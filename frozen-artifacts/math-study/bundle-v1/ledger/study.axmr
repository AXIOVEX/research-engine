ℓ : (SchwartzMap.referenceIntegerLattice d)) : IntegrableOn (fun x : (EuclideanSpace ℝ (Fin d)) => UnitAddTorus.mFourier (-n) (PoissonSummation.Standard.euclideanTorusProjection (d"},{"kind":"lemma","name":"fourier_weighted_translate_norm_bound","statement":"(n : Fin d → ℤ) (ℓ : (SchwartzMap.referenceIntegerLattice d)) (x : (EuclideanSpace ℝ (Fin d))) (hx : x ∈ SchwartzMap.PoissonSummation.Standard.halfOpenUnitCell (d"},{"kind":"lemma","name":"summable_cell_integrals_of_weighted_translates","statement":"(n : Fin d → ℤ) : Summable (fun ℓ : (SchwartzMap.referenceIntegerLattice d) => ∫ x in SchwartzMap.PoissonSummation.Standard.halfOpenUnitCell (d"},{"kind":"lemma","name":"fourier_coefficient_torus_periodization","statement":"(n : Fin d → ℤ) : UnitAddTorus.mFourierCoeff (torusDescendedPeriodization (d"},{"kind":"lemma","name":"summable_fourier_coefficients_torus_periodization","statement":"Summable (UnitAddTorus.mFourierCoeff (torusDescendedPeriodization (d"},{"kind":"theorem","name":"reference_lattice_poisson_formula","statement":"(v : (EuclideanSpace ℝ (Fin d))) : (∑' ℓ : (SchwartzMap.referenceIntegerLattice d), f (v + (ℓ : (EuclideanSpace ℝ (Fin d))))) = ∑' n : Fin d → ℤ, (𝓕 (fun x : (EuclideanSpace ℝ (Fin d)) => f x) (SchwartzMap.PoissonSummation.Standard.embeddedIntegerVector (d"},{"kind":"lemma","name":"coordinate_transport_maps_reference_lattice","statement":"(L : Submodule ℤ (EuclideanSpace ℝ (Fin d))) [DiscreteTopology L] [IsZLattice ℝ L] : Submodule.map ((latticeCoordinateEquiv (d"},{"kind":"lemma","name":"reference_basis_fundamental_region_volume","statement":"(volume : Measure (EuclideanSpace ℝ (Fin d))).real (ZSpan.fundamentalDomain ((EuclideanSpace.basisFun (Fin d) ℝ).toBasis)) = 1"},{"kind":"lemma","name":"lattice_covolume_eq_coordinate_determinant","statement":"ZLattice.covolume L = abs ((LinearMap.det : ((EuclideanSpace ℝ (Fin d)) →ₗ[ℝ] (EuclideanSpace ℝ (Fin d))) →* ℝ) ((latticeCoordinateEquiv L).toLinearMap))"},{"kind":"lemma","name":"reference_lattice_coordinate_equiv_apply","statement":"(x : SchwartzMap.referenceIntegerLattice d) : ((referenceLatticeCoordinateEquiv (d"},{"kind":"lemma","name":"dual_transport_comp_coordinate_adjoint","statement":"(dualCoordinateTransport (d"},{"kind":"lemma","name":"coordinate_adjoint_comp_dual_transport","statement":"(latticeCoordinateAdjoint (d"},{"kind":"lemma","name":"dual_coordinate_transport_maps_reference_lattice","statement":"Submodule.map ((dualCoordinateTransport (d"},{"kind":"lemma","name":"reference_lattice_polar_equiv_apply","statement":"(x : SchwartzMap.referenceIntegerLattice d) : ((referenceLatticePolarEquiv (d"},{"kind":"lemma","name":"integer_vector_polar_equiv_coe","statement":"(n : Fin d → ℤ) : ((integerVectorPolarLatticeEquiv (d"},{"kind":"theorem","name":"integer_lattice_poisson_identity","statement":"(f : SchwartzMap (EuclideanSpace ℝ (Fin d)) ℂ) (v : (EuclideanSpace ℝ (Fin d))) : (∑' ℓ : L, f (v + (ℓ : (EuclideanSpace ℝ (Fin d))))) = (1 / ZLattice.covolume L) * ∑' m : polarIntegerLattice (d"},{"kind":"theorem","name":"latticePoissonSummationFormula","statement":"(f : SchwartzMap (EuclideanSpace ℝ (Fin d)) ℂ) (v : EuclideanSpace ℝ (Fin d)) : ∑' ℓ : Λ, f (v + ℓ) = (1 / ZLattice.covolume Λ) * ∑' m : polarIntegerLattice (d"},{"kind":"theorem","name":"schwartz_fourier_inverse_identity","statement":"𝓕⁻ (𝓕 ⇑f) = f"},{"kind":"theorem","name":"Continuous.positive_iff_positive_on_neighborhood","statement":"{f : E → ℝ} (hf₁ : Continuous f) (x : E) : 0 < f x ↔ ∃ U ∈ (nhds x), ∀ y ∈ U, 0 < f y"},{"kind":"theorem","name":"Continuous.nonnegative_integral_vanishes_iff_function_vanishes","statement":"{f : E → ℝ} (hf₁ : Continuous f) (hf₂ : Integrable f) (hnn : ∀ x, 0 ≤ f x) : ∫ (v : E), f v = 0 ↔ f = 0"},{"kind":"theorem","name":"Complex.negative_imaginary_exponential_eq_conjugate","statement":"(x m : EuclideanSpace ℝ (Fin d)) : Complex.exp (-(2 * (Real.pi : ℂ) * Complex.I * (⟪x, m⟫_[ℝ] : ℂ))) = (starRingEnd ℂ) (Complex.exp (2 * (Real.pi : ℂ) * Complex.I * (⟪x, m⟫_[ℝ] : ℂ)))"},{"kind":"lemma","name":"summable_norm_on_translated_integral_lattice","statement":"(f : 𝓢(EuclideanSpace ℝ (Fin d), ℂ)) (a : EuclideanSpace ℝ (Fin d)) : Summable (fun ℓ : Λ => ‖f (a + (ℓ : EuclideanSpace ℝ (Fin d)))‖)"},{"kind":"lemma","name":"origin_character_sum_norm_sq_eq_orbit_count_sq","statement":"{d : ℕ} (P : PeriodicSpherePacking d) {D : Set (EuclideanSpace ℝ (Fin d))} (hd : 0 < d) (hD_isBounded : Bornology.IsBounded D) : norm (∑' x : ↑(P.centers ∩ D), Complex.exp (2 * π * Complex.I * ⟪(x : EuclideanSpace ℝ (Fin d)), (0 : EuclideanSpace ℝ (Fin d))⟫_[ℝ])) ^ 2 = (P.boundedCenterRepresentativeCount hd hD_isBounded : ℝ) ^ 2"},{"kind":"lemma","name":"inverse_product_rearrangement","statement":"{α : Type*} [DivisionCommMonoid α] (c a b : α) : (1 / c) * a * b = b * a / c"},{"kind":"lemma","name":"nonnegative_weighted_nonzero_frequency_sum","statement":"{d : ℕ} (f : 𝓢(EuclideanSpace ℝ (Fin d), ℂ)) (P : PeriodicSpherePacking d) (D : Set (EuclideanSpace ℝ (Fin d))) (hCohnElkies₂ : ∀ x : EuclideanSpace ℝ (Fin d), (𝓕 f x).re ≥ 0) : 0 ≤ ∑' m : ↥(SchwartzMap.polarIntegerLattice (d"},{"kind":"lemma","name":"packing_spectral_sum_exchange","statement":"(f : 𝓢(EuclideanSpace ℝ (Fin d), ℂ)) (hRealFourier : ∀ x : EuclideanSpace ℝ (Fin d), (((𝓕 f) x).re : ℂ) = (𝓕 f) x) (P : PeriodicSpherePacking d) {D : Set (EuclideanSpace ℝ (Fin d))} (hD_isBounded : Bornology.IsBounded D) (hd : 0 < d) : (∑' x : ↑(P.centers ∩ D), ∑' y : ↑(P.centers ∩ D), (1 / ZLattice.covolume P.lattice volume) * ∑' m : SchwartzMap.polarIntegerLattice (d"},{"kind":"theorem","name":"summable_lattice_shift_values","statement":"Summable (fun ℓ : Λ => f (a + (ℓ : EuclideanSpace ℝ (Fin d))))"},{"kind":"theorem","name":"summable_lattice_shift_real_parts","statement":"Summable (fun ℓ : Λ => (f (a + (ℓ : EuclideanSpace ℝ (Fin d)))).re)"},{"kind":"lemma","name":"center_double_sum_eq_region_lattice_sum","statement":"(f : 𝓢(EuclideanSpace ℝ (Fin d), ℂ)) (P : PeriodicSpherePacking d) [Nonempty P.centers] {D : Set (EuclideanSpace ℝ (Fin d))} (hD_isBounded : Bornology.IsBounded D) (hD_unique_covers : ∀ x, ∃! g : P.lattice, g +ᵥ x ∈ D) (hd : 0 < d) : ∑' (x : P.centers) (y : ↑(P.centers ∩ D)), (f (x - (y : EuclideanSpace ℝ (Fin d)))).re = ∑' (x : ↑(P.centers ∩ D)) (y : ↑(P.centers ∩ D)) (ℓ : P.lattice), (f ((x : EuclideanSpace ℝ (Fin d)) - (y : EuclideanSpace ℝ (Fin d)) + (ℓ : EuclideanSpace ℝ (Fin d)))).re"},{"kind":"lemma","name":"real_lattice_sum_bounded_by_origin_term","statement":"(hP : P.separation = 1) (hD_unique_covers : ∀ x, ∃! g : P.lattice, g +ᵥ x ∈ D) (hCohnElkies₁ : ∀ x : EuclideanSpace ℝ (Fin d), ‖x‖ ≥ 1 → (f x).re ≤ 0) (x y : ↑(P.centers ∩ D)) : (∑' ℓ : P.lattice, (f ((x : EuclideanSpace ℝ (Fin d)) - (y : EuclideanSpace ℝ (Fin d)) + (ℓ : EuclideanSpace ℝ (Fin d)))).re) ≤ ite (x = y) (f 0).re 0"},{"kind":"theorem","name":"imaginary_part_vanishes_of_real_valued","statement":"(g : EuclideanSpace ℝ (Fin d) → ℂ) : (∀ x : EuclideanSpace ℝ (Fin d), ↑(g x).re = (g x)) → (∀ x : EuclideanSpace ℝ (Fin d), (g x).im = 0)"},{"kind":"theorem","name":"fourier_imaginary_component_vanishes","statement":"∀ x : EuclideanSpace ℝ (Fin d), (𝓕 f x).im = 0"},{"kind":"theorem","name":"fourier_transform_is_integrable","statement":"MeasureTheory.Integrable (𝓕 ⇑f)"},{"kind":"theorem","name":"fourier_transform_nonzero","statement":"𝓕 f ≠ 0"},{"kind":"theorem","name":"test_function_nonnegative_at_origin","statement":"0 ≤ (f 0).re"},{"kind":"theorem","name":"test_function_positive_at_origin","statement":"0 < (f 0).re"},{"kind":"theorem","name":"packing_bound_auxiliary_estimate","statement":"(hd : 0 < d) (hD_unique_covers : ∀ x, ∃! g : P.lattice, g +ᵥ x ∈ D) : ∑' x : P.centers, ∑' y : ↑(P.centers ∩ D), (f (x - (y : EuclideanSpace ℝ (Fin d)))).re ≤ ↑(P.boundedCenterRepresentativeCount hd hD_isBounded) * (f 0).re"},{"kind":"lemma","name":"packing_bound_complete_estimate_refined","statement":"(hd : 0 < d) : ∑' (x : ↑(P.centers ∩ D)) (y : ↑(P.centers ∩ D)) (ℓ : ↥P.lattice), (f (↑x - ↑y + ↑ℓ)).re = (∑' (x : ↑(P.centers ∩ D)) (y : ↑(P.centers ∩ D)) (ℓ : ↥P.lattice), f (↑x - ↑y + ↑ℓ)).re"},{"kind":"theorem","name":"packing_bound_geometric_estimate","statement":"(hd : 0 < d) : ↑(P.boundedCenterRepresentativeCount hd hD_isBounded) * (f 0).re ≥ (1 / ZLattice.covolume P.lattice volume) * ∑' m : SchwartzMap.polarIntegerLattice (d"},{"kind":"theorem","name":"packing_bound_spectral_estimate","statement":"(hd : 0 < d) : (1 / ZLattice.covolume P.lattice volume) * ∑' m : SchwartzMap.polarIntegerLattice (d"},{"kind":"theorem","name":"packing_bound_complete_estimate","statement":"(hd : 0 < d) : ↑(P.boundedCenterRepresentativeCount hd hD_isBounded) * (f 0).re ≥ ↑(P.boundedCenterRepresentativeCount hd hD_isBounded) ^ 2 * (𝓕 f 0).re / ZLattice.covolume P.lattice volume"},{"kind":"theorem","name":"LinearProgrammingBound'","statement":"(hd : 0 < d) : P.upperPackingDensity ≤ (f 0).re.toNNReal / (𝓕 f 0).re.toNNReal * volume (Metric.ball (0 : EuclideanSpace ℝ (Fin d)) (1 / 2))"},{"kind":"theorem","name":"LinearProgrammingBound","statement":"(hd : 0 < d) : SpherePackingConstant d ≤ (f 0).re.toNNReal / (𝓕 ⇑f 0).re.toNNReal * volume (Metric.ball (0 : EuclideanSpace ℝ (Fin d)) (1 / 2))"},{"kind":"theorem","name":"exact_limit","statement":"Tendsto (fun d : ℕ => CohnElkies.linearProgram d ^ ((d : ℝ)⁻¹)) atTop (nhds (Real.sqrt (Real.exp 1 / (2 * Real.pi))))"},{"kind":"theorem","name":"exact_binary_exponent","statement":"Tendsto (fun d : ℕ => Real.logb 2 (CohnElkies.linearProgram d) / (d : ℝ)) atTop (nhds (-(1 / 2 : ℝ) * Real.logb 2 (2 * Real.pi / Real.exp 1)))"},{"kind":"theorem","name":"volume_half_ball","statement":"{d : ℕ} (hd : 0 < d) : volume (ball (0 : CohnElkies.Euclidean d) (1 / 2 : ℝ)) = ENNReal.ofReal (CohnElkies.unitBallVolume d / (2 : ℝ) ^ d)"},{"kind":"theorem","name":"sphere_packing_le_admissible","statement":"{d : ℕ} (hd : 0 < d) (f : CohnElkies.Admissible d) : SpherePackingConstant d ≤ ENNReal.ofReal (CohnElkies.unitBallVolume d / (2 : ℝ) ^ d * CohnElkies.quotient f)"},{"kind":"theorem","name":"sphere_packing_le_radial_linear_program","statement":"{d : ℕ} (hd : 0 < d) : (SpherePackingConstant d).toReal ≤ CohnElkies.linearProgram d"},{"kind":"theorem","name":"sphere_packing_le_radial_linear_program_ennreal","statement":"{d : ℕ} (hd : 0 < d) : SpherePackingConstant d ≤ ENNReal.ofReal (CohnElkies.linearProgram d)"},{"kind":"theorem","name":"sphere_packing_sharp_asymptotic_upper","statement":"∃ e : ℕ → ℝ, Asymptotics.IsLittleO atTop e (fun _ : ℕ => (1 : ℝ)) ∧ ∀ d : ℕ, 0 < d → SpherePackingConstant d ≤ ENNReal.ofReal ((Real.sqrt (Real.exp 1 / (2 * Real.pi)) + e d) ^ d)"},{"kind":"theorem","name":"fullQuotient_radialToFull","statement":"{d : ℕ} (f : CohnElkies.Admissible d) : fullQuotient (radialToFull f) = CohnElkies.quotient f"},{"kind":"theorem","name":"fullQuotientSet_eq_radial_iff","statement":"(d : ℕ) : fullQuotientSet d = CohnElkies.quotientSet d ↔ ∀ f : FullAdmissible d, ∃ g : CohnElkies.Admissible d, CohnElkies.quotient g = fullQuotient f"},{"kind":"theorem","name":"orthogonal_entry_abs_le_one","statement":"{d : ℕ} {A : Matrix (Fin d) (Fin d) ℝ} (hA : A ∈ Matrix.orthogonalGroup (Fin d) ℝ) (i j : Fin d) : |A i j| ≤ (1 : ℝ)"},{"kind":"theorem","name":"orthogonal_isCompact","statement":"(d : ℕ) : IsCompact (Matrix.orthogonalGroup (Fin d) ℝ : Set (Matrix (Fin d) (Fin d) ℝ))"},{"kind":"theorem","name":"orthogonalAction_continuous","statement":"{d : ℕ} (x : Ambient d) : Continuous (fun U : OrthogonalGroup d => orthogonalAction U x)"},{"kind":"theorem","name":"continuous_orthogonalAction_apply","statement":"{d : ℕ} (x : Ambient d) : Continuous (fun U : OrthogonalGroup d => orthogonalAction U x)"},{"kind":"theorem","name":"orthogonalAction_joint_continuous","statement":"(d : ℕ) : Continuous (fun p : OrthogonalGroup d × Ambient d => orthogonalAction p.1 p.2)"},{"kind":"theorem","name":"orthogonal_transitive","statement":"{d : ℕ} {x y : Ambient d} (hxy : ‖x‖ = ‖y‖) : ∃ U : OrthogonalGroup d, orthogonalAction U x = y"},{"kind":"theorem","name":"radialIsometrySchwartzOrbit_apply","statement":"{d : ℕ} (U : Ambient d ≃ₗᵢ[ℝ] Ambient d) (f : Schwartz d) (x : Ambient d) : radialIsometrySchwartzOrbit U f x = f (U x)"},{"kind":"theorem","name":"radialIsometrySchwartzOrbit_symm_apply","statement":"{d : ℕ} (U : Ambient d ≃ₗᵢ[ℝ] Ambient d) (f : Schwartz d) : radialIsometrySchwartzOrbit U.symm (radialIsometrySchwartzOrbit U f) = f"},{"kind":"theorem","name":"radialIsometrySchwartzOrbit_iteratedFDeriv_norm","statement":"{d : ℕ} (U : Ambient d ≃ₗᵢ[ℝ] Ambient d) (f : Schwartz d) (n : ℕ) (x : Ambient d) : ‖iteratedFDeriv ℝ n (radialIsometrySchwartzOrbit U f : Ambient d → ℂ) x‖ = ‖iteratedFDeriv ℝ n (f : Ambient d → ℂ) (U x)‖"},{"kind":"theorem","name":"radialIsometrySchwartzOrbit_iteratedFDeriv","statement":"{d : ℕ} (U : Ambient d ≃ₗᵢ[ℝ] Ambient d) (f : Schwartz d) (n : ℕ) (x : Ambient d) : iteratedFDeriv ℝ n (radialIsometrySchwartzOrbit U f : Ambient d → ℂ) x = (iteratedFDeriv ℝ n (f : Ambient d → ℂ) (U x)).compContinuousLinearMap (fun _ ↦ U.toContinuousLinearMap)"},{"kind":"theorem","name":"radialIsometrySchwartzOrbit_weighted_iteratedFDeriv_le","statement":"{d : ℕ} (U : Ambient d ≃ₗᵢ[ℝ] Ambient d) (f : Schwartz d) (k n : ℕ) (x : Ambient d) : ‖x‖ ^ k * ‖iteratedFDeriv ℝ n (radialIsometrySchwartzOrbit U f : Ambient d → ℂ) x‖ ≤ SchwartzMap.seminorm ℂ k n f"},{"kind":"theorem","name":"radialIsometrySchwartzOrbit_seminorm_le","statement":"{d : ℕ} (U : Ambient d ≃ₗᵢ[ℝ] Ambient d) (f : Schwartz d) (k n : ℕ) : SchwartzMap.seminorm ℂ k n (radialIsometrySchwartzOrbit U f) ≤ SchwartzMap.seminorm ℂ k n f"},{"kind":"theorem","name":"radialIsometrySchwartzOrbit_seminorm_eq","statement":"{d : ℕ} (U : Ambient d ≃ₗᵢ[ℝ] Ambient d) (f : Schwartz d) (k n : ℕ) : SchwartzMap.seminorm ℂ k n (radialIsometrySchwartzOrbit U f) = SchwartzMap.seminorm ℂ k n f"},{"kind":"theorem","name":"orthogonalLinearIsometry_continuousLinearMap_continuous","statement":"(d : ℕ) : Continuous (fun U : OrthogonalGroup d => (orthogonalLinearIsometry U).toContinuousLinearMap)"},{"kind":"theorem","name":"orthogonalSchwartzIteratedFDeriv_continuous","statement":"{d : ℕ} (f : Schwartz d) (n : ℕ) (x : Ambient d) : Continuous (fun U : OrthogonalGroup d => iteratedFDeriv ℝ n (radialIsometrySchwartzOrbit (orthogonalLinearIsometry U) f : Ambient d → ℂ) x)"},{"kind":"theorem","name":"orthogonalSchwartzInverseIteratedFDeriv_continuous","statement":"{d : ℕ} (f : Schwartz d) (n : ℕ) (x : Ambient d) : Continuous (fun U : OrthogonalGroup d => iteratedFDeriv ℝ n (radialIsometrySchwartzOrbit (orthogonalLinearIsometry U⁻¹) f : Ambient d → ℂ) x)"},{"kind":"theorem","name":"orthogonalSchwartzInverseIteratedFDeriv_aestronglyMeasurable","statement":"{d : ℕ} (f : Schwartz d) (n : ℕ) (x : Ambient d) : AEStronglyMeasurable (fun U : OrthogonalGroup d => iteratedFDeriv ℝ n (radialIsometrySchwartzOrbit (orthogonalLinearIsometry U⁻¹) f : Ambient d → ℂ) x) (radialOrthogonalHaar d)"},{"kind":"theorem","name":"radialSchwartzParametricDerivativeIntegrable","statement":"(hmeas : ∀ (n : ℕ) (x : Ambient d), AEStronglyMeasurable (fun a : α ↦ iteratedFDeriv ℝ n (g a : Ambient d → ℂ) x) μ) (hbound : ∀ (a : α) (k n : ℕ), SchwartzMap.seminorm ℂ k n (g a) ≤ C k n) (n : ℕ) (x : Ambient d) : Integrable (fun a : α ↦ iteratedFDeriv ℝ n (g a : Ambient d → ℂ) x) μ"},{"kind":"theorem","name":"radialSchwartzParametric_hasFDerivAt_iteratedIntegral","statement":"(hmeas : ∀ (n : ℕ) (x : Ambient d), AEStronglyMeasurable (fun a : α ↦ iteratedFDeriv ℝ n (g a : Ambient d → ℂ) x) μ) (hbound : ∀ (a : α) (k n : ℕ), SchwartzMap.seminorm ℂ k n (g a) ≤ C k n) (n : ℕ) (x : Ambient d) : HasFDerivAt (fun y : Ambient d ↦ ∫ a : α, iteratedFDeriv ℝ n (g a : Ambient d → ℂ) y ∂μ) (∫ a : α, fderiv ℝ (iteratedFDeriv ℝ n (g a : Ambient d → ℂ)) x ∂μ) x"},{"kind":"theorem","name":"radialSchwartzParametric_iteratedFDeriv_integral","statement":"(hmeas : ∀ (n : ℕ) (x : Ambient d), AEStronglyMeasurable (fun a : α ↦ iteratedFDeriv ℝ n (g a : Ambient d → ℂ) x) μ) (hbound : ∀ (a : α) (k n : ℕ), SchwartzMap.seminorm ℂ k n (g a) ≤ C k n) (n : ℕ) (x : Ambient d) : iteratedFDeriv ℝ n (fun y : Ambient d ↦ ∫ a : α, (g a) y ∂μ) x = ∫ a : α, iteratedFDeriv ℝ n (g a : Ambient d → ℂ) x ∂μ"},{"kind":"theorem","name":"radialSymmetrizationAverage_integrable","statement":"{d : ℕ} (f : Schwartz d) (x : Ambient d) : Integrable (fun U : OrthogonalGroup d ↦ f (orthogonalAction U⁻¹ x)) (radialOrthogonalHaar d)"},{"kind":"theorem","name":"radialSymmetrizationAverage_comp_orthogonal","statement":"{d : ℕ} (f : Schwartz d) (A : OrthogonalGroup d) (x : Ambient d) : radialSymmetrizationAverage f (orthogonalAction A x) = radialSymmetrizationAverage f x"},{"kind":"theorem","name":"radialSymmetrizationAverage_eq_of_norm_eq","statement":"{d : ℕ} (f : Schwartz d) {x y : Ambient d} (hxy : ‖x‖ = ‖y‖) : radialSymmetrizationAverage f x = radialSymmetrizationAverage f y"},{"kind":"theorem","name":"scalarProbabilityAverage_weighted_iteratedFDeriv_le","statement":"{ι : Type*} [MeasurableSpace ι] (μ : Measure ι) [IsProbabilityMeasure μ] {d : ℕ} (F : ι → Schwartz d) (C : ℕ → ℕ → ℝ) (hbound : ∀ (k n : ℕ) (a : ι) (x : Ambient d), ‖x‖ ^ k * ‖iteratedFDeriv ℝ n (fun y : Ambient d ↦ F a y) x‖ ≤ C k n) (hderiv : ∀ (n : ℕ) (x : Ambient d), iteratedFDeriv ℝ n (fun y : Ambient d ↦ ∫ a, F a y ∂μ) x = ∫ a, iteratedFDeriv ℝ n (fun y : Ambient d ↦ F a y) x ∂μ) (k n : ℕ) (x : Ambient d) : ‖x‖ ^ k * ‖iteratedFDeriv ℝ n (fun y : Ambient d ↦ ∫ a, F a y ∂μ) x‖ ≤ C k n"},{"kind":"theorem","name":"radialSymmetrization_apply","statement":"{d : ℕ} (f : Schwartz d) (x : Ambient d) : radialSymmetrization f x = radialSymmetrizationAverage f x"},{"kind":"theorem","name":"orthogonalScalarAverage_im_eq_zero","statement":"{d : ℕ} {G : Type*} [MeasurableSpace G] {μ : Measure G} (A : G → (Ambient d ≃ₗᵢ[ℝ] Ambient d)) {f : Schwartz d} (hf : IsRealValued f) (x : Ambient d) (hint : Integrable (fun U : G ↦ f (A U x)) μ) : (orthogonalScalarAverage μ A f x).im = 0"},{"kind":"theorem","name":"orthogonalScalarAverage_re","statement":"{d : ℕ} {G : Type*} [MeasurableSpace G] {μ : Measure G} (A : G → (Ambient d ≃ₗᵢ[ℝ] Ambient d)) (f : Schwartz d) (x : Ambient d) (hint : Integrable (fun U : G ↦ f (A U x)) μ) : (orthogonalScalarAverage μ A f x).re = ∫ U : G, (f (A U x)).re ∂μ"},{"kind":"theorem","name":"orthogonalScalarAverage_nonneg_of_nonneg","statement":"{d : ℕ} {G : Type*} [MeasurableSpace G] {μ : Measure G} (A : G → (Ambient d ≃ₗᵢ[ℝ] Ambient d)) {f : Schwartz d} (hf : ∀ y : Ambient d, 0 ≤ (f y).re) (x : Ambient d) (hint : Integrable (fun U : G ↦ f (A U x)) μ) : 0 ≤ (orthogonalScalarAverage μ A f x).re"},{"kind":"theorem","name":"orthogonalScalarAverage_nonpos_of_norm_ge","statement":"{d : ℕ} {G : Type*} [MeasurableSpace G] {μ : Measure G} (A : G → (Ambient d ≃ₗᵢ[ℝ] Ambient d)) {f : Schwartz d} {R : ℝ} (hf : ∀ y : Ambient d, R ≤ ‖y‖ → (f y).re ≤ 0) {x : Ambient d} (hx : R ≤ ‖x‖) (hint : Integrable (fun U : G ↦ f (A U x)) μ) : (orthogonalScalarAverage μ A f x).re ≤ 0"},{"kind":"theorem","name":"radialSymmetrizationAverage_eq_orthogonalScalarAverage","statement":"{d : ℕ} (f : Schwartz d) (x : Ambient d) : radialSymmetrizationAverage f x = orthogonalScalarAverage (radialOrthogonalHaar d) (fun U : OrthogonalGroup d ↦ orthogonalLinearIsometry U⁻¹) f x"},{"kind":"theorem","name":"radialSymmetrizationAverage_im_eq_zero","statement":"{d : ℕ} {f : Schwartz d} (hf : IsRealValued f) (x : Ambient d) : (radialSymmetrizationAverage f x).im = 0"},{"kind":"theorem","name":"radialSymmetrizationAverage_nonneg_of_nonneg","statement":"{d : ℕ} {f : Schwartz d} (hf : ∀ y : Ambient d, 0 ≤ (f y).re) (x : Ambient d) : 0 ≤ (radialSymmetrizationAverage f x).re"},{"kind":"theorem","name":"radialSymmetrizationAverage_nonpos_of_norm_ge","statement":"{d : ℕ} {f : Schwartz d} {R : ℝ} (hf : ∀ y : Ambient d, R ≤ ‖y‖ → (f y).re ≤ 0) {x : Ambient d} (hx : R ≤ ‖x‖) : (radialSymmetrizationAverage f x).re ≤ 0"},{"kind":"theorem","name":"radialSymmetrizationAverage_nonpos_of_one_le_norm","statement":"{d : ℕ} {f : Schwartz d} (hf : ∀ y : Ambient d, 1 ≤ ‖y‖ → (f y).re ≤ 0) {x : Ambient d} (hx : 1 ≤ ‖x‖) : (radialSymmetrizationAverage f x).re ≤ 0"},{"kind":"theorem","name":"IsRadial.neg_apply","statement":"{d : ℕ} {f : Schwartz d} (hf : IsRadial f) (x : Ambient d) : f (-x) = f x"},{"kind":"theorem","name":"IsRealValued.fourier_conj","statement":"{d : ℕ} {f : Schwartz d} (hf : IsRealValued f) (x : Ambient d) : (starRingEnd ℂ) ((𝓕 f : Schwartz d) x) = (𝓕 f : Schwartz d) (-x)"},{"kind":"theorem","name":"IsRadial.fourier_realValued","statement":"{d : ℕ} {f : Schwartz d} (hradial : IsRadial f) (hreal : IsRealValued f) : IsRealValued (𝓕 f : Schwartz d)"},{"kind":"theorem","name":"radialFourierCharacter_continuous","statement":"{d : ℕ} (ξ : Ambient d) : Continuous (radialFourierCharacter ξ)"},{"kind":"theorem","name":"radialFourierCharacter_norm","statement":"{d : ℕ} (ξ x : Ambient d) : ‖radialFourierCharacter ξ x‖ = 1"},{"kind":"theorem","name":"radialFourier_orthogonalOrbit_integrable","statement":"{d : ℕ} (f : Schwartz d) (A : Ambient d ≃ₗᵢ[ℝ] Ambient d) : Integrable (fun x : Ambient d ↦ f (A x))"},{"kind":"theorem","name":"radialFourier_orthogonalCharacterOrbit_integrable","statement":"{d : ℕ} (f : Schwartz d) (ξ : Ambient d) (A : Ambient d ≃ₗᵢ[ℝ] Ambient d) : Integrable (fun x : Ambient d ↦ radialFourierCharacter ξ x * f (A x))"},{"kind":"theorem","name":"radialFourier_orthogonalCharacterOrbit_integral_norm","statement":"{d : ℕ} (f : Schwartz d) (ξ : Ambient d) (A : Ambient d ≃ₗᵢ[ℝ] Ambient d) : (∫ x : Ambient d, ‖radialFourierCharacter ξ x * f (A x)‖) = ∫ x : Ambient d, ‖f x‖"},{"kind":"theorem","name":"radialFourier_orthogonalCharacterOrbit_integral","statement":"{d : ℕ} (f : Schwartz d) (ξ : Ambient d) (A : Ambient d ≃ₗᵢ[ℝ] Ambient d) : (∫ x : Ambient d, radialFourierCharacter ξ x * f (A x)) = (𝓕 f : Schwartz d) (A ξ)"},{"kind":"theorem","name":"radialFourierOrbitKernel_integrable","statement":"{d : ℕ} {G : Type*} [MeasurableSpace G] (μ : Measure G) [IsFiniteMeasure μ] (A : G → (Ambient d ≃ₗᵢ[ℝ] Ambient d)) (f : Schwartz d) (ξ : Ambient d) (horbit : Measurable (fun p : G × Ambient d ↦ f (A p.1 p.2))) : Integrable (radialFourierOrbitKernel A f ξ) (μ.prod volume)"},{"kind":"theorem","name":"radialFourierOrbitAverage_fourier","statement":"{d : ℕ} {G : Type*} [MeasurableSpace G] (μ : Measure G) [IsFiniteMeasure μ] (A : G → (Ambient d ≃ₗᵢ[ℝ] Ambient d)) (f : Schwartz d) (ξ : Ambient d) (horbit : Measurable (fun p : G × Ambient d ↦ f (A p.1 p.2))) : (𝓕 (radialFourierOrbitAverage μ A f) : Ambient d → ℂ) ξ = ∫ g : G, (𝓕 f : Schwartz d) (A g ξ) ∂μ"},{"kind":"theorem","name":"radialOrthogonalHaarOrbit_measurable","statement":"{d : ℕ} (f : Schwartz d) : Measurable (fun p : OrthogonalGroup d × Ambient d ↦ f (orthogonalLinearIsometry (p.1⁻¹) p.2))"},{"kind":"theorem","name":"radialOrthogonalHaar_radialFourierOrbitAverage_eq","statement":"{d : ℕ} (f : Schwartz d) : radialFourierOrbitAverage (radialOrthogonalHaar d) (fun U : OrthogonalGroup d ↦ orthogonalLinearIsometry (U⁻¹)) f = fun x : Ambient d ↦ ∫ U : OrthogonalGroup d, f (orthogonalAction (U⁻¹) x) ∂radialOrthogonalHaar d"},{"kind":"theorem","name":"radialOrthogonalHaar_fourier_average","statement":"{d : ℕ} (f : Schwartz d) (ξ : Ambient d) : (𝓕 (fun x : Ambient d ↦ ∫ U : OrthogonalGroup d, f (orthogonalAction (U⁻¹) x) ∂radialOrthogonalHaar d) : Ambient d → ℂ) ξ = ∫ U : OrthogonalGroup d, (𝓕 f : Schwartz d) (orthogonalAction (U⁻¹) ξ) ∂radialOrthogonalHaar d"},{"kind":"theorem","name":"fourier_radialSymmetrizationAverage","statement":"{d : ℕ} (f : Schwartz d) (ξ : Ambient d) : (𝓕 (radialSymmetrizationAverage f) : Ambient d → ℂ) ξ = radialSymmetrizationAverage (𝓕 f : Schwartz d) ξ"},{"kind":"theorem","name":"manuscript_pi_gt_d40","statement":"(3.1415926535897932384626433832795028841971 : ℝ) < Real.pi"},{"kind":"theorem","name":"manuscript_pi_lt_d40","statement":"Real.pi < (3.1415926535897932384626433832795028841972 : ℝ)"},{"kind":"theorem","name":"criticalBinaryExponent_eq_log_div","statement":"criticalBinaryExponent = Real.log (2 * Real.pi / Real.exp 1) / (2 * Real.log 2)"},{"kind":"theorem","name":"criticalBinaryExponent_eq_three_halves_sub_logFourDivPi","statement":"criticalBinaryExponent = (3 / 2 : ℝ) - (Real.log (4 / Real.pi) + 1) / (2 * Real.log 2)"},{"kind":"theorem","name":"baseTwo_log_two_gt_d6","statement":"(0.693147 : ℝ) < Real.log 2"},{"kind":"theorem","name":"baseTwo_log_four_div_pi_lt_d7","statement":"Real.log (4 / Real.pi) < (0.2415647 : ℝ)"},{"kind":"theorem","name":"criticalBinaryExponent_gt_d4","statement":"(0.6044 : ℝ) < criticalBinaryExponent"},{"kind":"theorem","name":"baseTwo_log_two_gt_d36","statement":"(0.693147180559945309417232121458176568 : ℝ) < Real.log 2"},{"kind":"theorem","name":"baseTwo_log_two_lt_d36","statement":"Real.log 2 < (0.693147180559945309417232121458176569 : ℝ)"},{"kind":"theorem","name":"baseTwo_log_four_div_pi_gt_d36","statement":"(0.241564475270490444691036891563294424 : ℝ) < Real.log (4 / Real.pi)"},{"kind":"theorem","name":"baseTwo_log_four_div_pi_lt_d36","statement":"Real.log (4 / Real.pi) < (0.241564475270490444691036891563294425 : ℝ)"},{"kind":"theorem","name":"criticalBinaryExponent_gt_d33","statement":"(0.604400544291677695341677307053057 : ℝ) < criticalBinaryExponent"},{"kind":"theorem","name":"criticalBinaryExponent_lt_d33","statement":"criticalBinaryExponent < (0.604400544291677695341677307053058 : ℝ)"},{"kind":"theorem","name":"criticalBinaryExponent_gt_d30","statement":"(0.604400544291677695341677307053 : ℝ) < criticalBinaryExponent"},{"kind":"theorem","name":"criticalBinaryExponent_lt_d30","statement":"criticalBinaryExponent < (0.604400544291677695341677307054 : ℝ)"},{"kind":"theorem","name":"criticalBinaryExponent_mem_Ioo_d30","statement":"criticalBinaryExponent ∈ Set.Ioo (0.604400544291677695341677307053 : ℝ) 0.604400544291677695341677307054"},{"kind":"theorem","name":"manuscriptQuotientRootSet_eq_literal","statement":"(d : ℕ) : manuscriptQuotientRootSet d = {q : ℝ | ∃ f : Admissible d, quotient f ^ ((d : ℝ)⁻¹) = q}"},{"kind":"theorem","name":"sharpCohnElkiesManuscriptConclusions","statement":"SharpCohnElkiesManuscriptConclusions"},{"kind":"theorem","name":"quotient_eq_of_origin_and_fourier_origin","statement":"{d : ℕ} {f g : Schwartz d} (horigin : g 0 = f 0) (hfourier : fourierReal g 0 = fourierReal f 0) : quotient g = quotient f"},{"kind":"theorem","name":"IsUnrestrictedAdmissible.radialAdmissible_of_average_data","statement":"{d : ℕ} {f g : Schwartz d} (hf : IsUnrestrictedAdmissible f) (hreal : IsRealValued g) (hradial : IsRadial g) (hfourier_zero : fourierReal g 0 = fourierReal f 0) (hfourier_nonneg : ∀ x : Ambient d, 0 ≤ fourierReal g x) (hexterior : ∀ x : Ambient d, 1 ≤ ‖x‖ → (g x).re ≤ 0) : IsAdmissible g where real_valued"},{"kind":"theorem","name":"radial_of_radialSymmetrizationAverage","statement":"{d : ℕ} {f g : Schwartz d} (haverage : ∀ x : Ambient d, g x = radialSymmetrizationAverage f x) : IsRadial g"},{"kind":"theorem","name":"radialSymmetrizationAverage_schwartz_zero","statement":"{d : ℕ} {f g : Schwartz d} (haverage : ∀ x : Ambient d, g x = radialSymmetrizationAverage f x) : g 0 = f 0"},{"kind":"theorem","name":"radialSymmetrizationAverage_fourier_zero","statement":"{d : ℕ} {f g : Schwartz d} (hfourier : ∀ x : Ambient d, (𝓕 g : Schwartz d) x = radialSymmetrizationAverage (𝓕 f : Schwartz d) x) : fourierReal g 0 = fourierReal f 0"},{"kind":"theorem","name":"IsUnrestrictedAdmissible.radialAdmissible_of_radialSymmetrizationAverage","statement":"{d : ℕ} {f g : Schwartz d} (hf : IsUnrestrictedAdmissible f) (haverage : ∀ x : Ambient d, g x = radialSymmetrizationAverage f x) (hfourier : ∀ x : Ambient d, (𝓕 g : Schwartz d) x = radialSymmetrizationAverage (𝓕 f : Schwartz d) x) : IsAdmissible g"},{"kind":"theorem","name":"quotient_eq_of_radialSymmetrizationAverage","statement":"{d : ℕ} {f g : Schwartz d} (haverage : ∀ x : Ambient d, g x = radialSymmetrizationAverage f x) (hfourier : ∀ x : Ambient d, (𝓕 g : Schwartz d) x = radialSymmetrizationAverage (𝓕 f : Schwartz d) x) : quotient g = quotient f"},{"kind":"theorem","name":"radialSymmetrization_fourier_average_apply_for_admissibility","statement":"{d : ℕ} (f : Schwartz d) (x : Ambient d) : (𝓕 (radialSymmetrization f) : Schwartz d) x = radialSymmetrizationAverage (𝓕 f : Schwartz d) x"},{"kind":"theorem","name":"IsUnrestrictedAdmissible.radialSymmetrization_admissible","statement":"{d : ℕ} {f : Schwartz d} (hf : IsUnrestrictedAdmissible f) : IsAdmissible (radialSymmetrization f)"},{"kind":"theorem","name":"IsUnrestrictedAdmissible.quotient_radialSymmetrization","statement":"{d : ℕ} {f : Schwartz d} (_hf : IsUnrestrictedAdmissible f) : quotient (radialSymmetrization f) = quotient f"},{"kind":"theorem","name":"fourier_schwartzDilation_apply","statement":"{d : ℕ} (a : ℝ) (ha : 0 < a) (f : Schwartz d) (ξ : Ambient d) : (𝓕 (schwartzDilation a ha.ne' f) : Schwartz d) ξ = (a ^ d)⁻¹ • (𝓕 f : Schwartz d) (a⁻¹ • ξ)"},{"kind":"theorem","name":"fourierReal_schwartzDilation_apply","statement":"{d : ℕ} (a : ℝ) (ha : 0 < a) (f : Schwartz d) (ξ : Ambient d) : fourierReal (schwartzDilation a ha.ne' f) ξ = (a ^ d)⁻¹ * fourierReal f (a⁻¹ • ξ)"},{"kind":"theorem","name":"fourierReal_schwartzDilation_nonneg","statement":"{d : ℕ} {f : Schwartz d} (hf : ∀ ξ, 0 ≤ fourierReal f ξ) (a : ℝ) (ha : 0 < a) (ξ : Ambient d) : 0 ≤ fourierReal (schwartzDilation a ha.ne' f) ξ"},{"kind":"theorem","name":"fourierReal_schwartzDilation_zero_pos","statement":"{d : ℕ} {f : Schwartz d} (hf : 0 < fourierReal f 0) (a : ℝ) (ha : 0 < a) : 0 < fourierReal (schwartzDilation a ha.ne' f) 0"},{"kind":"theorem","name":"quotient_schwartzDilation","statement":"{d : ℕ} (a : ℝ) (ha : 0 < a) (f : Schwartz d) : quotient (schwartzDilation a ha.ne' f) = a ^ d * quotient f"},{"kind":"theorem","name":"FullAdmissible.toAlternative","statement":"{d : ℕ} (f : FullAdmissible d) : SpherePacking.Alternative.IsUnrestrictedAdmissible f.function where real_valued"},{"kind":"theorem","name":"FullAdmissible.quotient_radialization","statement":"{d : ℕ} (f : FullAdmissible d) : CohnElkies.quotient f.radialization = fullQuotient f"},{"kind":"theorem","name":"exists_radial_admissible_of_full","statement":"{d : ℕ} (f : FullAdmissible d) : ∃ g : CohnElkies.Admissible d, CohnElkies.quotient g = fullQuotient f"},{"kind":"theorem","name":"fullQuotientSet_eq_radial","statement":"(d : ℕ) : fullQuotientSet d = CohnElkies.quotientSet d"},{"kind":"theorem","name":"fullLinearProgram_eq_radial","statement":"(d : ℕ) : fullLinearProgram d = CohnElkies.linearProgram d"},{"kind":"theorem","name":"exact_limit","statement":"Tendsto (fun d : ℕ => fullLinearProgram d ^ ((d : ℝ)⁻¹)) atTop (nhds (Real.sqrt (Real.exp 1 / (2 * Real.pi))))"},{"kind":"theorem","name":"exact_binary_exponent","statement":"Tendsto (fun d : ℕ => Real.logb 2 (fullLinearProgram d) / (d : ℝ)) atTop (nhds (-(1 / 2 : ℝ) * Real.logb 2 (2 * Real.pi / Real.exp 1)))"},{"kind":"theorem","name":"fullQuotientRootSet_eq_radial","statement":"(d : ℕ) : {q : ℝ | ∃ f : FullAdmissible d, fullQuotient f ^ ((d : ℝ)⁻¹) = q} = {q : ℝ | ∃ f : CohnElkies.Admissible d, CohnElkies.quotient f ^ ((d : ℝ)⁻¹) = q}"},{"kind":"theorem","name":"SharpFullCohnElkiesManuscriptConclusions.ofRadial","statement":"SharpFullCohnElkiesManuscriptConclusions"},{"kind":"theorem","name":"SharpFullCohnElkiesManuscriptConclusions.components","statement":"Tendsto (fun d : ℕ => sInf {q : ℝ | ∃ f : FullAdmissible d, fullQuotient f ^ ((d : ℝ)⁻¹) = q} / Real.sqrt (d : ℝ)) atTop (𝓝 (1 / Real.pi)) ∧ (∃ err : ℕ → ℝ, Tendsto err atTop (𝓝 0) ∧ ∀ d : ℕ, 0 < d → sInf {q : ℝ | ∃ f : FullAdmissible d, fullQuotient f ^ ((d : ℝ)⁻¹) = q} = (1 / Real.pi + err d) * Real.sqrt (d : ℝ)) ∧ Tendsto (fun d : ℕ => (fullLinearProgram d) ^ ((d : ℝ)⁻¹)) atTop (𝓝 (Real.sqrt (Real.exp 1 / (2 * Real.pi)))) ∧ Tendsto (fun d : ℕ => Real.log (fullLinearProgram d) / (d : ℝ)) atTop (𝓝 ((1 / 2 : ℝ) * Real.log (Real.exp 1 / (2 * Real.pi)))) ∧ (∃ err : ℕ → ℝ, Tendsto err atTop (𝓝 0) ∧ (∀ᶠ d : ℕ in atTop, fullLinearProgram d = (Real.sqrt (Real.exp 1 / (2 * Real.pi)) + err d) ^ d)) ∧ (∃ δ : ℕ → ℝ, Tendsto δ atTop (𝓝 0) ∧ (∀ d : ℕ, 0 ≤ δ d) ∧ (∀ᶠ d : ℕ in atTop, ∀ f : FullAdmissible d, (2 : ℝ) ^ d / CohnElkies.unitBallVolume d * (Real.sqrt (Real.exp 1 / (2 * Real.pi)) - δ d) ^ d ≤ fullQuotient f)) ∧ 0 < (1 / 2 : ℝ) * Real.logb 2 (2 * Real.pi / Real.exp 1) ∧ (1 / 2 : ℝ) * Real.logb 2 (2 * Real.pi / Real.exp 1) ∈ Set.Ioo (0.604400544291677695341677307053 : ℝ) 0.604400544291677695341677307054 ∧ Tendsto (fun d : ℕ => Real.logb 2 (fullLinearProgram d) / (d : ℝ)) atTop (𝓝 (-((1 / 2 : ℝ) * Real.logb 2 (2 * Real.pi / Real.exp 1)))) ∧ (∃ err : ℕ → ℝ, Tendsto err atTop (𝓝 0) ∧ (∀ᶠ d : ℕ in atTop, fullLinearProgram d = (2 : ℝ) ^ (-((1 / 2 : ℝ) * Real.logb 2 (2 * Real.pi / Real.exp 1) + err d) * (d : ℝ))))"},{"kind":"theorem","name":"sharpFullCohnElkiesManuscriptConclusions","statement":"SharpFullCohnElkiesManuscriptConclusions"}],"retrieved":"2026-10-12","sha256":"5e8a4d4ffa0c3b8c488f99ecedc43943dff63513d65bd5bd70d5e33beccc2c0f","sorry_count":0,"url":"https://github.com/openai/ten-proofs/blob/main/SpherePacking.lean"}},"prev_hash":"a7c1492ac95f2fa05ce3f8b37f246f814fcfa09c82512dcf5ebe06e5f7366ebb","seq":49,"ts":1791808520,"type":"math.lean_ingested"}
{"actor":"archivist","hash":"bd144b75b8c16299aa6bb5500cdfa0274e8afd27c34267988e3a51b1f69525b5","payload":{"artifact":{"admit_count":0,"byte_length":1343031,"compile_detail":{"method":"sorry/admit counted over comment-stripped bytes"},"compile_status":"not_attempted","declarations":[{"kind":"theorem","name":"hasPropertyT_of_mulEquiv","statement":"{G : Type u} {G' : Type w} [Group G] [Group G'] (e : G ≃* G') [HasPropertyT.{u, v} G] : HasPropertyT.{w, v} G'"},{"kind":"theorem","name":"normalizedHamming_self","statement":"{Y : Type*} [Fintype Y] [DecidableEq Y] (p : Equiv.Perm Y) : normalizedHamming p p = 0"},{"kind":"theorem","name":"normalizedHamming_comm","statement":"{Y : Type*} [Fintype Y] [DecidableEq Y] (p q : Equiv.Perm Y) : normalizedHamming p q = normalizedHamming q p"},{"kind":"theorem","name":"normalizedHamming_nonneg","statement":"{Y : Type*} [Fintype Y] [DecidableEq Y] (p q : Equiv.Perm Y) : 0 ≤ normalizedHamming p q"},{"kind":"theorem","name":"normalizedHamming_triangle","statement":"{Y : Type*} [Fintype Y] [DecidableEq Y] (p q r : Equiv.Perm Y) : normalizedHamming p r ≤ normalizedHamming p q + normalizedHamming q r"},{"kind":"theorem","name":"normalizedHamming_le_one","statement":"{Y : Type*} [Fintype Y] [DecidableEq Y] (p q : Equiv.Perm Y) : normalizedHamming p q ≤ 1"},{"kind":"theorem","name":"normalizedHamming_mul_left","statement":"{Y : Type*} [Fintype Y] [DecidableEq Y] (s p q : Equiv.Perm Y) : normalizedHamming (s * p) (s * q) = normalizedHamming p q"},{"kind":"theorem","name":"normalizedHamming_mul_right","statement":"{Y : Type*} [Fintype Y] [DecidableEq Y] (s p q : Equiv.Perm Y) : normalizedHamming (p * s) (q * s) = normalizedHamming p q"},{"kind":"theorem","name":"GoodOn.mono","statement":"{G : Type*} [Group G] {M : PermutationModel G} {F F' : Finset G} {ε : ℝ} (h : GoodOn M F' ε) (hF : F ⊆ F') : GoodOn M F ε where multiplicative g hg k hk"},{"kind":"theorem","name":"normalizedHamming_permCongr","statement":"{X Y : Type*} [Fintype X] [DecidableEq X] [Fintype Y] [DecidableEq Y] (e : X ≃ Y) (p q : Equiv.Perm X) : normalizedHamming (e.permCongr p) (e.permCongr q) = normalizedHamming p q"},{"kind":"theorem","name":"hammingDist_prodCongr_refl_left","statement":"{X Y : Type*} [Fintype X] [DecidableEq X] [Fintype Y] [DecidableEq Y] (p q : Equiv.Perm Y) : hammingDist (fun z : X × Y => ((Equiv.refl X).prodCongr p) z) (fun z : X × Y => ((Equiv.refl X).prodCongr q) z) = Fintype.card X * hammingDist (fun y => p y) (fun y => q y)"},{"kind":"theorem","name":"normalizedHamming_prodCongr_refl_left","statement":"{X Y : Type*} [Fintype X] [DecidableEq X] [Fintype Y] [DecidableEq Y] (hX : Fintype.card X ≠ 0) (p q : Equiv.Perm Y) : normalizedHamming ((Equiv.refl X).prodCongr p) ((Equiv.refl X).prodCongr q) = normalizedHamming p q"},{"kind":"theorem","name":"amplifyModel_normalizedHamming","statement":"{G : Type*} [Group G] (M : PermutationModel G) (k : ℕ) (hk : 0 < k) (g h : G) : normalizedHamming ((amplifyModel M k hk).action g) ((amplifyModel M k hk).action h) = normalizedHamming (M.action g) (M.action h)"},{"kind":"theorem","name":"amplifyModel_multiplicative_distance","statement":"{G : Type*} [Group G] (M : PermutationModel G) (k : ℕ) (hk : 0 < k) (g h : G) : normalizedHamming ((amplifyModel M k hk).action (g * h)) ((amplifyModel M k hk).action g * (amplifyModel M k hk).action h) = normalizedHamming (M.action (g * h)) (M.action g * M.action h)"},{"kind":"theorem","name":"amplifyModel_separation_distance","statement":"{G : Type*} [Group G] (M : PermutationModel G) (k : ℕ) (hk : 0 < k) (g : G) : normalizedHamming ((amplifyModel M k hk).action g) 1 = normalizedHamming (M.action g) 1"},{"kind":"theorem","name":"nonempty_soficApproximation_of_sofic","statement":"(G : Type*) [Group G] [Countable G] [Sofic G] : Nonempty (SoficApproximation G)"},{"kind":"theorem","name":"amplifyApproximation_size_tendsto","statement":"{G : Type*} [Group G] (A : SoficApproximation G) : Tendsto (fun n => (amplifyApproximation A).model n |>.size) atTop atTop"},{"kind":"theorem","name":"exists_soficApproximation_size_tendsto","statement":"(G : Type*) [Group G] [Countable G] [Sofic G] : ∃ A : SoficApproximation G, Tendsto (fun n => (A.model n).size) atTop atTop"},{"kind":"theorem","name":"sofic_of_injective","statement":"{G H : Type*} [Group G] [Group H] [Sofic G] (f : H →* G) (hf : Function.Injective f) : Sofic H"},{"kind":"theorem","name":"exists_finite_obstruction","statement":"{G : Type*} [Group G] (hG : ¬ Sofic G) : ∃ (F : Finset G) (ε : ℝ), 1 ∈ F ∧ 0 < ε ∧ ε < 1 ∧ ∀ M : PermutationModel G, ¬ GoodOn M F ε"},{"kind":"theorem","name":"mem_multiplicationTable_of_mem","statement":"{G : Type*} [Group G] {F : Finset G} {g : G} (hg : g ∈ F) : g ∈ multiplicationTable F"},{"kind":"theorem","name":"mul_mem_multiplicationTable","statement":"{G : Type*} [Group G] {F : Finset G} {g h : G} (hg : g ∈ F) (hh : h ∈ F) : g * h ∈ multiplicationTable F"},{"kind":"theorem","name":"tableGenerator_one","statement":"{G : Type*} [Group G] (F : Finset G) (h₁ : 1 ∈ F) : tableGenerator F h₁ ⟨1, mem_multiplicationTable_of_mem h₁⟩ = 1"},{"kind":"theorem","name":"tableGenerator_mul","statement":"{G : Type*} [Group G] (F : Finset G) (h₁ : 1 ∈ F) {g h : G} (hg : g ∈ F) (hh : h ∈ F) : tableGenerator F h₁ ⟨g, mem_multiplicationTable_of_mem hg⟩ * tableGenerator F h₁ ⟨h, mem_multiplicationTable_of_mem hh⟩ = tableGenerator F h₁ ⟨g * h, mul_mem_multiplicationTable hg hh⟩"},{"kind":"theorem","name":"tableEvaluation_generator","statement":"{G : Type*} [Group G] (F : Finset G) (h₁ : 1 ∈ F) (g : ↥(multiplicationTable F)) : tableEvaluation F h₁ (tableGenerator F h₁ g) = g.1"},{"kind":"theorem","name":"tableGenerator_ne_one","statement":"{G : Type*} [Group G] (F : Finset G) (h₁ : 1 ∈ F) {g : G} (hg : g ∈ F) (hne : g ≠ 1) : tableGenerator F h₁ ⟨g, mem_multiplicationTable_of_mem hg⟩ ≠ 1"},{"kind":"theorem","name":"tableGroup_finitelyPresented","statement":"{G : Type*} [Group G] (F : Finset G) (h₁ : 1 ∈ F) : Group.IsFinitelyPresented (tableGroup F h₁)"},{"kind":"theorem","name":"tableGenerator_mem_tableTestSet","statement":"{G : Type*} [Group G] (F : Finset G) (h₁ : 1 ∈ F) {g : G} (hg : g ∈ F) : tableGenerator F h₁ ⟨g, mem_multiplicationTable_of_mem hg⟩ ∈ tableTestSet F h₁"},{"kind":"theorem","name":"pullbackTableModel_action_of_mem","statement":"{G : Type*} [Group G] (F : Finset G) (h₁ : 1 ∈ F) (M : PermutationModel (tableGroup F h₁)) {g : G} (hg : g ∈ multiplicationTable F) : (pullbackTableModel F h₁ M).action g = M.action (tableGenerator F h₁ ⟨g, hg⟩)"},{"kind":"theorem","name":"goodOn_pullbackTableModel","statement":"{G : Type*} [Group G] (F : Finset G) (h₁ : 1 ∈ F) {ε : ℝ} (M : PermutationModel (tableGroup F h₁)) (hM : GoodOn M (tableTestSet F h₁) ε) : GoodOn (pullbackTableModel F h₁ M) F ε"},{"kind":"theorem","name":"tableGroup_not_sofic_of_obstruction","statement":"{G : Type*} [Group G] (F : Finset G) (h₁ : 1 ∈ F) (ε : ℝ) (hε : 0 < ε) (hε' : ε < 1) (hbad : ∀ M : PermutationModel G, ¬ GoodOn M F ε) : ¬ Sofic (tableGroup F h₁)"},{"kind":"theorem","name":"exists_nonsofic_finite_table","statement":"{G : Type u} [Group G] (hG : ¬ Sofic G) : ∃ (F : Finset G) (h₁ : 1 ∈ F), Group.IsFinitelyPresented (tableGroup F h₁) ∧ ¬ Sofic (tableGroup F h₁)"},{"kind":"theorem","name":"exists_finitelyPresented_not_sofic_of_not_sofic","statement":"{G : Type u} [Group G] (hG : ¬ Sofic G) : ∃ (H : Type u) (_ : Group H), Group.IsFinitelyPresented H ∧ ¬ Sofic H"},{"kind":"theorem","name":"mono","statement":"{s t : Finset G} {f : G → H} (h : LocalMultiplicativeOn t f) (hst : s ⊆ t) : LocalMultiplicativeOn s f where map_one"},{"kind":"theorem","name":"map_inv_of_mem","statement":"{s : Finset G} {f : G → H} (h : LocalMultiplicativeOn s f) {x : G} (hx : x ∈ s) (hi : x⁻¹ ∈ s) : f x⁻¹ = (f x)⁻¹"},{"kind":"theorem","name":"exists_local_word_control","statement":"{α : Type u} {G : Type v} [Group G] (φ : FreeGroup α →* G) (z : FreeGroup α) : ∃ s : Finset G, ∀ (H : Type w) [Group H] (f : G → H), LocalMultiplicativeOn s f → FreeGroup.lift (fun a => f (φ (FreeGroup.of a))) z = f (φ z)"},{"kind":"theorem","name":"agreementSet_card_add_hammingDist","statement":"{V : Type*} [Fintype V] [DecidableEq V] (c c' : Equiv.Perm V) : (agreementSet c c').card + hammingDist (fun x => c x) (fun x => c' x) = Fintype.card V"},{"kind":"theorem","name":"boundary_agreementSet_le_commutationDefect","statement":"{V ι : Type*} [Fintype V] [Fintype ι] [DecidableEq V] (σ : ι → Equiv.Perm V) (c c' : Equiv.Perm V) : boundary σ (agreementSet c c') ≤ permutationCommutationDefect σ c + permutationCommutationDefect σ c'"},{"kind":"theorem","name":"hamming_dichotomy_of_expansion","statement":"{V ι : Type*} [Fintype V] [Fintype ι] [DecidableEq V] (σ : ι → Equiv.Perm V) (h : ℝ) (hexp : ∀ A : Finset V, h * min (A.card : ℝ) ((Fintype.card V : ℝ) - A.card) ≤ (boundary σ A : ℝ)) (c c' : Equiv.Perm V) : h * (hammingDist (fun x => c x) (fun x => c' x) : ℝ) ≤ (permutationCommutationDefect σ c + permutationCommutationDefect σ c' : ℕ) ∨ h * ((Fintype.card V : ℝ) - hammingDist (fun x => c x) (fun x => c' x)) ≤ (permutationCommutationDefect σ c + permutationCommutationDefect σ c' : ℕ)"},{"kind":"theorem","name":"boundary_union_le","statement":"{V ι : Type*} [Fintype ι] [DecidableEq V] (σ : ι → Equiv.Perm V) (B E : Finset V) : boundary σ (B ∪ E) ≤ boundary σ B + inducedBoundary σ B E"},{"kind":"theorem","name":"boundary_le_induced_add_deleted","statement":"{V ι : Type*} [Fintype ι] [DecidableEq V] (σ : ι → Equiv.Perm V) (B E : Finset V) : boundary σ E ≤ inducedBoundary σ B E + Fintype.card ι * B.card"},{"kind":"theorem","name":"maximal_bad_cut_induced_lower","statement":"{V ι : Type*} [Fintype V] [Fintype ι] [DecidableEq V] (σ : ι → Equiv.Perm V) (B E : Finset V) (ell : ℝ) (hB : (boundary σ B : ℝ) ≤ ell * (B.card : ℝ)) (hmax : ∀ A : Finset V, 2 * A.card ≤ Fintype.card V → (boundary σ A : ℝ) < ell * (A.card : ℝ) → A.card ≤ B.card) (hdisj : Disjoint B E) (hne : E.Nonempty) (hhalf : 2 * (B ∪ E).card ≤ Fintype.card V) : ell * (E.card : ℝ) ≤ (inducedBoundary σ B E : ℝ)"},{"kind":"theorem","name":"bad_cut_card_bound","statement":"{γ ell a : ℝ} {N b q : ℕ} (hgap : ell < γ) (hadd : γ * (b : ℝ) - a * (N : ℝ) ≤ (q : ℝ)) (hbad : (q : ℝ) ≤ ell * (b : ℝ)) : (b : ℝ) ≤ a * (N : ℝ) / (γ - ell)"},{"kind":"theorem","name":"large_cut_lower","statement":"{γ ell a d N b e q : ℝ} (hgap : ell < γ) (hd : 0 ≤ d) (hN : 0 ≤ N) (hdeleted : (γ - ell) * b ≤ a * N) (hsmall : 2 * a * (2 * (γ - ell) + d) ≤ (γ - ell) ^ 2) (hlarge : N / 2 - b < e) (hcut : γ * e - a * N - d * b ≤ q) : ell * e ≤ q"},{"kind":"theorem","name":"prune_permutation_multigraph","statement":"{V ι : Type*} [Fintype V] [Fintype ι] [DecidableEq V] (σ : ι → Equiv.Perm V) (γ ell a : ℝ) (B : Finset V) (hgap : ell < γ) (hadd : ∀ A : Finset V, γ * min (A.card : ℝ) ((Fintype.card V : ℝ) - (A.card : ℝ)) - a * (Fintype.card V : ℝ) ≤ (boundary σ A : ℝ)) (hBhalf : 2 * B.card ≤ Fintype.card V) (hB : (boundary σ B : ℝ) ≤ ell * (B.card : ℝ)) (hmax : ∀ A : Finset V, 2 * A.card ≤ Fintype.card V → (boundary σ A : ℝ) < ell * (A.card : ℝ) → A.card ≤ B.card) (hsmall : 2 * a * (2 * (γ - ell) + (Fintype.card ι : ℝ)) ≤ (γ - ell) ^ 2) (E : Finset V) (hdisj : Disjoint B E) (hEhalf : 2 * E.card ≤ Fintype.card V - B.card) : ell * (E.card : ℝ) ≤ (inducedBoundary σ B E : ℝ)"},{"kind":"theorem","name":"exists_maximal_bad_cut","statement":"{V ι : Type*} [Fintype V] [Fintype ι] [DecidableEq V] (σ : ι → Equiv.Perm V) (ell : ℝ) : ∃ B : Finset V, 2 * B.card ≤ Fintype.card V ∧ (boundary σ B : ℝ) ≤ ell * (B.card : ℝ) ∧ ∀ A : Finset V, 2 * A.card ≤ Fintype.card V → (boundary σ A : ℝ) < ell * (A.card : ℝ) → A.card ≤ B.card"},{"kind":"theorem","name":"exists_pruned_expander","statement":"{V ι : Type*} [Fintype V] [Fintype ι] [DecidableEq V] (σ : ι → Equiv.Perm V) (γ ell a : ℝ) (hgap : ell < γ) (hadd : ∀ A : Finset V, γ * min (A.card : ℝ) ((Fintype.card V : ℝ) - (A.card : ℝ)) - a * (Fintype.card V : ℝ) ≤ (boundary σ A : ℝ)) (hsmall : 2 * a * (2 * (γ - ell) + (Fintype.card ι : ℝ)) ≤ (γ - ell) ^ 2) : ∃ B : Finset V, 2 * B.card ≤ Fintype.card V ∧ (B.card : ℝ) ≤ a * (Fintype.card V : ℝ) / (γ - ell) ∧ ∀ E : Finset V, Disjoint B E → 2 * E.card ≤ Fintype.card V - B.card → ell * (E.card : ℝ) ≤ (inducedBoundary σ B E : ℝ)"},{"kind":"theorem","name":"disjoint_dominant_intersections_false","statement":"{V : Type*} [DecidableEq V] (P Q D : Finset V) (hdisj : Disjoint P Q) (hP : D.card < 2 * (P ∩ D).card) (hQ : D.card < 2 * (Q ∩ D).card) : False"},{"kind":"theorem","name":"finpartition_dominant_matching_injOn","statement":"{V : Type*} [DecidableEq V] {U : Finset V} (P : Finpartition U) (R : Finset (Finset V)) (hR : R ⊆ P.parts) (D : Finset V → Finset V) (hmajor : ∀ C ∈ R, (D C).card < 2 * (C ∩ D C).card) : Set.InjOn D (R : Set (Finset V))"},{"kind":"theorem","name":"matchedRetainedSupport_subset","statement":"{V : Type*} [DecidableEq V] {U : Finset V} (P : Finpartition U) (R : Finset (Finset V)) (hR : R ⊆ P.parts) : matchedRetainedSupport R ⊆ U"},{"kind":"theorem","name":"matchedCore_subset_retainedSupport","statement":"{V : Type*} [DecidableEq V] (R : Finset (Finset V)) (D : Finset V → Finset V) : matchedCore R D ⊆ matchedRetainedSupport R"},{"kind":"theorem","name":"matchedCore_subset","statement":"{V : Type*} [DecidableEq V] {U : Finset V} (P : Finpartition U) (R : Finset (Finset V)) (hR : R ⊆ P.parts) (D : Finset V → Finset V) : matchedCore R D ⊆ U"},{"kind":"theorem","name":"matchedRetainedSupport_card","statement":"{V : Type*} [DecidableEq V] {U : Finset V} (P : Finpartition U) (R : Finset (Finset V)) (hR : R ⊆ P.parts) : (matchedRetainedSupport R).card = ∑ C ∈ R, C.card"},{"kind":"theorem","name":"matchedCore_card","statement":"{V : Type*} [DecidableEq V] {U : Finset V} (P : Finpartition U) (R : Finset (Finset V)) (hR : R ⊆ P.parts) (D : Finset V → Finset V) : (matchedCore R D).card = ∑ C ∈ R, (C ∩ D C).card"},{"kind":"theorem","name":"matchedCore_missing_card","statement":"{V : Type*} [DecidableEq V] {U : Finset V} (P : Finpartition U) (R : Finset (Finset V)) (hR : R ⊆ P.parts) (D : Finset V → Finset V) : (U \\ matchedCore R D).card = (U \\ matchedRetainedSupport R).card + ∑ C ∈ R, (C \\ D C).card"},{"kind":"theorem","name":"matchedCore_missing_card_le_symmDiff","statement":"{V : Type*} [DecidableEq V] {U : Finset V} (P : Finpartition U) (R : Finset (Finset V)) (hR : R ⊆ P.parts) (D : Finset V → Finset V) : (U \\ matchedCore R D).card ≤ (U \\ matchedRetainedSupport R).card + ∑ C ∈ R, (C ∆ D C).card"},{"kind":"theorem","name":"matched_partition_part_eq_of_target_part_eq","statement":"{V : Type*} [DecidableEq V] {U : Finset V} (P Q : Finpartition U) (R : Finset (Finset V)) (hR : R ⊆ P.parts) (D : Finset V → Finset V) (hD : ∀ C ∈ R, D C ∈ Q.parts) (hinj : Set.InjOn D (R : Set (Finset V))) {x y : V} (hx : x ∈ matchedCore R D) (hy : y ∈ matchedCore R D) (hpart : Q.part x = Q.part y) : P.part x = P.part y"},{"kind":"theorem","name":"matchedWordPreimageBad_card_le","statement":"{V : Type*} [DecidableEq V] (U : Finset V) (R : Finset (Finset V)) (D : Finset V → Finset V) (w : Equiv.Perm V) : (matchedWordPreimageBad U R D w).card ≤ (U \\ matchedCore R D).card"},{"kind":"theorem","name":"partitionWordCrossing_subset_target_or_unmatched","statement":"{V : Type*} [DecidableEq V] {U : Finset V} (P Q : Finpartition U) (R : Finset (Finset V)) (hR : R ⊆ P.parts) (D : Finset V → Finset V) (hD : ∀ C ∈ R, D C ∈ Q.parts) (hinj : Set.InjOn D (R : Set (Finset V))) (w : Equiv.Perm V) : partitionWordCrossing P w ⊆ partitionWordCrossing Q w ∪ (U \\ matchedCore R D) ∪ matchedWordPreimageBad U R D w"},{"kind":"theorem","name":"partitionWordCrossing_card_le_target_add_unmatched","statement":"{V : Type*} [DecidableEq V] {U : Finset V} (P Q : Finpartition U) (R : Finset (Finset V)) (hR : R ⊆ P.parts) (D : Finset V → Finset V) (hD : ∀ C ∈ R, D C ∈ Q.parts) (hinj : Set.InjOn D (R : Set (Finset V))) (w : Equiv.Perm V) : (partitionWordCrossing P w).card ≤ (partitionWordCrossing Q w).card + 2 * (U \\ matchedCore R D).card"},{"kind":"theorem","name":"matchedCore_missing_density_tendsto_zero","statement":"{V : ℕ → Type*} [∀ n, DecidableEq (V n)] (U : ∀ n, Finset (V n)) (P : ∀ n, Finpartition (U n)) (R : ∀ n, Finset (Finset (V n))) (hR : ∀ n, R n ⊆ (P n).parts) (D : ∀ n, Finset (V n) → Finset (V n)) (hdiscard : Tendsto (fun n => (((U n \\ matchedRetainedSupport (R n)).card : ℝ) / (U n).card)) atTop (𝓝 0)) (hsymm : Tendsto (fun n => ((∑ C ∈ R n, (C ∆ D n C).card : ℕ) : ℝ) / (U n).card) atTop (𝓝 0)) : Tendsto (fun n => (((U n \\ matchedCore (R n) (D n)).card : ℝ) / (U n).card)) atTop (𝓝 0)"},{"kind":"theorem","name":"permutation_increment_sum_eq_zero","statement":"{α : Type*} [Fintype α] (p : Equiv.Perm α) (f : α → ℝ) : ∑ x, (f (p x) - f x) = 0"},{"kind":"theorem","name":"permutation_squared_increment_le_twice_decreasing","statement":"{α : Type*} [Fintype α] (p : Equiv.Perm α) (f : α → ℝ) (hf_nonneg : ∀ x, 0 ≤ f x) (hf_le_one : ∀ x, f x ≤ 1) : ∑ x, (f (p x) - f x) ^ 2 ≤ 2 * ((Finset.univ.filter fun x => f (p x) < f x).card : ℝ)"},{"kind":"theorem","name":"exists_completion_of_internal_permutation","statement":"{V : Type*} [Fintype V] (p : Equiv.Perm V) (Z : Finset V) : ∃ q : Equiv.Perm {x : V // x ∈ Z}, ∀ (x : V) (hx : x ∈ Z) (_hp : p x ∈ Z), (q ⟨x, hx⟩ : V) = p x"},{"kind":"theorem","name":"diagonalRadius_tendsto_atTop","statement":"(e : ℕ → ℕ → ℝ) (he : ∀ k, Tendsto (fun n => e n k) atTop (𝓝 0)) : Tendsto (diagonalRadius e) atTop atTop"},{"kind":"theorem","name":"diagonalRadius_eventually_error_lt","statement":"(e : ℕ → ℕ → ℝ) (he : ∀ k, Tendsto (fun n => e n k) atTop (𝓝 0)) : ∀ᶠ n in atTop, e n (diagonalRadius e n) < 1 / ((diagonalRadius e n : ℝ) + 1)"},{"kind":"theorem","name":"diagonalRadius_error_tendsto_zero","statement":"(e : ℕ → ℕ → ℝ) (hnonneg : ∀ n k, 0 ≤ e n k) (he : ∀ k, Tendsto (fun n => e n k) atTop (𝓝 0)) : Tendsto (fun n => e n (diagonalRadius e n)) atTop (𝓝 0)"},{"kind":"theorem","name":"exists_diverging_radius_with_vanishing_diagonal_error","statement":"(e : ℕ → ℕ → ℝ) (hnonneg : ∀ n k, 0 ≤ e n k) (he : ∀ k, Tendsto (fun n => e n k) atTop (𝓝 0)) : ∃ r : ℕ → ℕ, Tendsto r atTop atTop ∧ Tendsto (fun n => e n (r n)) atTop (𝓝 0)"},{"kind":"theorem","name":"finite_union_bad_density_tendsto_zero","statement":"{α : ℕ → Type*} [∀ n, DecidableEq (α n)] {ι : Type*} (I : Finset ι) (V : ∀ n, Finset (α n)) (B : ∀ n, ι → Finset (α n)) (hbad : ∀ i ∈ I, Tendsto (fun n => (((V n ∩ B n i).card : ℝ) / (V n).card)) atTop (𝓝 0)) : Tendsto (fun n => (((V n ∩ I.biUnion (B n)).card : ℝ) / (V n).card)) atTop (𝓝 0)"},{"kind":"theorem","name":"sum_card_inter_partition","statement":"{α : Type*} [DecidableEq α] {U : Finset α} (P : Finpartition U) (B : Finset α) : ∑ C ∈ P.parts, (C ∩ B).card = (U ∩ B).card"},{"kind":"theorem","name":"retained_bad_density_tendsto_zero","statement":"{α : ℕ → Type*} [∀ n, DecidableEq (α n)] (V U B : ∀ n, Finset (α n)) (hV : ∀ n, (V n).Nonempty) (hU : ∀ n, (U n).Nonempty) (hUV : ∀ n, U n ⊆ V n) (hcover : Tendsto (fun n => ((U n).card : ℝ) / (V n).card) atTop (𝓝 1)) (hbad : Tendsto (fun n => (((V n ∩ B n).card : ℝ) / (V n).card)) atTop (𝓝 0)) : Tendsto (fun n => (((U n ∩ B n).card : ℝ) / (U n).card)) atTop (𝓝 0)"},{"kind":"theorem","name":"leavittT_mul_S","statement":"(i j : Fin 2) : leavittT i * leavittS j = if i = j then 1 else 0"},{"kind":"theorem","name":"leavitt_partition","statement":"leavittS 0 * leavittT 0 + leavittS 1 * leavittT 1 = 1"},{"kind":"theorem","name":"deletion_mul_prefix","statement":"(i j : Fin 2) : deletionOperator i * prefixOperator j = if i = j then 1 else 0"},{"kind":"theorem","name":"prefix_deletion_partition","statement":"prefixOperator 0 * deletionOperator 0 + prefixOperator 1 * deletionOperator 1 = 1"},{"kind":"theorem","name":"leavittFreeRepresentation_respects","statement":"{x y : LeavittFree} (h : LeavittRelation x y) : leavittFreeRepresentation x = leavittFreeRepresentation y"},{"kind":"theorem","name":"prefix_deletion_ne_one","statement":"prefixOperator 0 * deletionOperator 0 ≠ 1"},{"kind":"theorem","name":"leavittS_mul_T_ne_one","statement":"leavittS 0 * leavittT 0 ≠ 1"},{"kind":"theorem","name":"leavittWordT_mul_wordS_self","statement":"(a : List (Fin 2)) : leavittWordT a * leavittWordS a = 1"},{"kind":"theorem","name":"leavittWordT_mul_wordS_of_incomparable","statement":"(a b : List (Fin 2)) (hab : ¬a <+: b) (hba : ¬b <+: a) : leavittWordT a * leavittWordS b = 0"},{"kind":"theorem","name":"leavittWordS_append","statement":"(a b : List (Fin 2)) : leavittWordS (a ++ b) = leavittWordS a * leavittWordS b"},{"kind":"theorem","name":"leavittWordT_append","statement":"(a b : List (Fin 2)) : leavittWordT (a ++ b) = leavittWordT b * leavittWordT a"},{"kind":"theorem","name":"leavittCylinder_split","statement":"(a : List (Fin 2)) : leavittCylinder a = leavittCylinder (a ++ [0]) + leavittCylinder (a ++ [1])"},{"kind":"theorem","name":"decode_encode","statement":"[DecidableEq ι] (s t : ι → A) (h : ∀ i j, t i * s j = if i = j then 1 else 0) (M : Matrix ι ι A) : decode s t (encode s t M) = M"},{"kind":"theorem","name":"encode_decode","statement":"(s t : ι → A) (x : A) : encode s t (decode s t x) = codeIdempotent s t * x * codeIdempotent s t"},{"kind":"theorem","name":"codeIdempotent_isIdempotent","statement":"[DecidableEq ι] (s t : ι → A) (h : ∀ i j, t i * s j = if i = j then 1 else 0) : IsIdempotentElem (codeIdempotent s t)"},{"kind":"theorem","name":"encode_one","statement":"[DecidableEq ι] (s t : ι → A) : encode s t (1 : Matrix ι ι A) = codeIdempotent s t"},{"kind":"theorem","name":"encode_mul","statement":"[DecidableEq ι] (s t : ι → A) (h : ∀ i j, t i * s j = if i = j then 1 else 0) (M N : Matrix ι ι A) : encode s t (M * N) = encode s t M * encode s t N"},{"kind":"theorem","name":"binaryPrefixCode_orthogonal","statement":"{ι : Type*} [DecidableEq ι] (E : BinaryPrefixCode ι) (i j : ι) : leavittWordT (E.word i) * leavittWordS (E.word j) = if i = j then 1 else 0"},{"kind":"theorem","name":"prefixTable_mul_reverse","statement":"{ι : Type*} [Fintype ι] [DecidableEq ι] (source target : BinaryPrefixCode ι) : prefixTable source target * prefixTable target source = MatrixCorner.codeIdempotent (fun i => leavittWordS (target.word i)) (fun i => leavittWordT (target.word i))"},{"kind":"theorem","name":"alpha_cylinders","statement":"leavittCylinder (alphaWord 0) + leavittCylinder (alphaWord 1) + leavittCylinder (alphaWord 2) = leavittCylinder [0]"},{"kind":"theorem","name":"beta_cylinders","statement":"leavittCylinder (betaWord 0) + leavittCylinder (betaWord 1) + leavittCylinder (betaWord 2) = leavittCylinder [1, 0]"},{"kind":"theorem","name":"nu_cylinders","statement":"leavittCylinder (nuWord 0) + leavittCylinder (nuWord 1) + leavittCylinder (nuWord 2) = leavittCylinder [1, 1]"},{"kind":"theorem","name":"eta_cylinders","statement":"leavittCylinder (etaWord 0) + leavittCylinder (etaWord 1) + leavittCylinder (etaWord 2) = leavittCylinder [1]"},{"kind":"theorem","name":"ninePrefixCode_complete","statement":"MatrixCorner.codeIdempotent (fun i => leavittWordS (ninePrefixCode.word i)) (fun i => leavittWordT (ninePrefixCode.word i)) = 1"},{"kind":"theorem","name":"uPrefixCode_complete","statement":"MatrixCorner.codeIdempotent (fun i => leavittWordS (uPrefixCode.word i)) (fun i => leavittWordT (uPrefixCode.word i)) = 1"},{"kind":"theorem","name":"vPrefixCode_complete","statement":"MatrixCorner.codeIdempotent (fun i => leavittWordS (vPrefixCode.word i)) (fun i => leavittWordT (vPrefixCode.word i)) = 1"},{"kind":"theorem","name":"matrixUnitTransport_root","statement":"{A ι : Type*} [Ring A] [Fintype ι] [DecidableEq ι] (sSource tSource sTarget tTarget : ι → A) (hsource : ∀ i j, tSource i * sSource j = if i = j then 1 else 0) (i j : ι) (a : A) : (∑ k, sTarget k * tSource k) * (sSource i * a * tSource j) * (∑ k, sSource k * tTarget k) = sTarget i * a * tTarget j"},{"kind":"theorem","name":"prefixTable_transport_root","statement":"{ι : Type*} [Fintype ι] [DecidableEq ι] (source target : BinaryPrefixCode ι) (i j : ι) (a : BinaryLeavitt) : prefixTable source target * (leavittWordS (source.word i) * a * leavittWordT (source.word j)) * prefixTable target source = leavittWordS (target.word i) * a * leavittWordT (target.word j)"},{"kind":"theorem","name":"compressionU_conjugate_root","statement":"(i j : Fin 9) (a : BinaryLeavitt) : (compressionU : BinaryLeavitt) * (leavittWordS (nineWord i) * a * leavittWordT (nineWord j)) * (↑(compressionU⁻¹) : BinaryLeavitt) = leavittWordS (uWord i) * a * leavittWordT (uWord j)"},{"kind":"theorem","name":"compressionV_conjugate_root","statement":"(i j : Fin 9) (a : BinaryLeavitt) : (compressionV : BinaryLeavitt) * (leavittWordS (nineWord i) * a * leavittWordT (nineWord j)) * (↑(compressionV⁻¹) : BinaryLeavitt) = leavittWordS (vWord i) * a * leavittWordT (vWord j)"},{"kind":"theorem","name":"nineWord_alphaNineIndex","statement":"(i : Fin 3) : nineWord (alphaNineIndex i) = alphaWord i"},{"kind":"theorem","name":"uWord_alphaNineIndex","statement":"(i : Fin 3) : uWord (alphaNineIndex i) = alphaWord i ++ [0]"},{"kind":"theorem","name":"vWord_alphaNineIndex","statement":"(i : Fin 3) : vWord (alphaNineIndex i) = alphaWord i ++ [0]"},{"kind":"theorem","name":"compressionU_conjugate_alpha_root","statement":"(i j : Fin 3) (a : BinaryLeavitt) : (compressionU : BinaryLeavitt) * (leavittWordS (alphaWord i) * a * leavittWordT (alphaWord j)) * (↑(compressionU⁻¹) : BinaryLeavitt) = leavittWordS (alphaWord i ++ [0]) * a * leavittWordT (alphaWord j ++ [0])"},{"kind":"theorem","name":"compressionV_conjugate_alpha_root","statement":"(i j : Fin 3) (a : BinaryLeavitt) : (compressionV : BinaryLeavitt) * (leavittWordS (alphaWord i) * a * leavittWordT (alphaWord j)) * (↑(compressionV⁻¹) : BinaryLeavitt) = leavittWordS (alphaWord i ++ [0]) * a * leavittWordT (alphaWord j ++ [0])"},{"kind":"theorem","name":"compressionU_conjugate_alpha_elementaryUnit","statement":"(i j : Fin 3) (hij : i ≠ j) (a : BinaryLeavitt) : MulAut.conj compressionU (prefixElementaryUnit alphaPrefixCode i j hij a) = prefixElementaryUnit alphaZeroPrefixCode i j hij a"},{"kind":"theorem","name":"compressionV_conjugate_alpha_elementaryUnit","statement":"(i j : Fin 3) (hij : i ≠ j) (a : BinaryLeavitt) : MulAut.conj compressionV (prefixElementaryUnit alphaPrefixCode i j hij a) = prefixElementaryUnit alphaZeroPrefixCode i j hij a"},{"kind":"theorem","name":"prefixElementaryGroup_map_conj","statement":"{ι : Type*} [DecidableEq ι] (E E' : BinaryPrefixCode ι) (g : BinaryLeavittˣ) (hconj : ∀ (i j : ι) (hij : i ≠ j) (a : BinaryLeavitt), MulAut.conj g (prefixElementaryUnit E i j hij a) = prefixElementaryUnit E' i j hij a) : (prefixElementaryGroup E).map (MulAut.conj g).toMonoidHom = prefixElementaryGroup E'"},{"kind":"theorem","name":"compressionU_map_alphaPrefixElementaryGroup","statement":"(prefixElementaryGroup alphaPrefixCode).map (MulAut.conj compressionU).toMonoidHom = prefixElementaryGroup alphaZeroPrefixCode"},{"kind":"theorem","name":"compressionV_map_alphaPrefixElementaryGroup","statement":"(prefixElementaryGroup alphaPrefixCode).map (MulAut.conj compressionV).toMonoidHom = prefixElementaryGroup alphaZeroPrefixCode"},{"kind":"theorem","name":"alphaZero_prefixElementaryUnit_eq","statement":"(i j : Fin 3) (hij : i ≠ j) (a : BinaryLeavitt) : prefixElementaryUnit alphaZeroPrefixCode i j hij a = prefixElementaryUnit alphaPrefixCode i j hij (leavittS 0 * a * leavittT 0)"},{"kind":"theorem","name":"alphaZero_prefixElementaryGroup_le","statement":"prefixElementaryGroup alphaZeroPrefixCode ≤ prefixElementaryGroup alphaPrefixCode"},{"kind":"theorem","name":"single_mul_self_eq_zero","statement":"(i j : ι) (h : i ≠ j) (a : R) : Matrix.single i j a * Matrix.single i j a = 0"},{"kind":"theorem","name":"elementaryUnit_mul","statement":"(i j : ι) (h : i ≠ j) (a b : R) : elementaryUnit i j h a * elementaryUnit i j h b = elementaryUnit i j h (a + b)"},{"kind":"theorem","name":"elementaryUnit_injective","statement":"(i j : ι) (h : i ≠ j) : Function.Injective (elementaryUnit (R"},{"kind":"theorem","name":"elementaryUnit_mem","statement":"(i j : ι) (h : i ≠ j) (a : R) : elementaryUnit i j h a ∈ elementaryGroup ι R"},{"kind":"theorem","name":"elementaryGroup_infinite","statement":"[Infinite R] (i j : ι) (h : i ≠ j) : Infinite (elementaryGroup ι R)"},{"kind":"theorem","name":"cylinder_transposition_factorization","statement":"[CharP R 2] (P Q : R) (hPP : P * P = 0) (hPQP : P * Q * P = P) : (1 + P) * (1 + Q) * (1 + P) = 1 - P * Q - Q * P + P + Q"},{"kind":"theorem","name":"elementaryUnit_commutator","statement":"(i j k : ι) (hij : i ≠ j) (hjk : j ≠ k) (hik : i ≠ k) (a b : R) : ⁅elementaryUnit i j hij a, elementaryUnit j k hjk b⁆ = elementaryUnit i k hik (a * b)"},{"kind":"theorem","name":"elementaryUnit_mem_of_two_step","statement":"(H : Subgroup (Matrix ι ι R)ˣ) (i j k : ι) (hij : i ≠ j) (hjk : j ≠ k) (hik : i ≠ k) (a : R) (hleft : elementaryUnit i j hij a ∈ H) (hright : elementaryUnit j k hjk 1 ∈ H) : elementaryUnit i k hik a ∈ H"},{"kind":"theorem","name":"mem_finiteElementaryGenerators","statement":"[DecidableEq R] (n : ℕ) (s : Finset R) (z : (Matrix (Fin n) (Fin n) R)ˣ) : z ∈ finiteElementaryGenerators n s ↔ ∃ (i j : Fin n) (h : i ≠ j) (a : R), a ∈ insert 1 s ∧ elementaryUnit i j h a = z"},{"kind":"theorem","name":"elementaryGroup_finitelyGenerated","statement":"[Algebra.FiniteType (ZMod 2) R] (n : ℕ) (hn : 2 < n) : Group.FG (elementaryGroup (Fin n) R)"},{"kind":"theorem","name":"elementaryGroup_three_finitelyGenerated","statement":"[Algebra.FiniteType (ZMod 2) R] : Group.FG (elementaryGroup (Fin 3) R)"},{"kind":"theorem","name":"completePrefixUnitEquiv_elementaryUnit","statement":"{ι : Type*} [Fintype ι] [DecidableEq ι] (E : BinaryPrefixCode ι) (hcomplete : MatrixCorner.codeIdempotent (fun i => leavittWordS (E.word i)) (fun i => leavittWordT (E.word i)) = 1) (i j : ι) (hij : i ≠ j) (a : BinaryLeavitt) : completePrefixUnitEquiv E hcomplete (elementaryUnit i j hij a) = prefixElementaryUnit E i j hij a"},{"kind":"theorem","name":"completePrefixElementaryGroup_map","statement":"{ι : Type*} [Fintype ι] [DecidableEq ι] (E : BinaryPrefixCode ι) (hcomplete : MatrixCorner.codeIdempotent (fun i => leavittWordS (E.word i)) (fun i => leavittWordT (E.word i)) = 1) : (elementaryGroup ι BinaryLeavitt).map (completePrefixUnitEquiv E hcomplete).toMonoidHom = prefixElementaryGroup E"},{"kind":"theorem","name":"idempotentCornerUnitExtension_injective","statement":"{A : Type*} [Ring A] {e : A} (he : IsIdempotentElem e) : Function.Injective (idempotentCornerUnitExtension he)"},{"kind":"theorem","name":"prefixCornerUnitHom_injective","statement":"{ι : Type*} [Fintype ι] [DecidableEq ι] (E : BinaryPrefixCode ι) : Function.Injective (prefixCornerUnitHom E)"},{"kind":"theorem","name":"prefixCornerUnitHom_elementaryUnit","statement":"{ι : Type*} [Fintype ι] [DecidableEq ι] (E : BinaryPrefixCode ι) (i j : ι) (hij : i ≠ j) (a : BinaryLeavitt) : prefixCornerUnitHom E (elementaryUnit i j hij a) = prefixElementaryUnit E i j hij a"},{"kind":"theorem","name":"prefixCornerElementaryGroup_map","statement":"{ι : Type*} [Fintype ι] [DecidableEq ι] (E : BinaryPrefixCode ι) : (elementaryGroup ι BinaryLeavitt).map (prefixCornerUnitHom E) = prefixElementaryGroup E"},{"kind":"theorem","name":"alphaRoot_mem_sourceGenerated","statement":"(i j : Fin 3) (hij : i ≠ j) (a : BinaryLeavitt) : prefixElementaryUnit alphaPrefixCode i j hij a ∈ sourceGeneratedGroup"},{"kind":"theorem","name":"compressionU_mem_sourceGenerated","statement":"compressionU ∈ sourceGeneratedGroup"},{"kind":"theorem","name":"compressionV_mem_sourceGenerated","statement":"compressionV ∈ sourceGeneratedGroup"},{"kind":"theorem","name":"prefixTable_mul_wordS","statement":"{ι : Type*} [Fintype ι] [DecidableEq ι] (source target : BinaryPrefixCode ι) (i : ι) : prefixTable source target * leavittWordS (source.word i) = leavittWordS (target.word i)"},{"kind":"theorem","name":"wordT_mul_prefixTable","statement":"{ι : Type*} [Fintype ι] [DecidableEq ι] (source target : BinaryPrefixCode ι) (i : ι) : leavittWordT (target.word i) * prefixTable source target = leavittWordT (source.word i)"},{"kind":"theorem","name":"leavittWordS_split","statement":"(a : List (Fin 2)) : leavittWordS a = leavittWordS (a ++ [0]) * leavittT 0 + leavittWordS (a ++ [1]) * leavittT 1"},{"kind":"theorem","name":"leavittWordT_split","statement":"(a : List (Fin 2)) : leavittWordT a = leavittS 0 * leavittWordT (a ++ [0]) + leavittS 1 * leavittWordT (a ++ [1])"},{"kind":"theorem","name":"compressionU_inv_mul_alphaWordS","statement":"(i : Fin 3) : (↑(compressionU⁻¹) : BinaryLeavitt) * leavittWordS (alphaWord i) = leavittWordS (alphaWord i) * leavittT 0 + leavittWordS (betaWord i) * leavittT 1"},{"kind":"theorem","name":"alphaWordT_mul_compressionU","statement":"(i : Fin 3) : leavittWordT (alphaWord i) * (compressionU : BinaryLeavitt) = leavittS 0 * leavittWordT (alphaWord i) + leavittS 1 * leavittWordT (betaWord i)"},{"kind":"theorem","name":"alphaBetaNineIndex_ne","statement":"{i j : Fin 3} (hij : i ≠ j) (p q : Fin 2) : alphaBetaNineIndex p i ≠ alphaBetaNineIndex q j"},{"kind":"theorem","name":"binaryBlockSandwich","statement":"(x₀ x₁ y₀ y₁ a : BinaryLeavitt) (p q : Fin 2) : (x₀ * leavittT 0 + x₁ * leavittT 1) * (leavittS p * a * leavittT q) * (leavittS 0 * y₀ + leavittS 1 * y₁) = (if p = 0 then x₀ else x₁) * a * (if q = 0 then y₀ else y₁)"},{"kind":"theorem","name":"alphaBetaRoot_mem_sourceGenerated","statement":"(i j : Fin 3) (hij : i ≠ j) (p q : Fin 2) (a : BinaryLeavitt) : prefixElementaryUnit ninePrefixCode (alphaBetaNineIndex p i) (alphaBetaNineIndex q j) (alphaBetaNineIndex_ne hij p q) a ∈ sourceGeneratedGroup"},{"kind":"theorem","name":"prefixElementaryEntry_mul","statement":"{ι : Type*} [DecidableEq ι] (E : BinaryPrefixCode ι) (i j k l : ι) (a b : BinaryLeavitt) : prefixElementaryEntry E i j a * prefixElementaryEntry E k l b = if j = k then prefixElementaryEntry E i l (a * b) else 0"},{"kind":"theorem","name":"prefixElementaryUnit_commutator","statement":"{ι : Type*} [DecidableEq ι] (E : BinaryPrefixCode ι) (i j k : ι) (hij : i ≠ j) (hjk : j ≠ k) (hik : i ≠ k) (a b : BinaryLeavitt) : ⁅prefixElementaryUnit E i j hij a, prefixElementaryUnit E j k hjk b⁆ = prefixElementaryUnit E i k hik (a * b)"},{"kind":"theorem","name":"prefixElementaryUnit_mem_of_two_step","statement":"{ι : Type*} [DecidableEq ι] (E : BinaryPrefixCode ι) (H : Subgroup BinaryLeavittˣ) (i j k : ι) (hij : i ≠ j) (hjk : j ≠ k) (hik : i ≠ k) (a : BinaryLeavitt) (hleft : prefixElementaryUnit E i j hij a ∈ H) (hright : prefixElementaryUnit E j k hjk 1 ∈ H) : prefixElementaryUnit E i k hik a ∈ H"},{"kind":"theorem","name":"prefixElementaryGroup_le_of_hub","statement":"{ι : Type*} [DecidableEq ι] (E : BinaryPrefixCode ι) (H : Subgroup BinaryLeavittˣ) (k : ι) (hto : ∀ (i : ι) (h : i ≠ k) (a : BinaryLeavitt), prefixElementaryUnit E i k h a ∈ H) (hfrom : ∀ (j : ι) (h : k ≠ j) (a : BinaryLeavitt), prefixElementaryUnit E k j h a ∈ H) : prefixElementaryGroup E ≤ H"},{"kind":"theorem","name":"compressionV_inv_mul_alphaWordS","statement":"(i : Fin 3) : (↑(compressionV⁻¹) : BinaryLeavitt) * leavittWordS (alphaWord i) = leavittWordS (alphaWord i) * leavittT 0 + leavittWordS (nuWord i) * leavittT 1"},{"kind":"theorem","name":"alphaWordT_mul_compressionV","statement":"(i : Fin 3) : leavittWordT (alphaWord i) * (compressionV : BinaryLeavitt) = leavittS 0 * leavittWordT (alphaWord i) + leavittS 1 * leavittWordT (nuWord i)"},{"kind":"theorem","name":"alphaNuNineIndex_ne","statement":"{i j : Fin 3} (hij : i ≠ j) (p q : Fin 2) : alphaNuNineIndex p i ≠ alphaNuNineIndex q j"},{"kind":"theorem","name":"alphaNuRoot_mem_sourceGenerated","statement":"(i j : Fin 3) (hij : i ≠ j) (p q : Fin 2) (a : BinaryLeavitt) : prefixElementaryUnit ninePrefixCode (alphaNuNineIndex p i) (alphaNuNineIndex q j) (alphaNuNineIndex_ne hij p q) a ∈ sourceGeneratedGroup"},{"kind":"theorem","name":"nineRoot_to_alphaHub_mem_sourceGenerated","statement":"(i : Fin 9) (hi : i ≠ 0) (a : BinaryLeavitt) : prefixElementaryUnit ninePrefixCode i 0 hi a ∈ sourceGeneratedGroup"},{"kind":"theorem","name":"nineRoot_from_alphaHub_mem_sourceGenerated","statement":"(i : Fin 9) (hi : (0 : Fin 9) ≠ i) (a : BinaryLeavitt) : prefixElementaryUnit ninePrefixCode 0 i hi a ∈ sourceGeneratedGroup"},{"kind":"theorem","name":"ninePrefixElementaryGroup_le_sourceGenerated","statement":"prefixElementaryGroup ninePrefixCode ≤ sourceGeneratedGroup"},{"kind":"theorem","name":"alphaNineIndex_ne","statement":"{i j : Fin 3} (hij : i ≠ j) : alphaNineIndex i ≠ alphaNineIndex j"},{"kind":"theorem","name":"alphaPrefixElementaryUnit_eq_nine","statement":"(i j : Fin 3) (hij : i ≠ j) (a : BinaryLeavitt) : prefixElementaryUnit alphaPrefixCode i j hij a = prefixElementaryUnit ninePrefixCode (alphaNineIndex i) (alphaNineIndex j) (alphaNineIndex_ne hij) a"},{"kind":"theorem","name":"alphaPrefixElementaryGroup_le_nine","statement":"prefixElementaryGroup alphaPrefixCode ≤ prefixElementaryGroup ninePrefixCode"},{"kind":"theorem","name":"sourceGeneratedGroup_le_nine_of_compressions","statement":"(hu : compressionU ∈ prefixElementaryGroup ninePrefixCode) (hv : compressionV ∈ prefixElementaryGroup ninePrefixCode) : sourceGeneratedGroup ≤ prefixElementaryGroup ninePrefixCode"},{"kind":"theorem","name":"sourceGeneratedGroup_eq_nine_of_compressions","statement":"(hu : compressionU ∈ prefixElementaryGroup ninePrefixCode) (hv : compressionV ∈ prefixElementaryGroup ninePrefixCode) : sourceGeneratedGroup = prefixElementaryGroup ninePrefixCode"},{"kind":"theorem","name":"binaryLeavittMatrixUnitSubgroup_countable","statement":"(n : ℕ) (H : Subgroup (Matrix (Fin n) (Fin n) BinaryLeavitt)ˣ) : Countable H"},{"kind":"theorem","name":"binaryLeavittEL3_finitelyGenerated","statement":"Group.FG (binaryLeavittElementaryGroup 3)"},{"kind":"theorem","name":"binaryLeavittEL3_infinite","statement":"Infinite (binaryLeavittElementaryGroup 3)"},{"kind":"theorem","name":"alphaPrefixElementaryGroup_finitelyGenerated","statement":"Group.FG (prefixElementaryGroup alphaPrefixCode)"},{"kind":"theorem","name":"ninePrefixElementaryGroup_countable","statement":"Countable (prefixElementaryGroup ninePrefixCode)"},{"kind":"theorem","name":"midrankFirstMoment_eq","statement":"(a : ℝ) (ps : List ℝ) : midrankFirstMoment a ps = ((a + ps.sum) ^ 2 - a ^ 2) / 2"},{"kind":"theorem","name":"midrankSecondMoment_eq","statement":"(a : ℝ) (ps : List ℝ) : midrankSecondMoment a ps = ((a + ps.sum) ^ 3 - a ^ 3) / 3 - (ps.map fun p => p ^ 3).sum / 12"},{"kind":"theorem","name":"midrankVariance_eq","statement":"(ps : List ℝ) (hsum : ps.sum = 1) : midrankVariance ps = (1 - (ps.map fun p => p ^ 3).sum) / 12"},{"kind":"theorem","name":"cubeSum_le_dominant_mul_sum","statement":"(ps : List ℝ) (m : ℝ) (hpos : ∀ p ∈ ps, 0 ≤ p) (hone : ∀ p ∈ ps, p ≤ 1) (hdom : ∀ p ∈ ps, p ≤ m) : (ps.map fun p => p ^ 3).sum ≤ m * ps.sum"},{"kind":"theorem","name":"cube_sum_le_dominant_mass","statement":"(ps : List ℝ) (m : ℝ) (hsum : ps.sum = 1) (hpos : ∀ p ∈ ps, 0 ≤ p) (hdom : ∀ p ∈ ps, p ≤ m) : (ps.map fun p => p ^ 3).sum ≤ m"},{"kind":"theorem","name":"midrankVariance_controls_dominant_mass","statement":"(ps : List ℝ) (m : ℝ) (hsum : ps.sum = 1) (hpos : ∀ p ∈ ps, 0 ≤ p) (hdom : ∀ p ∈ ps, p ≤ m) : (1 - m) / 12 ≤ midrankVariance ps"},{"kind":"theorem","name":"weighted_midrank_dominant_mass_le","statement":"{ι : Type*} (I : Finset ι) (weight : ι → ℝ) (q : ι → List ℝ) (m : ι → ℝ) (hweight : ∀ i ∈ I, 0 ≤ weight i) (hsum : ∀ i ∈ I, (q i).sum = 1) (hpositive : ∀ i ∈ I, ∀ x ∈ q i, 0 ≤ x) (hdominant : ∀ i ∈ I, ∀ x ∈ q i, x ≤ m i) : (∑ i ∈ I, weight i * (1 - m i)) ≤ 12 * ∑ i ∈ I, weight i * midrankVariance (q i)"},{"kind":"theorem","name":"componentVertexMidrank_eq_sum_componentRankMass","statement":"{V : Type*} (C : Finset V) (b : V → ℤ) (x : V) : componentVertexMidrank C b x = (∑ j ∈ (C.image b).filter (fun j => j < b x), componentRankMass C b j) + componentRankMass C b (b x) / 2"},{"kind":"theorem","name":"componentRankMass_nonneg","statement":"{V : Type*} (C : Finset V) (b : V → ℤ) (j : ℤ) : 0 ≤ componentRankMass C b j"},{"kind":"theorem","name":"sum_componentRankMass","statement":"{V : Type*} (C : Finset V) (b : V → ℤ) (hC : C.Nonempty) : (∑ j ∈ C.image b, componentRankMass C b j) = 1"},{"kind":"theorem","name":"componentVertexMidrank_nonneg","statement":"{V : Type*} (C : Finset V) (b : V → ℤ) (x : V) : 0 ≤ componentVertexMidrank C b x"},{"kind":"theorem","name":"component_lower_equal_disjoint","statement":"{V : Type*} (C : Finset V) (b : V → ℤ) (x : V) : Disjoint (C.filter fun z => b z < b x) (C.filter fun z => b z = b x)"},{"kind":"theorem","name":"componentVertexMidrank_le_one","statement":"{V : Type*} (C : Finset V) (b : V → ℤ) (x : V) : componentVertexMidrank C b x ≤ 1"},{"kind":"theorem","name":"componentVertexMidrank_mono","statement":"{V : Type*} (C : Finset V) (b : V → ℤ) {x y : V} (hxy : b x ≤ b y) : componentVertexMidrank C b x ≤ componentVertexMidrank C b y"},{"kind":"theorem","name":"sum_map_sort_eq","statement":"{α : Type*} [LinearOrder α] (s : Finset α) (f : α → ℝ) : ((s.sort (· ≤ ·)).map f).sum = ∑ a ∈ s, f a"},{"kind":"theorem","name":"componentRankMassList_sum","statement":"{V : Type*} (C : Finset V) (b : V → ℤ) (hC : C.Nonempty) : (componentRankMassList C b).sum = 1"},{"kind":"theorem","name":"componentRankMassList_nonneg","statement":"{V : Type*} (C : Finset V) (b : V → ℤ) : ∀ p ∈ componentRankMassList C b, 0 ≤ p"},{"kind":"theorem","name":"componentRankMassList_le_max","statement":"{V : Type*} (C : Finset V) (b : V → ℤ) (j : ℤ) (hmax : ∀ k ∈ C.image b, componentRankMass C b k ≤ componentRankMass C b j) : ∀ p ∈ componentRankMassList C b, p ≤ componentRankMass C b j"},{"kind":"theorem","name":"exists_maximal_componentRankMass","statement":"{V : Type*} (C : Finset V) (b : V → ℤ) (hC : C.Nonempty) : ∃ j ∈ C.image b, ∀ k ∈ C.image b, componentRankMass C b k ≤ componentRankMass C b j"},{"kind":"theorem","name":"component_omitted_rank_card_eq","statement":"{V : Type*} (C : Finset V) (b : V → ℤ) (j : ℤ) (hC : C.Nonempty) : ((C.card - (C.filter fun x => b x = j).card : ℕ) : ℝ) = (C.card : ℝ) * (1 - componentRankMass C b j)"},{"kind":"theorem","name":"actual_weighted_midrank_dominant_mass_le","statement":"{V ι : Type*} (I : Finset ι) (C : ι → Finset V) (b : V → ℤ) (j : ι → ℤ) (hC : ∀ i ∈ I, (C i).Nonempty) (hmax : ∀ i ∈ I, ∀ k ∈ (C i).image b, componentRankMass (C i) b k ≤ componentRankMass (C i) b (j i)) : (∑ i ∈ I, (((C i).card - ((C i).filter fun x => b x = j i).card : ℕ) : ℝ)) ≤ 12 * ∑ i ∈ I, ((C i).card : ℝ) * midrankVariance (componentRankMassList (C i) b)"},{"kind":"theorem","name":"exists_maximum_overlap_component","statement":"{V : Type u} [DecidableEq V] {U : Finset V} (Q : Finpartition U) (C : Finset V) (hC : C.Nonempty) (hCU : C ⊆ U) : ∃ D ∈ Q.parts, ∀ E ∈ Q.parts, (C ∩ E).card ≤ (C ∩ D).card"},{"kind":"theorem","name":"sum_card_component_inter_partition","statement":"{V : Type u} [DecidableEq V] {U : Finset V} (Q : Finpartition U) (C : Finset V) (hCU : C ⊆ U) : ∑ D ∈ Q.parts, (C ∩ D).card = C.card"},{"kind":"theorem","name":"maximumOverlapPart_mem","statement":"{V : Type u} [DecidableEq V] {U : Finset V} (Q : Finpartition U) (C : Finset V) (hC : C.Nonempty) (hCU : C ⊆ U) : maximumOverlapPart Q C ∈ Q.parts"},{"kind":"theorem","name":"maximumOverlapPart_maximal","statement":"{V : Type u} [DecidableEq V] {U : Finset V} (Q : Finpartition U) (C : Finset V) (hC : C.Nonempty) (hCU : C ⊆ U) : ∀ E ∈ Q.parts, (C ∩ E).card ≤ (C ∩ maximumOverlapPart Q C).card"},{"kind":"theorem","name":"sourceCrossRoot_mem","statement":"(i j : Fin 9) (h : i ≠ j) (a b : List (Fin 2)) : sourceCrossRoot i j h a b ∈ prefixElementaryGroup ninePrefixCode"},{"kind":"theorem","name":"sourceCrossSwap_mem","statement":"(i j : Fin 9) (h : i ≠ j) (a b : List (Fin 2)) : sourceCrossSwap i j h a b ∈ prefixElementaryGroup ninePrefixCode"},{"kind":"theorem","name":"sourceRefinementOrthogonal","statement":"(i j : Fin 9) (h : i ≠ j) (a b : List (Fin 2)) : leavittWordT (nineWord i ++ a) * leavittWordS (nineWord j ++ b) = 0"},{"kind":"theorem","name":"sourceCrossSwap_val","statement":"(i j : Fin 9) (h : i ≠ j) (a b : List (Fin 2)) : (↑(sourceCrossSwap i j h a b) : BinaryLeavitt) = 1 - leavittWordS (nineWord i ++ a) * leavittWordT (nineWord i ++ a) - leavittWordS (nineWord j ++ b) * leavittWordT (nineWord j ++ b) + leavittWordS (nineWord i ++ a) * leavittWordT (nineWord j ++ b) + leavittWordS (nineWord j ++ b) * leavittWordT (nineWord i ++ a)"},{"kind":"theorem","name":"refinedSourcePrefixCode_complete","statement":"MatrixCorner.codeIdempotent (fun i => leavittWordS (refinedSourcePrefixCode.word i)) (fun i => leavittWordT (refinedSourcePrefixCode.word i)) = 1"},{"kind":"theorem","name":"completePrefixWord_ext","statement":"{ι : Type*} [Fintype ι] (E : BinaryPrefixCode ι) (hcomplete : MatrixCorner.codeIdempotent (fun i => leavittWordS (E.word i)) (fun i => leavittWordT (E.word i)) = 1) (x y : BinaryLeavitt) (haction : ∀ i : ι, x * leavittWordS (E.word i) = y * leavittWordS (E.word i)) : x = y"},{"kind":"theorem","name":"prefixTable_mul_sourceWord","statement":"{ι : Type*} [Fintype ι] [DecidableEq ι] (source target : BinaryPrefixCode ι) (i : ι) : prefixTable source target * leavittWordS (source.word i) = leavittWordS (target.word i)"},{"kind":"theorem","name":"compressionU_mul_nine_refinement","statement":"(i : Fin 9) (r : List (Fin 2)) : (compressionU : BinaryLeavitt) * leavittWordS (nineWord i ++ r) = leavittWordS (uWord i ++ r)"},{"kind":"theorem","name":"refinedSourceWord_eq_parent_append","statement":"(i : Fin 19) : refinedSourceWord i = nineWord (refinedSourceParent i) ++ refinedSourceSuffix i"},{"kind":"theorem","name":"compressionU_mul_refinedSourceWord","statement":"(i : Fin 19) : (compressionU : BinaryLeavitt) * leavittWordS (refinedSourceWord i) = leavittWordS (refinedTargetWord i)"},{"kind":"theorem","name":"leavittWordT_mul_wordS_cancel","statement":"(a b : List (Fin 2)) : leavittWordT a * leavittWordS b = binaryWordCancellation a b"},{"kind":"theorem","name":"leavittWordS_mul_wordS","statement":"(a b : List (Fin 2)) : leavittWordS a * leavittWordS b = leavittWordS (a ++ b)"},{"kind":"theorem","name":"sourceCrossSwap_mul_leavittWordS","statement":"(i j : Fin 9) (h : i ≠ j) (a b x : List (Fin 2)) : (↑(sourceCrossSwap i j h a b) : BinaryLeavitt) * leavittWordS x = leavittWordS x - leavittWordS (nineWord i ++ a) * binaryWordCancellation (nineWord i ++ a) x - leavittWordS (nineWord j ++ b) * binaryWordCancellation (nineWord j ++ b) x + leavittWordS (nineWord i ++ a) * binaryWordCancellation (nineWord j ++ b) x + leavittWordS (nineWord j ++ b) * binaryWordCancellation (nineWord i ++ a) x"},{"kind":"theorem","name":"elementaryCompressionU_mem","statement":"elementaryCompressionU ∈ prefixElementaryGroup ninePrefixCode"},{"kind":"theorem","name":"elementaryCompressionU_mul_refinedSourceWord","statement":"(i : Fin 19) : (elementaryCompressionU : BinaryLeavitt) * leavittWordS (refinedSourceWord i) = leavittWordS (refinedTargetWord i)"},{"kind":"theorem","name":"elementaryCompressionU_eq_compressionU","statement":"elementaryCompressionU = compressionU"},{"kind":"theorem","name":"compressionU_mem_ninePrefixElementaryGroup","statement":"compressionU ∈ prefixElementaryGroup ninePrefixCode"},{"kind":"theorem","name":"compressionU_mem_ninePrefixElementaryGroup","statement":"compressionU ∈ prefixElementaryGroup ninePrefixCode"},{"kind":"theorem","name":"prefixTable_compose","statement":"{ι : Type*} [Fintype ι] [DecidableEq ι] (source middle target : BinaryPrefixCode ι) : prefixTable middle target * prefixTable source middle = prefixTable source target"},{"kind":"theorem","name":"compressionV_eq_transition_mul","statement":"compressionV = compressionTransition * compressionU"},{"kind":"theorem","name":"nineCrossRoot_mem","statement":"(i j : Fin 9) (hij : i ≠ j) (a b : List (Fin 2)) : nineCrossRoot i j hij a b ∈ prefixElementaryGroup ninePrefixCode"},{"kind":"theorem","name":"nineCrossSwap_mem","statement":"(i j : Fin 9) (hij : i ≠ j) (a b : List (Fin 2)) : nineCrossSwap i j hij a b ∈ prefixElementaryGroup ninePrefixCode"},{"kind":"theorem","name":"compressionTransitionCrossSwaps_prod_mem","statement":"compressionTransitionCrossSwaps.prod ∈ prefixElementaryGroup ninePrefixCode"},{"kind":"theorem","name":"transpositionValue_refine","statement":"{A : Type*} [Ring A] (sa ta sb tb p₀ q₀ p₁ q₁ : A) (haa : ta * sa = 1) (hbb : tb * sb = 1) (hab : ta * sb = 0) (hba : tb * sa = 0) (h₀₀ : q₀ * p₀ = 1) (h₁₁ : q₁ * p₁ = 1) (h₀₁ : q₀ * p₁ = 0) (h₁₀ : q₁ * p₀ = 0) (hpartition : p₀ * q₀ + p₁ * q₁ = 1) : transpositionValue (sa * p₀) (q₀ * ta) (sb * p₀) (q₀ * tb) * transpositionValue (sa * p₁) (q₁ * ta) (sb * p₁) (q₁ * tb) = transpositionValue sa ta sb tb"},{"kind":"theorem","name":"nineRefinement_orthogonal","statement":"(i j : Fin 9) (hij : i ≠ j) (a b : List (Fin 2)) : leavittWordT (nineWord i ++ a) * leavittWordS (nineWord j ++ b) = 0"},{"kind":"theorem","name":"nineCrossSwap_val","statement":"(i j : Fin 9) (hij : i ≠ j) (a b : List (Fin 2)) : (↑(nineCrossSwap i j hij a b) : BinaryLeavitt) = transpositionValue (leavittWordS (nineWord i ++ a)) (leavittWordT (nineWord i ++ a)) (leavittWordS (nineWord j ++ b)) (leavittWordT (nineWord j ++ b))"},{"kind":"theorem","name":"wordSwapValue_refine","statement":"(a b : List (Fin 2)) (hab : leavittWordT a * leavittWordS b = 0) (hba : leavittWordT b * leavittWordS a = 0) : wordSwapValue (a ++ [0]) (b ++ [0]) * wordSwapValue (a ++ [1]) (b ++ [1]) = wordSwapValue a b"},{"kind":"theorem","name":"compressionTransitionCrossSwaps_prod_val","statement":"(↑compressionTransitionCrossSwaps.prod : BinaryLeavitt) = wordSwapValue (uWord 1) (uWord 2) * wordSwapValue (uWord 4) (uWord 5) * wordSwapValue (uWord 7) (uWord 8)"},{"kind":"theorem","name":"transpositionValue_mul_codeWord","statement":"{ι : Type*} [DecidableEq ι] (E : BinaryPrefixCode ι) (i j : ι) (hij : i ≠ j) (k : ι) : transpositionValue (leavittWordS (E.word i)) (leavittWordT (E.word i)) (leavittWordS (E.word j)) (leavittWordT (E.word j)) * leavittWordS (E.word k) = if k = i then leavittWordS (E.word j) else if k = j then leavittWordS (E.word i) else leavittWordS (E.word k)"},{"kind":"theorem","name":"uSwap12_mul","statement":"(k : Fin 9) : wordSwapValue (uWord 1) (uWord 2) * leavittWordS (uWord k) = if k = 1 then leavittWordS (uWord 2) else if k = 2 then leavittWordS (uWord 1) else leavittWordS (uWord k)"},{"kind":"theorem","name":"uSwap45_mul","statement":"(k : Fin 9) : wordSwapValue (uWord 4) (uWord 5) * leavittWordS (uWord k) = if k = 4 then leavittWordS (uWord 5) else if k = 5 then leavittWordS (uWord 4) else leavittWordS (uWord k)"},{"kind":"theorem","name":"uSwap78_mul","statement":"(k : Fin 9) : wordSwapValue (uWord 7) (uWord 8) * leavittWordS (uWord k) = if k = 7 then leavittWordS (uWord 8) else if k = 8 then leavittWordS (uWord 7) else leavittWordS (uWord k)"},{"kind":"theorem","name":"compressionTransitionParentSwaps_mul_word","statement":"(k : Fin 9) : (wordSwapValue (uWord 1) (uWord 2) * wordSwapValue (uWord 4) (uWord 5) * wordSwapValue (uWord 7) (uWord 8)) * leavittWordS (uWord k) = leavittWordS (vWord k)"},{"kind":"theorem","name":"compressionTransitionParentSwaps_eq_table","statement":"wordSwapValue (uWord 1) (uWord 2) * wordSwapValue (uWord 4) (uWord 5) * wordSwapValue (uWord 7) (uWord 8) = prefixTable uPrefixCode vPrefixCode"},{"kind":"theorem","name":"compressionTransitionCrossSwaps_prod_eq","statement":"compressionTransitionCrossSwaps.prod = compressionTransition"},{"kind":"theorem","name":"compressionTransition_mem","statement":"compressionTransition ∈ prefixElementaryGroup ninePrefixCode"},{"kind":"theorem","name":"compressionV_mem_of_compressionU","statement":"(hU : compressionU ∈ prefixElementaryGroup ninePrefixCode) : compressionV ∈ prefixElementaryGroup ninePrefixCode"},{"kind":"theorem","name":"compressionV_mem_ninePrefixElementaryGroup","statement":"compressionV ∈ prefixElementaryGroup ninePrefixCode"},{"kind":"theorem","name":"sourceGeneratedGroup_eq_nine","statement":"SourceGeneration.sourceGeneratedGroup = prefixElementaryGroup ninePrefixCode"},{"kind":"theorem","name":"shifted_floor_drop_subset_two_intervals","statement":"(u v H : ℝ) (hH : 0 < H) (k : ℤ) (hk : k = ⌊u / H⌋) : {r : ℝ | r ∈ Set.Ico 0 H ∧ ⌊(v + r) / H⌋ < ⌊(u + r) / H⌋} ⊆ Set.Ico ((k : ℝ) * H - u) ((k : ℝ) * H - v) ∪ Set.Ico (((k + 1 : ℤ) : ℝ) * H - u) (((k + 1 : ℤ) : ℝ) * H - v)"},{"kind":"theorem","name":"measurableSet_shifted_floor_drop","statement":"(u v H : ℝ) : MeasurableSet {r : ℝ | ⌊(v + r) / H⌋ < ⌊(u + r) / H⌋}"},{"kind":"theorem","name":"exists_common_offset_below_average","statement":"(H : ℝ) (hH : 0 < H) (f : ℝ → ℝ) (hf : MeasureTheory.IntegrableOn f (Set.Ico 0 H) MeasureTheory.volume) : ∃ r ∈ Set.Ico 0 H, f r ≤ MeasureTheory.average (MeasureTheory.volume.restrict (Set.Ico 0 H)) f"},{"kind":"theorem","name":"measurable_rankDropCount","statement":"{ι : Type*} [Fintype ι] (u v : ι → ℝ) (H : ℝ) : Measurable (fun r : ℝ => rankDropCount u v H r)"},{"kind":"theorem","name":"rankDropCount_nonneg_and_le","statement":"{ι : Type*} [Fintype ι] (u v : ι → ℝ) (H r : ℝ) : 0 ≤ rankDropCount u v H r ∧ rankDropCount u v H r ≤ (Fintype.card ι : ℝ)"},{"kind":"theorem","name":"integrableOn_rankDropCount","statement":"{ι : Type*} [Fintype ι] (u v : ι → ℝ) (H : ℝ) : MeasureTheory.IntegrableOn (fun r : ℝ => rankDropCount u v H r) (Set.Ico 0 H) MeasureTheory.volume"},{"kind":"theorem","name":"integrable_rankDropIndicator","statement":"(u v H : ℝ) : MeasureTheory.Integrable (fun r : ℝ => if ⌊(v + r) / H⌋ < ⌊(u + r) / H⌋ then (1 : ℝ) else 0) (MeasureTheory.volume.restrict (Set.Ico 0 H))"},{"kind":"theorem","name":"exists_common_rank_offset","statement":"{ι : Type*} [Fintype ι] (u v : ι → ℝ) (H : ℝ) (hH : 0 < H) : ∃ r ∈ Set.Ico 0 H, rankDropCount u v H r ≤ MeasureTheory.average (MeasureTheory.volume.restrict (Set.Ico 0 H)) (fun t : ℝ => rankDropCount u v H t)"},{"kind":"theorem","name":"rankDropCount_integral_eq","statement":"{ι : Type*} [Fintype ι] (u v : ι → ℝ) (H : ℝ) : (∫ r, rankDropCount u v H r ∂(MeasureTheory.volume.restrict (Set.Ico 0 H))) = ∑ i : ι, (MeasureTheory.volume.restrict (Set.Ico 0 H)).real {r : ℝ | ⌊(v i + r) / H⌋ < ⌊(u i + r) / H⌋}"},{"kind":"theorem","name":"rankDropCount_average_eq","statement":"{ι : Type*} [Fintype ι] (u v : ι → ℝ) (H : ℝ) (hH : 0 < H) : MeasureTheory.average (MeasureTheory.volume.restrict (Set.Ico 0 H)) (fun r : ℝ => rankDropCount u v H r) = H⁻¹ * ∑ i : ι, (MeasureTheory.volume.restrict (Set.Ico 0 H)).real {r : ℝ | ⌊(v i + r) / H⌋ < ⌊(u i + r) / H⌋}"},{"kind":"theorem","name":"rankDropCount_clamp_eq","statement":"{ι : Type*} [Fintype ι] (u v : ι → ℝ) (H r : ℝ) (hH : 0 < H) : rankDropCount u v H r = rankDropCount u (fun i => min (v i) (u i)) H r"},{"kind":"theorem","name":"shifted_floor_drop_volume_bound_sharp","statement":"(u v H : ℝ) (hH : 0 < H) (hvu : v ≤ u) : MeasureTheory.volume {r : ℝ | r ∈ Set.Ico 0 H ∧ ⌊(v + r) / H⌋ < ⌊(u + r) / H⌋} ≤ ENNReal.ofReal (u - v)"},{"kind":"theorem","name":"rankDrop_measureReal_bound_sharp","statement":"(u v H : ℝ) (hH : 0 < H) (hvu : v ≤ u) : (MeasureTheory.volume.restrict (Set.Ico 0 H)).real {r : ℝ | ⌊(v + r) / H⌋ < ⌊(u + r) / H⌋} ≤ u - v"},{"kind":"theorem","name":"exists_common_rank_offset_bound_sharp","statement":"{ι : Type*} [Fintype ι] (u v : ι → ℝ) (H : ℝ) (hH : 0 < H) (hvu : ∀ i : ι, v i ≤ u i) : ∃ r ∈ Set.Ico 0 H, rankDropCount u v H r ≤ (1 / H) * ∑ i : ι, (u i - v i)"},{"kind":"theorem","name":"exists_common_rank_offset_one_sided_sharp","statement":"{ι : Type*} [Fintype ι] (u v delta : ι → ℝ) (H : ℝ) (hH : 0 < H) (hdelta : ∀ i : ι, 0 ≤ delta i) (hone : ∀ i : ι, u i - delta i ≤ v i) : ∃ r ∈ Set.Ico 0 H, rankDropCount u v H r ≤ (1 / H) * ∑ i : ι, delta i"},{"kind":"theorem","name":"log_one_sided_of_multiplicative","statement":"(x y eta : ℝ) (hx : 0 < x) (heta0 : 0 ≤ eta) (heta1 : eta < 1) (hcomparison : (1 - eta) * x ≤ y) : Real.log x - |Real.log (1 - eta)| ≤ Real.log y"},{"kind":"theorem","name":"exists_common_log_rank_offset","statement":"{ι : Type*} [Fintype ι] (x y : ι → ℝ) (eta H : ℝ) (hx : ∀ i : ι, 0 < x i) (heta0 : 0 ≤ eta) (heta1 : eta < 1) (hH : 0 < H) (hcomparison : ∀ i : ι, (1 - eta) * x i ≤ y i) : ∃ r ∈ Set.Ico 0 H, rankDropCount (fun i => Real.log (x i)) (fun i => Real.log (y i)) H r ≤ (Fintype.card ι : ℝ) * |Real.log (1 - eta)| / H"},{"kind":"theorem","name":"abs_log_one_sub_le_two_mul","statement":"(eta : ℝ) (heta0 : 0 ≤ eta) (hetaHalf : eta ≤ (1 : ℝ) / 2) : |Real.log (1 - eta)| ≤ 2 * eta"},{"kind":"theorem","name":"abs_log_one_sub_div_tendsto_zero","statement":"(eta H : ℕ → ℝ) (heta0 : ∀ n, 0 ≤ eta n) (hH : ∀ n, 0 < H n) (heta : Filter.Tendsto eta Filter.atTop (nhds 0)) (hratio : Filter.Tendsto (fun n => eta n / H n) Filter.atTop (nhds 0)) : Filter.Tendsto (fun n => |Real.log (1 - eta n)| / H n) Filter.atTop (nhds 0)"},{"kind":"theorem","name":"sum_sub_finiteMean_eq_zero","statement":"{V : Type*} [Fintype V] [Nonempty V] (f : V → ℝ) : (∑ x : V, (f x - finiteMean f)) = 0"},{"kind":"theorem","name":"sum_sq_sub_finiteMean_le","statement":"{V : Type*} [Fintype V] [Nonempty V] (f : V → ℝ) (c : ℝ) : (∑ x : V, (f x - finiteMean f) ^ 2) ≤ ∑ x : V, (f x - c) ^ 2"},{"kind":"theorem","name":"exists_finite_real_median","statement":"{V : Type*} [Fintype V] [Nonempty V] (f : V → ℝ) : ∃ m : ℝ, 2 * (lowerLevel f m).card ≤ Fintype.card V ∧ 2 * (upperLevel f m).card ≤ Fintype.card V"},{"kind":"theorem","name":"positive_max_iff","statement":"(a : ℝ) : 0 < max a 0 ↔ 0 < a"},{"kind":"theorem","name":"positiveSupport_max_sub","statement":"{V : Type*} [Fintype V] (f : V → ℝ) (m : ℝ) : positiveSupport (fun x => max (f x - m) 0) = upperLevel f m"},{"kind":"theorem","name":"positiveSupport_max_sub_reverse","statement":"{V : Type*} [Fintype V] (f : V → ℝ) (m : ℝ) : positiveSupport (fun x => max (m - f x) 0) = lowerLevel f m"},{"kind":"theorem","name":"finiteVariance_nonneg","statement":"{V : Type*} [Fintype V] (f : V → ℝ) : 0 ≤ finiteVariance f"},{"kind":"theorem","name":"card_mul_finiteVariance","statement":"{V : Type*} [Fintype V] [Nonempty V] (f : V → ℝ) : (Fintype.card V : ℝ) * finiteVariance f = ∑ x : V, (f x - finiteMean f) ^ 2"},{"kind":"theorem","name":"idempotentCornerUnitExtensions_commute","statement":"{A : Type*} [Ring A] {e f : A} (he : IsIdempotentElem e) (hf : IsIdempotentElem f) (hef : e * f = 0) (hfe : f * e = 0) (u : he.Cornerˣ) (v : hf.Cornerˣ) : Commute (idempotentCornerUnitExtension he u) (idempotentCornerUnitExtension hf v)"},{"kind":"theorem","name":"idempotentCornerUnitExtensions_eq_one","statement":"{A : Type*} [Ring A] {e f : A} (he : IsIdempotentElem e) (hf : IsIdempotentElem f) (hef : e * f = 0) (u : he.Cornerˣ) (v : hf.Cornerˣ) (h : idempotentCornerUnitExtension he u = idempotentCornerUnitExtension hf v) : idempotentCornerUnitExtension he u = 1"},{"kind":"theorem","name":"idempotentCornerGroup_le_centralizer","statement":"{A : Type*} [Ring A] {e f : A} (he : IsIdempotentElem e) (hf : IsIdempotentElem f) (hef : e * f = 0) (hfe : f * e = 0) : idempotentCornerGroup hf ≤ Subgroup.centralizer (idempotentCornerGroup he : Set Aˣ)"},{"kind":"theorem","name":"idempotentCornerGroup_inf_eq_bot","statement":"{A : Type*} [Ring A] {e f : A} (he : IsIdempotentElem e) (hf : IsIdempotentElem f) (hef : e * f = 0) : idempotentCornerGroup he ⊓ idempotentCornerGroup hf = ⊥"},{"kind":"theorem","name":"leavittCylinder_isIdempotent","statement":"(a : List (Fin 2)) : IsIdempotentElem (leavittCylinder a)"},{"kind":"theorem","name":"leavittCylinder_mul_eq_zero_of_incomparable","statement":"(a b : List (Fin 2)) (hab : ¬ a <+: b) (hba : ¬ b <+: a) : leavittCylinder a * leavittCylinder b = 0"},{"kind":"theorem","name":"prefixElementaryGroup_le_corner","statement":"{ι : Type*} [Fintype ι] [DecidableEq ι] (E : BinaryPrefixCode ι) : prefixElementaryGroup E ≤ prefixCodeCornerGroup E"},{"kind":"theorem","name":"alphaZeroWord_incomparable_local","statement":"(i : Fin 3) : ¬ alphaZeroPrefixCode.word i <+: sourceLocalWord"},{"kind":"theorem","name":"localWord_incomparable_alphaZero","statement":"(i : Fin 3) : ¬ sourceLocalWord <+: alphaZeroPrefixCode.word i"},{"kind":"theorem","name":"alphaZeroCode_mul_localCylinder","statement":"prefixCodeIdempotent alphaZeroPrefixCode * leavittCylinder sourceLocalWord = 0"},{"kind":"theorem","name":"localCylinder_mul_alphaZeroCode","statement":"leavittCylinder sourceLocalWord * prefixCodeIdempotent alphaZeroPrefixCode = 0"},{"kind":"theorem","name":"localCylinderCorner_le_centralizer_alphaZero","statement":"cylinderCornerGroup sourceLocalWord ≤ Subgroup.centralizer (prefixElementaryGroup alphaZeroPrefixCode : Set BinaryLeavittˣ)"},{"kind":"theorem","name":"alphaZero_inf_localCylinderCorner_eq_bot","statement":"prefixElementaryGroup alphaZeroPrefixCode ⊓ cylinderCornerGroup sourceLocalWord = ⊥"},{"kind":"theorem","name":"target_majority_of_small_symmDiff","statement":"{V : Type*} [DecidableEq V] (C D : Finset V) (hsmall : 2 * (C ∆ D).card < C.card) : D.card < 2 * (C ∩ D).card"},{"kind":"theorem","name":"matchedRetainedSupport_nonempty","statement":"{V : Type*} [DecidableEq V] {U : Finset V} (P : Finpartition U) (R : Finset (Finset V)) (hR : R ⊆ P.parts) (hRne : R.Nonempty) : (matchedRetainedSupport R).Nonempty"},{"kind":"theorem","name":"partitionWordCrossing_indexed_sum_card_le_target_add_unmatched","statement":"{V ι : Type*} [DecidableEq V] {U : Finset V} (P Q : Finpartition U) (R : Finset (Finset V)) (hR : R ⊆ P.parts) (D : Finset V → Finset V) (hD : ∀ C ∈ R, D C ∈ Q.parts) (hinj : Set.InjOn D (R : Set (Finset V))) (I : Finset ι) (w : ι → Equiv.Perm V) : (∑ i ∈ I, (partitionWordCrossing P (w i)).card) ≤ (∑ i ∈ I, (partitionWordCrossing Q (w i)).card) + 2 * I.card * (U \\ matchedCore R D).card"},{"kind":"theorem","name":"matchedRetainedSupport_cover_density_tendsto_one","statement":"{V : ℕ → Type*} [∀ n, DecidableEq (V n)] (U : ∀ n, Finset (V n)) (hU : ∀ n, (U n).Nonempty) (P : ∀ n, Finpartition (U n)) (R : ∀ n, Finset (Finset (V n))) (hR : ∀ n, R n ⊆ (P n).parts) (hdiscard : Tendsto (fun n => (((U n \\ matchedRetainedSupport (R n)).card : ℝ) / (U n).card)) atTop (𝓝 0)) : Tendsto (fun n => ((matchedRetainedSupport (R n)).card : ℝ) / (U n).card) atTop (𝓝 1)"},{"kind":"theorem","name":"exists_matched_slow_diagonal_word_errors","statement":"{V : ℕ → Type*} [∀ n, DecidableEq (V n)] {ι : Type*} (U : ∀ n, Finset (V n)) (P Q : ∀ n, Finpartition (U n)) (R : ∀ n, Finset (Finset (V n))) (hR : ∀ n, R n ⊆ (P n).parts) (D : ∀ n, Finset (V n) → Finset (V n)) (hD : ∀ n C, C ∈ R n → D n C ∈ (Q n).parts) (hmajor : ∀ n C, C ∈ R n → (D n C).card < 2 * (C ∩ D n C).card) (hdiscard : Tendsto (fun n => (((U n \\ matchedRetainedSupport (R n)).card : ℝ) / (U n).card)) atTop (𝓝 0)) (hsymm : Tendsto (fun n => ((∑ C ∈ R n, (C ∆ D n C).card : ℕ) : ℝ) / (U n).card) atTop (𝓝 0)) (I : ℕ → Finset ι) (w : ∀ n, ι → Equiv.Perm (V n)) (hword : ∀ k, Tendsto (fun n => ((∑ i ∈ I k, (partitionWordCrossing (Q n) (w n i)).card : ℕ) : ℝ) / (U n).card) atTop (𝓝 0)) (B : ∀ n, ℕ → Finset (V n)) (hbad : ∀ k, Tendsto (fun n => (((U n ∩ B n k).card : ℝ) / (U n).card)) atTop (𝓝 0)) : ∃ r : ℕ → ℕ, Tendsto r atTop atTop ∧ Tendsto (fun n => (((∑ i ∈ I (r n), (partitionWordCrossing (P n) (w n i)).card : ℕ) : ℝ) + (U n ∩ B n (r n)).card) / (U n).card) atTop (𝓝 0)"},{"kind":"theorem","name":"matchedRadiusBad_card_le","statement":"{V ι : Type*} [DecidableEq V] {U : Finset V} (P : Finpartition U) (I : Finset ι) (w : ι → Equiv.Perm V) (B : Finset V) : (U ∩ matchedRadiusBad P I w B).card ≤ (U ∩ B).card + ∑ i ∈ I, (partitionWordCrossing P (w i)).card"},{"kind":"theorem","name":"matched_exists_le_weighted_average","statement":"{ι : Type*} (s : Finset ι) (hs : s.Nonempty) (weight bad : ι → ℝ) (hweight : ∀ i ∈ s, 0 < weight i) : ∃ i ∈ s, bad i / weight i ≤ (∑ j ∈ s, bad j) / (∑ j ∈ s, weight j)"},{"kind":"theorem","name":"matched_sum_card_inter_partition","statement":"{V : Type*} [DecidableEq V] {U : Finset V} (P : Finpartition U) (B : Finset V) : ∑ C ∈ P.parts, (C ∩ B).card = (U ∩ B).card"},{"kind":"theorem","name":"matchedRetained_bad_density_tendsto_zero","statement":"{V : ℕ → Type*} [∀ n, DecidableEq (V n)] (U : ∀ n, Finset (V n)) (hU : ∀ n, (U n).Nonempty) (P : ∀ n, Finpartition (U n)) (R : ∀ n, Finset (Finset (V n))) (hR : ∀ n, R n ⊆ (P n).parts) (hRne : ∀ n, (R n).Nonempty) (hdiscard : Tendsto (fun n => (((U n \\ matchedRetainedSupport (R n)).card : ℝ) / (U n).card)) atTop (𝓝 0)) (B : ∀ n, Finset (V n)) (hbad : Tendsto (fun n => (((U n ∩ B n).card : ℝ) / (U n).card)) atTop (𝓝 0)) : Tendsto (fun n => (((matchedRetainedSupport (R n) ∩ B n).card : ℝ) / (matchedRetainedSupport (R n)).card)) atTop (𝓝 0)"},{"kind":"theorem","name":"matched_eventually_exists_good_vertex","statement":"{V : ℕ → Type*} [∀ n, DecidableEq (V n)] (C B : ∀ n, Finset (V n)) (hC : ∀ n, (C n).Nonempty) (hbad : Tendsto (fun n => (((C n ∩ B n).card : ℝ) / (C n).card)) atTop (𝓝 0)) : ∀ᶠ n in atTop, ∃ x ∈ C n, x ∉ B n"},{"kind":"theorem","name":"sum_weighted_ordered_midpoints_sq","statement":"(s : Finset ℤ) (w : ℤ → ℝ) : (∑ j ∈ s, w j * (lowerRankWeight s w j + w j / 2) ^ 2) = (∑ j ∈ s, w j) ^ 3 / 3 - (∑ j ∈ s, w j ^ 3) / 12"},{"kind":"theorem","name":"twice_lower_rank_pairs_add_equal_rank_pairs","statement":"{V : Type*} (C : Finset V) (b : V → ℤ) : 2 * (∑ x ∈ C, ((C.filter fun z => b z < b x).card : ℝ)) + (∑ x ∈ C, ((C.filter fun z => b z = b x).card : ℝ)) = (C.card : ℝ) ^ 2"},{"kind":"theorem","name":"sum_componentVertexMidrank","statement":"{V : Type*} (C : Finset V) (b : V → ℤ) (hC : C.Nonempty) : (∑ x ∈ C, SoficGroups.componentVertexMidrank C b x) = (C.card : ℝ) / 2"},{"kind":"theorem","name":"componentVertexMidrank_eq_ordered_midpoint","statement":"{V : Type*} (C : Finset V) (b : V → ℤ) (x : V) : SoficGroups.componentVertexMidrank C b x = lowerRankWeight (C.image b) (SoficGroups.componentRankMass C b) (b x) + SoficGroups.componentRankMass C b (b x) / 2"},{"kind":"theorem","name":"sum_componentVertexMidrank_sq_eq","statement":"{V : Type*} (C : Finset V) (b : V → ℤ) (hC : C.Nonempty) : (∑ x ∈ C, SoficGroups.componentVertexMidrank C b x ^ 2) = (C.card : ℝ) * ((1 : ℝ) / 3 - (∑ j ∈ C.image b, SoficGroups.componentRankMass C b j ^ 3) / 12)"},{"kind":"theorem","name":"componentRankMassList_cube_sum","statement":"{V : Type*} (C : Finset V) (b : V → ℤ) : ((SoficGroups.componentRankMassList C b).map fun p => p ^ 3).sum = ∑ j ∈ C.image b, SoficGroups.componentRankMass C b j ^ 3"},{"kind":"theorem","name":"componentVertexMidrank_variance_eq","statement":"{V : Type*} (C : Finset V) (b : V → ℤ) (hC : C.Nonempty) : (∑ x ∈ C, (SoficGroups.componentVertexMidrank C b x - (1 / 2 : ℝ)) ^ 2) = (C.card : ℝ) * SoficGroups.midrankVariance (SoficGroups.componentRankMassList C b)"},{"kind":"theorem","name":"componentVertexMidrank_finiteMean_eq_half","statement":"{V : Type*} (C : Finset V) (b : V → ℤ) (hC : C.Nonempty) : SoficGroups.CheegerPoincare.finiteMean (fun x : {x // x ∈ C} => SoficGroups.componentVertexMidrank C b x) = (1 / 2 : ℝ)"},{"kind":"theorem","name":"componentVertexMidrank_finiteVariance_eq","statement":"{V : Type*} (C : Finset V) (b : V → ℤ) (hC : C.Nonempty) : SoficGroups.CheegerPoincare.finiteVariance (fun x : {x // x ∈ C} => SoficGroups.componentVertexMidrank C b x) = SoficGroups.midrankVariance (SoficGroups.componentRankMassList C b)"},{"kind":"theorem","name":"insufficientOverlapComponents_subset","statement":"{V : Type u} [DecidableEq V] {U : Finset V} (P Q : Finpartition U) (eta : ℝ) : insufficientOverlapComponents P Q eta ⊆ P.parts"},{"kind":"theorem","name":"insufficientOverlapComponents_mass_le_loss","statement":"{V : Type u} [DecidableEq V] {U : Finset V} (P Q : Finpartition U) (eta : ℝ) : eta * (∑ C ∈ insufficientOverlapComponents P Q eta, (C.card : ℝ)) ≤ ∑ C ∈ P.parts, ((C.card : ℝ) - ((C ∩ maximumOverlapPart Q C).card : ℝ))"},{"kind":"theorem","name":"transportedFinpartition_parts","statement":"{V : Type u} [DecidableEq V] {U : Finset V} (Q : Finpartition U) (T : Equiv.Perm V) : (transportedFinpartition Q T).parts = Q.parts.image (fun C : Finset V => C.map T.toEmbedding)"},{"kind":"theorem","name":"transportedUnivFinpartition_parts","statement":"{V : Type u} [Fintype V] [DecidableEq V] (Q : Finpartition (Finset.univ : Finset V)) (T : Equiv.Perm V) : (transportedUnivFinpartition Q T).parts = Q.parts.image (fun C : Finset V => C.map T.toEmbedding)"},{"kind":"theorem","name":"partitionComponentSize_eq_card_of_mem","statement":"{V : Type u} [DecidableEq V] {U : Finset V} (Q : Finpartition U) (C : Finset V) (hC : C ∈ Q.parts) (x : V) (hx : x ∈ C) : partitionComponentSize Q x = C.card"},{"kind":"theorem","name":"partitionComponentSize_transport_lower_of_overlap","statement":"{V : Type u} [DecidableEq V] {U : Finset V} (Q : Finpartition U) (T : Equiv.Perm V) (C D : Finset V) (hC : C ∈ Q.parts) (hD : D ∈ Q.parts) (eta : ℝ) (hoverlap : (1 - eta) * (C.card : ℝ) ≤ (((C.map T.toEmbedding) ∩ D).card : ℝ)) (x : V) (hx : x ∈ C) (hTx : T x ∈ D) : (1 - eta) * (partitionComponentSize Q x : ℝ) ≤ (partitionComponentSize Q (T x) : ℝ)"},{"kind":"theorem","name":"maximumOverlapPart_overlap_of_not_mem_insufficient","statement":"{V : Type u} [DecidableEq V] {U : Finset V} (P Q : Finpartition U) (eta : ℝ) (C : Finset V) (hC : C ∈ P.parts) (hretained : C ∉ insufficientOverlapComponents P Q eta) : (1 - eta) * (C.card : ℝ) ≤ ((C ∩ maximumOverlapPart Q C).card : ℝ)"},{"kind":"theorem","name":"partitionComponentSize_transport_lower_of_retained","statement":"{V : Type u} [Fintype V] [DecidableEq V] (Q : Finpartition (Finset.univ : Finset V)) (T : Equiv.Perm V) (C : Finset V) (hC : C ∈ Q.parts) (eta : ℝ) (hretained : C.map T.toEmbedding ∉ insufficientOverlapComponents (transportedUnivFinpartition Q T) Q eta) (x : V) (hx : x ∈ C) (hTx : T x ∈ maximumOverlapPart Q (C.map T.toEmbedding)) : (1 - eta) * (partitionComponentSize Q x : ℝ) ≤ (partitionComponentSize Q (T x) : ℝ)"},{"kind":"theorem","name":"singletonPrefixCode_codeIdempotent","statement":"(a : List (Fin 2)) : MatrixCorner.codeIdempotent (fun i => leavittWordS ((singletonPrefixCode a).word i)) (fun i => leavittWordT ((singletonPrefixCode a).word i)) = leavittCylinder a"},{"kind":"theorem","name":"prefixInsertionHom_injective","statement":"(a : List (Fin 2)) : Function.Injective (prefixInsertionHom a)"},{"kind":"theorem","name":"leavittCylinder_isIdempotent","statement":"(a : List (Fin 2)) : IsIdempotentElem (leavittCylinder a)"},{"kind":"theorem","name":"cylinderCornerGroup_eq_source","statement":"(a : List (Fin 2)) : cylinderCornerGroup a = ThompsonPrefixLocal.cylinderCornerGroup a"},{"kind":"theorem","name":"prefixInsertionHom_mem_cylinderCorner","statement":"(a : List (Fin 2)) (u : BinaryLeavittˣ) : prefixInsertionHom a u ∈ cylinderCornerGroup a"},{"kind":"theorem","name":"prefixInsertionHom_val","statement":"(a : List (Fin 2)) (u : BinaryLeavittˣ) : (↑(prefixInsertionHom a u) : BinaryLeavitt) = leavittWordS a * (u : BinaryLeavitt) * leavittWordT a + (1 - leavittCylinder a)"},{"kind":"theorem","name":"transpositionValue_mul_self","statement":"{A : Type*} [Ring A] (sa ta sb tb : A) (haa : ta * sa = 1) (hbb : tb * sb = 1) (hab : ta * sb = 0) (hba : tb * sa = 0) : PrefixCompression.transpositionValue sa ta sb tb * PrefixCompression.transpositionValue sa ta sb tb = 1"},{"kind":"theorem","name":"append_not_prefix_append","statement":"(a b x y : List (Fin 2)) (hab : ¬ a <+: b) (hba : ¬ b <+: a) : ¬ a ++ x <+: b ++ y"},{"kind":"theorem","name":"prepend_not_prefix_prepend","statement":"(l a b : List (Fin 2)) (hab : ¬ a <+: b) : ¬ l ++ a <+: l ++ b"},{"kind":"theorem","name":"prefixInsertionHom_cylinderSwap","statement":"(l a b : List (Fin 2)) (hab : ¬ a <+: b) (hba : ¬ b <+: a) : prefixInsertionHom l (cylinderSwap a b hab hba) = cylinderSwap (l ++ a) (l ++ b) (prepend_not_prefix_prepend l a b hab) (prepend_not_prefix_prepend l b a hba)"},{"kind":"theorem","name":"transpositionValue_braid","statement":"{A : Type*} [Ring A] (sa ta sb tb sc tc : A) (haa : ta * sa = 1) (hbb : tb * sb = 1) (hcc : tc * sc = 1) (hab : ta * sb = 0) (hba : tb * sa = 0) (hac : ta * sc = 0) (hca : tc * sa = 0) (hbc : tb * sc = 0) (hcb : tc * sb = 0) : PrefixCompression.transpositionValue sa ta sc tc * PrefixCompression.transpositionValue sb tb sc tc * PrefixCompression.transpositionValue sa ta sc tc = PrefixCompression.transpositionValue sa ta sb tb"},{"kind":"theorem","name":"prefixCrossRoot_mem","statement":"{ι : Type*} [DecidableEq ι] (E : BinaryPrefixCode ι) (i j : ι) (hij : i ≠ j) (a b : List (Fin 2)) : prefixCrossRoot E i j hij a b ∈ prefixElementaryGroup E"},{"kind":"theorem","name":"prefixCrossSwap_mem","statement":"{ι : Type*} [DecidableEq ι] (E : BinaryPrefixCode ι) (i j : ι) (hij : i ≠ j) (a b : List (Fin 2)) : prefixCrossSwap E i j hij a b ∈ prefixElementaryGroup E"},{"kind":"theorem","name":"prefixCrossSwap_val","statement":"{ι : Type*} [DecidableEq ι] (E : BinaryPrefixCode ι) (i j : ι) (hij : i ≠ j) (a b : List (Fin 2)) : (↑(prefixCrossSwap E i j hij a b) : BinaryLeavitt) = PrefixCompression.wordSwapValue (E.word i ++ a) (E.word j ++ b)"},{"kind":"theorem","name":"samePrefixCylinderSwap_mem","statement":"{ι : Type*} [DecidableEq ι] (E : BinaryPrefixCode ι) (i j : ι) (hij : i ≠ j) (a b c : List (Fin 2)) (hab : ¬ a <+: b) (hba : ¬ b <+: a) : cylinderSwap (E.word i ++ a) (E.word i ++ b) (prepend_not_prefix_prepend (E.word i) a b hab) (prepend_not_prefix_prepend (E.word i) b a hba) ∈ prefixElementaryGroup E"},{"kind":"theorem","name":"sourceLocal_cylinderSwap_mem_alpha","statement":"(a b : List (Fin 2)) (hab : ¬ a <+: b) (hba : ¬ b <+: a) : prefixInsertionHom [0, 0, 0, 1] (cylinderSwap a b hab hba) ∈ prefixElementaryGroup alphaPrefixCode"},{"kind":"theorem","name":"localPrefixTranspositionGroup_le_cylinderCorner","statement":"(l : List (Fin 2)) : localPrefixTranspositionGroup l ≤ cylinderCornerGroup l"},{"kind":"theorem","name":"localPrefixTranspositionGroup_le_sourceCylinderCorner","statement":"(l : List (Fin 2)) : localPrefixTranspositionGroup l ≤ ThompsonPrefixLocal.cylinderCornerGroup l"},{"kind":"theorem","name":"sourceLocalPrefixTranspositionGroup_le_alpha","statement":"localPrefixTranspositionGroup [0, 0, 0, 1] ≤ prefixElementaryGroup alphaPrefixCode"},{"kind":"theorem","name":"sourceLocalPrefixTranspositionGroup_le_alpha_sourceWord","statement":"localPrefixTranspositionGroup ThompsonPrefixLocal.sourceLocalWord ≤ prefixElementaryGroup alphaPrefixCode"},{"kind":"theorem","name":"sourceLocalPrefixTranspositionGroup_le_nine","statement":"localPrefixTranspositionGroup ThompsonPrefixLocal.sourceLocalWord ≤ prefixElementaryGroup ninePrefixCode"},{"kind":"theorem","name":"sourceLocalPrefixTranspositionGroup_le_centralizer_alphaZero","statement":"localPrefixTranspositionGroup ThompsonPrefixLocal.sourceLocalWord ≤ Subgroup.centralizer (prefixElementaryGroup alphaZeroPrefixCode : Set BinaryLeavittˣ)"},{"kind":"theorem","name":"alphaZero_inf_sourceLocalPrefixTranspositionGroup_eq_bot","statement":"prefixElementaryGroup alphaZeroPrefixCode ⊓ localPrefixTranspositionGroup ThompsonPrefixLocal.sourceLocalWord = ⊥"},{"kind":"theorem","name":"sourceCompressedLocalProductHom_injective","statement":"Function.Injective sourceCompressedLocalProductHom"},{"kind":"theorem","name":"sourceCompressedLocalProductHom_range_le_nine","statement":"sourceCompressedLocalProductHom.range ≤ prefixElementaryGroup ninePrefixCode"},{"kind":"theorem","name":"sourceCompressedLocalProductEmbedding_injective","statement":"Function.Injective sourceCompressedLocalProductEmbedding"},{"kind":"theorem","name":"rankDropCount_eq_sum_rankDecreasingVertices","statement":"{V ι : Type*} [Fintype V] [Fintype ι] (u : V → ℝ) (p : ι → Equiv.Perm V) (H r : ℝ) : SoficGroups.rankDropCount (fun e : ι × V => u e.2) (fun e : ι × V => u (p e.1 e.2)) H r = ∑ i : ι, ((rankDecreasingVertices Finset.univ (offsetFloorRank u H r) (p i)).card : ℝ)"},{"kind":"theorem","name":"midpointDecreasing_subset_crossing_union_rankDecreasing","statement":"{V : Type*} [DecidableEq V] {U : Finset V} (P : Finpartition U) (b : V → ℤ) (p : Equiv.Perm V) : midpointDecreasingVertices P b p ⊆ partitionWordCrossing P p ∪ rankDecreasingVertices U b p"},{"kind":"theorem","name":"partitionVertexMidrank_permutation_energy_le","statement":"{V : Type*} [Fintype V] [DecidableEq V] (P : Finpartition (Finset.univ : Finset V)) (b : V → ℤ) (p : Equiv.Perm V) : (∑ x : V, (partitionVertexMidrank P b (p x) - partitionVertexMidrank P b x) ^ 2) ≤ 2 * ((partitionWordCrossing P p).card : ℝ) + 2 * ((rankDecreasingVertices Finset.univ b p).card : ℝ)"},{"kind":"theorem","name":"sum_partitionVertexMidrank_permutation_energy_le","statement":"{V ι : Type*} [Fintype V] [DecidableEq V] (I : Finset ι) (P : Finpartition (Finset.univ : Finset V)) (b : V → ℤ) (p : ι → Equiv.Perm V) : (∑ i ∈ I, ∑ x : V, (partitionVertexMidrank P b (p i x) - partitionVertexMidrank P b x) ^ 2) ≤ 2 * (∑ i ∈ I, ((partitionWordCrossing P (p i)).card : ℝ)) + 2 * (∑ i ∈ I, ((rankDecreasingVertices Finset.univ b (p i)).card : ℝ))"},{"kind":"theorem","name":"partitionVertexMidrank_permutation_energy_tendsto_zero","statement":"(V ι : ℕ → Type*) [∀ n, Fintype (V n)] [∀ n, DecidableEq (V n)] [∀ n, Fintype (ι n)] (P : (n : ℕ) → Finpartition (Finset.univ : Finset (V n))) (b : (n : ℕ) → V n → ℤ) (p : (n : ℕ) → ι n → Equiv.Perm (V n)) (N : ℕ → ℝ) (hN : ∀ n, 0 < N n) (hcross : Tendsto (fun n => (∑ i : ι n, ((partitionWordCrossing (P n) (p n i)).card : ℝ)) / N n) atTop (nhds 0)) (hrank : Tendsto (fun n => (∑ i : ι n, ((rankDecreasingVertices Finset.univ (b n) (p n i)).card : ℝ)) / N n) atTop (nhds 0)) : Tendsto (fun n => (∑ i : ι n, ∑ x : V n, (partitionVertexMidrank (P n) (b n) (p n i x) - partitionVertexMidrank (P n) (b n) x) ^ 2) / N n) atTop (nhds 0)"},{"kind":"theorem","name":"selectedRankSupport_subset","statement":"{V : Type*} [DecidableEq V] {U : Finset V} (P : Finpartition U) (b : V → ℤ) (j : Finset V → ℤ) : selectedRankSupport P b j ⊆ U"},{"kind":"theorem","name":"selectedRankSupport_card","statement":"{V : Type*} [DecidableEq V] {U : Finset V} (P : Finpartition U) (b : V → ℤ) (j : Finset V → ℤ) : (selectedRankSupport P b j).card = ∑ C ∈ P.parts, (C.filter fun x => b x = j C).card"},{"kind":"theorem","name":"card_sdiff_selectedRankSupport","statement":"{V : Type*} [DecidableEq V] {U : Finset V} (P : Finpartition U) (b : V → ℤ) (j : Finset V → ℤ) : (U \\ selectedRankSupport P b j).card = ∑ C ∈ P.parts, (C.card - (C.filter fun x => b x = j C).card)"},{"kind":"theorem","name":"selectedRankSupport_rank_eq","statement":"{V : Type*} [DecidableEq V] {U : Finset V} (P : Finpartition U) (b : V → ℤ) (j : Finset V → ℤ) {x : V} (hx : x ∈ selectedRankSupport P b j) : b x = j (P.part x)"},{"kind":"theorem","name":"rankSupportPreimageBad_card_le","statement":"{V : Type*} [DecidableEq V] (U S : Finset V) (w : Equiv.Perm V) : (rankSupportPreimageBad U S w).card ≤ (U \\ S).card"},{"kind":"theorem","name":"rankChangingArc_subset_crossing_or_unselected","statement":"{V : Type*} [DecidableEq V] {U : Finset V} (P : Finpartition U) (b : V → ℤ) (j : Finset V → ℤ) (w : Equiv.Perm V) : rankChangingArc U b w ⊆ partitionWordCrossing P w ∪ (U \\ selectedRankSupport P b j) ∪ rankSupportPreimageBad U (selectedRankSupport P b j) w"},{"kind":"theorem","name":"rankChangingArc_card_le_crossing_add_unselected","statement":"{V : Type*} [DecidableEq V] {U : Finset V} (P : Finpartition U) (b : V → ℤ) (j : Finset V → ℤ) (w : Equiv.Perm V) : (rankChangingArc U b w).card ≤ (partitionWordCrossing P w).card + 2 * (U \\ selectedRankSupport P b j).card"},{"kind":"theorem","name":"rankChangingArc_density_tendsto_zero","statement":"(V : ℕ → Type*) [∀ n, DecidableEq (V n)] (U : ∀ n, Finset (V n)) (P : ∀ n, Finpartition (U n)) (b : ∀ n, V n → ℤ) (j : ∀ n, Finset (V n) → ℤ) (w : ∀ n, Equiv.Perm (V n)) (N : ℕ → ℝ) (hN : ∀ n, 0 < N n) (hcross : Filter.Tendsto (fun n => ((partitionWordCrossing (P n) (w n)).card : ℝ) / N n) Filter.atTop (nhds 0)) (homit : Filter.Tendsto (fun n => (((U n \\ selectedRankSupport (P n) (b n) (j n)).card : ℝ) / N n)) Filter.atTop (nhds 0)) : Filter.Tendsto (fun n => ((rankChangingArc (U n) (b n) (w n)).card : ℝ) / N n) Filter.atTop (nhds 0)"},{"kind":"theorem","name":"permutationDistance_self","statement":"{V : Type*} [Fintype V] [DecidableEq V] (p : Equiv.Perm V) : permutationDistance p p = 0"},{"kind":"theorem","name":"permutationDistance_comm","statement":"{V : Type*} [Fintype V] [DecidableEq V] (p q : Equiv.Perm V) : permutationDistance p q = permutationDistance q p"},{"kind":"theorem","name":"permutationDistance_triangle","statement":"{V : Type*} [Fintype V] [DecidableEq V] (p q r : Equiv.Perm V) : permutationDistance p r ≤ permutationDistance p q + permutationDistance q r"},{"kind":"theorem","name":"permutationDistance_mul_left","statement":"{V : Type*} [Fintype V] [DecidableEq V] (s p q : Equiv.Perm V) : permutationDistance (s * p) (s * q) = permutationDistance p q"},{"kind":"theorem","name":"permutationDistance_mul_right","statement":"{V : Type*} [Fintype V] [DecidableEq V] (s p q : Equiv.Perm V) : permutationDistance (p * s) (q * s) = permutationDistance p q"},{"kind":"theorem","name":"permutationDistance_mul_le","statement":"{V : Type*} [Fintype V] [DecidableEq V] (p p' q q' : Equiv.Perm V) : permutationDistance (p * q) (p' * q') ≤ permutationDistance p p' + permutationDistance q q'"},{"kind":"theorem","name":"permutationDistance_inv","statement":"{V : Type*} [Fintype V] [DecidableEq V] (p q : Equiv.Perm V) : permutationDistance p⁻¹ q⁻¹ = permutationDistance p q"},{"kind":"theorem","name":"permutationCommutationDefect_one","statement":"{V ι : Type*} [Fintype V] [Fintype ι] [DecidableEq V] (σ : ι → Equiv.Perm V) : permutationCommutationDefect σ 1 = 0"},{"kind":"theorem","name":"permutationCommutationDefect_inv","statement":"{V ι : Type*} [Fintype V] [Fintype ι] [DecidableEq V] (σ : ι → Equiv.Perm V) (c : Equiv.Perm V) : permutationCommutationDefect σ c⁻¹ = permutationCommutationDefect σ c"},{"kind":"theorem","name":"permutationCommutationDefect_mul_le","statement":"{V ι : Type*} [Fintype V] [Fintype ι] [DecidableEq V] (σ : ι → Equiv.Perm V) (p q : Equiv.Perm V) : permutationCommutationDefect σ (p * q) ≤ permutationCommutationDefect σ p + permutationCommutationDefect σ q"},{"kind":"theorem","name":"AlmostCentralizerElement.ext","statement":"{V ι : Type*} [Fintype V] [Fintype ι] [DecidableEq V] {σ : ι → Equiv.Perm V} {tolerance : ℕ} (p q : AlmostCentralizerElement σ tolerance) (h : p.permutation = q.permutation) : p = q"},{"kind":"theorem","name":"almostCentralizerGap_of_expansion","statement":"{V ι : Type*} [Fintype V] [Fintype ι] [DecidableEq V] (σ : ι → Equiv.Perm V) (tolerance : ℕ) (h : ℝ) (hpositive : 0 < h) (hexp : ∀ A : Finset V, h * min (A.card : ℝ) ((Fintype.card V : ℝ) - A.card) ≤ (boundary σ A : ℝ)) (hsmall : (10 : ℝ) * tolerance < h * Fintype.card V) : AlmostCentralizerGap σ tolerance"},{"kind":"theorem","name":"almostCentralizerCluster_eq_iff","statement":"{V ι : Type*} [Fintype V] [Fintype ι] [DecidableEq V] {σ : ι → Equiv.Perm V} {tolerance : ℕ} (hgap : AlmostCentralizerGap σ tolerance) (p q : AlmostCentralizerElement σ tolerance) : almostCentralizerCluster hgap p = almostCentralizerCluster hgap q ↔ 5 * permutationDistance p.permutation q.permutation ≤ Fintype.card V"},{"kind":"theorem","name":"correctedAlmostCentralizerProduct_congr","statement":"{V ι : Type*} [Fintype V] [Fintype ι] [DecidableEq V] {σ : ι → Equiv.Perm V} {tolerance : ℕ} (hgap : AlmostCentralizerGap σ tolerance) (R : AlmostCentralizerRepair σ tolerance) {p p' q q' : AlmostCentralizerElement σ tolerance} (hp : 5 * permutationDistance p.permutation p'.permutation ≤ Fintype.card V) (hq : 5 * permutationDistance q.permutation q'.permutation ≤ Fintype.card V) : 5 * permutationDistance (correctedAlmostCentralizerProduct R p q).permutation (correctedAlmostCentralizerProduct R p' q').permutation ≤ Fintype.card V"},{"kind":"theorem","name":"correctedAlmostCentralizerProduct_assoc","statement":"{V ι : Type*} [Fintype V] [Fintype ι] [DecidableEq V] {σ : ι → Equiv.Perm V} {tolerance : ℕ} (hgap : AlmostCentralizerGap σ tolerance) (R : AlmostCentralizerRepair σ tolerance) (p q r : AlmostCentralizerElement σ tolerance) : 5 * permutationDistance (correctedAlmostCentralizerProduct R (correctedAlmostCentralizerProduct R p q) r).permutation (correctedAlmostCentralizerProduct R p (correctedAlmostCentralizerProduct R q r)).permutation ≤ Fintype.card V"},{"kind":"theorem","name":"exists_finite_group_embedding_of_expanding_centralizer","statement":"{G : Type*} [Group G] (F : Finset G) (M : ExpandingCentralizerFiniteModel G F) : ∃ (H : Type) (_ : Group H) (_ : Finite H) (f : G → H), Set.InjOn f (F : Set G) ∧ f 1 = 1 ∧ ∀ x ∈ F, ∀ y ∈ F, f (x * y) = f x * f y"},{"kind":"theorem","name":"exists_permutation_embedding_of_expanding_centralizer","statement":"{G : Type*} [Group G] (F : Finset G) (M : ExpandingCentralizerFiniteModel G F) : ∃ (n : ℕ) (f : G → Equiv.Perm (Fin n)), Set.InjOn f (F : Set G) ∧ f 1 = 1 ∧ ∀ x ∈ F, ∀ y ∈ F, f (x * y) = f x * f y"},{"kind":"theorem","name":"lef_of_expanding_centralizer_models","statement":"{G : Type*} [Group G] (hmodels : ∀ F : Finset G, Nonempty (ExpandingCentralizerFiniteModel G F)) : LEF G"},{"kind":"theorem","name":"exists_positive_antitone_slow_vanishing_threshold","statement":"(e : ℕ → ℝ) (he_nonneg : ∀ n, 0 ≤ e n) (he : Tendsto e atTop (nhds 0)) : ∃ eta : ℕ → ℝ, (∀ n, 0 < eta n) ∧ Antitone eta ∧ Tendsto eta atTop (nhds 0) ∧ Tendsto (fun n => e n / eta n) atTop (nhds 0)"},{"kind":"theorem","name":"exists_positive_antitone_slow_overlap_scales","statement":"(e : ℕ → ℝ) (he_nonneg : ∀ n, 0 ≤ e n) (he : Tendsto e atTop (nhds 0)) : ∃ eta H : ℕ → ℝ, (∀ n, 0 < eta n) ∧ Antitone eta ∧ Tendsto eta atTop (nhds 0) ∧ (∀ n, 0 < H n) ∧ Antitone H ∧ Tendsto H atTop (nhds 0) ∧ Tendsto (fun n => e n / eta n) atTop (nhds 0) ∧ Tendsto (fun n => eta n / H n) atTop (nhds 0)"},{"kind":"theorem","name":"rankDropCount_goodSubtype_eq","statement":"{ι : Type*} (G : Finset ι) (u v : ι → ℝ) (H r : ℝ) : SoficGroups.rankDropCount (fun i : {i // i ∈ G} => u i.1) (fun i : {i // i ∈ G} => v i.1) H r = ∑ i ∈ G, if ⌊(v i + r) / H⌋ < ⌊(u i + r) / H⌋ then (1 : ℝ) else 0"},{"kind":"theorem","name":"rankDropCount_le_goodSubtype_add_exceptions","statement":"{ι : Type*} [Fintype ι] [DecidableEq ι] (G : Finset ι) (u v : ι → ℝ) (H r : ℝ) : SoficGroups.rankDropCount u v H r ≤ SoficGroups.rankDropCount (fun i : {i // i ∈ G} => u i.1) (fun i : {i // i ∈ G} => v i.1) H r + (((Finset.univ : Finset ι) \\ G).card : ℝ)"},{"kind":"theorem","name":"exists_common_log_rank_offset_except","statement":"{ι : Type*} [Fintype ι] [DecidableEq ι] (G : Finset ι) (x y : ι → ℝ) (eta H : ℝ) (hx : ∀ i ∈ G, 0 < x i) (heta0 : 0 ≤ eta) (heta1 : eta < 1) (hH : 0 < H) (hcomparison : ∀ i ∈ G, (1 - eta) * x i ≤ y i) : ∃ r ∈ Set.Ico 0 H, SoficGroups.rankDropCount (fun i => Real.log (x i)) (fun i => Real.log (y i)) H r ≤ (G.card : ℝ) * |Real.log (1 - eta)| / H + (((Finset.univ : Finset ι) \\ G).card : ℝ)"},{"kind":"theorem","name":"exists_common_log_rank_offsets_tendsto_zero_except","statement":"(ι : ℕ → Type*) [∀ n, Fintype (ι n)] [∀ n, DecidableEq (ι n)] (G : (n : ℕ) → Finset (ι n)) (x y : (n : ℕ) → ι n → ℝ) (eta H N : ℕ → ℝ) (C : ℝ) (hx : ∀ n i, i ∈ G n → 0 < x n i) (heta0 : ∀ n, 0 ≤ eta n) (heta1 : ∀ n, eta n < 1) (hH : ∀ n, 0 < H n) (hN : ∀ n, 0 < N n) (hcard : ∀ n, ((G n).card : ℝ) ≤ C * N n) (hcomparison : ∀ n i, i ∈ G n → (1 - eta n) * x n i ≤ y n i) (heta : Tendsto eta atTop (nhds 0)) (hratio : Tendsto (fun n => eta n / H n) atTop (nhds 0)) (hexceptions : Tendsto (fun n => (((Finset.univ : Finset (ι n)) \\ G n).card : ℝ) / N n) atTop (nhds 0)) : ∃ r : ℕ → ℝ, (∀ n, r n ∈ Set.Ico 0 (H n)) ∧ Tendsto (fun n => SoficGroups.rankDropCount (fun i => Real.log (x n i)) (fun i => Real.log (y n i)) (H n) (r n) / N n) atTop (nhds 0)"},{"kind":"theorem","name":"cylinderSwap_mul_wordS_right","statement":"(a b : List (Fin 2)) (hab : ¬ a <+: b) (hba : ¬ b <+: a) : (↑(cylinderSwap a b hab hba) : BinaryLeavitt) * leavittWordS b = leavittWordS a"},{"kind":"theorem","name":"elementaryMatrixUnitMap_elementaryUnit","statement":"(f : R →+* S) (i j : ι) (hij : i ≠ j) (a : R) : elementaryMatrixUnitMap f (elementaryUnit i j hij a) = elementaryUnit i j hij (f a)"},{"kind":"theorem","name":"elementaryGroup_map_le","statement":"(f : R →+* S) : (elementaryGroup ι R).map (elementaryMatrixUnitMap f) ≤ elementaryGroup ι S"},{"kind":"theorem","name":"elementaryGroup_map_eq_of_surjective","statement":"(f : R →+* S) (hf : Function.Surjective f) : (elementaryGroup ι R).map (elementaryMatrixUnitMap f) = elementaryGroup ι S"},{"kind":"theorem","name":"normalizedHamming_distinct_tendsto","statement":"{G : Type*} [Group G] (A : SoficGroups.SoficApproximation G) {g h : G} (hne : g ≠ h) : Tendsto (fun n => SoficGroups.normalizedHamming ((A.model n).action g) ((A.model n).action h)) atTop (𝓝 1)"},{"kind":"theorem","name":"one_mem_productTrackedTable","statement":"{J : Type*} [Group J] (F : Finset J) : 1 ∈ productTrackedTable F"},{"kind":"theorem","name":"mem_productTrackedTable","statement":"{J : Type*} [Group J] {F : Finset J} {j : J} (hj : j ∈ F) : j ∈ productTrackedTable F"},{"kind":"theorem","name":"mul_mem_productTrackedTable","statement":"{J : Type*} [Group J] {F : Finset J} {x y : J} (hx : x ∈ F) (hy : y ∈ F) : x * y ∈ productTrackedTable F"},{"kind":"theorem","name":"mem_permutationGraph","statement":"{V : Type*} [Fintype V] [DecidableEq V] (p : Equiv.Perm V) (x y : V) : (x, y) ∈ permutationGraph p ↔ y = p x"},{"kind":"theorem","name":"boundary_permutationGraph_eq_commutationDefect","statement":"{V ι : Type*} [Fintype V] [Fintype ι] [DecidableEq V] (σ : ι → Equiv.Perm V) (p : Equiv.Perm V) : boundary (fun i => (σ i).prodCongr (σ i)) (permutationGraph p) = permutationCommutationDefect σ p"},{"kind":"theorem","name":"kazhdan_generator_displacement","statement":"{G : Type u} {H : Type v} [Group G] [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H] (P : KazhdanPair.{u, v} G) (π : UnitaryRepresentation G H) (hfixed : ∀ η : H, (∀ g : G, π g η = η) → η = 0) (ξ : H) (hξ : ξ ≠ 0) : ∃ g ∈ P.generators, P.kazhdanConstant * ‖ξ‖ ≤ ‖π g ξ - ξ‖"},{"kind":"theorem","name":"prefixWordAction_append","statement":"{g : BinaryLeavittˣ} {a b : List (Fin 2)} (h : PrefixWordAction g a b) (r : List (Fin 2)) : PrefixWordAction g (a ++ r) (b ++ r)"},{"kind":"theorem","name":"prefixWordAction_mul","statement":"{g h : BinaryLeavittˣ} {a b c : List (Fin 2)} (hg : PrefixWordAction g b c) (hh : PrefixWordAction h a b) : PrefixWordAction (g * h) a c"},{"kind":"theorem","name":"cylinderSwap_prefixWordAction_left","statement":"(a b : List (Fin 2)) (hab : ¬ a <+: b) (hba : ¬ b <+: a) : PrefixWordAction (cylinderSwap a b hab hba) a b"},{"kind":"theorem","name":"cylinderSwap_prefixWordAction_right","statement":"(a b : List (Fin 2)) (hab : ¬ a <+: b) (hba : ¬ b <+: a) : PrefixWordAction (cylinderSwap a b hab hba) b a"},{"kind":"theorem","name":"cylinderSwap_prefixWordAction_fixed","statement":"(a b w : List (Fin 2)) (hab : ¬ a <+: b) (hba : ¬ b <+: a) (haw : ¬ a <+: w) (hwa : ¬ w <+: a) (hbw : ¬ b <+: w) (hwb : ¬ w <+: b) : PrefixWordAction (cylinderSwap a b hab hba) w w"},{"kind":"theorem","name":"prefixInsertionHom_conjugate_of_prefixWordAction","statement":"(g : BinaryLeavittˣ) (a b : List (Fin 2)) (h : PrefixWordAction g a b) (u : BinaryLeavittˣ) : g * prefixInsertionHom a u * g⁻¹ = prefixInsertionHom b u"},{"kind":"theorem","name":"prefixInsertionHom_mem_binaryPrefixTranspositionGroup","statement":"(a : List (Fin 2)) (u : BinaryLeavittˣ) (hu : u ∈ binaryPrefixTranspositionGroup) : prefixInsertionHom a u ∈ binaryPrefixTranspositionGroup"},{"kind":"theorem","name":"elementaryBlockUnitEquiv_elementaryUnit_single","statement":"(i j : ι) (hij : i ≠ j) (k l : κ) (a : R) : elementaryBlockUnitEquiv (ι"},{"kind":"theorem","name":"elementaryBlockUnitEquiv_elementaryUnit_mem","statement":"(i j : ι) (hij : i ≠ j) (A : Matrix κ κ R) : elementaryBlockUnitEquiv (ι"},{"kind":"theorem","name":"elementaryBlockGroup_map","statement":"[Nontrivial ι] : (elementaryGroup ι (Matrix κ κ R)).map (elementaryBlockUnitEquiv (ι"},{"kind":"theorem","name":"elementaryReindexUnitEquiv_elementaryUnit","statement":"(e : ι ≃ κ) (i j : ι) (hij : i ≠ j) (a : R) : elementaryReindexUnitEquiv (R"},{"kind":"theorem","name":"elementaryReindexGroup_map","statement":"(e : ι ≃ κ) : (elementaryGroup ι R).map (elementaryReindexUnitEquiv (R"},{"kind":"theorem","name":"ternaryLeavittPrefixCode_complete","statement":"MatrixCorner.codeIdempotent (fun i => leavittWordS (ternaryLeavittPrefixCode.word i)) (fun i => leavittWordT (ternaryLeavittPrefixCode.word i)) = 1"},{"kind":"theorem","name":"binaryLeavittElementaryThree_hasPropertyT_of_nine","statement":"[HasPropertyT.{0, v} (binaryLeavittElementaryGroup 9)] : HasPropertyT.{0, v} (binaryLeavittElementaryGroup 3)"},{"kind":"theorem","name":"alphaPrefixElementaryGroup_hasPropertyT_of_nine","statement":"[HasPropertyT.{0, v} (binaryLeavittElementaryGroup 9)] : HasPropertyT.{0, v} (prefixElementaryGroup alphaPrefixCode)"},{"kind":"theorem","name":"alphaZeroPrefixElementaryGroup_hasPropertyT_of_nine","statement":"[HasPropertyT.{0, v} (binaryLeavittElementaryGroup 9)] : HasPropertyT.{0, v} (prefixElementaryGroup alphaZeroPrefixCode)"},{"kind":"theorem","name":"cylinderSwap_prefixWordAction_of_cases","statement":"{a b w v : List (Fin 2)} (hab : ¬ a <+: b) (hba : ¬ b <+: a) (hcase : (a <+: w ∧ v = b ++ w.drop a.length) ∨ (b <+: w ∧ v = a ++ w.drop b.length) ∨ (v = w ∧ ¬ a <+: w ∧ ¬ w <+: a ∧ ¬ b <+: w ∧ ¬ w <+: b)) : PrefixWordAction (cylinderSwap a b hab hba) w v"},{"kind":"theorem","name":"three_pair_sum_norm_sq","statement":"(a b c : H) : ‖a + b‖ ^ 2 + ‖b + c‖ ^ 2 + ‖c + a‖ ^ 2 = ‖a + b + c‖ ^ 2 + (‖a‖ ^ 2 + ‖b‖ ^ 2 + ‖c‖ ^ 2)"},{"kind":"theorem","name":"norm_add_three_sq_le_three_mul","statement":"(a b c : H) : ‖a + b + c‖ ^ 2 ≤ 3 * (‖a‖ ^ 2 + ‖b‖ ^ 2 + ‖c‖ ^ 2)"},{"kind":"theorem","name":"three_pairwise_residual_spectral_gap","statement":"(a b c : H) (ε : ℝ) (hab : (1 - ε) * (‖a‖ ^ 2 + ‖b‖ ^ 2) ≤ ‖a + b‖ ^ 2) (hbc : (1 - ε) * (‖b‖ ^ 2 + ‖c‖ ^ 2) ≤ ‖b + c‖ ^ 2) (hca : (1 - ε) * (‖c‖ ^ 2 + ‖a‖ ^ 2) ≤ ‖c + a‖ ^ 2) : (1 - 2 * ε) * (‖a‖ ^ 2 + ‖b‖ ^ 2 + ‖c‖ ^ 2) ≤ ‖a + b + c‖ ^ 2"},{"kind":"theorem","name":"inner_sq_le_of_orthogonal_two_sector","statement":"(a₀ a₁ b₀ b₁ : H) (ha : inner ℂ a₀ a₁ = 0) (hb : inner ℂ b₀ b₁ = 0) (hcross₀ : inner ℂ a₀ b₁ = 0) (hcross₁ : inner ℂ a₁ b₀ = 0) (h₀ : 8 * ‖inner ℂ a₀ b₀‖ ^ 2 ≤ ‖a₀‖ ^ 2 * ‖b₀‖ ^ 2) (h₁ : 8 * ‖inner ℂ a₁ b₁‖ ^ 2 ≤ ‖a₁‖ ^ 2 * ‖b₁‖ ^ 2) : 8 * ‖inner ℂ (a₀ + a₁) (b₀ + b₁)‖ ^ 2 ≤ ‖a₀ + a₁‖ ^ 2 * ‖b₀ + b₁‖ ^ 2"},{"kind":"theorem","name":"inner_sq_le_of_finite_orthogonal_sector_splitting","statement":"{ι : Type*} [Fintype ι] (F : ι → Submodule ℂ H) [∀ i, (F i).HasOrthogonalProjection] (U V : Submodule ℂ H) (hU : ∀ (i : ι) ⦃x : H⦄, x ∈ U → (F i).starProjection x ∈ U) (hV : ∀ (i : ι) ⦃x : H⦄, x ∈ V → (F i).starProjection x ∈ V) (hF : ∀ (i j : ι) ⦃x : H⦄, x ∈ F j → (F i).starProjection x ∈ F j) (hsector : ∀ (i : ι) (a b : H), a ∈ U → b ∈ V → a ∈ (F i)ᗮ → b ∈ (F i)ᗮ → 8 * ‖inner ℂ a b‖ ^ 2 ≤ ‖a‖ ^ 2 * ‖b‖ ^ 2) (hterminal : ∀ (a b : H), a ∈ U → b ∈ V → (∀ i, a ∈ F i) → (∀ i, b ∈ F i) → inner ℂ a b = 0) (a b : H) (ha : a ∈ U) (hb : b ∈ V) : 8 * ‖inner ℂ a b‖ ^ 2 ≤ ‖a‖ ^ 2 * ‖b‖ ^ 2"},{"kind":"theorem","name":"ejStarProjection_re_inner","statement":"(W : Submodule ℂ H) [W.HasOrthogonalProjection] (x : H) : RCLike.re (inner ℂ (W.starProjection x) x) = ‖W.starProjection x‖ ^ 2"},{"kind":"theorem","name":"ejResidualProjection_apply","statement":"(V : Submodule ℂ H) [V.HasOrthogonalProjection] (x : H) : ejResidualProjection V x = x - V.starProjection x"},{"kind":"theorem","name":"ejResidualProjection_idempotent","statement":"(V : Submodule ℂ H) [V.HasOrthogonalProjection] (x : H) : ejResidualProjection V (ejResidualProjection V x) = ejResidualProjection V x"},{"kind":"theorem","name":"ejResidualProjection_inner","statement":"(V : Submodule ℂ H) [V.HasOrthogonalProjection] (x y : H) : inner ℂ (ejResidualProjection V x) y = inner ℂ x (ejResidualProjection V y)"},{"kind":"theorem","name":"ejResidualProjection_re_inner","statement":"(V : Submodule ℂ H) [V.HasOrthogonalProjection] (x : H) : RCLike.re (inner ℂ (ejResidualProjection V x) x) = ‖ejResidualProjection V x‖ ^ 2"},{"kind":"theorem","name":"ejThreeResidualMap_apply","statement":"(x : H) : ejThreeResidualMap V x = ejResidualProjection (V 0) x + ejResidualProjection (V 1) x + ejResidualProjection (V 2) x"},{"kind":"theorem","name":"ejThreeProjectionAverage_apply","statement":"(x : H) : ejThreeProjectionAverage V x = x - (3 : ℂ)⁻¹ • ejThreeResidualMap V x"},{"kind":"theorem","name":"ejThreeResidualEnergy_nonneg","statement":"(x : H) : 0 ≤ ejThreeResidualEnergy V x"},{"kind":"theorem","name":"ejThreeResidualEnergy_eq_re_inner","statement":"(x : H) : ejThreeResidualEnergy V x = RCLike.re (inner ℂ (ejThreeResidualMap V x) x)"},{"kind":"theorem","name":"ejThreeResidualMap_norm_sq_le","statement":"(x : H) : ‖ejThreeResidualMap V x‖ ^ 2 ≤ 3 * ejThreeResidualEnergy V x"},{"kind":"theorem","name":"ejResidualProjection_norm_le","statement":"(i : Fin 3) (x : H) : ‖ejResidualProjection (V i) x‖ ≤ ‖x‖"},{"kind":"theorem","name":"ejThreeResidualEnergy_le_three_norm_sq","statement":"(x : H) : ejThreeResidualEnergy V x ≤ 3 * ‖x‖ ^ 2"},{"kind":"theorem","name":"ejResidualProjection_cross_inner","statement":"(W : Submodule ℂ H) [W.HasOrthogonalProjection] (x z : H) : inner ℂ (ejResidualProjection W x) (ejResidualProjection W z) = inner ℂ (ejResidualProjection W x) z"},{"kind":"theorem","name":"ejThreeResidual_cross_re_inner","statement":"(x : H) : RCLike.re (inner ℂ (ejResidualProjection (V 0) x) (ejResidualProjection (V 0) (ejThreeResidualMap V x))) + RCLike.re (inner ℂ (ejResidualProjection (V 1) x) (ejResidualProjection (V 1) (ejThreeResidualMap V x))) + RCLike.re (inner ℂ (ejResidualProjection (V 2) x) (ejResidualProjection (V 2) (ejThreeResidualMap V x))) = ‖ejThreeResidualMap V x‖ ^ 2"},{"kind":"theorem","name":"norm_sub_one_third_smul_sq","statement":"(a b : H) : ‖a - (3 : ℂ)⁻¹ • b‖ ^ 2 = ‖a‖ ^ 2 - (2 / 3 : ℝ) * RCLike.re (inner ℂ a b) + (1 / 9 : ℝ) * ‖b‖ ^ 2"},{"kind":"theorem","name":"ejResidualProjection_average_norm_sq","statement":"(W : Submodule ℂ H) [W.HasOrthogonalProjection] (x z : H) : ‖ejResidualProjection W (x - (3 : ℂ)⁻¹ • z)‖ ^ 2 = ‖ejResidualProjection W x‖ ^ 2 - (2 / 3 : ℝ) * RCLike.re (inner ℂ (ejResidualProjection W x) (ejResidualProjection W z)) + (1 / 9 : ℝ) * ‖ejResidualProjection W z‖ ^ 2"},{"kind":"theorem","name":"ejThreeResidualEnergy_average","statement":"(x : H) : ejThreeResidualEnergy V (ejThreeProjectionAverage V x) = ejThreeResidualEnergy V x - (2 / 3 : ℝ) * ‖ejThreeResidualMap V x‖ ^ 2 + (1 / 9 : ℝ) * ejThreeResidualEnergy V (ejThreeResidualMap V x)"},{"kind":"theorem","name":"ejThreeResidualMap_spectral_gap","statement":"(x : H) (ε : ℝ) (h01 : (1 - ε) * (‖ejResidualProjection (V 0) x‖ ^ 2 + ‖ejResidualProjection (V 1) x‖ ^ 2) ≤ ‖ejResidualProjection (V 0) x + ejResidualProjection (V 1) x‖ ^ 2) (h12 : (1 - ε) * (‖ejResidualProjection (V 1) x‖ ^ 2 + ‖ejResidualProjection (V 2) x‖ ^ 2) ≤ ‖ejResidualProjection (V 1) x + ejResidualProjection (V 2) x‖ ^ 2) (h20 : (1 - ε) * (‖ejResidualProjection (V 2) x‖ ^ 2 + ‖ejResidualProjection (V 0) x‖ ^ 2) ≤ ‖ejResidualProjection (V 2) x + ejResidualProjection (V 0) x‖ ^ 2) : (1 - 2 * ε) * ejThreeResidualEnergy V x ≤ ‖ejThreeResidualMap V x‖ ^ 2"},{"kind":"theorem","name":"ejThreeResidualEnergy_average_le","statement":"(x : H) (δ : ℝ) (hgap : δ * ejThreeResidualEnergy V x ≤ ‖ejThreeResidualMap V x‖ ^ 2) : ejThreeResidualEnergy V (ejThreeProjectionAverage V x) ≤ (1 - δ / 3) * ejThreeResidualEnergy V x"},{"kind":"theorem","name":"ejStarProjection_mem_inf_orthogonal","statement":"(U V : Submodule ℂ H) [U.HasOrthogonalProjection] (w : H) (hw : w ∈ (U ⊓ V)ᗮ) : U.starProjection w ∈ (U ⊓ V)ᗮ"},{"kind":"theorem","name":"ejTwoProjection_norm_sq_sum_le_of_angle","statement":"(U V : Submodule ℂ H) [U.HasOrthogonalProjection] [V.HasOrthogonalProjection] (c : ℝ) (hc : 0 ≤ c) (hangle : ∀ (u v : H), u ∈ U → u ∈ (U ⊓ V)ᗮ → v ∈ V → v ∈ (U ⊓ V)ᗮ → ‖inner ℂ u v‖ ≤ c * ‖u‖ * ‖v‖) (w : H) (hw : w ∈ (U ⊓ V)ᗮ) : ‖U.starProjection w‖ ^ 2 + ‖V.starProjection w‖ ^ 2 ≤ (1 + c) * ‖w‖ ^ 2"},{"kind":"theorem","name":"ejTwoResidualEnergy_ge_of_angle","statement":"(U V : Submodule ℂ H) [U.HasOrthogonalProjection] [V.HasOrthogonalProjection] (c : ℝ) (hc : 0 ≤ c) (hangle : ∀ (u v : H), u ∈ U → u ∈ (U ⊓ V)ᗮ → v ∈ V → v ∈ (U ⊓ V)ᗮ → ‖inner ℂ u v‖ ≤ c * ‖u‖ * ‖v‖) (w : H) (hw : w ∈ (U ⊓ V)ᗮ) : (1 - c) * ‖w‖ ^ 2 ≤ ‖ejResidualProjection U w‖ ^ 2 + ‖ejResidualProjection V w‖ ^ 2"},{"kind":"theorem","name":"ejTwoResidual_sum_re_inner","statement":"(U V : Submodule ℂ H) [U.HasOrthogonalProjection] [V.HasOrthogonalProjection] (w : H) : RCLike.re (inner ℂ (ejResidualProjection U w + ejResidualProjection V w) w) = ‖ejResidualProjection U w‖ ^ 2 + ‖ejResidualProjection V w‖ ^ 2"},{"kind":"theorem","name":"ejTwoResidual_spectral_gap_of_angle","statement":"(U V : Submodule ℂ H) [U.HasOrthogonalProjection] [V.HasOrthogonalProjection] [(U ⊓ V).HasOrthogonalProjection] (c : ℝ) (hc : 0 ≤ c) (hc' : c ≤ 1) (hangle : ∀ (u v : H), u ∈ U → u ∈ (U ⊓ V)ᗮ → v ∈ V → v ∈ (U ⊓ V)ᗮ → ‖inner ℂ u v‖ ≤ c * ‖u‖ * ‖v‖) (x : H) : (1 - c) * (‖ejResidualProjection U x‖ ^ 2 + ‖ejResidualProjection V x‖ ^ 2) ≤ ‖ejResidualProjection U x + ejResidualProjection V x‖ ^ 2"},{"kind":"theorem","name":"ejThreeProjectionAverage_dist_sq","statement":"(x : H) : dist x (ejThreeProjectionAverage V x) ^ 2 = (1 / 9 : ℝ) * ‖ejThreeResidualMap V x‖ ^ 2"},{"kind":"theorem","name":"ejThreeProjectionAverage_dist_sq_le","statement":"(x : H) : dist x (ejThreeProjectionAverage V x) ^ 2 ≤ ejThreeResidualEnergy V x / 3"},{"kind":"theorem","name":"ejThreeResidualEnergy_iterate_le","statement":"(δ : ℝ) (hδ : δ ≤ 3) (hgap : ∀ x : H, δ * ejThreeResidualEnergy V x ≤ ‖ejThreeResidualMap V x‖ ^ 2) (x : H) (n : ℕ) : ejThreeResidualEnergy V (((ejThreeProjectionAverage V : H → H)^[n]) x) ≤ (1 - δ / 3) ^ n * ejThreeResidualEnergy V x"},{"kind":"theorem","name":"ejThreeProjectionAverage_iterate_dist_le_geometric","statement":"(δ : ℝ) (hδ : δ ≤ 3) (hgap : ∀ x : H, δ * ejThreeResidualEnergy V x ≤ ‖ejThreeResidualMap V x‖ ^ 2) (x : H) (n : ℕ) : dist (((ejThreeProjectionAverage V : H → H)^[n]) x) (((ejThreeProjectionAverage V : H → H)^[n + 1]) x) ≤ Real.sqrt (ejThreeResidualEnergy V x / 3) * (1 - δ / 6) ^ n"},{"kind":"theorem","name":"ejThreeResidual_spectral_gap_of_pair_angles","statement":"[∀ i j : Fin 3, (V i ⊓ V j).HasOrthogonalProjection] (c : ℝ) (hc : 0 ≤ c) (hc' : c ≤ 1) (hangle : ∀ (i j : Fin 3) (u v : H), u ∈ V i → u ∈ (V i ⊓ V j)ᗮ → v ∈ V j → v ∈ (V i ⊓ V j)ᗮ → ‖inner ℂ u v‖ ≤ c * ‖u‖ * ‖v‖) (x : H) : (1 - 2 * c) * ejThreeResidualEnergy V x ≤ ‖ejThreeResidualMap V x‖ ^ 2"},{"kind":"theorem","name":"ejThreeProjectionAverage_iterate_dist_le_of_pair_angles","statement":"[∀ i j : Fin 3, (V i ⊓ V j).HasOrthogonalProjection] (c : ℝ) (hc : 0 ≤ c) (hchalf : c < (1 / 2 : ℝ)) (hangle : ∀ (i j : Fin 3) (u v : H), u ∈ V i → u ∈ (V i ⊓ V j)ᗮ → v ∈ V j → v ∈ (V i ⊓ V j)ᗮ → ‖inner ℂ u v‖ ≤ c * ‖u‖ * ‖v‖) (x : H) (n : ℕ) : dist (((ejThreeProjectionAverage V : H → H)^[n]) x) (((ejThreeProjectionAverage V : H → H)^[n + 1]) x) ≤ Real.sqrt (ejThreeResidualEnergy V x / 3) * (1 - (1 - 2 * c) / 6) ^ n"},{"kind":"theorem","name":"ejThreeResidualEnergy_sqrt_div_three_le","statement":"(x : H) (T : ℝ) (hT : 0 ≤ T) (hbound : ∀ i : Fin 3, ‖ejResidualProjection (V i) x‖ ≤ T) : Real.sqrt (ejThreeResidualEnergy V x / 3) ≤ T"},{"kind":"theorem","name":"ejThreeProjectionAverage_fixed_iff_residualMap_eq_zero","statement":"(x : H) : ejThreeProjectionAverage V x = x ↔ ejThreeResidualMap V x = 0"},{"kind":"theorem","name":"ejThreeResidualEnergy_eq_zero_iff","statement":"(x : H) : ejThreeResidualEnergy V x = 0 ↔ ∀ i : Fin 3, ejResidualProjection (V i) x = 0"},{"kind":"theorem","name":"ejThreeProjectionAverage_fixed_mem","statement":"(x : H) (hx : ejThreeProjectionAverage V x = x) (i : Fin 3) : x ∈ V i"},{"kind":"theorem","name":"mem_ejUnitaryFixedSubmodule","statement":"{G : Type u₂} {H : Type v₂} [Group G] [NormedAddCommGroup H] [InnerProductSpace ℂ H] (π : UnitaryRepresentation G H) (K : Subgroup G) (x : H) : x ∈ ejUnitaryFixedSubmodule π K ↔ ∀ k : K, π (k : G) x = x"},{"kind":"theorem","name":"ejUnitaryFixedSubmodule_isClosed","statement":"{G : Type u₂} {H : Type v₂} [Group G] [NormedAddCommGroup H] [InnerProductSpace ℂ H] (π : UnitaryRepresentation G H) (K : Subgroup G) : IsClosed (ejUnitaryFixedSubmodule π K : Set H)"},{"kind":"theorem","name":"ejUnitaryFixedSubmodule_inf_isClosed","statement":"{G : Type u₂} {H : Type v₂} [Group G] [NormedAddCommGroup H] [InnerProductSpace ℂ H] (π : UnitaryRepresentation G H) (K J : Subgroup G) : IsClosed ((ejUnitaryFixedSubmodule π K ⊓ ejUnitaryFixedSubmodule π J : Submodule ℂ H) : Set H)"},{"kind":"theorem","name":"finiteUnitarySubgroupAverage_fixed","statement":"(π : SoficGroups.UnitaryRepresentation G H) (K : Subgroup G) [Fintype K] (x : H) (g : K) : π (g : G) (finiteUnitarySubgroupAverage π K x) = finiteUnitarySubgroupAverage π K x"},{"kind":"theorem","name":"finiteUnitarySubgroupAverage_sub","statement":"(π : SoficGroups.UnitaryRepresentation G H) (K : Subgroup G) [Fintype K] (x : H) : finiteUnitarySubgroupAverage π K x - x = (Fintype.card K : ℂ)⁻¹ • ∑ k : K, (π (k : G) x - x)"},{"kind":"theorem","name":"norm_finiteUnitarySubgroupAverage_sub_le","statement":"(π : SoficGroups.UnitaryRepresentation G H) (K : Subgroup G) [Fintype K] (x : H) : ‖finiteUnitarySubgroupAverage π K x - x‖ ≤ (Fintype.card K : ℝ)⁻¹ * ∑ k : K, ‖π (k : G) x - x‖"},{"kind":"theorem","name":"norm_sub_starProjection_le_finiteUnitarySubgroupAverage","statement":"(π : SoficGroups.UnitaryRepresentation G H) (K : Subgroup G) [Fintype K] (U : Submodule ℂ H) [U.HasOrthogonalProjection] (x : H) (hmem : finiteUnitarySubgroupAverage π K x ∈ U) : ‖x - U.starProjection x‖ ≤ ‖finiteUnitarySubgroupAverage π K x - x‖"},{"kind":"theorem","name":"hasPropertyT_of_geometric_finite_averaging","statement":"{G : Type u} [Group G] (S : Finset G) (q : ℝ) (hq1 : q < 1) (haverage : ∀ (H : Type v) [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H] (π : SoficGroups.UnitaryRepresentation G H), ∃ A : H →L[ℂ] H, (∀ (x : H) (n : ℕ), dist ((A : H → H)^[n] x) ((A : H → H)^[n + 1] x) ≤ (∑ g ∈ S, ‖π g x - x‖) * q ^ n) ∧ (∀ x : H, A x = x → ∀ g : G, π g x = x)) : SoficGroups.HasPropertyT.{u, v} G"},{"kind":"theorem","name":"mem_threeFiniteSubgroupGenerators","statement":"{G : Type u} [Group G] (K : Fin 3 → Subgroup G) [∀ i, Fintype (K i)] (g : G) : g ∈ threeFiniteSubgroupGenerators K ↔ ∃ i : Fin 3, g ∈ K i"},{"kind":"theorem","name":"hasPropertyT_of_three_finite_subgroups_geometric","statement":"{G : Type u} [Group G] (K : Fin 3 → Subgroup G) [∀ i, Fintype (K i)] (hgen : (⨆ i : Fin 3, K i) = ⊤) (q : ℝ) (hq : q < 1) (haverage : ∀ (H : Type v) [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H] (π : SoficGroups.UnitaryRepresentation G H), ∃ A : H →L[ℂ] H, (∀ (x : H) (n : ℕ), dist ((A : H → H)^[n] x) ((A : H → H)^[n + 1] x) ≤ (∑ g ∈ threeFiniteSubgroupGenerators K, ‖π g x - x‖) * q ^ n) ∧ (∀ x : H, A x = x → ∀ (i : Fin 3) (g : K i), π (g : G) x = x)) : SoficGroups.HasPropertyT.{u, v} G"},{"kind":"theorem","name":"inv_sqrt_eight_pos","statement":"0 < (Real.sqrt (8 : ℝ))⁻¹"},{"kind":"theorem","name":"inv_sqrt_eight_lt_one_half","statement":"(Real.sqrt (8 : ℝ))⁻¹ < (1 / 2 : ℝ)"},{"kind":"theorem","name":"norm_inner_le_inv_sqrt_eight_of_sq","statement":"{H : Type v} [NormedAddCommGroup H] [InnerProductSpace ℂ H] (a b : H) (h : 8 * ‖inner ℂ a b‖ ^ 2 ≤ ‖a‖ ^ 2 * ‖b‖ ^ 2) : ‖inner ℂ a b‖ ≤ (Real.sqrt (8 : ℝ))⁻¹ * ‖a‖ * ‖b‖"},{"kind":"theorem","name":"hasPropertyT_of_three_finite_subgroups_friedrichs_angle","statement":"{G : Type u} [Group G] (K : Fin 3 → Subgroup G) [∀ i, Fintype (K i)] (hgen : (⨆ i : Fin 3, K i) = ⊤) (c : ℝ) (hc : 0 ≤ c) (hchalf : c < (1 / 2 : ℝ)) (hangle : ∀ (H : Type v) [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H] (π : SoficGroups.UnitaryRepresentation G H) (i j : Fin 3), i ≠ j → ∀ (a b : H), a ∈ SoficGroups.ejUnitaryFixedSubmodule π (K i) → a ∈ (SoficGroups.ejUnitaryFixedSubmodule π (K i) ⊓ SoficGroups.ejUnitaryFixedSubmodule π (K j))ᗮ → b ∈ SoficGroups.ejUnitaryFixedSubmodule π (K j) → b ∈ (SoficGroups.ejUnitaryFixedSubmodule π (K i) ⊓ SoficGroups.ejUnitaryFixedSubmodule π (K j))ᗮ → ‖inner ℂ a b‖ ≤ c * ‖a‖ * ‖b‖) : SoficGroups.HasPropertyT.{u, v} G"},{"kind":"theorem","name":"finiteBlockGaloisField_natCard","statement":"Nat.card finiteBlockGaloisField = 8"},{"kind":"theorem","name":"finiteBlockCoefficientMatrix_mul_binary_mem","statement":"(W : Submodule (ZMod 2) R) (A : Matrix (Fin 3) (Fin 3) R) (hA : ∀ i j, A i j ∈ W) (B : Matrix (Fin 3) (Fin 3) (ZMod 2)) : ∀ i j, (A * RingHom.mapMatrix (algebraMap (ZMod 2) R) B) i j ∈ W"},{"kind":"theorem","name":"finiteBlockCoefficientMatrix_binary_mul_mem","statement":"(W : Submodule (ZMod 2) R) (A : Matrix (Fin 3) (Fin 3) R) (hA : ∀ i j, A i j ∈ W) (B : Matrix (Fin 3) (Fin 3) (ZMod 2)) : ∀ i j, (RingHom.mapMatrix (algebraMap (ZMod 2) R) B * A) i j ∈ W"},{"kind":"theorem","name":"finiteBlockCoefficientMatrix_mul_galois_mem","statement":"(W : Submodule (ZMod 2) R) (A : Matrix (Fin 3) (Fin 3) R) (hA : ∀ i j, A i j ∈ W) (t : finiteBlockGaloisField) : ∀ i j, (A * finiteBlockGaloisMatrixOver R t) i j ∈ W"},{"kind":"theorem","name":"finiteBlockCoefficientMatrix_galois_mul_mem","statement":"(W : Submodule (ZMod 2) R) (A : Matrix (Fin 3) (Fin 3) R) (hA : ∀ i j, A i j ∈ W) (t : finiteBlockGaloisField) : ∀ i j, (finiteBlockGaloisMatrixOver R t * A) i j ∈ W"},{"kind":"theorem","name":"finite_finiteOuterBlockRootSubgroup","statement":"(W : Submodule (ZMod 2) R) [Finite W] (i j : Fin 3) (hij : i ≠ j) : Finite (finiteOuterBlockRootSubgroup W i j hij)"},{"kind":"theorem","name":"finiteOuterElementaryRoot_commutator","statement":"(i j k : Fin 3) (hij : i ≠ j) (hjk : j ≠ k) (hik : i ≠ k) (A B : Matrix (Fin 3) (Fin 3) R) : ⁅elementaryRootHom i j hij (Multiplicative.ofAdd A), elementaryRootHom j k hjk (Multiplicative.ofAdd B)⁆ = elementaryRootHom i k hik (Multiplicative.ofAdd (A * B))"},{"kind":"theorem","name":"finiteOuterElementaryRoot_conjugate_by_successor","statement":"(i j k : Fin 3) (hij : i ≠ j) (hjk : j ≠ k) (hik : i ≠ k) (A B : Matrix (Fin 3) (Fin 3) R) : let x"},{"kind":"theorem","name":"finiteOuterElementaryUnit_commute_of_nonadjacent","statement":"(i j k l : Fin 3) (hij : i ≠ j) (hkl : k ≠ l) (hjk : j ≠ k) (hli : l ≠ i) (A B : Matrix (Fin 3) (Fin 3) R) : Commute (elementaryUnit i j hij A) (elementaryUnit k l hkl B)"},{"kind":"theorem","name":"finiteOuterElementaryRoot_commute_of_nonadjacent","statement":"(i j k l : Fin 3) (hij : i ≠ j) (hkl : k ≠ l) (hjk : j ≠ k) (hli : l ≠ i) (A B : Matrix (Fin 3) (Fin 3) R) : Commute (elementaryRootHom i j hij (Multiplicative.ofAdd A)) (elementaryRootHom k l hkl (Multiplicative.ofAdd B))"},{"kind":"theorem","name":"finiteOuterElementaryRoot_commute_same","statement":"(i j : Fin 3) (hij : i ≠ j) (A B : Matrix (Fin 3) (Fin 3) R) : Commute (elementaryRootHom i j hij (Multiplicative.ofAdd A)) (elementaryRootHom i j hij (Multiplicative.ofAdd B))"},{"kind":"theorem","name":"finiteOuterBlockRoot_commutator_mem_productCentral","statement":"(W : Submodule (ZMod 2) R) (i j k : Fin 3) (hij : i ≠ j) (hjk : j ≠ k) (hik : i ≠ k) (A B : Matrix (Fin 3) (Fin 3) W) : ⁅finiteOuterBlockRootHom W i j hij (Multiplicative.ofAdd A), finiteOuterBlockRootHom W j k hjk (Multiplicative.ofAdd B)⁆ ∈ finiteOuterBlockProductCentralRootSubgroup W i k hik B"},{"kind":"theorem","name":"finiteOuterBlockRoot_commutator_exists_productCentral","statement":"(W : Submodule (ZMod 2) R) (i j k : Fin 3) (hij : i ≠ j) (hjk : j ≠ k) (hik : i ≠ k) (x y : elementaryGroup (Fin 3) (Matrix (Fin 3) (Fin 3) R)) (hx : x ∈ finiteOuterBlockRootSubgroup W i j hij) (hy : y ∈ finiteOuterBlockRootSubgroup W j k hjk) : ∃ B : Matrix (Fin 3) (Fin 3) W, ⁅x, y⁆ ∈ finiteOuterBlockProductCentralRootSubgroup W i k hik B"},{"kind":"theorem","name":"finiteOuterBlockProductCentralRoot_commute_left","statement":"(W : Submodule (ZMod 2) R) (i j k : Fin 3) (hij : i ≠ j) (hik : i ≠ k) (B : Matrix (Fin 3) (Fin 3) W) (x z : elementaryGroup (Fin 3) (Matrix (Fin 3) (Fin 3) R)) (hx : x ∈ finiteOuterBlockRootSubgroup W i j hij) (hz : z ∈ finiteOuterBlockProductCentralRootSubgroup W i k hik B) : Commute x z"},{"kind":"theorem","name":"finiteOuterBlockProductCentralRoot_commute_right","statement":"(W : Submodule (ZMod 2) R) (i j k : Fin 3) (hjk : j ≠ k) (hik : i ≠ k) (B : Matrix (Fin 3) (Fin 3) W) (y z : elementaryGroup (Fin 3) (Matrix (Fin 3) (Fin 3) R)) (hy : y ∈ finiteOuterBlockRootSubgroup W j k hjk) (hz : z ∈ finiteOuterBlockProductCentralRootSubgroup W i k hik B) : Commute y z"},{"kind":"theorem","name":"finiteOuterBlockProductCentralRoot_pair_le_centralizer","statement":"(W : Submodule (ZMod 2) R) (i j k : Fin 3) (hij : i ≠ j) (hjk : j ≠ k) (hik : i ≠ k) (B : Matrix (Fin 3) (Fin 3) W) : finiteOuterBlockRootSubgroup W i j hij ⊔ finiteOuterBlockRootSubgroup W j k hjk ≤ Subgroup.centralizer (finiteOuterBlockProductCentralRootSubgroup W i k hik B : Set (elementaryGroup (Fin 3) (Matrix (Fin 3) (Fin 3) R)))"},{"kind":"theorem","name":"finiteOuterBlockProductCentralRoots_commute","statement":"(W : Submodule (ZMod 2) R) (i k : Fin 3) (hik : i ≠ k) (B C : Matrix (Fin 3) (Fin 3) W) (z w : elementaryGroup (Fin 3) (Matrix (Fin 3) (Fin 3) R)) (hz : z ∈ finiteOuterBlockProductCentralRootSubgroup W i k hik B) (hw : w ∈ finiteOuterBlockProductCentralRootSubgroup W i k hik C) : Commute z w"},{"kind":"theorem","name":"finiteBlockCoefficientMatrixHom_galoisLeftProduct","statement":"(W : Submodule (ZMod 2) R) (B : Matrix (Fin 3) (Fin 3) W) (t : finiteBlockGaloisField) : finiteBlockCoefficientMatrixHom W (finiteBlockGaloisLeftProductCoefficientMatrix W B t) = finiteBlockGaloisMatrixOver R t * finiteBlockCoefficientMatrixHom W B"},{"kind":"theorem","name":"finiteOuterBlockGaloisConjugatorWithCoefficient_mem","statement":"(W : Submodule (ZMod 2) R) (j k : Fin 3) (hjk : j ≠ k) (B : Matrix (Fin 3) (Fin 3) W) (t : finiteBlockGaloisField) : finiteOuterBlockGaloisConjugatorWithCoefficient W j k hjk B t ∈ finiteOuterBlockRootSubgroup W j k hjk"},{"kind":"theorem","name":"finiteOuterElementaryRootConjugates_commute","statement":"(i j k : Fin 3) (hij : i ≠ j) (hjk : j ≠ k) (hik : i ≠ k) (A C P Q : Matrix (Fin 3) (Fin 3) R) : Commute (MulAut.conj (elementaryRootHom j k hjk (Multiplicative.ofAdd P)) (elementaryRootHom i j hij (Multiplicative.ofAdd A))) (MulAut.conj (elementaryRootHom j k hjk (Multiplicative.ofAdd Q)) (elementaryRootHom i j hij (Multiplicative.ofAdd C)))"},{"kind":"theorem","name":"finiteOuterBlockGaloisConjugateRootsWithCoefficient_commute","statement":"(W : Submodule (ZMod 2) R) (i j k : Fin 3) (hij : i ≠ j) (hjk : j ≠ k) (hik : i ≠ k) (B : Matrix (Fin 3) (Fin 3) W) (s t : finiteBlockGaloisField) (x y : elementaryGroup (Fin 3) (Matrix (Fin 3) (Fin 3) R)) (hx : x ∈ finiteOuterBlockGaloisConjugateRootWithCoefficient W i j k hij hjk B s) (hy : y ∈ finiteOuterBlockGaloisConjugateRootWithCoefficient W i j k hij hjk B t) : Commute x y"},{"kind":"theorem","name":"finiteBlockCoefficientMatrixHom_galoisRightInverse","statement":"(W : Submodule (ZMod 2) R) (A : Matrix (Fin 3) (Fin 3) W) (s t : finiteBlockGaloisField) : finiteBlockCoefficientMatrixHom W (finiteBlockGaloisRightInverseCoefficientMatrix W A s t) = finiteBlockCoefficientMatrixHom W A * finiteBlockGaloisMatrixOver R (t - s)⁻¹"},{"kind":"theorem","name":"finiteBlockGalois_right_inverse_difference","statement":"(s t : finiteBlockGaloisField) (hst : s ≠ t) (C : Matrix (Fin 3) (Fin 3) R) : (C * finiteBlockGaloisMatrixOver R (t - s)⁻¹) * finiteBlockGaloisMatrixOver R t - (C * finiteBlockGaloisMatrixOver R (t - s)⁻¹) * finiteBlockGaloisMatrixOver R s = C"},{"kind":"theorem","name":"finiteOuterBlockProductCentralRoot_le_galoisConjugates","statement":"(W : Submodule (ZMod 2) R) (i j k : Fin 3) (hij : i ≠ j) (hjk : j ≠ k) (hik : i ≠ k) (B : Matrix (Fin 3) (Fin 3) W) (s t : finiteBlockGaloisField) (hst : s ≠ t) : finiteOuterBlockProductCentralRootSubgroup W i k hik B ≤ finiteOuterBlockGaloisConjugateRootWithCoefficient W i j k hij hjk B s ⊔ finiteOuterBlockGaloisConjugateRootWithCoefficient W i j k hij hjk B t"},{"kind":"theorem","name":"unitaryFixedSubmodule_sup","statement":"{G : Type u₁} {H : Type v₁} [Group G] [NormedAddCommGroup H] [InnerProductSpace ℂ H] (π : UnitaryRepresentation G H) (K J : Subgroup G) : unitaryFixedSubmodule π (K ⊔ J) = unitaryFixedSubmodule π K ⊓ unitaryFixedSubmodule π J"},{"kind":"theorem","name":"unitaryFixedSubmodule_isClosed","statement":"{G : Type u₁} {H : Type v₁} [Group G] [NormedAddCommGroup H] [InnerProductSpace ℂ H] (π : UnitaryRepresentation G H) (K : Subgroup G) : IsClosed (unitaryFixedSubmodule π K : Set H)"},{"kind":"theorem","name":"unitaryFixedSubmodule_map_of_centralizes","statement":"{G : Type u₁} {H : Type v₁} [Group G] [NormedAddCommGroup H] [InnerProductSpace ℂ H] (π : UnitaryRepresentation G H) (K : Subgroup G) (g : G) (hg : ∀ k : K, Commute g (k : G)) : (unitaryFixedSubmodule π K).map (π g).toLinearEquiv.toLinearMap = unitaryFixedSubmodule π K"},{"kind":"theorem","name":"unitaryFixedSubmodule_starProjection_commute","statement":"{G : Type u₁} {H : Type v₁} [Group G] [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H] (π : UnitaryRepresentation G H) (K : Subgroup G) (g : G) (hg : ∀ k : K, Commute g (k : G)) (x : H) : (unitaryFixedSubmodule π K).starProjection (π g x) = π g ((unitaryFixedSubmodule π K).starProjection x)"},{"kind":"theorem","name":"unitaryFixedSubmodule_starProjection_mem_of_commute","statement":"{G : Type u₁} {H : Type v₁} [Group G] [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H] (π : UnitaryRepresentation G H) (K J : Subgroup G) (hcomm : ∀ k : K, ∀ j : J, Commute (k : G) (j : G)) {x : H} (hx : x ∈ unitaryFixedSubmodule π J) : (unitaryFixedSubmodule π K).starProjection x ∈ unitaryFixedSubmodule π J"},{"kind":"theorem","name":"norm_finset_sum_sq_eq_of_pairwise_inner_zero","statement":"{ι H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] (f : ι → H) (s : Finset ι) (horth : ∀ ⦃i j : ι⦄, i ≠ j → inner ℂ (f i) (f j) = 0) : ‖∑ i ∈ s, f i‖ ^ 2 = ∑ i ∈ s, ‖f i‖ ^ 2"},{"kind":"theorem","name":"unitaryImages_inner_sq_mul_card_le","statement":"{ι H : Type*} [Fintype ι] [NormedAddCommGroup H] [InnerProductSpace ℂ H] (U : ι → H ≃ₗᵢ[ℂ] H) (a b : H) (hb : ∀ i : ι, U i b = b) (horth : ∀ ⦃i j : ι⦄, i ≠ j → inner ℂ (U i a) (U j a) = 0) : (Fintype.card ι : ℝ) * ‖inner ℂ a b‖ ^ 2 ≤ ‖a‖ ^ 2 * ‖b‖ ^ 2"},{"kind":"theorem","name":"unitaryFixedSubmodule_starProjection_mem_orthogonal_of_commute","statement":"{G : Type u₁} {H : Type v₁} [Group G] [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H] (π : UnitaryRepresentation G H) (K Z : Subgroup G) (hcomm : ∀ k : K, ∀ z : Z, Commute (k : G) (z : G)) {x : H} (hx : x ∈ (unitaryFixedSubmodule π Z)ᗮ) : (unitaryFixedSubmodule π K).starProjection x ∈ (unitaryFixedSubmodule π Z)ᗮ"},{"kind":"theorem","name":"unitaryFixedSubmodule_orthogonal_map_of_centralizes","statement":"{G : Type u₁} {H : Type v₁} [Group G] [NormedAddCommGroup H] [InnerProductSpace ℂ H] (π : UnitaryRepresentation G H) (Z : Subgroup G) (g : G) (hg : ∀ z : Z, Commute g (z : G)) {x : H} (hx : x ∈ (unitaryFixedSubmodule π Z)ᗮ) : π g x ∈ (unitaryFixedSubmodule π Z)ᗮ"},{"kind":"theorem","name":"unitaryFixedSubmodules_inner_eq_zero_of_commute_centerComplement","statement":"{G : Type u₁} {H : Type v₁} [Group G] [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H] (π : UnitaryRepresentation G H) (K J Z : Subgroup G) (hcomm : ∀ k : K, ∀ j : J, Commute (k : G) (j : G)) (hKZ : ∀ k : K, ∀ z : Z, Commute (k : G) (z : G)) (hcenter : Z ≤ K ⊔ J) {a b : H} (ha : a ∈ unitaryFixedSubmodule π K) (hb : b ∈ unitaryFixedSubmodule π J) (hbZ : b ∈ (unitaryFixedSubmodule π Z)ᗮ) : inner ℂ a b = 0"},{"kind":"theorem","name":"heisenbergFiniteFamily_centerComplement_inner_sq_le","statement":"{G : Type u₁} {H : Type v₁} {ι : Type*} [Group G] [Fintype ι] [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H] (π : UnitaryRepresentation G H) (X Z : Subgroup G) (y : ι → G) (hXZ : ∀ x : X, ∀ z : Z, Commute (x : G) (z : G)) (hyZ : ∀ i : ι, ∀ z : Z, Commute (y i) (z : G)) (hcomm : ∀ ⦃i j : ι⦄, i ≠ j → ∀ x : heisenbergConjugateSubgroup X (y i), ∀ x' : heisenbergConjugateSubgroup X (y j), Commute (x : G) (x' : G)) (hcenter : ∀ ⦃i j : ι⦄, i ≠ j → Z ≤ heisenbergConjugateSubgroup X (y i) ⊔ heisenbergConjugateSubgroup X (y j)) {a b : H} (ha : a ∈ unitaryFixedSubmodule π X) (haZ : a ∈ (unitaryFixedSubmodule π Z)ᗮ) (hb : ∀ i : ι, π (y i) b = b) : (Fintype.card ι : ℝ) * ‖inner ℂ a b‖ ^ 2 ≤ ‖a‖ ^ 2 * ‖b‖ ^ 2"},{"kind":"theorem","name":"finiteOuterBlockProductCentral_centerComplement_inner_sq_le","statement":"{R : Type*} [Ring R] [Algebra (ZMod 2) R] {H : Type v₁} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H] (W : Submodule (ZMod 2) R) (i j k : Fin 3) (hij : i ≠ j) (hjk : j ≠ k) (hik : i ≠ k) (B : Matrix (Fin 3) (Fin 3) W) (π : UnitaryRepresentation (elementaryGroup (Fin 3) (Matrix (Fin 3) (Fin 3) R)) H) {a b : H} (ha : a ∈ unitaryFixedSubmodule π (finiteOuterBlockRootSubgroup W i j hij)) (haZ : a ∈ (unitaryFixedSubmodule π (finiteOuterBlockProductCentralRootSubgroup W i k hik B))ᗮ) (hb : b ∈ unitaryFixedSubmodule π (finiteOuterBlockRootSubgroup W j k hjk)) : 8 * ‖inner ℂ a b‖ ^ 2 ≤ ‖a‖ ^ 2 * ‖b‖ ^ 2"},{"kind":"theorem","name":"finiteUnitarySubgroupAverage_fixed","statement":"(π : UnitaryRepresentation G H) (K : Subgroup G) [Fintype K] (x : H) (g : K) : π (g : G) (finiteUnitarySubgroupAverage π K x) = finiteUnitarySubgroupAverage π K x"},{"kind":"theorem","name":"inner_finiteUnitarySubgroupAverage_of_fixed_left","statement":"(π : UnitaryRepresentation G H) (K : Subgroup G) [Fintype K] (a b : H) (ha : ∀ k : K, π (k : G) a = a) : inner ℂ a (finiteUnitarySubgroupAverage π K b) = inner ℂ a b"},{"kind":"theorem","name":"finiteUnitarySubgroupAverage_fixed_of_orbit_fixed","statement":"(π : UnitaryRepresentation G H) (K J : Subgroup G) [Fintype K] (b : H) (horbit : ∀ (k : K) (j : J), π (j : G) (π (k : G) b) = π (k : G) b) (j : J) : π (j : G) (finiteUnitarySubgroupAverage π K b) = finiteUnitarySubgroupAverage π K b"},{"kind":"theorem","name":"inner_eq_zero_of_finite_subgroupAverage_pair_orthogonal","statement":"(π : UnitaryRepresentation G H) (K J : Subgroup G) [Fintype K] (a b : H) (ha : ∀ k : K, π (k : G) a = a) (horbit : ∀ (k : K) (j : J), π (j : G) (π (k : G) b) = π (k : G) b) (horth : ∀ z : H, (∀ k : K, π (k : G) z = z) → (∀ j : J, π (j : G) z = z) → inner ℂ a z = 0) : inner ℂ a b = 0"},{"kind":"theorem","name":"finiteOuterBlockRootSubgroups_pair_inner_sq_le","statement":"{R : Type*} [Ring R] [Algebra (ZMod 2) R] {H : Type v₁} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H] (W : Submodule (ZMod 2) R) [Finite W] (i j k : Fin 3) (hij : i ≠ j) (hjk : j ≠ k) (hik : i ≠ k) (π : UnitaryRepresentation (elementaryGroup (Fin 3) (Matrix (Fin 3) (Fin 3) R)) H) {a b : H} (ha : a ∈ unitaryFixedSubmodule π (finiteOuterBlockRootSubgroup W i j hij)) (hb : b ∈ unitaryFixedSubmodule π (finiteOuterBlockRootSubgroup W j k hjk)) (haQ : a ∈ (unitaryFixedSubmodule π (finiteOuterBlockRootSubgroup W i j hij) ⊓ unitaryFixedSubmodule π (finiteOuterBlockRootSubgroup W j k hjk))ᗮ) (hbQ : b ∈ (unitaryFixedSubmodule π (finiteOuterBlockRootSubgroup W i j hij) ⊓ unitaryFixedSubmodule π (finiteOuterBlockRootSubgroup W j k hjk))ᗮ) : 8 * ‖inner ℂ a b‖ ^ 2 ≤ ‖a‖ ^ 2 * ‖b‖ ^ 2"},{"kind":"theorem","name":"finiteOuterBlockCyclicRootFamily_pair_inner_sq_le","statement":"{R : Type*} [Ring R] [Algebra (ZMod 2) R] {H : Type v₁} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H] (W : Submodule (ZMod 2) R) [Finite W] (π : UnitaryRepresentation (elementaryGroup (Fin 3) (Matrix (Fin 3) (Fin 3) R)) H) (i j : Fin 3) (hij : i ≠ j) (a b : H) (ha : a ∈ unitaryFixedSubmodule π (finiteOuterBlockCyclicRootFamily W i)) (haQ : a ∈ (unitaryFixedSubmodule π (finiteOuterBlockCyclicRootFamily W i) ⊓ unitaryFixedSubmodule π (finiteOuterBlockCyclicRootFamily W j))ᗮ) (hb : b ∈ unitaryFixedSubmodule π (finiteOuterBlockCyclicRootFamily W j)) (hbQ : b ∈ (unitaryFixedSubmodule π (finiteOuterBlockCyclicRootFamily W i) ⊓ unitaryFixedSubmodule π (finiteOuterBlockCyclicRootFamily W j))ᗮ) : 8 * ‖inner ℂ a b‖ ^ 2 ≤ ‖a‖ ^ 2 * ‖b‖ ^ 2"},{"kind":"theorem","name":"one_mem_finiteBlockCoefficientSpan","statement":"(s : Finset R) : (1 : R) ∈ finiteBlockCoefficientSpan s"},{"kind":"theorem","name":"mem_finiteBlockCoefficientSpan_of_mem","statement":"(s : Finset R) {a : R} (ha : a ∈ s) : a ∈ finiteBlockCoefficientSpan s"},{"kind":"theorem","name":"finiteBlockIndex_ne_of_ne","statement":"{i j : Fin 3} (hij : i ≠ j) (p q : Fin 3) : finiteBlockIndex i p ≠ finiteBlockIndex j q"},{"kind":"theorem","name":"finiteBlockRootHom_single","statement":"(W : Submodule (ZMod 2) R) (i j : Fin 3) (hij : i ≠ j) (p q : Fin 3) (a : W) : finiteBlockRootHom W i j hij (Multiplicative.ofAdd (Matrix.single p q a)) = elementaryUnit (finiteBlockIndex i p) (finiteBlockIndex j q) (finiteBlockIndex_ne_of_ne hij p q) (a : R)"},{"kind":"theorem","name":"elementaryUnit_mem_finiteBlockRootSubgroup","statement":"(W : Submodule (ZMod 2) R) (i j : Fin 3) (hij : i ≠ j) (p q : Fin 3) (a : R) (ha : a ∈ W) : elementaryUnit (finiteBlockIndex i p) (finiteBlockIndex j q) (finiteBlockIndex_ne_of_ne hij p q) a ∈ finiteBlockRootSubgroup W i j hij"},{"kind":"theorem","name":"finiteBlockRootSubgroup_le_elementaryGroup","statement":"(W : Submodule (ZMod 2) R) (i j : Fin 3) (hij : i ≠ j) : finiteBlockRootSubgroup W i j hij ≤ elementaryGroup (Fin 9) R"},{"kind":"theorem","name":"cyclicFiniteBlockRootSubgroup_le_elementaryGroup","statement":"(W : Submodule (ZMod 2) R) : cyclicFiniteBlockRootSubgroup W ≤ elementaryGroup (Fin 9) R"},{"kind":"theorem","name":"elementaryUnit_mem_cyclicFiniteBlockRootSubgroup_of_block_ne","statement":"(W : Submodule (ZMod 2) R) (hW : (1 : R) ∈ W) (i j : Fin 3) (hij : i ≠ j) (p q : Fin 3) (a : R) (ha : a ∈ W) : elementaryUnit (finiteBlockIndex i p) (finiteBlockIndex j q) (finiteBlockIndex_ne_of_ne hij p q) a ∈ cyclicFiniteBlockRootSubgroup W"},{"kind":"theorem","name":"elementaryUnit_mem_cyclicFiniteBlockRootSubgroup","statement":"(W : Submodule (ZMod 2) R) (hW : (1 : R) ∈ W) (x y : Fin 9) (hxy : x ≠ y) (a : R) (ha : a ∈ W) : elementaryUnit x y hxy a ∈ cyclicFiniteBlockRootSubgroup W"},{"kind":"theorem","name":"cyclicFiniteBlockRootSubgroup_eq_elementaryGroup","statement":"(s : Finset R) (hs : Algebra.adjoin (ZMod 2) (↑s : Set R) = ⊤) : cyclicFiniteBlockRootSubgroup (finiteBlockCoefficientSpan s) = elementaryGroup (Fin 9) R"},{"kind":"theorem","name":"hasPropertyT_of_finiteOuterBlockCyclicRootFamily_generate","statement":"{R : Type*} [Ring R] [Algebra (ZMod 2) R] (W : Submodule (ZMod 2) R) [Finite W] (hgen : (⨆ i : Fin 3, finiteOuterBlockCyclicRootFamily W i) = ⊤) : HasPropertyT.{_, vSharp} (elementaryGroup (Fin 3) (Matrix (Fin 3) (Fin 3) R))"},{"kind":"theorem","name":"finiteOuterBlockRootSubgroup_map_flatten","statement":"{R : Type*} [Ring R] [Algebra (ZMod 2) R] (W : Submodule (ZMod 2) R) (i j : Fin 3) (hij : i ≠ j) : (finiteOuterBlockRootSubgroup W i j hij).map (finiteOuterBlockFlattenHom (R"},{"kind":"theorem","name":"finiteOuterBlockCyclicRootFamily_iSup_eq_top","statement":"{R : Type*} [Ring R] [Algebra (ZMod 2) R] (s : Finset R) (hs : Algebra.adjoin (ZMod 2) (↑s : Set R) = ⊤) : (⨆ i : Fin 3, finiteOuterBlockCyclicRootFamily (finiteBlockCoefficientSpan s) i) = ⊤"},{"kind":"theorem","name":"binaryLeavittElementaryNine_hasPropertyT_unconditional","statement":"HasPropertyT.{0, vSharp} (binaryLeavittElementaryGroup 9)"},{"kind":"theorem","name":"alphaPrefixElementaryGroup_hasPropertyT_unconditional","statement":"HasPropertyT.{0, vSharp} (prefixElementaryGroup alphaPrefixCode)"},{"kind":"theorem","name":"alphaZeroPrefixElementaryGroup_hasPropertyT_unconditional","statement":"HasPropertyT.{0, vSharp} (prefixElementaryGroup alphaZeroPrefixCode)"},{"kind":"theorem","name":"ninePrefixElementaryGroup_hasPropertyT_unconditional","statement":"HasPropertyT.{0, vSharp} (prefixElementaryGroup ninePrefixCode)"},{"kind":"theorem","name":"sum_firstFiber_card","statement":"{V : Type*} [Fintype V] [DecidableEq V] (U : Finset (V × V)) : (∑ x : V, (firstFiber U x).card) = U.card"},{"kind":"theorem","name":"sum_secondFiber_card","statement":"{V : Type*} [Fintype V] [DecidableEq V] (U : Finset (V × V)) : (∑ x : V, (secondFiber U x).card) = U.card"},{"kind":"theorem","name":"natDist_card_le_sdiff","statement":"{α : Type*} [DecidableEq α] (A B : Finset α) : Nat.dist A.card B.card ≤ (A \\ B).card + (B \\ A).card"},{"kind":"theorem","name":"firstFiber_sdiff","statement":"{V : Type*} [DecidableEq V] (U W : Finset (V × V)) (x : V) : firstFiber (U \\ W) x = firstFiber U x \\ firstFiber W x"},{"kind":"theorem","name":"secondFiber_sdiff","statement":"{V : Type*} [DecidableEq V] (U W : Finset (V × V)) (x : V) : secondFiber (U \\ W) x = secondFiber U x \\ secondFiber W x"},{"kind":"theorem","name":"firstMultiplicity_variation_le_relation_difference","statement":"{V : Type*} [Fintype V] [DecidableEq V] (U W : Finset (V × V)) : (∑ x : V, Nat.dist (firstMultiplicity U x) (firstMultiplicity W x)) ≤ (U \\ W).card + (W \\ U).card"},{"kind":"theorem","name":"secondMultiplicity_variation_le_relation_difference","statement":"{V : Type*} [Fintype V] [DecidableEq V] (U W : Finset (V × V)) : (∑ x : V, Nat.dist (secondMultiplicity U x) (secondMultiplicity W x)) ≤ (U \\ W).card + (W \\ U).card"},{"kind":"theorem","name":"diagonalImage_card","statement":"{V : Type*} [DecidableEq V] (p : Equiv.Perm V) (U : Finset (V × V)) : (diagonalImage p U).card = U.card"},{"kind":"theorem","name":"firstFiber_diagonalImage","statement":"{V : Type*} [DecidableEq V] (p : Equiv.Perm V) (U : Finset (V × V)) (x : V) : firstFiber (diagonalImage p U) (p x) = (firstFiber U x).image (p.prodCongr p)"},{"kind":"theorem","name":"secondFiber_diagonalImage","statement":"{V : Type*} [DecidableEq V] (p : Equiv.Perm V) (U : Finset (V × V)) (x : V) : secondFiber (diagonalImage p U) (p x) = (secondFiber U x).image (p.prodCongr p)"},{"kind":"theorem","name":"firstMultiplicity_diagonalImage","statement":"{V : Type*} [DecidableEq V] (p : Equiv.Perm V) (U : Finset (V × V)) (x : V) : firstMultiplicity (diagonalImage p U) (p x) = firstMultiplicity U x"},{"kind":"theorem","name":"secondMultiplicity_diagonalImage","statement":"{V : Type*} [DecidableEq V] (p : Equiv.Perm V) (U : Finset (V × V)) (x : V) : secondMultiplicity (diagonalImage p U) (p x) = secondMultiplicity U x"},{"kind":"theorem","name":"diagonalImage_sdiff_eq_image_exit","statement":"{V : Type*} [DecidableEq V] (p : Equiv.Perm V) (U : Finset (V × V)) : diagonalImage p U \\ U = (U.filter fun z => (p.prodCongr p) z ∉ U).image (p.prodCongr p)"},{"kind":"theorem","name":"diagonalImage_sdiff_cards","statement":"{V : Type*} [DecidableEq V] (p : Equiv.Perm V) (U : Finset (V × V)) : (diagonalImage p U \\ U).card = diagonalExit p U ∧ (U \\ diagonalImage p U).card = diagonalExit p U"},{"kind":"theorem","name":"firstMultiplicity_diagonal_variation_le_twice_exit","statement":"{V : Type*} [Fintype V] [DecidableEq V] (p : Equiv.Perm V) (U : Finset (V × V)) : (∑ x : V, Nat.dist (firstMultiplicity U (p x)) (firstMultiplicity U x)) ≤ 2 * diagonalExit p U"},{"kind":"theorem","name":"secondMultiplicity_diagonal_variation_le_twice_exit","statement":"{V : Type*} [Fintype V] [DecidableEq V] (p : Equiv.Perm V) (U : Finset (V × V)) : (∑ x : V, Nat.dist (secondMultiplicity U (p x)) (secondMultiplicity U x)) ≤ 2 * diagonalExit p U"},{"kind":"theorem","name":"firstMultiplicity_totalVariation_le_twice_diagonalBoundary","statement":"{V ι : Type*} [Fintype V] [Fintype ι] [DecidableEq V] (σ : ι → Equiv.Perm V) (U : Finset (V × V)) : (∑ i : ι, ∑ x : V, Nat.dist (firstMultiplicity U (σ i x)) (firstMultiplicity U x)) ≤ 2 * SoficGroups.boundary (fun i => (σ i).prodCongr (σ i)) U"},{"kind":"theorem","name":"secondMultiplicity_totalVariation_le_twice_diagonalBoundary","statement":"{V ι : Type*} [Fintype V] [Fintype ι] [DecidableEq V] (σ : ι → Equiv.Perm V) (U : Finset (V × V)) : (∑ i : ι, ∑ x : V, Nat.dist (secondMultiplicity U (σ i x)) (secondMultiplicity U x)) ≤ 2 * SoficGroups.boundary (fun i => (σ i).prodCongr (σ i)) U"},{"kind":"theorem","name":"mem_positiveNatSupport","statement":"{V : Type*} [Fintype V] (f : V → ℕ) (x : V) : x ∈ positiveNatSupport f ↔ 0 < f x"},{"kind":"theorem","name":"card_entering_eq_card_exiting","statement":"{V : Type*} [Fintype V] [DecidableEq V] (p : Equiv.Perm V) (A : Finset V) : (Finset.univ.filter fun x => x ∉ A ∧ p x ∈ A).card = (A.filter fun x => p x ∉ A).card"},{"kind":"theorem","name":"sum_indicator_nat_eq_mul_card","statement":"{V : Type*} (A : Finset V) (q : V → Prop) [DecidablePred q] (m : ℕ) : (∑ x ∈ A, if q x then m else 0) = m * (A.filter q).card"},{"kind":"theorem","name":"permutationVariation_subtract_layer","statement":"{V ι : Type*} [Fintype V] [Fintype ι] [DecidableEq V] (σ : ι → Equiv.Perm V) (f : V → ℕ) (A : Finset V) (m : ℕ) (hinside : ∀ x ∈ A, m ≤ f x) (houtside : ∀ x, x ∉ A → f x = 0) : permutationVariation σ f = permutationVariation σ (fun x => if x ∈ A then f x - m else 0) + 2 * m * SoficGroups.boundary σ A"},{"kind":"theorem","name":"permutation_small_support_coarea","statement":"{V ι : Type*} [Fintype V] [Fintype ι] [DecidableEq V] (σ : ι → Equiv.Perm V) (h : ℝ) (hexp : ∀ A : Finset V, h * min (A.card : ℝ) ((Fintype.card V : ℝ) - A.card) ≤ (SoficGroups.boundary σ A : ℝ)) (f : V → ℕ) (hhalf : 2 * (positiveNatSupport f).card ≤ Fintype.card V) : 2 * h * (∑ x : V, f x) ≤ (permutationVariation σ f : ℝ)"},{"kind":"theorem","name":"natDist_sub_one_le","statement":"(a b : ℕ) : Nat.dist (a - 1) (b - 1) ≤ Nat.dist a b"},{"kind":"theorem","name":"natDist_zero_indicator_le","statement":"(a b : ℕ) : Nat.dist (if a = 0 then 1 else 0) (if b = 0 then 1 else 0) ≤ Nat.dist a b"},{"kind":"theorem","name":"permutationVariation_sub_one_le","statement":"{V ι : Type*} [Fintype V] [Fintype ι] (σ : ι → Equiv.Perm V) (f : V → ℕ) : permutationVariation σ (fun x => f x - 1) ≤ permutationVariation σ f"},{"kind":"theorem","name":"permutationVariation_zero_indicator_le","statement":"{V ι : Type*} [Fintype V] [Fintype ι] (σ : ι → Equiv.Perm V) (f : V → ℕ) : permutationVariation σ (fun x => if f x = 0 then 1 else 0) ≤ permutationVariation σ f"},{"kind":"theorem","name":"mem_singletonSupport","statement":"{V : Type*} [Fintype V] (f : V → ℕ) (x : V) : x ∈ singletonSupport f ↔ f x = 1"},{"kind":"theorem","name":"excess_support_card_le_half_of_singletons","statement":"{V : Type*} [Fintype V] [DecidableEq V] (f : V → ℕ) (hsingle : Fintype.card V ≤ 2 * (singletonSupport f).card) : 2 * (positiveNatSupport (fun x => f x - 1)).card ≤ Fintype.card V"},{"kind":"theorem","name":"zero_support_card_le_half_of_singletons","statement":"{V : Type*} [Fintype V] [DecidableEq V] (f : V → ℕ) (hsingle : Fintype.card V ≤ 2 * (singletonSupport f).card) : 2 * (positiveNatSupport (fun x => if f x = 0 then 1 else 0)).card ≤ Fintype.card V"},{"kind":"theorem","name":"excess_mass_le_of_diagonal_variation","statement":"{V ι : Type*} [Fintype V] [Fintype ι] [DecidableEq V] (σ : ι → Equiv.Perm V) (h : ℝ) (hexp : ∀ A : Finset V, h * min (A.card : ℝ) ((Fintype.card V : ℝ) - A.card) ≤ (SoficGroups.boundary σ A : ℝ)) (f : V → ℕ) (B : ℕ) (hsingle : Fintype.card V ≤ 2 * (singletonSupport f).card) (hvariation : permutationVariation σ f ≤ 2 * B) : h * (∑ x : V, (f x - 1 : ℕ)) ≤ (B : ℝ)"},{"kind":"theorem","name":"zero_mass_le_of_diagonal_variation","statement":"{V ι : Type*} [Fintype V] [Fintype ι] [DecidableEq V] (σ : ι → Equiv.Perm V) (h : ℝ) (hexp : ∀ A : Finset V, h * min (A.card : ℝ) ((Fintype.card V : ℝ) - A.card) ≤ (SoficGroups.boundary σ A : ℝ)) (f : V → ℕ) (B : ℕ) (hsingle : Fintype.card V ≤ 2 * (singletonSupport f).card) (hvariation : permutationVariation σ f ≤ 2 * B) : h * (Finset.univ.filter fun x : V => f x = 0).card ≤ (B : ℝ)"},{"kind":"theorem","name":"first_excess_mass_le_diagonalBoundary","statement":"{V ι : Type*} [Fintype V] [Fintype ι] [DecidableEq V] (σ : ι → Equiv.Perm V) (U : Finset (V × V)) (h : ℝ) (hexp : ∀ A : Finset V, h * min (A.card : ℝ) ((Fintype.card V : ℝ) - A.card) ≤ (SoficGroups.boundary σ A : ℝ)) (hsingle : Fintype.card V ≤ 2 * (singletonSupport (firstMultiplicity U)).card) : h * (∑ x : V, (firstMultiplicity U x - 1 : ℕ)) ≤ (SoficGroups.boundary (fun i => (σ i).prodCongr (σ i)) U : ℝ)"},{"kind":"theorem","name":"second_excess_mass_le_diagonalBoundary","statement":"{V ι : Type*} [Fintype V] [Fintype ι] [DecidableEq V] (σ : ι → Equiv.Perm V) (U : Finset (V × V)) (h : ℝ) (hexp : ∀ A : Finset V, h * min (A.card : ℝ) ((Fintype.card V : ℝ) - A.card) ≤ (SoficGroups.boundary σ A : ℝ)) (hsingle : Fintype.card V ≤ 2 * (singletonSupport (secondMultiplicity U)).card) : h * (∑ x : V, (secondMultiplicity U x - 1 : ℕ)) ≤ (SoficGroups.boundary (fun i => (σ i).prodCongr (σ i)) U : ℝ)"},{"kind":"theorem","name":"first_zero_mass_le_diagonalBoundary","statement":"{V ι : Type*} [Fintype V] [Fintype ι] [DecidableEq V] (σ : ι → Equiv.Perm V) (U : Finset (V × V)) (h : ℝ) (hexp : ∀ A : Finset V, h * min (A.card : ℝ) ((Fintype.card V : ℝ) - A.card) ≤ (SoficGroups.boundary σ A : ℝ)) (hsingle : Fintype.card V ≤ 2 * (singletonSupport (firstMultiplicity U)).card) : h * (Finset.univ.filter fun x : V => firstMultiplicity U x = 0).card ≤ (SoficGroups.boundary (fun i => (σ i).prodCongr (σ i)) U : ℝ)"},{"kind":"theorem","name":"firstFiber_nonSingletonFirstEdges","statement":"{V : Type*} [DecidableEq V] (U : Finset (V × V)) (x : V) : firstFiber (nonSingletonFirstEdges U) x = if firstMultiplicity U x ≠ 1 then firstFiber U x else ∅"},{"kind":"theorem","name":"secondFiber_nonSingletonSecondEdges","statement":"{V : Type*} [DecidableEq V] (U : Finset (V × V)) (x : V) : secondFiber (nonSingletonSecondEdges U) x = if secondMultiplicity U x ≠ 1 then secondFiber U x else ∅"},{"kind":"theorem","name":"card_nonSingletonFirstEdges_le_twice_excess","statement":"{V : Type*} [Fintype V] [DecidableEq V] (U : Finset (V × V)) : (nonSingletonFirstEdges U).card ≤ 2 * ∑ x : V, (firstMultiplicity U x - 1 : ℕ)"},{"kind":"theorem","name":"card_nonSingletonSecondEdges_le_twice_excess","statement":"{V : Type*} [Fintype V] [DecidableEq V] (U : Finset (V × V)) : (nonSingletonSecondEdges U).card ≤ 2 * ∑ x : V, (secondMultiplicity U x - 1 : ℕ)"},{"kind":"theorem","name":"nonmatchedFiberEdges_subset","statement":"{V : Type*} [DecidableEq V] (U : Finset (V × V)) : U \\ matchedFiberEdges U ⊆ nonSingletonFirstEdges U ∪ nonSingletonSecondEdges U"},{"kind":"theorem","name":"card_nonmatchedFiberEdges_le_twice_excess","statement":"{V : Type*} [Fintype V] [DecidableEq V] (U : Finset (V × V)) : (U \\ matchedFiberEdges U).card ≤ 2 * (∑ x : V, (firstMultiplicity U x - 1 : ℕ)) + 2 * (∑ x : V, (secondMultiplicity U x - 1 : ℕ))"},{"kind":"theorem","name":"firstFiber_singletonFirstEdges","statement":"{V : Type*} [DecidableEq V] (U : Finset (V × V)) (x : V) : firstFiber (singletonFirstEdges U) x = if firstMultiplicity U x = 1 then firstFiber U x else ∅"},{"kind":"theorem","name":"card_singletonFirstEdges","statement":"{V : Type*} [Fintype V] [DecidableEq V] (U : Finset (V × V)) : (singletonFirstEdges U).card = (singletonSupport (firstMultiplicity U)).card"},{"kind":"theorem","name":"singletonFirstEdges_subset_matching_union","statement":"{V : Type*} [DecidableEq V] (U : Finset (V × V)) : singletonFirstEdges U ⊆ matchedFiberEdges U ∪ nonSingletonSecondEdges U"},{"kind":"theorem","name":"card_singletonSupport_le_matching_add_column_excess","statement":"{V : Type*} [Fintype V] [DecidableEq V] (U : Finset (V × V)) : (singletonSupport (firstMultiplicity U)).card ≤ (matchedFiberEdges U).card + 2 * (∑ x : V, (secondMultiplicity U x - 1 : ℕ))"},{"kind":"theorem","name":"card_le_zero_singleton_excess","statement":"{V : Type*} [Fintype V] (f : V → ℕ) : Fintype.card V ≤ (Finset.univ.filter fun x : V => f x = 0).card + (singletonSupport f).card + ∑ x : V, (f x - 1 : ℕ)"},{"kind":"theorem","name":"unmatched_vertices_le_zero_and_excess","statement":"{V : Type*} [Fintype V] [DecidableEq V] (U : Finset (V × V)) : Fintype.card V - (matchedFiberEdges U).card ≤ (Finset.univ.filter fun x : V => firstMultiplicity U x = 0).card + (∑ x : V, (firstMultiplicity U x - 1 : ℕ)) + 2 * (∑ x : V, (secondMultiplicity U x - 1 : ℕ))"},{"kind":"theorem","name":"matchedFiberEdges_relation_loss_bound","statement":"{V ι : Type*} [Fintype V] [Fintype ι] [DecidableEq V] (σ : ι → Equiv.Perm V) (U : Finset (V × V)) (h : ℝ) (hpositive : 0 < h) (hexp : ∀ A : Finset V, h * min (A.card : ℝ) ((Fintype.card V : ℝ) - A.card) ≤ (SoficGroups.boundary σ A : ℝ)) (hfirst : Fintype.card V ≤ 2 * (singletonSupport (firstMultiplicity U)).card) (hsecond : Fintype.card V ≤ 2 * (singletonSupport (secondMultiplicity U)).card) : h * ((U \\ matchedFiberEdges U).card : ℝ) ≤ 4 * (SoficGroups.boundary (fun i => (σ i).prodCongr (σ i)) U : ℝ)"},{"kind":"theorem","name":"matchedFiberEdges_vertex_loss_bound","statement":"{V ι : Type*} [Fintype V] [Fintype ι] [DecidableEq V] (σ : ι → Equiv.Perm V) (U : Finset (V × V)) (h : ℝ) (hpositive : 0 < h) (hexp : ∀ A : Finset V, h * min (A.card : ℝ) ((Fintype.card V : ℝ) - A.card) ≤ (SoficGroups.boundary σ A : ℝ)) (hfirst : Fintype.card V ≤ 2 * (singletonSupport (firstMultiplicity U)).card) (hsecond : Fintype.card V ≤ 2 * (singletonSupport (secondMultiplicity U)).card) : h * ((Fintype.card V - (matchedFiberEdges U).card : ℕ) : ℝ) ≤ 4 * (SoficGroups.boundary (fun i => (σ i).prodCongr (σ i)) U : ℝ)"},{"kind":"theorem","name":"exists_permutation_extending_matchedFiberEdges","statement":"{V : Type*} [DecidableEq V] (U : Finset (V × V)) : ∃ p : Equiv.Perm V, ∀ z ∈ matchedFiberEdges U, p z.1 = z.2"},{"kind":"theorem","name":"exists_permutationGraph_containing_matchedFiberEdges","statement":"{V : Type*} [Fintype V] [DecidableEq V] (U : Finset (V × V)) : ∃ p : Equiv.Perm V, matchedFiberEdges U ⊆ SoficGroups.permutationGraph p"},{"kind":"theorem","name":"permutationGraph_card","statement":"{V : Type*} [Fintype V] [DecidableEq V] (p : Equiv.Perm V) : (SoficGroups.permutationGraph p).card = Fintype.card V"},{"kind":"theorem","name":"permutationGraph_sdiff_bounds_of_matchedFiberEdges","statement":"{V : Type*} [Fintype V] [DecidableEq V] (U : Finset (V × V)) (p : Equiv.Perm V) (hp : matchedFiberEdges U ⊆ SoficGroups.permutationGraph p) : (SoficGroups.permutationGraph p \\ U).card ≤ Fintype.card V - (matchedFiberEdges U).card ∧ (U \\ SoficGroups.permutationGraph p).card ≤ (U \\ matchedFiberEdges U).card"},{"kind":"theorem","name":"boundary_le_boundary_add_sdiff","statement":"{V ι : Type*} [Fintype ι] [DecidableEq V] (σ : ι → Equiv.Perm V) (U W : Finset V) : SoficGroups.boundary σ U ≤ SoficGroups.boundary σ W + Fintype.card ι * ((U \\ W).card + (W \\ U).card)"},{"kind":"theorem","name":"exists_boundary_controlled_permutation_repair","statement":"{V ι : Type*} [Fintype V] [Fintype ι] [DecidableEq V] (σ : ι → Equiv.Perm V) (U : Finset (V × V)) (h : ℝ) (hpositive : 0 < h) (hexp : ∀ A : Finset V, h * min (A.card : ℝ) ((Fintype.card V : ℝ) - A.card) ≤ (SoficGroups.boundary σ A : ℝ)) (hfirst : Fintype.card V ≤ 2 * (singletonSupport (firstMultiplicity U)).card) (hsecond : Fintype.card V ≤ 2 * (singletonSupport (secondMultiplicity U)).card) : ∃ q : Equiv.Perm V, matchedFiberEdges U ⊆ SoficGroups.permutationGraph q ∧ h * (SoficGroups.permutationCommutationDefect σ q : ℝ) ≤ (h + 8 * (Fintype.card ι : ℝ)) * (SoficGroups.boundary (fun i => (σ i).prodCongr (σ i)) U : ℝ)"},{"kind":"theorem","name":"permutationDistance_eq_card_permutationGraph_sdiff","statement":"{V : Type*} [Fintype V] [DecidableEq V] (p q : Equiv.Perm V) : SoficGroups.permutationDistance p q = (SoficGroups.permutationGraph p \\ SoficGroups.permutationGraph q).card"},{"kind":"theorem","name":"permutationDistance_le_matching_loss_add_reference","statement":"{V : Type*} [Fintype V] [DecidableEq V] (U : Finset (V × V)) (q p : Equiv.Perm V) (hq : matchedFiberEdges U ⊆ SoficGroups.permutationGraph q) : SoficGroups.permutationDistance q p ≤ Fintype.card V - (matchedFiberEdges U).card + (U \\ SoficGroups.permutationGraph p).card"},{"kind":"theorem","name":"exists_boundary_controlled_permutation_repair_close_to_reference","statement":"{V ι : Type*} [Fintype V] [Fintype ι] [DecidableEq V] (σ : ι → Equiv.Perm V) (U : Finset (V × V)) (p : Equiv.Perm V) (h : ℝ) (hpositive : 0 < h) (hexp : ∀ A : Finset V, h * min (A.card : ℝ) ((Fintype.card V : ℝ) - A.card) ≤ (SoficGroups.boundary σ A : ℝ)) (hfirst : Fintype.card V ≤ 2 * (singletonSupport (firstMultiplicity U)).card) (hsecond : Fintype.card V ≤ 2 * (singletonSupport (secondMultiplicity U)).card) : ∃ q : Equiv.Perm V, h * (SoficGroups.permutationDistance q p : ℝ) ≤ 4 * (SoficGroups.boundary (fun i => (σ i).prodCongr (σ i)) U : ℝ) + h * ((U \\ SoficGroups.permutationGraph p).card : ℝ) ∧ h * (SoficGroups.permutationCommutationDefect σ q : ℝ) ≤ (h + 8 * (Fintype.card ι : ℝ)) * (SoficGroups.boundary (fun i => (σ i).prodCongr (σ i)) U : ℝ)"},{"kind":"theorem","name":"hasAlmostCentralizerImprovement_of_expanding_diagonal_cuts","statement":"{V ι : Type*} [Fintype V] [Fintype ι] [DecidableEq V] (σ : ι → Equiv.Perm V) (tolerance : ℕ) (h : ℝ) (hpositive : 0 < h) (hexp : ∀ A : Finset V, h * min (A.card : ℝ) ((Fintype.card V : ℝ) - A.card) ≤ (SoficGroups.boundary σ A : ℝ)) (hcut : ∀ p : Equiv.Perm V, SoficGroups.permutationCommutationDefect σ p ≤ 2 * tolerance → ∃ U : Finset (V × V), Fintype.card V ≤ 2 * (singletonSupport (firstMultiplicity U)).card ∧ Fintype.card V ≤ 2 * (singletonSupport (secondMultiplicity U)).card ∧ (h + 8 * (Fintype.card ι : ℝ)) * (SoficGroups.boundary (fun i => (σ i).prodCongr (σ i)) U : ℝ) ≤ h * (tolerance : ℝ) ∧ (5 : ℝ) * (4 * (SoficGroups.boundary (fun i => (σ i).prodCongr (σ i)) U : ℝ) + h * ((U \\ SoficGroups.permutationGraph p).card : ℝ)) ≤ h * (Fintype.card V : ℝ)) : SoficGroups.HasAlmostCentralizerImprovement σ tolerance"},{"kind":"theorem","name":"firstMultiplicity_permutationGraph","statement":"{V : Type*} [Fintype V] [DecidableEq V] (p : Equiv.Perm V) (x : V) : firstMultiplicity (SoficGroups.permutationGraph p) x = 1"},{"kind":"theorem","name":"secondMultiplicity_permutationGraph","statement":"{V : Type*} [Fintype V] [DecidableEq V] (p : Equiv.Perm V) (x : V) : secondMultiplicity (SoficGroups.permutationGraph p) x = 1"},{"kind":"theorem","name":"card_nonSingletonMultiplicity_le_total_distance","statement":"{V : Type*} [Fintype V] (f : V → ℕ) : (Finset.univ.filter fun x : V => f x ≠ 1).card ≤ ∑ x : V, Nat.dist (f x) 1"},{"kind":"theorem","name":"card_nonSingletonFirstMultiplicity_le_reference_difference","statement":"{V : Type*} [Fintype V] [DecidableEq V] (U : Finset (V × V)) (p : Equiv.Perm V) : (Finset.univ.filter fun x : V => firstMultiplicity U x ≠ 1).card ≤ (U \\ SoficGroups.permutationGraph p).card + (SoficGroups.permutationGraph p \\ U).card"},{"kind":"theorem","name":"card_nonSingletonSecondMultiplicity_le_reference_difference","statement":"{V : Type*} [Fintype V] [DecidableEq V] (U : Finset (V × V)) (p : Equiv.Perm V) : (Finset.univ.filter fun x : V => secondMultiplicity U x ≠ 1).card ≤ (U \\ SoficGroups.permutationGraph p).card + (SoficGroups.permutationGraph p \\ U).card"},{"kind":"theorem","name":"first_singleton_half_of_reference_difference","statement":"{V : Type*} [Fintype V] [DecidableEq V] (U : Finset (V × V)) (p : Equiv.Perm V) (hnear : 2 * ((U \\ SoficGroups.permutationGraph p).card + (SoficGroups.permutationGraph p \\ U).card) ≤ Fintype.card V) : Fintype.card V ≤ 2 * (singletonSupport (firstMultiplicity U)).card"},{"kind":"theorem","name":"second_singleton_half_of_reference_difference","statement":"{V : Type*} [Fintype V] [DecidableEq V] (U : Finset (V × V)) (p : Equiv.Perm V) (hnear : 2 * ((U \\ SoficGroups.permutationGraph p).card + (SoficGroups.permutationGraph p \\ U).card) ≤ Fintype.card V) : Fintype.card V ≤ 2 * (singletonSupport (secondMultiplicity U)).card"},{"kind":"theorem","name":"hasAlmostCentralizerImprovement_of_rooted_reference_cuts","statement":"{V ι : Type*} [Fintype V] [Fintype ι] [DecidableEq V] (σ : ι → Equiv.Perm V) (tolerance : ℕ) (h : ℝ) (hpositive : 0 < h) (hexp : ∀ A : Finset V, h * min (A.card : ℝ) ((Fintype.card V : ℝ) - A.card) ≤ (SoficGroups.boundary σ A : ℝ)) (hcut : ∀ p : Equiv.Perm V, SoficGroups.permutationCommutationDefect σ p ≤ 2 * tolerance → ∃ U : Finset (V × V), 2 * ((U \\ SoficGroups.permutationGraph p).card + (SoficGroups.permutationGraph p \\ U).card) ≤ Fintype.card V ∧ (h + 8 * (Fintype.card ι : ℝ)) * (SoficGroups.boundary (fun i => (σ i).prodCongr (σ i)) U : ℝ) ≤ h * (tolerance : ℝ) ∧ (5 : ℝ) * (4 * (SoficGroups.boundary (fun i => (σ i).prodCongr (σ i)) U : ℝ) + h * ((U \\ SoficGroups.permutationGraph p).card : ℝ)) ≤ h * (Fintype.card V : ℝ)) : SoficGroups.HasAlmostCentralizerImprovement σ tolerance"},{"kind":"theorem","name":"sum_sq_le_sq_sum_of_same_sign","statement":"{ι : Type*} [Fintype ι] (a : ι → ℝ) (h : (∀ i, 0 ≤ a i) ∨ (∀ i, a i ≤ 0)) : (∑ i, a i ^ 2) ≤ (∑ i, a i) ^ 2"},{"kind":"theorem","name":"indicator_displacements_same_sign","statement":"{ι V : Type*} (p : ι → V → V) (f : V → ℝ) (hf : ∀ x, f x = 0 ∨ f x = 1) (x : V) : (∀ i, 0 ≤ f (p i x) - f x) ∨ (∀ i, f (p i x) - f x ≤ 0)"},{"kind":"theorem","name":"sum_indicator_displacement_sq_le","statement":"{ι V : Type*} [Fintype ι] (p : ι → V → V) (f : V → ℝ) (hf : ∀ x, f x = 0 ∨ f x = 1) (x : V) : (∑ i, (f (p i x) - f x) ^ 2) ≤ (∑ i, (f (p i x) - f x)) ^ 2"},{"kind":"theorem","name":"sum_sum_indicator_displacement_sq_le","statement":"{ι V : Type*} [Fintype ι] [Fintype V] (p : ι → V → V) (f : V → ℝ) (hf : ∀ x, f x = 0 ∨ f x = 1) : (∑ i, ∑ x, (f (p i x) - f x) ^ 2) ≤ ∑ x, (∑ i, (f (p i x) - f x)) ^ 2"},{"kind":"theorem","name":"sum_sum_indicator_displacement_sq_le_card_sq_mul_markov_defect","statement":"{ι V : Type*} [Fintype ι] [Nonempty ι] [Fintype V] (p : ι → V → V) (f : V → ℝ) (hf : ∀ x, f x = 0 ∨ f x = 1) : (∑ i, ∑ x, (f (p i x) - f x) ^ 2) ≤ (Fintype.card ι : ℝ) ^ 2 * ∑ x, ((∑ i, f (p i x)) / (Fintype.card ι : ℝ) - f x) ^ 2"},{"kind":"theorem","name":"permutationUnitary_mul","statement":"{V : Type*} [Fintype V] (p q : Equiv.Perm V) (ξ : EuclideanSpace ℂ V) : permutationUnitary (p * q) ξ = permutationUnitary p (permutationUnitary q ξ)"},{"kind":"theorem","name":"permutationUnitary_one","statement":"{V : Type*} [Fintype V] (ξ : EuclideanSpace ℂ V) : permutationUnitary (1 : Equiv.Perm V) ξ = ξ"},{"kind":"theorem","name":"permutationUnitary_eq_of_agree_on_support","statement":"{V : Type*} [Fintype V] (p q : Equiv.Perm V) (ξ : EuclideanSpace ℂ V) (h : ∀ x : V, ξ x ≠ 0 → p x = q x) : permutationUnitary p ξ = permutationUnitary q ξ"},{"kind":"theorem","name":"permutationUnitary_model_mul_of_agree_on_support","statement":"{G V : Type*} [Group G] [Fintype V] (σ : G → Equiv.Perm V) (a g : G) (ξ : EuclideanSpace ℂ V) (hroot : ∀ x : V, ξ x ≠ 0 → σ (a * g) x = (σ a * σ g) x) : permutationUnitary (σ (a * g)) ξ = permutationUnitary (σ a) (permutationUnitary (σ g) ξ)"},{"kind":"theorem","name":"permutationMarkov_apply","statement":"{ι V : Type*} [Fintype ι] [Fintype V] (p : ι → Equiv.Perm V) (ξ : EuclideanSpace ℂ V) (x : V) : permutationMarkov p ξ x = (∑ i, ξ ((p i).symm x)) / (Fintype.card ι : ℂ)"},{"kind":"theorem","name":"permutation_indicator_displacement_norm_sq","statement":"{V : Type*} [Fintype V] (p : Equiv.Perm V) (f : V → ℝ) : ‖permutationUnitary p (indicatorVector f) - indicatorVector f‖ ^ 2 = ∑ x, (f (p.symm x) - f x) ^ 2"},{"kind":"theorem","name":"permutation_indicator_markov_defect_norm_sq","statement":"{ι V : Type*} [Fintype ι] [Fintype V] (p : ι → Equiv.Perm V) (f : V → ℝ) : ‖permutationMarkov p (indicatorVector f) - indicatorVector f‖ ^ 2 = ∑ x, ((∑ i, f ((p i).symm x)) / (Fintype.card ι : ℝ) - f x) ^ 2"},{"kind":"theorem","name":"sum_permutation_indicator_displacement_norm_sq_le","statement":"{ι V : Type*} [Fintype ι] [Nonempty ι] [Fintype V] (p : ι → Equiv.Perm V) (f : V → ℝ) (hf : ∀ x, f x = 0 ∨ f x = 1) : (∑ i, ‖permutationUnitary (p i) (indicatorVector f) - indicatorVector f‖ ^ 2) ≤ (Fintype.card ι : ℝ) ^ 2 * ‖permutationMarkov p (indicatorVector f) - indicatorVector f‖ ^ 2"},{"kind":"theorem","name":"permutation_indicator_displacement_norm_le_card_mul_markov_defect","statement":"{ι V : Type*} [Fintype ι] [Nonempty ι] [Fintype V] (p : ι → Equiv.Perm V) (f : V → ℝ) (hf : ∀ x, f x = 0 ∨ f x = 1) (i : ι) : ‖permutationUnitary (p i) (indicatorVector f) - indicatorVector f‖ ≤ (Fintype.card ι : ℝ) * ‖permutationMarkov p (indicatorVector f) - indicatorVector f‖"},{"kind":"theorem","name":"norm_normalizedIndicatorDisplacement_generator_le","statement":"{ι V : Type*} [Fintype ι] [Nonempty ι] [Fintype V] (p : ι → Equiv.Perm V) (f : V → ℝ) (hf : ∀ x, f x = 0 ∨ f x = 1) (hdefect : permutationMarkov p (indicatorVector f) ≠ indicatorVector f) (i : ι) : ‖normalizedIndicatorDisplacement p f (p i)‖ ≤ (Fintype.card ι : ℝ)"},{"kind":"theorem","name":"normalizedIndicatorDisplacement_mul","statement":"{ι V : Type*} [Fintype ι] [Fintype V] (p : ι → Equiv.Perm V) (f : V → ℝ) (q r : Equiv.Perm V) : normalizedIndicatorDisplacement p f (q * r) = normalizedIndicatorDisplacement p f q + permutationUnitary q (normalizedIndicatorDisplacement p f r)"},{"kind":"theorem","name":"norm_normalizedIndicatorDisplacement_list_prod_le","statement":"{ι V : Type*} [Fintype ι] [Nonempty ι] [Fintype V] (p : ι → Equiv.Perm V) (f : V → ℝ) (hf : ∀ x, f x = 0 ∨ f x = 1) (hdefect : permutationMarkov p (indicatorVector f) ≠ indicatorVector f) (w : List ι) : ‖normalizedIndicatorDisplacement p f (w.map p).prod‖ ≤ (Fintype.card ι : ℝ) * w.length"},{"kind":"theorem","name":"norm_normalizedIndicatorDefect","statement":"{ι V : Type*} [Fintype ι] [Fintype V] (p : ι → Equiv.Perm V) (f : V → ℝ) (hdefect : permutationMarkov p (indicatorVector f) ≠ indicatorVector f) : ‖normalizedIndicatorDefect p f‖ = 1"},{"kind":"theorem","name":"average_permutation_indicator_displacement","statement":"{ι V : Type*} [Fintype ι] [Nonempty ι] [Fintype V] (p : ι → Equiv.Perm V) (f : V → ℝ) : (Fintype.card ι : ℂ)⁻¹ • (∑ i, (permutationUnitary (p i) (indicatorVector f) - indicatorVector f)) = permutationMarkov p (indicatorVector f) - indicatorVector f"},{"kind":"theorem","name":"average_normalizedIndicatorDisplacement","statement":"{ι V : Type*} [Fintype ι] [Nonempty ι] [Fintype V] (p : ι → Equiv.Perm V) (f : V → ℝ) : (Fintype.card ι : ℂ)⁻¹ • (∑ i, normalizedIndicatorDisplacement p f (p i)) = normalizedIndicatorDefect p f"},{"kind":"theorem","name":"normalizedIndicatorDisplacement_cocycle_of_agree_on_support","statement":"{G ι V : Type*} [Group G] [Fintype ι] [Fintype V] (p : ι → Equiv.Perm V) (f : V → ℝ) (σ : G → Equiv.Perm V) (a g : G) (hroot : ∀ x : V, indicatorVector f x ≠ 0 → σ (a * g) x = (σ a * σ g) x) : normalizedIndicatorDisplacement p f (σ (a * g)) = normalizedIndicatorDisplacement p f (σ a) + permutationUnitary (σ a) (normalizedIndicatorDisplacement p f (σ g))"},{"kind":"theorem","name":"normalizedPairDisplacement_diagonal","statement":"{G ι V : Type*} [Group G] [Fintype ι] [Fintype V] (p : ι → Equiv.Perm V) (f : V → ℝ) (σ : G → Equiv.Perm V) (a g h : G) (hg : ∀ x : V, indicatorVector f x ≠ 0 → σ (a * g) x = (σ a * σ g) x) (hh : ∀ x : V, indicatorVector f x ≠ 0 → σ (a * h) x = (σ a * σ h) x) : normalizedPairDisplacement p f σ (a * g, a * h) = permutationUnitary (σ a) (normalizedPairDisplacement p f σ (g, h))"},{"kind":"theorem","name":"normalizedPairDisplacement_inner_diagonal","statement":"{G ι V : Type*} [Group G] [Fintype ι] [Fintype V] (p : ι → Equiv.Perm V) (f : V → ℝ) (σ : G → Equiv.Perm V) (a g h j k : G) (hg : ∀ x : V, indicatorVector f x ≠ 0 → σ (a * g) x = (σ a * σ g) x) (hh : ∀ x : V, indicatorVector f x ≠ 0 → σ (a * h) x = (σ a * σ h) x) (hj : ∀ x : V, indicatorVector f x ≠ 0 → σ (a * j) x = (σ a * σ j) x) (hk : ∀ x : V, indicatorVector f x ≠ 0 → σ (a * k) x = (σ a * σ k) x) : @inner ℂ (EuclideanSpace ℂ V) _ (normalizedPairDisplacement p f σ (a * g, a * h)) (normalizedPairDisplacement p f σ (a * j, a * k)) = @inner ℂ (EuclideanSpace ℂ V) _ (normalizedPairDisplacement p f σ (g, h)) (normalizedPairDisplacement p f σ (j, k))"},{"kind":"theorem","name":"normalizedPairDisplacement_add","statement":"{G ι V : Type*} [Fintype ι] [Fintype V] (p : ι → Equiv.Perm V) (f : V → ℝ) (σ : G → Equiv.Perm V) (g h j : G) : normalizedPairDisplacement p f σ (g, h) + normalizedPairDisplacement p f σ (h, j) = normalizedPairDisplacement p f σ (g, j)"},{"kind":"theorem","name":"norm_normalizedPairDisplacement_le_of_words","statement":"{G ι V : Type*} [Fintype ι] [Nonempty ι] [Fintype V] (p : ι → Equiv.Perm V) (f : V → ℝ) (hf : ∀ x, f x = 0 ∨ f x = 1) (hdefect : permutationMarkov p (indicatorVector f) ≠ indicatorVector f) (σ : G → Equiv.Perm V) (w : G → List ι) (hw : ∀ g, σ g = ((w g).map p).prod) (g h : G) : ‖normalizedPairDisplacement p f σ (g, h)‖ ≤ (Fintype.card ι : ℝ) * ((w g).length + (w h).length)"},{"kind":"theorem","name":"exists_hyperfilter_gram_limit_of_pointwise_bound","statement":"{I : Type*} {H : ℕ → Type*} [∀ n, SeminormedAddCommGroup (H n)] [∀ n, InnerProductSpace ℂ (H n)] (v : ∀ n, I → H n) (B : I → ℝ) (hbound : ∀ n i, ‖v n i‖ ≤ B i) : ∃ K : Matrix I I ℂ, ∀ i j, Tendsto (fun n => ⟪v n i, v n j⟫_ℂ) (Filter.hyperfilter ℕ) (𝓝 (K i j))"},{"kind":"theorem","name":"gram_posSemidef_infinite","statement":"{I H : Type*} [SeminormedAddCommGroup H] [InnerProductSpace ℂ H] (v : I → H) : (Matrix.gram ℂ v).PosSemidef"},{"kind":"theorem","name":"exists_hyperfilter_positive_gram_kernel_of_pointwise_bound","statement":"{I : Type*} {H : ℕ → Type*} [∀ n, SeminormedAddCommGroup (H n)] [∀ n, InnerProductSpace ℂ (H n)] (v : ∀ n, I → H n) (B : I → ℝ) (hbound : ∀ n i, ‖v n i‖ ≤ B i) : ∃ K : Matrix I I ℂ, K.PosSemidef ∧ ∀ i j, Tendsto (fun n => ⟪v n i, v n j⟫_ℂ) (Filter.hyperfilter ℕ) (𝓝 (K i j))"},{"kind":"theorem","name":"exists_hyperfilter_diagonal_positive_pair_kernel","statement":"{G : Type*} [Group G] {H : ℕ → Type*} [∀ n, SeminormedAddCommGroup (H n)] [∀ n, InnerProductSpace ℂ (H n)] (v : ∀ n, G × G → H n) (B : G × G → ℝ) (hbound : ∀ n q, ‖v n q‖ ≤ B q) (hdiagonal : ∀ a g h j k : G, ∀ᶠ n in Filter.atTop, ⟪v n (a * g, a * h), v n (a * j, a * k)⟫_ℂ = ⟪v n (g, h), v n (j, k)⟫_ℂ) (hadd : ∀ n (g h j : G), v n (g, h) + v n (h, j) = v n (g, j)) : ∃ K : Matrix (G × G) (G × G) ℂ, K.PosSemidef ∧ (∀ a g h j k : G, K (a * g, a * h) (a * j, a * k) = K (g, h) (j, k)) ∧ (∀ g h j : G, ∀ q : G × G, K (g, h) q + K (h, j) q = K (g, j) q) ∧ ∀ q r, Tendsto (fun n => ⟪v n q, v n r⟫_ℂ) (Filter.hyperfilter ℕ) (𝓝 (K q r))"},{"kind":"theorem","name":"exists_hyperfilter_diagonal_positive_pair_kernel_of_rooted_indicators","statement":"{G ι : Type*} [Group G] [Fintype ι] [Nonempty ι] {V : ℕ → Type*} [∀ n, Fintype (V n)] (p : ∀ n, ι → Equiv.Perm (V n)) (f : ∀ n, V n → ℝ) (σ : ∀ n, G → Equiv.Perm (V n)) (w : G → List ι) (hf : ∀ n x, f n x = 0 ∨ f n x = 1) (hdefect : ∀ n, permutationMarkov (p n) (indicatorVector (f n)) ≠ indicatorVector (f n)) (hw : ∀ n g, σ n g = ((w g).map (p n)).prod) (hroot : ∀ a g : G, ∀ᶠ n in Filter.atTop, ∀ x : V n, indicatorVector (f n) x ≠ 0 → σ n (a * g) x = (σ n a * σ n g) x) : ∃ K : Matrix (G × G) (G × G) ℂ, K.PosSemidef ∧ (∀ a g h j k : G, K (a * g, a * h) (a * j, a * k) = K (g, h) (j, k)) ∧ (∀ g h j : G, ∀ q : G × G, K (g, h) q + K (h, j) q = K (g, j) q) ∧ ∀ q r, Tendsto (fun n => ⟪normalizedPairDisplacement (p n) (f n) (σ n) q, normalizedPairDisplacement (p n) (f n) (σ n) r⟫_ℂ) (Filter.hyperfilter ℕ) (𝓝 (K q r))"},{"kind":"theorem","name":"scalarOperatorKernel_posSemidef","statement":"{I : Type u} (K : Matrix I I ℂ) (hK : K.PosSemidef) : (scalarOperatorKernel K).PosSemidef"},{"kind":"theorem","name":"preKernel_inner_single","statement":"{I : Type u} (K : Matrix I I ℂ) [Fact (scalarOperatorKernel K).PosSemidef] (i j : I × ℂ) (z w : ℂ) : ⟪(Finsupp.single i z : RKHS.H₀ (scalarOperatorKernel K)), (Finsupp.single j w : RKHS.H₀ (scalarOperatorKernel K))⟫_ℂ = star z * w * ⟪scalarOperatorKernel K j.1 i.1 i.2, j.2⟫_ℂ"},{"kind":"theorem","name":"actionPreKernelTranslation_inner","statement":"{G I : Type u} [Group G] (K : Matrix I I ℂ) [Fact (scalarOperatorKernel K).PosSemidef] (ρ : G →* Equiv.Perm I) (hinv : ∀ a i j, K (ρ a i) (ρ a j) = K i j) (a : G) (f g : RKHS.H₀ (scalarOperatorKernel K)) : ⟪actionPreKernelTranslation K ρ a f, actionPreKernelTranslation K ρ a g⟫_ℂ = ⟪f, g⟫_ℂ"},{"kind":"theorem","name":"actionKernelTranslationMap_coe","statement":"{G I : Type u} [Group G] (K : Matrix I I ℂ) [Fact (scalarOperatorKernel K).PosSemidef] (ρ : G →* Equiv.Perm I) (hinv : ∀ a i j, K (ρ a i) (ρ a j) = K i j) (a : G) (f : RKHS.H₀ (scalarOperatorKernel K)) : actionKernelTranslationMap K ρ hinv a (f : RKHS.OfKernel (scalarOperatorKernel K)) = (actionPreKernelTranslation K ρ a f : RKHS.OfKernel (scalarOperatorKernel K))"},{"kind":"theorem","name":"actionKernelTranslationMap_isometry","statement":"{G I : Type u} [Group G] (K : Matrix I I ℂ) [Fact (scalarOperatorKernel K).PosSemidef] (ρ : G →* Equiv.Perm I) (hinv : ∀ a i j, K (ρ a i) (ρ a j) = K i j) (a : G) : Isometry (actionKernelTranslationMap K ρ hinv a)"},{"kind":"theorem","name":"actionPreKernelTranslation_mul_apply","statement":"{G I : Type u} [Group G] (K : Matrix I I ℂ) (ρ : G →* Equiv.Perm I) (a b : G) (f : RKHS.H₀ (scalarOperatorKernel K)) : actionPreKernelTranslation K ρ (a * b) f = actionPreKernelTranslation K ρ a (actionPreKernelTranslation K ρ b f)"},{"kind":"theorem","name":"actionPreKernelTranslation_one_apply","statement":"{G I : Type u} [Group G] (K : Matrix I I ℂ) (ρ : G →* Equiv.Perm I) (f : RKHS.H₀ (scalarOperatorKernel K)) : actionPreKernelTranslation K ρ 1 f = f"},{"kind":"theorem","name":"actionKernelTranslationMap_mul_apply","statement":"{G I : Type u} [Group G] (K : Matrix I I ℂ) [Fact (scalarOperatorKernel K).PosSemidef] (ρ : G →* Equiv.Perm I) (hinv : ∀ a i j, K (ρ a i) (ρ a j) = K i j) (a b : G) (x : RKHS.OfKernel (scalarOperatorKernel K)) : actionKernelTranslationMap K ρ hinv (a * b) x = actionKernelTranslationMap K ρ hinv a (actionKernelTranslationMap K ρ hinv b x)"},{"kind":"theorem","name":"actionKernelTranslationMap_one_apply","statement":"{G I : Type u} [Group G] (K : Matrix I I ℂ) [Fact (scalarOperatorKernel K).PosSemidef] (ρ : G →* Equiv.Perm I) (hinv : ∀ a i j, K (ρ a i) (ρ a j) = K i j) (x : RKHS.OfKernel (scalarOperatorKernel K)) : actionKernelTranslationMap K ρ hinv 1 x = x"},{"kind":"theorem","name":"ofKernel_kerFun_one_eq_coe_single","statement":"{I : Type u} (L : Matrix I I (ℂ →L[ℂ] ℂ)) [Fact L.PosSemidef] (i : I) : RKHS.kerFun (RKHS.OfKernel L) i (1 : ℂ) = ((Finsupp.single (i, (1 : ℂ)) (1 : ℂ) : RKHS.H₀ L) : RKHS.OfKernel L)"},{"kind":"theorem","name":"actionKernelUnitaryRepresentation_kerFun_one","statement":"{G I : Type u} [Group G] (K : Matrix I I ℂ) [Fact (scalarOperatorKernel K).PosSemidef] (ρ : G →* Equiv.Perm I) (hinv : ∀ a i j, K (ρ a i) (ρ a j) = K i j) (a : G) (i : I) : actionKernelUnitaryRepresentation K ρ hinv a (RKHS.kerFun (RKHS.OfKernel (scalarOperatorKernel K)) i (1 : ℂ)) = RKHS.kerFun (RKHS.OfKernel (scalarOperatorKernel K)) (ρ a i) (1 : ℂ)"},{"kind":"theorem","name":"diagonalPairKernelUnitaryRepresentation_kerFun_one","statement":"{G : Type u} [Group G] (K : Matrix (G × G) (G × G) ℂ) [Fact (scalarOperatorKernel K).PosSemidef] (hinv : ∀ a g h j k : G, K (a * g, a * h) (a * j, a * k) = K (g, h) (j, k)) (a g h : G) : diagonalPairKernelUnitaryRepresentation K hinv a (RKHS.kerFun (RKHS.OfKernel (scalarOperatorKernel K)) (g, h) (1 : ℂ)) = RKHS.kerFun (RKHS.OfKernel (scalarOperatorKernel K)) (a * g, a * h) (1 : ℂ)"},{"kind":"theorem","name":"hilbertKernelRealization_pair_vector_add","statement":"{G : Type u} (K : Matrix (G × G) (G × G) ℂ) (R : HilbertKernelRealization K) (hadd : ∀ g h j : G, ∀ q : G × G, K (g, h) q + K (h, j) q = K (g, j) q) (g h j : G) : R.vector (g, h) + R.vector (h, j) = R.vector (g, j)"},{"kind":"theorem","name":"exists_equivariantHilbertKernelRealization","statement":"{G : Type u} [Group G] (K : Matrix (G × G) (G × G) ℂ) (hpositive : K.PosSemidef) (hdiagonal : ∀ a g h j k : G, K (a * g, a * h) (a * j, a * k) = K (g, h) (j, k)) : Nonempty (EquivariantHilbertKernelRealization K)"},{"kind":"theorem","name":"equivariantPairCocycle_mul","statement":"{G : Type u} [Group G] (K : Matrix (G × G) (G × G) ℂ) (R : EquivariantHilbertKernelRealization K) (hadd : ∀ g h j : G, ∀ q : G × G, K (g, h) q + K (h, j) q = K (g, j) q) (a g : G) : equivariantPairCocycle R (a * g) = equivariantPairCocycle R a + R.representation a (equivariantPairCocycle R g)"},{"kind":"theorem","name":"normalizedPairDisplacement_generator_of_model","statement":"{G ι V : Type*} [Group G] [Fintype ι] [Fintype V] (p : ι → Equiv.Perm V) (f : V → ℝ) (σ : G → Equiv.Perm V) (s : ι → G) (hone : σ 1 = 1) (hgenerator : ∀ i, σ (s i) = p i) (i : ι) : normalizedPairDisplacement p f σ (s i, 1) = normalizedIndicatorDisplacement p f (p i)"},{"kind":"theorem","name":"norm_average_normalizedPairDisplacement_of_model","statement":"{G ι V : Type*} [Group G] [Fintype ι] [Nonempty ι] [Fintype V] (p : ι → Equiv.Perm V) (f : V → ℝ) (σ : G → Equiv.Perm V) (s : ι → G) (hone : σ 1 = 1) (hgenerator : ∀ i, σ (s i) = p i) (hdefect : permutationMarkov p (indicatorVector f) ≠ indicatorVector f) : ‖(Fintype.card ι : ℂ)⁻¹ • ∑ i, normalizedPairDisplacement p f σ (s i, 1)‖ = 1"},{"kind":"theorem","name":"inner_smul_finset_sum_self","statement":"{I E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E] (z : I → E) (F : Finset I) (c : ℂ) : ⟪c • ∑ i ∈ F, z i, c • ∑ i ∈ F, z i⟫_ℂ = star c * (∑ i ∈ F, ∑ j ∈ F, ⟪z i, z j⟫_ℂ) * c"},{"kind":"theorem","name":"tendsto_norm_sq_smul_finset_sum_of_gram","statement":"{N I H : Type*} {E : N → Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [∀ n, NormedAddCommGroup (E n)] [∀ n, InnerProductSpace ℂ (E n)] (l : Filter N) (z : ∀ n, I → E n) (v : I → H) (hgram : ∀ i j, Tendsto (fun n => ⟪z n i, z n j⟫_ℂ) l (𝓝 ⟪v i, v j⟫_ℂ)) (F : Finset I) (c : ℂ) : Tendsto (fun n => ‖c • ∑ i ∈ F, z n i‖ ^ 2) l (𝓝 (‖c • ∑ i ∈ F, v i‖ ^ 2))"},{"kind":"theorem","name":"norm_smul_finset_sum_eq_one_of_gram","statement":"{N I H : Type*} {E : N → Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [∀ n, NormedAddCommGroup (E n)] [∀ n, InnerProductSpace ℂ (E n)] (l : Filter N) [NeBot l] (z : ∀ n, I → E n) (v : I → H) (hgram : ∀ i j, Tendsto (fun n => ⟪z n i, z n j⟫_ℂ) l (𝓝 ⟪v i, v j⟫_ℂ)) (F : Finset I) (c : ℂ) (hnorm : ∀ n, ‖c • ∑ i ∈ F, z n i‖ = 1) : ‖c • ∑ i ∈ F, v i‖ = 1"},{"kind":"theorem","name":"exists_equivariant_hilbert_normalized_rooted_pair_realization","statement":"{G ι : Type u} [Group G] [Fintype ι] [Nonempty ι] {V : ℕ → Type u} [∀ n, Fintype (V n)] (p : ∀ n, ι → Equiv.Perm (V n)) (f : ∀ n, V n → ℝ) (σ : ∀ n, G → Equiv.Perm (V n)) (s : ι → G) (w : G → List ι) (hf : ∀ n x, f n x = 0 ∨ f n x = 1) (hdefect : ∀ n, permutationMarkov (p n) (indicatorVector (f n)) ≠ indicatorVector (f n)) (hw : ∀ n g, σ n g = ((w g).map (p n)).prod) (hone : ∀ n, σ n 1 = 1) (hgenerator : ∀ n i, σ n (s i) = p n i) (hroot : ∀ a g : G, ∀ᶠ n in Filter.atTop, ∀ x : V n, indicatorVector (f n) x ≠ 0 → σ n (a * g) x = (σ n a * σ n g) x) : ∃ (K : Matrix (G × G) (G × G) ℂ) (R : EquivariantHilbertKernelRealization K), K.PosSemidef ∧ (∀ a g h j k : G, K (a * g, a * h) (a * j, a * k) = K (g, h) (j, k)) ∧ (∀ a g h : G, R.representation a (R.realization.vector (g, h)) = R.realization.vector (a * g, a * h)) ∧ (∀ g h j : G, R.realization.vector (g, h) + R.realization.vector (h, j) = R.realization.vector (g, j)) ∧ (∀ a g : G, equivariantPairCocycle R (a * g) = equivariantPairCocycle R a + R.representation a (equivariantPairCocycle R g)) ∧ ‖(Fintype.card ι : ℂ)⁻¹ • ∑ i, equivariantPairCocycle R (s i)‖ = 1 ∧ ∀ q r, Tendsto (fun n => ⟪normalizedPairDisplacement (p n) (f n) (σ n) q, normalizedPairDisplacement (p n) (f n) (σ n) r⟫_ℂ) (Filter.hyperfilter ℕ) (𝓝 ⟪R.realization.vector q, R.realization.vector r⟫_ℂ)"},{"kind":"theorem","name":"map_mem_invariantSubmodule_orthogonal","statement":"(π : SoficGroups.UnitaryRepresentation G H) (g : G) {x : H} (hx : x ∈ (invariantSubmodule π)ᗮ) : π g x ∈ (invariantSubmodule π)ᗮ"},{"kind":"theorem","name":"orthogonalRepresentation_no_fixed","statement":"(π : SoficGroups.UnitaryRepresentation G H) (x : (invariantSubmodule π)ᗮ) (hx : ∀ g : G, orthogonalRepresentation π g x = x) : x = 0"},{"kind":"theorem","name":"cocycle_one","statement":"(π : SoficGroups.UnitaryRepresentation G H) (b : G → H) (hb : ∀ g h : G, b (g * h) = b g + π g (b h)) : b 1 = 0"},{"kind":"theorem","name":"inner_cocycle_inv_of_invariant","statement":"(π : SoficGroups.UnitaryRepresentation G H) (b : G → H) (hb : ∀ g h : G, b (g * h) = b g + π g (b h)) (y : H) (hy : ∀ g : G, π g y = y) (g : G) : @inner ℂ H _ y (b g⁻¹) = -@inner ℂ H _ y (b g)"},{"kind":"theorem","name":"inner_cocycle_sum_eq_zero_of_invariant","statement":"(π : SoficGroups.UnitaryRepresentation G H) (b : G → H) (hb : ∀ g h : G, b (g * h) = b g + π g (b h)) (S : Finset G) (hS : ∀ g ∈ S, g⁻¹ ∈ S) (y : H) (hy : ∀ g : G, π g y = y) : @inner ℂ H _ y (∑ g ∈ S, b g) = 0"},{"kind":"theorem","name":"inner_smul_cocycle_sum_eq_zero_of_invariant","statement":"(π : SoficGroups.UnitaryRepresentation G H) (b : G → H) (hb : ∀ g h : G, b (g * h) = b g + π g (b h)) (S : Finset G) (hS : ∀ g ∈ S, g⁻¹ ∈ S) (c : ℂ) (y : H) (hy : ∀ g : G, π g y = y) : @inner ℂ H _ y (c • ∑ g ∈ S, b g) = 0"},{"kind":"theorem","name":"norm_add_le_two_sub_sq_div_four","statement":"(x y : H) (δ : ℝ) (hδ : 0 ≤ δ) (hδtwo : δ ≤ 2) (hnorm : ‖y‖ = ‖x‖) (hseparated : δ * ‖x‖ ≤ ‖x - y‖) : ‖x + y‖ ≤ (2 - δ ^ 2 / 4) * ‖x‖"},{"kind":"theorem","name":"norm_finset_sum_le_pair_add","statement":"{X : Type*} (S : Finset X) (f : X → H) (a b : X) (ha : a ∈ S) (hb : b ∈ S) (hab : a ≠ b) (r : ℝ) (hnorm : ∀ s ∈ S, ‖f s‖ = r) : ‖∑ s ∈ S, f s‖ ≤ ‖f a + f b‖ + ((S.card : ℝ) - 2) * r"},{"kind":"theorem","name":"kazhdan_generator_displacement_of_orthogonal_invariants","statement":"[CompleteSpace H] (P : SoficGroups.KazhdanPair.{u, v} G) (π : SoficGroups.UnitaryRepresentation G H) (x : H) (hx : x ≠ 0) (horth : ∀ y : H, (∀ g : G, π g y = y) → @inner ℂ H _ y x = 0) : ∃ g ∈ P.generators, P.kazhdanConstant * ‖x‖ ≤ ‖π g x - x‖"},{"kind":"theorem","name":"kazhdan_generator_sum_contraction","statement":"[CompleteSpace H] (P : SoficGroups.KazhdanPair.{u, v} G) (π : SoficGroups.UnitaryRepresentation G H) (S : Finset G) (hone : 1 ∈ S) (hsub : P.generators ⊆ S) (x : H) (horth : ∀ y : H, (∀ g : G, π g y = y) → @inner ℂ H _ y x = 0) : ‖∑ g ∈ S, π g x‖ ≤ ((S.card : ℝ) - P.kazhdanConstant ^ 2 / 4) * ‖x‖"},{"kind":"theorem","name":"kazhdanMarkovContractionFactor_lt_one","statement":"(P : SoficGroups.KazhdanPair.{u, v} G) (S : Finset G) (hS : S.Nonempty) : kazhdanMarkovContractionFactor P S < 1"},{"kind":"theorem","name":"kazhdanMarkovContractionFactor_nonneg","statement":"(P : SoficGroups.KazhdanPair.{u, v} G) (S : Finset G) : 0 ≤ kazhdanMarkovContractionFactor P S"},{"kind":"theorem","name":"unitaryFinsetMarkov_norm_le","statement":"[CompleteSpace H] (P : SoficGroups.KazhdanPair.{u, v} G) (π : SoficGroups.UnitaryRepresentation G H) (S : Finset G) (hone : 1 ∈ S) (hsub : P.generators ⊆ S) (x : H) (horth : ∀ y : H, (∀ g : G, π g y = y) → @inner ℂ H _ y x = 0) : ‖unitaryFinsetMarkov π S x‖ ≤ kazhdanMarkovContractionFactor P S * ‖x‖"},{"kind":"theorem","name":"unitaryFinsetMarkov_orthogonal_invariants","statement":"(π : SoficGroups.UnitaryRepresentation G H) (S : Finset G) (x : H) (horth : ∀ y : H, (∀ g : G, π g y = y) → @inner ℂ H _ y x = 0) : ∀ y : H, (∀ g : G, π g y = y) → @inner ℂ H _ y (unitaryFinsetMarkov π S x) = 0"},{"kind":"theorem","name":"unitaryFinsetMarkov_iterate_norm_le","statement":"[CompleteSpace H] (P : SoficGroups.KazhdanPair.{u, v} G) (π : SoficGroups.UnitaryRepresentation G H) (S : Finset G) (hone : 1 ∈ S) (hsub : P.generators ⊆ S) (x : H) (horth : ∀ y : H, (∀ g : G, π g y = y) → @inner ℂ H _ y x = 0) (n : ℕ) : ‖((unitaryFinsetMarkov π S)^[n]) x‖ ≤ kazhdanMarkovContractionFactor P S ^ n * ‖x‖"},{"kind":"theorem","name":"inner_smul_fintype_sum","statement":"{ι E : Type*} [Fintype ι] [NormedAddCommGroup E] [InnerProductSpace ℂ E] (x y : ι → E) (c : ℂ) : ⟪c • ∑ i, x i, c • ∑ j, y j⟫_ℂ = star c * (∑ i, ∑ j, ⟪x i, y j⟫_ℂ) * c"},{"kind":"theorem","name":"tendsto_inner_pairedWordAverage_of_gram","statement":"{G ι N H : Type*} [Group G] [Fintype ι] [NormedAddCommGroup H] [InnerProductSpace ℂ H] {E : N → Type*} [∀ n, NormedAddCommGroup (E n)] [∀ n, InnerProductSpace ℂ (E n)] (l : Filter N) (s : ι → G) (z : ∀ n, G × G → E n) (v : G × G → H) (hgram : ∀ q r, Tendsto (fun n => ⟪z n q, z n r⟫_ℂ) l (𝓝 ⟪v q, v r⟫_ℂ)) (k : ℕ) (q r : G × G) : Tendsto (fun n => ⟪pairedWordAverage s (z n) k q, pairedWordAverage s (z n) k r⟫_ℂ) l (𝓝 ⟪pairedWordAverage s v k q, pairedWordAverage s v k r⟫_ℂ)"},{"kind":"theorem","name":"tendsto_norm_pairedDefectWordAverage_of_gram","statement":"{G ι N H : Type*} [Group G] [Fintype ι] [NormedAddCommGroup H] [InnerProductSpace ℂ H] {E : N → Type*} [∀ n, NormedAddCommGroup (E n)] [∀ n, InnerProductSpace ℂ (E n)] (l : Filter N) (s : ι → G) (z : ∀ n, G × G → E n) (v : G × G → H) (hgram : ∀ q r, Tendsto (fun n => ⟪z n q, z n r⟫_ℂ) l (𝓝 ⟪v q, v r⟫_ℂ)) (k : ℕ) : Tendsto (fun n => ‖pairedDefectWordAverage s (z n) k‖) l (𝓝 ‖pairedDefectWordAverage s v k‖)"},{"kind":"theorem","name":"permutationMarkovLinear_apply","statement":"{ι V : Type*} [Fintype ι] [Fintype V] (p : ι → Equiv.Perm V) (x : EuclideanSpace ℂ V) : permutationMarkovLinear p x = permutationMarkov p x"},{"kind":"theorem","name":"permutationMarkovLinear_pow_apply","statement":"{ι V : Type*} [Fintype ι] [Fintype V] (p : ι → Equiv.Perm V) (k : ℕ) (x : EuclideanSpace ℂ V) : ((permutationMarkovLinear p) ^ k) x = ((permutationMarkov p)^[k]) x"},{"kind":"theorem","name":"permutationMarkov_pair_of_rooted","statement":"{G ι V : Type*} [Group G] [Fintype ι] [Fintype V] (p : ι → Equiv.Perm V) (f : V → ℝ) (σ : G → Equiv.Perm V) (s : ι → G) (hgenerator : ∀ i, σ (s i) = p i) (q : G × G) (hroot : ∀ i, (∀ x : V, indicatorVector f x ≠ 0 → σ (s i * q.1) x = (σ (s i) * σ q.1) x) ∧ (∀ x : V, indicatorVector f x ≠ 0 → σ (s i * q.2) x = (σ (s i) * σ q.2) x)) : permutationMarkov p (normalizedPairDisplacement p f σ q) = pairedWordAverage s (normalizedPairDisplacement p f σ) 1 q"},{"kind":"theorem","name":"eventually_permutationMarkov_pair_of_rooted","statement":"{G ι : Type*} [Group G] [Fintype ι] {V : ℕ → Type*} [∀ n, Fintype (V n)] (p : ∀ n, ι → Equiv.Perm (V n)) (f : ∀ n, V n → ℝ) (σ : ∀ n, G → Equiv.Perm (V n)) (s : ι → G) (hgenerator : ∀ n i, σ n (s i) = p n i) (hroot : ∀ a g : G, ∀ᶠ n in Filter.atTop, ∀ x : V n, indicatorVector (f n) x ≠ 0 → σ n (a * g) x = (σ n a * σ n g) x) (q : G × G) : ∀ᶠ n in Filter.atTop, permutationMarkov (p n) (normalizedPairDisplacement (p n) (f n) (σ n) q) = pairedWordAverage s (normalizedPairDisplacement (p n) (f n) (σ n)) 1 q"},{"kind":"theorem","name":"eventually_linear_pairedWordAverage_pow","statement":"{G ι N : Type*} [Group G] [Fintype ι] {E : N → Type*} [∀ n, AddCommMonoid (E n)] [∀ n, Module ℂ (E n)] (l : Filter N) (s : ι → G) (L : ∀ n, E n →ₗ[ℂ] E n) (z : ∀ n, G × G → E n) (hbase : ∀ q, ∀ᶠ n in l, L n (z n q) = pairedWordAverage s (z n) 1 q) (k : ℕ) (q : G × G) : ∀ᶠ n in l, ((L n) ^ k) (z n q) = pairedWordAverage s (z n) k q"},{"kind":"theorem","name":"eventually_linear_pairedDefectWordAverage_pow","statement":"{G ι N : Type*} [Group G] [Fintype ι] {E : N → Type*} [∀ n, AddCommMonoid (E n)] [∀ n, Module ℂ (E n)] (l : Filter N) (s : ι → G) (L : ∀ n, E n →ₗ[ℂ] E n) (z : ∀ n, G × G → E n) (hbase : ∀ q, ∀ᶠ n in l, L n (z n q) = pairedWordAverage s (z n) 1 q) (k : ℕ) : ∀ᶠ n in l, ((L n) ^ k) (pairedDefectWordAverage s (z n) 0) = pairedDefectWordAverage s (z n) k"},{"kind":"theorem","name":"pairedDefectWordAverage_zero_eq_normalizedIndicatorDefect","statement":"{G ι V : Type*} [Group G] [Fintype ι] [Nonempty ι] [Fintype V] (p : ι → Equiv.Perm V) (f : V → ℝ) (σ : G → Equiv.Perm V) (s : ι → G) (hone : σ 1 = 1) (hgenerator : ∀ i, σ (s i) = p i) : pairedDefectWordAverage s (normalizedPairDisplacement p f σ) 0 = normalizedIndicatorDefect p f"},{"kind":"theorem","name":"tendsto_norm_normalizedIndicatorDefect_markov_pow","statement":"{G ι H : Type*} [Group G] [Fintype ι] [Nonempty ι] [NormedAddCommGroup H] [InnerProductSpace ℂ H] {V : ℕ → Type*} [∀ n, Fintype (V n)] (p : ∀ n, ι → Equiv.Perm (V n)) (f : ∀ n, V n → ℝ) (σ : ∀ n, G → Equiv.Perm (V n)) (s : ι → G) (v : G × G → H) (hone : ∀ n, σ n 1 = 1) (hgenerator : ∀ n i, σ n (s i) = p n i) (hroot : ∀ a g : G, ∀ᶠ n in Filter.atTop, ∀ x : V n, indicatorVector (f n) x ≠ 0 → σ n (a * g) x = (σ n a * σ n g) x) (hgram : ∀ q r, Tendsto (fun n => ⟪normalizedPairDisplacement (p n) (f n) (σ n) q, normalizedPairDisplacement (p n) (f n) (σ n) r⟫_ℂ) (Filter.hyperfilter ℕ) (𝓝 ⟪v q, v r⟫_ℂ)) (k : ℕ) : Tendsto (fun n => ‖((permutationMarkov (p n))^[k]) (normalizedIndicatorDefect (p n) (f n))‖) (Filter.hyperfilter ℕ) (𝓝 ‖pairedDefectWordAverage s v k‖)"},{"kind":"theorem","name":"representationFamilyMarkovLinear_subtype_apply","statement":"{G H : Type*} [Group G] [NormedAddCommGroup H] [InnerProductSpace ℂ H] (π : SoficGroups.UnitaryRepresentation G H) (S : Finset G) (x : H) : representationFamilyMarkovLinear π (fun i : ↥S => (i : G)) x = unitaryFinsetMarkov π S x"},{"kind":"theorem","name":"representationFamilyMarkovLinear_subtype_pow_apply","statement":"{G H : Type*} [Group G] [NormedAddCommGroup H] [InnerProductSpace ℂ H] (π : SoficGroups.UnitaryRepresentation G H) (S : Finset G) (k : ℕ) (x : H) : (representationFamilyMarkovLinear π (fun i : ↥S => (i : G)) ^ k) x = ((unitaryFinsetMarkov π S)^[k]) x"},{"kind":"theorem","name":"representationFamilyMarkovLinear_pair_of_equivariant","statement":"{G ι H : Type*} [Group G] [Fintype ι] [NormedAddCommGroup H] [InnerProductSpace ℂ H] (π : SoficGroups.UnitaryRepresentation G H) (s : ι → G) (v : G × G → H) (hequivariant : ∀ a g h : G, π a (v (g, h)) = v (a * g, a * h)) (q : G × G) : representationFamilyMarkovLinear π s (v q) = pairedWordAverage s v 1 q"},{"kind":"theorem","name":"linear_pairedWordAverage_pow","statement":"{G ι E : Type*} [Group G] [Fintype ι] [AddCommMonoid E] [Module ℂ E] (s : ι → G) (L : E →ₗ[ℂ] E) (z : G × G → E) (hbase : ∀ q, L (z q) = pairedWordAverage s z 1 q) (k : ℕ) (q : G × G) : (L ^ k) (z q) = pairedWordAverage s z k q"},{"kind":"theorem","name":"pairedDefectWordAverage_eq_unitaryFinsetMarkov_iterate","statement":"{G H : Type*} [Group G] [NormedAddCommGroup H] [InnerProductSpace ℂ H] (π : SoficGroups.UnitaryRepresentation G H) (S : Finset G) (v : G × G → H) (hequivariant : ∀ a g h : G, π a (v (g, h)) = v (a * g, a * h)) (k : ℕ) : pairedDefectWordAverage (fun i : ↥S => (i : G)) v k = ((unitaryFinsetMarkov π S)^[k]) (pairedDefectWordAverage (fun i : ↥S => (i : G)) v 0)"},{"kind":"theorem","name":"eventually_normalizedIndicatorDefect_markov_pow_lt_of_rooted","statement":"{G : Type u} [Group G] (P : SoficGroups.KazhdanPair.{u, u} G) (S : Finset G) (honeS : 1 ∈ S) (hcover : P.generators ⊆ S) (hsymmetric : ∀ g ∈ S, g⁻¹ ∈ S) {V : ℕ → Type u} [∀ n, Fintype (V n)] (p : ∀ n, ↥S → Equiv.Perm (V n)) (f : ∀ n, V n → ℝ) (σ : ∀ n, G → Equiv.Perm (V n)) (w : G → List ↥S) (hf : ∀ n x, f n x = 0 ∨ f n x = 1) (hdefect : ∀ n, permutationMarkov (p n) (indicatorVector (f n)) ≠ indicatorVector (f n)) (hw : ∀ n g, σ n g = ((w g).map (p n)).prod) (hone : ∀ n, σ n 1 = 1) (hgenerator : ∀ n (i : ↥S), σ n (i : G) = p n i) (hroot : ∀ a g : G, ∀ᶠ n in Filter.atTop, ∀ x : V n, indicatorVector (f n) x ≠ 0 → σ n (a * g) x = (σ n a * σ n g) x) (k : ℕ) (ε : ℝ) (hε : 0 < ε) : ∀ᶠ n in (Filter.hyperfilter ℕ : Filter ℕ), ‖((permutationMarkov (p n))^[k]) (normalizedIndicatorDefect (p n) (f n))‖ < kazhdanMarkovContractionFactor P S ^ k + ε"},{"kind":"theorem","name":"eventually_rooted_of_growing_word_radius","statement":"{G ι : Type u} [Group G] (X : ℕ → RootedIndicatorMarkovModel G ι) (w : G → List ι) (hroot : ∀ n, (X n).IsRootedAtRadius w n) (a g : G) : ∀ᶠ n in Filter.atTop, ∀ x : (X n).carrier, indicatorVector (X n).indicator x ≠ 0 → (X n).evaluation (a * g) x = ((X n).evaluation a * (X n).evaluation g) x"},{"kind":"theorem","name":"exists_rooted_word_radius_normalized_markov_contraction","statement":"{G : Type u} [Group G] (P : SoficGroups.KazhdanPair.{u, u} G) (S : Finset G) (honeS : 1 ∈ S) (hcover : P.generators ⊆ S) (hsymmetric : ∀ g ∈ S, g⁻¹ ∈ S) (w : G → List ↥S) (k : ℕ) (ε : ℝ) (hε : 0 < ε) : ∃ r : ℕ, ∀ X : RootedIndicatorMarkovModel G ↥S, X.IsGenerated (fun i : ↥S => (i : G)) w → X.IsRootedAtRadius w r → permutationMarkov X.generator (indicatorVector X.indicator) ≠ indicatorVector X.indicator → ‖((permutationMarkov X.generator)^[k]) (normalizedIndicatorDefect X.generator X.indicator)‖ < kazhdanMarkovContractionFactor P S ^ k + ε"},{"kind":"theorem","name":"permutationMarkov_iterate_difference","statement":"{ι V : Type*} [Fintype ι] [Fintype V] (p : ι → Equiv.Perm V) (x : EuclideanSpace ℂ V) (k : ℕ) : ((permutationMarkov p)^[k + 1]) x - ((permutationMarkov p)^[k]) x = ((permutationMarkovLinear p) ^ k) (permutationMarkov p x - x)"},{"kind":"theorem","name":"norm_normalizedIndicatorDefect_markov_pow","statement":"{ι V : Type*} [Fintype ι] [Fintype V] (p : ι → Equiv.Perm V) (f : V → ℝ) (k : ℕ) : ‖((permutationMarkov p)^[k]) (normalizedIndicatorDefect p f)‖ = ‖((permutationMarkovLinear p) ^ k) (permutationMarkov p (indicatorVector f) - indicatorVector f)‖ / ‖permutationMarkov p (indicatorVector f) - indicatorVector f‖"},{"kind":"theorem","name":"exists_rooted_word_radius_markov_iterate_contraction","statement":"{G : Type u} [Group G] (P : SoficGroups.KazhdanPair.{u, u} G) (S : Finset G) (honeS : 1 ∈ S) (hcover : P.generators ⊆ S) (hsymmetric : ∀ g ∈ S, g⁻¹ ∈ S) (w : G → List ↥S) (k : ℕ) (ε : ℝ) (hε : 0 < ε) : ∃ r : ℕ, ∀ X : RootedIndicatorMarkovModel G ↥S, X.IsGenerated (fun i : ↥S => (i : G)) w → X.IsRootedAtRadius w r → ‖((permutationMarkov X.generator)^[k + 1]) (indicatorVector X.indicator) - ((permutationMarkov X.generator)^[k]) (indicatorVector X.indicator)‖ ≤ (kazhdanMarkovContractionFactor P S ^ k + ε) * ‖permutationMarkov X.generator (indicatorVector X.indicator) - indicatorVector X.indicator‖"},{"kind":"theorem","name":"mem_modelMultiplicationBad","statement":"{G : Type*} [Group G] (M : SoficGroups.PermutationModel G) (g h : G) (x : Fin M.size) : x ∈ modelMultiplicationBad M g h ↔ M.action (g * h) x ≠ (M.action g * M.action h) x"},{"kind":"theorem","name":"modelMultiplicationBad_density_tendsto_zero","statement":"{G : Type*} [Group G] (A : SoficGroups.SoficApproximation G) (g h : G) : Tendsto (fun n => ((modelMultiplicationBad (A.model n) g h).card : ℝ) / (A.model n).size) atTop (𝓝 0)"},{"kind":"theorem","name":"mem_modelSeparationBad","statement":"{G : Type*} [Group G] (M : SoficGroups.PermutationModel G) (g h : G) (x : Fin M.size) : x ∈ modelSeparationBad M g h ↔ M.action g x = M.action h x"},{"kind":"theorem","name":"modelSeparationBad_density_tendsto_zero","statement":"{G : Type*} [Group G] (A : SoficGroups.SoficApproximation G) {g h : G} (hne : g ≠ h) : Tendsto (fun n => ((modelSeparationBad (A.model n) g h).card : ℝ) / (A.model n).size) atTop (𝓝 0)"},{"kind":"theorem","name":"finiteMultiplicationBad_density_tendsto_zero","statement":"{G : Type*} [Group G] (A : SoficGroups.SoficApproximation G) (F : Finset G) : Tendsto (fun n => ((finiteMultiplicationBad (A.model n) F).card : ℝ) / (A.model n).size) atTop (𝓝 0)"},{"kind":"theorem","name":"finiteSeparationBad_density_tendsto_zero","statement":"{G : Type*} [Group G] (A : SoficGroups.SoficApproximation G) (F : Finset G) : Tendsto (fun n => ((finiteSeparationBad (A.model n) F).card : ℝ) / (A.model n).size) atTop (𝓝 0)"},{"kind":"theorem","name":"finiteRootBad_density_tendsto_zero","statement":"{G : Type*} [Group G] (A : SoficGroups.SoficApproximation G) (F : Finset G) : Tendsto (fun n => ((finiteRootBad (A.model n) F).card : ℝ) / (A.model n).size) atTop (𝓝 0)"},{"kind":"theorem","name":"finiteRootBad_multiplicative","statement":"{G : Type*} [Group G] (M : SoficGroups.PermutationModel G) (F : Finset G) {g h : G} (hg : g ∈ F) (hh : h ∈ F) {x : Fin M.size} (hx : x ∉ finiteRootBad M F) : M.action (g * h) x = (M.action g * M.action h) x"},{"kind":"theorem","name":"finiteRootBad_separated","statement":"{G : Type*} [Group G] (M : SoficGroups.PermutationModel G) (F : Finset G) {g h : G} (hg : g ∈ F) (hh : h ∈ F) (hne : g ≠ h) {x : Fin M.size} (hx : x ∉ finiteRootBad M F) : M.action g x ≠ M.action h x"},{"kind":"theorem","name":"finiteRootBad_injective_word_evaluation","statement":"{G : Type*} [Group G] (M : SoficGroups.PermutationModel G) (F : Finset G) {x : Fin M.size} (hx : x ∉ finiteRootBad M F) : Set.InjOn (fun g : G => M.action g x) (↑F : Set G)"},{"kind":"theorem","name":"normalizedHamming_mul_le","statement":"{V : Type*} [Fintype V] [DecidableEq V] (p p' q q' : Equiv.Perm V) : SoficGroups.normalizedHamming (p * q) (p' * q') ≤ SoficGroups.normalizedHamming p p' + SoficGroups.normalizedHamming q q'"},{"kind":"theorem","name":"action_list_prod_tendsto","statement":"{G : Type*} [Group G] (A : SoficGroups.SoficApproximation G) (l : List G) : Tendsto (fun n => SoficGroups.normalizedHamming ((A.model n).action l.prod) ((l.map (A.model n).action).prod)) atTop (𝓝 0)"},{"kind":"theorem","name":"chosenWordEvaluation_tendsto_action","statement":"{G ι : Type*} [Group G] (A : SoficGroups.SoficApproximation G) (s : ι → G) (w : G → List ι) (hw : ∀ g, ((w g).map s).prod = g) (g : G) : Tendsto (fun n => SoficGroups.normalizedHamming ((A.model n).action g) (chosenWordEvaluation A s w n g)) atTop (𝓝 0)"},{"kind":"theorem","name":"chosenWordEvaluation_multiplicative_tendsto","statement":"{G ι : Type*} [Group G] (A : SoficGroups.SoficApproximation G) (s : ι → G) (w : G → List ι) (hw : ∀ g, ((w g).map s).prod = g) (g h : G) : Tendsto (fun n => SoficGroups.normalizedHamming (chosenWordEvaluation A s w n (g * h)) (chosenWordEvaluation A s w n g * chosenWordEvaluation A s w n h)) atTop (𝓝 0)"},{"kind":"theorem","name":"mem_chosenWordMultiplicationBad","statement":"{G ι : Type*} [Group G] (A : SoficGroups.SoficApproximation G) (s : ι → G) (w : G → List ι) (n : ℕ) (g h : G) (x : Fin (A.model n).size) : x ∈ chosenWordMultiplicationBad A s w n g h ↔ chosenWordEvaluation A s w n (g * h) x ≠ (chosenWordEvaluation A s w n g * chosenWordEvaluation A s w n h) x"},{"kind":"theorem","name":"chosenWordMultiplicationBad_density_tendsto_zero","statement":"{G ι : Type*} [Group G] (A : SoficGroups.SoficApproximation G) (s : ι → G) (w : G → List ι) (hw : ∀ g, ((w g).map s).prod = g) (g h : G) : Tendsto (fun n => ((chosenWordMultiplicationBad A s w n g h).card : ℝ) / (A.model n).size) atTop (𝓝 0)"},{"kind":"theorem","name":"chosenFiniteMultiplicationBad_density_tendsto_zero","statement":"{G ι : Type*} [Group G] (A : SoficGroups.SoficApproximation G) (s : ι → G) (w : G → List ι) (hw : ∀ g, ((w g).map s).prod = g) (F : Finset G) : Tendsto (fun n => ((chosenFiniteMultiplicationBad A s w F n).card : ℝ) / (A.model n).size) atTop (𝓝 0)"},{"kind":"theorem","name":"chosenFiniteMultiplicationBad_rooted","statement":"{G ι : Type*} [Group G] (A : SoficGroups.SoficApproximation G) (s : ι → G) (w : G → List ι) (F : Finset G) (n : ℕ) {g h : G} (hg : g ∈ F) (hh : h ∈ F) {x : Fin (A.model n).size} (hx : x ∉ chosenFiniteMultiplicationBad A s w F n) : chosenWordEvaluation A s w n (g * h) x = (chosenWordEvaluation A s w n g * chosenWordEvaluation A s w n h) x"},{"kind":"theorem","name":"chosenFiniteRootBad_density_tendsto_zero","statement":"{G ι : Type*} [Group G] (A : SoficGroups.SoficApproximation G) (s : ι → G) (w : G → List ι) (hw : ∀ g, ((w g).map s).prod = g) (F : Finset G) : Tendsto (fun n => ((chosenFiniteRootBad A s w F n).card : ℝ) / (A.model n).size) atTop (𝓝 0)"},{"kind":"theorem","name":"chosenFiniteRootBad_injective_word_evaluation","statement":"{G ι : Type*} [Group G] (A : SoficGroups.SoficApproximation G) (s : ι → G) (w : G → List ι) (F : Finset G) (n : ℕ) {x : Fin (A.model n).size} (hx : x ∉ chosenFiniteRootBad A s w F n) : Set.InjOn (fun g : G => (A.model n).action g x) (↑F : Set G)"},{"kind":"theorem","name":"exists_generator_word_of_symmetric_generates","statement":"{G : Type*} [Group G] (S : Finset G) (hsymmetric : ∀ g ∈ S, g⁻¹ ∈ S) (hgenerates : Subgroup.closure (S : Set G) = ⊤) (g : G) : ∃ l : List ↥S, ((l.map fun i : ↥S => (i : G)).prod) = g"},{"kind":"theorem","name":"symmetricGeneratorWord_prod","statement":"{G : Type*} [Group G] [DecidableEq G] (S : Finset G) (hsymmetric : ∀ g ∈ S, g⁻¹ ∈ S) (hgenerates : Subgroup.closure (S : Set G) = ⊤) (g : G) : (((symmetricGeneratorWord S hsymmetric hgenerates g).map fun i : ↥S => (i : G)).prod) = g"},{"kind":"theorem","name":"symmetricGeneratorWord_one","statement":"{G : Type*} [Group G] [DecidableEq G] (S : Finset G) (hsymmetric : ∀ g ∈ S, g⁻¹ ∈ S) (hgenerates : Subgroup.closure (S : Set G) = ⊤) : symmetricGeneratorWord S hsymmetric hgenerates (1 : G) = []"},{"kind":"theorem","name":"symmetricGeneratorWord_generator","statement":"{G : Type*} [Group G] [DecidableEq G] (S : Finset G) (hsymmetric : ∀ g ∈ S, g⁻¹ ∈ S) (hgenerates : Subgroup.closure (S : Set G) = ⊤) (i : ↥S) (hi : (i : G) ≠ 1) : symmetricGeneratorWord S hsymmetric hgenerates (i : G) = [i]"},{"kind":"theorem","name":"chosen_symmetric_wordEvaluation_one","statement":"{G : Type*} [Group G] [DecidableEq G] (A : SoficGroups.SoficApproximation G) (S : Finset G) (hsymmetric : ∀ g ∈ S, g⁻¹ ∈ S) (hgenerates : Subgroup.closure (S : Set G) = ⊤) (n : ℕ) : chosenWordEvaluation A (fun i : ↥S => (i : G)) (symmetricGeneratorWord S hsymmetric hgenerates) n 1 = 1"},{"kind":"theorem","name":"chosen_symmetric_wordEvaluation_generator","statement":"{G : Type*} [Group G] [DecidableEq G] (A : SoficGroups.SoficApproximation G) (S : Finset G) (hsymmetric : ∀ g ∈ S, g⁻¹ ∈ S) (hgenerates : Subgroup.closure (S : Set G) = ⊤) (n : ℕ) (i : ↥S) : chosenWordEvaluation A (fun j : ↥S => (j : G)) (symmetricGeneratorWord S hsymmetric hgenerates) n (i : G) = (A.model n).action (i : G)"},{"kind":"theorem","name":"generator_word_prod_mem_pow","statement":"{G : Type*} [Group G] [DecidableEq G] (S : Finset G) (l : List ↥S) : ((l.map fun i : ↥S => (i : G)).prod) ∈ S ^ l.length"},{"kind":"theorem","name":"mem_generator_pow_of_chosen_word_length","statement":"{G : Type*} [Group G] [DecidableEq G] (S : Finset G) (hone : 1 ∈ S) (w : G → List ↥S) (hw : ∀ g, ((w g).map fun i : ↥S => (i : G)).prod = g) {g : G} {r : ℕ} (hgr : (w g).length ≤ r) : g ∈ S ^ r"},{"kind":"theorem","name":"chosenCayleyRadiusBad_density_tendsto_zero","statement":"{G : Type*} [Group G] [DecidableEq G] (A : SoficGroups.SoficApproximation G) (S : Finset G) (w : G → List ↥S) (hw : ∀ g, ((w g).map fun i : ↥S => (i : G)).prod = g) (r : ℕ) : Tendsto (fun n => ((chosenCayleyRadiusBad A S w n r).card : ℝ) / (A.model n).size) atTop (𝓝 0)"},{"kind":"theorem","name":"chosenCayleyRadiusBad_rooted","statement":"{G : Type*} [Group G] [DecidableEq G] (A : SoficGroups.SoficApproximation G) (S : Finset G) (hone : 1 ∈ S) (w : G → List ↥S) (hw : ∀ g, ((w g).map fun i : ↥S => (i : G)).prod = g) (n r : ℕ) (a g : G) (hword : (w a).length + (w g).length + (w (a * g)).length ≤ r) {x : Fin (A.model n).size} (hx : x ∉ chosenCayleyRadiusBad A S w n r) : chosenWordEvaluation A (fun i : ↥S => (i : G)) w n (a * g) x = (chosenWordEvaluation A (fun i : ↥S => (i : G)) w n a * chosenWordEvaluation A (fun i : ↥S => (i : G)) w n g) x"},{"kind":"theorem","name":"chosenCayleyRadiusBad_injective_ball","statement":"{G : Type*} [Group G] [DecidableEq G] (A : SoficGroups.SoficApproximation G) (S : Finset G) (w : G → List ↥S) (n r : ℕ) {x : Fin (A.model n).size} (hx : x ∉ chosenCayleyRadiusBad A S w n r) : Set.InjOn (fun g : G => (A.model n).action g x) (↑(S ^ r) : Set G)"},{"kind":"theorem","name":"sq_realIndicator_displacement","statement":"{V : Type*} [DecidableEq V] (p : Equiv.Perm V) (T : Finset V) (x : V) : (realIndicator T (p x) - realIndicator T x) ^ 2 = (if x ∈ T ∧ p x ∉ T then (1 : ℝ) else 0) + (if x ∉ T ∧ p x ∈ T then (1 : ℝ) else 0)"},{"kind":"theorem","name":"sum_sq_realIndicator_displacement","statement":"{V : Type*} [Fintype V] [DecidableEq V] (p : Equiv.Perm V) (T : Finset V) : (∑ x : V, (realIndicator T (p x) - realIndicator T x) ^ 2) = 2 * ((T.filter fun x => p x ∉ T).card : ℝ)"},{"kind":"theorem","name":"sum_sq_realIndicator_inverse_displacement","statement":"{V : Type*} [Fintype V] [DecidableEq V] (p : Equiv.Perm V) (T : Finset V) : (∑ x : V, (realIndicator T (p.symm x) - realIndicator T x) ^ 2) = 2 * ((T.filter fun x => p x ∉ T).card : ℝ)"},{"kind":"theorem","name":"sum_sum_sq_realIndicator_inverse_displacement","statement":"{V ι : Type*} [Fintype V] [Fintype ι] [DecidableEq V] (σ : ι → Equiv.Perm V) (T : Finset V) : (∑ i : ι, ∑ x : V, (realIndicator T ((σ i).symm x) - realIndicator T x) ^ 2) = 2 * (SoficGroups.boundary σ T : ℝ)"},{"kind":"theorem","name":"realPermutationMarkov_sub_sq_le_average_sq","statement":"{V ι : Type*} [Fintype ι] [Nonempty ι] (σ : ι → Equiv.Perm V) (f : V → ℝ) (x : V) : (realPermutationMarkov σ f x - f x) ^ 2 ≤ (∑ i : ι, (f ((σ i).symm x) - f x) ^ 2) / (Fintype.card ι : ℝ)"},{"kind":"theorem","name":"realPermutationMarkov_indicator_defect_sq_le_boundary","statement":"{V ι : Type*} [Fintype V] [DecidableEq V] [Fintype ι] [Nonempty ι] (σ : ι → Equiv.Perm V) (T : Finset V) : (∑ x : V, (realPermutationMarkov σ (realIndicator T) x - realIndicator T x) ^ 2) ≤ 2 * (SoficGroups.boundary σ T : ℝ) / (Fintype.card ι : ℝ)"},{"kind":"theorem","name":"realPermutationMarkov_nonneg","statement":"{V ι : Type*} [Fintype ι] (σ : ι → Equiv.Perm V) (f : V → ℝ) (hf : ∀ x, 0 ≤ f x) (x : V) : 0 ≤ realPermutationMarkov σ f x"},{"kind":"theorem","name":"realPermutationMarkov_le_one","statement":"{V ι : Type*} [Fintype ι] [Nonempty ι] (σ : ι → Equiv.Perm V) (f : V → ℝ) (hf : ∀ x, f x ≤ 1) (x : V) : realPermutationMarkov σ f x ≤ 1"},{"kind":"theorem","name":"sum_realPermutationMarkov","statement":"{V ι : Type*} [Fintype V] [Fintype ι] [Nonempty ι] (σ : ι → Equiv.Perm V) (f : V → ℝ) : (∑ x : V, realPermutationMarkov σ f x) = ∑ x : V, f x"},{"kind":"theorem","name":"realPermutationMarkov_iterate_nonneg","statement":"{V ι : Type*} [Fintype ι] (σ : ι → Equiv.Perm V) (f : V → ℝ) (hf : ∀ x, 0 ≤ f x) (k : ℕ) : ∀ x, 0 ≤ ((realPermutationMarkov σ)^[k]) f x"},{"kind":"theorem","name":"realPermutationMarkov_iterate_le_one","statement":"{V ι : Type*} [Fintype ι] [Nonempty ι] (σ : ι → Equiv.Perm V) (f : V → ℝ) (hf : ∀ x, f x ≤ 1) (k : ℕ) : ∀ x, ((realPermutationMarkov σ)^[k]) f x ≤ 1"},{"kind":"theorem","name":"sum_realPermutationMarkov_iterate","statement":"{V ι : Type*} [Fintype V] [Fintype ι] [Nonempty ι] (σ : ι → Equiv.Perm V) (f : V → ℝ) (k : ℕ) : (∑ x : V, ((realPermutationMarkov σ)^[k]) f x) = ∑ x : V, f x"},{"kind":"theorem","name":"sum_realIndicator","statement":"{V : Type*} [Fintype V] [DecidableEq V] (T : Finset V) : (∑ x : V, realIndicator T x) = (T.card : ℝ)"},{"kind":"theorem","name":"sum_realPermutationMarkov_iterate_indicator","statement":"{V ι : Type*} [Fintype V] [DecidableEq V] [Fintype ι] [Nonempty ι] (σ : ι → Equiv.Perm V) (T : Finset V) (k : ℕ) : (∑ x : V, ((realPermutationMarkov σ)^[k]) (realIndicator T) x) = (T.card : ℝ)"},{"kind":"theorem","name":"realPermutationMarkov_iterate_indicator_mem_unitInterval","statement":"{V ι : Type*} [DecidableEq V] [Fintype ι] [Nonempty ι] (σ : ι → Equiv.Perm V) (T : Finset V) (k : ℕ) (x : V) : 0 ≤ ((realPermutationMarkov σ)^[k]) (realIndicator T) x ∧ ((realPermutationMarkov σ)^[k]) (realIndicator T) x ≤ 1"},{"kind":"theorem","name":"boundary_eq_sum_indicator","statement":"{V ι : Type*} [Fintype V] [Fintype ι] [DecidableEq V] (σ : ι → Equiv.Perm V) (A : Finset V) : SoficGroups.boundary σ A = ∑ i : ι, ∑ x : V, if x ∈ A ∧ σ i x ∉ A then 1 else 0"},{"kind":"theorem","name":"boundary_eq_sum_entering_indicator","statement":"{V ι : Type*} [Fintype V] [Fintype ι] [DecidableEq V] (σ : ι → Equiv.Perm V) (A : Finset V) : SoficGroups.boundary σ A = ∑ i : ι, ∑ x : V, if x ∉ A ∧ σ i x ∈ A then 1 else 0"},{"kind":"theorem","name":"boundary_complement","statement":"{V ι : Type*} [Fintype V] [Fintype ι] [DecidableEq V] (σ : ι → Equiv.Perm V) (A : Finset V) : SoficGroups.boundary σ (Finset.univ \\ A) = SoficGroups.boundary σ A"},{"kind":"theorem","name":"boundary_le_degree_mul_card","statement":"{V ι : Type*} [Fintype ι] [DecidableEq V] (σ : ι → Equiv.Perm V) (A : Finset V) : SoficGroups.boundary σ A ≤ Fintype.card ι * A.card"},{"kind":"theorem","name":"boundary_inter_add_boundary_sdiff_le","statement":"{V ι : Type*} [Fintype V] [Fintype ι] [DecidableEq V] (σ : ι → Equiv.Perm V) (R U : Finset V) : SoficGroups.boundary σ (R ∩ U) + SoficGroups.boundary σ (R \\ U) ≤ SoficGroups.boundary σ R + 2 * SoficGroups.boundary σ U"},{"kind":"theorem","name":"exists_minimum_sparse_residual_cut","statement":"{V ι : Type*} [Fintype ι] [DecidableEq V] (σ : ι → Equiv.Perm V) (R : Finset V) (γ : ℝ) (hsparse : ∃ T : Finset V, T ⊆ R ∧ (SoficGroups.boundary σ T : ℝ) < γ * (T.card : ℝ)) : ∃ T : Finset V, T ⊆ R ∧ (SoficGroups.boundary σ T : ℝ) < γ * (T.card : ℝ) ∧ ∀ E : Finset V, E ⊆ R → (SoficGroups.boundary σ E : ℝ) < γ * (E.card : ℝ) → T.card ≤ E.card"},{"kind":"theorem","name":"close_residual_inter_properties","statement":"{V : Type*} [DecidableEq V] (R T U : Finset V) (hTR : T ⊆ R) (hclose : 3 * (U ∆ T).card < T.card) : (R ∩ U).Nonempty ∧ U.card ≤ 2 * (R ∩ U).card ∧ (R ∩ U).card < 2 * T.card"},{"kind":"theorem","name":"minimum_sparse_cut_expands_close_residual_part","statement":"{V ι : Type*} [Fintype ι] [DecidableEq V] (σ : ι → Equiv.Perm V) (R T U : Finset V) (γ : ℝ) (hTR : T ⊆ R) (hminimum : ∀ E : Finset V, E ⊆ R → (SoficGroups.boundary σ E : ℝ) < γ * (E.card : ℝ) → T.card ≤ E.card) (hclose : 3 * (U ∆ T).card < T.card) : ∀ E : Finset V, E ⊆ R ∩ U → 2 * E.card ≤ (R ∩ U).card → γ * (E.card : ℝ) ≤ (SoficGroups.boundary σ E : ℝ)"},{"kind":"theorem","name":"exists_expanding_residual_finpartition","statement":"{V ι : Type*} [Fintype V] [Fintype ι] [DecidableEq V] (σ : ι → Equiv.Perm V) (B : Finset V) (γ α : ℝ) (hα : 0 ≤ α) (himprove : ∀ T : Finset V, T ⊆ Finset.univ \\ B → (SoficGroups.boundary σ T : ℝ) < γ * (T.card : ℝ) → ∃ U : Finset V, 3 * (U ∆ T).card < T.card ∧ (SoficGroups.boundary σ U : ℝ) ≤ α * (U.card : ℝ)) (R : Finset V) (hRB : R ⊆ Finset.univ \\ B) : ∃ P : Finpartition R, (∀ C ∈ P.parts, ∀ E : Finset V, E ⊆ C → 2 * E.card ≤ C.card → γ * (E.card : ℝ) ≤ (SoficGroups.boundary σ E : ℝ)) ∧ (∑ C ∈ P.parts, (SoficGroups.boundary σ C : ℝ)) ≤ (SoficGroups.boundary σ R : ℝ) + 4 * α * (R.card : ℝ)"},{"kind":"theorem","name":"exists_expanding_clean_finpartition","statement":"{V ι : Type*} [Fintype V] [Fintype ι] [DecidableEq V] (σ : ι → Equiv.Perm V) (B : Finset V) (γ α : ℝ) (hα : 0 ≤ α) (himprove : ∀ T : Finset V, T ⊆ Finset.univ \\ B → (SoficGroups.boundary σ T : ℝ) < γ * (T.card : ℝ) → ∃ U : Finset V, 3 * (U ∆ T).card < T.card ∧ (SoficGroups.boundary σ U : ℝ) ≤ α * (U.card : ℝ)) : ∃ P : Finpartition (Finset.univ \\ B), (∀ C ∈ P.parts, ∀ E : Finset V, E ⊆ C → 2 * E.card ≤ C.card → γ * (E.card : ℝ) ≤ (SoficGroups.boundary σ E : ℝ)) ∧ (∑ C ∈ P.parts, (SoficGroups.boundary σ C : ℝ)) ≤ (Fintype.card ι : ℝ) * (B.card : ℝ) + 4 * α * ((Finset.univ \\ B).card : ℝ)"},{"kind":"theorem","name":"completeCleanFinpartition_parts","statement":"{V : Type*} [Fintype V] [DecidableEq V] (B : Finset V) (P : Finpartition (Finset.univ \\ B)) : (completeCleanFinpartition B P).parts = P.parts ∪ (⊥ : Finpartition B).parts"},{"kind":"theorem","name":"disjoint_clean_parts_singleton_bad_parts","statement":"{V : Type*} [Fintype V] [DecidableEq V] (B : Finset V) (P : Finpartition (Finset.univ \\ B)) : Disjoint P.parts (⊥ : Finpartition B).parts"},{"kind":"theorem","name":"sum_singleton_bad_boundary_le","statement":"{V ι : Type*} [Fintype ι] [DecidableEq V] (σ : ι → Equiv.Perm V) (B : Finset V) : (∑ C ∈ (⊥ : Finpartition B).parts, (SoficGroups.boundary σ C : ℝ)) ≤ (Fintype.card ι : ℝ) * (B.card : ℝ)"},{"kind":"theorem","name":"completeCleanFinpartition_half_expansion","statement":"{V ι : Type*} [Fintype V] [Fintype ι] [DecidableEq V] (σ : ι → Equiv.Perm V) (B : Finset V) (P : Finpartition (Finset.univ \\ B)) (γ : ℝ) (hexpand : ∀ C ∈ P.parts, ∀ E : Finset V, E ⊆ C → 2 * E.card ≤ C.card → γ * (E.card : ℝ) ≤ (SoficGroups.boundary σ E : ℝ)) : ∀ C ∈ (completeCleanFinpartition B P).parts, ∀ E : Finset V, E ⊆ C → 2 * E.card ≤ C.card → γ * (E.card : ℝ) ≤ (SoficGroups.boundary σ E : ℝ)"},{"kind":"theorem","name":"exists_expanding_full_finpartition","statement":"{V ι : Type*} [Fintype V] [Fintype ι] [DecidableEq V] (σ : ι → Equiv.Perm V) (B : Finset V) (γ α : ℝ) (hα : 0 ≤ α) (himprove : ∀ T : Finset V, T ⊆ Finset.univ \\ B → (SoficGroups.boundary σ T : ℝ) < γ * (T.card : ℝ) → ∃ U : Finset V, 3 * (U ∆ T).card < T.card ∧ (SoficGroups.boundary σ U : ℝ) ≤ α * (U.card : ℝ)) : ∃ P : Finpartition (Finset.univ : Finset V), (∀ C ∈ P.parts, ∀ E : Finset V, E ⊆ C → 2 * E.card ≤ C.card → γ * (E.card : ℝ) ≤ (SoficGroups.boundary σ E : ℝ)) ∧ (∑ C ∈ P.parts, (SoficGroups.boundary σ C : ℝ)) ≤ 2 * (Fintype.card ι : ℝ) * (B.card : ℝ) + 4 * α * (Fintype.card V : ℝ)"},{"kind":"theorem","name":"exists_expanding_full_finpartition_sequence","statement":"(ι : Type*) [Fintype ι] (V : ℕ → Type*) [∀ n, Fintype (V n)] [∀ n, Nonempty (V n)] [∀ n, DecidableEq (V n)] (σ : (n : ℕ) → ι → Equiv.Perm (V n)) (B : (n : ℕ) → Finset (V n)) (γ : ℝ) (hγ : 0 < γ) (α : ℕ → ℝ) (hα : ∀ n, 0 ≤ α n) (hαzero : Tendsto α atTop (nhds 0)) (hbad : Tendsto (fun n => ((B n).card : ℝ) / Fintype.card (V n)) atTop (nhds 0)) (himprove : ∀ n (T : Finset (V n)), T ⊆ Finset.univ \\ B n → (SoficGroups.boundary (σ n) T : ℝ) < γ * (T.card : ℝ) → ∃ U : Finset (V n), 3 * (U ∆ T).card < T.card ∧ (SoficGroups.boundary (σ n) U : ℝ) ≤ α n * (U.card : ℝ)) : ∃ P : (n : ℕ) → Finpartition (Finset.univ : Finset (V n)), 0 < γ ∧ (∀ n, ∀ C ∈ (P n).parts, ∀ E : Finset (V n), E ⊆ C → 2 * E.card ≤ C.card → γ * (E.card : ℝ) ≤ (SoficGroups.boundary (σ n) E : ℝ)) ∧ Tendsto (fun n => (∑ C ∈ (P n).parts, (SoficGroups.boundary (σ n) C : ℝ)) / Fintype.card (V n)) atTop (nhds 0)"},{"kind":"theorem","name":"original_boundary_le_completed_add_component_boundary","statement":"{V ι : Type*} [Fintype ι] [DecidableEq V] (σ : ι → Equiv.Perm V) (C : Finset V) (τ : ι → Equiv.Perm {x : V // x ∈ C}) (hτ : ∀ i (x : V) (hx : x ∈ C) (_hy : σ i x ∈ C), ((τ i ⟨x, hx⟩ : {x : V // x ∈ C}) : V) = σ i x) (A : Finset {x : V // x ∈ C}) : SoficGroups.boundary σ (A.map (Function.Embedding.subtype (fun x : V => x ∈ C))) ≤ SoficGroups.boundary τ A + SoficGroups.boundary σ C"},{"kind":"theorem","name":"completed_component_additive_expansion","statement":"{V ι : Type*} [Fintype ι] [DecidableEq V] (σ : ι → Equiv.Perm V) (C : Finset V) (τ : ι → Equiv.Perm {x : V // x ∈ C}) (hτ : ∀ i (x : V) (hx : x ∈ C) (_hy : σ i x ∈ C), ((τ i ⟨x, hx⟩ : {x : V // x ∈ C}) : V) = σ i x) (γ : ℝ) (hexpand : ∀ E : Finset V, E ⊆ C → 2 * E.card ≤ C.card → γ * (E.card : ℝ) ≤ (SoficGroups.boundary σ E : ℝ)) : ∀ A : Finset {x : V // x ∈ C}, γ * min (A.card : ℝ) ((C.card : ℝ) - A.card) - (SoficGroups.boundary σ C : ℝ) ≤ (SoficGroups.boundary τ A : ℝ)"},{"kind":"theorem","name":"goodPermutationGraph_subset","statement":"{V : Type*} [Fintype V] [DecidableEq V] (p : Equiv.Perm V) (B : Finset V) : goodPermutationGraph p B ⊆ SoficGroups.permutationGraph p"},{"kind":"theorem","name":"card_filter_permutationGraph_fst_mem","statement":"{V : Type*} [Fintype V] [DecidableEq V] (p : Equiv.Perm V) (B : Finset V) : ((SoficGroups.permutationGraph p).filter fun z => z.1 ∈ B).card = B.card"},{"kind":"theorem","name":"card_filter_permutationGraph_snd_mem","statement":"{V : Type*} [Fintype V] [DecidableEq V] (p : Equiv.Perm V) (B : Finset V) : ((SoficGroups.permutationGraph p).filter fun z => z.2 ∈ B).card = B.card"},{"kind":"theorem","name":"permutationGraph_sdiff_goodPermutationGraph_subset","statement":"{V : Type*} [Fintype V] [DecidableEq V] (p : Equiv.Perm V) (B : Finset V) : SoficGroups.permutationGraph p \\ goodPermutationGraph p B ⊆ ((SoficGroups.permutationGraph p).filter fun z => z.1 ∈ B) ∪ ((SoficGroups.permutationGraph p).filter fun z => z.2 ∈ B)"},{"kind":"theorem","name":"card_permutationGraph_sdiff_goodPermutationGraph_le","statement":"{V : Type*} [Fintype V] [DecidableEq V] (p : Equiv.Perm V) (B : Finset V) : (SoficGroups.permutationGraph p \\ goodPermutationGraph p B).card ≤ 2 * B.card"},{"kind":"theorem","name":"card_goodPermutationGraph_add_graph_loss","statement":"{V : Type*} [Fintype V] [DecidableEq V] (p : Equiv.Perm V) (B : Finset V) : (SoficGroups.permutationGraph p \\ goodPermutationGraph p B).card + (goodPermutationGraph p B).card = Fintype.card V"},{"kind":"theorem","name":"card_goodPermutationGraph_ge_card_sub_twice_bad","statement":"{V : Type*} [Fintype V] [DecidableEq V] (p : Equiv.Perm V) (B : Finset V) : (Fintype.card V : ℝ) - 2 * (B.card : ℝ) ≤ ((goodPermutationGraph p B).card : ℝ)"},{"kind":"theorem","name":"boundary_goodPermutationGraph_le_commutationDefect_add","statement":"{V ι : Type*} [Fintype V] [Fintype ι] [DecidableEq V] (σ : ι → Equiv.Perm V) (p : Equiv.Perm V) (B : Finset V) : SoficGroups.boundary (fun i => (σ i).prodCongr (σ i)) (goodPermutationGraph p B) ≤ SoficGroups.permutationCommutationDefect σ p + 2 * Fintype.card ι * B.card"},{"kind":"theorem","name":"hasAlmostCentralizerImprovement_zero","statement":"{V ι : Type*} [Fintype V] [Fintype ι] [DecidableEq V] (σ : ι → Equiv.Perm V) : SoficGroups.HasAlmostCentralizerImprovement σ 0"},{"kind":"theorem","name":"boundary_complement","statement":"{V ι : Type*} [Fintype V] [Fintype ι] [DecidableEq V] (σ : ι → Equiv.Perm V) (A : Finset V) : SoficGroups.boundary σ (Finset.univ \\ A) = SoficGroups.boundary σ A"},{"kind":"theorem","name":"boundary_expansion_of_half","statement":"{V ι : Type*} [Fintype V] [Fintype ι] [DecidableEq V] (σ : ι → Equiv.Perm V) (h : ℝ) (hhalf : ∀ A : Finset V, 2 * A.card ≤ Fintype.card V → h * (A.card : ℝ) ≤ (SoficGroups.boundary σ A : ℝ)) : ∀ A : Finset V, h * min (A.card : ℝ) ((Fintype.card V : ℝ) - A.card) ≤ (SoficGroups.boundary σ A : ℝ)"},{"kind":"theorem","name":"inducedBoundary_le_completed_boundary","statement":"{V ι : Type*} [Fintype V] [Fintype ι] [DecidableEq V] (σ : ι → Equiv.Perm V) (B Z : Finset V) (hZ : Z = Finset.univ \\ B) (τ : ι → Equiv.Perm {x : V // x ∈ Z}) (hτ : ∀ i (x : V) (hx : x ∈ Z) (_hy : σ i x ∈ Z), ((τ i ⟨x, hx⟩ : {x : V // x ∈ Z}) : V) = σ i x) (A : Finset {x : V // x ∈ Z}) : SoficGroups.inducedBoundary σ B (A.map (Function.Embedding.subtype (fun x : V => x ∈ Z))) ≤ SoficGroups.boundary τ A"},{"kind":"theorem","name":"exists_completed_pruned_expander","statement":"{V ι : Type*} [Fintype V] [Fintype ι] [DecidableEq V] (σ : ι → Equiv.Perm V) (γ ell a : ℝ) (hgap : ell < γ) (hadd : ∀ A : Finset V, γ * min (A.card : ℝ) ((Fintype.card V : ℝ) - (A.card : ℝ)) - a * (Fintype.card V : ℝ) ≤ (SoficGroups.boundary σ A : ℝ)) (hsmall : 2 * a * (2 * (γ - ell) + (Fintype.card ι : ℝ)) ≤ (γ - ell) ^ 2) : ∃ (B : Finset V) (τ : ι → Equiv.Perm {x : V // x ∈ (Finset.univ \\ B)}), 2 * B.card ≤ Fintype.card V ∧ (B.card : ℝ) ≤ a * (Fintype.card V : ℝ) / (γ - ell) ∧ (∀ i (x : V) (hx : x ∈ Finset.univ \\ B) (_hy : σ i x ∈ Finset.univ \\ B), ((τ i ⟨x, hx⟩ : {x : V // x ∈ Finset.univ \\ B}) : V) = σ i x) ∧ ∀ A : Finset {x : V // x ∈ Finset.univ \\ B}, ell * min (A.card : ℝ) ((Fintype.card {x : V // x ∈ Finset.univ \\ B} : ℝ) - A.card) ≤ (SoficGroups.boundary τ A : ℝ)"},{"kind":"theorem","name":"completedRestriction_apply_of_mem","statement":"{V : Type*} [Fintype V] (p : Equiv.Perm V) (Z : Finset V) (x : V) (hx : x ∈ Z) (hp : p x ∈ Z) : ((completedRestriction p Z ⟨x, hx⟩ : {x : V // x ∈ Z}) : V) = p x"},{"kind":"theorem","name":"card_subtypeBad","statement":"{V : Type*} [DecidableEq V] (Z E : Finset V) : (subtypeBad Z E).card = (Z ∩ E).card"},{"kind":"theorem","name":"permutationDistance_le_subtypeBad","statement":"{V : Type*} [DecidableEq V] (Z E : Finset V) (p q : Equiv.Perm {x : V // x ∈ Z}) (hagrees : ∀ x : {x : V // x ∈ Z}, (x : V) ∉ E → p x = q x) : SoficGroups.permutationDistance p q ≤ (subtypeBad Z E).card"},{"kind":"theorem","name":"card_lt_five_mul_permutationDistance_of_subtypeBad","statement":"{V : Type*} [DecidableEq V] (Z E : Finset V) (hZ : Z.Nonempty) (p q : Equiv.Perm {x : V // x ∈ Z}) (hbad : 5 * (subtypeBad Z E).card ≤ Fintype.card {x : V // x ∈ Z}) (hseparated : ∀ x : {x : V // x ∈ Z}, (x : V) ∉ E → p x ≠ q x) : Fintype.card {x : V // x ∈ Z} < 5 * SoficGroups.permutationDistance p q"},{"kind":"theorem","name":"sourceCompletionBad_subset","statement":"{V ι J : Type*} [DecidableEq V] [Fintype ι] [Group J] (σ : ι → Equiv.Perm V) (p : J → Equiv.Perm V) (F : Finset J) (Z : Finset V) : sourceCompletionBad σ p F Z ⊆ Z"},{"kind":"theorem","name":"card_subtype_sourceCompletionBad","statement":"{V ι J : Type*} [DecidableEq V] [Fintype ι] [Group J] (σ : ι → Equiv.Perm V) (p : J → Equiv.Perm V) (F : Finset J) (Z : Finset V) : (subtypeBad Z (sourceCompletionBad σ p F Z)).card = (sourceCompletionBad σ p F Z).card"},{"kind":"theorem","name":"sourceCompletionBad_good","statement":"{V ι J : Type*} [DecidableEq V] [Fintype ι] [Group J] (σ : ι → Equiv.Perm V) (p : J → Equiv.Perm V) (F : Finset J) (Z : Finset V) (x : V) (hx : x ∈ Z) (hgood : x ∉ sourceCompletionBad σ p F Z) : (∀ i, σ i x ∈ Z) ∧ (∀ j ∈ SoficGroups.CompressionCriterion.productTrackedTable F, p j x ∈ Z) ∧ (∀ i, ∀ j ∈ SoficGroups.CompressionCriterion.productTrackedTable F, p j (σ i x) = σ i (p j x)) ∧ (∀ i, ∀ j ∈ SoficGroups.CompressionCriterion.productTrackedTable F, p j (σ i x) ∈ Z) ∧ (∀ j ∈ F, ∀ k ∈ F, p (j * k) x = p j (p k x)) ∧ (∀ j ∈ F, ∀ k ∈ F, j ≠ k → p j x ≠ p k x)"},{"kind":"theorem","name":"completedRestriction_mul_of_not_mem_sourceCompletionBad","statement":"{V ι J : Type*} [Fintype V] [DecidableEq V] [Fintype ι] [Group J] (σ : ι → Equiv.Perm V) (p : J → Equiv.Perm V) (F : Finset J) (Z : Finset V) {j k : J} (hj : j ∈ F) (hk : k ∈ F) (z : {x : V // x ∈ Z}) (hz : (z : V) ∉ sourceCompletionBad σ p F Z) : completedRestriction (p (j * k)) Z z = (completedRestriction (p j) Z * completedRestriction (p k) Z) z"},{"kind":"theorem","name":"completedRestriction_ne_of_not_mem_sourceCompletionBad","statement":"{V ι J : Type*} [Fintype V] [DecidableEq V] [Fintype ι] [Group J] (σ : ι → Equiv.Perm V) (p : J → Equiv.Perm V) (F : Finset J) (Z : Finset V) {j k : J} (hj : j ∈ F) (hk : k ∈ F) (hne : j ≠ k) (z : {x : V // x ∈ Z}) (hz : (z : V) ∉ sourceCompletionBad σ p F Z) : completedRestriction (p j) Z z ≠ completedRestriction (p k) Z z"},{"kind":"theorem","name":"completedRestriction_commute_of_not_mem_sourceCompletionBad","statement":"{V ι J : Type*} [Fintype V] [DecidableEq V] [Fintype ι] [Group J] (σ : ι → Equiv.Perm V) (p : J → Equiv.Perm V) (F : Finset J) (Z : Finset V) (σZ : ι → Equiv.Perm {x : V // x ∈ Z}) (hσZ : ∀ i (x : V) (hx : x ∈ Z) (_hi : σ i x ∈ Z), ((σZ i ⟨x, hx⟩ : {x : V // x ∈ Z}) : V) = σ i x) {j : J} (hj : j ∈ SoficGroups.CompressionCriterion.productTrackedTable F) (i : ι) (z : {x : V // x ∈ Z}) (hz : (z : V) ∉ sourceCompletionBad σ p F Z) : completedRestriction (p j) Z (σZ i z) = σZ i (completedRestriction (p j) Z z)"},{"kind":"theorem","name":"completedRestriction_mul_distance_le_sourceCompletionBad","statement":"{V ι J : Type*} [Fintype V] [DecidableEq V] [Fintype ι] [Group J] (σ : ι → Equiv.Perm V) (p : J → Equiv.Perm V) (F : Finset J) (Z : Finset V) {j k : J} (hj : j ∈ F) (hk : k ∈ F) : SoficGroups.permutationDistance (completedRestriction (p (j * k)) Z) (completedRestriction (p j) Z * completedRestriction (p k) Z) ≤ (sourceCompletionBad σ p F Z).card"},{"kind":"theorem","name":"completedRestriction_separated_of_sourceCompletionBad","statement":"{V ι J : Type*} [Fintype V] [DecidableEq V] [Fintype ι] [Group J] (σ : ι → Equiv.Perm V) (p : J → Equiv.Perm V) (F : Finset J) (Z : Finset V) (hZ : Z.Nonempty) (hbad : 5 * (sourceCompletionBad σ p F Z).card ≤ Z.card) {j k : J} (hj : j ∈ F) (hk : k ∈ F) (hne : j ≠ k) : Fintype.card {x : V // x ∈ Z} < 5 * SoficGroups.permutationDistance (completedRestriction (p j) Z) (completedRestriction (p k) Z)"},{"kind":"theorem","name":"completedRestriction_commutationDefect_le_sourceCompletionBad","statement":"{V ι J : Type*} [Fintype V] [DecidableEq V] [Fintype ι] [Group J] (σ : ι → Equiv.Perm V) (p : J → Equiv.Perm V) (F : Finset J) (Z : Finset V) (σZ : ι → Equiv.Perm {x : V // x ∈ Z}) (hσZ : ∀ i (x : V) (hx : x ∈ Z) (_hi : σ i x ∈ Z), ((σZ i ⟨x, hx⟩ : {x : V // x ∈ Z}) : V) = σ i x) {j : J} (hj : j ∈ SoficGroups.CompressionCriterion.productTrackedTable F) : SoficGroups.permutationCommutationDefect σZ (completedRestriction (p j) Z) ≤ Fintype.card ι * (sourceCompletionBad σ p F Z).card"},{"kind":"theorem","name":"card_permutation_exit_le_deleted","statement":"{V : Type*} [Fintype V] [DecidableEq V] (p : Equiv.Perm V) (Z : Finset V) : (Z.filter fun x => p x ∉ Z).card ≤ (Finset.univ \\ Z).card"},{"kind":"theorem","name":"card_composite_exit_le_deleted","statement":"{V : Type*} [Fintype V] [DecidableEq V] (p q : Equiv.Perm V) (Z : Finset V) : (Z.filter fun x => p (q x) ∉ Z).card ≤ (Finset.univ \\ Z).card"},{"kind":"theorem","name":"card_biUnion_permutation_exit_le","statement":"{V ι : Type*} [Fintype V] [DecidableEq V] (I : Finset ι) (p : ι → Equiv.Perm V) (Z : Finset V) : (I.biUnion fun i => Z.filter fun x => p i x ∉ Z).card ≤ I.card * (Finset.univ \\ Z).card"},{"kind":"theorem","name":"card_biUnion_composite_exit_le","statement":"{V ι κ : Type*} [Fintype V] [DecidableEq V] (I : Finset ι) (K : Finset κ) (p : ι → Equiv.Perm V) (q : κ → Equiv.Perm V) (Z : Finset V) : (I.biUnion fun i => K.biUnion fun k => Z.filter fun x => q k (p i x) ∉ Z).card ≤ I.card * K.card * (Finset.univ \\ Z).card"},{"kind":"theorem","name":"sourceCompletionBad_subset_exit_union_wordBad","statement":"{V ι J : Type*} [Fintype V] [DecidableEq V] [Fintype ι] [Group J] (σ : ι → Equiv.Perm V) (p : J → Equiv.Perm V) (F : Finset J) (Z : Finset V) : SoficGroups.MatchedComponentCompletion.sourceCompletionBad σ p F Z ⊆ (Finset.univ.biUnion fun i : ι => Z.filter fun z => σ i z ∉ Z) ∪ ((SoficGroups.CompressionCriterion.productTrackedTable F).biUnion fun j => Z.filter fun z => p j z ∉ Z) ∪ (Finset.univ.biUnion fun i : ι => (SoficGroups.CompressionCriterion.productTrackedTable F).biUnion fun j => Z.filter fun z => p j (σ i z) ∉ Z) ∪ sourceWordTestBad σ p F"},{"kind":"theorem","name":"card_sourceCompletionBad_le_deleted_add_wordBad","statement":"{V ι J : Type*} [Fintype V] [DecidableEq V] [Fintype ι] [Group J] (σ : ι → Equiv.Perm V) (p : J → Equiv.Perm V) (F : Finset J) (Z : Finset V) : (SoficGroups.MatchedComponentCompletion.sourceCompletionBad σ p F Z).card ≤ (Fintype.card ι + (SoficGroups.CompressionCriterion.productTrackedTable F).card + Fintype.card ι * (SoficGroups.CompressionCriterion.productTrackedTable F).card) * (Finset.univ \\ Z).card + (sourceWordTestBad σ p F).card"},{"kind":"theorem","name":"sourceCompletionBad_subset_survivors","statement":"{V ι J : Type*} [DecidableEq V] [Fintype ι] [Group J] (σ : ι → Equiv.Perm V) (p : J → Equiv.Perm V) (F : Finset J) (Z : Finset V) : SoficGroups.MatchedComponentCompletion.sourceCompletionBad σ p F Z ⊆ Z"},{"kind":"theorem","name":"sourceCompletionBad_original_density_tendsto_zero","statement":"(V : ℕ → Type*) [∀ n, Fintype (V n)] [∀ n, DecidableEq (V n)] {ι J : Type*} [Fintype ι] [Group J] (σ : (n : ℕ) → ι → Equiv.Perm (V n)) (p : (n : ℕ) → J → Equiv.Perm (V n)) (F : Finset J) (B : (n : ℕ) → Finset (V n)) (hdeleted : Tendsto (fun n => ((B n).card : ℝ) / Fintype.card (V n)) atTop (nhds 0)) (hword : Tendsto (fun n => ((sourceWordTestBad (σ n) (p n) F).card : ℝ) / Fintype.card (V n)) atTop (nhds 0)) : Tendsto (fun n => ((SoficGroups.MatchedComponentCompletion.sourceCompletionBad (σ n) (p n) F (Finset.univ \\ B n)).card : ℝ) / Fintype.card (V n)) atTop (nhds 0)"},{"kind":"theorem","name":"sourceCompletionBad_surviving_density_tendsto_zero","statement":"(V : ℕ → Type*) [∀ n, Fintype (V n)] [∀ n, DecidableEq (V n)] {ι J : Type*} [Fintype ι] [Group J] (σ : (n : ℕ) → ι → Equiv.Perm (V n)) (p : (n : ℕ) → J → Equiv.Perm (V n)) (F : Finset J) (B : (n : ℕ) → Finset (V n)) (hZ : ∀ n, (Finset.univ \\ B n : Finset (V n)).Nonempty) (hdeleted : Tendsto (fun n => ((B n).card : ℝ) / Fintype.card (V n)) atTop (nhds 0)) (hword : Tendsto (fun n => ((sourceWordTestBad (σ n) (p n) F).card : ℝ) / Fintype.card (V n)) atTop (nhds 0)) : Tendsto (fun n => ((SoficGroups.MatchedComponentCompletion.sourceCompletionBad (σ n) (p n) F (Finset.univ \\ B n)).card : ℝ) / (Finset.univ \\ B n : Finset (V n)).card) atTop (nhds 0)"},{"kind":"theorem","name":"pruned_component_card_tendsto_atTop","statement":"(V : ℕ → Type*) [∀ n, Fintype (V n)] [∀ n, DecidableEq (V n)] (B : (n : ℕ) → Finset (V n)) (hsize : Tendsto (fun n => Fintype.card (V n)) atTop atTop) (hdeleted : Tendsto (fun n => ((B n).card : ℝ) / Fintype.card (V n)) atTop (nhds 0)) : Tendsto (fun n => (Finset.univ \\ B n : Finset (V n)).card) atTop atTop"},{"kind":"theorem","name":"indicatorVector_apply","statement":"{V : Type*} (f : V → ℝ) (x : V) : indicatorVector f x = (f x : ℂ)"},{"kind":"theorem","name":"permutationMarkov_apply","statement":"{ι V : Type*} [Fintype ι] [Fintype V] (p : ι → Equiv.Perm V) (ξ : EuclideanSpace ℂ V) (x : V) : permutationMarkov p ξ x = (∑ i, ξ ((p i).symm x)) / (Fintype.card ι : ℂ)"},{"kind":"theorem","name":"indicatorVector_realMarkov","statement":"{ι V : Type*} [Fintype ι] [Fintype V] (p : ι → Equiv.Perm V) (f : V → ℝ) : indicatorVector (realMarkov p f) = permutationMarkov p (indicatorVector f)"},{"kind":"theorem","name":"indicatorVector_iterate_realMarkov","statement":"{ι V : Type*} [Fintype ι] [Fintype V] (p : ι → Equiv.Perm V) (f : V → ℝ) (k : ℕ) : indicatorVector (((realMarkov p)^[k]) f) = ((permutationMarkov p)^[k]) (indicatorVector f)"},{"kind":"theorem","name":"norm_indicatorVector_sub_sq","statement":"{V : Type*} [Fintype V] (f g : V → ℝ) : ‖indicatorVector f - indicatorVector g‖ ^ 2 = ∑ x, (f x - g x) ^ 2"},{"kind":"theorem","name":"norm_permutationMarkov_indicator_sub_sq","statement":"{ι V : Type*} [Fintype ι] [Fintype V] (p : ι → Equiv.Perm V) (f : V → ℝ) : ‖permutationMarkov p (indicatorVector f) - indicatorVector f‖ ^ 2 = ∑ x, (realMarkov p f x - f x) ^ 2"},{"kind":"theorem","name":"norm_iterate_permutationMarkov_indicator_sub_sq","statement":"{ι V : Type*} [Fintype ι] [Fintype V] (p : ι → Equiv.Perm V) (f : V → ℝ) (k : ℕ) : ‖((permutationMarkov p)^[k]) (indicatorVector f) - indicatorVector f‖ ^ 2 = ∑ x, ((((realMarkov p)^[k]) f) x - f x) ^ 2"},{"kind":"theorem","name":"norm_iterate_permutationMarkov_indicator_sub_iterate_sq","statement":"{ι V : Type*} [Fintype ι] [Fintype V] (p : ι → Equiv.Perm V) (f : V → ℝ) (k : ℕ) : ‖((permutationMarkov p)^[k + 1]) (indicatorVector f) - ((permutationMarkov p)^[k]) (indicatorVector f)‖ ^ 2 = ∑ x, ((((realMarkov p)^[k + 1]) f) x - (((realMarkov p)^[k]) f) x) ^ 2"},{"kind":"theorem","name":"RootedIndicatorMarkovModel.IsRootedAtRadius.mono","statement":"{G ι : Type u} [Group G] {X : RootedIndicatorMarkovModel G ι} {w : G → List ι} {r R : ℕ} (h : X.IsRootedAtRadius w R) (hr : r ≤ R) : X.IsRootedAtRadius w r"},{"kind":"theorem","name":"exists_rooted_word_radius_all_markov_iterate_contractions","statement":"{G : Type u} [Group G] (P : SoficGroups.KazhdanPair.{u, u} G) (S : Finset G) (honeS : 1 ∈ S) (hcover : P.generators ⊆ S) (hsymmetric : ∀ g ∈ S, g⁻¹ ∈ S) (w : G → List ↥S) (k : ℕ) (ε : ℝ) (hε : 0 < ε) : ∃ r : ℕ, ∀ X : RootedIndicatorMarkovModel G ↥S, X.IsGenerated (fun i : ↥S => (i : G)) w → X.IsRootedAtRadius w r → ∀ j ≤ k, ‖((permutationMarkov X.generator)^[j + 1]) (indicatorVector X.indicator) - ((permutationMarkov X.generator)^[j]) (indicatorVector X.indicator)‖ ≤ (kazhdanMarkovContractionFactor P S ^ j + ε) * ‖permutationMarkov X.generator (indicatorVector X.indicator) - indicatorVector X.indicator‖"},{"kind":"theorem","name":"norm_iterate_sub_le_sum_successive","statement":"{E : Type*} [NormedAddCommGroup E] (F : E → E) (x : E) (k : ℕ) : ‖(F^[k]) x - x‖ ≤ ∑ j ∈ Finset.range k, ‖(F^[j + 1]) x - (F^[j]) x‖"},{"kind":"theorem","name":"sum_geometric_budget_le","statement":"(q : ℝ) (hqzero : 0 ≤ q) (hqone : q < 1) (k : ℕ) : (∑ j ∈ Finset.range k, (q ^ j + (((k + 1 : ℕ) : ℝ) * (1 - q))⁻¹)) ≤ 2 / (1 - q)"},{"kind":"theorem","name":"exists_rooted_word_radius_geometric_markov_displacement","statement":"{G : Type u} [Group G] (P : SoficGroups.KazhdanPair.{u, u} G) (S : Finset G) (honeS : 1 ∈ S) (hcover : P.generators ⊆ S) (hsymmetric : ∀ g ∈ S, g⁻¹ ∈ S) (w : G → List ↥S) (k : ℕ) : ∃ r : ℕ, ∀ X : RootedIndicatorMarkovModel G ↥S, X.IsGenerated (fun i : ↥S => (i : G)) w → X.IsRootedAtRadius w r → ‖((permutationMarkov X.generator)^[k]) (indicatorVector X.indicator) - indicatorVector X.indicator‖ ≤ (2 / (1 - kazhdanMarkovContractionFactor P S)) * ‖permutationMarkov X.generator (indicatorVector X.indicator) - indicatorVector X.indicator‖"},{"kind":"theorem","name":"rooted_realMarkov_eq_mass_realPermutationMarkov","statement":"{ι V : Type*} [Fintype ι] (p : ι → Equiv.Perm V) : SoficGroups.KunRealComplexMarkovBridge.realMarkov p = SoficGroups.KunFinitePermutationMarkovMass.realPermutationMarkov p"},{"kind":"theorem","name":"rooted_markov_real_iterate_sq_error","statement":"{ι V : Type*} [Fintype ι] [Fintype V] [DecidableEq V] (p : ι → Equiv.Perm V) (T : Finset V) (k : ℕ) : ‖((permutationMarkov p)^[k]) (indicatorVector (SoficGroups.KunFinitePermutationMarkovMass.realIndicator T)) - indicatorVector (SoficGroups.KunFinitePermutationMarkovMass.realIndicator T)‖ ^ 2 = ∑ x : V, ((((SoficGroups.KunFinitePermutationMarkovMass.realPermutationMarkov p)^[k]) (SoficGroups.KunFinitePermutationMarkovMass.realIndicator T)) x - if x ∈ T then (1 : ℝ) else 0) ^ 2"},{"kind":"theorem","name":"rooted_indicator_defect_sq_le_boundary","statement":"{ι V : Type*} [Fintype ι] [Nonempty ι] [Fintype V] [DecidableEq V] (p : ι → Equiv.Perm V) (T : Finset V) : ‖permutationMarkov p (indicatorVector (SoficGroups.KunFinitePermutationMarkovMass.realIndicator T)) - indicatorVector (SoficGroups.KunFinitePermutationMarkovMass.realIndicator T)‖ ^ 2 ≤ 2 * (SoficGroups.boundary p T : ℝ) / (Fintype.card ι : ℝ)"},{"kind":"theorem","name":"sourceRootedIndicatorMarkovModel_isGenerated","statement":"{G : Type} [Group G] [DecidableEq G] (A : SoficGroups.SoficApproximation G) (S : Finset G) (hsymmetric : ∀ g ∈ S, g⁻¹ ∈ S) (hgenerates : Subgroup.closure (S : Set G) = ⊤) (n : ℕ) (T : Finset (Fin (A.model n).size)) : (sourceRootedIndicatorMarkovModel A S hsymmetric hgenerates n T).IsGenerated (fun i : ↥S => (i : G)) (symmetricGeneratorWord S hsymmetric hgenerates)"},{"kind":"theorem","name":"sourceRootedIndicatorMarkovModel_isRootedAtRadius","statement":"{G : Type} [Group G] [DecidableEq G] (A : SoficGroups.SoficApproximation G) (S : Finset G) (hone : 1 ∈ S) (hsymmetric : ∀ g ∈ S, g⁻¹ ∈ S) (hgenerates : Subgroup.closure (S : Set G) = ⊤) (n r : ℕ) (T : Finset (Fin (A.model n).size)) (hgood : Disjoint T (chosenCayleyRadiusBad A S (symmetricGeneratorWord S hsymmetric hgenerates) n r)) : (sourceRootedIndicatorMarkovModel A S hsymmetric hgenerates n T).IsRootedAtRadius (symmetricGeneratorWord S hsymmetric hgenerates) r"},{"kind":"theorem","name":"highCrossingProfile_eq_boundary","statement":"{V ι : Type*} [Fintype V] [Fintype ι] [DecidableEq V] (σ : ι → Equiv.Perm V) (f : V → ℝ) (a t : ℝ) (hat : a < t) : highCrossingProfile σ f a t = (SoficGroups.boundary σ (upperLevel f t) : ℝ)"},{"kind":"theorem","name":"integrableOn_crossingIndicator","statement":"(a b c d : ℝ) : IntegrableOn ((Ico a b).indicator (fun _ => (1 : ℝ))) (Ioo c d)"},{"kind":"theorem","name":"integrableOn_highCrossingProfile","statement":"{V ι : Type*} [Fintype V] [Fintype ι] (σ : ι → Equiv.Perm V) (f : V → ℝ) (a c d : ℝ) : IntegrableOn (highCrossingProfile σ f a) (Ioo c d)"},{"kind":"theorem","name":"setIntegral_crossingIndicator_le_abs","statement":"(a b c d : ℝ) : (∫ t in Ioo c d, (Ico a b).indicator (fun _ => (1 : ℝ)) t) ≤ |b - a|"},{"kind":"theorem","name":"setIntegral_highCrossingProfile_le_variation","statement":"{V ι : Type*} [Fintype V] [Fintype ι] (σ : ι → Equiv.Perm V) (f : V → ℝ) (a c d : ℝ) : (∫ t in Ioo c d, highCrossingProfile σ f a t) ≤ ∑ i : ι, ∑ x ∈ Finset.univ.filter (fun x : V => a < f x), |f (σ i x) - f x|"},{"kind":"theorem","name":"card_symmDiff_upperLevel_le_nine_sq_error","statement":"{V : Type*} [Fintype V] [DecidableEq V] (T : Finset V) (f : V → ℝ) (t : ℝ) (hlow : (1 / 3 : ℝ) ≤ t) (hhigh : t ≤ (2 / 3 : ℝ)) : (((upperLevel f t ∆ T).card : ℝ)) ≤ 9 * ∑ x : V, (f x - if x ∈ T then (1 : ℝ) else 0) ^ 2"},{"kind":"theorem","name":"exists_upperLevel_boundary_and_symmDiff_le","statement":"{V ι : Type*} [Fintype V] [Fintype ι] [DecidableEq V] (σ : ι → Equiv.Perm V) (T : Finset V) (f : V → ℝ) : ∃ t ∈ Ioo (1 / 3 : ℝ) (2 / 3 : ℝ), (SoficGroups.boundary σ (upperLevel f t) : ℝ) ≤ 3 * ∑ i : ι, ∑ x ∈ Finset.univ.filter (fun x : V => (1 / 3 : ℝ) < f x), |f (σ i x) - f x| ∧ (((upperLevel f t ∆ T).card : ℝ)) ≤ 9 * ∑ x : V, (f x - if x ∈ T then (1 : ℝ) else 0) ^ 2"},{"kind":"theorem","name":"sum_permutation_mul_eq_sum_inverse_mul","statement":"{V : Type*} [Fintype V] (p : Equiv.Perm V) (f : V → ℝ) : (∑ x : V, f (p x) * f x) = ∑ x : V, f x * f (p.symm x)"},{"kind":"theorem","name":"sum_sq_displacement_eq_twice_inverse_residual","statement":"{V : Type*} [Fintype V] (p : Equiv.Perm V) (f : V → ℝ) : (∑ x : V, (f (p x) - f x) ^ 2) = 2 * ∑ x : V, f x * (f x - f (p.symm x))"},{"kind":"theorem","name":"sum_sum_sq_displacement_eq_twice_card_mul_realMarkov_residual","statement":"{V ι : Type*} [Fintype V] [Fintype ι] [Nonempty ι] (σ : ι → Equiv.Perm V) (f : V → ℝ) : (∑ i : ι, ∑ x : V, (f (σ i x) - f x) ^ 2) = 2 * (Fintype.card ι : ℝ) * ∑ x : V, f x * (f x - realMarkov σ f x)"},{"kind":"theorem","name":"sum_sq_le_card_of_unit_interval_mass","statement":"{V : Type*} [Fintype V] (T : Finset V) (f : V → ℝ) (hfzero : ∀ x, 0 ≤ f x) (hfone : ∀ x, f x ≤ 1) (hmass : (∑ x : V, f x) = (T.card : ℝ)) : (∑ x : V, f x ^ 2) ≤ (T.card : ℝ)"},{"kind":"theorem","name":"realMarkov_residual_pairing_le_sqrt_card_mul_residual","statement":"{V ι : Type*} [Fintype V] [Fintype ι] (σ : ι → Equiv.Perm V) (T : Finset V) (f : V → ℝ) (hfzero : ∀ x, 0 ≤ f x) (hfone : ∀ x, f x ≤ 1) (hmass : (∑ x : V, f x) = (T.card : ℝ)) : (∑ x : V, f x * (f x - realMarkov σ f x)) ≤ Real.sqrt (T.card : ℝ) * Real.sqrt (∑ x : V, (realMarkov σ f x - f x) ^ 2)"},{"kind":"theorem","name":"sum_sum_sq_displacement_le_twice_card_mul_sqrt_card_mul_residual","statement":"{V ι : Type*} [Fintype V] [Fintype ι] [Nonempty ι] (σ : ι → Equiv.Perm V) (T : Finset V) (f : V → ℝ) (hfzero : ∀ x, 0 ≤ f x) (hfone : ∀ x, f x ≤ 1) (hmass : (∑ x : V, f x) = (T.card : ℝ)) : (∑ i : ι, ∑ x : V, (f (σ i x) - f x) ^ 2) ≤ 2 * (Fintype.card ι : ℝ) * Real.sqrt (T.card : ℝ) * Real.sqrt (∑ x : V, (realMarkov σ f x - f x) ^ 2)"},{"kind":"theorem","name":"card_highSupport_le_three_card","statement":"{V : Type*} [Fintype V] (T : Finset V) (f : V → ℝ) (hfzero : ∀ x, 0 ≤ f x) (hmass : (∑ x : V, f x) = (T.card : ℝ)) : (((Finset.univ.filter fun x : V => (1 / 3 : ℝ) < f x).card : ℝ)) ≤ 3 * (T.card : ℝ)"},{"kind":"theorem","name":"filtered_variation_sq_le_card_mul_filtered_energy","statement":"{V ι : Type*} [Fintype ι] (σ : ι → Equiv.Perm V) (f : V → ℝ) (H : Finset V) : (∑ i : ι, ∑ x ∈ H, |f (σ i x) - f x|) ^ 2 ≤ (Fintype.card ι : ℝ) * (H.card : ℝ) * ∑ i : ι, ∑ x ∈ H, (f (σ i x) - f x) ^ 2"},{"kind":"theorem","name":"filtered_variation_sq_le_card_mul_energy","statement":"{V ι : Type*} [Fintype V] [Fintype ι] (σ : ι → Equiv.Perm V) (f : V → ℝ) (H : Finset V) : (∑ i : ι, ∑ x ∈ H, |f (σ i x) - f x|) ^ 2 ≤ (Fintype.card ι : ℝ) * (H.card : ℝ) * ∑ i : ι, ∑ x : V, (f (σ i x) - f x) ^ 2"},{"kind":"theorem","name":"highSupport_variation_sq_le_three_mul_reference_energy","statement":"{V ι : Type*} [Fintype V] [Fintype ι] (σ : ι → Equiv.Perm V) (f : V → ℝ) (T : Finset V) (hhigh : ((Finset.univ.filter (fun x : V => (1 / 3 : ℝ) < f x)).card : ℝ) ≤ 3 * (T.card : ℝ)) : (∑ i : ι, ∑ x ∈ Finset.univ.filter (fun x : V => (1 / 3 : ℝ) < f x), |f (σ i x) - f x|) ^ 2 ≤ 3 * (Fintype.card ι : ℝ) * (T.card : ℝ) * ∑ i : ι, ∑ x : V, (f (σ i x) - f x) ^ 2"},{"kind":"theorem","name":"high_variation_le_of_markov_square_bounds","statement":"{d t α η b r E H : ℝ} (hd : 0 ≤ d) (ht : 0 ≤ t) (hα : 0 ≤ α) (hη : 0 ≤ η) (hbase : b ^ 2 ≤ t) (hresidual : r ≤ η * b) (henergy : E ≤ 2 * d * Real.sqrt t * r) (hcauchy : H ^ 2 ≤ 3 * d * t * E) (hsmall : 486 * d ^ 2 * η ≤ 4 * α ^ 2) : 9 * H ≤ 2 * α * t"},{"kind":"theorem","name":"highSupport_variation_le_of_realMarkov_residual_and_highSupport","statement":"{V ι : Type*} [Fintype V] [Fintype ι] [Nonempty ι] (σ : ι → Equiv.Perm V) (T : Finset V) (f : V → ℝ) (α η b : ℝ) (hfzero : ∀ x, 0 ≤ f x) (hfone : ∀ x, f x ≤ 1) (hmass : (∑ x : V, f x) = (T.card : ℝ)) (hhigh : ((Finset.univ.filter (fun x : V => (1 / 3 : ℝ) < f x)).card : ℝ) ≤ 3 * (T.card : ℝ)) (hα : 0 ≤ α) (hη : 0 ≤ η) (hbase : b ^ 2 ≤ (T.card : ℝ)) (hresidual : Real.sqrt (∑ x : V, (realMarkov σ f x - f x) ^ 2) ≤ η * b) (hsmall : 486 * (Fintype.card ι : ℝ) ^ 2 * η ≤ 4 * α ^ 2) : 9 * (∑ i : ι, ∑ x ∈ Finset.univ.filter (fun x : V => (1 / 3 : ℝ) < f x), |f (σ i x) - f x|) ≤ 2 * α * (T.card : ℝ)"},{"kind":"theorem","name":"highSupport_variation_le_of_realMarkov_residual","statement":"{V ι : Type*} [Fintype V] [Fintype ι] [Nonempty ι] (σ : ι → Equiv.Perm V) (T : Finset V) (f : V → ℝ) (α η b : ℝ) (hfzero : ∀ x, 0 ≤ f x) (hfone : ∀ x, f x ≤ 1) (hmass : (∑ x : V, f x) = (T.card : ℝ)) (hα : 0 ≤ α) (hη : 0 ≤ η) (hbase : b ^ 2 ≤ (T.card : ℝ)) (hresidual : Real.sqrt (∑ x : V, (realMarkov σ f x - f x) ^ 2) ≤ η * b) (hsmall : 486 * (Fintype.card ι : ℝ) ^ 2 * η ≤ 4 * α ^ 2) : 9 * (∑ i : ι, ∑ x ∈ Finset.univ.filter (fun x : V => (1 / 3 : ℝ) < f x), |f (σ i x) - f x|) ≤ 2 * α * (T.card : ℝ)"},{"kind":"theorem","name":"card_completed_sourceWordTestBad_le_sourceCompletionBad","statement":"{V ι J : Type*} [Fintype V] [DecidableEq V] [Fintype ι] [Group J] (σ : ι → Equiv.Perm V) (p : J → Equiv.Perm V) (F : Finset J) (P : Finset V) : (SoficGroups.MatchedComponentExitBudget.sourceWordTestBad (fun i => SoficGroups.MatchedComponentCompletion.completedRestriction (σ i) P) (fun j => SoficGroups.MatchedComponentCompletion.completedRestriction (p j) P) F).card ≤ (SoficGroups.MatchedComponentCompletion.sourceCompletionBad σ p F P).card"},{"kind":"theorem","name":"completed_sourceWordTestBad_density_tendsto_zero","statement":"(V : ℕ → Type*) [∀ n, Fintype (V n)] [∀ n, DecidableEq (V n)] {ι J : Type*} [Fintype ι] [Group J] (σ : (n : ℕ) → ι → Equiv.Perm (V n)) (p : (n : ℕ) → J → Equiv.Perm (V n)) (F : Finset J) (P E : (n : ℕ) → Finset (V n)) (hcapture : ∀ n, SoficGroups.MatchedComponentCompletion.sourceCompletionBad (σ n) (p n) F (P n) ⊆ P n ∩ E n) (hradius : Tendsto (fun n => (((P n ∩ E n).card : ℝ) / (P n).card)) atTop (nhds 0)) : Tendsto (fun n => ((SoficGroups.MatchedComponentExitBudget.sourceWordTestBad (fun i => SoficGroups.MatchedComponentCompletion.completedRestriction (σ n i) (P n)) (fun j => SoficGroups.MatchedComponentCompletion.completedRestriction (p n j) (P n)) F).card : ℝ) / (P n).card) atTop (nhds 0)"},{"kind":"theorem","name":"completed_sourceWordTestBad_density_tendsto_zero_of_matchedRadius","statement":"(V : ℕ → Type*) [∀ n, Fintype (V n)] [∀ n, DecidableEq (V n)] {ι κ J : Type*} [Fintype ι] [Group J] (σ : (n : ℕ) → ι → Equiv.Perm (V n)) (p : (n : ℕ) → J → Equiv.Perm (V n)) (F : Finset J) (U P : (n : ℕ) → Finset (V n)) (Q : (n : ℕ) → Finpartition (U n)) (I : ℕ → Finset κ) (w : (n : ℕ) → κ → Equiv.Perm (V n)) (r : ℕ → ℕ) (B : (n : ℕ) → ℕ → Finset (V n)) (hcapture : ∀ n, SoficGroups.MatchedComponentCompletion.sourceCompletionBad (σ n) (p n) F (P n) ⊆ P n ∩ SoficGroups.matchedRadiusBad (Q n) (I (r n)) (w n) (B n (r n))) (hradius : Tendsto (fun n => (((P n ∩ SoficGroups.matchedRadiusBad (Q n) (I (r n)) (w n) (B n (r n))).card : ℝ) / (P n).card)) atTop (nhds 0)) : Tendsto (fun n => ((SoficGroups.MatchedComponentExitBudget.sourceWordTestBad (fun i => SoficGroups.MatchedComponentCompletion.completedRestriction (σ n i) (P n)) (fun j => SoficGroups.MatchedComponentCompletion.completedRestriction (p n j) (P n)) F).card : ℝ) / (P n).card) atTop (nhds 0)"},{"kind":"theorem","name":"pruned_sourceCompletionBad_density_tendsto_zero_of_matchedRadius","statement":"(V : ℕ → Type*) [∀ n, Fintype (V n)] [∀ n, DecidableEq (V n)] {ι κ J : Type*} [Fintype ι] [Group J] (σ : (n : ℕ) → ι → Equiv.Perm (V n)) (p : (n : ℕ) → J → Equiv.Perm (V n)) (F : Finset J) (U P : (n : ℕ) → Finset (V n)) (Q : (n : ℕ) → Finpartition (U n)) (I : ℕ → Finset κ) (w : (n : ℕ) → κ → Equiv.Perm (V n)) (r : ℕ → ℕ) (B : (n : ℕ) → ℕ → Finset (V n)) (D : (n : ℕ) → Finset {x : V n // x ∈ P n}) (hcapture : ∀ n, SoficGroups.MatchedComponentCompletion.sourceCompletionBad (σ n) (p n) F (P n) ⊆ P n ∩ SoficGroups.matchedRadiusBad (Q n) (I (r n)) (w n) (B n (r n))) (hradius : Tendsto (fun n => (((P n ∩ SoficGroups.matchedRadiusBad (Q n) (I (r n)) (w n) (B n (r n))).card : ℝ) / (P n).card)) atTop (nhds 0)) (hZ : ∀ n, (Finset.univ \\ D n : Finset {x : V n // x ∈ P n}).Nonempty) (hdeleted : Tendsto (fun n => ((D n).card : ℝ) / (P n).card) atTop (nhds 0)) : Tendsto (fun n => ((SoficGroups.MatchedComponentCompletion.sourceCompletionBad (fun i => SoficGroups.MatchedComponentCompletion.completedRestriction (σ n i) (P n)) (fun j => SoficGroups.MatchedComponentCompletion.completedRestriction (p n j) (P n)) F (Finset.univ \\ D n)).card : ℝ) / (Finset.univ \\ D n : Finset {x : V n // x ∈ P n}).card) atTop (nhds 0)"},{"kind":"theorem","name":"lt_exp_mul_of_equal_log_floor","statement":"{x y H r : ℝ} (hx : 0 < x) (hy : 0 < y) (hH : 0 < H) (hrank : ⌊(Real.log x + r) / H⌋ = ⌊(Real.log y + r) / H⌋) : y < Real.exp H * x"},{"kind":"theorem","name":"transported_maximumOverlapPart_card_lt_exp_mul","statement":"{V : Type*} [Fintype V] [DecidableEq V] (Q : Finpartition (Finset.univ : Finset V)) (T : Equiv.Perm V) (C : Finset V) (hC : C ∈ Q.parts) (H r : ℝ) (hH : 0 < H) (x : V) (hx : x ∈ C) (hTx : T x ∈ SoficGroups.maximumOverlapPart Q (C.map T.toEmbedding)) (hrank : SoficGroups.MidrankPermutationEnergy.offsetFloorRank (fun z : V => Real.log (SoficGroups.partitionComponentSize Q z : ℝ)) H r (T x) = SoficGroups.MidrankPermutationEnergy.offsetFloorRank (fun z : V => Real.log (SoficGroups.partitionComponentSize Q z : ℝ)) H r x) : ((SoficGroups.maximumOverlapPart Q (C.map T.toEmbedding)).card : ℝ) < Real.exp H * (C.card : ℝ)"},{"kind":"theorem","name":"card_symmDiff_add_twice_inter","statement":"{V : Type*} [DecidableEq V] (C D : Finset V) : (C ∆ D).card + 2 * (C ∩ D).card = C.card + D.card"},{"kind":"theorem","name":"symmDiff_card_lt_of_overlap_and_exp_card","statement":"{V : Type*} [DecidableEq V] (C D : Finset V) (H eta : ℝ) (hoverlap : (1 - eta) * (C.card : ℝ) ≤ ((C ∩ D).card : ℝ)) (hcard : (D.card : ℝ) < Real.exp H * (C.card : ℝ)) : ((C ∆ D).card : ℝ) < (Real.exp H - 1 + 2 * eta) * (C.card : ℝ)"},{"kind":"theorem","name":"target_majority_of_overlap_and_exp_card","statement":"{V : Type*} [DecidableEq V] (C D : Finset V) (hC : C.Nonempty) (H eta : ℝ) (hoverlap : (1 - eta) * (C.card : ℝ) ≤ ((C ∩ D).card : ℝ)) (hcard : (D.card : ℝ) < Real.exp H * (C.card : ℝ)) (hsmall : 2 * (Real.exp H - 1 + 2 * eta) < 1) : D.card < 2 * (C ∩ D).card"},{"kind":"theorem","name":"symmDiff_density_tendsto_zero_of_log_rank_bounds","statement":"{V : ℕ → Type*} [∀ n, DecidableEq (V n)] (U : ∀ n, Finset (V n)) (hU : ∀ n, (U n).Nonempty) (P : ∀ n, Finpartition (U n)) (R : ∀ n, Finset (Finset (V n))) (hR : ∀ n, R n ⊆ (P n).parts) (D : ∀ n, Finset (V n) → Finset (V n)) (H eta : ℕ → ℝ) (hH : ∀ n, 0 ≤ H n) (heta : ∀ n, 0 ≤ eta n) (hHzero : Tendsto H atTop (nhds 0)) (hetazero : Tendsto eta atTop (nhds 0)) (hbound : ∀ n C, C ∈ R n → ((C ∆ D n C).card : ℝ) ≤ (Real.exp (H n) - 1 + 2 * eta n) * (C.card : ℝ)) : Tendsto (fun n => ((∑ C ∈ R n, (C ∆ D n C).card : ℕ) : ℝ) / (U n).card) atTop (nhds 0)"},{"kind":"theorem","name":"mem_partitionWordCrossing_univ","statement":"{V : Type*} [Fintype V] [DecidableEq V] (Q : Finpartition (Finset.univ : Finset V)) (p : Equiv.Perm V) (x : V) : x ∈ SoficGroups.partitionWordCrossing Q p ↔ Q.part x ≠ Q.part (p x)"},{"kind":"theorem","name":"card_partitionWordCrossing_le_add_distance","statement":"{V : Type*} [Fintype V] [DecidableEq V] (Q : Finpartition (Finset.univ : Finset V)) (p q : Equiv.Perm V) : (SoficGroups.partitionWordCrossing Q p).card ≤ (SoficGroups.partitionWordCrossing Q q).card + SoficGroups.permutationDistance p q"},{"kind":"theorem","name":"tendsto_action_inverse","statement":"{G : Type*} [Group G] (A : SoficGroups.SoficApproximation G) (u : G) : Tendsto (fun n => SoficGroups.normalizedHamming (((A.model n).action u)⁻¹) ((A.model n).action (u⁻¹))) atTop (nhds 0)"},{"kind":"theorem","name":"tendsto_action_conjugate","statement":"{G : Type*} [Group G] (A : SoficGroups.SoficApproximation G) (u g : G) : Tendsto (fun n => SoficGroups.normalizedHamming ((A.model n).action (u * g * u⁻¹)) ((A.model n).action u * (A.model n).action g * ((A.model n).action u)⁻¹)) atTop (nhds 0)"},{"kind":"theorem","name":"conjugated_word_crossing_density_tendsto_zero","statement":"{G : Type*} [Group G] (A : SoficGroups.SoficApproximation G) (u g : G) (Q : ∀ n, Finpartition (Finset.univ : Finset (Fin (A.model n).size))) (hword : Tendsto (fun n => ((SoficGroups.partitionWordCrossing (Q n) ((A.model n).action (u * g * u⁻¹))).card : ℝ) / (A.model n).size) atTop (nhds 0)) : Tendsto (fun n => ((SoficGroups.partitionWordCrossing (Q n) ((A.model n).action u * (A.model n).action g * ((A.model n).action u)⁻¹)).card : ℝ) / (A.model n).size) atTop (nhds 0)"},{"kind":"theorem","name":"exists_matchedRetained_part_boundary_and_bad_density_le","statement":"{V ι : Type*} [DecidableEq V] [Fintype ι] (σ : ι → Equiv.Perm V) {U : Finset V} (P : Finpartition U) (R : Finset (Finset V)) (hR : R ⊆ P.parts) (hRne : R.Nonempty) (B : Finset V) : ∃ C ∈ R, (SoficGroups.boundary σ C : ℝ) / C.card ≤ ((∑ D ∈ R, (SoficGroups.boundary σ D : ℝ)) + ((SoficGroups.matchedRetainedSupport R ∩ B).card : ℝ)) / (SoficGroups.matchedRetainedSupport R).card ∧ ((C ∩ B).card : ℝ) / C.card ≤ ((∑ D ∈ R, (SoficGroups.boundary σ D : ℝ)) + ((SoficGroups.matchedRetainedSupport R ∩ B).card : ℝ)) / (SoficGroups.matchedRetainedSupport R).card"},{"kind":"theorem","name":"matchedRetained_boundary_density_tendsto_zero","statement":"{V : ℕ → Type*} [∀ n, DecidableEq (V n)] {ι : Type*} [Fintype ι] (σ : (n : ℕ) → ι → Equiv.Perm (V n)) (U : ∀ n, Finset (V n)) (hU : ∀ n, (U n).Nonempty) (P : ∀ n, Finpartition (U n)) (R : ∀ n, Finset (Finset (V n))) (hR : ∀ n, R n ⊆ (P n).parts) (hRne : ∀ n, (R n).Nonempty) (hdiscard : Tendsto (fun n => (((U n \\ SoficGroups.matchedRetainedSupport (R n)).card : ℝ) / (U n).card)) atTop (𝓝 0)) (hboundary : Tendsto (fun n => (∑ C ∈ (P n).parts, (SoficGroups.boundary (σ n) C : ℝ)) / (U n).card) atTop (𝓝 0)) : Tendsto (fun n => (∑ C ∈ R n, (SoficGroups.boundary (σ n) C : ℝ)) / (SoficGroups.matchedRetainedSupport (R n)).card) atTop (𝓝 0)"},{"kind":"theorem","name":"exists_matchedRetained_parts_with_vanishing_boundary_and_bad_density","statement":"{V : ℕ → Type*} [∀ n, DecidableEq (V n)] {ι : Type*} [Fintype ι] (σ : (n : ℕ) → ι → Equiv.Perm (V n)) (U : ∀ n, Finset (V n)) (hU : ∀ n, (U n).Nonempty) (P : ∀ n, Finpartition (U n)) (R : ∀ n, Finset (Finset (V n))) (hR : ∀ n, R n ⊆ (P n).parts) (hRne : ∀ n, (R n).Nonempty) (hdiscard : Tendsto (fun n => (((U n \\ SoficGroups.matchedRetainedSupport (R n)).card : ℝ) / (U n).card)) atTop (𝓝 0)) (B : ∀ n, Finset (V n)) (hbad : Tendsto (fun n => (((U n ∩ B n).card : ℝ) / (U n).card)) atTop (𝓝 0)) (hboundary : Tendsto (fun n => (∑ C ∈ (P n).parts, (SoficGroups.boundary (σ n) C : ℝ)) / (U n).card) atTop (𝓝 0)) : ∃ C : ∀ n, Finset (V n), (∀ n, C n ∈ R n) ∧ Tendsto (fun n => (SoficGroups.boundary (σ n) (C n) : ℝ) / (C n).card) atTop (𝓝 0) ∧ Tendsto (fun n => (((C n ∩ B n).card : ℝ) / (C n).card)) atTop (𝓝 0)"},{"kind":"theorem","name":"exists_matched_slow_diagonal_large_components_with_vanishing_boundary","statement":"{K : Type*} [Group K] [Infinite K] [DecidableEq K] (S : Finset K) (hS : 1 ∈ S) (hgen : Subgroup.closure (S : Set K) = ⊤) {V : ℕ → Type*} [∀ n, DecidableEq (V n)] {ι κ : Type*} [Fintype κ] (σ : (n : ℕ) → κ → Equiv.Perm (V n)) (U : ∀ n, Finset (V n)) (hU : ∀ n, (U n).Nonempty) (P Q : ∀ n, Finpartition (U n)) (R : ∀ n, Finset (Finset (V n))) (hR : ∀ n, R n ⊆ (P n).parts) (hRne : ∀ n, (R n).Nonempty) (D : ∀ n, Finset (V n) → Finset (V n)) (hD : ∀ n C, C ∈ R n → D n C ∈ (Q n).parts) (hmajor : ∀ n C, C ∈ R n → (D n C).card < 2 * (C ∩ D n C).card) (hdiscard : Tendsto (fun n => (((U n \\ SoficGroups.matchedRetainedSupport (R n)).card : ℝ) / (U n).card)) atTop (𝓝 0)) (hsymm : Tendsto (fun n => ((∑ C ∈ R n, (C ∆ D n C).card : ℕ) : ℝ) / (U n).card) atTop (𝓝 0)) (I : ℕ → Finset ι) (w : ∀ n, ι → Equiv.Perm (V n)) (hword : ∀ k, Tendsto (fun n => ((∑ i ∈ I k, (SoficGroups.partitionWordCrossing (Q n) (w n i)).card : ℕ) : ℝ) / (U n).card) atTop (𝓝 0)) (B : ∀ n, ℕ → Finset (V n)) (hbad : ∀ k, Tendsto (fun n => (((U n ∩ B n k).card : ℝ) / (U n).card)) atTop (𝓝 0)) (hboundary : Tendsto (fun n => (∑ C ∈ (P n).parts, (SoficGroups.boundary (σ n) C : ℝ)) / (U n).card) atTop (𝓝 0)) (hrealize : ∀ n k (C : Finset (V n)), C ∈ R n → ∀ x ∈ C, x ∉ SoficGroups.matchedRadiusBad (P n) (I k) (w n) (B n k) → ∃ f : K → V n, Set.MapsTo f (↑(S ^ (k / 2)) : Set K) (↑C : Set (V n)) ∧ Set.InjOn f (↑(S ^ (k / 2)) : Set K)) : ∃ (r : ℕ → ℕ) (C : ∀ n, Finset (V n)), Tendsto r atTop atTop ∧ (∀ n, C n ∈ R n) ∧ Tendsto (fun n => (SoficGroups.boundary (σ n) (C n) : ℝ) / (C n).card) atTop (𝓝 0) ∧ Tendsto (fun n => (((C n ∩ SoficGroups.matchedRadiusBad (P n) (I (r n)) (w n) (B n (r n))).card : ℝ) / (C n).card)) atTop (𝓝 0) ∧ Tendsto (fun n => (C n).card) atTop atTop"},{"kind":"theorem","name":"matchedRetained_parts_eventually_nonempty_of_discard","statement":"{V : ℕ → Type*} [∀ n, DecidableEq (V n)] (U : ∀ n, Finset (V n)) (hU : ∀ n, (U n).Nonempty) (R : ∀ n, Finset (Finset (V n))) (hdiscard : Tendsto (fun n => (((U n \\ SoficGroups.matchedRetainedSupport (R n)).card : ℝ) / (U n).card)) atTop (𝓝 0)) : ∀ᶠ n in atTop, (R n).Nonempty"},{"kind":"theorem","name":"exists_matched_slow_diagonal_large_components_on_guarded_tail","statement":"{K : Type*} [Group K] [Infinite K] [DecidableEq K] (S : Finset K) (hS : 1 ∈ S) (hgen : Subgroup.closure (S : Set K) = ⊤) {V : ℕ → Type*} [∀ n, DecidableEq (V n)] {ι κ : Type*} [Fintype κ] (σ : (n : ℕ) → κ → Equiv.Perm (V n)) (U : ∀ n, Finset (V n)) (hU : ∀ n, (U n).Nonempty) (P Q : ∀ n, Finpartition (U n)) (R : ∀ n, Finset (Finset (V n))) (hR : ∀ n, R n ⊆ (P n).parts) (D : ∀ n, Finset (V n) → Finset (V n)) (hD : ∀ n C, C ∈ R n → D n C ∈ (Q n).parts) (guard : ℕ → Prop) (hguard : ∀ᶠ n in atTop, guard n) (hmajor : ∀ n, guard n → ∀ C, C ∈ R n → (D n C).card < 2 * (C ∩ D n C).card) (hdiscard : Tendsto (fun n => (((U n \\ SoficGroups.matchedRetainedSupport (R n)).card : ℝ) / (U n).card)) atTop (𝓝 0)) (hsymm : Tendsto (fun n => ((∑ C ∈ R n, (C ∆ D n C).card : ℕ) : ℝ) / (U n).card) atTop (𝓝 0)) (I : ℕ → Finset ι) (w : ∀ n, ι → Equiv.Perm (V n)) (hword : ∀ k, Tendsto (fun n => ((∑ i ∈ I k, (SoficGroups.partitionWordCrossing (Q n) (w n i)).card : ℕ) : ℝ) / (U n).card) atTop (𝓝 0)) (B : ∀ n, ℕ → Finset (V n)) (hbad : ∀ k, Tendsto (fun n => (((U n ∩ B n k).card : ℝ) / (U n).card)) atTop (𝓝 0)) (hboundary : Tendsto (fun n => (∑ C ∈ (P n).parts, (SoficGroups.boundary (σ n) C : ℝ)) / (U n).card) atTop (𝓝 0)) (hrealize : ∀ n k (C : Finset (V n)), C ∈ R n → ∀ x ∈ C, x ∉ SoficGroups.matchedRadiusBad (P n) (I k) (w n) (B n k) → ∃ f : K → V n, Set.MapsTo f (↑(S ^ (k / 2)) : Set K) (↑C : Set (V n)) ∧ Set.InjOn f (↑(S ^ (k / 2)) : Set K)) (N₀ : ℕ) : ∃ (N : ℕ) (r : ℕ → ℕ) (C : (n : ℕ) → Finset (V (n + N))), N₀ ≤ N ∧ (∀ n, guard (n + N)) ∧ Tendsto r atTop atTop ∧ (∀ n, C n ∈ R (n + N)) ∧ Tendsto (fun n => (SoficGroups.boundary (σ (n + N)) (C n) : ℝ) / (C n).card) atTop (𝓝 0) ∧ Tendsto (fun n => (((C n ∩ SoficGroups.matchedRadiusBad (P (n + N)) (I (r n)) (w (n + N)) (B (n + N) (r n))).card : ℝ) / (C n).card)) atTop (𝓝 0) ∧ Tendsto (fun n => (C n).card) atTop atTop"},{"kind":"theorem","name":"source_compression_scale_guard_eventually","statement":"(H eta : ℕ → ℝ) (hH : Tendsto H atTop (𝓝 0)) (heta : Tendsto eta atTop (𝓝 0)) : ∀ᶠ n in atTop, eta n ≤ (1 : ℝ) / 2 ∧ 2 * (Real.exp (H n) - 1 + 2 * eta n) < 1"},{"kind":"theorem","name":"exists_matched_slow_diagonal_large_components_on_source_scale_tail","statement":"{K : Type*} [Group K] [Infinite K] [DecidableEq K] (S : Finset K) (hS : 1 ∈ S) (hgen : Subgroup.closure (S : Set K) = ⊤) {V : ℕ → Type*} [∀ n, DecidableEq (V n)] {ι κ : Type*} [Fintype κ] (σ : (n : ℕ) → κ → Equiv.Perm (V n)) (U : ∀ n, Finset (V n)) (hU : ∀ n, (U n).Nonempty) (P Q : ∀ n, Finpartition (U n)) (R : ∀ n, Finset (Finset (V n))) (hR : ∀ n, R n ⊆ (P n).parts) (D : ∀ n, Finset (V n) → Finset (V n)) (hD : ∀ n C, C ∈ R n → D n C ∈ (Q n).parts) (H eta : ℕ → ℝ) (hH : Tendsto H atTop (𝓝 0)) (heta : Tendsto eta atTop (𝓝 0)) (hmajor : ∀ n, eta n ≤ (1 : ℝ) / 2 → 2 * (Real.exp (H n) - 1 + 2 * eta n) < 1 → ∀ C, C ∈ R n → (D n C).card < 2 * (C ∩ D n C).card) (hdiscard : Tendsto (fun n => (((U n \\ SoficGroups.matchedRetainedSupport (R n)).card : ℝ) / (U n).card)) atTop (𝓝 0)) (hsymm : Tendsto (fun n => ((∑ C ∈ R n, (C ∆ D n C).card : ℕ) : ℝ) / (U n).card) atTop (𝓝 0)) (I : ℕ → Finset ι) (w : ∀ n, ι → Equiv.Perm (V n)) (hword : ∀ k, Tendsto (fun n => ((∑ i ∈ I k, (SoficGroups.partitionWordCrossing (Q n) (w n i)).card : ℕ) : ℝ) / (U n).card) atTop (𝓝 0)) (B : ∀ n, ℕ → Finset (V n)) (hbad : ∀ k, Tendsto (fun n => (((U n ∩ B n k).card : ℝ) / (U n).card)) atTop (𝓝 0)) (hboundary : Tendsto (fun n => (∑ C ∈ (P n).parts, (SoficGroups.boundary (σ n) C : ℝ)) / (U n).card) atTop (𝓝 0)) (hrealize : ∀ n k (C : Finset (V n)), C ∈ R n → ∀ x ∈ C, x ∉ SoficGroups.matchedRadiusBad (P n) (I k) (w n) (B n k) → ∃ f : K → V n, Set.MapsTo f (↑(S ^ (k / 2)) : Set K) (↑C : Set (V n)) ∧ Set.InjOn f (↑(S ^ (k / 2)) : Set K)) (N₀ : ℕ) : ∃ (N : ℕ) (r : ℕ → ℕ) (C : (n : ℕ) → Finset (V (n + N))), N₀ ≤ N ∧ (∀ n, eta (n + N) ≤ (1 : ℝ) / 2) ∧ (∀ n, 2 * (Real.exp (H (n + N)) - 1 + 2 * eta (n + N)) < 1) ∧ Tendsto r atTop atTop ∧ (∀ n, C n ∈ R (n + N)) ∧ Tendsto (fun n => (SoficGroups.boundary (σ (n + N)) (C n) : ℝ) / (C n).card) atTop (𝓝 0) ∧ Tendsto (fun n => (((C n ∩ SoficGroups.matchedRadiusBad (P (n + N)) (I (r n)) (w (n + N)) (B (n + N) (r n))).card : ℝ) / (C n).card)) atTop (𝓝 0) ∧ Tendsto (fun n =>"},{"kind":"theorem","name":"reference_difference_le_symmDiff_add_missing","statement":"{α : Type*} [DecidableEq α] (U T W : Finset α) (hsub : T ⊆ W) : (U \\ W).card + (W \\ U).card ≤ (U ∆ T).card + (W \\ T).card"},{"kind":"theorem","name":"reference_difference_le_of_good_root_threshold","statement":"{V ι : Type*} [Fintype V] [DecidableEq V] [Fintype ι] [Nonempty ι] (σ : ι → Equiv.Perm V) (p : Equiv.Perm V) (B : Finset V) (T U : Finset (V × V)) (t : ℕ) (q : ℝ) (hq : q < 1) (hsub : T ⊆ SoficGroups.permutationGraph p) (hmissing : (SoficGroups.permutationGraph p \\ T).card ≤ 2 * B.card) (hbad : 2 * (Fintype.card ι : ℝ) * (B.card : ℝ) ≤ (t : ℝ)) (hdefect : SoficGroups.permutationCommutationDefect σ p ≤ 2 * t) (hboundary : SoficGroups.boundary (fun i => (σ i).prodCongr (σ i)) T ≤ SoficGroups.permutationCommutationDefect σ p + 2 * Fintype.card ι * B.card) (hthreshold : ((U ∆ T).card : ℝ) ≤ 72 * (SoficGroups.boundary (fun i => (σ i).prodCongr (σ i)) T : ℝ) / ((Fintype.card ι : ℝ) * (1 - q) ^ 2)) : (((U \\ SoficGroups.permutationGraph p).card + (SoficGroups.permutationGraph p \\ U).card : ℕ) : ℝ) ≤ (216 / ((Fintype.card ι : ℝ) * (1 - q) ^ 2) + 1 / (Fintype.card ι : ℝ)) * (t : ℝ)"},{"kind":"theorem","name":"hasAlmostCentralizerImprovement_of_universal_good_root_thresholds","statement":"{V ι : Type*} [Fintype V] [Nonempty V] [DecidableEq V] [Fintype ι] [Nonempty ι] (σ : ι → Equiv.Perm V) (tolerance : ℕ) (h q : ℝ) (hpositive : 0 < h) (hq : q < 1) (B : Finset V) (good : Equiv.Perm V → Finset (V × V)) (hexp : ∀ A : Finset V, h * min (A.card : ℝ) ((Fintype.card V : ℝ) - A.card) ≤ (SoficGroups.boundary σ A : ℝ)) (hbad : 2 * (Fintype.card ι : ℝ) * (B.card : ℝ) ≤ (tolerance : ℝ)) (hgood_subset : ∀ p : Equiv.Perm V, good p ⊆ SoficGroups.permutationGraph p) (hgood_missing : ∀ p : Equiv.Perm V, (SoficGroups.permutationGraph p \\ good p).card ≤ 2 * B.card) (hgood_boundary : ∀ p : Equiv.Perm V, SoficGroups.boundary (fun i => (σ i).prodCongr (σ i)) (good p) ≤ SoficGroups.permutationCommutationDefect σ p + 2 * Fintype.card ι * B.card) (hslow : 5 * (4 + h * (216 / ((Fintype.card ι : ℝ) * (1 - q) ^ 2) + 1 / (Fintype.card ι : ℝ))) * (tolerance : ℝ) ≤ h * (Fintype.card V : ℝ)) (hthreshold : ∀ p : Equiv.Perm V, SoficGroups.permutationCommutationDefect σ p ≤ 2 * tolerance → ∃ U : Finset (V × V), ((U ∆ good p).card : ℝ) ≤ 72 * (SoficGroups.boundary (fun i => (σ i).prodCongr (σ i)) (good p) : ℝ) / ((Fintype.card ι : ℝ) * (1 - q) ^ 2) ∧ (SoficGroups.boundary (fun i => (σ i).prodCongr (σ i)) U : ℝ) ≤ (h * (tolerance : ℝ) / (2 * (h + 8 * (Fintype.card ι : ℝ)) * (Fintype.card V : ℝ))) * (U.card : ℝ)) : SoficGroups.HasAlmostCentralizerImprovement σ tolerance"},{"kind":"theorem","name":"exists_rooted_word_radius_real_markov_sq_error_le_boundary","statement":"{G : Type u} [Group G] (P : SoficGroups.KazhdanPair.{u, u} G) (S : Finset G) (honeS : 1 ∈ S) (hcover : P.generators ⊆ S) (hsymmetric : ∀ g ∈ S, g⁻¹ ∈ S) (w : G → List ↥S) (k : ℕ) : ∃ r : ℕ, ∀ X : RootedIndicatorMarkovModel G ↥S, X.IsGenerated (fun i : ↥S => (i : G)) w → X.IsRootedAtRadius w r → ∀ T : Finset X.carrier, (∀ x : X.carrier, X.indicator x = if x ∈ T then (1 : ℝ) else 0) → (∑ x : X.carrier, ((((SoficGroups.KunFinitePermutationMarkovMass.realPermutationMarkov X.generator)^[k]) (SoficGroups.KunFinitePermutationMarkovMass.realIndicator T)) x - if x ∈ T then (1 : ℝ) else 0) ^ 2) ≤ 8 * (SoficGroups.boundary X.generator T : ℝ) / ((S.card : ℝ) * (1 - kazhdanMarkovContractionFactor P S) ^ 2)"},{"kind":"theorem","name":"rooted_final_realMarkov_eq_mass_realPermutationMarkov","statement":"{ι V : Type*} [Fintype ι] (p : ι → Equiv.Perm V) : SoficGroups.KunActualFinalRestrictedVariation.realMarkov p = SoficGroups.KunFinitePermutationMarkovMass.realPermutationMarkov p"},{"kind":"theorem","name":"rooted_real_markov_iterate_residual_sqrt_eq","statement":"{ι V : Type*} [Fintype ι] [Fintype V] [DecidableEq V] (p : ι → Equiv.Perm V) (T : Finset V) (k : ℕ) : Real.sqrt (∑ x : V, (SoficGroups.KunActualFinalRestrictedVariation.realMarkov p ((((SoficGroups.KunFinitePermutationMarkovMass.realPermutationMarkov p)^[k]) (SoficGroups.KunFinitePermutationMarkovMass.realIndicator T))) x - ((((SoficGroups.KunFinitePermutationMarkovMass.realPermutationMarkov p)^[k]) (SoficGroups.KunFinitePermutationMarkovMass.realIndicator T)) x)) ^ 2) = ‖((permutationMarkov p)^[k + 1]) (indicatorVector (SoficGroups.KunFinitePermutationMarkovMass.realIndicator T)) - ((permutationMarkov p)^[k]) (indicatorVector (SoficGroups.KunFinitePermutationMarkovMass.realIndicator T))‖"},{"kind":"theorem","name":"exists_rooted_word_radius_sparse_cut_of_boundary","statement":"{G : Type u} [Group G] (P : SoficGroups.KazhdanPair.{u, u} G) (S : Finset G) (honeS : 1 ∈ S) (hcover : P.generators ⊆ S) (hsymmetric : ∀ g ∈ S, g⁻¹ ∈ S) (w : G → List ↥S) (γ α : ℝ) (_hγ : 0 < γ) (hα : 0 < α) (hγsmall : 216 * γ < (S.card : ℝ) * (1 - kazhdanMarkovContractionFactor P S) ^ 2) : ∃ (k r : ℕ), ∀ X : RootedIndicatorMarkovModel G ↥S, X.IsGenerated (fun i : ↥S => (i : G)) w → X.IsRootedAtRadius w r → ∀ T : Finset X.carrier, T.Nonempty → (∀ x : X.carrier, X.indicator x = if x ∈ T then (1 : ℝ) else 0) → (SoficGroups.boundary X.generator T : ℝ) < γ * (T.card : ℝ) → ∃ U : Finset X.carrier, (((U ∆ T).card : ℝ)) ≤ 9 * (∑ x : X.carrier, ((((SoficGroups.KunFinitePermutationMarkovMass.realPermutationMarkov X.generator)^[k]) (SoficGroups.KunFinitePermutationMarkovMass.realIndicator T)) x - if x ∈ T then (1 : ℝ) else 0) ^ 2) ∧ (((U ∆ T).card : ℝ)) ≤ 72 * (SoficGroups.boundary X.generator T : ℝ) / ((S.card : ℝ) * (1 - kazhdanMarkovContractionFactor P S) ^ 2) ∧ 3 * (U ∆ T).card < T.card ∧ (SoficGroups.boundary X.generator U : ℝ) ≤ α * (U.card : ℝ)"},{"kind":"theorem","name":"witnesslessComponents_subset_parts","statement":"{V : Type*} [Fintype V] [DecidableEq V] (P Q : Finpartition (Finset.univ : Finset V)) (T : Equiv.Perm V) (b : V → ℤ) (eta : ℝ) : witnesslessComponents P Q T b eta ⊆ P.parts"},{"kind":"theorem","name":"overlapBad_disjoint_witnesslessComponents","statement":"{V : Type*} [Fintype V] [DecidableEq V] (P Q : Finpartition (Finset.univ : Finset V)) (T : Equiv.Perm V) (b : V → ℤ) (eta : ℝ) : Disjoint (SoficGroups.insufficientOverlapComponents P Q eta) (witnesslessComponents P Q T b eta)"},{"kind":"theorem","name":"retainedComponents_spec","statement":"{V : Type*} [Fintype V] [DecidableEq V] (P Q : Finpartition (Finset.univ : Finset V)) (T : Equiv.Perm V) (b : V → ℤ) (eta : ℝ) (C : Finset V) (hC : C ∈ retainedComponents P Q T b eta) : C ∈ P.parts ∧ SoficGroups.maximumOverlapPart Q C ∈ Q.parts ∧ (1 - eta) * (C.card : ℝ) ≤ ((C ∩ SoficGroups.maximumOverlapPart Q C).card : ℝ) ∧ ∃ y ∈ C ∩ SoficGroups.maximumOverlapPart Q C, b (T.symm y) = b y"},{"kind":"theorem","name":"witnessless_component_card_le_twice_rankChanging","statement":"{V : Type*} [Fintype V] [DecidableEq V] (P Q : Finpartition (Finset.univ : Finset V)) (T : Equiv.Perm V) (b : V → ℤ) (eta : ℝ) (heta : eta ≤ (1 : ℝ) / 2) (C : Finset V) (hC : C ∈ witnesslessComponents P Q T b eta) : C.card ≤ 2 * (C ∩ SoficGroups.RankArcCharging.rankChangingArc (Finset.univ : Finset V) b T.symm).card"},{"kind":"theorem","name":"witnesslessComponents_mass_le_twice_rankChanging","statement":"{V : Type*} [Fintype V] [DecidableEq V] (P Q : Finpartition (Finset.univ : Finset V)) (T : Equiv.Perm V) (b : V → ℤ) (eta : ℝ) (heta : eta ≤ (1 : ℝ) / 2) : (∑ C ∈ witnesslessComponents P Q T b eta, C.card) ≤ 2 * (SoficGroups.RankArcCharging.rankChangingArc (Finset.univ : Finset V) b T.symm).card"},{"kind":"theorem","name":"retained_missing_card_le_overlap_add_twice_rankChanging","statement":"{V : Type*} [Fintype V] [DecidableEq V] (P Q : Finpartition (Finset.univ : Finset V)) (T : Equiv.Perm V) (b : V → ℤ) (eta : ℝ) (heta : eta ≤ (1 : ℝ) / 2) : ((Finset.univ : Finset V) \\ SoficGroups.matchedRetainedSupport (retainedComponents P Q T b eta)).card ≤ (∑ C ∈ SoficGroups.insufficientOverlapComponents P Q eta, C.card) + 2 * (SoficGroups.RankArcCharging.rankChangingArc (Finset.univ : Finset V) b T.symm).card"},{"kind":"theorem","name":"retained_missing_density_tendsto_zero","statement":"(V : ℕ → Type*) [∀ n, Fintype (V n)] [∀ n, DecidableEq (V n)] (P Q : (n : ℕ) → Finpartition (Finset.univ : Finset (V n))) (T : (n : ℕ) → Equiv.Perm (V n)) (b : (n : ℕ) → V n → ℤ) (eta : ℕ → ℝ) (heta : Tendsto eta atTop (nhds 0)) (hoverlap : Tendsto (fun n => ((∑ C ∈ SoficGroups.insufficientOverlapComponents (P n) (Q n) (eta n), C.card : ℕ) : ℝ) / Fintype.card (V n)) atTop (nhds 0)) (hrank : Tendsto (fun n => ((SoficGroups.RankArcCharging.rankChangingArc (Finset.univ : Finset (V n)) (b n) (T n).symm).card : ℝ) / Fintype.card (V n)) atTop (nhds 0)) : Tendsto (fun n => (((Finset.univ : Finset (V n)) \\ SoficGroups.matchedRetainedSupport (retainedComponents (P n) (Q n) (T n) (b n) (eta n))).card : ℝ) / Fintype.card (V n)) atTop (nhds 0)"},{"kind":"theorem","name":"mem_partitionWordCrossing_univ","statement":"{V : Type*} [Fintype V] [DecidableEq V] (Q : Finpartition (Finset.univ : Finset V)) (p : Equiv.Perm V) (x : V) : x ∈ SoficGroups.partitionWordCrossing Q p ↔ Q.part x ≠ Q.part (p x)"},{"kind":"theorem","name":"card_partitionWordCrossing_le_add_distance","statement":"{V : Type*} [Fintype V] [DecidableEq V] (Q : Finpartition (Finset.univ : Finset V)) (p q : Equiv.Perm V) : (SoficGroups.partitionWordCrossing Q p).card ≤ (SoficGroups.partitionWordCrossing Q q).card + SoficGroups.permutationDistance p q"},{"kind":"theorem","name":"card_partitionWordCrossing_mul_le","statement":"{V : Type*} [Fintype V] [DecidableEq V] (Q : Finpartition (Finset.univ : Finset V)) (p q : Equiv.Perm V) : (SoficGroups.partitionWordCrossing Q (p * q)).card ≤ (SoficGroups.partitionWordCrossing Q p).card + (SoficGroups.partitionWordCrossing Q q).card"},{"kind":"theorem","name":"sum_generator_crossing_eq_sum_partition_boundary","statement":"{V ι : Type*} [Fintype V] [DecidableEq V] [Fintype ι] (Q : Finpartition (Finset.univ : Finset V)) (σ : ι → Equiv.Perm V) : (∑ i : ι, (SoficGroups.partitionWordCrossing Q (σ i)).card) = ∑ C ∈ Q.parts, SoficGroups.boundary σ C"},{"kind":"theorem","name":"generator_crossing_density_tendsto_zero","statement":"{V : ℕ → Type*} [∀ n, Fintype (V n)] [∀ n, DecidableEq (V n)] {ι : Type*} [Fintype ι] (Q : ∀ n, Finpartition (Finset.univ : Finset (V n))) (σ : ∀ n, ι → Equiv.Perm (V n)) (hboundary : Tendsto (fun n => (∑ C ∈ (Q n).parts, (SoficGroups.boundary (σ n) C : ℝ)) / Fintype.card (V n)) atTop (nhds 0)) (i : ι) : Tendsto (fun n => ((SoficGroups.partitionWordCrossing (Q n) (σ n i)).card : ℝ) / Fintype.card (V n)) atTop (nhds 0)"},{"kind":"theorem","name":"list_generator_crossing_density_tendsto_zero","statement":"{V : ℕ → Type*} [∀ n, Fintype (V n)] [∀ n, DecidableEq (V n)] {ι : Type*} (Q : ∀ n, Finpartition (Finset.univ : Finset (V n))) (σ : ∀ n, ι → Equiv.Perm (V n)) (hgenerator : ∀ i : ι, Tendsto (fun n => ((SoficGroups.partitionWordCrossing (Q n) (σ n i)).card : ℝ) / Fintype.card (V n)) atTop (nhds 0)) (l : List ι) : Tendsto (fun n => ((SoficGroups.partitionWordCrossing (Q n) ((l.map (σ n)).prod)).card : ℝ) / Fintype.card (V n)) atTop (nhds 0)"},{"kind":"theorem","name":"action_list_prod_tendsto","statement":"{G : Type*} [Group G] (A : SoficGroups.SoficApproximation G) (l : List G) : Tendsto (fun n => SoficGroups.normalizedHamming ((A.model n).action l.prod) ((l.map (A.model n).action).prod)) atTop (nhds 0)"},{"kind":"theorem","name":"exists_word_of_symmetric_generators","statement":"{H : Type*} [Group H] (S : Finset H) (hsymmetric : ∀ g ∈ S, g⁻¹ ∈ S) (hgenerates : Subgroup.closure (S : Set H) = ⊤) (g : H) : ∃ l : List ↥S, ((l.map fun i : ↥S => (i : H)).prod) = g"},{"kind":"theorem","name":"crossing_density_tendsto_zero_of_normalizedHamming","statement":"{V : ℕ → Type*} [∀ n, Fintype (V n)] [∀ n, DecidableEq (V n)] (Q : ∀ n, Finpartition (Finset.univ : Finset (V n))) (p q : ∀ n, Equiv.Perm (V n)) (hq : Tendsto (fun n => ((SoficGroups.partitionWordCrossing (Q n) (q n)).card : ℝ) / Fintype.card (V n)) atTop (nhds 0)) (hdist : Tendsto (fun n => SoficGroups.normalizedHamming (p n) (q n)) atTop (nhds 0)) : Tendsto (fun n => ((SoficGroups.partitionWordCrossing (Q n) (p n)).card : ℝ) / Fintype.card (V n)) atTop (nhds 0)"},{"kind":"theorem","name":"fixed_generated_word_crossing_density_tendsto_zero","statement":"{G H : Type*} [Group G] [Group H] (A : SoficGroups.SoficApproximation G) (φ : H →* G) (S : Finset H) (hsymmetric : ∀ g ∈ S, g⁻¹ ∈ S) (hgenerates : Subgroup.closure (S : Set H) = ⊤) (Q : ∀ n, Finpartition (Finset.univ : Finset (Fin (A.model n).size))) (hboundary : Tendsto (fun n => (∑ C ∈ (Q n).parts, (SoficGroups.boundary (fun i : ↥S => (A.model n).action (φ (i : H))) C : ℝ)) / (A.model n).size) atTop (nhds 0)) (g : H) : Tendsto (fun n => ((SoficGroups.partitionWordCrossing (Q n) ((A.model n).action (φ g))).card : ℝ) / (A.model n).size) atTop (nhds 0)"},{"kind":"theorem","name":"source_alpha_word_crossing_density_tendsto_zero","statement":"(A : SoficGroups.SoficApproximation (SoficGroups.prefixElementaryGroup SoficGroups.ninePrefixCode)) (S : Finset (SoficGroups.prefixElementaryGroup SoficGroups.alphaPrefixCode)) (hsymmetric : ∀ g ∈ S, g⁻¹ ∈ S) (hgenerates : Subgroup.closure (S : Set (SoficGroups.prefixElementaryGroup SoficGroups.alphaPrefixCode)) = ⊤) (Q : ∀ n, Finpartition (Finset.univ : Finset (Fin (A.model n).size))) (hboundary : Tendsto (fun n => (∑ C ∈ (Q n).parts, (SoficGroups.boundary (fun i : ↥S => (A.model n).action (sourceAlphaInclusion i)) C : ℝ)) / (A.model n).size) atTop (nhds 0)) (g : SoficGroups.prefixElementaryGroup SoficGroups.alphaPrefixCode) : Tendsto (fun n => ((SoficGroups.partitionWordCrossing (Q n) ((A.model n).action (sourceAlphaInclusion g))).card : ℝ) / (A.model n).size) atTop (nhds 0)"},{"kind":"theorem","name":"rooted_graph_boundary_lt_of_slow_tolerance","statement":"{h d q t N b c e : ℝ} (hh : 0 < h) (hd : 0 < d) (hq : q < 1) (ht : 0 < t) (hbad : 2 * d * b ≤ t) (hmissing : N - 2 * b ≤ c) (hboundary : e ≤ 3 * t) (hslow : 5 * (4 + h * (216 / (d * (1 - q) ^ 2) + 1 / d)) * t ≤ h * N) : e < (d * (1 - q) ^ 2 / 288) * c"},{"kind":"theorem","name":"rooted_graph_coefficient_small","statement":"{d q : ℝ} (hd : 0 < d) (hq : q < 1) : 0 < d * (1 - q) ^ 2 / 288 ∧ 216 * (d * (1 - q) ^ 2 / 288) < d * (1 - q) ^ 2"},{"kind":"theorem","name":"sourceCompressionUElement_conjugates_alpha","statement":"(g : SoficGroups.prefixElementaryGroup SoficGroups.alphaPrefixCode) : sourceCompressionUElement * sourceAlphaElement g * sourceCompressionUElement⁻¹ = sourceAlphaElement (sourceConjugatedAlphaUElement g)"},{"kind":"theorem","name":"sourceCompressionVElement_conjugates_alpha","statement":"(g : SoficGroups.prefixElementaryGroup SoficGroups.alphaPrefixCode) : sourceCompressionVElement * sourceAlphaElement g * sourceCompressionVElement⁻¹ = sourceAlphaElement (sourceConjugatedAlphaVElement g)"},{"kind":"theorem","name":"sourceCompressionTable_conjugates_alpha","statement":"(i : Fin 2) (g : SoficGroups.prefixElementaryGroup SoficGroups.alphaPrefixCode) : ∃ k : SoficGroups.prefixElementaryGroup SoficGroups.alphaPrefixCode, sourceCompressionTable i * sourceAlphaElement g * (sourceCompressionTable i)⁻¹ = sourceAlphaElement k"},{"kind":"theorem","name":"completedGoodPermutationGraphRootedModel_isGenerated","statement":"{G ι V : Type u} [Group G] [Fintype ι] [Fintype V] [DecidableEq V] (s : ι → G) (w : G → List ι) (σ : ι → Equiv.Perm V) (φ : G → Equiv.Perm V) (hword : ∀ g : G, φ g = ((w g).map σ).prod) (hone : φ 1 = 1) (hgenerator : ∀ i : ι, φ (s i) = σ i) (p : Equiv.Perm V) (B : Finset V) : (completedGoodPermutationGraphRootedModel σ φ p B).IsGenerated s w"},{"kind":"theorem","name":"completedGoodPermutationGraphRootedModel_isRootedAtRadius","statement":"{G ι V : Type u} [Group G] [Fintype V] [DecidableEq V] (w : G → List ι) (σ : ι → Equiv.Perm V) (φ : G → Equiv.Perm V) (p : Equiv.Perm V) (B : Finset V) (r : ℕ) (hroot : ∀ a g : G, (w a).length + (w g).length + (w (a * g)).length ≤ r → ∀ x : V, x ∉ B → φ (a * g) x = (φ a * φ g) x) : (completedGoodPermutationGraphRootedModel σ φ p B).IsRootedAtRadius w r"},{"kind":"theorem","name":"exists_completed_goodPermutationGraph_sparse_cut","statement":"{G : Type u} [Group G] (P : SoficGroups.KazhdanPair.{u, u} G) (S : Finset G) (honeS : 1 ∈ S) (hcover : P.generators ⊆ S) (hsymmetric : ∀ g ∈ S, g⁻¹ ∈ S) (w : G → List ↥S) (γ α : ℝ) (hγ : 0 < γ) (hα : 0 < α) (hγsmall : 216 * γ < (S.card : ℝ) * (1 - kazhdanMarkovContractionFactor P S) ^ 2) : ∃ r : ℕ, ∀ (V : Type u) [Fintype V] [DecidableEq V] (σ : ↥S → Equiv.Perm V) (φ : G → Equiv.Perm V), (∀ g : G, φ g = ((w g).map σ).prod) → φ 1 = 1 → (∀ i : ↥S, φ (i : G) = σ i) → ∀ (p : Equiv.Perm V) (B : Finset V), (∀ a g : G, (w a).length + (w g).length + (w (a * g)).length ≤ r → ∀ x : V, x ∉ B → φ (a * g) x = (φ a * φ g) x) → let T"},{"kind":"theorem","name":"intersection_generator_exit_subset_union","statement":"{V : Type*} [DecidableEq V] (p : Equiv.Perm V) (C D : Finset V) : ((C ∩ D).filter fun x => p x ∉ C ∩ D) ⊆ ((C.filter fun x => p x ∉ C) ∩ D) ∪ ((D.filter fun x => p x ∉ D) ∩ C)"},{"kind":"theorem","name":"sum_intersection_generator_exit_card_le","statement":"{V : Type*} [DecidableEq V] {U : Finset V} (P Q : Finpartition U) (p : Equiv.Perm V) : (∑ C ∈ P.parts, ∑ D ∈ Q.parts, ((C ∩ D).filter fun x => p x ∉ C ∩ D).card) ≤ (∑ C ∈ P.parts, (C.filter fun x => p x ∉ C).card) + (∑ D ∈ Q.parts, (D.filter fun x => p x ∉ D).card)"},{"kind":"theorem","name":"sum_intersection_boundary_le_partition_boundaries","statement":"{V ι : Type*} [DecidableEq V] [Fintype ι] {U : Finset V} (P Q : Finpartition U) (σ : ι → Equiv.Perm V) : (∑ C ∈ P.parts, ∑ D ∈ Q.parts, SoficGroups.boundary σ (C ∩ D)) ≤ (∑ C ∈ P.parts, SoficGroups.boundary σ C) + (∑ D ∈ Q.parts, SoficGroups.boundary σ D)"},{"kind":"theorem","name":"dominant_component_loss_le_ambient_intersection_boundaries","statement":"{V ι : Type*} [DecidableEq V] [Fintype ι] {U : Finset V} (P Q : Finpartition U) (σ : ι → Equiv.Perm V) (gamma : ℝ) (hexp : ∀ C ∈ P.parts, ∀ E : Finset V, E ⊆ C → 2 * E.card ≤ C.card → gamma * (E.card : ℝ) ≤ (SoficGroups.boundary σ E : ℝ)) (C : Finset V) (hC : C ∈ P.parts) : gamma * ((C.card : ℝ) - ((C ∩ SoficGroups.maximumOverlapPart Q C).card : ℝ)) ≤ ∑ E ∈ Q.parts, (SoficGroups.boundary σ (C ∩ E) : ℝ)"},{"kind":"theorem","name":"sum_dominant_component_losses_le_partition_boundaries","statement":"{V ι : Type*} [DecidableEq V] [Fintype ι] {U : Finset V} (P Q : Finpartition U) (σ : ι → Equiv.Perm V) (gamma : ℝ) (hexp : ∀ C ∈ P.parts, ∀ E : Finset V, E ⊆ C → 2 * E.card ≤ C.card → gamma * (E.card : ℝ) ≤ (SoficGroups.boundary σ E : ℝ)) : gamma * (∑ C ∈ P.parts, ((C.card : ℝ) - ((C ∩ SoficGroups.maximumOverlapPart Q C).card : ℝ))) ≤ (∑ C ∈ P.parts, (SoficGroups.boundary σ C : ℝ)) + (∑ D ∈ Q.parts, (SoficGroups.boundary σ D : ℝ))"},{"kind":"theorem","name":"dominant_component_loss_density_tendsto_zero","statement":"{V : ℕ → Type*} [∀ n, Fintype (V n)] [∀ n, Nonempty (V n)] [∀ n, DecidableEq (V n)] {ι : Type*} [Fintype ι] (P Q : ∀ n, Finpartition (Finset.univ : Finset (V n))) (σ : (n : ℕ) → ι → Equiv.Perm (V n)) (gamma : ℝ) (hgamma : 0 < gamma) (hexp : ∀ n C, C ∈ (P n).parts → ∀ E : Finset (V n), E ⊆ C → 2 * E.card ≤ C.card → gamma * (E.card : ℝ) ≤ (SoficGroups.boundary (σ n) E : ℝ)) (hsource : Tendsto (fun n => (∑ C ∈ (P n).parts, (SoficGroups.boundary (σ n) C : ℝ)) / Fintype.card (V n)) atTop (nhds 0)) (htarget : Tendsto (fun n => (∑ D ∈ (Q n).parts, (SoficGroups.boundary (σ n) D : ℝ)) / Fintype.card (V n)) atTop (nhds 0)) : Tendsto (fun n => (∑ C ∈ (P n).parts, ((C.card : ℝ) - ((C ∩ SoficGroups.maximumOverlapPart (Q n) C).card : ℝ))) / Fintype.card (V n)) atTop (nhds 0)"},{"kind":"theorem","name":"boundary_conjugate_map","statement":"{V ι : Type*} [DecidableEq V] [Fintype ι] (σ : ι → Equiv.Perm V) (T : Equiv.Perm V) (C : Finset V) : SoficGroups.boundary (fun i => T * σ i * T⁻¹) (C.map T.toEmbedding) = SoficGroups.boundary σ C"},{"kind":"theorem","name":"transportedUnivFinpartition_half_expansion","statement":"{V ι : Type*} [Fintype V] [DecidableEq V] [Fintype ι] (Q : Finpartition (Finset.univ : Finset V)) (σ : ι → Equiv.Perm V) (T : Equiv.Perm V) (gamma : ℝ) (hexp : ∀ C ∈ Q.parts, ∀ E : Finset V, E ⊆ C → 2 * E.card ≤ C.card → gamma * (E.card : ℝ) ≤ (SoficGroups.boundary σ E : ℝ)) : ∀ C ∈ (SoficGroups.transportedUnivFinpartition Q T).parts, ∀ E : Finset V, E ⊆ C → 2 * E.card ≤ C.card → gamma * (E.card : ℝ) ≤ (SoficGroups.boundary (fun i => T * σ i * T⁻¹) E : ℝ)"},{"kind":"theorem","name":"sum_boundary_transportedUnivFinpartition","statement":"{V ι : Type*} [Fintype V] [DecidableEq V] [Fintype ι] (Q : Finpartition (Finset.univ : Finset V)) (σ : ι → Equiv.Perm V) (T : Equiv.Perm V) : (∑ C ∈ (SoficGroups.transportedUnivFinpartition Q T).parts, SoficGroups.boundary (fun i => T * σ i * T⁻¹) C) = ∑ C ∈ Q.parts, SoficGroups.boundary σ C"},{"kind":"theorem","name":"transported_partition_boundary_density_tendsto_zero","statement":"{V : ℕ → Type*} [∀ n, Fintype (V n)] [∀ n, DecidableEq (V n)] {ι : Type*} [Fintype ι] (Q : ∀ n, Finpartition (Finset.univ : Finset (V n))) (σ : (n : ℕ) → ι → Equiv.Perm (V n)) (T : (n : ℕ) → Equiv.Perm (V n)) (hboundary : Tendsto (fun n => (∑ C ∈ (Q n).parts, (SoficGroups.boundary (σ n) C : ℝ)) / Fintype.card (V n)) atTop (nhds 0)) : Tendsto (fun n => (∑ C ∈ (SoficGroups.transportedUnivFinpartition (Q n) (T n)).parts, (SoficGroups.boundary (fun i => T n * σ n i * (T n)⁻¹) C : ℝ)) / Fintype.card (V n)) atTop (nhds 0)"},{"kind":"theorem","name":"exists_common_slow_overlap_scales_for_transported_partitions","statement":"{V : ℕ → Type*} [∀ n, Fintype (V n)] [∀ n, Nonempty (V n)] [∀ n, DecidableEq (V n)] {ι κ : Type*} [Fintype ι] [Fintype κ] (Q : ∀ n, Finpartition (Finset.univ : Finset (V n))) (σ : (n : ℕ) → ι → Equiv.Perm (V n)) (T : (n : ℕ) → κ → Equiv.Perm (V n)) (gamma : ℝ) (hgamma : 0 < gamma) (hexp : ∀ n C, C ∈ (Q n).parts → ∀ E : Finset (V n), E ⊆ C → 2 * E.card ≤ C.card → gamma * (E.card : ℝ) ≤ (SoficGroups.boundary (σ n) E : ℝ)) (hsource : Tendsto (fun n => (∑ C ∈ (Q n).parts, (SoficGroups.boundary (σ n) C : ℝ)) / Fintype.card (V n)) atTop (nhds 0)) (htarget : ∀ j : κ, Tendsto (fun n => (∑ D ∈ (Q n).parts, (SoficGroups.boundary (fun i => T n j * σ n i * (T n j)⁻¹) D : ℝ)) / Fintype.card (V n)) atTop (nhds 0)) : ∃ eta H : ℕ → ℝ, (∀ n, 0 < eta n) ∧ Antitone eta ∧ Tendsto eta atTop (nhds 0) ∧ (∀ n, 0 < H n) ∧ Antitone H ∧ Tendsto H atTop (nhds 0) ∧ Tendsto (fun n => eta n / H n) atTop (nhds 0) ∧ ∀ j : κ, Tendsto (fun n => (∑ C ∈ SoficGroups.insufficientOverlapComponents (SoficGroups.transportedUnivFinpartition (Q n) (T n j)) (Q n) (eta n), (C.card : ℝ)) / Fintype.card (V n)) atTop (nhds 0)"},{"kind":"theorem","name":"exists_uniform_radius_hasAlmostCentralizerImprovement","statement":"{G : Type u} [Group G] (P : SoficGroups.KazhdanPair.{u, u} G) (S : Finset G) (honeS : 1 ∈ S) (hcover : P.generators ⊆ S) (hsymmetric : ∀ g ∈ S, g⁻¹ ∈ S) (w : G → List ↥S) (h α : ℝ) (hpositive : 0 < h) (hα : 0 < α) : ∃ r : ℕ, ∀ (V : Type u) [Fintype V] [Nonempty V] [DecidableEq V] (σ : ↥S → Equiv.Perm V) (φ : G → Equiv.Perm V) (tolerance : ℕ) (B : Finset V), (∀ g : G, φ g = ((w g).map σ).prod) → φ 1 = 1 → (∀ i : ↥S, φ (i : G) = σ i) → (∀ A : Finset V, h * min (A.card : ℝ) ((Fintype.card V : ℝ) - A.card) ≤ (SoficGroups.boundary σ A : ℝ)) → (5 * (4 + h * (216 / ((S.card : ℝ) * (1 - kazhdanMarkovContractionFactor P S) ^ 2) + 1 / (S.card : ℝ))) * (tolerance : ℝ) ≤ h * (Fintype.card V : ℝ)) → (tolerance = 0 ∨ (0 < (tolerance : ℝ) ∧ α ≤ h * (tolerance : ℝ) / (2 * (h + 8 * (S.card : ℝ)) * (Fintype.card V : ℝ)) ∧ 2 * (S.card : ℝ) * (B.card : ℝ) ≤ (tolerance : ℝ) ∧ ∀ a g : G, (w a).length + (w g).length + (w (a * g)).length ≤ r → ∀ x : V, x ∉ B → φ (a * g) x = (φ a * φ g) x)) → SoficGroups.HasAlmostCentralizerImprovement σ tolerance"},{"kind":"theorem","name":"normalizedHamming_mul_le","statement":"{V : Type*} [Fintype V] [DecidableEq V] (p p' q q' : Equiv.Perm V) : SoficGroups.normalizedHamming (p * q) (p' * q') ≤ SoficGroups.normalizedHamming p p' + SoficGroups.normalizedHamming q q'"},{"kind":"theorem","name":"list_permutation_hamming_tendsto","statement":"(V : ℕ → Type*) [∀ n, Fintype (V n)] [∀ n, DecidableEq (V n)] {ι : Type*} (σ τ : ∀ n, ι → Equiv.Perm (V n)) (hletter : ∀ i : ι, Tendsto (fun n => SoficGroups.normalizedHamming (σ n i) (τ n i)) atTop (nhds 0)) (l : List ι) : Tendsto (fun n => SoficGroups.normalizedHamming ((l.map (σ n)).prod) ((l.map (τ n)).prod)) atTop (nhds 0)"},{"kind":"theorem","name":"approximate_action_list_prod_tendsto","statement":"{G : Type*} [Group G] (V : ℕ → Type*) [∀ n, Fintype (V n)] [∀ n, DecidableEq (V n)] (p : ∀ n, G → Equiv.Perm (V n)) (hone : ∀ n, p n 1 = 1) (hmul : ∀ a g : G, Tendsto (fun n => SoficGroups.normalizedHamming (p n (a * g)) (p n a * p n g)) atTop (nhds 0)) (l : List G) : Tendsto (fun n => SoficGroups.normalizedHamming (p n l.prod) ((l.map (p n)).prod)) atTop (nhds 0)"},{"kind":"theorem","name":"chosenWordEvaluation_tendsto_action","statement":"{G ι : Type*} [Group G] (V : ℕ → Type*) [∀ n, Fintype (V n)] [∀ n, DecidableEq (V n)] (p : ∀ n, G → Equiv.Perm (V n)) (hone : ∀ n, p n 1 = 1) (hmul : ∀ a g : G, Tendsto (fun n => SoficGroups.normalizedHamming (p n (a * g)) (p n a * p n g)) atTop (nhds 0)) (s : ι → G) (w : G → List ι) (hw : ∀ g : G, ((w g).map s).prod = g) (σ : ∀ n, ι → Equiv.Perm (V n)) (hletter : ∀ i : ι, Tendsto (fun n => SoficGroups.normalizedHamming (σ n i) (p n (s i))) atTop (nhds 0)) (g : G) : Tendsto (fun n => SoficGroups.normalizedHamming (chosenWordEvaluation (σ n) w g) (p n g)) atTop (nhds 0)"},{"kind":"theorem","name":"chosenWordEvaluation_multiplicative_tendsto","statement":"{G ι : Type*} [Group G] (V : ℕ → Type*) [∀ n, Fintype (V n)] [∀ n, DecidableEq (V n)] (p : ∀ n, G → Equiv.Perm (V n)) (hone : ∀ n, p n 1 = 1) (hmul : ∀ a g : G, Tendsto (fun n => SoficGroups.normalizedHamming (p n (a * g)) (p n a * p n g)) atTop (nhds 0)) (s : ι → G) (w : G → List ι) (hw : ∀ g : G, ((w g).map s).prod = g) (σ : ∀ n, ι → Equiv.Perm (V n)) (hletter : ∀ i : ι, Tendsto (fun n => SoficGroups.normalizedHamming (σ n i) (p n (s i))) atTop (nhds 0)) (a g : G) : Tendsto (fun n => SoficGroups.normalizedHamming (chosenWordEvaluation (σ n) w (a * g)) (chosenWordEvaluation (σ n) w a * chosenWordEvaluation (σ n) w g)) atTop (nhds 0)"},{"kind":"theorem","name":"completedGenerator_permutationDistance_le_deleted","statement":"{V : Type*} [Fintype V] [DecidableEq V] (σ : Equiv.Perm V) (Z : Finset V) (τ : Equiv.Perm {x : V // x ∈ Z}) (hagrees : ∀ x : {x : V // x ∈ Z}, σ (x : V) ∈ Z → ((τ x : {x : V // x ∈ Z}) : V) = σ (x : V)) : SoficGroups.permutationDistance τ (completedRestriction σ Z) ≤ (Finset.univ \\ Z).card"},{"kind":"theorem","name":"completedGenerator_normalizedHamming_le_deleted","statement":"{V : Type*} [Fintype V] [DecidableEq V] (σ : Equiv.Perm V) (Z : Finset V) (τ : Equiv.Perm {x : V // x ∈ Z}) (hagrees : ∀ x : {x : V // x ∈ Z}, σ (x : V) ∈ Z → ((τ x : {x : V // x ∈ Z}) : V) = σ (x : V)) : SoficGroups.normalizedHamming τ (completedRestriction σ Z) ≤ (((Finset.univ \\ Z).card : ℝ) / Z.card)"},{"kind":"theorem","name":"completedGenerator_normalizedHamming_tendsto_zero","statement":"(V : ℕ → Type*) [∀ n, Fintype (V n)] [∀ n, DecidableEq (V n)] (σ : (n : ℕ) → Equiv.Perm (V n)) (Z : (n : ℕ) → Finset (V n)) (τ : (n : ℕ) → Equiv.Perm {x : V n // x ∈ Z n}) (hagrees : ∀ n, ∀ x : {x : V n // x ∈ Z n}, σ n (x : V n) ∈ Z n → ((τ n x : {x : V n // x ∈ Z n}) : V n) = σ n (x : V n)) (hdeleted : Tendsto (fun n => (((Finset.univ \\ Z n).card : ℝ) / (Z n).card)) atTop (nhds 0)) : Tendsto (fun n => SoficGroups.normalizedHamming (τ n) (completedRestriction (σ n) (Z n))) atTop (nhds 0)"},{"kind":"theorem","name":"surviving_card_ratio_tendsto_one","statement":"(V : ℕ → Type*) [∀ n, Fintype (V n)] [∀ n, DecidableEq (V n)] (D : (n : ℕ) → Finset (V n)) (hZ : ∀ n, (Finset.univ \\ D n : Finset (V n)).Nonempty) (hdeleted : Tendsto (fun n => ((D n).card : ℝ) / Fintype.card (V n)) atTop (nhds 0)) : Tendsto (fun n => (((Finset.univ \\ D n : Finset (V n)).card : ℝ) / Fintype.card (V n))) atTop (nhds 1)"},{"kind":"theorem","name":"deleted_density_relative_survivors","statement":"(V : ℕ → Type*) [∀ n, Fintype (V n)] [∀ n, DecidableEq (V n)] (D : (n : ℕ) → Finset (V n)) (hZ : ∀ n, (Finset.univ \\ D n : Finset (V n)).Nonempty) (hdeleted : Tendsto (fun n => ((D n).card : ℝ) / Fintype.card (V n)) atTop (nhds 0)) : Tendsto (fun n => ((D n).card : ℝ) / (Finset.univ \\ D n : Finset (V n)).card) atTop (nhds 0)"},{"kind":"theorem","name":"twiceCompleted_sourceGenerator_normalizedHamming_tendsto_zero","statement":"(V : ℕ → Type*) [∀ n, Fintype (V n)] [∀ n, DecidableEq (V n)] {ι J : Type*} (σ : (n : ℕ) → ι → Equiv.Perm (V n)) (p : (n : ℕ) → J → Equiv.Perm (V n)) (s : ι → J) (P : (n : ℕ) → Finset (V n)) (D : (n : ℕ) → Finset {x : V n // x ∈ P n}) (τ : (n : ℕ) → (i : ι) → Equiv.Perm {x : {x : V n // x ∈ P n} // x ∈ (Finset.univ \\ D n : Finset {x : V n // x ∈ P n})}) (hsource : ∀ n i, σ n i = p n (s i)) (hagrees : ∀ n i, ∀ x : {x : {x : V n // x ∈ P n} // x ∈ (Finset.univ \\ D n : Finset {x : V n // x ∈ P n})}, completedRestriction (σ n i) (P n) x.val ∈ (Finset.univ \\ D n : Finset {x : V n // x ∈ P n}) → (τ n i x).val = completedRestriction (σ n i) (P n) x.val) (hZ : ∀ n, (Finset.univ \\ D n : Finset {x : V n // x ∈ P n}).Nonempty) (hdeleted : Tendsto (fun n => ((D n).card : ℝ) / (P n).card) atTop (nhds 0)) : ∀ i : ι, Tendsto (fun n => SoficGroups.normalizedHamming (τ n i) (completedRestriction (completedRestriction (p n (s i)) (P n)) (Finset.univ \\ D n))) atTop (nhds 0)"},{"kind":"theorem","name":"mem_generator_pow_of_chosen_word_length","statement":"{G : Type*} [Group G] [DecidableEq G] (S : Finset G) (hone : 1 ∈ S) (w : G → List ↥S) (hw : ∀ a : G, ((w a).map fun i : ↥S => (i : G)).prod = a) {a : G} {r : ℕ} (ha : (w a).length ≤ r) : a ∈ S ^ r"},{"kind":"theorem","name":"fixedRadiusRootBad_rooted","statement":"{G V : Type*} [Group G] [DecidableEq G] [Fintype V] [DecidableEq V] (S : Finset G) (hone : 1 ∈ S) (w : G → List ↥S) (hw : ∀ a : G, ((w a).map fun i : ↥S => (i : G)).prod = a) (φ : G → Equiv.Perm V) (r : ℕ) (a g : G) (hr : (w a).length + (w g).length + (w (a * g)).length ≤ r) (x : V) (hx : x ∉ fixedRadiusRootBad φ S r) : φ (a * g) x = (φ a * φ g) x"},{"kind":"theorem","name":"fixedRadiusRootBad_density_tendsto_zero","statement":"{G : Type*} [Group G] [DecidableEq G] (V : ℕ → Type*) [∀ n, Fintype (V n)] [∀ n, DecidableEq (V n)] (φ : ∀ n, G → Equiv.Perm (V n)) (S : Finset G) (hmul : ∀ a g : G, Tendsto (fun n => SoficGroups.normalizedHamming (φ n (a * g)) (φ n a * φ n g)) atTop (𝓝 0)) (r : ℕ) : Tendsto (fun n => ((fixedRadiusRootBad (φ n) S r).card : ℝ) / Fintype.card (V n)) atTop (𝓝 0)"},{"kind":"theorem","name":"exists_source_sparse_cut_at_radius","statement":"{G : Type} [Group G] [DecidableEq G] (P : SoficGroups.KazhdanPair.{0, 0} G) (S : Finset G) (hone : 1 ∈ S) (hcover : P.generators ⊆ S) (hsymmetric : ∀ g ∈ S, g⁻¹ ∈ S) (hgenerates : Subgroup.closure (S : Set G) = ⊤) (γ α : ℝ) (hγ : 0 < γ) (hα : 0 < α) (hsmall : 216 * γ < (S.card : ℝ) * (1 - kazhdanMarkovContractionFactor P S) ^ 2) : ∃ r : ℕ, ∀ (A : SoficGroups.SoficApproximation G) (n : ℕ) (T : Finset (Fin (A.model n).size)), Disjoint T (chosenCayleyRadiusBad A S (symmetricGeneratorWord S hsymmetric hgenerates) n r) → (SoficGroups.boundary (fun i : ↥S => (A.model n).action (i : G)) T : ℝ) < γ * (T.card : ℝ) → ∃ U : Finset (Fin (A.model n).size), 3 * (U ∆ T).card < T.card ∧ (SoficGroups.boundary (fun i : ↥S => (A.model n).action (i : G)) U : ℝ) ≤ α * (U.card : ℝ)"},{"kind":"theorem","name":"exists_source_full_finpartition_sequence_of_kazhdan","statement":"{G : Type} [Group G] [DecidableEq G] (A : SoficGroups.SoficApproximation G) (P : SoficGroups.KazhdanPair.{0, 0} G) (S : Finset G) (hone : 1 ∈ S) (hcover : P.generators ⊆ S) (hsymmetric : ∀ g ∈ S, g⁻¹ ∈ S) (hgenerates : Subgroup.closure (S : Set G) = ⊤) : ∃ (γ : ℝ) (Q : (n : ℕ) → Finpartition (Finset.univ : Finset (Fin (A.model n).size))), 0 < γ ∧ (∀ n, ∀ C ∈ (Q n).parts, ∀ E : Finset (Fin (A.model n).size), E ⊆ C → 2 * E.card ≤ C.card → γ * (E.card : ℝ) ≤ (SoficGroups.boundary (fun i : ↥S => (A.model n).action (i : G)) E : ℝ)) ∧ Tendsto (fun n => (∑ C ∈ (Q n).parts, (SoficGroups.boundary (fun i : ↥S => (A.model n).action (i : G)) C : ℝ)) / (A.model n).size) atTop (𝓝 0)"},{"kind":"theorem","name":"exists_source_subgroup_and_ambient_full_finpartition_sequences","statement":"{G Γ : Type} [Group G] [Group Γ] [DecidableEq G] [DecidableEq Γ] (A : SoficGroups.SoficApproximation G) (f : Γ →* G) (hf : Function.Injective f) (PΓ : SoficGroups.KazhdanPair.{0, 0} Γ) (PG : SoficGroups.KazhdanPair.{0, 0} G) (SΓ : Finset Γ) (SG : Finset G) (honeΓ : 1 ∈ SΓ) (honeG : 1 ∈ SG) (hcoverΓ : PΓ.generators ⊆ SΓ) (hcoverG : PG.generators ⊆ SG) (hsymmetricΓ : ∀ g ∈ SΓ, g⁻¹ ∈ SΓ) (hsymmetricG : ∀ g ∈ SG, g⁻¹ ∈ SG) (hgeneratesΓ : Subgroup.closure (SΓ : Set Γ) = ⊤) (hgeneratesG : Subgroup.closure (SG : Set G) = ⊤) : ∃ (γΓ γG : ℝ) (QΓ QG : (n : ℕ) → Finpartition (Finset.univ : Finset (Fin (A.model n).size))), 0 < γΓ ∧ 0 < γG ∧ (∀ n, ∀ C ∈ (QΓ n).parts, ∀ E : Finset (Fin (A.model n).size), E ⊆ C → 2 * E.card ≤ C.card → γΓ * (E.card : ℝ) ≤ (SoficGroups.boundary (fun i : ↥SΓ => (A.model n).action (f (i : Γ))) E : ℝ)) ∧ (∀ n, ∀ C ∈ (QG n).parts, ∀ E : Finset (Fin (A.model n).size), E ⊆ C → 2 * E.card ≤ C.card → γG * (E.card : ℝ) ≤ (SoficGroups.boundary (fun i : ↥SG => (A.model n).action (i : G)) E : ℝ)) ∧ Tendsto (fun n => (∑ C ∈ (QΓ n).parts, (SoficGroups.boundary (fun i : ↥SΓ => (A.model n).action (f (i : Γ))) C : ℝ)) / (A.model n).size) atTop (𝓝 0) ∧ Tendsto (fun n => (∑ C ∈ (QG n).parts, (SoficGroups.boundary (fun i : ↥SG => (A.model n).action (i : G)) C : ℝ)) / (A.model n).size) atTop (𝓝 0)"},{"kind":"theorem","name":"alphaZeroPrefixElementaryGroup_infinite","statement":"Infinite (SoficGroups.prefixElementaryGroup SoficGroups.alphaZeroPrefixCode)"},{"kind":"theorem","name":"unitary_word_displacement_le","statement":"{G : Type u} {H : Type v} [Group G] [NormedAddCommGroup H] [InnerProductSpace ℂ H] (π : SoficGroups.UnitaryRepresentation G H) (ξ : H) (l : List G) (δ : ℝ) (hletters : ∀ g ∈ l, ‖π g ξ - ξ‖ ≤ δ) : ‖π l.prod ξ - ξ‖ ≤ (l.length : ℝ) * δ"},{"kind":"theorem","name":"exists_word_of_symmetric_generating_finset","statement":"{G : Type u} [Group G] (S : Finset G) (hsymmetric : ∀ g ∈ S, g⁻¹ ∈ S) (hgenerates : Subgroup.closure (S : Set G) = ⊤) (g : G) : ∃ l : List ↥S, ((l.map fun i : ↥S => (i : G)).prod) = g"},{"kind":"theorem","name":"symmetricGeneratingWord_prod","statement":"{G : Type u} [Group G] (S : Finset G) (hsymmetric : ∀ g ∈ S, g⁻¹ ∈ S) (hgenerates : Subgroup.closure (S : Set G) = ⊤) (g : G) : (((symmetricGeneratingWord S hsymmetric hgenerates g).map fun i : ↥S => (i : G)).prod) = g"},{"kind":"theorem","name":"kazhdanPairOnSymmetricGeneratingFinset_generators","statement":"{G : Type u} [Group G] (P : SoficGroups.KazhdanPair.{u, v} G) (S : Finset G) (hsymmetric : ∀ g ∈ S, g⁻¹ ∈ S) (hgenerates : Subgroup.closure (S : Set G) = ⊤) : (kazhdanPairOnSymmetricGeneratingFinset P S hsymmetric hgenerates).generators = S"},{"kind":"theorem","name":"exists_kazhdanPair_with_exact_symmetric_generators","statement":"{G : Type u} [Group G] [SoficGroups.HasPropertyT.{u, v} G] (S : Finset G) (hsymmetric : ∀ g ∈ S, g⁻¹ ∈ S) (hgenerates : Subgroup.closure (S : Set G) = ⊤) : ∃ P : SoficGroups.KazhdanPair.{u, v} G, P.generators = S"},{"kind":"theorem","name":"sourceAlphaInclusion_injective","statement":"Function.Injective sourceAlphaInclusion"},{"kind":"theorem","name":"one_mem_sourceAmbientSymmetricGenerators","statement":"(SΓ : Finset (SoficGroups.prefixElementaryGroup SoficGroups.alphaPrefixCode)) : 1 ∈ sourceAmbientSymmetricGenerators SΓ"},{"kind":"theorem","name":"sourceAmbientSymmetricGenerators_inv_mem","statement":"(SΓ : Finset (SoficGroups.prefixElementaryGroup SoficGroups.alphaPrefixCode)) (g : SoficGroups.prefixElementaryGroup SoficGroups.ninePrefixCode) (hg : g ∈ sourceAmbientSymmetricGenerators SΓ) : g⁻¹ ∈ sourceAmbientSymmetricGenerators SΓ"},{"kind":"theorem","name":"sourceAmbientSymmetricGenerators_generate","statement":"(SΓ : Finset (SoficGroups.prefixElementaryGroup SoficGroups.alphaPrefixCode)) (hgeneratesΓ : Subgroup.closure (SΓ : Set (SoficGroups.prefixElementaryGroup SoficGroups.alphaPrefixCode)) = ⊤) : Subgroup.closure (sourceAmbientSymmetricGenerators SΓ : Set (SoficGroups.prefixElementaryGroup SoficGroups.ninePrefixCode)) = ⊤"},{"kind":"theorem","name":"exists_kazhdanPair_on_exact_sourceAmbientSymmetricGenerators","statement":"(SΓ : Finset (SoficGroups.prefixElementaryGroup SoficGroups.alphaPrefixCode)) (hgeneratesΓ : Subgroup.closure (SΓ : Set (SoficGroups.prefixElementaryGroup SoficGroups.alphaPrefixCode)) = ⊤) [SoficGroups.HasPropertyT.{0, 0} (SoficGroups.prefixElementaryGroup SoficGroups.ninePrefixCode)] : ∃ P : SoficGroups.KazhdanPair.{0, 0} (SoficGroups.prefixElementaryGroup SoficGroups.ninePrefixCode), P.generators = sourceAmbientSymmetricGenerators SΓ"},{"kind":"theorem","name":"range_sourcePositiveGeneratorMap","statement":"(SΓ : Finset (SoficGroups.prefixElementaryGroup SoficGroups.alphaPrefixCode)) : Set.range (sourcePositiveGeneratorMap SΓ) = (sourcePositiveGenerators SΓ : Set (SoficGroups.prefixElementaryGroup SoficGroups.ninePrefixCode))"},{"kind":"theorem","name":"sourcePositiveGenerators_generate","statement":"(SΓ : Finset (SoficGroups.prefixElementaryGroup SoficGroups.alphaPrefixCode)) (hgeneratesΓ : Subgroup.closure (SΓ : Set (SoficGroups.prefixElementaryGroup SoficGroups.alphaPrefixCode)) = ⊤) : Subgroup.closure (sourcePositiveGenerators SΓ : Set (SoficGroups.prefixElementaryGroup SoficGroups.ninePrefixCode)) = ⊤"},{"kind":"theorem","name":"sourcePositiveGeneratorMap_range_generate","statement":"(SΓ : Finset (SoficGroups.prefixElementaryGroup SoficGroups.alphaPrefixCode)) (hgeneratesΓ : Subgroup.closure (SΓ : Set (SoficGroups.prefixElementaryGroup SoficGroups.alphaPrefixCode)) = ⊤) : Subgroup.closure (Set.range (sourcePositiveGeneratorMap SΓ)) = ⊤"},{"kind":"theorem","name":"exists_symmetric_generating_finset_of_finitelyGenerated","statement":"{G : Type*} [Group G] (hfg : Group.FG G) : ∃ S : Finset G, 1 ∈ S ∧ (∀ g ∈ S, g⁻¹ ∈ S) ∧ Subgroup.closure (S : Set G) = ⊤"},{"kind":"theorem","name":"exists_actual_source_alpha_symmetric_generators","statement":"∃ SΓ : Finset (SoficGroups.prefixElementaryGroup SoficGroups.alphaPrefixCode), 1 ∈ SΓ ∧ (∀ g ∈ SΓ, g⁻¹ ∈ SΓ) ∧ Subgroup.closure (SΓ : Set (SoficGroups.prefixElementaryGroup SoficGroups.alphaPrefixCode)) = ⊤"},{"kind":"theorem","name":"exists_unconditional_actual_source_generator_data","statement":"∃ (SΓ : Finset (SoficGroups.prefixElementaryGroup SoficGroups.alphaPrefixCode)) (PΓ : SoficGroups.KazhdanPair.{0, 0} (SoficGroups.prefixElementaryGroup SoficGroups.alphaPrefixCode)) (PG : SoficGroups.KazhdanPair.{0, 0} (SoficGroups.prefixElementaryGroup SoficGroups.ninePrefixCode)), 1 ∈ SΓ ∧ (∀ g ∈ SΓ, g⁻¹ ∈ SΓ) ∧ Subgroup.closure (SΓ : Set (SoficGroups.prefixElementaryGroup SoficGroups.alphaPrefixCode)) = ⊤ ∧ PΓ.generators = SΓ ∧ 1 ∈ sourceAmbientSymmetricGenerators SΓ ∧ (∀ g ∈ sourceAmbientSymmetricGenerators SΓ, g⁻¹ ∈ sourceAmbientSymmetricGenerators SΓ) ∧ Subgroup.closure (sourceAmbientSymmetricGenerators SΓ : Set (SoficGroups.prefixElementaryGroup SoficGroups.ninePrefixCode)) = ⊤ ∧ PG.generators = sourceAmbientSymmetricGenerators SΓ ∧ Function.Injective sourceAlphaInclusion ∧ Subgroup.closure (Set.range (sourcePositiveGeneratorMap SΓ)) = ⊤"},{"kind":"theorem","name":"familyComparisonBad_card","statement":"{V ι : Type*} [Fintype V] [DecidableEq V] [Fintype ι] (Q : Finpartition (Finset.univ : Finset V)) (p : ι → Equiv.Perm V) (eta : ℝ) : (familyComparisonBad Q p eta).card = ∑ i : ι, (comparisonBad Q (p i) eta).card"},{"kind":"theorem","name":"comparisonBad_subset_partitionWordCrossing","statement":"{V : Type*} [Fintype V] [DecidableEq V] (Q : Finpartition (Finset.univ : Finset V)) (p : Equiv.Perm V) (eta : ℝ) (heta : 0 ≤ eta) : comparisonBad Q p eta ⊆ SoficGroups.partitionWordCrossing Q p"},{"kind":"theorem","name":"comparisonBad_subset_matchedWordPreimageBad","statement":"{V : Type*} [Fintype V] [DecidableEq V] (Q : Finpartition (Finset.univ : Finset V)) (T : Equiv.Perm V) (eta : ℝ) : comparisonBad Q T eta ⊆ SoficGroups.matchedWordPreimageBad (Finset.univ : Finset V) (overlapRetainedComponents Q T eta) (SoficGroups.maximumOverlapPart Q) T"},{"kind":"theorem","name":"matchedCore_missing_card_le_overlap_and_loss","statement":"{V : Type*} [Fintype V] [DecidableEq V] (Q : Finpartition (Finset.univ : Finset V)) (T : Equiv.Perm V) (eta : ℝ) : ((Finset.univ : Finset V) \\ SoficGroups.matchedCore (overlapRetainedComponents Q T eta) (SoficGroups.maximumOverlapPart Q)).card ≤ (∑ C ∈ SoficGroups.insufficientOverlapComponents (SoficGroups.transportedUnivFinpartition Q T) Q eta, C.card) + ∑ C ∈ (SoficGroups.transportedUnivFinpartition Q T).parts, (C \\ SoficGroups.maximumOverlapPart Q C).card"},{"kind":"theorem","name":"comparisonBad_card_le_overlap_and_loss","statement":"{V : Type*} [Fintype V] [DecidableEq V] (Q : Finpartition (Finset.univ : Finset V)) (T : Equiv.Perm V) (eta : ℝ) : (comparisonBad Q T eta).card ≤ (∑ C ∈ SoficGroups.insufficientOverlapComponents (SoficGroups.transportedUnivFinpartition Q T) Q eta, C.card) + ∑ C ∈ (SoficGroups.transportedUnivFinpartition Q T).parts, (C \\ SoficGroups.maximumOverlapPart Q C).card"},{"kind":"theorem","name":"cast_card_sdiff_eq_sub_card_inter","statement":"{V : Type*} [DecidableEq V] (C D : Finset V) : ((C \\ D).card : ℝ) = (C.card : ℝ) - ((C ∩ D).card : ℝ)"},{"kind":"theorem","name":"subgroup_comparisonBad_density_tendsto_zero","statement":"(V : ℕ → Type*) [∀ n, Fintype (V n)] [∀ n, DecidableEq (V n)] (Q : (n : ℕ) → Finpartition (Finset.univ : Finset (V n))) (p : (n : ℕ) → Equiv.Perm (V n)) (eta : ℕ → ℝ) (heta : ∀ n, 0 ≤ eta n) (hcross : Tendsto (fun n => ((SoficGroups.partitionWordCrossing (Q n) (p n)).card : ℝ) / Fintype.card (V n)) atTop (nhds 0)) : Tendsto (fun n => ((comparisonBad (Q n) (p n) (eta n)).card : ℝ) / Fintype.card (V n)) atTop (nhds 0)"},{"kind":"theorem","name":"transported_comparisonBad_density_tendsto_zero","statement":"(V : ℕ → Type*) [∀ n, Fintype (V n)] [∀ n, DecidableEq (V n)] (Q : (n : ℕ) → Finpartition (Finset.univ : Finset (V n))) (T : (n : ℕ) → Equiv.Perm (V n)) (eta : ℕ → ℝ) (hoverlap : Tendsto (fun n => (∑ C ∈ SoficGroups.insufficientOverlapComponents (SoficGroups.transportedUnivFinpartition (Q n) (T n)) (Q n) (eta n), (C.card : ℝ)) / Fintype.card (V n)) atTop (nhds 0)) (hloss : Tendsto (fun n => (∑ C ∈ (SoficGroups.transportedUnivFinpartition (Q n) (T n)).parts, ((C.card : ℝ) - ((C ∩ SoficGroups.maximumOverlapPart (Q n) C).card : ℝ))) / Fintype.card (V n)) atTop (nhds 0)) : Tendsto (fun n => ((comparisonBad (Q n) (T n) (eta n)).card : ℝ) / Fintype.card (V n)) atTop (nhds 0)"},{"kind":"theorem","name":"combined_positive_comparisonBad_density_tendsto_zero","statement":"(V : ℕ → Type*) [∀ n, Fintype (V n)] [∀ n, DecidableEq (V n)] (ι κ : Type*) [Fintype ι] [Fintype κ] (Q : (n : ℕ) → Finpartition (Finset.univ : Finset (V n))) (σ : (n : ℕ) → ι → Equiv.Perm (V n)) (T : (n : ℕ) → κ → Equiv.Perm (V n)) (eta : ℕ → ℝ) (heta : ∀ n, 0 ≤ eta n) (hcross : ∀ i : ι, Tendsto (fun n => ((SoficGroups.partitionWordCrossing (Q n) (σ n i)).card : ℝ) / Fintype.card (V n)) atTop (nhds 0)) (hoverlap : ∀ j : κ, Tendsto (fun n => (∑ C ∈ SoficGroups.insufficientOverlapComponents (SoficGroups.transportedUnivFinpartition (Q n) (T n j)) (Q n) (eta n), (C.card : ℝ)) / Fintype.card (V n)) atTop (nhds 0)) (hloss : ∀ j : κ, Tendsto (fun n => (∑ C ∈ (SoficGroups.transportedUnivFinpartition (Q n) (T n j)).parts, ((C.card : ℝ) - ((C ∩ SoficGroups.maximumOverlapPart (Q n) C).card : ℝ))) / Fintype.card (V n)) atTop (nhds 0)) : Tendsto (fun n => ((familyComparisonBad (Q n) (Sum.elim (σ n) (T n)) (eta n)).card : ℝ) / Fintype.card (V n)) atTop (nhds 0)"},{"kind":"theorem","name":"componentSizeComparison_of_not_mem","statement":"{V ι : Type*} [Fintype V] [DecidableEq V] [Fintype ι] (Q : Finpartition (Finset.univ : Finset V)) (p : ι → Equiv.Perm V) (eta : ℝ) (i : ι) (x : V) (hx : (i, x) ∉ componentSizeComparisonBad Q p eta) : (1 - eta) * realComponentSize Q x ≤ realComponentSize Q (p i x)"},{"kind":"theorem","name":"exists_common_component_log_rank_with_vanishing_drops","statement":"(V : ℕ → Type*) [∀ n, Fintype (V n)] [∀ n, Nonempty (V n)] [∀ n, DecidableEq (V n)] (ι : Type*) [Fintype ι] (Q : (n : ℕ) → Finpartition (Finset.univ : Finset (V n))) (p : (n : ℕ) → ι → Equiv.Perm (V n)) (eta H : ℕ → ℝ) (heta0 : ∀ n, 0 ≤ eta n) (heta1 : ∀ n, eta n < 1) (hH : ∀ n, 0 < H n) (heta : Tendsto eta atTop (nhds 0)) (hratio : Tendsto (fun n => eta n / H n) atTop (nhds 0)) (hbad : Tendsto (fun n => ((componentSizeComparisonBad (Q n) (p n) (eta n)).card : ℝ) / Fintype.card (V n)) atTop (nhds 0)) : ∃ r : ℕ → ℝ, (∀ n, r n ∈ Set.Ico 0 (H n)) ∧ Tendsto (fun n => (∑ i : ι, ((SoficGroups.MidrankPermutationEnergy.rankDecreasingVertices Finset.univ (componentLogRank (Q n) (H n) (r n)) (p n i)).card : ℝ)) / Fintype.card (V n)) atTop (nhds 0)"},{"kind":"theorem","name":"exists_common_component_log_rank_with_vanishing_midrank_energy","statement":"(V : ℕ → Type*) [∀ n, Fintype (V n)] [∀ n, Nonempty (V n)] [∀ n, DecidableEq (V n)] (ι : Type*) [Fintype ι] (Q A : (n : ℕ) → Finpartition (Finset.univ : Finset (V n))) (p : (n : ℕ) → ι → Equiv.Perm (V n)) (eta H : ℕ → ℝ) (heta0 : ∀ n, 0 ≤ eta n) (heta1 : ∀ n, eta n < 1) (hH : ∀ n, 0 < H n) (heta : Tendsto eta atTop (nhds 0)) (hratio : Tendsto (fun n => eta n / H n) atTop (nhds 0)) (hbad : Tendsto (fun n => ((componentSizeComparisonBad (Q n) (p n) (eta n)).card : ℝ) / Fintype.card (V n)) atTop (nhds 0)) (hcross : Tendsto (fun n => (∑ i : ι, ((SoficGroups.partitionWordCrossing (A n) (p n i)).card : ℝ)) / Fintype.card (V n)) atTop (nhds 0)) : ∃ r : ℕ → ℝ, (∀ n, r n ∈ Set.Ico 0 (H n)) ∧ Tendsto (fun n => (∑ i : ι, ((SoficGroups.MidrankPermutationEnergy.rankDecreasingVertices Finset.univ (componentLogRank (Q n) (H n) (r n)) (p n i)).card : ℝ)) / Fintype.card (V n)) atTop (nhds 0) ∧ Tendsto (fun n => (∑ i : ι, ∑ x : V n, (SoficGroups.MidrankPermutationEnergy.partitionVertexMidrank (A n) (componentLogRank (Q n) (H n) (r n)) (p n i x) - SoficGroups.MidrankPermutationEnergy.partitionVertexMidrank (A n) (componentLogRank (Q n) (H n) (r n)) x) ^ 2) / Fintype.card (V n)) atTop (nhds 0)"},{"kind":"theorem","name":"exists_common_positive_component_log_rank_with_vanishing_midrank_energy","statement":"(V : ℕ → Type*) [∀ n, Fintype (V n)] [∀ n, Nonempty (V n)] [∀ n, DecidableEq (V n)] (ι κ : Type*) [Fintype ι] [Fintype κ] (Q A : (n : ℕ) → Finpartition (Finset.univ : Finset (V n))) (σ : (n : ℕ) → ι → Equiv.Perm (V n)) (T : (n : ℕ) → κ → Equiv.Perm (V n)) (eta H : ℕ → ℝ) (heta0 : ∀ n, 0 ≤ eta n) (heta1 : ∀ n, eta n < 1) (hH : ∀ n, 0 < H n) (heta : Tendsto eta atTop (nhds 0)) (hratio : Tendsto (fun n => eta n / H n) atTop (nhds 0)) (hcrossQ : ∀ i : ι, Tendsto (fun n => ((SoficGroups.partitionWordCrossing (Q n) (σ n i)).card : ℝ) / Fintype.card (V n)) atTop (nhds 0)) (hoverlap : ∀ j : κ, Tendsto (fun n => (∑ C ∈ SoficGroups.insufficientOverlapComponents (SoficGroups.transportedUnivFinpartition (Q n) (T n j)) (Q n) (eta n), (C.card : ℝ)) / Fintype.card (V n)) atTop (nhds 0)) (hloss : ∀ j : κ, Tendsto (fun n => (∑ C ∈ (SoficGroups.transportedUnivFinpartition (Q n) (T n j)).parts, ((C.card : ℝ) - ((C ∩ SoficGroups.maximumOverlapPart (Q n) C).card : ℝ))) / Fintype.card (V n)) atTop (nhds 0)) (hcrossA : Tendsto (fun n => (∑ i : ι ⊕ κ, ((SoficGroups.partitionWordCrossing (A n) (Sum.elim (σ n) (T n) i)).card : ℝ)) / Fintype.card (V n)) atTop (nhds 0)) : ∃ r : ℕ → ℝ, (∀ n, r n ∈ Set.Ico 0 (H n)) ∧ Tendsto (fun n => (∑ i : ι ⊕ κ, ((SoficGroups.MidrankPermutationEnergy.rankDecreasingVertices Finset.univ (SoficGroups.SourceCommonOffsetMidrankEnergy.componentLogRank (Q n) (H n) (r n)) (Sum.elim (σ n) (T n) i)).card : ℝ)) / Fintype.card (V n)) atTop (nhds 0) ∧ Tendsto (fun n => (∑ i : ι ⊕ κ, ∑ x : V n, (SoficGroups.MidrankPermutationEnergy.partitionVertexMidrank (A n) (SoficGroups.SourceCommonOffsetMidrankEnergy.componentLogRank (Q n) (H n) (r n)) (Sum.elim (σ n) (T n) i x) - SoficGroups.MidrankPermutationEnergy.partitionVertexMidrank (A n) (SoficGroups.SourceCommonOffsetMidrankEnergy.componentLogRank (Q n) (H n) (r n)) x) ^ 2) / Fintype.card (V n)) atTop (nhds 0)"},{"kind":"theorem","name":"squaredPermutationEnergy_nonneg","statement":"{V : Type*} [Fintype V] (f : V → ℝ) (p : Equiv.Perm V) : 0 ≤ squaredPermutationEnergy f p"},{"kind":"theorem","name":"squaredPermutationEnergy_inv","statement":"{V : Type*} [Fintype V] (f : V → ℝ) (p : Equiv.Perm V) : squaredPermutationEnergy f p⁻¹ = squaredPermutationEnergy f p"},{"kind":"theorem","name":"squaredPermutationEnergy_mul_le","statement":"{V : Type*} [Fintype V] (f : V → ℝ) (p q : Equiv.Perm V) : squaredPermutationEnergy f (p * q) ≤ 2 * squaredPermutationEnergy f p + 2 * squaredPermutationEnergy f q"},{"kind":"theorem","name":"squaredPermutationEnergy_le_add_hammingDist","statement":"{V : Type*} [Fintype V] [DecidableEq V] (f : V → ℝ) (hf0 : ∀ x, 0 ≤ f x) (hf1 : ∀ x, f x ≤ 1) (p q : Equiv.Perm V) : squaredPermutationEnergy f p ≤ squaredPermutationEnergy f q + (hammingDist (fun x => p x) (fun x => q x) : ℝ)"},{"kind":"theorem","name":"squaredPermutationEnergy_tendsto_of_normalizedHamming","statement":"(V : ℕ → Type*) [∀ n, Fintype (V n)] [∀ n, DecidableEq (V n)] (f : (n : ℕ) → V n → ℝ) (hf0 : ∀ n x, 0 ≤ f n x) (hf1 : ∀ n x, f n x ≤ 1) (p q : (n : ℕ) → Equiv.Perm (V n)) (hq : Tendsto (fun n => squaredPermutationEnergy (f n) (q n) / Fintype.card (V n)) atTop (𝓝 0)) (hd : Tendsto (fun n => SoficGroups.normalizedHamming (p n) (q n)) atTop (𝓝 0)) : Tendsto (fun n => squaredPermutationEnergy (f n) (p n) / Fintype.card (V n)) atTop (𝓝 0)"},{"kind":"theorem","name":"squaredPermutationEnergy_mul_tendsto_zero","statement":"(V : ℕ → Type*) [∀ n, Fintype (V n)] (f : (n : ℕ) → V n → ℝ) (p q : (n : ℕ) → Equiv.Perm (V n)) (hp : Tendsto (fun n => squaredPermutationEnergy (f n) (p n) / Fintype.card (V n)) atTop (𝓝 0)) (hq : Tendsto (fun n => squaredPermutationEnergy (f n) (q n) / Fintype.card (V n)) atTop (𝓝 0)) : Tendsto (fun n => squaredPermutationEnergy (f n) (p n * q n) / Fintype.card (V n)) atTop (𝓝 0)"},{"kind":"theorem","name":"sofic_action_inverse_normalizedHamming_tendsto_zero","statement":"{G : Type*} [Group G] (A : SoficGroups.SoficApproximation G) (g : G) : Tendsto (fun n => SoficGroups.normalizedHamming (((A.model n).action g)⁻¹) ((A.model n).action (g⁻¹))) atTop (𝓝 0)"},{"kind":"theorem","name":"sofic_action_squared_energy_mul","statement":"{G : Type*} [Group G] (A : SoficGroups.SoficApproximation G) (f : (n : ℕ) → Fin (A.model n).size → ℝ) (hf0 : ∀ n x, 0 ≤ f n x) (hf1 : ∀ n x, f n x ≤ 1) (g h : G) (hg : Tendsto (fun n => squaredPermutationEnergy (f n) ((A.model n).action g) / (A.model n).size) atTop (𝓝 0)) (hh : Tendsto (fun n => squaredPermutationEnergy (f n) ((A.model n).action h) / (A.model n).size) atTop (𝓝 0)) : Tendsto (fun n => squaredPermutationEnergy (f n) ((A.model n).action (g * h)) / (A.model n).size) atTop (𝓝 0)"},{"kind":"theorem","name":"sofic_action_squared_energy_inv","statement":"{G : Type*} [Group G] (A : SoficGroups.SoficApproximation G) (f : (n : ℕ) → Fin (A.model n).size → ℝ) (hf0 : ∀ n x, 0 ≤ f n x) (hf1 : ∀ n x, f n x ≤ 1) (g : G) (hg : Tendsto (fun n => squaredPermutationEnergy (f n) ((A.model n).action g) / (A.model n).size) atTop (𝓝 0)) : Tendsto (fun n => squaredPermutationEnergy (f n) ((A.model n).action (g⁻¹)) / (A.model n).size) atTop (𝓝 0)"},{"kind":"theorem","name":"action_energy_tendsto_zero_of_positive_generator_sum","statement":"{G ι : Type*} [Group G] [Fintype ι] (A : SoficGroups.SoficApproximation G) (s : ι → G) (hgenerate : Subgroup.closure (Set.range s) = ⊤) (f : (n : ℕ) → Fin (A.model n).size → ℝ) (hf0 : ∀ n x, 0 ≤ f n x) (hf1 : ∀ n x, f n x ≤ 1) (hpositive : Tendsto (fun n => (∑ i : ι, squaredPermutationEnergy (f n) ((A.model n).action (s i))) / (A.model n).size) atTop (𝓝 0)) : ∀ g : G, Tendsto (fun n => squaredPermutationEnergy (f n) ((A.model n).action g) / (A.model n).size) atTop (𝓝 0)"},{"kind":"theorem","name":"sum_action_energy_tendsto_zero_of_positive_generator_sum","statement":"{G ι : Type*} [Group G] [Fintype ι] (A : SoficGroups.SoficApproximation G) (s : ι → G) (hgenerate : Subgroup.closure (Set.range s) = ⊤) (f : (n : ℕ) → Fin (A.model n).size → ℝ) (hf0 : ∀ n x, 0 ≤ f n x) (hf1 : ∀ n x, f n x ≤ 1) (hpositive : Tendsto (fun n => (∑ i : ι, squaredPermutationEnergy (f n) ((A.model n).action (s i))) / (A.model n).size) atTop (𝓝 0)) (S : Finset G) : Tendsto (fun n => (∑ g ∈ S, squaredPermutationEnergy (f n) ((A.model n).action g)) / (A.model n).size) atTop (𝓝 0)"},{"kind":"theorem","name":"sum_indicator_real_eq_mul_card","statement":"{V : Type*} (A : Finset V) (q : V → Prop) [DecidablePred q] (m : ℝ) : (∑ x ∈ A, if q x then m else 0) = m * (A.filter q).card"},{"kind":"theorem","name":"permutationRealVariation_subtract_layer","statement":"{V ι : Type*} [Fintype V] [Fintype ι] [DecidableEq V] (σ : ι → Equiv.Perm V) (f : V → ℝ) (A : Finset V) (m : ℝ) (hm : 0 ≤ m) (hinside : ∀ x ∈ A, m ≤ f x) (houtside : ∀ x, x ∉ A → f x = 0) : permutationRealVariation σ f = permutationRealVariation σ (fun x => if x ∈ A then f x - m else 0) + 2 * m * (SoficGroups.boundary σ A : ℝ)"},{"kind":"theorem","name":"additive_permutation_small_support_coarea","statement":"{V ι : Type*} [Fintype V] [Fintype ι] [DecidableEq V] (σ : ι → Equiv.Perm V) (γ ε : ℝ) (hε : 0 ≤ ε) (hexp : ∀ A : Finset V, γ * min (A.card : ℝ) ((Fintype.card V : ℝ) - A.card) ≤ (SoficGroups.boundary σ A : ℝ) + ε) (f : V → ℝ) (M : ℝ) (hM : 0 ≤ M) (hf : ∀ x, 0 ≤ f x) (hfM : ∀ x, f x ≤ M) (hhalf : 2 * (SoficGroups.CheegerPoincare.positiveSupport f).card ≤ Fintype.card V) : 2 * γ * (∑ x : V, f x) ≤ permutationRealVariation σ f + 2 * ε * M"},{"kind":"theorem","name":"positive_negative_abs_eq","statement":"(a b : ℝ) : |max a 0 - max b 0| + |max (-a) 0 - max (-b) 0| = |a - b|"},{"kind":"theorem","name":"permutationRealVariation_positive_negative","statement":"{V ι : Type*} [Fintype V] [Fintype ι] (σ : ι → Equiv.Perm V) (f : V → ℝ) (m : ℝ) : permutationRealVariation σ (fun x => max (f x - m) 0) + permutationRealVariation σ (fun x => max (m - f x) 0) = permutationRealVariation σ f"},{"kind":"theorem","name":"exists_bounded_finite_real_median","statement":"{V : Type*} [Fintype V] [Nonempty V] (f : V → ℝ) (hf : ∀ x, 0 ≤ f x) (hf_one : ∀ x, f x ≤ 1) : ∃ m : ℝ, 0 ≤ m ∧ m ≤ 1 ∧ 2 * (SoficGroups.CheegerPoincare.lowerLevel f m).card ≤ Fintype.card V ∧ 2 * (SoficGroups.CheegerPoincare.upperLevel f m).card ≤ Fintype.card V"},{"kind":"theorem","name":"additive_permutation_median_absolute_deviation","statement":"{V ι : Type*} [Fintype V] [Nonempty V] [Fintype ι] [DecidableEq V] (σ : ι → Equiv.Perm V) (γ ε : ℝ) (hε : 0 ≤ ε) (hexp : ∀ A : Finset V, γ * min (A.card : ℝ) ((Fintype.card V : ℝ) - A.card) ≤ (SoficGroups.boundary σ A : ℝ) + ε) (f : V → ℝ) (hf : ∀ x, 0 ≤ f x) (hf_one : ∀ x, f x ≤ 1) : ∃ m : ℝ, 0 ≤ m ∧ m ≤ 1 ∧ 2 * γ * (∑ x : V, |f x - m|) ≤ permutationRealVariation σ f + 4 * ε"},{"kind":"theorem","name":"additive_permutation_median_variance","statement":"{V ι : Type*} [Fintype V] [Nonempty V] [Fintype ι] [DecidableEq V] (σ : ι → Equiv.Perm V) (γ ε : ℝ) (hγ : 0 ≤ γ) (hε : 0 ≤ ε) (hexp : ∀ A : Finset V, γ * min (A.card : ℝ) ((Fintype.card V : ℝ) - A.card) ≤ (SoficGroups.boundary σ A : ℝ) + ε) (f : V → ℝ) (hf : ∀ x, 0 ≤ f x) (hf_one : ∀ x, f x ≤ 1) : 2 * γ * (∑ x : V, (f x - SoficGroups.CheegerPoincare.finiteMean f) ^ 2) ≤ permutationRealVariation σ f + 4 * ε"},{"kind":"theorem","name":"additive_permutation_finiteVariance","statement":"{V ι : Type*} [Fintype V] [Nonempty V] [Fintype ι] [DecidableEq V] (σ : ι → Equiv.Perm V) (γ ε : ℝ) (hγ : 0 ≤ γ) (hε : 0 ≤ ε) (hexp : ∀ A : Finset V, γ * min (A.card : ℝ) ((Fintype.card V : ℝ) - A.card) ≤ (SoficGroups.boundary σ A : ℝ) + ε) (f : V → ℝ) (hf : ∀ x, 0 ≤ f x) (hf_one : ∀ x, f x ≤ 1) : 2 * γ * (Fintype.card V : ℝ) * SoficGroups.CheegerPoincare.finiteVariance f ≤ permutationRealVariation σ f + 4 * ε"},{"kind":"theorem","name":"permutationRealVariation_sq_le_card_mul_energy","statement":"{V ι : Type*} [Fintype V] [Fintype ι] (σ : ι → Equiv.Perm V) (f : V → ℝ) : permutationRealVariation σ f ^ 2 ≤ ((Fintype.card ι : ℝ) * Fintype.card V) * (∑ i : ι, ∑ x : V, (f (σ i x) - f x) ^ 2)"},{"kind":"theorem","name":"normalized_permutationRealVariation_tendsto_zero_of_energy","statement":"(V : ℕ → Type*) [∀ n, Fintype (V n)] [∀ n, Nonempty (V n)] (ι : Type*) [Fintype ι] (σ : (n : ℕ) → ι → Equiv.Perm (V n)) (f : (n : ℕ) → V n → ℝ) (henergy : Tendsto (fun n => (∑ i : ι, ∑ x : V n, (f n (σ n i x) - f n x) ^ 2) / (Fintype.card (V n) : ℝ)) atTop (nhds 0)) : Tendsto (fun n => permutationRealVariation (σ n) (f n) / (Fintype.card (V n) : ℝ)) atTop (nhds 0)"},{"kind":"theorem","name":"sum_partition_parts_eq","statement":"{V : Type*} [Fintype V] [DecidableEq V] (P : Finpartition (Finset.univ : Finset V)) (f : V → ℝ) : (∑ C ∈ P.parts, ∑ x ∈ C, f x) = ∑ x : V, f x"},{"kind":"theorem","name":"completed_component_real_variation_le","statement":"{V ι : Type*} [DecidableEq V] [Fintype ι] (σ : ι → Equiv.Perm V) (C : Finset V) (τ : ι → Equiv.Perm {x : V // x ∈ C}) (hτ : ∀ i (x : V) (hx : x ∈ C) (_hy : σ i x ∈ C), ((τ i ⟨x, hx⟩ : {x : V // x ∈ C}) : V) = σ i x) (f : V → ℝ) (hf0 : ∀ x, 0 ≤ f x) (hf1 : ∀ x, f x ≤ 1) : permutationRealVariation τ (fun x => f (x : V)) ≤ (∑ i : ι, ∑ x ∈ C, |f (σ i x) - f x|) + (SoficGroups.boundary σ C : ℝ)"},{"kind":"theorem","name":"sum_completed_component_real_variation_le","statement":"{V ι : Type*} [Fintype V] [DecidableEq V] [Fintype ι] (P : Finpartition (Finset.univ : Finset V)) (σ : ι → Equiv.Perm V) (τ : (C : Finset V) → ι → Equiv.Perm {x : V // x ∈ C}) (hτ : ∀ C ∈ P.parts, ∀ i (x : V) (hx : x ∈ C) (_hy : σ i x ∈ C), ((τ C i ⟨x, hx⟩ : {x : V // x ∈ C}) : V) = σ i x) (f : V → ℝ) (hf0 : ∀ x, 0 ≤ f x) (hf1 : ∀ x, f x ≤ 1) : (∑ C ∈ P.parts, permutationRealVariation (τ C) (fun x => f (x : V))) ≤ permutationRealVariation σ f + ∑ C ∈ P.parts, (SoficGroups.boundary σ C : ℝ)"},{"kind":"theorem","name":"weighted_component_midrankVariance_additive_bound","statement":"{V ι : Type*} [Fintype V] [DecidableEq V] [Fintype ι] (P : Finpartition (Finset.univ : Finset V)) (σ : ι → Equiv.Perm V) (τ : (C : Finset V) → ι → Equiv.Perm {x : V // x ∈ C}) (γ : ℝ) (hγ : 0 ≤ γ) (hτ : ∀ C ∈ P.parts, ∀ i (x : V) (hx : x ∈ C) (_hy : σ i x ∈ C), ((τ C i ⟨x, hx⟩ : {x : V // x ∈ C}) : V) = σ i x) (hexpand : ∀ C ∈ P.parts, ∀ E : Finset V, E ⊆ C → 2 * E.card ≤ C.card → γ * (E.card : ℝ) ≤ (SoficGroups.boundary σ E : ℝ)) (b : V → ℤ) : 2 * γ * (∑ C ∈ P.parts, (C.card : ℝ) * SoficGroups.midrankVariance (SoficGroups.componentRankMassList C b)) ≤ SoficGroups.KunCompletedComponentMidrankVariation.permutationRealVariation σ (SoficGroups.MidrankPermutationEnergy.partitionVertexMidrank P b) + 5 * (∑ C ∈ P.parts, (SoficGroups.boundary σ C : ℝ))"},{"kind":"theorem","name":"weighted_component_midrankVariance_tendsto_zero_of_additive_expansion","statement":"(V : ℕ → Type*) [∀ n, Fintype (V n)] [∀ n, Nonempty (V n)] [∀ n, DecidableEq (V n)] (ι : Type*) [Fintype ι] (P : (n : ℕ) → Finpartition (Finset.univ : Finset (V n))) (σ : (n : ℕ) → ι → Equiv.Perm (V n)) (τ : (n : ℕ) → (C : Finset (V n)) → ι → Equiv.Perm {x : V n // x ∈ C}) (b : (n : ℕ) → V n → ℤ) (γ : ℝ) (hγ : 0 < γ) (hτ : ∀ n C, C ∈ (P n).parts → ∀ i (x : V n) (hx : x ∈ C) (_hy : σ n i x ∈ C), ((τ n C i ⟨x, hx⟩ : {x : V n // x ∈ C}) : V n) = σ n i x) (hexpand : ∀ n C, C ∈ (P n).parts → ∀ E : Finset (V n), E ⊆ C → 2 * E.card ≤ C.card → γ * (E.card : ℝ) ≤ (SoficGroups.boundary (σ n) E : ℝ)) (hboundary : Tendsto (fun n => (∑ C ∈ (P n).parts, (SoficGroups.boundary (σ n) C : ℝ)) / (Fintype.card (V n) : ℝ)) atTop (nhds 0)) (henergy : Tendsto (fun n => (∑ i : ι, ∑ x : V n, (SoficGroups.MidrankPermutationEnergy.partitionVertexMidrank (P n) (b n) (σ n i x) - SoficGroups.MidrankPermutationEnergy.partitionVertexMidrank (P n) (b n) x) ^ 2) / (Fintype.card (V n) : ℝ)) atTop (nhds 0)) : Tendsto (fun n => (∑ C ∈ (P n).parts, (C.card : ℝ) * SoficGroups.midrankVariance (SoficGroups.componentRankMassList C (b n))) / (Fintype.card (V n) : ℝ)) atTop (nhds 0)"},{"kind":"theorem","name":"weighted_component_midrankVariance_tendsto_zero_of_source_half_expansion","statement":"(V : ℕ → Type*) [∀ n, Fintype (V n)] [∀ n, Nonempty (V n)] [∀ n, DecidableEq (V n)] (ι : Type*) [Fintype ι] (P : (n : ℕ) → Finpartition (Finset.univ : Finset (V n))) (σ : (n : ℕ) → ι → Equiv.Perm (V n)) (b : (n : ℕ) → V n → ℤ) (γ : ℝ) (hγ : 0 < γ) (hexpand : ∀ n C, C ∈ (P n).parts → ∀ E : Finset (V n), E ⊆ C → 2 * E.card ≤ C.card → γ * (E.card : ℝ) ≤ (SoficGroups.boundary (σ n) E : ℝ)) (hboundary : Tendsto (fun n => (∑ C ∈ (P n).parts, (SoficGroups.boundary (σ n) C : ℝ)) / (Fintype.card (V n) : ℝ)) atTop (nhds 0)) (henergy : Tendsto (fun n => (∑ i : ι, ∑ x : V n, (SoficGroups.MidrankPermutationEnergy.partitionVertexMidrank (P n) (b n) (σ n i x) - SoficGroups.MidrankPermutationEnergy.partitionVertexMidrank (P n) (b n) x) ^ 2) / (Fintype.card (V n) : ℝ)) atTop (nhds 0)) : Tendsto (fun n => (∑ C ∈ (P n).parts, (C.card : ℝ) * SoficGroups.midrankVariance (SoficGroups.componentRankMassList C (b n))) / (Fintype.card (V n) : ℝ)) atTop (nhds 0)"},{"kind":"theorem","name":"exists_maximizing_partition_ranks","statement":"{V : ℕ → Type*} [∀ n, Fintype (V n)] [∀ n, DecidableEq (V n)] (P : (n : ℕ) → Finpartition (Finset.univ : Finset (V n))) (b : (n : ℕ) → V n → ℤ) : ∃ j : (n : ℕ) → Finset (V n) → ℤ, ∀ n C, C ∈ (P n).parts → j n C ∈ C.image (b n) ∧ ∀ k ∈ C.image (b n), SoficGroups.componentRankMass C (b n) k ≤ SoficGroups.componentRankMass C (b n) (j n C)"},{"kind":"theorem","name":"maximizing_partition_rank_omitted_density_tendsto_zero","statement":"{V : ℕ → Type*} [∀ n, Fintype (V n)] [∀ n, DecidableEq (V n)] (P : (n : ℕ) → Finpartition (Finset.univ : Finset (V n))) (b : (n : ℕ) → V n → ℤ) (j : (n : ℕ) → Finset (V n) → ℤ) (hmax : ∀ n C, C ∈ (P n).parts → ∀ k ∈ C.image (b n), SoficGroups.componentRankMass C (b n) k ≤ SoficGroups.componentRankMass C (b n) (j n C)) (hvariance : Tendsto (fun n => (∑ C ∈ (P n).parts, (C.card : ℝ) * SoficGroups.midrankVariance (SoficGroups.componentRankMassList C (b n))) / Fintype.card (V n)) atTop (nhds 0)) : Tendsto (fun n => ((((Finset.univ : Finset (V n)) \\ SoficGroups.RankArcCharging.selectedRankSupport (P n) (b n) (j n)).card : ℝ) / Fintype.card (V n))) atTop (nhds 0)"},{"kind":"theorem","name":"rankChangingArc_density_tendsto_zero_of_selected_support","statement":"{V : ℕ → Type*} [∀ n, Fintype (V n)] [∀ n, Nonempty (V n)] [∀ n, DecidableEq (V n)] {κ : Type*} (P : (n : ℕ) → Finpartition (Finset.univ : Finset (V n))) (b : (n : ℕ) → V n → ℤ) (j : (n : ℕ) → Finset (V n) → ℤ) (w : (n : ℕ) → κ → Equiv.Perm (V n)) (homitted : Tendsto (fun n => ((((Finset.univ : Finset (V n)) \\ SoficGroups.RankArcCharging.selectedRankSupport (P n) (b n) (j n)).card : ℝ) / Fintype.card (V n))) atTop (nhds 0)) (hcross : ∀ i : κ, Tendsto (fun n => ((SoficGroups.partitionWordCrossing (P n) (w n i)).card : ℝ) / Fintype.card (V n)) atTop (nhds 0)) : ∀ i : κ, Tendsto (fun n => ((SoficGroups.RankArcCharging.rankChangingArc (Finset.univ : Finset (V n)) (b n) (w n i)).card : ℝ) / Fintype.card (V n)) atTop (nhds 0)"},{"kind":"theorem","name":"exists_common_rank_invariance_of_midrank_variance","statement":"{V : ℕ → Type*} [∀ n, Fintype (V n)] [∀ n, Nonempty (V n)] [∀ n, DecidableEq (V n)] {κ : Type*} (P : (n : ℕ) → Finpartition (Finset.univ : Finset (V n))) (b : (n : ℕ) → V n → ℤ) (w : (n : ℕ) → κ → Equiv.Perm (V n)) (hvariance : Tendsto (fun n => (∑ C ∈ (P n).parts, (C.card : ℝ) * SoficGroups.midrankVariance (SoficGroups.componentRankMassList C (b n))) / Fintype.card (V n)) atTop (nhds 0)) (hcross : ∀ i : κ, Tendsto (fun n => ((SoficGroups.partitionWordCrossing (P n) (w n i)).card : ℝ) / Fintype.card (V n)) atTop (nhds 0)) : ∃ j : (n : ℕ) → Finset (V n) → ℤ, (∀ n C, C ∈ (P n).parts → j n C ∈ C.image (b n) ∧ ∀ k ∈ C.image (b n), SoficGroups.componentRankMass C (b n) k ≤ SoficGroups.componentRankMass C (b n) (j n C)) ∧ Tendsto (fun n => ((((Finset.univ : Finset (V n)) \\ SoficGroups.RankArcCharging.selectedRankSupport (P n) (b n) (j n)).card : ℝ) / Fintype.card (V n))) atTop (nhds 0) ∧ ∀ i : κ, Tendsto (fun n => ((SoficGroups.RankArcCharging.rankChangingArc (Finset.univ : Finset (V n)) (b n) (w n i)).card : ℝ) / Fintype.card (V n)) atTop (nhds 0)"},{"kind":"theorem","name":"sofic_action_inverse_normalizedHamming_tendsto_zero","statement":"{G : Type*} [Group G] (A : SoficGroups.SoficApproximation G) (g : G) : Tendsto (fun n => SoficGroups.normalizedHamming (((A.model n).action g)⁻¹) ((A.model n).action (g⁻¹))) atTop (nhds 0)"},{"kind":"theorem","name":"sourceFirstFactorCayleyRadiusBad_density_tendsto_zero","statement":"{K J : Type*} [Group K] [Group J] [DecidableEq K] (A : SoficGroups.SoficApproximation (K × J)) (S : Finset K) (hsymmetric : ∀ g ∈ S, g⁻¹ ∈ S) (hgenerates : Subgroup.closure (S : Set K) = ⊤) (k : ℕ) : Tendsto (fun n => ((sourceFirstFactorCayleyRadiusBad A S hsymmetric hgenerates n k).card : ℝ) / (A.model n).size) atTop (nhds 0)"},{"kind":"theorem","name":"sourceFirstFactor_injective_ball","statement":"{K J : Type*} [Group K] [Group J] [DecidableEq K] (A : SoficGroups.SoficApproximation (K × J)) (S : Finset K) (hsymmetric : ∀ g ∈ S, g⁻¹ ∈ S) (hgenerates : Subgroup.closure (S : Set K) = ⊤) (n k : ℕ) {x : Fin (A.model n).size} (hx : x ∉ sourceFirstFactorCayleyRadiusBad A S hsymmetric hgenerates n k) : Set.InjOn (fun g : K => (A.model n).action (g, 1) x) (↑(S ^ k) : Set K)"},{"kind":"theorem","name":"firstFactor_mem_sourceProductRadiusLabels","statement":"{K J : Type*} [Group K] [Group J] [DecidableEq K] [DecidableEq J] (S : Finset K) (F : Finset J) (k : ℕ) {a : K} (ha : a ∈ S ^ k) : (a, (1 : J)) ∈ sourceProductRadiusLabels S F k"},{"kind":"theorem","name":"secondFactor_mem_sourceProductRadiusLabels","statement":"{K J : Type*} [Group K] [Group J] [DecidableEq K] [DecidableEq J] (S : Finset K) (F : Finset J) (k : ℕ) {j : J} (hj : j ∈ SoficGroups.CompressionCriterion.productTrackedTable F) : ((1 : K), j) ∈ sourceProductRadiusLabels S F k"},{"kind":"theorem","name":"composite_mem_sourceProductRadiusLabels","statement":"{K J : Type*} [Group K] [Group J] [DecidableEq K] [DecidableEq J] (S : Finset K) (F : Finset J) (k : ℕ) {a : K} (ha : a ∈ S) {j : J} (hj : j ∈ SoficGroups.CompressionCriterion.productTrackedTable F) : (a, j) ∈ sourceProductRadiusLabels S F k"},{"kind":"theorem","name":"generator_mem_sourceProductRadiusLabels","statement":"{K J : Type*} [Group K] [Group J] [DecidableEq K] [DecidableEq J] (S : Finset K) (F : Finset J) (k : ℕ) {a : K} (ha : a ∈ S) : (a, (1 : J)) ∈ sourceProductRadiusLabels S F k"},{"kind":"theorem","name":"canonicalProductRadiusBad_density_tendsto_zero","statement":"{K J : Type*} [Group K] [Group J] [DecidableEq K] [DecidableEq J] (A : SoficGroups.SoficApproximation (K × J)) (S : Finset K) (hsymmetric : ∀ a ∈ S, a⁻¹ ∈ S) (hgenerates : Subgroup.closure (S : Set K) = ⊤) (F : Finset J) (k : ℕ) : Tendsto (fun n => ((canonicalProductRadiusBad A S hsymmetric hgenerates F n k).card : ℝ) / (A.model n).size) atTop (nhds 0)"},{"kind":"theorem","name":"sourceWordTestBad_subset_finiteProductRootBad","statement":"{K J : Type*} [Group K] [Group J] [DecidableEq K] [DecidableEq J] (A : SoficGroups.SoficApproximation (K × J)) (S : Finset K) (F : Finset J) (n k : ℕ) : sourceWordTestBad (fun i : ↥S => (A.model n).action ((i : K), 1)) (fun j : J => (A.model n).action (1, j)) F ⊆ finiteRootBad (A.model n) (sourceProductRadiusLabels S F k)"},{"kind":"theorem","name":"component_exit_mem_partitionWordCrossing","statement":"{V : Type*} [DecidableEq V] {U : Finset V} (P : Finpartition U) (C : Finset V) (hC : C ∈ P.parts) (p : Equiv.Perm V) {x : V} (hx : x ∈ C) (hout : p x ∉ C) : x ∈ SoficGroups.partitionWordCrossing P p"},{"kind":"theorem","name":"sourceCompletionBad_subset_canonical_matchedRadiusBad","statement":"{K J : Type*} [Group K] [Group J] [DecidableEq K] [DecidableEq J] (A : SoficGroups.SoficApproximation (K × J)) (S : Finset K) (hsymmetric : ∀ a ∈ S, a⁻¹ ∈ S) (hgenerates : Subgroup.closure (S : Set K) = ⊤) (F : Finset J) (n k : ℕ) {U : Finset (Fin (A.model n).size)} (P : Finpartition U) (C : Finset (Fin (A.model n).size)) (hC : C ∈ P.parts) : sourceCompletionBad (fun i : ↥S => (A.model n).action ((i : K), 1)) (fun j : J => (A.model n).action (1, j)) F C ⊆ C ∩ SoficGroups.matchedRadiusBad P (sourceProductRadiusLabels S F k) ((A.model n).action) (canonicalProductRadiusBad A S hsymmetric hgenerates F n k)"},{"kind":"theorem","name":"canonical_source_matched_component_cayley_ball_realization","statement":"{K J : Type*} [Group K] [Group J] [DecidableEq K] [DecidableEq J] (A : SoficGroups.SoficApproximation (K × J)) (S : Finset K) (honeS : 1 ∈ S) (hsymmetric : ∀ a ∈ S, a⁻¹ ∈ S) (hgenerates : Subgroup.closure (S : Set K) = ⊤) (F : Finset J) (n k : ℕ) {U : Finset (Fin (A.model n).size)} (P : Finpartition U) (C : Finset (Fin (A.model n).size)) (hC : C ∈ P.parts) (x : Fin (A.model n).size) (hx : x ∈ C) (hgood : x ∉ SoficGroups.matchedRadiusBad P (sourceProductRadiusLabels S F k) ((A.model n).action) (canonicalProductRadiusBad A S hsymmetric hgenerates F n k)) : ∃ f : K → Fin (A.model n).size, Set.MapsTo f (↑(S ^ (k / 2)) : Set K) (↑C : Set (Fin (A.model n).size)) ∧ Set.InjOn f (↑(S ^ (k / 2)) : Set K)"},{"kind":"theorem","name":"eventually_five_mul_sourceCompletionBad_le_of_density","statement":"(V : ℕ → Type*) [∀ n, DecidableEq (V n)] {ι J : Type*} [Fintype ι] [Group J] (σ : (n : ℕ) → ι → Equiv.Perm (V n)) (p : (n : ℕ) → J → Equiv.Perm (V n)) (F : Finset J) (Z : (n : ℕ) → Finset (V n)) (hZ : ∀ n, (Z n).Nonempty) (hbad : Tendsto (fun n => ((sourceCompletionBad (σ n) (p n) F (Z n)).card : ℝ) / (Z n).card) atTop (nhds 0)) : ∀ᶠ n in atTop, 5 * (sourceCompletionBad (σ n) (p n) F (Z n)).card ≤ (Z n).card"},{"kind":"theorem","name":"eventually_completed_sourceCentralizer_table_of_bad_density","statement":"(V : ℕ → Type*) [∀ n, Fintype (V n)] [∀ n, DecidableEq (V n)] {ι J : Type*} [Fintype ι] [Group J] (σ : (n : ℕ) → ι → Equiv.Perm (V n)) (p : (n : ℕ) → J → Equiv.Perm (V n)) (F : Finset J) (Z : (n : ℕ) → Finset (V n)) (hZ : ∀ n, (Z n).Nonempty) (hbad : Tendsto (fun n => ((sourceCompletionBad (σ n) (p n) F (Z n)).card : ℝ) / (Z n).card) atTop (nhds 0)) (σZ : (n : ℕ) → ι → Equiv.Perm {x : V n // x ∈ Z n}) (hσZ : ∀ n i (x : V n) (hx : x ∈ Z n) (_hi : σ n i x ∈ Z n), ((σZ n i ⟨x, hx⟩ : {x : V n // x ∈ Z n}) : V n) = σ n i x) (t : ℕ → ℕ) (ht : ∀ n, 2 * Fintype.card ι * (sourceCompletionBad (σ n) (p n) F (Z n)).card ≤ t n) : ∀ᶠ n in atTop, (∀ a ∈ F, ∀ b ∈ F, 5 * SoficGroups.permutationDistance (completedRestriction (p n (a * b)) (Z n)) (completedRestriction (p n a) (Z n) * completedRestriction (p n b) (Z n)) ≤ Fintype.card {x : V n // x ∈ Z n}) ∧ (∀ a ∈ F, ∀ b ∈ F, a ≠ b → Fintype.card {x : V n // x ∈ Z n} < 5 * SoficGroups.permutationDistance (completedRestriction (p n a) (Z n)) (completedRestriction (p n b) (Z n))) ∧ (∀ a ∈ SoficGroups.CompressionCriterion.productTrackedTable F, SoficGroups.permutationCommutationDefect (σZ n) (completedRestriction (p n a) (Z n)) ≤ t n)"},{"kind":"theorem","name":"trackedCompletedAlmostCentralizer_permutation_of_mem","statement":"{V ι J : Type} [Fintype V] [DecidableEq V] [Fintype ι] [Group J] (σ : ι → Equiv.Perm V) (p : J → Equiv.Perm V) (F : Finset J) (t : ℕ) (hdefect : ∀ j ∈ SoficGroups.CompressionCriterion.productTrackedTable F, SoficGroups.permutationCommutationDefect σ (p j) ≤ t) {j : J} (hj : j ∈ SoficGroups.CompressionCriterion.productTrackedTable F) : (trackedCompletedAlmostCentralizer σ p F t hdefect j).permutation = p j"},{"kind":"theorem","name":"trackedCompletedAlmostCentralizer_map_one","statement":"{V ι J : Type} [Fintype V] [DecidableEq V] [Fintype ι] [Group J] (σ : ι → Equiv.Perm V) (p : J → Equiv.Perm V) (hp : p 1 = 1) (F : Finset J) (t : ℕ) (hdefect : ∀ j ∈ SoficGroups.CompressionCriterion.productTrackedTable F, SoficGroups.permutationCommutationDefect σ (p j) ≤ t) : (trackedCompletedAlmostCentralizer σ p F t hdefect 1).permutation = 1"},{"kind":"theorem","name":"trackedCompletedAlmostCentralizer_multiplicative","statement":"{V ι J : Type} [Fintype V] [DecidableEq V] [Fintype ι] [Group J] (σ : ι → Equiv.Perm V) (p : J → Equiv.Perm V) (F : Finset J) (t : ℕ) (hdefect : ∀ j ∈ SoficGroups.CompressionCriterion.productTrackedTable F, SoficGroups.permutationCommutationDefect σ (p j) ≤ t) (hmul : ∀ x ∈ F, ∀ y ∈ F, 5 * SoficGroups.permutationDistance (p (x * y)) (p x * p y) ≤ Fintype.card V) : ∀ x ∈ F, ∀ y ∈ F, 5 * SoficGroups.permutationDistance (trackedCompletedAlmostCentralizer σ p F t hdefect (x * y)).permutation ((trackedCompletedAlmostCentralizer σ p F t hdefect x).permutation * (trackedCompletedAlmostCentralizer σ p F t hdefect y).permutation) ≤ Fintype.card V"},{"kind":"theorem","name":"trackedCompletedAlmostCentralizer_separated","statement":"{V ι J : Type} [Fintype V] [DecidableEq V] [Fintype ι] [Group J] (σ : ι → Equiv.Perm V) (p : J → Equiv.Perm V) (F : Finset J) (t : ℕ) (hdefect : ∀ j ∈ SoficGroups.CompressionCriterion.productTrackedTable F, SoficGroups.permutationCommutationDefect σ (p j) ≤ t) (hsep : ∀ x ∈ F, ∀ y ∈ F, x ≠ y → Fintype.card V < 5 * SoficGroups.permutationDistance (p x) (p y)) : ∀ x ∈ F, ∀ y ∈ F, x ≠ y → Fintype.card V < 5 * SoficGroups.permutationDistance (trackedCompletedAlmostCentralizer σ p F t hdefect x).permutation (trackedCompletedAlmostCentralizer σ p F t hdefect y).permutation"},{"kind":"theorem","name":"nonempty_expandingCentralizerFiniteModel_of_selected_completed_sequence","statement":"{J : Type} [Group J] (F : Finset J) (V : ℕ → Type) [∀ n, Fintype (V n)] [∀ n, DecidableEq (V n)] (ι : Type) [Fintype ι] (σ : (n : ℕ) → ι → Equiv.Perm (V n)) (p : (n : ℕ) → J → Equiv.Perm (V n)) (hp : ∀ n, p n 1 = 1) (t : ℕ → ℕ) (h : ℝ) (hpositive : 0 < h) (hdefect : ∀ᶠ n in atTop, ∀ j ∈ SoficGroups.CompressionCriterion.productTrackedTable F, SoficGroups.permutationCommutationDefect (σ n) (p n j) ≤ t n) (hexp : ∀ᶠ n in atTop, ∀ E : Finset (V n), h * min (E.card : ℝ) ((Fintype.card (V n) : ℝ) - E.card) ≤ (SoficGroups.boundary (σ n) E : ℝ)) (hsmall : ∀ᶠ n in atTop, (10 : ℝ) * t n < h * Fintype.card (V n)) (himprove : ∀ᶠ n in atTop, SoficGroups.HasAlmostCentralizerImprovement (σ n) (t n)) (hmul : ∀ᶠ n in atTop, ∀ x ∈ F, ∀ y ∈ F, 5 * SoficGroups.permutationDistance (p n (x * y)) (p n x * p n y) ≤ Fintype.card (V n)) (hsep : ∀ᶠ n in atTop, ∀ x ∈ F, ∀ y ∈ F, x ≠ y → Fintype.card (V n) < 5 * SoficGroups.permutationDistance (p n x) (p n y)) : Nonempty (SoficGroups.ExpandingCentralizerFiniteModel J F)"},{"kind":"theorem","name":"sourceLocalPrefixTranspositionGroup_lef_of_source_finite_models","statement":"(hmodels : ∀ A : SoficGroups.SoficApproximation (SoficGroups.prefixElementaryGroup SoficGroups.ninePrefixCode), Tendsto (fun n => (A.model n).size) atTop atTop → ∀ F : Finset (SoficGroups.ThompsonPrefixInsertion.localPrefixTranspositionGroup SoficGroups.ThompsonPrefixLocal.sourceLocalWord), Nonempty (SoficGroups.ExpandingCentralizerFiniteModel (SoficGroups.ThompsonPrefixInsertion.localPrefixTranspositionGroup SoficGroups.ThompsonPrefixLocal.sourceLocalWord) F)) (hsource : SoficGroups.Sofic (SoficGroups.prefixElementaryGroup SoficGroups.ninePrefixCode)) : SoficGroups.LEF (SoficGroups.ThompsonPrefixInsertion.localPrefixTranspositionGroup SoficGroups.ThompsonPrefixLocal.sourceLocalWord)"},{"kind":"theorem","name":"conjugateTerm_succ","statement":"(a b : G) (n : ℕ) : conjugateTerm a b (n + 1) = a⁻¹ * conjugateTerm a b n * a"},{"kind":"theorem","name":"conjugation_shift","statement":"(a u v w : G) (h : u⁻¹ * v * u = w) : (a⁻¹ * u * a)⁻¹ * (a⁻¹ * v * a) * (a⁻¹ * u * a) = a⁻¹ * w * a"},{"kind":"theorem","name":"conjugacy_relation_of_commute","statement":"(a b : G) (n : ℕ) (h : Commute (a * b⁻¹) (conjugateTerm a b n)) : b⁻¹ * conjugateTerm a b n * b = conjugateTerm a b (n + 1)"},{"kind":"theorem","name":"conjugacy_relation_shift","statement":"(a b u : G) (n : ℕ) (h : u⁻¹ * conjugateTerm a b n * u = conjugateTerm a b (n + 1)) : (a⁻¹ * u * a)⁻¹ * conjugateTerm a b (n + 1) * (a⁻¹ * u * a) = conjugateTerm a b (n + 2)"},{"kind":"theorem","name":"conjugacy_relation_step","statement":"(a b : G) (n : ℕ) (hfirst : b⁻¹ * conjugateTerm a b 1 * b = conjugateTerm a b 2) (hprevious : b⁻¹ * conjugateTerm a b n * b = conjugateTerm a b (n + 1)) (hcurrent : b⁻¹ * conjugateTerm a b (n + 1) * b = conjugateTerm a b (n + 2)) : b⁻¹ * conjugateTerm a b (n + 2) * b = conjugateTerm a b (n + 3)"},{"kind":"theorem","name":"conjugacy_relation_all","statement":"(a b : G) (hfirst : b⁻¹ * conjugateTerm a b 1 * b = conjugateTerm a b 2) (hsecond : b⁻¹ * conjugateTerm a b 2 * b = conjugateTerm a b 3) (n : ℕ) : b⁻¹ * conjugateTerm a b (n + 1) * b = conjugateTerm a b (n + 2)"},{"kind":"theorem","name":"finite_group_commute_of_thompsonF_two_relations","statement":"{G : Type*} [Group G] [Finite G] (a b : G) (hfirst : Commute (a * b⁻¹) (a⁻¹ * b * a)) (hsecond : Commute (a * b⁻¹) ((a ^ 2)⁻¹ * b * a ^ 2)) : Commute a b"},{"kind":"theorem","name":"not_lef_of_thompsonF_two_relations","statement":"{G : Type*} [Group G] (a b : G) (h₁ : Commute (a * b⁻¹) (a⁻¹ * b * a)) (h₂ : Commute (a * b⁻¹) ((a ^ 2)⁻¹ * b * a ^ 2)) (hne : ¬ Commute a b) (hfinite : ∀ (n : ℕ) (x y : Equiv.Perm (Fin n)), Commute (x * y⁻¹) (x⁻¹ * y * x) → Commute (x * y⁻¹) ((x ^ 2)⁻¹ * y * x ^ 2) → Commute x y) : ¬ SoficGroups.LEF G"},{"kind":"theorem","name":"prefixWordAction_inv","statement":"{g : BinaryLeavittˣ} {a b : List (Fin 2)} (h : PrefixWordAction g a b) : PrefixWordAction g⁻¹ b a"},{"kind":"theorem","name":"prefixWordAction_prefixInsertion","statement":"{g : BinaryLeavittˣ} {a b : List (Fin 2)} (l : List (Fin 2)) (h : PrefixWordAction g a b) : PrefixWordAction (prefixInsertionHom l g) (l ++ a) (l ++ b)"},{"kind":"theorem","name":"rootRotation_action_zero_zero","statement":"PrefixWordAction rootRotation [0, 0] [0]"},{"kind":"theorem","name":"rootRotation_action_zero_one","statement":"PrefixWordAction rootRotation [0, 1] [1, 0]"},{"kind":"theorem","name":"rootRotation_action_one","statement":"PrefixWordAction rootRotation [1] [1, 1]"},{"kind":"theorem","name":"generatorB_eq_prefixInsertion","statement":"generatorB = prefixInsertionHom [1] generatorA"},{"kind":"theorem","name":"generator_two_eq_prefixInsertion","statement":"generatorA⁻¹ * generatorB * generatorA = prefixInsertionHom [1, 1] generatorA"},{"kind":"theorem","name":"generator_three_eq_prefixInsertion","statement":"(generatorA ^ 2)⁻¹ * generatorB * generatorA ^ 2 = prefixInsertionHom [1, 1, 1] generatorA"},{"kind":"theorem","name":"generator_difference_action_one_one","statement":"PrefixWordAction (generatorA * generatorB⁻¹) [1, 1] [1, 1]"},{"kind":"theorem","name":"commute_prefixInsertion_of_prefixWordAction_fixed","statement":"(g : BinaryLeavittˣ) (w : List (Fin 2)) (h : PrefixWordAction g w w) (u : BinaryLeavittˣ) : Commute g (prefixInsertionHom w u)"},{"kind":"theorem","name":"relator_one","statement":"Commute (generatorA * generatorB⁻¹) (generatorA⁻¹ * generatorB * generatorA)"},{"kind":"theorem","name":"relator_two","statement":"Commute (generatorA * generatorB⁻¹) ((generatorA ^ 2)⁻¹ * generatorB * generatorA ^ 2)"},{"kind":"theorem","name":"cylinderSwap_mem_binaryPrefixTranspositionGroup","statement":"(a b : List (Fin 2)) (hab : ¬ a <+: b) (hba : ¬ b <+: a) : cylinderSwap a b hab hba ∈ binaryPrefixTranspositionGroup"},{"kind":"theorem","name":"rootRotation_mem_binaryPrefixTranspositionGroup","statement":"rootRotation ∈ binaryPrefixTranspositionGroup"},{"kind":"theorem","name":"generatorA_mem_binaryPrefixTranspositionGroup","statement":"generatorA ∈ binaryPrefixTranspositionGroup"},{"kind":"theorem","name":"generatorB_mem_binaryPrefixTranspositionGroup","statement":"generatorB ∈ binaryPrefixTranspositionGroup"},{"kind":"theorem","name":"generators_not_commute","statement":"¬ Commute generatorA generatorB"},{"kind":"theorem","name":"source_relator_one","statement":"Commute (sourceGeneratorA * sourceGeneratorB⁻¹) (sourceGeneratorA⁻¹ * sourceGeneratorB * sourceGeneratorA)"},{"kind":"theorem","name":"source_relator_two","statement":"Commute (sourceGeneratorA * sourceGeneratorB⁻¹) ((sourceGeneratorA ^ 2)⁻¹ * sourceGeneratorB * sourceGeneratorA ^ 2)"},{"kind":"theorem","name":"source_generators_not_commute","statement":"¬ Commute sourceGeneratorA sourceGeneratorB"},{"kind":"theorem","name":"sourceLocalPrefixTranspositionGroup_notLEF","statement":"¬ LEF (ThompsonPrefixInsertion.localPrefixTranspositionGroup ThompsonPrefixLocal.sourceLocalWord)"},{"kind":"theorem","name":"exists_unconditional_actual_source_dual_finpartition_sequences","statement":"(A : SoficGroups.SoficApproximation (SoficGroups.prefixElementaryGroup SoficGroups.ninePrefixCode)) : ∃ (SΓ : Finset (SoficGroups.prefixElementaryGroup SoficGroups.alphaPrefixCode)) (SG : Finset (SoficGroups.prefixElementaryGroup SoficGroups.ninePrefixCode)) (QΓ QG : (n : ℕ) → Finpartition (Finset.univ : Finset (Fin (A.model n).size))) (γΓ γG : ℝ), SG = sourceAmbientSymmetricGenerators SΓ ∧ 1 ∈ SΓ ∧ (∀ g ∈ SΓ, g⁻¹ ∈ SΓ) ∧ Subgroup.closure (SΓ : Set (SoficGroups.prefixElementaryGroup SoficGroups.alphaPrefixCode)) = ⊤ ∧ 1 ∈ SG ∧ (∀ g ∈ SG, g⁻¹ ∈ SG) ∧ Subgroup.closure (SG : Set (SoficGroups.prefixElementaryGroup SoficGroups.ninePrefixCode)) = ⊤ ∧ Function.Injective sourceAlphaInclusion ∧ Subgroup.closure (Set.range (sourcePositiveGeneratorMap SΓ)) = ⊤ ∧ 0 < γΓ ∧ 0 < γG ∧ (∀ n, ∀ C ∈ (QΓ n).parts, ∀ E : Finset (Fin (A.model n).size), E ⊆ C → 2 * E.card ≤ C.card → γΓ * (E.card : ℝ) ≤ (SoficGroups.boundary (fun i : ↥SΓ => (A.model n).action (sourceAlphaInclusion (i : SoficGroups.prefixElementaryGroup SoficGroups.alphaPrefixCode))) E : ℝ)) ∧ (∀ n, ∀ C ∈ (QG n).parts, ∀ E : Finset (Fin (A.model n).size), E ⊆ C → 2 * E.card ≤ C.card → γG * (E.card : ℝ) ≤ (SoficGroups.boundary (fun i : ↥SG => (A.model n).action (i : SoficGroups.prefixElementaryGroup SoficGroups.ninePrefixCode)) E : ℝ)) ∧ Tendsto (fun n => (∑ C ∈ (QΓ n).parts, (SoficGroups.boundary (fun i : ↥SΓ => (A.model n).action (sourceAlphaInclusion (i : SoficGroups.prefixElementaryGroup SoficGroups.alphaPrefixCode))) C : ℝ)) / (A.model n).size) atTop (𝓝 0) ∧ Tendsto (fun n => (∑ C ∈ (QG n).parts, (SoficGroups.boundary (fun i : ↥SG => (A.model n).action (i : SoficGroups.prefixElementaryGroup SoficGroups.ninePrefixCode)) C : ℝ)) / (A.model n).size) atTop (𝓝 0)"},{"kind":"theorem","name":"eventually_scaled_tolerance_lt","statement":"(N t : ℕ → ℕ) (hN : ∀ n, 0 < N n) (ht : Tendsto (fun n => (t n : ℝ) / (N n : ℝ)) atTop (𝓝 0)) (c ell : ℝ) (hc : 0 < c) (hell : 0 < ell) : ∀ᶠ n in atTop, c * (t n : ℝ) < ell * (N n : ℝ)"},{"kind":"theorem","name":"exists_prescribed_radius_union_source_completed_tolerance","statement":"(V : ℕ → Type*) [∀ n, Fintype (V n)] [∀ n, DecidableEq (V n)] (hVpositive : ∀ n, 0 < Fintype.card (V n)) (hV : Tendsto (fun n => Fintype.card (V n)) atTop atTop) (root : (n : ℕ) → ℕ → Finset (V n)) (source : (n : ℕ) → Finset (V n)) (hroot : ∀ r : ℕ, Tendsto (fun n => ((root n r).card : ℝ) / Fintype.card (V n)) atTop (𝓝 0)) (hsource : Tendsto (fun n => ((source n).card : ℝ) / Fintype.card (V n)) atTop (𝓝 0)) (δ : ℕ → ℝ) (hδpositive : ∀ j, 0 < δ j) (hδ : Tendsto δ atTop (𝓝 0)) (R : ℕ → ℕ) (hR : ∀ j, j ≤ R j) (d : ℕ) (hd : 0 < d) (ell q : ℝ) (hell : 0 < ell) (hq : q < 1) : ∃ m rootError t : ℕ → ℕ, Tendsto m atTop atTop ∧ Tendsto (fun n => R (m n)) atTop atTop ∧ Tendsto (fun n => δ (m n)) atTop (𝓝 0) ∧ Tendsto (fun n => (((root n (R (m n)) ∪ source n).card : ℝ) / (δ (m n) * (Fintype.card (V n) : ℝ)))) atTop (𝓝 0) ∧ (∀ n, rootError n = Nat.ceil (δ (m n) * (Fintype.card (V n) : ℝ))) ∧ (∀ n, δ (m n) ≤ (rootError n : ℝ) / (Fintype.card (V n) : ℝ)) ∧ Tendsto (fun n => (rootError n : ℝ) / (Fintype.card (V n) : ℝ)) atTop (𝓝 0) ∧ (∀ n, t n = 2 * d * (root n (R (m n)) ∪ source n).card + rootError n + 1) ∧ (∀ n, 0 < t n) ∧ (∀ n, 2 * d * (root n (R (m n))).card ≤ t n) ∧ (∀ n, 2 * d * (source n).card ≤ t n) ∧ (∀ n, rootError n ≤ t n) ∧ Tendsto (fun n => (t n : ℝ) / (Fintype.card (V n) : ℝ)) atTop (𝓝 0) ∧ (∀ n, ell * δ (m n) / (2 * (ell + 8 * (d : ℝ))) ≤ ell * (t n : ℝ) / (2 * (ell + 8 * (d : ℝ)) * (Fintype.card (V n) : ℝ))) ∧ (∀ᶠ n in atTop, (10 : ℝ) * (t n : ℝ) < ell * (Fintype.card (V n) : ℝ)) ∧ (∀ᶠ n in atTop, (5 : ℝ) * (4 + ell * (216 / ((d : ℝ) * (1 - q) ^ 2) + 1 / (d : ℝ))) * (t n : ℝ) ≤ ell * (Fintype.card (V n) : ℝ))"},{"kind":"theorem","name":"sourceConjugacyDisagreementBad_density_tendsto_zero","statement":"{G : Type*} [Group G] (A : SoficGroups.SoficApproximation G) (u g : G) : Tendsto (fun n => ((sourceConjugacyDisagreementBad A u g n).card : ℝ) / (A.model n).size) atTop (nhds 0)"},{"kind":"theorem","name":"source_both_transported_generator_boundary_density_tendsto_zero","statement":"(A : SoficGroups.SoficApproximation (SoficGroups.prefixElementaryGroup SoficGroups.ninePrefixCode)) (S : Finset (SoficGroups.prefixElementaryGroup SoficGroups.alphaPrefixCode)) (hsymmetric : ∀ g ∈ S, g⁻¹ ∈ S) (hgenerates : Subgroup.closure (S : Set (SoficGroups.prefixElementaryGroup SoficGroups.alphaPrefixCode)) = ⊤) (Q : ∀ n, Finpartition (Finset.univ : Finset (Fin (A.model n).size))) (hsource : Tendsto (fun n => (∑ C ∈ (Q n).parts, (SoficGroups.boundary (fun i : ↥S => (A.model n).action (SoficGroups.SourceBothCompressionNormalization.sourceAlphaElement (i : SoficGroups.prefixElementaryGroup SoficGroups.alphaPrefixCode))) C : ℝ)) / (A.model n).size) atTop (nhds 0)) : ∀ j : Fin 2, Tendsto (fun n => (∑ C ∈ (Q n).parts, (SoficGroups.boundary (fun i : ↥S => (A.model n).action (SoficGroups.SourceBothCompressionNormalization.sourceCompressionTable j) * (A.model n).action (SoficGroups.SourceBothCompressionNormalization.sourceAlphaElement (i : SoficGroups.prefixElementaryGroup SoficGroups.alphaPrefixCode)) * ((A.model n).action (SoficGroups.SourceBothCompressionNormalization.sourceCompressionTable j