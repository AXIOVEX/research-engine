l.exp (-u)))) (-t / (2 * Real.pi))"},{"kind":"theorem","name":"mellinDenominator_re_pos","statement":"{ℓ : ℝ} (hℓ : 0 < ℓ) (t : ℝ) : 0 < (((ℓ : ℂ) + Complex.I * (t : ℂ)) / 2).re"},{"kind":"theorem","name":"mellinMultiplier_denominator_ne_zero","statement":"{ℓ : ℝ} (hℓ : 0 < ℓ) (t : ℝ) : Complex.Gamma (((ℓ : ℂ) + Complex.I * (t : ℂ)) / 2) ≠ 0"},{"kind":"theorem","name":"gamma_add_nat_eq_product","statement":"(z : ℂ) (hz : ∀ j : ℕ, z + (j : ℂ) ≠ 0) (k : ℕ) : Complex.Gamma (z + (k : ℂ)) = Complex.Gamma z * ∏ j ∈ Finset.range k, (z + (j : ℂ))"},{"kind":"theorem","name":"integer_gamma_product","statement":"(k : ℕ) {y : ℝ} (hy : y ≠ 0) : Complex.Gamma ((k : ℂ) + Complex.I * (y : ℂ) / 2) = Complex.Gamma (Complex.I * (y : ℂ) / 2) * ∏ j ∈ Finset.range k, ((j : ℂ) + Complex.I * (y : ℂ) / 2)"},{"kind":"theorem","name":"half_integer_gamma_product","statement":"(k : ℕ) (y : ℝ) : Complex.Gamma ((k : ℂ) + (1 / 2 : ℂ) + Complex.I * (y : ℂ) / 2) = Complex.Gamma ((1 / 2 : ℂ) + Complex.I * (y : ℂ) / 2) * ∏ j ∈ Finset.range k, ((j : ℂ) + (1 / 2 : ℂ) + Complex.I * (y : ℂ) / 2)"},{"kind":"theorem","name":"IsRadial.even","statement":"{d : ℕ} {f : TestFunction d} (hf : IsRadial f) : IsEven f"},{"kind":"theorem","name":"fourierInv_apply_zero","statement":"{d : ℕ} (f : TestFunction d) : (𝓕⁻ f : TestFunction d) (0 : Euclidean d) = ∫ x : Euclidean d, f x"},{"kind":"theorem","name":"admissible_zero_pos","statement":"{d : ℕ} (f : Admissible d) : 0 < (f.function (0 : Euclidean d)).re"},{"kind":"theorem","name":"quotient_pos","statement":"{d : ℕ} (f : Admissible d) : 0 < quotient f"},{"kind":"theorem","name":"quotientSet_bddBelow","statement":"(d : ℕ) : BddBelow (quotientSet d)"},{"kind":"theorem","name":"normalizedCost_nonneg","statement":"{d : ℕ} (f : Admissible d) : 0 ≤ normalizedCost f"},{"kind":"theorem","name":"normalizedCostSet_bddBelow","statement":"(d : ℕ) : BddBelow (Set.range (normalizedCost (d"},{"kind":"theorem","name":"fourier_sq_apply","statement":"{d : ℕ} (f : TestFunction d) (x : Euclidean d) : ((𝓕 (𝓕 f) : TestFunction d) x) = f (-x)"},{"kind":"theorem","name":"fourier_sq_of_radial","statement":"{d : ℕ} (f : TestFunction d) (hf : IsRadial f) : (𝓕 (𝓕 f) : TestFunction d) = f"},{"kind":"theorem","name":"fourier_antiFourierPart","statement":"{d : ℕ} (f : TestFunction d) (hf : IsRadial f) : (𝓕 (antiFourierPart f) : TestFunction d) = -antiFourierPart f"},{"kind":"theorem","name":"antiFourierPart_zero","statement":"{d : ℕ} (f : TestFunction d) (hbalance : (𝓕 f : TestFunction d) (0 : Euclidean d) = f 0) : antiFourierPart f (0 : Euclidean d) = 0"},{"kind":"theorem","name":"antiFourierPart_nonneg_of_signs","statement":"{d : ℕ} (f : TestFunction d) (R : ℝ) (hfourier : ∀ x : Euclidean d, 0 ≤ ((𝓕 f) x).re) (houtside : ∀ x : Euclidean d, R ≤ ‖x‖ → (f x).re ≤ 0) (x : Euclidean d) (hx : R ≤ ‖x‖) : 0 ≤ (antiFourierPart f x).re"},{"kind":"theorem","name":"IsRealValued.dilate","statement":"{d : ℕ} {f : TestFunction d} (hf : IsRealValued f) (a : ℝ) (ha : 0 < a) : IsRealValued (dilate f a ha)"},{"kind":"theorem","name":"IsRadial.dilate","statement":"{d : ℕ} {f : TestFunction d} (hf : IsRadial f) (a : ℝ) (ha : 0 < a) : IsRadial (dilate f a ha)"},{"kind":"theorem","name":"fourier_dilate_apply","statement":"{d : ℕ} (f : TestFunction d) (a : ℝ) (ha : 0 < a) (ξ : Euclidean d) : ((𝓕 (dilate f a ha) : TestFunction d) ξ) = (a ^ d)⁻¹ • ((𝓕 f : TestFunction d) (a⁻¹ • ξ))"},{"kind":"theorem","name":"fourier_dilate_zero","statement":"{d : ℕ} (f : TestFunction d) (a : ℝ) (ha : 0 < a) : ((𝓕 (dilate f a ha) : TestFunction d) (0 : Euclidean d)) = (a ^ d)⁻¹ • ((𝓕 f : TestFunction d) (0 : Euclidean d))"},{"kind":"theorem","name":"balancingScale_pos","statement":"{d : ℕ} (f : Admissible d) : 0 < balancingScale f"},{"kind":"theorem","name":"balancingScale_pow","statement":"{d : ℕ} (f : Admissible d) (hd : 0 < d) : balancingScale f ^ d = ((𝓕 f.function : TestFunction d) (0 : Euclidean d)).re / (f.function (0 : Euclidean d)).re"},{"kind":"theorem","name":"balancingScale_inv_eq_quoti