{"actor":"archivist","hash":"a7401066143f631af24121d4bd0ad15c77fe2639e8d4c9d314c8fa4ae3577faf","payload":{"artifact":{"admit_count":0,"byte_length":32896,"compile_detail":{"method":"sorry/admit counted over comment-stripped bytes"},"compile_status":"not_attempted","declarations":[{"kind":"lemma","name":"H_val","statement":"(X : Set ℤ) (x : ℤ) : let a"},{"kind":"lemma","name":"sum_H","statement":"(X : Set ℤ) (S : Finset ℤ) : ∑ x ∈ S, (ind X x + ind X (x+1) + ind X (x+2) + ind X x * ind X (x+2) + ind X (x+1) * ind X (x+3)) ≥ ∑ x ∈ S, (ind X x * ind X (x+1) + 2 * ind X (x+1) * ind X (x+2) + ind X (x+2) * ind X (x+3) + ind X x * ind X (x+3))"},{"kind":"lemma","name":"universal_parity_3","statement":"(X : Set ℤ) (hX : X.Finite) : 4 * N_k_Z X 1 + N_k_Z X 3 ≤ 3 * X.ncard + 2 * N_k_Z X 2"},{"kind":"lemma","name":"I_identity_Z","statement":"(X : Set ℤ) (hX : X.Finite) : I_Z X + 2 * N_k_Z X 1 = X.ncard + V_2_Z X"},{"kind":"lemma","name":"C_bound","statement":"(X : Set ℤ) (hX : X.Finite) : (C_set_Z X).ncard ≤ (C1 X).ncard + (C3 X).ncard ∧ (C_set_Z X).ncard ≤ (C2 X).ncard + (C4 X).ncard"},{"kind":"lemma","name":"C1_bound","statement":"(X : Set ℤ) (hX : X.Finite) : (C1 X).ncard ≤ I_Z X"},{"kind":"lemma","name":"C2_bound","statement":"(X : Set ℤ) (hX : X.Finite) : (C2 X).ncard ≤ I_Z X"},{"kind":"lemma","name":"C34_bound","statement":"(X : Set ℤ) (hX : X.Finite) : (C3 X).ncard + (C4 X).ncard ≤ N_k_Z X 3"},{"kind":"lemma","name":"local_pattern_C_Z","statement":"(X : Set ℤ) (hX : X.Finite) : 2 * (C_set_Z X).ncard ≤ N_k_Z X 3 + 2 * I_Z X"},{"kind":"lemma","name":"local_pattern_bound_Z_hN","statement":"(X : Set ℤ) (hX : X.Finite) : N_k_Z X 2 = V_2_Z X + (C_set_Z X).ncard"},{"kind":"lemma","name":"local_pattern_bound_Z","statement":"(X : Set ℤ) (hX : X.Finite) : 2 * N_k_Z X 2 ≤ N_k_Z X 3 + 2 * V_2_Z X + 2 * I_Z X"},{"kind":"lemma","name":"num_isolated_Z_rel","statement":"(A : Set ℕ) : I_Z (Z_S (A + A)) ≤ num_isolated A + 1"},{"kind":"lemma","name":"N_k_Z_rel_1","statement":"(A : Set ℕ) : N_k_Z (Z_S (A + A)) (1 : ℤ) = N_k_N (A + A) 1"},{"kind":"lemma","name":"N_k_Z_rel_2","statement":"(A : Set ℕ) : N_k_Z (Z_S (A + A)) (2 : ℤ) = N_k_N (A + A) 2"},{"kind":"lemma","name":"N_k_Z_rel_3","statement":"(A : Set ℕ) : N_k_Z (Z_S (A + A)) (3 : ℤ) = N_k_N (A + A) 3"},{"kind":"lemma","name":"Z_S_card","statement":"(A : Set ℕ) : (Z_S (A + A)).ncard = (A + A).ncard"},{"kind":"lemma","name":"quad_upper_Q0","statement":"(A : Set ℕ) (k : ℕ) (_ : IsSidon A) (hA : A.Finite) (hk : k > 0) : {q ∈ quad_k_N A k | (q.1 : ℤ) - q.2.2.1 = 0}.ncard ≤ A.ncard"},{"kind":"lemma","name":"quad_upper_Qk_inj","statement":"(A : Set ℕ) (k : ℕ) (_ : IsSidon A) (hk : k > 0) : InjOn (fun q : ℕ × ℕ × ℕ × ℕ => q.2.1) {q ∈ quad_k_N A k | (q.1 : ℤ) - q.2.2.1 = -k}"},{"kind":"lemma","name":"quad_upper_Qk_im","statement":"(A : Set ℕ) (k : ℕ) (_ : IsSidon A) (hk : k > 0) : (fun q : ℕ × ℕ × ℕ × ℕ => q.2.1) '' {q ∈ quad_k_N A k | (q.1 : ℤ) - q.2.2.1 = -k} ⊆ A"},{"kind":"lemma","name":"quad_upper_Qk","statement":"(A : Set ℕ) (k : ℕ) (hSidon : IsSidon A) (hA : A.Finite) (hk : k > 0) : {q ∈ quad_k_N A k | (q.1 : ℤ) - q.2.2.1 = -k}.ncard ≤ A.ncard"},{"kind":"lemma","name":"quad_upper_other_inj","statement":"(A : Set ℕ) (k : ℕ) (_ : IsSidon A) : InjOn (fun q : ℕ × ℕ × ℕ × ℕ => (q.1 : ℤ) - q.2.2.1) {q ∈ quad_k_N A k | (q.1 : ℤ) - q.2.2.1 ≠ 0 ∧ (q.1 : ℤ) - q.2.2.1 ≠ -k}"},{"kind":"lemma","name":"quad_upper_other_im","statement":"(A : Set ℕ) (k : ℕ) (_ : IsSidon A) : (fun q : ℕ × ℕ × ℕ × ℕ => (q.1 : ℤ) - q.2.2.1) '' {q ∈ quad_k_N A k | (q.1 : ℤ) - q.2.2.1 ≠ 0 ∧ (q.1 : ℤ) - q.2.2.1 ≠ -k} ⊆ {x ∈ D_set A | x + k ∈ D_set A}"},{"kind":"lemma","name":"quad_upper_other","statement":"(A : Set ℕ) (k : ℕ) (hSidon : IsSidon A) (_ : A.Finite) : {q ∈ quad_k_N A k | (q.1 : ℤ) - q.2.2.1 ≠ 0 ∧ (q.1 : ℤ) - q.2.2.1 ≠ -k}.ncard ≤ N_k_Z (D_set A) k"},{"kind":"lemma","name":"quad_upper_part","statement":"(A : Set ℕ) (k : ℕ) (_ : A.Finite) : (quad_k_N A k).ncard ≤ {q ∈ quad_k_N A k | (q.1 : ℤ) - q.2.2.1 = 0}.ncard + {q ∈ quad_k_N A k | (q.1 : ℤ) - q.2.2.1 = -k}.ncard + {q ∈ quad_k_N A k | (q.1 : ℤ) - q.2.2.1 ≠ 0 ∧ (q.1 : ℤ) - q.2.2.1 ≠ -k}.ncard"},{"kind":"lemma","name":"quad_upper","statement":"(A : Set ℕ) (k : ℕ) (hSidon : IsSidon A) (hA : A.Finite) (hk : k > 0) : (quad_k_N A k).ncard ≤ N_k_Z (D_set A) k + 2 * A.ncard"},{"kind":"lemma","name":"quad_fiber_subset","statement":"(A : Set ℕ) (hA : A.Finite) (s k : ℕ) : quad_fiber A s k ⊆ quad_k_N A k"},{"kind":"lemma","name":"quad_fiber_card","statement":"(A : Set ℕ) (hA : A.Finite) (k : ℕ) (s : ℕ) (hs : s ∈ S_good A k) : 4 ≤ (quad_fiber A s k).ncard"},{"kind":"lemma","name":"quad_fiber_disjoint","statement":"(A : Set ℕ) (hA : A.Finite) (k : ℕ) (s1 s2 : ℕ) (h : s1 ≠ s2) : Disjoint (quad_fiber A s1 k) (quad_fiber A s2 k)"},{"kind":"lemma","name":"quad_lower_sub_fin","statement":"(A : Set ℕ) (k : ℕ) (hA : A.Finite) : (S_good A k).Finite"},{"kind":"lemma","name":"quad_lower_sub","statement":"(A : Set ℕ) (k : ℕ) (hA : A.Finite) : 4 * (S_good A k).ncard ≤ (quad_k_N A k).ncard"},{"kind":"lemma","name":"quad_lower_edges","statement":"(A : Set ℕ) (k : ℕ) (hA : A.Finite) : N_k_N (A + A) k ≤ (S_good A k).ncard + 2 * A.ncard"},{"kind":"lemma","name":"quad_lower","statement":"(A : Set ℕ) (k : ℕ) (hSidon : IsSidon A) (hA : A.Finite) : 4 * N_k_N (A + A) k ≤ (quad_k_N A k).ncard + 8 * A.ncard"},{"kind":"lemma","name":"quad_lower_2","statement":"(A : Set ℕ) (k : ℕ) (hSidon : IsSidon A) (hA : A.Finite) : N_k_Z (D_set A) k ≤ (quad_k_N A k).ncard + 2 * A.ncard"},{"kind":"lemma","name":"quad_upper_2","statement":"(A : Set ℕ) (k : ℕ) (hSidon : IsSidon A) (hA : A.Finite) : (quad_k_N A k).ncard ≤ 4 * N_k_N (A + A) k + 2 * A.ncard"},{"kind":"lemma","name":"N_bound_upper_1","statement":"(A : Set ℕ) (hA : A.Finite) (hSidon : IsSidon A) : 4 * N_k_N (A + A) 1 ≤ N_k_Z (D_set A) 1 + 10 * A.ncard"},{"kind":"lemma","name":"N_bound_lower_2","statement":"(A : Set ℕ) (hA : A.Finite) (hSidon : IsSidon A) : N_k_Z (D_set A) 2 ≤ 4 * N_k_N (A + A) 2 + 10 * A.ncard"},{"kind":"lemma","name":"N_bound_upper_3","statement":"(A : Set ℕ) (hA : A.Finite) (hSidon : IsSidon A) : 4 * N_k_N (A + A) 3 ≤ N_k_Z (D_set A) 3 + 10 * A.ncard"},{"kind":"lemma","name":"D_set_card","statement":"(A : Set ℕ) (hA : A.Finite) : (D_set A).ncard ≤ A.ncard * A.ncard"},{"kind":"lemma","name":"S_card","statement":"(A : Set ℕ) (hA : A.Finite) (hSidon : IsSidon A) : 2 * (A + A).ncard ≥ A.ncard * A.ncard"},{"kind":"lemma","name":"num_isolated_lower_bound","statement":"(n : ℕ) (hn : n > 0) (A : Set ℕ) (h_card : A.ncard = n) (h_sidon : IsSidon A) : 16 * num_isolated A + 100 * n + 16 ≥ n * n"},{"kind":"lemma","name":"exists_sidon_set_n","statement":"(n : ℕ) : ∃ A : Set ℕ, A.ncard = n ∧ IsSidon A"},{"kind":"lemma","name":"f_lower_bound_div","statement":"(n : ℕ) : f n ≥ (n * n - 100 * n - 16) / 16"},{"kind":"lemma","name":"tendsto_bound","statement":"Tendsto (fun n : ℕ => (n * n - 100 * n - 16) / 16) atTop atTop"},{"kind":"lemma","name":"tendsto_f","statement":"Tendsto f atTop atTop"},{"kind":"theorem","name":"target_theorem_0","statement":"answer( -- EVOLVE-VALUE-START True -- EVOLVE-VALUE-END ) ↔ Tendsto f atTop atTop"}],"retrieved":"2026-10-12","sha256":"fb9cf6bb4de746f9e520e07ce9fccbddd6cd63eafb674bbe60dd457a827c6e35","sorry_count":0,"url":"https://github.com/google-deepmind/alphaproof-nexus-results/blob/main/APNOutputs/ErdosProblems/erdos_152.lean"}},"prev_hash":"d954fd3ac260ff5147c9ad05541289f15d4bcffa8d526b97a71aafe80754f27d","seq":52,"ts":1791808522,"type":"math.lean_ingested"}
