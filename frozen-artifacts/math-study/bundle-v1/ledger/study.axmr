: TestFunction d) = -antiFourierPart f"},{"kind":"theorem","name":"antiFourierPart_zero","statement":"{d : ℕ} (f : TestFunction d) (hbalance : (𝓕 f : TestFunction d) (0 : Euclidean d) = f 0) : antiFourierPart f (0 : Euclidean d) = 0"},{"kind":"theorem","name":"antiFourierPart_nonneg_of_signs","statement":"{d : ℕ} (f : TestFunction d) (R : ℝ) (hfourier : ∀ x : Euclidean d, 0 ≤ ((𝓕 f) x).re) (houtside : ∀ x : Euclidean d, R ≤ ‖x‖ → (f x).re ≤ 0) (x : Euclidean d) (hx : R ≤ ‖x‖) : 0 ≤ (antiFourierPart f x).re"},{"kind":"theorem","name":"IsRealValued.dilate","statement":"{d : ℕ} {f : TestFunction d} (hf : IsRealValued f) (a : ℝ) (ha : 0 < a) : IsRealValued (dilate f a ha)"},{"kind":"theorem","name":"IsRadial.dilate","statement":"{d : ℕ} {f : TestFunction d} (hf : IsRadial f) (a : ℝ) (ha : 0 < a) : IsRadial (dilate f a ha)"},{"kind":"theorem","name":"fourier_dilate_apply","statement":"{d : ℕ} (f : TestFunction d) (a : ℝ) (ha : 0 < a) (ξ : Euclidean d) : ((𝓕 (dilate f a ha) : TestFunction d) ξ) = (a ^ d)⁻¹ • ((𝓕 f : TestFunction d) (a⁻¹ • ξ))"},{"kind":"theorem","name":"fourier_dilate_zero","statement":"{d : ℕ} (f : TestFunction d) (a : ℝ) (ha : 0 < a) : ((𝓕 (dilate f a ha) : TestFunction d) (0 : Euclidean d)) = (a ^ d)⁻¹ • ((𝓕 f : TestFunction d) (0 : Euclidean d))"},{"kind":"theorem","name":"balancingScale_pos","statement":"{d : ℕ} (f : Admissible d) : 0 < balancingScale f"},{"kind":"theorem","name":"balancingScale_pow","statement":"{d : ℕ} (f : Admissible d) (hd : 0 < d) : balancingScale f ^ d = ((𝓕 f.function : TestFunction d) (0 : Euclidean d)).re / (f.function (0 : Euclidean d)).re"},{"kind":"theorem","name":"balancingScale_inv_eq_quotient_rpow","statement":"{d : ℕ} (f : Admissible d) : (balancingScale f)⁻¹ = quotient f ^ ((d : ℝ)⁻¹)"},{"kind":"theorem","name":"balancingScale_inv_eq_normalizedCost_mul_sqrt","statement":"{d : ℕ} (f : Admissible d) (hd : 0 < d) : (balancingScale f)⁻¹ = normalizedCost f * Real.sqrt (d : ℝ)"},{"kind":"theorem","name":"balancedFunction_real","statement":"{d : ℕ} (f : Admissible d) : IsRealValued (balancedFunction f)"},{"kind":"theorem","name":"balancedFunction_radial","statement":"{d : ℕ} (f : Admissible d) : IsRadial (balancedFunction f)"},{"kind":"theorem","name":"balancedFunction_fourier_real","statement":"{d : ℕ} (f : Admissible d) : IsRealValued (𝓕 (balancedFunction f) : TestFunction d)"},{"kind":"theorem","name":"balancedFunction_fourier_nonneg","statement":"{d : ℕ} (f : Admissible d) (ξ : Euclidean d) : 0 ≤ ((𝓕 (balancedFunction f) : TestFunction d) ξ).re"},{"kind":"theorem","name":"balancedFunction_fourier_radial","statement":"{d : ℕ} (f : Admissible d) : IsRadial (𝓕 (balancedFunction f) : TestFunction d)"},{"kind":"theorem","name":"balancedFunction_fourier_zero","statement":"{d : ℕ} (f : Admissible d) (hd : 0 < d) : ((𝓕 (balancedFunction f) : TestFunction d) (0 : Euclidean d)) = balancedFunction f 0"},{"kind":"theorem","name":"balancedFunction_outside_nonpos","statement":"{d : ℕ} (f : Admissible d) (x : Euclidean d) (hx : (balancingScale f)⁻¹ ≤ ‖x‖) : (balancedFunction f x).re ≤ 0"},{"kind":"theorem","name":"fourier_balancedAntiFourierPart","statement":"{d : ℕ} (f : Admissible d) : (𝓕 (balancedAntiFourierPart f) : TestFunction d) = -balancedAntiFourierPart f"},{"kind":"theorem","name":"balancedAntiFourierPart_zero","statement":"{d : ℕ} (f : Admissible d) (hd : 0 < d) : balancedAntiFourierPart f (0 : Euclidean d) = 0"},{"kind":"theorem","name":"balancedAntiFourierPart_real","statement":"{d : ℕ} (f : Admissible d) : IsRealValued (balancedAntiFourierPart f)"},{"kind":"theorem","name":"balancedAntiFourierPart_radial","statement":"{d : ℕ} (f : Admissible d) : IsRadial (balancedAntiFourierPart f)"},{"kind":"theorem","name":"balancedAntiFourierPart_nonneg","statement":"{d : ℕ} (f : Admissible d) (x : Euclidean d) (hx : (balancingScale f)⁻¹ ≤ ‖x‖) : 0 ≤ (balancedAntiFourierPart f x).re"},{"kind":"theorem","name":"balancedAntiFourierPart_eq_zero_iff","statement":"{d : ℕ} (f : Admissible d) : balancedAntiFourierPart f = 0 ↔ (𝓕 (balancedFunction f) : TestFunction d) = balancedFunction f"},{"kind":"theorem","name":"balancedFunction_support_subset_of_anti_zero","statement":"{d : ℕ} (f : Admissible d) (hzero : balancedAntiFourierPart f = 0) : Function.support (balancedFunction f : Euclidean d → ℂ) ⊆ Metric.closedBall (0 : Euclidean d) (balancingScale f)⁻¹"},{"kind":"theorem","name":"balancedFunction_hasCompactSupport_of_anti_zero","statement":"{d : ℕ} (f : Admissible d) (hzero : balancedAntiFourierPart f = 0) : HasCompactSupport (balancedFunction f : Euclidean d → ℂ)"},{"kind":"theorem","name":"nonnegativeSchwartzDensity_continuous","statement":"{d : ℕ} (g : TestFunction d) (hg : ∀ x : Euclidean d, 0 ≤ (g x).re) : Continuous (nonnegativeSchwartzDensity g hg)"},{"kind":"theorem","name":"integrableExpSet_nonnegativeSchwartzMeasure_eq_univ","statement":"{d : ℕ} (g : TestFunction d) (hg : ∀ x : Euclidean d, 0 ≤ (g x).re) (hcompact : HasCompactSupport (g : Euclidean d → ℂ)) (X : Euclidean d → ℝ) (hX : Continuous X) : ProbabilityTheory.integrableExpSet X (nonnegativeSchwartzMeasure g hg) = Set.univ"},{"kind":"theorem","name":"nonnegativeSchwartz_complexMGF_analytic","statement":"{d : ℕ} (g : TestFunction d) (hg : ∀ x : Euclidean d, 0 ≤ (g x).re) (hcompact : HasCompactSupport (g : Euclidean d → ℂ)) (X : Euclidean d → ℝ) (hX : Continuous X) : AnalyticOnNhd ℂ (ProbabilityTheory.complexMGF X (nonnegativeSchwartzMeasure g hg)) Set.univ"},{"kind":"theorem","name":"nonnegativeSchwartz_complexMGF_mul_I","statement":"{d : ℕ} (g : TestFunction d) (hreal : IsRealValued g) (hg : ∀ x : Euclidean d, 0 ≤ (g x).re) (e : Euclidean d) (t : ℝ) : ProbabilityTheory.complexMGF (fun x : Euclidean d => -2 * Real.pi * @inner ℝ (Euclidean d) _ x e) (nonnegativeSchwartzMeasure g hg) ((t : ℂ) * Complex.I) = ((𝓕 g : TestFunction d) (t • e))"},{"kind":"theorem","name":"analytic_eq_zero_of_imaginary_ray","statement":"(F : ℂ → ℂ) (hF : AnalyticOnNhd ℂ F Set.univ) (T : ℝ) (hvanish : ∀ t : ℝ, T < t → F ((t : ℂ) * Complex.I) = 0) : F = 0"},{"kind":"theorem","name":"nonnegative_compact_fourier_fixed_eq_zero","statement":"{d : ℕ} (hd : 0 < d) (g : TestFunction d) (hreal : IsRealValued g) (hg : ∀ x : Euclidean d, 0 ≤ (g x).re) (hcompact : HasCompactSupport (g : Euclidean d → ℂ)) (hfixed : (𝓕 g : TestFunction d) = g) : g = 0"},{"kind":"theorem","name":"balancedAntiFourierPart_ne_zero","statement":"{d : ℕ} (f : Admissible d) (hd : 0 < d) : balancedAntiFourierPart f ≠ 0"},{"kind":"theorem","name":"normalizedCost_ge_of_no_antiFourierWitness","statement":"{d : ℕ} (f : Admissible d) (hd : 0 < d) (c : ℝ) (hno : IsEmpty (AntiFourierWitness d (c * Real.sqrt (d : ℝ)))) : c ≤ normalizedCost f"},{"kind":"theorem","name":"sqrt_pi_pow_eq_rpow","statement":"(d : ℕ) : Real.sqrt Real.pi ^ d = Real.pi ^ ((d : ℝ) / 2)"},{"kind":"theorem","name":"volume_unitBall","statement":"{d : ℕ} (hd : 0 < d) : volume (ball (0 : Euclidean d) (1 : ℝ)) = ENNReal.ofReal (unitBallVolume d)"},{"kind":"theorem","name":"unitBallVolume_even","statement":"(k : ℕ) : unitBallVolume (2 * k) = Real.pi ^ k / (k.factorial : ℝ)"},{"kind":"theorem","name":"norm_radialUnitDirection","statement":"{d : ℕ} (hd : 0 < d) : ‖radialUnitDirection hd‖ = 1"},{"kind":"theorem","name":"radialProfile_norm","statement":"{d : ℕ} (hd : 0 < d) (f : TestFunction d) (hf : IsRadial f) (x : Euclidean d) : radialProfile hd f ‖x‖ = f x"},{"kind":"theorem","name":"radialProfile_neg","statement":"{d : ℕ} (hd : 0 < d) (f : TestFunction d) (hf : IsRadial f) (r : ℝ) : radialProfile hd f (-r) = radialProfile hd f r"},{"kind":"theorem","name":"radialProfile_continuous","statement":"{d : ℕ} (hd : 0 < d) (f : TestFunction d) : Continuous (radialProfile hd f)"},{"kind":"theorem","name":"radialProfile_real","statement":"{d : ℕ} (hd : 0 < d) (f : TestFunction d) (hf : IsRealValued f) (r : ℝ) : (radialProfile hd f r).im = 0"},{"kind":"theorem","name":"volume_real_unitBall","statement":"{d : ℕ} (hd : 0 < d) : volume.real (ball (0 : Euclidean d) (1 : ℝ)) = unitBallVolume d"},{"kind":"theorem","name":"radialSurfaceArea_pos","statement":"{d : ℕ} (hd : 0 < d) : 0 < radialSurfaceArea d"},{"kind":"theorem","name":"integral_radialProfile_mul","statement":"{d : ℕ} (hd : 0 < d) (f : TestFunction d) (hf : IsRadial f) (w : ℝ → ℂ) : (∫ x : Euclidean d, f x * w ‖x‖) = radialSurfaceArea d • ∫ r : ℝ in Ioi 0, r ^ (d - 1) • (radialProfile hd f r * w r)"},{"kind":"theorem","name":"integral_radialProfile_cpow","statement":"{d : ℕ} (hd : 0 < d) (f : TestFunction d) (hf : IsRadial f) (s : ℂ) : (∫ x : Euclidean d, f x * (‖x‖ : ℂ) ^ (s - (d : ℂ))) = radialSurfaceArea d • mellin (radialProfile hd f) s"},{"kind":"theorem","name":"radialMellinFrequency_eq_fourier","statement":"{d : ℕ} (hd : 0 < d) (f : TestFunction d) (t : ℝ) : radialMellinFrequency hd f t = (𝓕 (fun u : ℝ => Real.exp (-((d : ℝ) / 2) * u) • radialProfile hd f (Real.exp (-u)))) (-t / (2 * Real.pi))"},{"kind":"theorem","name":"gaussianMellin_fourier_radial","statement":"{d : ℕ} {f : TestFunction d} (hf : IsRadial f) : IsRadial (𝓕 f : TestFunction d)"},{"kind":"theorem","name":"gaussianMellinWeight_integrable","statement":"{d : ℕ} (a : ℝ) (ha : 0 < a) : Integrable (gaussianMellinWeight d a) (volume : Measure (Euclidean d))"},{"kind":"theorem","name":"fourier_gaussianMellinWeight","statement":"{d : ℕ} (a : ℝ) (ha : 0 < a) (ξ : Euclidean d) : (𝓕 (gaussianMellinWeight d a) : Euclidean d → ℂ) ξ = ((Real.pi : ℂ) / (a : ℂ)) ^ ((d : ℂ) / 2) * Complex.exp (-((Real.pi : ℂ) ^ 2) * (‖ξ‖ : ℂ) ^ 2 / (a : ℂ))"},{"kind":"theorem","name":"fourier_gaussianMellin_pairing","statement":"{d : ℕ} (f : TestFunction d) (a : ℝ) (ha : 0 < a) : (∫ ξ : Euclidean d, ((𝓕 f : TestFunction d) ξ) * gaussianMellinWeight d a ξ) = ∫ x : Euclidean d, f x * (((Real.pi : ℂ) / (a : ℂ)) ^ ((d : ℂ) / 2) * Complex.exp (-((Real.pi : ℂ) ^ 2) * (‖x‖ : ℂ) ^ 2 / (a : ℂ)))"},{"kind":"theorem","name":"schwartz_mul_norm_cpow_integrable","statement":"{d : ℕ} (hd : 0 < d) (f : TestFunction d) (z : ℂ) (hlower : -(d : ℝ) < z.re) (hupper : z.re ≤ 0) : Integrable (fun x : Euclidean d => f x * (‖x‖ : ℂ) ^ z) (volume : Measure (Euclidean d))"},{"kind":"theorem","name":"gaussianMellinParameter_integrable","statement":"(b : ℂ) (hb : 0 < b.re) (r : ℝ) (hr : 0 < r) : IntegrableOn (fun a : ℝ => (a : ℂ) ^ (b - 1) * Complex.exp (-((r : ℂ) * (a : ℂ)))) (Ioi 0)"},{"kind":"theorem","name":"gaussianMellinParameter_norm_integral","statement":"(b : ℂ) (hb : 0 < b.re) (r : ℝ) (hr : 0 < r) : (∫ a : ℝ in Ioi 0, ‖(a : ℂ) ^ (b - 1) * Complex.exp (-((r : ℂ) * (a : ℂ)))‖) = (1 / r) ^ b.re * Real.Gamma b.re"},{"kind":"theorem","name":"gaussianMellin_inv_sq_rpow","statement":"(r b : ℝ) (hr : 0 ≤ r) : (1 / r ^ 2) ^ b = r ^ (-(2 * b))"},{"kind":"theorem","name":"gaussianMellin_inv_sq_cpow","statement":"(r : ℝ) (hr : 0 ≤ r) (b : ℂ) : (1 / (((r ^ 2 : ℝ) : ℂ))) ^ b = (r : ℂ) ^ (-(2 * b))"},{"kind":"theorem","name":"gaussianMellin_div_cpow","statement":"(p a : ℝ) (hp : 0 < p) (ha : 0 < a) (b : ℂ) : ((p : ℂ) / (a : ℂ)) ^ b = (p : ℂ) ^ b * (a : ℂ) ^ (-b)"},{"kind":"theorem","name":"gaussianMellin_pi_coefficient","statement":"(b q : ℂ) : (Real.pi : ℂ) ^ q * (((Real.pi ^ 2 : ℝ) : ℂ) ^ (b - q)) = (Real.pi : ℂ) ^ (2 * b - q)"},{"kind":"theorem","name":"gaussianMellinMixture_integrable","statement":"{d : ℕ} (hd : 0 < d) (f : TestFunction d) (b : ℂ) (hb : 0 < b.re) (hbd : 2 * b.re < (d : ℝ)) : Integrable (Function.uncurry (gaussianMellinMixture f b)) ((volume : Measure (Euclidean d)).prod (volume.restrict (Ioi (0 : ℝ))))"},{"kind":"theorem","name":"gaussianMellinMixture_fubini","statement":"{d : ℕ} (hd : 0 < d) (f : TestFunction d) (b : ℂ) (hb : 0 < b.re) (hbd : 2 * b.re < (d : ℝ)) : (∫ x : Euclidean d, ∫ a : ℝ in Ioi 0, gaussianMellinMixture f b x a) = ∫ a : ℝ in Ioi 0, ∫ x : Euclidean d, gaussianMellinMixture f b x a"},{"kind":"theorem","name":"gaussianMellinMixture_parameter_integral","statement":"{d : ℕ} (f : TestFunction d) (b : ℂ) (hb : 0 < b.re) (x : Euclidean d) (hx : x ≠ 0) : (∫ a : ℝ in Ioi 0, gaussianMellinMixture f b x a) = f x * ((‖x‖ : ℂ) ^ (-(2 * b)) * Complex.Gamma b)"},{"kind":"theorem","name":"mellin_gaussianMellinPairingProfile","statement":"{d : ℕ} (hd : 0 < d) (f : TestFunction d) (b : ℂ) (hb : 0 < b.re) (hbd : 2 * b.re < (d : ℝ)) : mellin (gaussianMellinPairingProfile f) b = Complex.Gamma b * (∫ x : Euclidean d, f x * (‖x‖ : ℂ) ^ (-(2 * b)))"},{"kind":"theorem","name":"gaussianMellinPairingProfile_fourier","statement":"{d : ℕ} (f : TestFunction d) (a : ℝ) (ha : 0 < a) : gaussianMellinPairingProfile (𝓕 f : TestFunction d) a = ((Real.pi : ℂ) / (a : ℂ)) ^ ((d : ℂ) / 2) * gaussianMellinPairingProfile f (Real.pi ^ 2 / a)"},{"kind":"theorem","name":"mellin_gaussianMellinPairingProfile_fourier","statement":"{d : ℕ} (f : TestFunction d) (b : ℂ) : mellin (gaussianMellinPairingProfile (𝓕 f : TestFunction d)) b = (Real.pi : ℂ) ^ ((d : ℂ) / 2) * (((Real.pi ^ 2 : ℝ) : ℂ) ^ (b - (d : ℂ) / 2) * mellin (gaussianMellinPairingProfile f) ((d : ℂ) / 2 - b))"},{"kind":"theorem","name":"fourier_riesz_pairing","statement":"{d : ℕ} (hd : 0 < d) (f : TestFunction d) (b : ℂ) (hb : 0 < b.re) (hbd : 2 * b.re < (d : ℝ)) : Complex.Gamma b * (∫ ξ : Euclidean d, (𝓕 f : TestFunction d) ξ * (‖ξ‖ : ℂ) ^ (-(2 * b))) = (Real.pi : ℂ) ^ ((d : ℂ) / 2) * (((Real.pi ^ 2 : ℝ) : ℂ) ^ (b - (d : ℂ) / 2) * (Complex.Gamma ((d : ℂ) / 2 - b) * (∫ x : Euclidean d, f x * (‖x‖ : ℂ) ^ (-(2 * ((d : ℂ) / 2 - b))))))"},{"kind":"theorem","name":"fourier_riesz_pairing_strip","statement":"{d : ℕ} (hd : 0 < d) (f : TestFunction d) (s : ℂ) (hs : 0 < s.re) (hsd : s.re < (d : ℝ)) : Complex.Gamma (((d : ℂ) - s) / 2) * (∫ ξ : Euclidean d, (𝓕 f : TestFunction d) ξ * (‖ξ‖ : ℂ) ^ (s - (d : ℂ))) = (Real.pi : ℂ) ^ ((d : ℂ) / 2 - s) * (Complex.Gamma (s / 2) * (∫ x : Euclidean d, f x * (‖x‖ : ℂ) ^ (-s)))"},{"kind":"theorem","name":"radial_fourier_mellin_strip","statement":"{d : ℕ} (hd : 0 < d) (f : TestFunction d) (hf : IsRadial f) (s : ℂ) (hs : 0 < s.re) (hsd : s.re < (d : ℝ)) : mellin (radialProfile hd (𝓕 f : TestFunction d)) s = ((Real.pi : ℂ) ^ ((d : ℂ) / 2 - s) * Complex.Gamma (s / 2) / Complex.Gamma (((d : ℂ) - s) / 2)) * mellin (radialProfile hd f) ((d : ℂ) - s)"},{"kind":"theorem","name":"radialMellinMultiplier","statement":"{d : ℕ} (hd : 0 < d) (f : TestFunction d) (hf : IsRadial f) (t : ℝ) : radialMellinFrequency hd (𝓕 f : TestFunction d) t = mellinMultiplier ((d : ℝ) / 2) t * radialMellinFrequency hd f (-t)"},{"kind":"theorem","name":"shellOscillation_eq_sinc","statement":"(B T : ℝ) : shellOscillation B T = 1 - Real.sinc (T / 2) * Real.cos ((B + 1 / 2) * T)"},{"kind":"theorem","name":"cos_le_quartic","statement":"{x : ℝ} (hx0 : 0 ≤ x) (hx1 : x ≤ 1) : Real.cos x ≤ 1 - x ^ 2 / 2 + x ^ 4 * (5 / 96 : ℝ)"},{"kind":"theorem","name":"sin_le_quintic","statement":"{x : ℝ} (hx0 : 0 ≤ x) (hx1 : x ≤ 1) : Real.sin x ≤ x - x ^ 3 / 6 + x ^ 5 / 96"},{"kind":"theorem","name":"sin_le_linear_sub_cubic","statement":"{x : ℝ} (hx0 : 0 ≤ x) (hxhalf : x ≤ (1 / 2 : ℝ)) : Real.sin x ≤ x - (4 / 25 : ℝ) * x ^ 3"},{"kind":"theorem","name":"sinc_abs","statement":"(x : ℝ) : Real.sinc |x| = Real.sinc x"},{"kind":"theorem","name":"sinc_quadratic_gap_nonneg","statement":"{x : ℝ} (hx0 : 0 ≤ x) (hxhalf : x ≤ (1 / 2 : ℝ)) : (4 / 25 : ℝ) * x ^ 2 ≤ 1 - |Real.sinc x|"},{"kind":"theorem","name":"abs_sinc_le_twentyfour_twentyfive","statement":"{x : ℝ} (hx : (1 / 2 : ℝ) ≤ x) : |Real.sinc x| ≤ (24 / 25 : ℝ)"},{"kind":"theorem","name":"sinc_explicit","statement":"(T : ℝ) : (1 / 25 : ℝ) * min (T ^ 2) 1 ≤ 1 - |Real.sinc (T / 2)|"},{"kind":"theorem","name":"shellOscillation_lower_bound","statement":"(B T : ℝ) : (1 / 25 : ℝ) * min (T ^ 2) 1 ≤ shellOscillation B T"},{"kind":"theorem","name":"cosh_ratio_lower","statement":"{a δ : ℝ} (ha : 0 ≤ a) (hδ : 0 ≤ δ) : Real.exp (δ * a) / 2 ≤ Real.cosh ((1 + δ) * a) / Real.cosh a"},{"kind":"theorem","name":"cosh_ratio_upper","statement":"{a δ : ℝ} (ha : 0 ≤ a) (hδ : 0 ≤ δ) : Real.cosh ((1 + δ) * a) / Real.cosh a ≤ Real.exp (δ * a)"},{"kind":"theorem","name":"positiveShellDamping_lower_bound","statement":"{ε ℓ δ T : ℝ} (hε : 0 < ε) (hℓ : 0 ≤ ℓ) (hδ : 0 ≤ δ) : ℓ / 50 * shellWeight ε * Real.exp (δ * shellLocation ε) * min (T ^ 2) 1 ≤ positiveShellDamping ε ℓ δ T"},{"kind":"theorem","name":"positiveShellRadiusContribution_bounds","statement":"{ε : ℝ} (hε : 0 < ε) : 0 ≤ positiveShellRadiusContribution ε ∧ positiveShellRadiusContribution ε ≤ (shellLocation ε + 1) * shellWeight ε * Real.exp ((ε / 4) * (shellLocation ε + 1))"},{"kind":"theorem","name":"mellinShellPhase_neg","statement":"(ε : ℝ) (z : ℂ) : mellinShellPhase ε (-z) = mellinShellPhase ε z"},{"kind":"theorem","name":"mellinShellPhase_ofReal","statement":"(ε t : ℝ) : mellinShellPhase ε (t : ℂ) = (realOscillatoryShellPhase ε t : ℂ)"},{"kind":"theorem","name":"mellinShellPhase_imaginary","statement":"(ε u : ℝ) : mellinShellPhase ε (Complex.I * (u : ℂ)) = (realHyperbolicShellPhase ε u : ℂ)"},{"kind":"theorem","name":"realHyperbolicShellPhase_neg","statement":"(ε u : ℝ) : realHyperbolicShellPhase ε (-u) = realHyperbolicShellPhase ε u"},{"kind":"theorem","name":"positiveShellDensity_continuous","statement":"(ε : ℝ) : Continuous (positiveShellDensity ε)"},{"kind":"theorem","name":"shortShellDensity_intervalIntegrable","statement":"{ε : ℝ} (hε : 0 < ε) (horder : shortCutoff ε ≤ shortEndpoint ε) : IntervalIntegrable (shortShellDensity ε) volume (shortCutoff ε) (shortEndpoint ε)"},{"kind":"theorem","name":"shortShellOscillatoryIntegral_continuous","statement":"{ε : ℝ} (hε : 0 < ε) (horder : shortCutoff ε ≤ shortEndpoint ε) : Continuous (fun t : ℝ => ∫ a in shortCutoff ε..shortEndpoint ε, shortShellDensity ε a * (Real.cos (a * t) - 1))"},{"kind":"theorem","name":"positiveShellOscillatoryIntegral_continuous","statement":"(ε : ℝ) : Continuous (fun t : ℝ => ∫ a in shellLocation ε..shellLocation ε + 1, positiveShellDensity ε a * (Real.cos (a * t) - 1))"},{"kind":"theorem","name":"realOscillatoryShellPhase_continuous","statement":"{ε : ℝ} (hε : 0 < ε) (horder : shortCutoff ε ≤ shortEndpoint ε) : Continuous (realOscillatoryShellPhase ε)"},{"kind":"theorem","name":"complexShellInterval_continuous","statement":"(w : ℝ → ℝ) (hw : Continuous w) {a b : ℝ} (hab : a ≤ b) : Continuous (fun z : ℂ => ∫ x in a..b, (w x : ℂ) * (Complex.cos ((x : ℂ) * z) - 1))"},{"kind":"theorem","name":"complexShellInterval_differentiable","statement":"(w : ℝ → ℝ) (hw : Continuous w) {a b : ℝ} (hab : a ≤ b) : Differentiable ℂ (fun z : ℂ => ∫ x in a..b, (w x : ℂ) * (Complex.cos ((x : ℂ) * z) - 1))"},{"kind":"theorem","name":"mellinShellPhase_continuous","statement":"{ε : ℝ} (hε : 0 < ε) (horder : shortCutoff ε ≤ shortEndpoint ε) : Continuous (mellinShellPhase ε)"},{"kind":"theorem","name":"mellinShellPhase_differentiable","statement":"{ε : ℝ} (hε : 0 < ε) (horder : shortCutoff ε ≤ shortEndpoint ε) : Differentiable ℂ (mellinShellPhase ε)"},{"kind":"theorem","name":"mellinShellPhase_analyticOnNhd","statement":"{ε : ℝ} (hε : 0 < ε) (horder : shortCutoff ε ≤ shortEndpoint ε) : AnalyticOnNhd ℂ (mellinShellPhase ε) Set.univ"},{"kind":"theorem","name":"abs_realOscillatoryShellPhase_le","statement":"{ε : ℝ} (hε : 0 < ε) (horder : shortCutoff ε ≤ shortEndpoint ε) (t : ℝ) : |realOscillatoryShellPhase ε t| ≤ 2 * saddleShellTotalVariation ε"},{"kind":"theorem","name":"mellinShellPhase_real_conj","statement":"(ε t : ℝ) : starRingEnd ℂ (mellinShellPhase ε (t : ℂ)) = mellinShellPhase ε (t : ℂ)"},{"kind":"theorem","name":"saddleVerticalGamma_continuous","statement":"{ℓ : ℝ} (hℓ : 0 < ℓ) : Continuous (fun t : ℝ => Complex.Gamma (((ℓ : ℂ) - Complex.I * (t : ℂ)) / 2))"},{"kind":"theorem","name":"saddleShellPhase_continuous","statement":"{ε : ℝ} (hε : 0 < ε) (horder : shortCutoff ε ≤ shortEndpoint ε) (ℓ : ℝ) : Continuous (fun t : ℝ => mellinShellPhase ε ((t : ℂ) / (ℓ : ℂ)))"},{"kind":"theorem","name":"saddleEnvelope_continuous","statement":"{ε ℓ : ℝ} (hε : 0 < ε) (hℓ : 0 < ℓ) (horder : shortCutoff ε ≤ shortEndpoint ε) : Continuous (saddleEnvelope ε ℓ)"},{"kind":"theorem","name":"plusSaddleSpectrum_continuous","statement":"{ε ℓ : ℝ} (hε : 0 < ε) (hℓ : 0 < ℓ) (horder : shortCutoff ε ≤ shortEndpoint ε) : Continuous (plusSaddleSpectrum ε ℓ)"},{"kind":"theorem","name":"minusSaddleSpectrum_continuous","statement":"{ε ℓ : ℝ} (hε : 0 < ε) (hℓ : 0 < ℓ) (horder : shortCutoff ε ≤ shortEndpoint ε) : Continuous (minusSaddleSpectrum ε ℓ)"},{"kind":"theorem","name":"saddleOriginValue_pos","statement":"{ε : ℝ} (hε : 0 < ε) (ℓ : ℝ) : 0 < saddleOriginValue ε ℓ"},{"kind":"theorem","name":"plusSaddleMellinData_eq_gamma_mul_regular","statement":"(ε ℓ : ℝ) (z : ℂ) : plusSaddleMellinData ε ℓ z = Complex.Gamma (z / 2) * plusSaddleRegularMellinFactor ε ℓ z"},{"kind":"theorem","name":"minusSaddleMellinData_eq_gamma_mul_regular","statement":"(ε ℓ : ℝ) (z : ℂ) : minusSaddleMellinData ε ℓ z = Complex.Gamma (z / 2) * minusSaddleRegularMellinFactor ε ℓ z"},{"kind":"theorem","name":"saddleRegularMellinFactor_continuous","statement":"{ε : ℝ} (hε : 0 < ε) (horder : shortCutoff ε ≤ shortEndpoint ε) (ℓ : ℝ) : Continuous (saddleRegularMellinFactor ε ℓ)"},{"kind":"theorem","name":"saddleRegularMellinFactor_differentiable","statement":"{ε : ℝ} (hε : 0 < ε) (horder : shortCutoff ε ≤ shortEndpoint ε) (ℓ : ℝ) : Differentiable ℂ (saddleRegularMellinFactor ε ℓ)"},{"kind":"theorem","name":"plusSaddleRegularMellinFactor_differentiable","statement":"{ε : ℝ} (hε : 0 < ε) (horder : shortCutoff ε ≤ shortEndpoint ε) (ℓ : ℝ) : Differentiable ℂ (plusSaddleRegularMellinFactor ε ℓ)"},{"kind":"theorem","name":"minusSaddleRegularMellinFactor_differentiable","statement":"{ε : ℝ} (hε : 0 < ε) (horder : shortCutoff ε ≤ shortEndpoint ε) (ℓ : ℝ) : Differentiable ℂ (minusSaddleRegularMellinFactor ε ℓ)"},{"kind":"theorem","name":"plusSaddleRegularMellinFactor_analyticOnNhd","statement":"{ε : ℝ} (hε : 0 < ε) (horder : shortCutoff ε ≤ shortEndpoint ε) (ℓ : ℝ) : AnalyticOnNhd ℂ (plusSaddleRegularMellinFactor ε ℓ) Set.univ"},{"kind":"theorem","name":"minusSaddleRegularMellinFactor_analyticOnNhd","statement":"{ε : ℝ} (hε : 0 < ε) (horder : shortCutoff ε ≤ shortEndpoint ε) (ℓ : ℝ) : AnalyticOnNhd ℂ (minusSaddleRegularMellinFactor ε ℓ) Set.univ"},{"kind":"theorem","name":"saddleMellinGamma_meromorphic","statement":"Meromorphic (fun z : ℂ => Complex.Gamma (z / 2))"},{"kind":"theorem","name":"plusSaddleMellinData_meromorphic","statement":"{ε : ℝ} (hε : 0 < ε) (horder : shortCutoff ε ≤ shortEndpoint ε) (ℓ : ℝ) : Meromorphic (plusSaddleMellinData ε ℓ)"},{"kind":"theorem","name":"minusSaddleMellinData_meromorphic","statement":"{ε : ℝ} (hε : 0 < ε) (horder : shortCutoff ε ≤ shortEndpoint ε) (ℓ : ℝ) : Meromorphic (minusSaddleMellinData ε ℓ)"},{"kind":"theorem","name":"saddleMellinGamma_differentiableAt_of_re_pos","statement":"{z : ℂ} (hz : 0 < z.re) : DifferentiableAt ℂ (fun w : ℂ => Complex.Gamma (w / 2)) z"},{"kind":"theorem","name":"saddleMellinGamma_differentiableOn_rightHalfPlane","statement":"DifferentiableOn ℂ (fun z : ℂ => Complex.Gamma (z / 2)) {z : ℂ | 0 < z.re}"},{"kind":"theorem","name":"plusSaddleMellinData_differentiableOn_rightHalfPlane","statement":"{ε : ℝ} (hε : 0 < ε) (horder : shortCutoff ε ≤ shortEndpoint ε) (ℓ : ℝ) : DifferentiableOn ℂ (plusSaddleMellinData ε ℓ) {z : ℂ | 0 < z.re}"},{"kind":"theorem","name":"minusSaddleMellinData_differentiableOn_rightHalfPlane","statement":"{ε : ℝ} (hε : 0 < ε) (horder : shortCutoff ε ≤ shortEndpoint ε) (ℓ : ℝ) : DifferentiableOn ℂ (minusSaddleMellinData ε ℓ) {z : ℂ | 0 < z.re}"},{"kind":"theorem","name":"saddleMellinShellArgument_zero","statement":"{ℓ : ℝ} (hℓ : 0 < ℓ) : Complex.I * ((0 : ℂ) - (ℓ : ℂ)) / (ℓ : ℂ) = -Complex.I"},{"kind":"theorem","name":"saddleMellinShellArgument_neg_even","statement":"{ℓ : ℝ} (hℓ : 0 < ℓ) (n : ℕ) : Complex.I * ((-((2 * n : ℕ) : ℂ)) - (ℓ : ℂ)) / (ℓ : ℂ) = Complex.I * ((-(1 + 2 * (n : ℝ) / ℓ) : ℝ) : ℂ)"},{"kind":"theorem","name":"mellinShellPhase_neg_I","statement":"(ε : ℝ) : mellinShellPhase ε (-Complex.I) = (realHyperbolicShellPhase ε 1 : ℂ)"},{"kind":"theorem","name":"plusPolynomial_neg_I","statement":"(ε : ℝ) : plusPolynomial ε (-Complex.I) = (beta ε : ℂ)"},{"kind":"theorem","name":"minusPolynomial_neg_I","statement":"(ε : ℝ) : minusPolynomial ε (-Complex.I) = (beta ε : ℂ)"},{"kind":"theorem","name":"saddleRegularMellinFactor_zero","statement":"{ε ℓ : ℝ} (hℓ : 0 < ℓ) : saddleRegularMellinFactor ε ℓ 0 = ((Real.pi ^ (ℓ / 2) * Real.exp (ℓ * realHyperbolicShellPhase ε 1) : ℝ) : ℂ)"},{"kind":"theorem","name":"saddleRegularMellinFactor_neg_even","statement":"{ε ℓ : ℝ} (hℓ : 0 < ℓ) (n : ℕ) : saddleRegularMellinFactor ε ℓ (-((2 * n : ℕ) : ℂ)) = ((Real.pi ^ (ℓ / 2 + (n : ℝ)) * Real.exp (ℓ * realHyperbolicShellPhase ε (1 + 2 * (n : ℝ) / ℓ)) : ℝ) : ℂ)"},{"kind":"theorem","name":"plusSaddleRegularMellinFactor_neg_even","statement":"{ε ℓ : ℝ} (hℓ : 0 < ℓ) (n : ℕ) : plusSaddleRegularMellinFactor ε ℓ (-((2 * n : ℕ) : ℂ)) = ((Real.pi ^ (ℓ / 2 + (n : ℝ)) * Real.exp (ℓ * realHyperbolicShellPhase ε (1 + 2 * (n : ℝ) / ℓ)) : ℝ) : ℂ) * plusPolynomial ε (Complex.I * ((-(1 + 2 * (n : ℝ) / ℓ) : ℝ) : ℂ))"},{"kind":"theorem","name":"two_mul_plusSaddleRegularMellinFactor_zero","statement":"{ε ℓ : ℝ} (hℓ : 0 < ℓ) : (2 : ℂ) * plusSaddleRegularMellinFactor ε ℓ 0 = (saddleOriginValue ε ℓ : ℂ)"},{"kind":"theorem","name":"two_mul_minusSaddleRegularMellinFactor_zero","statement":"{ε ℓ : ℝ} (hℓ : 0 < ℓ) : (2 : ℂ) * minusSaddleRegularMellinFactor ε ℓ 0 = (saddleOriginValue ε ℓ : ℂ)"},{"kind":"theorem","name":"complexGamma_residue_neg_nat","statement":"(n : ℕ) : Tendsto (fun z : ℂ => (z + (n : ℂ)) * Complex.Gamma z) (𝓝[≠] (-(n : ℂ))) (𝓝 (((-1 : ℂ) ^ n) / (n.factorial : ℂ)))"},{"kind":"theorem","name":"saddleGamma_residue_neg_even","statement":"(n : ℕ) : Tendsto (fun z : ℂ => (z + ((2 * n : ℕ) : ℂ)) * Complex.Gamma (z / 2)) (𝓝[≠] (-((2 * n : ℕ) : ℂ))) (𝓝 ((2 : ℂ) * (-1 : ℂ) ^ n / (n.factorial : ℂ)))"},{"kind":"theorem","name":"gamma_add_nat_eq_product_of_lt","statement":"(z : ℂ) (k : ℕ) (hz : ∀ j : ℕ, j < k → z + (j : ℂ) ≠ 0) : Complex.Gamma (z + (k : ℂ)) = Complex.Gamma z * ∏ j ∈ Finset.range k, (z + (j : ℂ))"},{"kind":"theorem","name":"saddlePole_mem_strip","statement":"(n : ℕ) : (-((2 * n : ℕ) : ℂ)) ∈ saddlePoleStrip n"},{"kind":"theorem","name":"isOpen_saddlePoleStrip","statement":"(n : ℕ) : IsOpen (saddlePoleStrip n)"},{"kind":"theorem","name":"saddlePoleLowerProduct_ne_zero","statement":"{n : ℕ} {z : ℂ} (hz : z ∈ saddlePoleStrip n) : saddlePoleLowerProduct n z ≠ 0"},{"kind":"theorem","name":"saddlePoleLowerProduct_differentiable","statement":"(n : ℕ) : Differentiable ℂ (saddlePoleLowerProduct n)"},{"kind":"theorem","name":"saddleGamma_eq_nthPoleNumerator_div","statement":"{n : ℕ} {z : ℂ} (hstrip : z ∈ saddlePoleStrip n) (hpole : z ≠ (-((2 * n : ℕ) : ℂ))) : Complex.Gamma (z / 2) = saddleNthGammaPoleNumerator n z / (z + ((2 * n : ℕ) : ℂ))"},{"kind":"theorem","name":"saddleNthGammaPoleNumerator_differentiableOn","statement":"(n : ℕ) : DifferentiableOn ℂ (saddleNthGammaPoleNumerator n) (saddlePoleStrip n)"},{"kind":"theorem","name":"saddleNthGammaPoleNumerator_at_pole","statement":"(n : ℕ) : saddleNthGammaPoleNumerator n (-((2 * n : ℕ) : ℂ)) = (2 : ℂ) * (-1 : ℂ) ^ n / (n.factorial : ℂ)"},{"kind":"theorem","name":"plusSaddleNthPoleNumerator_differentiableOn","statement":"{ε : ℝ} (hε : 0 < ε) (horder : shortCutoff ε ≤ shortEndpoint ε) (ℓ : ℝ) (n : ℕ) : DifferentiableOn ℂ (plusSaddleNthPoleNumerator ε ℓ n) (saddlePoleStrip n)"},{"kind":"theorem","name":"minusSaddleNthPoleNumerator_differentiableOn","statement":"{ε : ℝ} (hε : 0 < ε) (horder : shortCutoff ε ≤ shortEndpoint ε) (ℓ : ℝ) (n : ℕ) : DifferentiableOn ℂ (minusSaddleNthPoleNumerator ε ℓ n) (saddlePoleStrip n)"},{"kind":"theorem","name":"plusSaddleMellinData_eq_nthPoleNumerator_div","statement":"(ε ℓ : ℝ) {n : ℕ} {z : ℂ} (hstrip : z ∈ saddlePoleStrip n) (hpole : z ≠ (-((2 * n : ℕ) : ℂ))) : plusSaddleMellinData ε ℓ z = plusSaddleNthPoleNumerator ε ℓ n z / (z + ((2 * n : ℕ) : ℂ))"},{"kind":"theorem","name":"minusSaddleMellinData_eq_nthPoleNumerator_div","statement":"(ε ℓ : ℝ) {n : ℕ} {z : ℂ} (hstrip : z ∈ saddlePoleStrip n) (hpole : z ≠ (-((2 * n : ℕ) : ℂ))) : minusSaddleMellinData ε ℓ z = minusSaddleNthPoleNumerator ε ℓ n z / (z + ((2 * n : ℕ) : ℂ))"},{"kind":"theorem","name":"plusSaddleNthPoleNumerator_at_pole","statement":"(ε ℓ : ℝ) (n : ℕ) : plusSaddleNthPoleNumerator ε ℓ n (-((2 * n : ℕ) : ℂ)) = (2 : ℂ) * (-1 : ℂ) ^ n / (n.factorial : ℂ) * plusSaddleRegularMellinFactor ε ℓ (-((2 * n : ℕ) : ℂ))"},{"kind":"theorem","name":"minusSaddleNthPoleNumerator_at_pole","statement":"(ε ℓ : ℝ) (n : ℕ) : minusSaddleNthPoleNumerator ε ℓ n (-((2 * n : ℕ) : ℂ)) = (2 : ℂ) * (-1 : ℂ) ^ n / (n.factorial : ℂ) * minusSaddleRegularMellinFactor ε ℓ (-((2 * n : ℕ) : ℂ))"},{"kind":"theorem","name":"plusSaddleNthPoleNumerator_poleResidue","statement":"(ε ℓ : ℝ) (n : ℕ) : plusSaddleNthPoleNumerator ε ℓ n (-((2 * n : ℕ) : ℂ)) = plusSaddlePoleResidue ε ℓ n"},{"kind":"theorem","name":"minusSaddleNthPoleNumerator_poleResidue","statement":"(ε ℓ : ℝ) (n : ℕ) : minusSaddleNthPoleNumerator ε ℓ n (-((2 * n : ℕ) : ℂ)) = minusSaddlePoleResidue ε ℓ n"},{"kind":"theorem","name":"plusSaddleNthPoleRegularPart_differentiableOn","statement":"{ε : ℝ} (hε : 0 < ε) (horder : shortCutoff ε ≤ shortEndpoint ε) (ℓ : ℝ) (n : ℕ) : DifferentiableOn ℂ (plusSaddleNthPoleRegularPart ε ℓ n) (saddlePoleStrip n)"},{"kind":"theorem","name":"minusSaddleNthPoleRegularPart_differentiableOn","statement":"{ε : ℝ} (hε : 0 < ε) (horder : shortCutoff ε ≤ shortEndpoint ε) (ℓ : ℝ) (n : ℕ) : DifferentiableOn ℂ (minusSaddleNthPoleRegularPart ε ℓ n) (saddlePoleStrip n)"},{"kind":"theorem","name":"plusSaddleMellinData_nthPole_decomposition","statement":"(ε ℓ : ℝ) {n : ℕ} {z : ℂ} (hstrip : z ∈ saddlePoleStrip n) (hpole : z ≠ (-((2 * n : ℕ) : ℂ))) : plusSaddleMellinData ε ℓ z = plusSaddlePoleResidue ε ℓ n / (z + ((2 * n : ℕ) : ℂ)) + plusSaddleNthPoleRegularPart ε ℓ n z"},{"kind":"theorem","name":"minusSaddleMellinData_nthPole_decomposition","statement":"(ε ℓ : ℝ) {n : ℕ} {z : ℂ} (hstrip : z ∈ saddlePoleStrip n) (hpole : z ≠ (-((2 * n : ℕ) : ℂ))) : minusSaddleMellinData ε ℓ z = minusSaddlePoleResidue ε ℓ n / (z + ((2 * n : ℕ) : ℂ)) + minusSaddleNthPoleRegularPart ε ℓ n z"},{"kind":"theorem","name":"saddlePole_mem_finiteHalfPlane_iff","statement":"(N n : ℕ) : (-((2 * n : ℕ) : ℂ)) ∈ saddleFinitePoleHalfPlane N ↔ n ≤ N"},{"kind":"theorem","name":"saddleMellinGamma_differentiableAt_of_not_pole","statement":"{z : ℂ} (hz : ∀ n : ℕ, z ≠ (-((2 * n : ℕ) : ℂ))) : DifferentiableAt ℂ (fun w : ℂ => Complex.Gamma (w / 2)) z"},{"kind":"theorem","name":"plusSaddleMellinData_differentiableAt_of_not_pole","statement":"{ε : ℝ} (hε : 0 < ε) (horder : shortCutoff ε ≤ shortEndpoint ε) (ℓ : ℝ) {z : ℂ} (hz : ∀ n : ℕ, z ≠ (-((2 * n : ℕ) : ℂ))) : DifferentiableAt ℂ (plusSaddleMellinData ε ℓ) z"},{"kind":"theorem","name":"minusSaddleMellinData_differentiableAt_of_not_pole","statement":"{ε : ℝ} (hε : 0 < ε) (horder : shortCutoff ε ≤ shortEndpoint ε) (ℓ : ℝ) {z : ℂ} (hz : ∀ n : ℕ, z ≠ (-((2 * n : ℕ) : ℂ))) : DifferentiableAt ℂ (minusSaddleMellinData ε ℓ) z"},{"kind":"theorem","name":"plusSaddleFinitePoleSubtraction_meromorphic","statement":"{ε : ℝ} (hε : 0 < ε) (horder : shortCutoff ε ≤ shortEndpoint ε) (ℓ : ℝ) (N : ℕ) : Meromorphic (plusSaddleFinitePoleSubtraction ε ℓ N)"},{"kind":"theorem","name":"minusSaddleFinitePoleSubtraction_meromorphic","statement":"{ε : ℝ} (hε : 0 < ε) (horder : shortCutoff ε ≤ shortEndpoint ε) (ℓ : ℝ) (N : ℕ) : Meromorphic (minusSaddleFinitePoleSubtraction ε ℓ N)"},{"kind":"theorem","name":"plusSaddleFinitePoleRegularPart_meromorphicNFOn","statement":"(ε ℓ : ℝ) (N : ℕ) : MeromorphicNFOn (plusSaddleFinitePoleRegularPart ε ℓ N) (saddleFinitePoleHalfPlane N)"},{"kind":"theorem","name":"minusSaddleFinitePoleRegularPart_meromorphicNFOn","statement":"(ε ℓ : ℝ) (N : ℕ) : MeromorphicNFOn (minusSaddleFinitePoleRegularPart ε ℓ N) (saddleFinitePoleHalfPlane N)"},{"kind":"theorem","name":"plusSaddleFinitePoleRegularPart_eq_on_punctured","statement":"{ε : ℝ} (hε : 0 < ε) (horder : shortCutoff ε ≤ shortEndpoint ε) (ℓ : ℝ) (N : ℕ) {z : ℂ} (hz : z ∈ saddleFinitePoleHalfPlane N) : plusSaddleFinitePoleRegularPart ε ℓ N =ᶠ[𝓝[≠] z] plusSaddleFinitePoleSubtraction ε ℓ N"},{"kind":"theorem","name":"minusSaddleFinitePoleRegularPart_eq_on_punctured","statement":"{ε : ℝ} (hε : 0 < ε) (horder : shortCutoff ε ≤ shortEndpoint ε) (ℓ : ℝ) (N : ℕ) {z : ℂ} (hz : z ∈ saddleFinitePoleHalfPlane N) : minusSaddleFinitePoleRegularPart ε ℓ N =ᶠ[𝓝[≠] z] minusSaddleFinitePoleSubtraction ε ℓ N"},{"kind":"theorem","name":"saddlePoleCoordinate_ne_zero_at_other","statement":"{m n : ℕ} (hmn : m ≠ n) : -((2 * n : ℕ) : ℂ) + ((2 * m : ℕ) : ℂ) ≠ 0"},{"kind":"theorem","name":"plusSaddleFinitePoleRemaining_differentiableAt_pole","statement":"(ε ℓ : ℝ) (N n : ℕ) : DifferentiableAt ℂ (plusSaddleFinitePoleRemaining ε ℓ N n) (-((2 * n : ℕ) : ℂ))"},{"kind":"theorem","name":"minusSaddleFinitePoleRemaining_differentiableAt_pole","statement":"(ε ℓ : ℝ) (N n : ℕ) : DifferentiableAt ℂ (minusSaddleFinitePoleRemaining ε ℓ N n) (-((2 * n : ℕ) : ℂ))"},{"kind":"theorem","name":"plusSaddleFinitePoleSubtraction_differentiableAt_of_not_pole","statement":"{ε : ℝ} (hε : 0 < ε) (horder : shortCutoff ε ≤ shortEndpoint ε) (ℓ : ℝ) (N : ℕ) {z : ℂ} (hz : ∀ n : ℕ, z ≠ (-((2 * n : ℕ) : ℂ))) : DifferentiableAt ℂ (plusSaddleFinitePoleSubtraction ε ℓ N) z"},{"kind":"theorem","name":"minusSaddleFinitePoleSubtraction_differentiableAt_of_not_pole","statement":"{ε : ℝ} (hε : 0 < ε) (horder : shortCutoff ε ≤ shortEndpoint ε) (ℓ : ℝ) (N : ℕ) {z : ℂ} (hz : ∀ n : ℕ, z ≠ (-((2 * n : ℕ) : ℂ))) : DifferentiableAt ℂ (minusSaddleFinitePoleSubtraction ε ℓ N) z"},{"kind":"theorem","name":"plusSaddleFinitePoleSubtraction_eventually_eq_poleRegular","statement":"(ε ℓ : ℝ) (N n : ℕ) (hn : n ≤ N) : plusSaddleFinitePoleSubtraction ε ℓ N =ᶠ[𝓝[≠] (-((2 * n : ℕ) : ℂ))] (fun z : ℂ => plusSaddleNthPoleRegularPart ε ℓ n z - plusSaddleFinitePoleRemaining ε ℓ N n z)"},{"kind":"theorem","name":"minusSaddleFinitePoleSubtraction_eventually_eq_poleRegular","statement":"(ε ℓ : ℝ) (N n : ℕ) (hn : n ≤ N) : minusSaddleFinitePoleSubtraction ε ℓ N =ᶠ[𝓝[≠] (-((2 * n : ℕ) : ℂ))] (fun z : ℂ => minusSaddleNthPoleRegularPart ε ℓ n z - minusSaddleFinitePoleRemaining ε ℓ N n z)"},{"kind":"theorem","name":"plusSaddleFinitePoleSubtraction_tendsto_at_pole","statement":"{ε : ℝ} (hε : 0 < ε) (horder : shortCutoff ε ≤ shortEndpoint ε) (ℓ : ℝ) (N n : ℕ) (hn : n ≤ N) : Tendsto (plusSaddleFinitePoleSubtraction ε ℓ N) (𝓝[≠] (-((2 * n : ℕ) : ℂ))) (𝓝 (plusSaddleNthPoleRegularPart ε ℓ n (-((2 * n : ℕ) : ℂ)) - plusSaddleFinitePoleRemaining ε ℓ N n (-((2 * n : ℕ) : ℂ))))"},{"kind":"theorem","name":"minusSaddleFinitePoleSubtraction_tendsto_at_pole","statement":"{ε : ℝ} (hε : 0 < ε) (horder : shortCutoff ε ≤ shortEndpoint ε) (ℓ : ℝ) (N n : ℕ) (hn : n ≤ N) : Tendsto (minusSaddleFinitePoleSubtraction ε ℓ N) (𝓝[≠] (-((2 * n : ℕ) : ℂ))) (𝓝 (minusSaddleNthPoleRegularPart ε ℓ n (-((2 * n : ℕ) : ℂ)) - minusSaddleFinitePoleRemaining ε ℓ N n (-((2 * n : ℕ) : ℂ))))"},{"kind":"theorem","name":"plusSaddleFinitePoleSubtraction_tendsto_of_mem","statement":"{ε : ℝ} (hε : 0 < ε) (horder : shortCutoff ε ≤ shortEndpoint ε) (ℓ : ℝ) (N : ℕ) {z : ℂ} (hz : z ∈ saddleFinitePoleHalfPlane N) : ∃ c : ℂ, Tendsto (plusSaddleFinitePoleSubtraction ε ℓ N) (𝓝[≠] z) (𝓝 c)"},{"kind":"theorem","name":"minusSaddleFinitePoleSubtraction_tendsto_of_mem","statement":"{ε : ℝ} (hε : 0 < ε) (horder : shortCutoff ε ≤ shortEndpoint ε) (ℓ : ℝ) (N : ℕ) {z : ℂ} (hz : z ∈ saddleFinitePoleHalfPlane N) : ∃ c : ℂ, Tendsto (minusSaddleFinitePoleSubtraction ε ℓ N) (𝓝[≠] z) (𝓝 c)"},{"kind":"theorem","name":"plusSaddleFinitePoleRegularPart_analyticOnNhd","statement":"{ε : ℝ} (hε : 0 < ε) (horder : shortCutoff ε ≤ shortEndpoint ε) (ℓ : ℝ) (N : ℕ) : AnalyticOnNhd ℂ (plusSaddleFinitePoleRegularPart ε ℓ N) (saddleFinitePoleHalfPlane N)"},{"kind":"theorem","name":"minusSaddleFinitePoleRegularPart_analyticOnNhd","statement":"{ε : ℝ} (hε : 0 < ε) (horder : shortCutoff ε ≤ shortEndpoint ε) (ℓ : ℝ) (N : ℕ) : AnalyticOnNhd ℂ (minusSaddleFinitePoleRegularPart ε ℓ N) (saddleFinitePoleHalfPlane N)"},{"kind":"theorem","name":"plusSaddleFinitePoleRegularPart_eq_subtraction_of_not_pole","statement":"{ε : ℝ} (hε : 0 < ε) (horder : shortCutoff ε ≤ shortEndpoint ε) (ℓ : ℝ) (N : ℕ) {z : ℂ} (hz : z ∈ saddleFinitePoleHalfPlane N) (hpole : ∀ n : ℕ, z ≠ (-((2 * n : ℕ) : ℂ))) : plusSaddleFinitePoleRegularPart ε ℓ N z = plusSaddleFinitePoleSubtraction ε ℓ N z"},{"kind":"theorem","name":"minusSaddleFinitePoleRegularPart_eq_subtraction_of_not_pole","statement":"{ε : ℝ} (hε : 0 < ε) (horder : shortCutoff ε ≤ shortEndpoint ε) (ℓ : ℝ) (N : ℕ) {z : ℂ} (hz : z ∈ saddleFinitePoleHalfPlane N) (hpole : ∀ n : ℕ, z ≠ (-((2 * n : ℕ) : ℂ))) : minusSaddleFinitePoleRegularPart ε ℓ N z = minusSaddleFinitePoleSubtraction ε ℓ N z"},{"kind":"theorem","name":"plusSaddleFinitePoleRegularPart_differentiableOn","statement":"{ε : ℝ} (hε : 0 < ε) (horder : shortCutoff ε ≤ shortEndpoint ε) (ℓ : ℝ) (N : ℕ) : DifferentiableOn ℂ (plusSaddleFinitePoleRegularPart ε ℓ N) (saddleFinitePoleHalfPlane N)"},{"kind":"theorem","name":"minusSaddleFinitePoleRegularPart_differentiableOn","statement":"{ε : ℝ} (hε : 0 < ε) (horder : shortCutoff ε ≤ shortEndpoint ε) (ℓ : ℝ) (N : ℕ) : DifferentiableOn ℂ (minusSaddleFinitePoleRegularPart ε ℓ N) (saddleFinitePoleHalfPlane N)"},{"kind":"theorem","name":"saddleFinitePoleHalfPlane_reProdIm_subset","statement":"{N : ℕ} {z w : ℂ} (hz : z ∈ saddleFinitePoleHalfPlane N) (hw : w ∈ saddleFinitePoleHalfPlane N) : ([[z.re, w.re]] ×ℂ [[z.im, w.im]]) ⊆ saddleFinitePoleHalfPlane N"},{"kind":"theorem","name":"saddleMellinInversePower_differentiable","statement":"{r : ℝ} (hr : 0 < r) : Differentiable ℂ (saddleMellinInversePower r)"},{"kind":"theorem","name":"saddleGaussianPoleSlope_differentiable","statement":"Differentiable ℂ saddleGaussianPoleSlope"},{"kind":"theorem","name":"saddleGaussianPoleSlope_mul","statement":"(z : ℂ) : z * saddleGaussianPoleSlope z = Complex.exp (z ^ 2) - 1"},{"kind":"theorem","name":"saddleGaussianPoleSlope_eq_of_ne","statement":"{z : ℂ} (hz : z ≠ 0) : saddleGaussianPoleSlope z = (Complex.exp (z ^ 2) - 1) / z"},{"kind":"theorem","name":"plusSaddleFiniteRapidPoleRegularPart_differentiableOn","statement":"{ε : ℝ} (hε : 0 < ε) (horder : shortCutoff ε ≤ shortEndpoint ε) (ℓ : ℝ) (N : ℕ) : DifferentiableOn ℂ (plusSaddleFiniteRapidPoleRegularPart ε ℓ N) (saddleFinitePoleHalfPlane N)"},{"kind":"theorem","name":"minusSaddleFiniteRapidPoleRegularPart_differentiableOn","statement":"{ε : ℝ} (hε : 0 < ε) (horder : shortCutoff ε ≤ shortEndpoint ε) (ℓ : ℝ) (N : ℕ) : DifferentiableOn ℂ (minusSaddleFiniteRapidPoleRegularPart ε ℓ N) (saddleFinitePoleHalfPlane N)"},{"kind":"theorem","name":"plusSaddleFiniteRapidPoleRegularPart_eq_subtraction_of_not_pole","statement":"{ε : ℝ} (hε : 0 < ε) (horder : shortCutoff ε ≤ shortEndpoint ε) (ℓ : ℝ) (N : ℕ) {z : ℂ} (hz : z ∈ saddleFinitePoleHalfPlane N) (hpole : ∀ n : ℕ, z ≠ (-((2 * n : ℕ) : ℂ))) : plusSaddleFiniteRapidPoleRegularPart ε ℓ N z = plusSaddleFiniteRapidPoleSubtraction ε ℓ N z"},{"kind":"theorem","name":"minusSaddleFiniteRapidPoleRegularPart_eq_subtraction_of_not_pole","statement":"{ε : ℝ} (hε : 0 < ε) (horder : shortCutoff ε ≤ shortEndpoint ε) (ℓ : ℝ) (N : ℕ) {z : ℂ} (hz : z ∈ saddleFinitePoleHalfPlane N) (hpole : ∀ n : ℕ, z ≠ (-((2 * n : ℕ) : ℂ))) : minusSaddleFiniteRapidPoleRegularPart ε ℓ N z = minusSaddleFiniteRapidPoleSubtraction ε ℓ N z"},{"kind":"theorem","name":"plusSaddleFiniteRapidContourIntegrand_differentiableOn","statement":"{ε : ℝ} (hε : 0 < ε) (horder : shortCutoff ε ≤ shortEndpoint ε) (ℓ : ℝ) (N : ℕ) {r : ℝ} (hr : 0 < r) : DifferentiableOn ℂ (plusSaddleFiniteRapidContourIntegrand ε ℓ N r) (saddleFinitePoleHalfPlane N)"},{"kind":"theorem","name":"minusSaddleFiniteRapidContourIntegrand_differentiableOn","statement":"{ε : ℝ} (hε : 0 < ε) (horder : shortCutoff ε ≤ shortEndpoint ε) (ℓ : ℝ) (N : ℕ) {r : ℝ} (hr : 0 < r) : DifferentiableOn ℂ (minusSaddleFiniteRapidContourIntegrand ε ℓ N r) (saddleFinitePoleHalfPlane N)"},{"kind":"theorem","name":"plusSaddleFiniteRapidContourIntegrand_boundary_rectangle","statement":"{ε : ℝ} (hε : 0 < ε) (horder : shortCutoff ε ≤ shortEndpoint ε) (ℓ : ℝ) (N : ℕ) {r : ℝ} (hr : 0 < r) (z w : ℂ) (hz : z ∈ saddleFinitePoleHalfPlane N) (hw : w ∈ saddleFinitePoleHalfPlane N) : (∫ x : ℝ in z.re..w.re, plusSaddleFiniteRapidContourIntegrand ε ℓ N r (x + z.im * Complex.I)) - (∫ x : ℝ in z.re..w.re, plusSaddleFiniteRapidContourIntegrand ε ℓ N r (x + w.im * Complex.I)) + Complex.I • (∫ y : ℝ in z.im..w.im, plusSaddleFiniteRapidContourIntegrand ε ℓ N r (w.re + y * Complex.I)) - Complex.I • (∫ y : ℝ in z.im..w.im, plusSaddleFiniteRapidContourIntegrand ε ℓ N r (z.re + y * Complex.I)) = 0"},{"kind":"theorem","name":"minusSaddleFiniteRapidContourIntegrand_boundary_rectangle","statement":"{ε : ℝ} (hε : 0 < ε) (horder : shortCutoff ε ≤ shortEndpoint ε) (ℓ : ℝ) (N : ℕ) {r : ℝ} (hr : 0 < r) (z w : ℂ) (hz : z ∈ saddleFinitePoleHalfPlane N) (hw : w ∈ saddleFinitePoleHalfPlane N) : (∫ x : ℝ in z.re..w.re, minusSaddleFiniteRapidContourIntegrand ε ℓ N r (x + z.im * Complex.I)) - (∫ x : ℝ in z.re..w.re, minusSaddleFiniteRapidContourIntegrand ε ℓ N r (x + w.im * Complex.I)) + Complex.I • (∫ y : ℝ in z.im..w.im, minusSaddleFiniteRapidContourIntegrand ε ℓ N r (w.re + y * Complex.I)) - Complex.I • (∫ y : ℝ in z.im..w.im, minusSaddleFiniteRapidContourIntegrand ε ℓ N r (z.re + y * Complex.I)) = 0"},{"kind":"theorem","name":"saddleMellinEnvelope_vertical","statement":"(ε ℓ t : ℝ) : saddleMellinEnvelope ε ℓ ((ℓ : ℂ) - Complex.I * (t : ℂ)) = saddleEnvelope ε ℓ t"},{"kind":"theorem","name":"plusSaddleMellinData_vertical","statement":"(ε ℓ t : ℝ) : plusSaddleMellinData ε ℓ ((ℓ : ℂ) - Complex.I * (t : ℂ)) = plusSaddleSpectrum ε ℓ t"},{"kind":"theorem","name":"minusSaddleMellinData_vertical","statement":"(ε ℓ t : ℝ) : minusSaddleMellinData ε ℓ ((ℓ : ℂ) - Complex.I * (t : ℂ)) = minusSaddleSpectrum ε ℓ t"},{"kind":"theorem","name":"plusSaddleFunction_radial","statement":"(ε : ℝ) (d : ℕ) (x y : Euclidean d) (hxy : ‖x‖ = ‖y‖) : plusSaddleFunction ε d x = plusSaddleFunction ε d y"},{"kind":"theorem","name":"minusSaddleFunction_radial","statement":"(ε : ℝ) (d : ℕ) (x y : Euclidean d) (hxy : ‖x‖ = ‖y‖) : minusSaddleFunction ε d x = minusSaddleFunction ε d y"},{"kind":"theorem","name":"saddleFunction_zero_pos","statement":"{ε : ℝ} (hε : 0 < ε) (d : ℕ) : 0 < (plusSaddleFunction ε d (0 : Euclidean d)).re ∧ 0 < (minusSaddleFunction ε d (0 : Euclidean d)).re"},{"kind":"theorem","name":"minusPolynomial_neg","statement":"(ε : ℝ) (z : ℂ) : minusPolynomial ε (-z) = plusPolynomial ε z"},{"kind":"theorem","name":"plusPolynomial_conj","statement":"(ε : ℝ) (z : ℂ) : starRingEnd ℂ (plusPolynomial ε z) = minusPolynomial ε (starRingEnd ℂ z)"},{"kind":"theorem","name":"minusPolynomial_conj","statement":"(ε : ℝ) (z : ℂ) : starRingEnd ℂ (minusPolynomial ε z) = plusPolynomial ε (starRingEnd ℂ z)"},{"kind":"theorem","name":"norm_plusPolynomial_le","statement":"(ε : ℝ) (z : ℂ) : ‖plusPolynomial ε z‖ ≤ (1 + |beta ε|) * (1 + ‖z‖) ^ 3"},{"kind":"theorem","name":"norm_minusPolynomial_le","statement":"(ε : ℝ) (z : ℂ) : ‖minusPolynomial ε z‖ ≤ (1 + |beta ε|) * (1 + ‖z‖) ^ 3"},{"kind":"theorem","name":"norm_complexGamma_le_realGamma","statement":"{z : ℂ} (hz : 0 < z.re) : ‖Complex.Gamma z‖ ≤ Real.Gamma z.re"},{"kind":"theorem","name":"complexGamma_vertical_polynomial_bound","statement":"{z : ℂ} (hz : 0 < z.re) (k : ℕ) : |z.im| ^ k * ‖Complex.Gamma z‖ ≤ Real.Gamma (z.re + k)"},{"kind":"theorem","name":"complexGamma_shifted_vertical_polynomial_bound","statement":"{z : ℂ} (hz : z.im ≠ 0) (k : ℕ) (hshift : 0 < z.re + k) : |z.im| ^ k * ‖Complex.Gamma z‖ ≤ Real.Gamma (z.re + k)"},{"kind":"theorem","name":"saddleGamma_shiftedLine_polynomial_bound","statement":"(a : ℝ) {t : ℝ} (ht : 1 ≤ |t|) (k m : ℕ) (hshift : 0 < a / 2 + (k : ℝ)) : |t| ^ m * ‖Complex.Gamma (((a : ℂ) + (t : ℂ) * Complex.I) / 2)‖ ≤ (2 : ℝ) ^ (k + m) * Real.Gamma (a / 2 + ((k + m : ℕ) : ℝ))"},{"kind":"theorem","name":"norm_complexCos_le_cosh_im","statement":"(z : ℂ) : ‖Complex.cos z‖ ≤ Real.cosh z.im"},{"kind":"theorem","name":"saddleHorizontalShellVariation_mono","statement":"{ε : ℝ} (hε : 0 < ε) (horder : shortCutoff ε ≤ shortEndpoint ε) {H K : ℝ} (hH : 0 ≤ H) (hHK : H ≤ K) : saddleHorizontalShellVariation ε H ≤ saddleHorizontalShellVariation ε K"},{"kind":"theorem","name":"norm_mellinShellPhase_le_horizontalVariation","statement":"{ε : ℝ} (hε : 0 < ε) (horder : shortCutoff ε ≤ shortEndpoint ε) {z : ℂ} {H : ℝ} (hstrip : |z.im| ≤ H) : ‖mellinShellPhase ε z‖ ≤ saddleHorizontalShellVariation ε H"},{"kind":"theorem","name":"norm_saddleShellExponential_horizontal_le","statement":"{ε : ℝ} (hε : 0 < ε) (horder : shortCutoff ε ≤ shortEndpoint ε) (ℓ : ℝ) (z : ℂ) : ‖Complex.exp ((ℓ : ℂ) * mellinShellPhase ε z)‖ ≤ Real.exp (|ℓ| * saddleHorizontalShellVariation ε |z.im|)"},{"kind":"theorem","name":"saddleMellinShellArgument_shiftedLine","statement":"{ℓ : ℝ} (hℓ : 0 < ℓ) (a t : ℝ) : Complex.I * (((a : ℂ) + (t : ℂ) * Complex.I) - (ℓ : ℂ)) / (ℓ : ℂ) = ((-t / ℓ : ℝ) : ℂ) + Complex.I * (((a - ℓ) / ℓ : ℝ) : ℂ)"},{"kind":"theorem","name":"saddleMellinPiFactor_shiftedLine_norm","statement":"(ℓ a t : ℝ) : ‖Complex.exp (((ℓ : ℂ) - ((a : ℂ) + (t : ℂ) * Complex.I)) * (Real.log Real.pi : ℂ) / 2)‖ = Real.exp ((ℓ - a) * Real.log Real.pi / 2)"},{"kind":"theorem","name":"norm_saddleShellExponential_shiftedLine_le","statement":"{ε ℓ : ℝ} (hε : 0 < ε) (hℓ : 0 < ℓ) (horder : shortCutoff ε ≤ shortEndpoint ε) (a t : ℝ) : ‖Complex.exp ((ℓ : ℂ) * mellinShellPhase ε (Complex.I * (((a : ℂ) + (t : ℂ) * Complex.I) - (ℓ : ℂ)) / (ℓ : ℂ)))‖ ≤ Real.exp (ℓ * saddleHorizontalShellVariation ε |(a - ℓ) / ℓ|)"},{"kind":"theorem","name":"saddleMellinShellArgument_shiftedLine_norm_le","statement":"{ℓ : ℝ} (hℓ : 0 < ℓ) (a t : ℝ) : ‖Complex.I * (((a : ℂ) + (t : ℂ) * Complex.I) - (ℓ : ℂ)) / (ℓ : ℂ)‖ ≤ |t| / ℓ + |(a - ℓ) / ℓ|"},{"kind":"theorem","name":"saddleMellinShellArgument_shiftedLine_linear_le","statement":"{ℓ : ℝ} (hℓ : 0 < ℓ) (a : ℝ) {t : ℝ} (ht : 1 ≤ |t|) : 1 + ‖Complex.I * (((a : ℂ) + (t : ℂ) * Complex.I) - (ℓ : ℂ)) / (ℓ : ℂ)‖ ≤ (1 + ℓ⁻¹ + |(a - ℓ) / ℓ|) * |t|"},{"kind":"theorem","name":"norm_plusPolynomial_shiftedLine_le","statement":"{ε ℓ : ℝ} (hℓ : 0 < ℓ) (a : ℝ) {t : ℝ} (ht : 1 ≤ |t|) : ‖plusPolynomial ε (Complex.I * (((a : ℂ) + (t : ℂ) * Complex.I) - (ℓ : ℂ)) / (ℓ : ℂ))‖ ≤ (1 + |beta ε|) * (1 + ℓ⁻¹ + |(a - ℓ) / ℓ|) ^ 3 * |t| ^ 3"},{"kind":"theorem","name":"norm_minusPolynomial_shiftedLine_le","statement":"{ε ℓ : ℝ} (hℓ : 0 < ℓ) (a : ℝ) {t : ℝ} (ht : 1 ≤ |t|) : ‖minusPolynomial ε (Complex.I * (((a : ℂ) + (t : ℂ) * Complex.I) - (ℓ : ℂ)) / (ℓ : ℂ))‖ ≤ (1 + |beta ε|) * (1 + ℓ⁻¹ + |(a - ℓ) / ℓ|) ^ 3 * |t| ^ 3"},{"kind":"theorem","name":"saddleShiftedLineMajorant_nonneg","statement":"{ε ℓ a : ℝ} (hℓ : 0 < ℓ) (k m : ℕ) (hshift : 0 < a / 2 + (k : ℝ)) : 0 ≤ saddleShiftedLineMajorant ε ℓ a k m"},{"kind":"theorem","name":"plusSaddleMellinData_shiftedLine_polynomial_bound","statement":"{ε ℓ : ℝ} (hε : 0 < ε) (hℓ : 0 < ℓ) (horder : shortCutoff ε ≤ shortEndpoint ε) (a : ℝ) {t : ℝ} (ht : 1 ≤ |t|) (k m : ℕ) (hshift : 0 < a / 2 + (k : ℝ)) : |t| ^ m * ‖plusSaddleMellinData ε ℓ ((a : ℂ) + (t : ℂ) * Complex.I)‖ ≤ saddleShiftedLineMajorant ε ℓ a k m"},{"kind":"theorem","name":"minusSaddleMellinData_shiftedLine_polynomial_bound","statement":"{ε ℓ : ℝ} (hε : 0 < ε) (hℓ : 0 < ℓ) (horder : shortCutoff ε ≤ shortEndpoint ε) (a : ℝ) {t : ℝ} (ht : 1 ≤ |t|) (k m : ℕ) (hshift : 0 < a / 2 + (k : ℝ)) : |t| ^ m * ‖minusSaddleMellinData ε ℓ ((a : ℂ) + (t : ℂ) * Complex.I)‖ ≤ saddleShiftedLineMajorant ε ℓ a k m"},{"kind":"theorem","name":"saddleHorizontalStripHeight_bound","statement":"{ℓ A B x : ℝ} (hℓ : 0 < ℓ) (hx : x ∈ Set.Icc A B) : |(x - ℓ) / ℓ| ≤ saddleHorizontalStripHeight ℓ A B"},{"kind":"theorem","name":"saddleShiftedLineMajorant_le_fixedStrip","statement":"{ε ℓ a H : ℝ} (hε : 0 < ε) (hℓ : 0 < ℓ) (horder : shortCutoff ε ≤ shortEndpoint ε) (hH : |(a - ℓ) / ℓ| ≤ H) (k m : ℕ) (hshift : 0 < a / 2 + (k : ℝ)) : saddleShiftedLineMajorant ε ℓ a k m ≤ saddleFixedStripMajorant ε ℓ H a k m"},{"kind":"theorem","name":"saddleShiftedGamma_continuousOn","statement":"{A B : ℝ} (k m : ℕ) (hshift : 0 < A / 2 + (k : ℝ)) : ContinuousOn (fun a : ℝ => Real.Gamma (a / 2 + ((k + (m + 3) : ℕ) : ℝ))) (Set.Icc A B)"},{"kind":"theorem","name":"saddleFixedStripMajorant_continuousOn","statement":"{A B : ℝ} (ε ℓ H : ℝ) (k m : ℕ) (hshift : 0 < A / 2 + (k : ℝ)) : ContinuousOn (fun a : ℝ => saddleFixedStripMajorant ε ℓ H a k m) (Set.Icc A B)"},{"kind":"theorem","name":"plusSaddleMellinData_horizontalStrip_polynomial_bound","statement":"{ε ℓ : ℝ} (hε : 0 < ε) (hℓ : 0 < ℓ) (horder : shortCutoff ε ≤ shortEndpoint ε) {A B : ℝ} (hAB : A ≤ B) (m : ℕ) : ∃ C : ℝ, 0 ≤ C ∧ ∀ a ∈ Set.Icc A B, ∀ t : ℝ, 1 ≤ |t| → |t| ^ m * ‖plusSaddleMellinData ε ℓ ((a : ℂ) + (t : ℂ) * Complex.I)‖ ≤ C"},{"kind":"theorem","name":"minusSaddleMellinData_horizontalStrip_polynomial_bound","statement":"{ε ℓ : ℝ} (hε : 0 < ε) (hℓ : 0 < ℓ) (horder : shortCutoff ε ≤ shortEndpoint ε) {A B : ℝ} (hAB : A ≤ B) (m : ℕ) : ∃ C : ℝ, 0 ≤ C ∧ ∀ a ∈ Set.Icc A B, ∀ t : ℝ, 1 ≤ |t| → |t| ^ m * ‖minusSaddleMellinData ε ℓ ((a : ℂ) + (t : ℂ) * Complex.I)‖ ≤ C"},{"kind":"theorem","name":"saddleEnvelope_conj","statement":"(ε ℓ t : ℝ) : starRingEnd ℂ (saddleEnvelope ε ℓ t) = saddleEnvelope ε ℓ (-t)"},{"kind":"theorem","name":"norm_saddleShellExponential_le","statement":"{ε ℓ : ℝ} (hε : 0 < ε) (horder : shortCutoff ε ≤ shortEndpoint ε) (t : ℝ) : ‖Complex.exp ((ℓ : ℂ) * mellinShellPhase ε ((t : ℂ) / (ℓ : ℂ)))‖ ≤ Real.exp (2 * |ℓ| * saddleShellTotalVariation ε)"},{"kind":"theorem","name":"saddleEnvelope_vertical_polynomial_bound","statement":"{ε ℓ : ℝ} (hε : 0 < ε) (hℓ : 0 < ℓ) (horder : shortCutoff ε ≤ shortEndpoint ε) (t : ℝ) (k : ℕ) : |t| ^ k * ‖saddleEnvelope ε ℓ t‖ ≤ (2 : ℝ) ^ k * Real.Gamma (ℓ / 2 + k) * Real.exp (2 * |ℓ| * saddleShellTotalVariation ε)"},{"kind":"theorem","name":"norm_plusPolynomial_scaled_le","statement":"{ε ℓ t : ℝ} (hℓ : 0 < ℓ) (ht : 1 ≤ |t|) : ‖plusPolynomial ε ((t : ℂ) / (ℓ : ℂ))‖ ≤ (1 + |beta ε|) * (1 + ℓ⁻¹) ^ 3 * |t| ^ 3"},{"kind":"theorem","name":"norm_minusPolynomial_scaled_le","statement":"{ε ℓ t : ℝ} (hℓ : 0 < ℓ) (ht : 1 ≤ |t|) : ‖minusPolynomial ε ((t : ℂ) / (ℓ : ℂ))‖ ≤ (1 + |beta ε|) * (1 + ℓ⁻¹) ^ 3 * |t| ^ 3"},{"kind":"theorem","name":"plusSaddleSpectrum_vertical_polynomial_bound","statement":"{ε ℓ : ℝ} (hε : 0 < ε) (hℓ : 0 < ℓ) (horder : shortCutoff ε ≤ shortEndpoint ε) {t : ℝ} (ht : 1 ≤ |t|) (k : ℕ) : |t| ^ k * ‖plusSaddleSpectrum ε ℓ t‖ ≤ ((1 + |beta ε|) * (1 + ℓ⁻¹) ^ 3) * ((2 : ℝ) ^ (k + 3) * Real.Gamma (ℓ / 2 + (k + 3)) * Real.exp (2 * |ℓ| * saddleShellTotalVariation ε))"},{"kind":"theorem","name":"minusSaddleSpectrum_vertical_polynomial_bound","statement":"{ε ℓ : ℝ} (hε : 0 < ε) (hℓ : 0 < ℓ) (horder : shortCutoff ε ≤ shortEndpoint ε) {t : ℝ} (ht : 1 ≤ |t|) (k : ℕ) : |t| ^ k * ‖minusSaddleSpectrum ε ℓ t‖ ≤ ((1 + |beta ε|) * (1 + ℓ⁻¹) ^ 3) * ((2 : ℝ) ^ (k + 3) * Real.Gamma (ℓ / 2 + (k + 3)) * Real.exp (2 * |ℓ| * saddleShellTotalVariation ε))"},{"kind":"theorem","name":"integrable_of_continuous_polynomial_decay","statement":"{F : ℝ → ℂ} (hF : Continuous F) (hdecay : ∀ j : ℕ, ∃ C : ℝ, 0 ≤ C ∧ ∀ t : ℝ, 1 ≤ |t| → |t| ^ j * ‖F t‖ ≤ C) (k : ℕ) : Integrable (fun t : ℝ => (t : ℂ) ^ k * F t)"},{"kind":"theorem","name":"saddleShiftedLine_ne_pole","statement":"{a : ℝ} (hpole : ∀ n : ℕ, a ≠ -((2 * n : ℕ) : ℝ)) (t : ℝ) (n : ℕ) : (a : ℂ) + (t : ℂ) * Complex.I ≠ (-((2 * n : ℕ) : ℂ))"},{"kind":"theorem","name":"plusSaddleMellinData_shiftedLine_continuous","statement":"{ε a : ℝ} (hε : 0 < ε) (horder : shortCutoff ε ≤ shortEndpoint ε) (ℓ : ℝ) (hpole : ∀ n : ℕ, a ≠ -((2 * n : ℕ) : ℝ)) : Continuous (fun t : ℝ => plusSaddleMellinData ε ℓ ((a : ℂ) + (t : ℂ) * Complex.I))"},{"kind":"theorem","name":"minusSaddleMellinData_shiftedLine_continuous","statement":"{ε a : ℝ} (hε : 0 < ε) (horder : shortCutoff ε ≤ shortEndpoint ε) (ℓ : ℝ) (hpole : ∀ n : ℕ, a ≠ -((2 * n : ℕ) : ℝ)) : Continuous (fun t : ℝ => minusSaddleMellinData ε ℓ ((a : ℂ) + (t : ℂ) * Complex.I))"},{"kind":"theorem","name":"plusSaddleMellinData_shiftedLine_moment_integrable","statement":"{ε ℓ a : ℝ} (hε : 0 < ε) (hℓ : 0 < ℓ) (horder : shortCutoff ε ≤ shortEndpoint ε) (hpole : ∀ n : ℕ, a ≠ -((2 * n : ℕ) : ℝ)) (j : ℕ) : Integrable (fun t : ℝ => (t : ℂ) ^ j * plusSaddleMellinData ε ℓ ((a : ℂ) + (t : ℂ) * Complex.I))"},{"kind":"theorem","name":"minusSaddleMellinData_shiftedLine_moment_integrable","statement":"{ε ℓ a : ℝ} (hε : 0 < ε) (hℓ : 0 < ℓ) (horder : shortCutoff ε ≤ shortEndpoint ε) (hpole : ∀ n : ℕ, a ≠ -((2 * n : ℕ) : ℝ)) (j : ℕ) : Integrable (fun t : ℝ => (t : ℂ) ^ j * minusSaddleMellinData ε ℓ ((a : ℂ) + (t : ℂ) * Complex.I))"},{"kind":"theorem","name":"saddleMellinInversePower_shiftedLine_norm","statement":"{r : ℝ} (hr : 0 < r) (a t : ℝ) : ‖saddleMellinInversePower r ((a : ℂ) + (t : ℂ) * Complex.I)‖ = r ^ (-a)"},{"kind":"theorem","name":"saddleMellinInversePower_shiftedLine_continuous","statement":"{r : ℝ} (hr : 0 < r) (a : ℝ) : Continuous (fun t : ℝ => saddleMellinInversePower r ((a : ℂ) + (t : ℂ) * Complex.I))"},{"kind":"theorem","name":"plusSaddleMellinData_shiftedLine_weighted_moment_integrable","statement":"{ε ℓ a r : ℝ} (hε : 0 < ε) (hℓ : 0 < ℓ) (horder : shortCutoff ε ≤ shortEndpoint ε) (hpole : ∀ n : ℕ, a ≠ -((2 * n : ℕ) : ℝ)) (hr : 0 < r) (j : ℕ) : Integrable (fun t : ℝ => saddleMellinInversePower r ((a : ℂ) + (t : ℂ) * Complex.I) * ((t : ℂ) ^ j * plusSaddleMellinData ε ℓ ((a : ℂ) + (t : ℂ) * Complex.I)))"},{"kind":"theorem","name":"minusSaddleMellinData_shiftedLine_weighted_moment_integrable","statement":"{ε ℓ a r : ℝ} (hε : 0 < ε) (hℓ : 0 < ℓ) (horder : shortCutoff ε ≤ shortEndpoint ε) (hpole : ∀ n : ℕ, a ≠ -((2 * n : ℕ) : ℝ)) (hr : 0 < r) (j : ℕ) : Integrable (fun t : ℝ => saddleMellinInversePower r ((a : ℂ) + (t : ℂ) * Complex.I) * ((t : ℂ) ^ j * minusSaddleMellinData ε ℓ ((a : ℂ) + (t : ℂ) * Complex.I)))"},{"kind":"theorem","name":"plusSaddleMellinData_shiftedLine_weighted_integrable","statement":"{ε ℓ a r : ℝ} (hε : 0 < ε) (hℓ : 0 < ℓ) (horder : shortCutoff ε ≤ shortEndpoint ε) (hpole : ∀ n : ℕ, a ≠ -((2 * n : ℕ) : ℝ)) (hr : 0 < r) : Integrable (fun t : ℝ => saddleMellinInversePower r ((a : ℂ) + (t : ℂ) * Complex.I) * plusSaddleMellinData ε ℓ ((a : ℂ) + (t : ℂ) * Complex.I))"},{"kind":"theorem","name":"minusSaddleMellinData_shiftedLine_weighted_integrable","statement":"{ε ℓ a r : ℝ} (hε : 0 < ε) (hℓ : 0 < ℓ) (horder : shortCutoff ε ≤ shortEndpoint ε) (hpole : ∀ n : ℕ, a ≠ -((2 * n : ℕ) : ℝ)) (hr : 0 < r) : Integrable (fun t : ℝ => saddleMellinInversePower r ((a : ℂ) + (t : ℂ) * Complex.I) * minusSaddleMellinData ε ℓ ((a : ℂ) + (t : ℂ) * Complex.I))"},{"kind":"theorem","name":"saddleGaussianPoleRepresentative_shiftedLine_norm","statement":"(a t : ℝ) (n : ℕ) : ‖saddleGaussianPoleRepresentative n ((a : ℂ) + (t : ℂ) * Complex.I)‖ = Real.exp ((a + ((2 * n : ℕ) : ℝ)) ^ 2 - t ^ 2) / ‖(a : ℂ) + (t : ℂ) * Complex.I + ((2 * n : ℕ) : ℂ)‖"},{"kind":"theorem","name":"saddleGaussianPoleRepresentative_shiftedLine_continuous","statement":"{a : ℝ} (n : ℕ) (ha : a ≠ -((2 * n : ℕ) : ℝ)) : Continuous (fun t : ℝ => saddleGaussianPoleRepresentative n ((a : ℂ) + (t : ℂ) * Complex.I))"},{"kind":"theorem","name":"saddleGaussianPoleRepresentative_shiftedLine_bound","statement":"{a : ℝ} (n : ℕ) (ha : a ≠ -((2 * n : ℕ) : ℝ)) (t : ℝ) : ‖saddleGaussianPoleRepresentative n ((a : ℂ) + (t : ℂ) * Complex.I)‖ ≤ (Real.exp ((a + ((2 * n : ℕ) : ℝ)) ^ 2) / |a + ((2 * n : ℕ) : ℝ)|) * Real.exp (-t ^ 2)"},{"kind":"theorem","name":"saddleGaussianPoleRepresentative_shiftedLine_integrable","statement":"{a : ℝ} (n : ℕ) (ha : a ≠ -((2 * n : ℕ) : ℝ)) : Integrable (fun t : ℝ => saddleGaussianPoleRepresentative n ((a : ℂ) + (t : ℂ) * Complex.I))"},{"kind":"theorem","name":"saddleGaussianPoleRepresentative_shiftedLine_weighted_integrable","statement":"{a r : ℝ} (n : ℕ) (ha : a ≠ -((2 * n : ℕ) : ℝ)) (hr : 0 < r) : Integrable (fun t : ℝ => saddleMellinInversePower r ((a : ℂ) + (t : ℂ) * Complex.I) * saddleGaussianPoleRepresentative n ((a : ℂ) + (t : ℂ) * Complex.I))"},{"kind":"theorem","name":"plusSaddleFiniteRapidContourIntegrand_shiftedLine_integrable","statement":"{ε ℓ a r : ℝ} (hε : 0 < ε) (hℓ : 0 < ℓ) (horder : shortCutoff ε ≤ shortEndpoint ε) (N : ℕ) (hhalf : -(2 * ((N : ℝ) + 1)) < a) (hpole : ∀ n : ℕ, a ≠ -((2 * n : ℕ) : ℝ)) (hr : 0 < r) : Integrable (fun t : ℝ => plusSaddleFiniteRapidContourIntegrand ε ℓ N r ((a : ℂ) + (t : ℂ) * Complex.I))"},{"kind":"theorem","name":"minusSaddleFiniteRapidContourIntegrand_shiftedLine_integrable","statement":"{ε ℓ a r : ℝ} (hε : 0 < ε) (hℓ : 0 < ℓ) (horder : shortCutoff ε ≤ shortEndpoint ε) (N : ℕ) (hhalf : -(2 * ((N : ℝ) + 1)) < a) (hpole : ∀ n : ℕ, a ≠ -((2 * n : ℕ) : ℝ)) (hr : 0 < r) : Integrable (fun t : ℝ => minusSaddleFiniteRapidContourIntegrand ε ℓ N r ((a : ℂ) + (t : ℂ) * Complex.I))"},{"kind":"theorem","name":"saddleMellinInversePower_horizontalStrip_bounded","statement":"{r A B : ℝ} (hr : 0 < r) (hAB : A ≤ B) : ∃ C : ℝ, 0 ≤ C ∧ ∀ a ∈ Set.Icc A B, ∀ t : ℝ, ‖saddleMellinInversePower r ((a : ℂ) + (t : ℂ) * Complex.I)‖ ≤ C"},{"kind":"theorem","name":"plusSaddleMellinData_weighted_horizontalStrip_polynomial_bound","statement":"{ε ℓ r : ℝ} (hε : 0 < ε) (hℓ : 0 < ℓ) (horder : shortCutoff ε ≤ shortEndpoint ε) (hr : 0 < r) {A B : ℝ} (hAB : A ≤ B) (m : ℕ) : ∃ C : ℝ, 0 ≤ C ∧ ∀ a ∈ Set.Icc A B, ∀ t : ℝ, 1 ≤ |t| → |t| ^ m * ‖saddleMellinInversePower r ((a : ℂ) + (t : ℂ) * Complex.I) * plusSaddleMellinData ε ℓ ((a : ℂ) + (t : ℂ) * Complex.I)‖ ≤ C"},{"kind":"theorem","name":"minusSaddleMellinData_weighted_horizontalStrip_polynomial_bound","statement":"{ε ℓ r : ℝ} (hε : 0 < ε) (hℓ : 0 < ℓ) (horder : shortCutoff ε ≤ shortEndpoint ε) (hr : 0 < r) {A B : ℝ} (hAB : A ≤ B) (m : ℕ) : ∃ C : ℝ, 0 ≤ C ∧ ∀ a ∈ Set.Icc A B, ∀ t : ℝ, 1 ≤ |t| → |t| ^ m * ‖saddleMellinInversePower r ((a : ℂ) + (t : ℂ) * Complex.I) * minusSaddleMellinData ε ℓ ((a : ℂ) + (t : ℂ) * Complex.I)‖ ≤ C"},{"kind":"theorem","name":"saddleHorizontalIntegral_tendsto_zero","statement":"{F : ℂ → ℂ} {A B C : ℝ} (hAB : A ≤ B) (hdecay : ∀ a ∈ Set.Icc A B, ∀ t : ℝ, 1 ≤ |t| → |t| * ‖F ((a : ℂ) + (t : ℂ) * Complex.I)‖ ≤ C) (s : ℝ) (hs : |s| = 1) : Tendsto (fun T : ℝ => ∫ a in A..B, F ((a : ℂ) + ((s * T : ℝ) : ℂ) * Complex.I)) Filter.atTop (𝓝 0)"},{"kind":"theorem","name":"plusSaddleMellinData_weighted_horizontalIntegral_tendsto_zero","statement":"{ε ℓ r : ℝ} (hε : 0 < ε) (hℓ : 0 < ℓ) (horder : shortCutoff ε ≤ shortEndpoint ε) (hr : 0 < r) {A B : ℝ} (hAB : A ≤ B) (s : ℝ) (hs : |s| = 1) : Tendsto (fun T : ℝ => ∫ a in A..B, saddleMellinInversePower r ((a : ℂ) + ((s * T : ℝ) : ℂ) * Complex.I) * plusSaddleMellinData ε ℓ ((a : ℂ) + ((s * T : ℝ) : ℂ) * Complex.I)) Filter.atTop (𝓝 0)"},{"kind":"theorem","name":"minusSaddleMellinData_weighted_horizontalIntegral_tendsto_zero","statement":"{ε ℓ r : ℝ} (hε : 0 < ε) (hℓ : 0 < ℓ) (horder : shortCutoff ε ≤ shortEndpoint ε) (hr : 0 < r) {A B : ℝ} (hAB : A ≤ B) (s : ℝ) (hs : |s| = 1) : Tendsto (fun T : ℝ => ∫ a in A..B, saddleMellinInversePower r ((a : ℂ) + ((s * T : ℝ) : ℂ) * Complex.I) * minusSaddleMellinData ε ℓ ((a : ℂ) + ((s * T : ℝ) : ℂ) * Complex.I)) Filter.atTop (𝓝 0)"},{"kind":"theorem","name":"saddleGaussianPoleRepresentative_weighted_horizontalStrip_bound","statement":"{r A B : ℝ} (hr : 0 < r) (hAB : A ≤ B) (n : ℕ) : ∃ C : ℝ, 0 ≤ C ∧ ∀ a ∈ Set.Icc A B, ∀ t : ℝ, 1 ≤ |t| → |t| * ‖saddleMellinInversePower r ((a : ℂ) + (t : ℂ) * Complex.I) * saddleGaussianPoleRepresentative n ((a : ℂ) + (t : ℂ) * Complex.I)‖ ≤ C"},{"kind":"theorem","name":"saddleFiniteGaussianPoleWeighted_horizontalStrip_bound","statement":"{r A B : ℝ} (hr : 0 < r) (hAB : A ≤ B) (c : ℕ → ℂ) (N : ℕ) : ∃ C : ℝ, 0 ≤ C ∧ ∀ a ∈ Set.Icc A B, ∀ t : ℝ, 1 ≤ |t| → |t| * ‖saddleMellinInversePower r ((a : ℂ) + (t : ℂ) * Complex.I) * (∑ n ∈ Finset.range (N + 1), c n * saddleGaussianPoleRepresentative n ((a : ℂ) + (t : ℂ) * Complex.I))‖ ≤ C"},{"kind":"theorem","name":"saddleNonzeroFrequency_ne_pole","statement":"(a : ℝ) {t : ℝ} (ht : t ≠ 0) (n : ℕ) : (a : ℂ) + (t : ℂ) * Complex.I ≠ (-((2 * n : ℕ) : ℂ))"},{"kind":"theorem","name":"plusSaddleFiniteRapidContourIntegrand_horizontalStrip_bound","statement":"{ε ℓ r A B : ℝ} (hε : 0 < ε) (hℓ : 0 < ℓ) (horder : shortCutoff ε ≤ shortEndpoint ε) (hr : 0 < r) (N : ℕ) (hhalf : -(2 * ((N : ℝ) + 1)) < A) (hAB : A ≤ B) : ∃ C : ℝ, 0 ≤ C ∧ ∀ a ∈ Set.Icc A B, ∀ t : ℝ, 1 ≤ |t| → |t| * ‖plusSaddleFiniteRapidContourIntegrand ε ℓ N r ((a : ℂ) + (t : ℂ) * Complex.I)‖ ≤ C"},{"kind":"theorem","name":"minusSaddleFiniteRapidContourIntegrand_horizontalStrip_bound","statement":"{ε ℓ r A B : ℝ} (hε : 0 < ε) (hℓ : 0 < ℓ) (horder : shortCutoff ε ≤ shortEndpoint ε) (hr : 0 < r) (N : ℕ) (hhalf : -(2 * ((N : ℝ) + 1)) < A) (hAB : A ≤ B) : ∃ C : ℝ, 0 ≤ C ∧ ∀ a ∈ Set.Icc A B, ∀ t : ℝ, 1 ≤ |t| → |t| * ‖minusSaddleFiniteRapidContourIntegrand ε ℓ N r ((a : ℂ) + (t : ℂ) * Complex.I)‖ ≤ C"},{"kind":"theorem","name":"plusSaddleFiniteRapidContourIntegrand_horizontalIntegral_tendsto_zero","statement":"{ε ℓ r A B : ℝ} (hε : 0 < ε) (hℓ : 0 < ℓ) (horder : shortCutoff ε ≤ shortEndpoint ε) (hr : 0 < r) (N : ℕ) (hhalf : -(2 * ((N : ℝ) + 1)) < A) (hAB : A ≤ B) (s : ℝ) (hs : |s| = 1) : Tendsto (fun T : ℝ => ∫ a in A..B, plusSaddleFiniteRapidContourIntegrand ε ℓ N r ((a : ℂ) + ((s * T : ℝ) : ℂ) * Complex.I)) Filter.atTop (𝓝 0)"},{"kind":"theorem","name":"minusSaddleFiniteRapidContourIntegrand_horizontalIntegral_tendsto_zero","statement":"{ε ℓ r A B : ℝ} (hε : 0 < ε) (hℓ : 0 < ℓ) (horder : shortCutoff ε ≤ shortEndpoint ε) (hr : 0 < r) (N : ℕ) (hhalf : -(2 * ((N : ℝ) + 1)) < A) (hAB : A ≤ B) (s : ℝ) (hs : |s| = 1) : Tendsto (fun T : ℝ => ∫ a in A..B, minusSaddleFiniteRapidContourIntegrand ε ℓ N r ((a : ℂ) + ((s * T : ℝ) : ℂ) * Complex.I)) Filter.atTop (𝓝 0)"},{"kind":"theorem","name":"saddleCauchyPolePrimitive_hasDerivAt","statement":"{a : ℝ} (ha : a ≠ 0) (t : ℝ) : HasDerivAt (saddleCauchyPolePrimitive a) (((a : ℂ) + (t : ℂ) * Complex.I)⁻¹) t"},{"kind":"theorem","name":"saddleCauchyPole_symmetric_intervalIntegral","statement":"{a : ℝ} (ha : a ≠ 0) (T : ℝ) : (∫ t in -T..T, ((a : ℂ) + (t : ℂ) * Complex.I)⁻¹) = ((2 * Real.arctan (T / a) : ℝ) : ℂ)"},{"kind":"theorem","name":"saddleInfiniteRectangle_vertical_integral_eq","statement":"{F : ℂ → ℂ} {A B : ℝ} (hA : Integrable (fun t : ℝ => F ((A : ℂ) + (t : ℂ) * Complex.I))) (hB : Integrable (fun t : ℝ => F ((B : ℂ) + (t : ℂ) * Complex.I))) (hlower : Tendsto (fun T : ℝ => ∫ a in A..B, F ((a : ℂ) + ((-T : ℝ) : ℂ) * Complex.I)) Filter.atTop (𝓝 0)) (hupper : Tendsto (fun T : ℝ => ∫ a in A..B, F ((a : ℂ) + (T : ℂ) * Complex.I)) Filter.atTop (𝓝 0)) (hrectangle : ∀ T : ℝ, (∫ a in A..B, F ((a : ℂ) + ((-T : ℝ) : ℂ) * Complex.I)) - (∫ a in A..B, F ((a : ℂ) + (T : ℂ) * Complex.I)) + Complex.I * (∫ t in -T..T, F ((B : ℂ) + (t : ℂ) * Complex.I)) - Complex.I * (∫ t in -T..T, F ((A : ℂ) + (t : ℂ) * Complex.I)) = 0) : (∫ t : ℝ, F ((B : ℂ) + (t : ℂ) * Complex.I)) = (∫ t : ℝ, F ((A : ℂ) + (t : ℂ) * Complex.I))"},{"kind":"theorem","name":"plusSaddleFiniteRapidContourIntegrand_vertical_integral_eq","statement":"{ε ℓ r A B : ℝ} (hε : 0 < ε) (hℓ : 0 < ℓ) (horder : shortCutoff ε ≤ shortEndpoint ε) (hr : 0 < r) (N : ℕ) (hhalf : -(2 * ((N : ℝ) + 1)) < A) (hAB : A ≤ B) (hApole : ∀ n : ℕ, A ≠ -((2 * n : ℕ) : ℝ)) (hBpole : ∀ n : ℕ, B ≠ -((2 * n : ℕ) : ℝ)) : (∫ t : ℝ, plusSaddleFiniteRapidContourIntegrand ε ℓ N r ((B : ℂ) + (t : ℂ) * Complex.I)) = (∫ t : ℝ, plusSaddleFiniteRapidContourIntegrand ε ℓ N r ((A : ℂ) + (t : ℂ) * Complex.I))"},{"kind":"theorem","name":"minusSaddleFiniteRapidContourIntegrand_vertical_integral_eq","statement":"{ε ℓ r A B : ℝ} (hε : 0 < ε) (hℓ : 0 < ℓ) (horder : shortCutoff ε ≤ shortEndpoint ε) (hr : 0 < r) (N : ℕ) (hhalf : -(2 * ((N : ℝ) + 1)) < A) (hAB : A ≤ B) (hApole : ∀ n : ℕ, A ≠ -((2 * n : ℕ) : ℝ)) (hBpole : ∀ n : ℕ, B ≠ -((2 * n : ℕ) : ℝ)) : (∫ t : ℝ, minusSaddleFiniteRapidContourIntegrand ε ℓ N r ((B : ℂ) + (t : ℂ) * Complex.I)) = (∫ t : ℝ, minusSaddleFiniteRapidContourIntegrand ε ℓ N r ((A : ℂ) + (t : ℂ) * Complex.I))"},{"kind":"theorem","name":"plusSaddleSpectrum_moment_integrable","statement":"{ε ℓ : ℝ} (hε : 0 < ε) (hℓ : 0 < ℓ) (horder : shortCutoff ε ≤ shortEndpoint ε) (k : ℕ) : Integrable (fun t : ℝ => (t : ℂ) ^ k * plusSaddleSpectrum ε ℓ t)"},{"kind":"theorem","name":"minusSaddleSpectrum_moment_integrable","statement":"{ε ℓ : ℝ} (hε : 0 < ε) (hℓ : 0 < ℓ) (horder : shortCutoff ε ≤ shortEndpoint ε) (k : ℕ) : Integrable (fun t : ℝ => (t : ℂ) ^ k * minusSaddleSpectrum ε ℓ t)"},{"kind":"theorem","name":"plusSaddleSpectrum_norm_moment_integrable","statement":"{ε ℓ : ℝ} (hε : 0 < ε) (hℓ : 0 < ℓ) (horder : shortCutoff ε ≤ shortEndpoint ε) (k : ℕ) : Integrable (fun t : ℝ => |t| ^ k * ‖plusSaddleSpectrum ε ℓ t‖)"},{"kind":"theorem","name":"minusSaddleSpectrum_norm_moment_integrable","statement":"{ε ℓ : ℝ} (hε : 0 < ε) (hℓ : 0 < ℓ) (horder : shortCutoff ε ≤ shortEndpoint ε) (k : ℕ) : Integrable (fun t : ℝ => |t| ^ k * ‖minusSaddleSpectrum ε ℓ t‖)"},{"kind":"theorem","name":"integrable_scaled_norm_moment","statement":"{F : ℝ → ℂ} (hF : Continuous F) (hmom : ∀ j : ℕ, Integrable (fun t : ℝ => |t| ^ j * ‖F t‖)) {c : ℝ} (hc : c ≠ 0) (hclarge : 1 ≤ |c|) (k : ℕ) : Integrable (fun y : ℝ => ‖y‖ ^ k * ‖F (c * y)‖)"},{"kind":"theorem","name":"plusSaddleFourierData_norm_moment_integrable","statement":"{ε ℓ : ℝ} (hε : 0 < ε) (hℓ : 0 < ℓ) (horder : shortCutoff ε ≤ shortEndpoint ε) (k : ℕ) : Integrable (fun y : ℝ => ‖y‖ ^ k * ‖plusSaddleFourierData ε ℓ y‖)"},{"kind":"theorem","name":"minusSaddleFourierData_norm_moment_integrable","statement":"{ε ℓ : ℝ} (hε : 0 < ε) (hℓ : 0 < ℓ) (horder : shortCutoff ε ≤ shortEndpoint ε) (k : ℕ) : Integrable (fun y : ℝ => ‖y‖ ^ k * ‖minusSaddleFourierData ε ℓ y‖)"},{"kind":"theorem","name":"plusSaddleFourierData_fourier_contDiff","statement":"{ε ℓ : ℝ} (hε : 0 < ε) (hℓ : 0 < ℓ) (horder : shortCutoff ε ≤ shortEndpoint ε) : ContDiff ℝ ∞ (𝓕 (plusSaddleFourierData ε ℓ))"},{"kind":"theorem","name":"minusSaddleFourierData_fourier_contDiff","statement":"{ε ℓ : ℝ} (hε : 0 < ε) (hℓ : 0 < ℓ) (horder : shortCutoff ε ≤ shortEndpoint ε) : ContDiff ℝ ∞ (𝓕 (minusSaddleFourierData ε ℓ))"},{"kind":"theorem","name":"plusSaddleMellinData_fourier_vertical","statement":"(ε ℓ y : ℝ) : plusSaddleMellinData ε ℓ ((ℓ : ℂ) + (2 * Real.pi * y : ℝ) * Complex.I) = plusSaddleFourierData ε ℓ y"},{"kind":"theorem","name":"minusSaddleMellinData_fourier_vertical","statement":"(ε ℓ y : ℝ) : minusSaddleMellinData ε ℓ ((ℓ : ℂ) + (2 * Real.pi * y : ℝ) * Complex.I) = minusSaddleFourierData ε ℓ y"},{"kind":"theorem","name":"plusSaddleProfile_eq_fourier","statement":"(ε ℓ : ℝ) {r : ℝ} (hr : 0 < r) : plusSaddleProfile ε ℓ r = (r ^ (-ℓ) : ℝ) * (𝓕 (plusSaddleFourierData ε ℓ)) (Real.log r)"},{"kind":"theorem","name":"minusSaddleProfile_eq_fourier","statement":"(ε ℓ : ℝ) {r : ℝ} (hr : 0 < r) : minusSaddleProfile ε ℓ r = (r ^ (-ℓ) : ℝ) * (𝓕 (minusSaddleFourierData ε ℓ)) (Real.log r)"},{"kind":"theorem","name":"plusSaddleProfile_contDiffOn","statement":"{ε ℓ : ℝ} (hε : 0 < ε) (hℓ : 0 < ℓ) (horder : shortCutoff ε ≤ shortEndpoint ε) : ContDiffOn ℝ ∞ (plusSaddleProfile ε ℓ) (Set.Ioi 0)"},{"kind":"theorem","name":"minusSaddleProfile_contDiffOn","statement":"{ε ℓ : ℝ} (hε : 0 < ε) (hℓ : 0 < ℓ) (horder : shortCutoff ε ≤ shortEndpoint ε) : ContDiffOn ℝ ∞ (minusSaddleProfile ε ℓ) (Set.Ioi 0)"},{"kind":"theorem","name":"plusSaddleFunction_contDiffOn","statement":"{ε : ℝ} (hε : 0 < ε) {d : ℕ} (hd : 0 < d) (horder : shortCutoff ε ≤ shortEndpoint ε) : ContDiffOn ℝ ∞ (plusSaddleFunction ε d) ({0}ᶜ : Set (Euclidean d))"},{"kind":"theorem","name":"minusSaddleFunction_contDiffOn","statement":"{ε : ℝ} (hε : 0 < ε) {d : ℕ} (hd : 0 < d) (horder : shortCutoff ε ≤ shortEndpoint ε) : ContDiffOn ℝ ∞ (minusSaddleFunction ε d) ({0}ᶜ : Set (Euclidean d))"},{"kind":"theorem","name":"plusSaddleSpectrum_conj","statement":"(ε ℓ t : ℝ) : starRingEnd ℂ (plusSaddleSpectrum ε ℓ t) = plusSaddleSpectrum ε ℓ (-t)"},{"kind":"theorem","name":"minusSaddleSpectrum_conj","statement":"(ε ℓ t : ℝ) : starRingEnd ℂ (minusSaddleSpectrum ε ℓ t) = minusSaddleSpectrum ε ℓ (-t)"},{"kind":"theorem","name":"mellinInversePower_conj","statement":"{r : ℝ} (hr : 0 < r) (σ t : ℝ) : starRingEnd ℂ ((r : ℂ) ^ (-((σ : ℂ) + (t : ℂ) * Complex.I))) = (r : ℂ) ^ (-((σ : ℂ) + ((-t : ℝ) : ℂ) * Complex.I))"},{"kind":"theorem","name":"mellinInv_real_of_hermitian","statement":"(σ : ℝ) (F : ℂ → ℂ) (hF : ∀ t : ℝ, starRingEnd ℂ (F ((σ : ℂ) + (t : ℂ) * Complex.I)) = F ((σ : ℂ) + ((-t : ℝ) : ℂ) * Complex.I)) {r : ℝ} (hr : 0 < r) : (mellinInv σ F r).im = 0"},{"kind":"theorem","name":"plusSaddleMellinData_conj_vertical","statement":"(ε ℓ t : ℝ) : starRingEnd ℂ (plusSaddleMellinData ε ℓ ((ℓ : ℂ) + (t : ℂ) * Complex.I)) = plusSaddleMellinData ε ℓ ((ℓ : ℂ) + ((-t : ℝ) : ℂ) * Complex.I)"},{"kind":"theorem","name":"minusSaddleMellinData_conj_vertical","statement":"(ε ℓ t : ℝ) : starRingEnd ℂ (minusSaddleMellinData ε ℓ ((ℓ : ℂ) + (t : ℂ) * Complex.I)) = minusSaddleMellinData ε ℓ ((ℓ : ℂ) + ((-t : ℝ) : ℂ) * Complex.I)"},{"kind":"theorem","name":"plusSaddleProfile_real","statement":"(ε ℓ : ℝ) {r : ℝ} (hr : 0 ≤ r) : (plusSaddleProfile ε ℓ r).im = 0"},{"kind":"theorem","name":"minusSaddleProfile_real","statement":"(ε ℓ : ℝ) {r : ℝ} (hr : 0 ≤ r) : (minusSaddleProfile ε ℓ r).im = 0"},{"kind":"theorem","name":"plusSaddleFunction_real","statement":"(ε : ℝ) (d : ℕ) (x : Euclidean d) : (plusSaddleFunction ε d x).im = 0"},{"kind":"theorem","name":"minusSaddleFunction_real","statement":"(ε : ℝ) (d : ℕ) (x : Euclidean d) : (minusSaddleFunction ε d x).im = 0"},{"kind":"theorem","name":"mellinMultiplier_mul_saddleEnvelope_neg","statement":"{ε ℓ : ℝ} (hℓ : 0 < ℓ) (t : ℝ) : mellinMultiplier ℓ t * saddleEnvelope ε ℓ (-t) = saddleEnvelope ε ℓ t"},{"kind":"theorem","name":"mellinMultiplier_mul_minusSaddleSpectrum_neg","statement":"{ε ℓ : ℝ} (hℓ : 0 < ℓ) (t : ℝ) : mellinMultiplier ℓ t * minusSaddleSpectrum ε ℓ (-t) = plusSaddleSpectrum ε ℓ t"},{"kind":"theorem","name":"saddleCauchyPole_symmetric_intervalIntegral_tendsto_pos","statement":"{a : ℝ} (ha : 0 < a) : Tendsto (fun T : ℝ => ∫ t in -T..T, ((a : ℂ) + (t : ℂ) * Complex.I)⁻¹) Filter.atTop (𝓝 (Real.pi : ℂ))"},{"kind":"theorem","name":"saddleCauchyPole_symmetric_intervalIntegral_tendsto_neg","statement":"{a : ℝ} (ha : a < 0) : Tendsto (fun T : ℝ => ∫ t in -T..T, ((a : ℂ) + (t : ℂ) * Complex.I)⁻¹) Filter.atTop (𝓝 (-(Real.pi : ℂ)))"},{"kind":"theorem","name":"saddleShiftedCauchyPole_symmetric_intervalIntegral_tendsto_pos","statement":"(n : ℕ) {a : ℝ} (ha : -((2 * n : ℕ) : ℝ) < a) : Tendsto (fun T : ℝ => ∫ t in -T..T, (((a : ℂ) + (t : ℂ) * Complex.I + ((2 * n : ℕ) : ℂ))⁻¹)) Filter.atTop (𝓝 (Real.pi : ℂ))"},{"kind":"theorem","name":"saddleShiftedCauchyPole_symmetric_intervalIntegral_tendsto_neg","statement":"(n : ℕ) {a : ℝ} (ha : a < -((2 * n : ℕ) : ℝ)) : Tendsto (fun T : ℝ => ∫ t in -T..T, (((a : ℂ) + (t : ℂ) * Complex.I + ((2 * n : ℕ) : ℂ))⁻¹)) Filter.atTop (𝓝 (-(Real.pi : ℂ)))"},{"kind":"theorem","name":"saddleGaussianPoleRepresentative_eq_inv_add_slope","statement":"(n : ℕ) {z : ℂ} (hz : z + ((2 * n : ℕ) : ℂ) ≠ 0) : saddleGaussianPoleRepresentative n z = (z + ((2 * n : ℕ) : ℂ))⁻¹ + saddleGaussianPoleSlope (z + ((2 * n : ℕ) : ℂ))"},{"kind":"theorem","name":"saddleGaussianPoleShiftedSlope_differentiable","statement":"(n : ℕ) : Differentiable ℂ (fun z : ℂ => saddleGaussianPoleSlope (z + ((2 * n : ℕ) : ℂ)))"},{"kind":"theorem","name":"saddleGaussianPoleShiftedSlope_boundary_rectangle","statement":"(n : ℕ) (A B T : ℝ) : (∫ a in A..B, saddleGaussianPoleSlope ((a : ℂ) + ((-T : ℝ) : ℂ) * Complex.I + ((2 * n : ℕ) : ℂ))) - (∫ a in A..B, saddleGaussianPoleSlope ((a : ℂ) + (T : ℂ) * Complex.I + ((2 * n : ℕ) : ℂ))) + Complex.I * (∫ t in -T..T, saddleGaussianPoleSlope ((B : ℂ) + (t : ℂ) * Complex.I + ((2 * n : ℕ) : ℂ))) - Complex.I * (∫ t in -T..T, saddleGaussianPoleSlope ((A : ℂ) + (t : ℂ) * Complex.I + ((2 * n : ℕ) : ℂ))) = 0"},{"kind":"theorem","name":"saddleGaussianPoleShiftedSlope_horizontalIntegral_tendsto_zero","statement":"{A B : ℝ} (hAB : A ≤ B) (n : ℕ) (s : ℝ) (hs : |s| = 1) : Tendsto (fun T : ℝ => ∫ a in A..B, saddleGaussianPoleSlope ((a : ℂ) + ((s * T : ℝ) : ℂ) * Complex.I + ((2 * n : ℕ) : ℂ))) Filter.atTop (𝓝 0)"},{"kind":"theorem","name":"saddleInfiniteRectangle_vertical_limit_eq","statement":"{F : ℂ → ℂ} {A B : ℝ} {u v : ℂ} (hleft : Tendsto (fun T : ℝ => ∫ t in -T..T, F ((A : ℂ) + (t : ℂ) * Complex.I)) Filter.atTop (𝓝 u)) (hright : Tendsto (fun T : ℝ => ∫ t in -T..T, F ((B : ℂ) + (t : ℂ) * Complex.I)) Filter.atTop (𝓝 v)) (hlower : Tendsto (fun T : ℝ => ∫ a in A..B, F ((a : ℂ) + ((-T : ℝ) : ℂ) * Complex.I)) Filter.atTop (𝓝 0)) (hupper : Tendsto (fun T : ℝ => ∫ a in A..B, F ((a : ℂ) + (T : ℂ) * Complex.I)) Filter.atTop (𝓝 0)) (hrectangle : ∀ T : ℝ, (∫ a in A..B, F ((a : ℂ) + ((-T : ℝ) : ℂ) * Complex.I)) - (∫ a in A..B, F ((a : ℂ) + (T : ℂ) * Complex.I)) + Complex.I * (∫ t in -T..T, F ((B : ℂ) + (t : ℂ) * Complex.I)) - Complex.I * (∫ t in -T..T, F ((A : ℂ) + (t : ℂ) * Complex.I)) = 0) : v = u"},{"kind":"theorem","name":"saddleGaussianPoleShiftedSlope_symmetric_intervalIntegral","statement":"(n : ℕ) {a : ℝ} (ha : a ≠ -((2 * n : ℕ) : ℝ)) (T : ℝ) : (∫ t in -T..T, saddleGaussianPoleSlope ((a : ℂ) + (t : ℂ) * Complex.I + ((2 * n : ℕ) : ℂ))) = (∫ t in -T..T, saddleGaussianPoleRepresentative n ((a : ℂ) + (t : ℂ) * Complex.I)) - (∫ t in -T..T, (((a : ℂ) + (t : ℂ) * Complex.I + ((2 * n : ℕ) : ℂ))⁻¹))"},{"kind":"theorem","name":"saddleGaussianPoleShiftedSlope_symmetric_intervalIntegral_tendsto_pos","statement":"(n : ℕ) {a : ℝ} (ha : -((2 * n : ℕ) : ℝ) < a) : Tendsto (fun T : ℝ => ∫ t in -T..T, saddleGaussianPoleSlope ((a : ℂ) + (t : ℂ) * Complex.I + ((2 * n : ℕ) : ℂ))) Filter.atTop (𝓝 ((∫ t : ℝ, saddleGaussianPoleRepresentative n ((a : ℂ) + (t : ℂ) * Complex.I)) - (Real.pi : ℂ)))"},{"kind":"theorem","name":"saddleGaussianPoleShiftedSlope_symmetric_intervalIntegral_tendsto_neg","statement":"(n : ℕ) {a : ℝ} (ha : a < -((2 * n : ℕ) : ℝ)) : Tendsto (fun T : ℝ => ∫ t in -T..T, saddleGaussianPoleSlope ((a : ℂ) + (t : ℂ) * Complex.I + ((2 * n : ℕ) : ℂ))) Filter.atTop (𝓝 ((∫ t : ℝ, saddleGaussianPoleRepresentative n ((a : ℂ) + (t : ℂ) * Complex.I)) - (-(Real.pi : ℂ))))"},{"kind":"theorem","name":"saddleGaussianPoleRepresentative_vertical_integral_jump","statement":"(n : ℕ) {A B : ℝ} (hA : A < -((2 * n : ℕ) : ℝ)) (hB : -((2 * n : ℕ) : ℝ) < B) : (∫ t : ℝ, saddleGaussianPoleRepresentative n ((B : ℂ) + (t : ℂ) * Complex.I)) - (∫ t : ℝ, saddleGaussianPoleRepresentative n ((A : ℂ) + (t : ℂ) * Complex.I)) = ((2 * Real.pi : ℝ) : ℂ)"},{"kind":"theorem","name":"saddleMellinInversePower_negativeEvenPole","statement":"(r : ℝ) (n : ℕ) : saddleMellinInversePower r (-((2 * n : ℕ) : ℂ)) = ((r ^ (2 * n) : ℝ) : ℂ)"},{"kind":"theorem","name":"saddleMellinInversePowerPoleSlope_differentiable","statement":"{r : ℝ} (hr : 0 < r) (n : ℕ) : Differentiable ℂ (saddleMellinInversePowerPoleSlope r n)"},{"kind":"theorem","name":"saddleGaussianPoleWeightedCorrection_differentiable","statement":"{r : ℝ} (hr : 0 < r) (n : ℕ) : Differentiable ℂ (saddleGaussianPoleWeightedCorrection r n)"},{"kind":"theorem","name":"saddleGaussianPoleWeightedRepresentative_eq_pole_add_correction","statement":"{r : ℝ} (n : ℕ) {z : ℂ} (hz : z + ((2 * n : ℕ) : ℂ) ≠ 0) : saddleMellinInversePower r z * saddleGaussianPoleRepresentative n z = saddleMellinInversePower r (-((2 * n : ℕ) : ℂ)) * saddleGaussianPoleRepresentative n z + saddleGaussianPoleWeightedCorrection r n z"},{"kind":"theorem","name":"saddleGaussianPole_shiftedLine_ne_zero","statement":"(n : ℕ) {a : ℝ} (ha : a ≠ -((2 * n : ℕ) : ℝ)) (t : ℝ) : (a : ℂ) + (t : ℂ) * Complex.I + ((2 * n : ℕ) : ℂ) ≠ 0"},{"kind":"theorem","name":"saddleGaussianPoleWeightedCorrection_eq_sub","statement":"{r : ℝ} (n : ℕ) {z : ℂ} (hz : z + ((2 * n : ℕ) : ℂ) ≠ 0) : saddleGaussianPoleWeightedCorrection r n z = saddleMellinInversePower r z * saddleGaussianPoleRepresentative n z - saddleMellinInversePower r (-((2 * n : ℕ) : ℂ)) * saddleGaussianPoleRepresentative n z"},{"kind":"theorem","name":"saddleGaussianPoleWeightedCorrection_shiftedLine_integrable","statement":"{r a : ℝ} (hr : 0 < r) (n : ℕ) (ha : a ≠ -((2 * n : ℕ) : ℝ)) : Integrable (fun t : ℝ => saddleGaussianPoleWeightedCorrection r n ((a : ℂ) + (t : ℂ) * Complex.I))"},{"kind":"theorem","name":"saddleGaussianPoleWeightedCorrection_horizontalStrip_bound","statement":"{r A B : ℝ} (hr : 0 < r) (hAB : A ≤ B) (n : ℕ) : ∃ C : ℝ, 0 ≤ C ∧ ∀ a ∈ Set.Icc A B, ∀ t : ℝ, 1 ≤ |t| → |t| * ‖saddleGaussianPoleWeightedCorrection r n ((a : ℂ) + (t : ℂ) * Complex.I)‖ ≤ C"},{"kind":"theorem","name":"saddleGaussianPoleWeightedCorrection_horizontalIntegral_tendsto_zero","statement":"{r A B : ℝ} (hr : 0 < r) (hAB : A ≤ B) (n : ℕ) (s : ℝ) (hs : |s| = 1) : Tendsto (fun T : ℝ => ∫ a in A..B, saddleGaussianPoleWeightedCorrection r n ((a : ℂ) + ((s * T : ℝ) : ℂ) * Complex.I)) Filter.atTop (𝓝 0)"},{"kind":"theorem","name":"saddleGaussianPoleWeightedCorrection_boundary_rectangle","statement":"{r : ℝ} (hr : 0 < r) (n : ℕ) (A B T : ℝ) : (∫ a in A..B, saddleGaussianPoleWeightedCorrection r n ((a : ℂ) + ((-T : ℝ) : ℂ) * Complex.I)) - (∫ a in A..B, saddleGaussianPoleWeightedCorrection r n ((a : ℂ) + (T : ℂ) * Complex.I)) + Complex.I * (∫ t in -T..T, saddleGaussianPoleWeightedCorrection r n ((B : ℂ) + (t : ℂ) * Complex.I)) - Complex.I * (∫ t in -T..T, saddleGaussianPoleWeightedCorrection r n ((A : ℂ) + (t : ℂ) * Complex.I)) = 0"},{"kind":"theorem","name":"saddleGaussianPoleWeightedCorrection_vertical_integral_eq","statement":"{r A B : ℝ} (hr : 0 < r) (n : ℕ) (hAB : A ≤ B) (hA : A ≠ -((2 * n : ℕ) : ℝ)) (hB : B ≠ -((2 * n : ℕ) : ℝ)) : (∫ t : ℝ, saddleGaussianPoleWeightedCorrection r n ((B : ℂ) + (t : ℂ) * Complex.I)) = (∫ t : ℝ, saddleGaussianPoleWeightedCorrection r n ((A : ℂ) + (t : ℂ) * Complex.I))"},{"kind":"theorem","name":"saddleGaussianPoleWeightedRepresentative_shiftedLine_integral_eq","statement":"{r a : ℝ} (hr : 0 < r) (n : ℕ) (ha : a ≠ -((2 * n : ℕ) : ℝ)) : (∫ t : ℝ, saddleMellinInversePower r ((a : ℂ) + (t : ℂ) * Complex.I) * saddleGaussianPoleRepresentative n ((a : ℂ) + (t : ℂ) * Complex.I)) = saddleMellinInversePower r (-((2 * n : ℕ) : ℂ)) * (∫ t : ℝ, saddleGaussianPoleRepresentative n ((a : ℂ) + (t : ℂ) * Complex.I)) + (∫ t : ℝ, saddleGaussianPoleWeightedCorrection r n ((a : ℂ) + (t : ℂ) * Complex.I))"},{"kind":"theorem","name":"saddleGaussianPoleWeightedRepresentative_vertical_integral_jump","statement":"{r A B : ℝ} (hr : 0 < r) (n : ℕ) (hA : A < -((2 * n : ℕ) : ℝ)) (hB : -((2 * n : ℕ) : ℝ) < B) : (∫ t : ℝ, saddleMellinInversePower r ((B : ℂ) + (t : ℂ) * Complex.I) * saddleGaussianPoleRepresentative n ((B : ℂ) + (t : ℂ) * Complex.I)) - (∫ t : ℝ, saddleMellinInversePower r ((A : ℂ) + (t : ℂ) * Complex.I) * saddleGaussianPoleRepresentative n ((A : ℂ) + (t : ℂ) * Complex.I)) = ((2 * Real.pi : ℝ) : ℂ) * ((r ^ (2 * n) : ℝ) : ℂ)"},{"kind":"theorem","name":"saddleFiniteGaussianPoleWeighted_shiftedLine_integrable","statement":"{r a : ℝ} (hr : 0 < r) (c : ℕ → ℂ) (N : ℕ) (ha : ∀ n : ℕ, a ≠ -((2 * n : ℕ) : ℝ)) : Integrable (fun t : ℝ => ∑ n ∈ Finset.range (N + 1), saddleMellinInversePower r ((a : ℂ) + (t : ℂ) * Complex.I) * (c n * saddleGaussianPoleRepresentative n ((a : ℂ) + (t : ℂ) * Complex.I)))"},{"kind":"theorem","name":"saddleFiniteGaussianPoleWeighted_shiftedLine_integral","statement":"{r a : ℝ} (hr : 0 < r) (c : ℕ → ℂ) (N : ℕ) (ha : ∀ n : ℕ, a ≠ -((2 * n : ℕ) : ℝ)) : (∫ t : ℝ, ∑ n ∈ Finset.range (N + 1), saddleMellinInversePower r ((a : ℂ) + (t : ℂ) * Complex.I) * (c n * saddleGaussianPoleRepresentative n ((a : ℂ) + (t : ℂ) * Complex.I))) = ∑ n ∈ Finset.range (N + 1), c n * (∫ t : ℝ, saddleMellinInversePower r ((a : ℂ) + (t : ℂ) * Complex.I) * saddleGaussianPoleRepresentative n ((a : ℂ) + (t : ℂ) * Complex.I))"},{"kind":"theorem","name":"plusSaddleFiniteRapidContourIntegrand_shiftedLine_integral_eq","statement":"{ε ℓ a r : ℝ} (hε : 0 < ε) (hℓ : 0 < ℓ) (horder : shortCutoff ε ≤ shortEndpoint ε) (hr : 0 < r) (N : ℕ) (hhalf : -(2 * ((N : ℝ) + 1)) < a) (hpole : ∀ n : ℕ, a ≠ -((2 * n : ℕ) : ℝ)) : (∫ t : ℝ, plusSaddleFiniteRapidContourIntegrand ε ℓ N r ((a : ℂ) + (t : ℂ) * Complex.I)) = (∫ t : ℝ, saddleMellinInversePower r ((a : ℂ) + (t : ℂ) * Complex.I) * plusSaddleMellinData ε ℓ ((a : ℂ) + (t : ℂ) * Complex.I)) - ∑ n ∈ Finset.range (N + 1), plusSaddlePoleResidue ε ℓ n * (∫ t : ℝ, saddleMellinInversePower r ((a : ℂ) + (t : ℂ) * Complex.I) * saddleGaussianPoleRepresentative n ((a : ℂ) + (t : ℂ) * Complex.I))"},{"kind":"theorem","name":"minusSaddleFiniteRapidContourIntegrand_shiftedLine_integral_eq","statement":"{ε ℓ a r : ℝ} (hε : 0 < ε) (hℓ : 0 < ℓ) (horder : shortCutoff ε ≤ shortEndpoint ε) (hr : 0 < r) (N : ℕ) (hhalf : -(2 * ((N : ℝ) + 1)) < a) (hpole : ∀ n : ℕ, a ≠ -((2 * n : ℕ) : ℝ)) : (∫ t : ℝ, minusSaddleFiniteRapidContourIntegrand ε ℓ N r ((a : ℂ) + (t : ℂ) * Complex.I)) = (∫ t : ℝ, saddleMellinInversePower r ((a : ℂ) + (t : ℂ) * Complex.I) * minusSaddleMellinData ε ℓ ((a : ℂ) + (t : ℂ) * Complex.I)) - ∑ n ∈ Finset.range (N + 1), minusSaddlePoleResidue ε ℓ n * (∫ t : ℝ, saddleMellinInversePower r ((a : ℂ) + (t : ℂ) * Complex.I) * saddleGaussianPoleRepresentative n ((a : ℂ) + (t : ℂ) * Complex.I))"},{"kind":"theorem","name":"saddleFiniteGaussianPoleWeighted_vertical_integral_jump","statement":"{r A B : ℝ} (hr : 0 < r) (c : ℕ → ℂ) (N : ℕ) (hcross : ∀ n ∈ Finset.range (N + 1), A < -((2 * n : ℕ) : ℝ) ∧ -((2 * n : ℕ) : ℝ) < B) : (∑ n ∈ Finset.range (N + 1), c n * (∫ t : ℝ, saddleMellinInversePower r ((B : ℂ) + (t : ℂ) * Complex.I) * saddleGaussianPoleRepresentative n ((B : ℂ) + (t : ℂ) * Complex.I))) - (∑ n ∈ Finset.range (N + 1), c n * (∫ t : ℝ, saddleMellinInversePower r ((A : ℂ) + (t : ℂ) * Complex.I) * saddleGaussianPoleRepresentative n ((A : ℂ) + (t : ℂ) * Complex.I))) = ((2 * Real.pi : ℝ) : ℂ) * ∑ n ∈ Finset.range (N + 1), c n * ((r ^ (2 * n) : ℝ) : ℂ)"},{"kind":"theorem","name":"plusSaddleMellinData_vertical_integral_residue_expansion","statement":"{ε ℓ r A B : ℝ} (hε : 0 < ε) (hℓ : 0 < ℓ) (horder : shortCutoff ε ≤ shortEndpoint ε) (hr : 0 < r) (N : ℕ) (hhalf : -(2 * ((N : ℝ) + 1)) < A) (hAB : A ≤ B) (hApole : ∀ n : ℕ, A ≠ -((2 * n : ℕ) : ℝ)) (hBpole : ∀ n : ℕ, B ≠ -((2 * n : ℕ) : ℝ)) (hcross : ∀ n ∈ Finset.range (N + 1), A < -((2 * n : ℕ) : ℝ) ∧ -((2 * n : ℕ) : ℝ) < B) : (∫ t : ℝ, saddleMellinInversePower r ((B : ℂ) + (t : ℂ) * Complex.I) * plusSaddleMellinData ε ℓ ((B : ℂ) + (t : ℂ) * Complex.I)) = (∫ t : ℝ, saddleMellinInversePower r ((A : ℂ) + (t : ℂ) * Complex.I) * plusSaddleMellinData ε ℓ ((A : ℂ) + (t : ℂ) * Complex.I)) + ((2 * Real.pi : ℝ) : ℂ) * ∑ n ∈ Finset.range (N + 1), plusSaddlePoleResidue ε ℓ n * ((r ^ (2 * n) : ℝ) : ℂ)"},{"kind":"theorem","name":"minusSaddleMellinData_vertical_integral_residue_expansion","statement":"{ε ℓ r A B : ℝ} (hε : 0 < ε) (hℓ : 0 < ℓ) (horder : shortCutoff ε ≤ shortEndpoint ε) (hr : 0 < r) (N : ℕ) (hhalf : -(2 * ((N : ℝ) + 1)) < A) (hAB : A ≤ B) (hApole : ∀ n : ℕ, A ≠ -((2 * n : ℕ) : ℝ)) (hBpole : ∀ n : ℕ, B ≠ -((2 * n : ℕ) : ℝ)) (hcross : ∀ n ∈ Finset.range (N + 1), A < -((2 * n : ℕ) : ℝ) ∧ -((2 * n : ℕ) : ℝ) < B) : (∫ t : ℝ, saddleMellinInversePower r ((B : ℂ) + (t : ℂ) * Complex.I) * minusSaddleMellinData ε ℓ ((B : ℂ) + (t : ℂ) * Complex.I)) = (∫ t : ℝ, saddleMellinInversePower r ((A : ℂ) + (t : ℂ) * Complex.I) * minusSaddleMellinData ε ℓ ((A : ℂ) + (t : ℂ) * Complex.I)) + ((2 * Real.pi : ℝ) : ℂ) * ∑ n ∈ Finset.range (N + 1), minusSaddlePoleResidue ε ℓ n * ((r ^ (2 * n) : ℝ) : ℂ)"},{"kind":"theorem","name":"saddleTaylorContour_mem_halfPlane","statement":"(N : ℕ) : -(2 * ((N : ℝ) + 1)) < saddleTaylorContour N"},{"kind":"theorem","name":"saddleTaylorContour_ne_pole","statement":"(N n : ℕ) : saddleTaylorContour N ≠ -((2 * n : ℕ) : ℝ)"},{"kind":"theorem","name":"saddlePositiveContour_ne_pole","statement":"{ℓ : ℝ} (hℓ : 0 < ℓ) (n : ℕ) : ℓ ≠ -((2 * n : ℕ) : ℝ)"},{"kind":"theorem","name":"saddleTaylorContour_crosses_poles","statement":"{ℓ : ℝ} (hℓ : 0 < ℓ) (N : ℕ) : ∀ n ∈ Finset.range (N + 1), saddleTaylorContour N < -((2 * n : ℕ) : ℝ) ∧ -((2 * n : ℕ) : ℝ) < ℓ"},{"kind":"theorem","name":"saddleTaylorContour_le_positive","statement":"{ℓ : ℝ} (hℓ : 0 < ℓ) (N : ℕ) : saddleTaylorContour N ≤ ℓ"},{"kind":"theorem","name":"plusSaddleProfile_eq_normalized_vertical_integral","statement":"{ε ℓ r : ℝ} (hr : 0 < r) : plusSaddleProfile ε ℓ r = ((1 / (2 * Real.pi) : ℝ) : ℂ) * (∫ t : ℝ, saddleMellinInversePower r ((ℓ : ℂ) + (t : ℂ) * Complex.I) * plusSaddleMellinData ε ℓ ((ℓ : ℂ) + (t : ℂ) * Complex.I))"},{"kind":"theorem","name":"minusSaddleProfile_eq_normalized_vertical_integral","statement":"{ε ℓ r : ℝ} (hr : 0 < r) : minusSaddleProfile ε ℓ r = ((1 / (2 * Real.pi) : ℝ) : ℂ) * (∫ t : ℝ, saddleMellinInversePower r ((ℓ : ℂ) + (t : ℂ) * Complex.I) * minusSaddleMellinData ε ℓ ((ℓ : ℂ) + (t : ℂ) * Complex.I))"},{"kind":"theorem","name":"plusSaddlePoleResidue_zero","statement":"{ε ℓ : ℝ} (hℓ : 0 < ℓ) : plusSaddlePoleResidue ε ℓ 0 = (saddleOriginValue ε ℓ : ℂ)"},{"kind":"theorem","name":"minusSaddlePoleResidue_zero","statement":"{ε ℓ : ℝ} (hℓ : 0 < ℓ) : minusSaddlePoleResidue ε ℓ 0 = (saddleOriginValue ε ℓ : ℂ)"},{"kind":"theorem","name":"plusSaddleProfile_eq_residue_sum_add_remainder","statement":"{ε ℓ r : ℝ} (hε : 0 < ε) (hℓ : 0 < ℓ) (horder : shortCutoff ε ≤ shortEndpoint ε) (hr : 0 < r) (N : ℕ) : plusSaddleProfile ε ℓ r = (∑ n ∈ Finset.range (N + 1), plusSaddlePoleResidue ε ℓ n * ((r ^ (2 * n) : ℝ) : ℂ)) + plusSaddleTaylorRemainder ε ℓ N r"},{"kind":"theorem","name":"minusSaddleProfile_eq_residue_sum_add_remainder","statement":"{ε ℓ r : ℝ} (hε : 0 < ε) (hℓ : 0 < ℓ) (horder : shortCutoff ε ≤ shortEndpoint ε) (hr : 0 < r) (N : ℕ) : minusSaddleProfile ε ℓ r = (∑ n ∈ Finset.range (N + 1), minusSaddlePoleResidue ε ℓ n * ((r ^ (2 * n) : ℝ) : ℂ)) + minusSaddleTaylorRemainder ε ℓ N r"},{"kind":"theorem","name":"saddleMellinInversePower_shiftedLine_integral_norm","statement":"{r a : ℝ} (hr : 0 < r) (F : ℂ → ℂ) (hF : Integrable (fun t : ℝ => F ((a : ℂ) + (t : ℂ) * Complex.I))) : (∫ t : ℝ, ‖saddleMellinInversePower r ((a : ℂ) + (t : ℂ) * Complex.I) * F ((a : ℂ) + (t : ℂ) * Complex.I)‖) = r ^ (-a) * (∫ t : ℝ, ‖F ((a : ℂ) + (t : ℂ) * Complex.I)‖)"},{"kind":"theorem","name":"saddleTaylorContour_rpow","statement":"(r : ℝ) (N : ℕ) : r ^ (-(saddleTaylorContour N)) = r ^ (2 * N + 1)"},{"kind":"theorem","name":"wallisProduct_pos","statement":"(n : ℕ) : 0 < wallisProduct n"},{"kind":"theorem","name":"tendsto_wallisProduct","statement":"Tendsto wallisProduct atTop (nhds (Real.pi / 2))"},{"kind":"theorem","name":"tendsto_log_wallisProduct","statement":"Tendsto (fun n : ℕ => Real.log (wallisProduct n)) atTop (nhds (Real.log (Real.pi / 2)))"},{"kind":"theorem","name":"laplaceKernel_integrable","statement":"{a : ℝ} (ha : 0 < a) : IntegrableOn (fun x : ℝ => Real.exp (-a * x)) (Ioi 0)"},{"kind":"theorem","name":"integral_laplaceKernel","statement":"{a : ℝ} (ha : 0 < a) : (∫ x : ℝ in Ioi 0, Real.exp (-a * x)) = a⁻¹"},{"kind":"theorem","name":"intervalIntegral_laplaceKernel","statement":"{x : ℝ} (hx : x ≠ 0) (a b : ℝ) : (∫ s in a..b, Real.exp (-s * x)) = frullaniKernel a b x"},{"kind":"theorem","name":"laplaceParameter_integrable","statement":"{a b : ℝ} (ha : 0 < a) (hab : a ≤ b) : Integrable (Function.uncurry (fun s x : ℝ => Real.exp (-s * x))) ((volume.restrict (Set.uIoc a b)).prod (volume.restrict (Ioi 0)))"},{"kind":"theorem","name":"integral_frullaniKernel","statement":"{a b : ℝ} (ha : 0 < a) (hab : a ≤ b) : (∫ x : ℝ in Ioi 0, frullaniKernel a b x) = Real.log (b / a)"},{"kind":"theorem","name":"frullaniKernel_integrable","statement":"{a b : ℝ} (ha : 0 < a) (hab : a ≤ b) : IntegrableOn (frullaniKernel a b) (Ioi 0)"},{"kind":"theorem","name":"wallisPairKernel_eq","statement":"(n : ℕ) (x : ℝ) : wallisPairKernel n x = Real.exp (-(2 * (n : ℝ) + 1) * x) * (1 - Real.exp (-x)) ^ 2 / x"},{"kind":"theorem","name":"wallisPairKernel_integrable","statement":"(n : ℕ) : IntegrableOn (wallisPairKernel n) (Ioi 0)"},{"kind":"theorem","name":"integral_wallisPairKernel","statement":"(n : ℕ) : (∫ x : ℝ in Ioi 0, wallisPairKernel n x) = Real.log (wallisPairFactor n)"},{"kind":"theorem","name":"wallisPairFactor_pos","statement":"(n : ℕ) : 0 < wallisPairFactor n"},{"kind":"theorem","name":"wallisProduct_succ","statement":"(n : ℕ) : wallisProduct (n + 1) = wallisProduct n * wallisPairFactor n"},{"kind":"theorem","name":"wallisPartialKernel_integrable","statement":"(n : ℕ) : IntegrableOn (wallisPartialKernel n) (Ioi 0)"},{"kind":"theorem","name":"integral_wallisPartialKernel","statement":"(n : ℕ) : (∫ x : ℝ in Ioi 0, wallisPartialKernel n x) = Real.log (wallisProduct n)"},{"kind":"theorem","name":"wallisPartialKernel_eq","statement":"(n : ℕ) {x : ℝ} (hx : x ≠ 0) : wallisPartialKernel n x = wallisLaplaceKernel x * (1 - Real.exp (-(2 * (n : ℝ)) * x))"},{"kind":"theorem","name":"wallisLaplaceKernel_nonneg","statement":"{x : ℝ} (hx : 0 < x) : 0 ≤ wallisLaplaceKernel x"},{"kind":"theorem","name":"wallisLaplaceKernel_abs_le","statement":"{x : ℝ} (hx : 0 < x) : |wallisLaplaceKernel x| ≤ Real.exp (-x)"},{"kind":"theorem","name":"wallisLaplaceKernel_integrable","statement":"IntegrableOn wallisLaplaceKernel (Ioi 0)"},{"kind":"theorem","name":"wallisPartialKernel_abs_le","statement":"(n : ℕ) {x : ℝ} (hx : 0 < x) : |wallisPartialKernel n x| ≤ wallisLaplaceKernel x"},{"kind":"theorem","name":"tendsto_wallisPartialKernel","statement":"{x : ℝ} (hx : 0 < x) : Tendsto (fun n : ℕ => wallisPartialKernel n x) atTop (nhds (wallisLaplaceKernel x))"},{"kind":"theorem","name":"tendsto_integral_wallisPartialKernel","statement":"Tendsto (fun n : ℕ => ∫ x : ℝ in Ioi 0, wallisPartialKernel n x) atTop (nhds (∫ x : ℝ in Ioi 0, wallisLaplaceKernel x))"},{"kind":"theorem","name":"integral_wallisLaplaceKernel","statement":"(∫ x : ℝ in Ioi 0, wallisLaplaceKernel x) = Real.log (Real.pi / 2)"},{"kind":"theorem","name":"tendsto_cubic_gaussian_atTop","statement":"Tendsto (fun x : ℝ => (x ^ 3 + 1) * Real.exp (-(x ^ 2) / 8)) atTop (nhds 0)"},{"kind":"theorem","name":"shellRadiusMajorant_inv","statement":"{x : ℝ} (hx : x ≠ 0) : shellRadiusMajorant x⁻¹ = ((x ^ 3 + 1) * Real.exp (-(x ^ 2) / 8)) * Real.exp (x⁻¹ / 4)"},{"kind":"theorem","name":"tendsto_shellRadiusMajorant","statement":"Tendsto shellRadiusMajorant (𝓝[>] (0 : ℝ)) (nhds 0)"},{"kind":"theorem","name":"tendsto_positiveShellRadiusContribution","statement":"Tendsto positiveShellRadiusContribution (𝓝[>] (0 : ℝ)) (nhds 0)"},{"kind":"theorem","name":"sinh_le_mul_cosh","statement":"{a : ℝ} (ha : 0 ≤ a) : Real.sinh a ≤ a * Real.cosh a"},{"kind":"theorem","name":"tendsto_shortShellRadiusIntegrand","statement":"{a : ℝ} (ha : 0 < a) : Tendsto (fun ε : ℝ => shortShellRadiusIntegrand ε a) (𝓝[>] (0 : ℝ)) (nhds (wallisRadiusIntegrand a))"},{"kind":"theorem","name":"shortMargin_abs_le_exp","statement":"{ε a : ℝ} (hε0 : 0 ≤ ε) (hε1 : ε ≤ 1) (ha : 0 ≤ a) : |shortMargin ε a| ≤ 11 * Real.exp a"},{"kind":"theorem","name":"shortShellHyperbolicRatio_le","statement":"{ε a : ℝ} (hε0 : 0 ≤ ε) (hε1 : ε ≤ 1) (ha : 0 ≤ a) : Real.sinh ((1 + ε / 4) * a) / Real.cosh a ≤ (5 / 4 : ℝ) * a * Real.exp (a / 4)"},{"kind":"theorem","name":"shortShellRadiusIntegrand_eq_ratio","statement":"{ε a : ℝ} (ha : a ≠ 0) : shortShellRadiusIntegrand ε a = -(shortMargin ε a * Real.exp (-2 * a) * (Real.sinh ((1 + ε / 4) * a) / Real.cosh a) / (2 * a))"},{"kind":"theorem","name":"shortShellRadiusIntegrand_abs_le","statement":"{ε a : ℝ} (hε0 : 0 ≤ ε) (hε1 : ε ≤ 1) (ha : 0 < a) : |shortShellRadiusIntegrand ε a| ≤ 7 * Real.exp (-(3 / 4 : ℝ) * a)"},{"kind":"theorem","name":"shortShellRadiusMajorant_integrable","statement":"IntegrableOn shortShellRadiusMajorant (Set.Ioi (0 : ℝ))"},{"kind":"theorem","name":"shortShellRadiusIntegrand_measurable","statement":"(ε : ℝ) : Measurable (shortShellRadiusIntegrand ε)"},{"kind":"theorem","name":"tendsto_shortCutoff","statement":"Tendsto shortCutoff (𝓝[>] (0 : ℝ)) (nhds 0)"},{"kind":"theorem","name":"tendsto_shortEndpoint","statement":"Tendsto shortEndpoint (𝓝[>] (0 : ℝ)) atTop"},{"kind":"theorem","name":"supportedShortShellRadiusIntegrand_measurable","statement":"(ε : ℝ) : Measurable (supportedShortShellRadiusIntegrand ε)"},{"kind":"theorem","name":"tendsto_supportedShortShellRadiusIntegrand","statement":"{a : ℝ} (ha : 0 < a) : Tendsto (fun ε : ℝ => supportedShortShellRadiusIntegrand ε a) (𝓝[>] (0 : ℝ)) (nhds (wallisRadiusIntegrand a))"},{"kind":"theorem","name":"tendsto_supportedShortShellRadiusIntegral","statement":"Tendsto (fun ε : ℝ => ∫ a in Set.Ioi (0 : ℝ), supportedShortShellRadiusIntegrand ε a) (𝓝[>] (0 : ℝ)) (nhds (∫ a in Set.Ioi (0 : ℝ), wallisRadiusIntegrand a))"},{"kind":"theorem","name":"shortShellRadiusContribution_eq_supported","statement":"{ε : ℝ} (hε : 0 < ε) (horder : shortCutoff ε ≤ shortEndpoint ε) : shortShellRadiusContribution ε = ∫ a in Set.Ioi (0 : ℝ), supportedShortShellRadiusIntegrand ε a"},{"kind":"theorem","name":"tendsto_shortShellRadiusContribution","statement":"Tendsto shortShellRadiusContribution (𝓝[>] (0 : ℝ)) (nhds (∫ a in Set.Ioi (0 : ℝ), wallisRadiusIntegrand a))"},{"kind":"theorem","name":"wallisRadiusIntegrand_eq_laplace","statement":"(a : ℝ) : wallisRadiusIntegrand a = -wallisLaplaceKernel (2 * a)"},{"kind":"theorem","name":"integral_wallisRadiusIntegrand","statement":"(∫ a in Set.Ioi (0 : ℝ), wallisRadiusIntegrand a) = -(1 / 2 : ℝ) * Real.log (Real.pi / 2)"},{"kind":"theorem","name":"tendsto_limitingSaddleRadius_wallisIntegral","statement":"Tendsto limitingSaddleRadius (𝓝[>] (0 : ℝ)) (nhds (Real.sqrt (1 / (2 * Real.pi)) * Real.exp (∫ a in Set.Ioi (0 : ℝ), wallisRadiusIntegrand a)))"},{"kind":"theorem","name":"saddleRadius_wallis_constant","statement":"Real.sqrt (1 / (2 * Real.pi)) * Real.exp (-(1 / 2 : ℝ) * Real.log (Real.pi / 2)) = criticalRadius"},{"kind":"theorem","name":"tendsto_limitingSaddleRadius","statement":"Tendsto limitingSaddleRadius (𝓝[>] (0 : ℝ)) (nhds criticalRadius)"},{"kind":"theorem","name":"radialL1Mass_pos","statement":"{d : ℕ} (g : TestFunction d) (hg : g ≠ 0) : 0 < radialL1Mass g"},{"kind":"theorem","name":"integral_scaled_exp_change_Ioi","statement":"{E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] {R : ℝ} (hR : 0 < R) (f : ℝ → E) : (∫ r : ℝ in Ioi 0, f r) = ∫ v : ℝ, (R * Real.exp v) • f (R * Real.exp v)"},{"kind":"theorem","name":"integrable_scaled_exp_change_Ioi","statement":"{E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] {R : ℝ} (hR : 0 < R) (f : ℝ → E) : IntegrableOn f (Ioi 0) ↔ Integrable (fun v : ℝ => (R * Real.exp v) • f (R * Real.exp v))"},{"kind":"theorem","name":"radialL1Mass_eq","statement":"{d : ℕ} (hd : 0 < d) (g : TestFunction d) (hg : IsRadial g) : radialL1Mass g = radialSurfaceArea d * ∫ r : ℝ in Ioi 0, r ^ (d - 1) * ‖radialProfile hd g r‖"},{"kind":"theorem","name":"norm_radialProfile_eq_abs_re","statement":"{d : ℕ} (hd : 0 < d) (g : TestFunction d) (hg : IsRealValued g) (r : ℝ) : ‖radialProfile hd g r‖ = |(radialProfile hd g r).re|"},{"kind":"theorem","name":"radialProfile_re_weight_integrable","statement":"{d : ℕ} (hd : 0 < d) (g : TestFunction d) (hg : IsRadial g) : IntegrableOn (fun r : ℝ => r ^ (d - 1) * (radialProfile hd g r).re) (Ioi 0)"},{"kind":"theorem","name":"integral_radialProfile_re","statement":"{d : ℕ} (hd : 0 < d) (g : TestFunction d) (hg : IsRadial g) : (∫ x : Euclidean d, (g x).re) = radialSurfaceArea d * ∫ r : ℝ in Ioi 0, r ^ (d - 1) * (radialProfile hd g r).re"},{"kind":"theorem","name":"radialLogRadius_pow","statement":"{d : ℕ} (hd : 0 < d) (r : ℝ) : r ^ d = r * r ^ (d - 1)"},{"kind":"theorem","name":"normalizedRadialLogProfile_eq","statement":"{d : ℕ} (hd : 0 < d) (g : TestFunction d) (R v : ℝ) : normalizedRadialLogProfile hd g R v = (radialSurfaceArea d / radialL1Mass g) * ((R * Real.exp v) * ((R * Real.exp v) ^ (d - 1) * (radialProfile hd g (R * Real.exp v)).re))"},{"kind":"theorem","name":"normalizedRadialLogProfile_integrable","statement":"{d : ℕ} (hd : 0 < d) (g : TestFunction d) (hg : IsRadial g) {R : ℝ} (hR : 0 < R) : Integrable (normalizedRadialLogProfile hd g R)"},{"kind":"theorem","name":"integral_normalizedRadialLogProfile","statement":"{d : ℕ} (hd : 0 < d) (g : TestFunction d) (hg : IsRadial g) {R : ℝ} (hR : 0 < R) : (∫ v : ℝ, normalizedRadialLogProfile hd g R v) = (∫ x : Euclidean d, (g x).re) / radialL1Mass g"},{"kind":"theorem","name":"abs_normalizedRadialLogProfile","statement":"{d : ℕ} (hd : 0 < d) (g : TestFunction d) (hreal : IsRealValued g) (hnonzero : g ≠ 0) {R : ℝ} (hR : 0 < R) (v : ℝ) : |normalizedRadialLogProfile hd g R v| = (radialSurfaceArea d / radialL1Mass g) * ((R * Real.exp v) * ((R * Real.exp v) ^ (d - 1) * ‖radialProfile hd g (R * Real.exp v)‖))"},{"kind":"theorem","name":"integral_abs_normalizedRadialLogProfile","statement":"{d : ℕ} (hd : 0 < d) (g : TestFunction d) (hradial : IsRadial g) (hreal : IsRealValued g) (hnonzero : g ≠ 0) {R : ℝ} (hR : 0 < R) : (∫ v : ℝ, |normalizedRadialLogProfile hd g R v|) = 1"},{"kind":"theorem","name":"integral_re_eq_zero_of_antiFourier","statement":"{d : ℕ} (g : TestFunction d) (hanti : (𝓕 g : TestFunction d) = -g) (hzero : g (0 : Euclidean d) = 0) : (∫ x : Euclidean d, (g x).re) = 0"},{"kind":"theorem","name":"integral_normalizedRadialLogProfile_eq_zero_of_antiFourier","statement":"{d : ℕ} (hd : 0 < d) (g : TestFunction d) (hradial : IsRadial g) (hanti : (𝓕 g : TestFunction d) = -g) (hzero : g (0 : Euclidean d) = 0) {R : ℝ} (hR : 0 < R) : (∫ v : ℝ, normalizedRadialLogProfile hd g R v) = 0"},{"kind":"theorem","name":"normalizedRadialLogProfile_nonneg_of_exterior","statement":"{d : ℕ} (hd : 0 < d) (g : TestFunction d) (hnonzero : g ≠ 0) {R : ℝ} (hR : 0 < R) (houtside : ∀ x : Euclidean d, R ≤ ‖x‖ → 0 ≤ (g x).re) (v : ℝ) (hv : 0 ≤ v) : 0 ≤ normalizedRadialLogProfile hd g R v"},{"kind":"theorem","name":"antiFourierWitness_normalizedRadialLogProfile","statement":"{d : ℕ} (hd : 0 < d) {R : ℝ} (hR : 0 < R) (w : AntiFourierWitness d R) : let φ"},{"kind":"theorem","name":"radialProfile_smooth","statement":"{d : ℕ} (hd : 0 < d) (f : TestFunction d) (n : ℕ∞) : ContDiff ℝ n (radialProfile hd f)"},{"kind":"theorem","name":"radialProfile_deriv_zero","statement":"{d : ℕ} (hd : 0 < d) (f : TestFunction d) (hf : IsRadial f) : deriv (radialProfile hd f) 0 = 0"},{"kind":"theorem","name":"radialProfile_quadratic_bound","statement":"{d : ℕ} (hd : 0 < d) (f : TestFunction d) (hf : IsRadial f) (hzero : f (0 : Euclidean d) = 0) : ∃ C : ℝ, ∀ r : ℝ, 0 ≤ r → r ≤ 1 → ‖radialProfile hd f r‖ ≤ C * r ^ 2"},{"kind":"theorem","name":"radialProfile_isBigO_rpow_two_zero","statement":"{d : ℕ} (hd : 0 < d) (f : TestFunction d) (hf : IsRadial f) (hzero : f (0 : Euclidean d) = 0) : radialProfile hd f =O[𝓝[>] (0 : ℝ)] (fun r : ℝ => r ^ (2 : ℝ))"},{"kind":"theorem","name":"radialProfile_isBigO_rpow_atTop","statement":"{d : ℕ} (hd : 0 < d) (f : TestFunction d) (a : ℝ) : radialProfile hd f =O[atTop] (fun r : ℝ => r ^ (-a))"},{"kind":"theorem","name":"radialProfile_locallyIntegrableOn","statement":"{d : ℕ} (hd : 0 < d) (f : TestFunction d) : LocallyIntegrableOn (radialProfile hd f) (Ioi (0 : ℝ))"},{"kind":"theorem","name":"radialProfile_mellinConvergent","statement":"{d : ℕ} (hd : 0 < d) (f : TestFunction d) (hf : IsRadial f) (hzero : f (0 : Euclidean d) = 0) (s : ℂ) (hs : -2 < s.re) : MellinConvergent (radialProfile hd f) s"},{"kind":"theorem","name":"radialProfile_mellin_differentiableAt","statement":"{d : ℕ} (hd : 0 < d) (f : TestFunction d) (hf : IsRadial f) (hzero : f (0 : Euclidean d) = 0) (s : ℂ) (hs : -2 < s.re) : DifferentiableAt ℂ (mellin (radialProfile hd f)) s"},{"kind":"theorem","name":"radialMellinStrip_differentiableAt","statement":"{d : ℕ} (hd : 0 < d) (f : TestFunction d) (hf : IsRadial f) (hzero : f (0 : Euclidean d) = 0) (z : ℂ) (hz : -(d : ℝ) / 2 - 2 < z.im) : DifferentiableAt ℂ (radialMellinStrip hd f) z"},{"kind":"theorem","name":"radialMellinStrip_diffContOnCl","statement":"{d : ℕ} (hd : 0 < d) (f : TestFunction d) (hf : IsRadial f) (hzero : f (0 : Euclidean d) = 0) : DiffContOnCl ℂ (radialMellinStrip hd f) (Complex.im ⁻¹' Ioo (-((d : ℝ) / 2)) ((d : ℝ) / 2))"},{"kind":"theorem","name":"normalizedRadialMellinStrip_diffContOnCl","statement":"{d : ℕ} (hd : 0 < d) (f : TestFunction d) (hf : IsRadial f) (hzero : f (0 : Euclidean d) = 0) (R : ℝ) : DiffContOnCl ℂ (normalizedRadialMellinStrip hd f R) (Complex.im ⁻¹' Ioo (-((d : ℝ) / 2)) ((d : ℝ) / 2))"},{"kind":"theorem","name":"norm_nonnegative_imaginary_cpow_le_one","statement":"(r t : ℝ) (hr : 0 ≤ r) : ‖(r : ℂ) ^ (-(Complex.I * (t : ℂ)))‖ ≤ 1"},{"kind":"theorem","name":"schwartz_imaginaryRiesz_integrable","statement":"{d : ℕ} (hd : 0 < d) (f : TestFunction d) (t : ℝ) : Integrable (fun x : Euclidean d => f x * (‖x‖ : ℂ) ^ (-(Complex.I * (t : ℂ))))"},{"kind":"theorem","name":"norm_schwartz_imaginaryRiesz_integral_le_L1","statement":"{d : ℕ} (hd : 0 < d) (f : TestFunction d) (t : ℝ) : ‖∫ x : Euclidean d, f x * (‖x‖ : ℂ) ^ (-(Complex.I * (t : ℂ)))‖ ≤ radialL1Mass f"},{"kind":"theorem","name":"normalizedRadialMellinStrip_top_norm_le_one","statement":"{d : ℕ} (hd : 0 < d) (f : TestFunction d) (hf : IsRadial f) (hnonzero : f ≠ 0) (R : ℝ) (y : ℝ) : ‖normalizedRadialMellinStrip hd f R ((y : ℂ) + Complex.I * (((d : ℝ) / 2 : ℝ) : ℂ))‖ ≤ 1"},{"kind":"theorem","name":"radial_fourier_mellin_regularized_closed","statement":"{d : ℕ} (hd : 0 < d) (f : TestFunction d) (hf : IsRadial f) (hzero : f (0 : Euclidean d) = 0) (hhatZero : (𝓕 f : TestFunction d) (0 : Euclidean d) = 0) (s : ℂ) (hs : 0 ≤ s.re) (hsd : s.re ≤ (d : ℝ)) : mellin (radialProfile hd (𝓕 f : TestFunction d)) s * (Complex.Gamma (s / 2))⁻¹ = (Real.pi : ℂ) ^ ((d : ℂ) / 2 - s) * (mellin (radialProfile hd f) ((d : ℂ) - s) * (Complex.Gamma (((d : ℂ) - s) / 2))⁻¹)"},{"kind":"theorem","name":"radial_fourier_mellin_antifourier_boundary","statement":"{d : ℕ} (hd : 0 < d) (f : TestFunction d) (hf : IsRadial f) (hzero : f (0 : Euclidean d) = 0) (hanti : (𝓕 f : TestFunction d) = -f) (y : ℝ) (hy : y ≠ 0) : Complex.Gamma (((d : ℝ) / 2 : ℝ) + Complex.I * (y : ℂ) / 2) * mellin (radialProfile hd f) (-(Complex.I * (y : ℂ))) = -((Real.pi : ℂ) ^ (((d : ℂ) / 2) + Complex.I * (y : ℂ)) * Complex.Gamma (-(Complex.I * (y : ℂ)) / 2) * mellin (radialProfile hd f) ((d : ℂ) + Complex.I * (y : ℂ)))"},{"kind":"theorem","name":"radial_fourier_mellin_antifourier_boundary_norm","statement":"{d : ℕ} (hd : 0 < d) (f : TestFunction d) (hf : IsRadial f) (hzero : f (0 : Euclidean d) = 0) (hanti : (𝓕 f : TestFunction d) = -f) (y : ℝ) (hy : y ≠ 0) : ‖mellin (radialProfile hd f) (-(Complex.I * (y : ℂ)))‖ = Real.pi ^ ((d : ℝ) / 2) * (‖Complex.Gamma (-(Complex.I * (y : ℂ)) / 2)‖ / ‖Complex.Gamma (((d : ℝ) / 2 : ℝ) + Complex.I * (y : ℂ) / 2)‖) * ‖mellin (radialProfile hd f) ((d : ℂ) + Complex.I * (y : ℂ))‖"},{"kind":"theorem","name":"normalizedRadialMellinStrip_top_norm_eq","statement":"{d : ℕ} (hd : 0 < d) (f : TestFunction d) (hnonzero : f ≠ 0) (R : ℝ) (y : ℝ) : ‖normalizedRadialMellinStrip hd f R ((y : ℂ) + Complex.I * (((d : ℝ) / 2 : ℝ) : ℂ))‖ = (radialSurfaceArea d / radialL1Mass f) * ‖mellin (radialProfile hd f) ((d : ℂ) - Complex.I * (y : ℂ))‖"},{"kind":"theorem","name":"normalizedRadialMellinStrip_bottom_norm_eq","statement":"{d : ℕ} (hd : 0 < d) (f : TestFunction d) (hnonzero : f ≠ 0) (R : ℝ) (y : ℝ) : ‖normalizedRadialMellinStrip hd f R ((y : ℂ) - Complex.I * (((d : ℝ) / 2 : ℝ) : ℂ))‖ = (radialSurfaceArea d / radialL1Mass f) * Real.exp ((d : ℝ) * Real.log R) * ‖mellin (radialProfile hd f) (-(Complex.I * (y : ℂ)))‖"},{"kind":"theorem","name":"radialGammaBoundaryExponent_exp","statement":"(d : ℕ) (R A B : ℝ) (hR : 0 < R) (hA : 0 < A) (hB : 0 < B) : Real.exp (((d : ℝ) / 2) * Real.log (Real.pi * R ^ 2) + Real.log A - Real.log B) = Real.exp ((d : ℝ) * Real.log R) * Real.pi ^ ((d : ℝ) / 2) * (A / B)"},{"kind":"theorem","name":"normalizedRadialMellinStrip_bottom_norm_le_gamma","statement":"{d : ℕ} (hd : 0 < d) (f : TestFunction d) (hf : IsRadial f) (hzero : f (0 : Euclidean d) = 0) (hanti : (𝓕 f : TestFunction d) = -f) (hnonzero : f ≠ 0) (R : ℝ) (hR : 0 < R) (y : ℝ) (hy : y ≠ 0) : ‖normalizedRadialMellinStrip hd f R ((y : ℂ) - Complex.I * (((d : ℝ) / 2 : ℝ) : ℂ))‖ ≤ Real.exp (((d : ℝ) / 2) * Real.log (Real.pi * R ^ 2) + Real.log ‖Complex.Gamma (-Complex.I * (y : ℂ) / 2)‖ - Real.log ‖Complex.Gamma (((d : ℝ) / 2 : ℝ) + Complex.I * (y : ℂ) / 2)‖)"},{"kind":"theorem","name":"radialProfile_mellin_uniform_strip_bound","statement":"{d : ℕ} (hd : 0 < d) (f : TestFunction d) (hf : IsRadial f) (hzero : f (0 : Euclidean d) = 0) : ∃ C : ℝ, 0 ≤ C ∧ ∀ s : ℂ, 0 ≤ s.re → s.re ≤ (d : ℝ) → ‖mellin (radialProfile hd f) s‖ ≤ C"},{"kind":"theorem","name":"normalizedRadialMellinStrip_uniform_bound","statement":"{d : ℕ} (hd : 0 < d) (f : TestFunction d) (hf : IsRadial f) (hzero : f (0 : Euclidean d) = 0) (R : ℝ) : ∃ C : ℝ, 0 ≤ C ∧ ∀ z : ℂ, -((d : ℝ) / 2) ≤ z.im → z.im ≤ (d : ℝ) / 2 → ‖normalizedRadialMellinStrip hd f R z‖ ≤ C"},{"kind":"theorem","name":"normalizedRadialLogProfile_ofReal","statement":"{d : ℕ} (hd : 0 < d) (f : TestFunction d) (hreal : IsRealValued f) (R v : ℝ) : (normalizedRadialLogProfile hd f R v : ℂ) = ((radialSurfaceArea d / radialL1Mass f : ℝ) : ℂ) * (((R * Real.exp v) ^ d : ℝ) : ℂ) * radialProfile hd f (R * Real.exp v)"},{"kind":"theorem","name":"normalizedRadialLogProfile_weighted_ofReal","statement":"{d : ℕ} (hd : 0 < d) (f : TestFunction d) (hreal : IsRealValued f) (R a v : ℝ) : (Real.exp (-a * v) : ℂ) * (normalizedRadialLogProfile hd f R v : ℂ) = ((radialSurfaceArea d / radialL1Mass f * R ^ d : ℝ) : ℂ) * (Real.exp (((d : ℝ) - a) * v) : ℂ) * radialProfile hd f (R * Real.exp v)"},{"kind":"theorem","name":"normalizedRadialMellinStrip_shifted_eq_fourier","statement":"{d : ℕ} (hd : 0 < d) (f : TestFunction d) (hreal : IsRealValued f) (R : ℝ) (hR : 0 < R) (a t : ℝ) : normalizedRadialMellinStrip hd f R ((t : ℂ) + Complex.I * ((((d : ℝ) / 2 - a : ℝ) : ℂ))) = (𝓕 (fun v : ℝ => (Real.exp (-a * v) : ℂ) * (normalizedRadialLogProfile hd f R v : ℂ)) : ℝ → ℂ) (t / (2 * Real.pi))"},{"kind":"theorem","name":"normalizedRadialLogProfile_weighted_integrable","statement":"{d : ℕ} (hd : 0 < d) (f : TestFunction d) (hf : IsRadial f) (hreal : IsRealValued f) (hzero : f (0 : Euclidean d) = 0) {R : ℝ} (hR : 0 < R) {a : ℝ} (ha : a < (d : ℝ) + 2) : Integrable (fun v : ℝ => (Real.exp (-a * v) : ℂ) * (normalizedRadialLogProfile hd f R v : ℂ))"},{"kind":"theorem","name":"integrable_fourier_of_integrable_two_derivatives","statement":"(g : ℝ → ℂ) (hg : Integrable g) (hgdiff : Differentiable ℝ g) (hg' : Integrable (deriv g)) (hg'diff : Differentiable ℝ (deriv g)) (hg'' : Integrable (deriv (deriv g))) : Integrable (𝓕 g : ℝ → ℂ)"},{"kind":"theorem","name":"schwartzRealLine_mellinConvergent_of_re_pos","statement":"(g : 𝓢(ℝ, ℂ)) (s : ℂ) (hs : 0 < s.re) : MellinConvergent (g : ℝ → ℂ) s"},{"kind":"theorem","name":"schwartzExponentialTilt_integrable","statement":"(g : 𝓢(ℝ, ℂ)) {κ R : ℝ} (hκ : 0 < κ) (hR : 0 < R) : Integrable (schwartzExponentialTilt g κ R)"},{"kind":"theorem","name":"schwartzExponentialTilt_differentiable","statement":"(g : 𝓢(ℝ, ℂ)) (κ R : ℝ) : Differentiable ℝ (schwartzExponentialTilt g κ R)"},{"kind":"theorem","name":"schwartzExponentialTilt_deriv","statement":"(g : 𝓢(ℝ, ℂ)) (κ R v : ℝ) : deriv (schwartzExponentialTilt g κ R) v = (κ : ℂ) * schwartzExponentialTilt g κ R v + (R : ℂ) * schwartzExponentialTilt ((SchwartzMap.derivCLM ℂ ℂ) g) (κ + 1) R v"},{"kind":"theorem","name":"schwartzExponentialTilt_deriv_integrable","statement":"(g : 𝓢(ℝ, ℂ)) {κ R : ℝ} (hκ : 0 < κ) (hR : 0 < R) : Integrable (deriv (schwartzExponentialTilt g κ R))"},{"kind":"theorem","name":"schwartzExponentialTilt_deriv_deriv","statement":"(g : 𝓢(ℝ, ℂ)) (κ R v : ℝ) : deriv (deriv (schwartzExponentialTilt g κ R)) v = (κ : ℂ) * deriv (schwartzExponentialTilt g κ R) v + (R : ℂ) * deriv (schwartzExponentialTilt ((SchwartzMap.derivCLM ℂ ℂ) g) (κ + 1) R) v"},{"kind":"theorem","name":"schwartzExponentialTilt_deriv_deriv_integrable","statement":"(g : 𝓢(ℝ, ℂ)) {κ R : ℝ} (hκ : 0 < κ) (hR : 0 < R) : Integrable (deriv (deriv (schwartzExponentialTilt g κ R)))"},{"kind":"theorem","name":"schwartzExponentialTilt_deriv_differentiable","statement":"(g : 𝓢(ℝ, ℂ)) (κ R : ℝ) : Differentiable ℝ (deriv (schwartzExponentialTilt g κ R))"},{"kind":"theorem","name":"schwartzExponentialTilt_fourier_integrable","statement":"(g : 𝓢(ℝ, ℂ)) {κ R : ℝ} (hκ : 0 < κ) (hR : 0 < R) : Integrable (𝓕 (schwartzExponentialTilt g κ R) : ℝ → ℂ)"},{"kind":"theorem","name":"normalizedRadialLogProfile_weighted_fourier_integrable","statement":"{d : ℕ} (hd : 0 < d) (f : TestFunction d) (hreal : IsRealValued f) {R : ℝ} (hR : 0 < R) {a : ℝ} (ha : a < (d : ℝ)) : Integrable (𝓕 (fun v : ℝ => (Real.exp (-a * v) : ℂ) * (normalizedRadialLogProfile hd f R v : ℂ)) : ℝ → ℂ)"},{"kind":"theorem","name":"normalizedRadialMellinStrip_shifted_integrable","statement":"{d : ℕ} (hd : 0 < d) (f : TestFunction d) (hreal : IsRealValued f) {R : ℝ} (hR : 0 < R) {a : ℝ} (ha : a < (d : ℝ)) : Integrable (fun t : ℝ => normalizedRadialMellinStrip hd f R ((t : ℂ) + Complex.I * ((((d : ℝ) / 2 - a : ℝ) : ℂ))))"},{"kind":"theorem","name":"normalizedRadialMellinStrip_shifted_fourier_inversion","statement":"{d : ℕ} (hd : 0 < d) (f : TestFunction d) (hf : IsRadial f) (hreal : IsRealValued f) (hzero : f (0 : Euclidean d) = 0) {R : ℝ} (hR : 0 < R) {a : ℝ} (ha : a < (d : ℝ)) (v : ℝ) : (normalizedRadialLogProfile hd f R v : ℂ) = (Real.exp (a * v) : ℂ) * ((𝓕⁻ (fun ξ : ℝ => normalizedRadialMellinStrip hd f R (((2 * Real.pi * ξ : ℝ) : ℂ) + Complex.I * ((((d : ℝ) / 2 - a : ℝ) : ℂ)))) : ℝ → ℂ) v)"},{"kind":"theorem","name":"stripAngle_mem_Ioo","statement":"{σ : ℝ} (hbelow : -1 < σ) (habove : σ < 1) : 0 < stripAngle σ ∧ stripAngle σ < Real.pi"},{"kind":"theorem","name":"stripBottomMass_pos","statement":"{σ : ℝ} (hσ : σ < 1) : 0 < stripBottomMass σ"},{"kind":"theorem","name":"stripBottomMass_lt_one","statement":"{σ : ℝ} (hσ : -1 < σ) : stripBottomMass σ < 1"},{"kind":"theorem","name":"stripPoissonKernel_pos","statement":"{σ : ℝ} (hbelow : -1 < σ) (habove : σ < 1) (T : ℝ) : 0 < stripPoissonKernel σ T"},{"kind":"theorem","name":"stripPoissonKernel_neg","statement":"(σ T : ℝ) : stripPoissonKernel σ (-T) = stripPoissonKernel σ T"},{"kind":"theorem","name":"stripPoissonKernel_abs","statement":"(σ T : ℝ) : stripPoissonKernel σ |T| = stripPoissonKernel σ T"},{"kind":"theorem","name":"stripPoissonPrimitive_hasDerivAt","statement":"{σ : ℝ} (hbelow : -1 < σ) (habove : σ < 1) (T : ℝ) : HasDerivAt (stripPoissonPrimitive σ) (stripPoissonKernel σ T) T"},{"kind":"theorem","name":"stripPoissonPrimitive_zero","statement":"{σ : ℝ} (hbelow : -1 < σ) (habove : σ < 1) : stripPoissonPrimitive σ 0 = stripAngle σ / (2 * Real.pi)"},{"kind":"theorem","name":"stripPoissonPrimitive_tendsto_atTop","statement":"{σ : ℝ} (hbelow : -1 < σ) (habove : σ < 1) : Tendsto (stripPoissonPrimitive σ) atTop (nhds (1 / 2 : ℝ))"},{"kind":"theorem","name":"stripPoissonKernel_integrableOn_Ioi","statement":"{σ : ℝ} (hbelow : -1 < σ) (habove : σ < 1) : IntegrableOn (stripPoissonKernel σ) (Ioi (0 : ℝ))"},{"kind":"theorem","name":"stripPoissonKernel_integral_Ioi","statement":"{σ : ℝ} (hbelow : -1 < σ) (habove : σ < 1) : (∫ T in Ioi (0 : ℝ), stripPoissonKernel σ T) = 1 / 2 - stripAngle σ / (2 * Real.pi)"},{"kind":"theorem","name":"stripPoissonKernel_integrable","statement":"{σ : ℝ} (hbelow : -1 < σ) (habove : σ < 1) : Integrable (stripPoissonKernel σ)"},{"kind":"theorem","name":"integral_stripPoissonKernel","statement":"{σ : ℝ} (hbelow : -1 < σ) (habove : σ < 1) : (∫ T : ℝ, stripPoissonKernel σ T) = stripBottomMass σ"},{"kind":"theorem","name":"stripPoissonKernel_antitone_abs","statement":"{σ : ℝ} (hbelow : -1 < σ) (habove : σ < 1) {x y : ℝ} (hxy : |x| ≤ |y|) : stripPoissonKernel σ y ≤ stripPoissonKernel σ x"},{"kind":"theorem","name":"stripPoissonPrimitive_centered_hasDerivAt","statement":"{σ : ℝ} (hbelow : -1 < σ) (habove : σ < 1) (r x : ℝ) : HasDerivAt (fun s : ℝ => stripPoissonPrimitive σ (s + r) - stripPoissonPrimitive σ (s - r)) (stripPoissonKernel σ (x + r) - stripPoissonKernel σ (x - r)) x"},{"kind":"theorem","name":"stripPoissonPrimitive_centered_antitoneOn","statement":"{σ : ℝ} (hbelow : -1 < σ) (habove : σ < 1) {r : ℝ} (hr : 0 ≤ r) : AntitoneOn (fun s : ℝ => stripPoissonPrimitive σ (s + r) - stripPoissonPrimitive σ (s - r)) (Ici (0 : ℝ))"},{"kind":"theorem","name":"intervalIntegral_stripPoissonKernel","statement":"{σ : ℝ} (hbelow : -1 < σ) (habove : σ < 1) (a b : ℝ) : (∫ x in a..b, stripPoissonKernel σ x) = stripPoissonPrimitive σ b - stripPoissonPrimitive σ a"},{"kind":"theorem","name":"stripPoissonPrimitive_centered_neg","statement":"{σ : ℝ} (hbelow : -1 < σ) (habove : σ < 1) (r s : ℝ) : stripPoissonPrimitive σ (-s + r) - stripPoissonPrimitive σ (-s - r) = stripPoissonPrimitive σ (s + r) - stripPoissonPrimitive σ (s - r)"},{"kind":"theorem","name":"stripPoissonPrimitive_centered_le","statement":"{σ : ℝ} (hbelow : -1 < σ) (habove : σ < 1) {r : ℝ} (hr : 0 ≤ r) (s : ℝ) : stripPoissonPrimitive σ (s + r) - stripPoissonPrimitive σ (s - r) ≤ stripPoissonPrimitive σ r - stripPoissonPrimitive σ (-r)"},{"kind":"theorem","name":"stripPoissonKernel_centered_interval_max","statement":"{σ : ℝ} (hbelow : -1 < σ) (habove : σ < 1) {r : ℝ} (hr : 0 ≤ r) (s : ℝ) : (∫ x in Icc (s - r) (s + r), stripPoissonKernel σ x) ≤ ∫ x in Icc (-r) r, stripPoissonKernel σ x"},{"kind":"theorem","name":"stripComplexPoissonKernel_re","statement":"{σ : ℝ} (hbelow : -1 < σ) (habove : σ < 1) (T : ℝ) : (stripComplexPoissonKernel σ T).re = stripPoissonKernel σ T"},{"kind":"theorem","name":"stripSchwarzExponential_continuous","statement":"(ℓ : ℝ) (z : ℂ) : Continuous (fun y : ℝ => stripSchwarzExponential ℓ z y)"},{"kind":"theorem","name":"stripSchwarzExponential_hasDerivAt","statement":"(ℓ : ℝ) (z : ℂ) (y : ℝ) : HasDerivAt (fun w : ℂ => stripSchwarzExponential ℓ w y) (stripSchwarzExponential ℓ z y * ((Real.pi : ℂ) / (2 * (ℓ : ℂ)))) z"},{"kind":"theorem","name":"norm_stripSchwarzExponential","statement":"(ℓ : ℝ) (z : ℂ) (y : ℝ) : ‖stripSchwarzExponential ℓ z y‖ = Real.exp (Real.pi * (z.re - y) / (2 * ℓ))"},{"kind":"theorem","name":"stripSchwarzExponential_re","statement":"(ℓ : ℝ) (z : ℂ) (y : ℝ) : (stripSchwarzExponential ℓ z y).re = Real.exp (Real.pi * (z.re - y) / (2 * ℓ)) * Real.cos (Real.pi * (z.im + ℓ) / (2 * ℓ))"},{"kind":"theorem","name":"stripSchwarzExponential_im","statement":"(ℓ : ℝ) (z : ℂ) (y : ℝ) : (stripSchwarzExponential ℓ z y).im = Real.exp (Real.pi * (z.re - y) / (2 * ℓ)) * Real.sin (Real.pi * (z.im + ℓ) / (2 * ℓ))"},{"kind":"theorem","name":"stripSchwarzAngle_mem_Ioo","statement":"{ℓ : ℝ} (hℓ : 0 < ℓ) {z : ℂ} (hz : z ∈ Complex.im ⁻¹' Ioo (-ℓ) ℓ) : 0 < Real.pi * (z.im + ℓ) / (2 * ℓ) ∧ Real.pi * (z.im + ℓ) / (2 * ℓ) < Real.pi"},{"kind":"theorem","name":"stripSchwarzExponential_sub_one_norm_ge_sin","statement":"{ℓ : ℝ} (hℓ : 0 < ℓ) {z : ℂ} (hz : z ∈ Complex.im ⁻¹' Ioo (-ℓ) ℓ) (y : ℝ) : Real.sin (Real.pi * (z.im + ℓ) / (2 * ℓ)) ≤ ‖stripSchwarzExponential ℓ z y - 1‖"},{"kind":"theorem","name":"stripSchwarzExponential_sub_one_norm_ge_exp_mul_sin","statement":"{ℓ : ℝ} (hℓ : 0 < ℓ) {z : ℂ} (hz : z ∈ Complex.im ⁻¹' Ioo (-ℓ) ℓ) (y : ℝ) : Real.exp (Real.pi * (z.re - y) / (2 * ℓ)) * Real.sin (Real.pi * (z.im + ℓ) / (2 * ℓ)) ≤ ‖stripSchwarzExponential ℓ z y - 1‖"},{"kind":"theorem","name":"stripHolomorphicPoissonKernel_denominator_ne_zero","statement":"{ℓ : ℝ} (hℓ : 0 < ℓ) {z : ℂ} (hz : z ∈ Complex.im ⁻¹' Ioo (-ℓ) ℓ) (y : ℝ) : Complex.exp (((Real.pi : ℂ) * (z - (y : ℂ) + Complex.I * (ℓ : ℂ))) / (2 * (ℓ : ℂ))) - 1 ≠ 0"},{"kind":"theorem","name":"stripHolomorphicPoissonKernel_eq_scaled","statement":"{ℓ : ℝ} (hℓ : 0 < ℓ) (σ s y : ℝ) : stripHolomorphicPoissonKernel ℓ ((s : ℂ) + Complex.I * ((σ * ℓ : ℝ) : ℂ)) y = stripComplexPoissonKernel σ ((s - y) / ℓ) / (ℓ : ℂ)"},{"kind":"theorem","name":"stripHolomorphicPoissonKernel_re","statement":"{ℓ σ : ℝ} (hℓ : 0 < ℓ) (hbelow : -1 < σ) (habove : σ < 1) (s y : ℝ) : (stripHolomorphicPoissonKernel ℓ ((s : ℂ) + Complex.I * ((σ * ℓ : ℝ) : ℂ)) y).re = stripPoissonKernel σ ((s - y) / ℓ) / ℓ"},{"kind":"theorem","name":"stripRegularizedHolomorphicPoissonKernel_hasDerivAt","statement":"{ℓ : ℝ} (hℓ : 0 < ℓ) {z : ℂ} (hz : z ∈ Complex.im ⁻¹' Ioo (-ℓ) ℓ) (y : ℝ) : HasDerivAt (fun w : ℂ => stripRegularizedHolomorphicPoissonKernel ℓ w y) (-(Complex.I * (Real.pi : ℂ) * stripSchwarzExponential ℓ z y) / (4 * (ℓ : ℂ) ^ 2 * (stripSchwarzExponential ℓ z y - 1) ^ 2)) z"},{"kind":"theorem","name":"stripRegularizedHolomorphicPoissonKernel_hasDerivAt_deriv","statement":"{ℓ : ℝ} (hℓ : 0 < ℓ) {z : ℂ} (hz : z ∈ Complex.im ⁻¹' Ioo (-ℓ) ℓ) (y : ℝ) : HasDerivAt (fun w : ℂ => stripRegularizedHolomorphicPoissonKernel ℓ w y) (stripRegularizedHolomorphicPoissonKernelDeriv ℓ z y) z"},{"kind":"theorem","name":"norm_stripRegularizedHolomorphicPoissonKernelDeriv_pos","statement":"{ℓ : ℝ} (hℓ : 0 < ℓ) {z : ℂ} (hz : z ∈ Complex.im ⁻¹' Ioo (-ℓ) ℓ) (y : ℝ) : ‖stripRegularizedHolomorphicPoissonKernelDeriv ℓ z y‖ ≤ Real.pi * Real.exp (Real.pi * (z.re - y) / (2 * ℓ)) / (4 * ℓ ^ 2 * Real.sin (Real.pi * (z.im + ℓ) / (2 * ℓ)) ^ 2)"},{"kind":"theorem","name":"norm_stripRegularizedHolomorphicPoissonKernelDeriv_neg","statement":"{ℓ : ℝ} (hℓ : 0 < ℓ) {z : ℂ} (hz : z ∈ Complex.im ⁻¹' Ioo (-ℓ) ℓ) (y : ℝ) : ‖stripRegularizedHolomorphicPoissonKernelDeriv ℓ z y‖ ≤ Real.pi * Real.exp (-(Real.pi * (z.re - y) / (2 * ℓ))) / (4 * ℓ ^ 2 * Real.sin (Real.pi * (z.im + ℓ) / (2 * ℓ)) ^ 2)"},{"kind":"theorem","name":"stripRegularizedHolomorphicPoissonKernelDeriv_continuous","statement":"{ℓ : ℝ} (hℓ : 0 < ℓ) {z : ℂ} (hz : z ∈ Complex.im ⁻¹' Ioo (-ℓ) ℓ) : Continuous (fun y : ℝ => stripRegularizedHolomorphicPoissonKernelDeriv ℓ z y)"},{"kind":"theorem","name":"stripRegularizedHolomorphicPoissonKernelDeriv_local_bound","statement":"{ℓ : ℝ} (hℓ : 0 < ℓ) {z : ℂ} (hz : z ∈ Complex.im ⁻¹' Ioo (-ℓ) ℓ) : ∃ S ∈ 𝓝 z, ∃ C : ℝ, 0 ≤ C ∧ ∀ w ∈ S, ∀ y : ℝ, ‖stripRegularizedHolomorphicPoissonKernelDeriv ℓ w y‖ ≤ C * Real.exp (-(Real.pi / (2 * ℓ)) * |y|)"},{"kind":"theorem","name":"stripRegularizedHolomorphicPoissonKernel_of_nonneg","statement":"{ℓ : ℝ} (hℓ : 0 < ℓ) {z : ℂ} (hz : z ∈ Complex.im ⁻¹' Ioo (-ℓ) ℓ) {y : ℝ} (hy : 0 ≤ y) : stripRegularizedHolomorphicPoissonKernel ℓ z y = Complex.I * stripSchwarzExponential ℓ z y / (2 * (ℓ : ℂ) * (stripSchwarzExponential ℓ z y - 1))"},{"kind":"theorem","name":"stripRegularizedHolomorphicPoissonKernel_of_neg","statement":"{ℓ : ℝ} (hℓ : 0 < ℓ) {z : ℂ} (hz : z ∈ Complex.im ⁻¹' Ioo (-ℓ) ℓ) {y : ℝ} (hy : y < 0) : stripRegularizedHolomorphicPoissonKernel ℓ z y = Complex.I / (2 * (ℓ : ℂ) * (stripSchwarzExponential ℓ z y - 1))"},{"kind":"theorem","name":"norm_stripRegularizedHolomorphicPoissonKernel_of_nonneg","statement":"{ℓ : ℝ} (hℓ : 0 < ℓ) {z : ℂ} (hz : z ∈ Complex.im ⁻¹' Ioo (-ℓ) ℓ) {y : ℝ} (hy : 0 ≤ y) : ‖stripRegularizedHolomorphicPoissonKernel ℓ z y‖ ≤ Real.exp (Real.pi * (z.re - y) / (2 * ℓ)) / (2 * ℓ * Real.sin (Real.pi * (z.im + ℓ) / (2 * ℓ)))"},{"kind":"theorem","name":"norm_stripRegularizedHolomorphicPoissonKernel_of_neg","statement":"{ℓ : ℝ} (hℓ : 0 < ℓ) {z : ℂ} (hz : z ∈ Complex.im ⁻¹' Ioo (-ℓ) ℓ) {y : ℝ} (hy : y < 0) : ‖stripRegularizedHolomorphicPoissonKernel ℓ z y‖ ≤ Real.exp (-(Real.pi * (z.re - y) / (2 * ℓ))) / (2 * ℓ * Real.sin (Real.pi * (z.im + ℓ) / (2 * ℓ)))"},{"kind":"theorem","name":"stripRegularizedHolomorphicPoissonKernel_continuousOn_Ioi","statement":"{ℓ : ℝ} (hℓ : 0 < ℓ) {z : ℂ} (hz : z ∈ Complex.im ⁻¹' Ioo (-ℓ) ℓ) : ContinuousOn (fun y : ℝ => stripRegularizedHolomorphicPoissonKernel ℓ z y) (Ioi (0 : ℝ))"},{"kind":"theorem","name":"stripRegularizedHolomorphicPoissonKernel_continuousOn_Iio","statement":"{ℓ : ℝ} (hℓ : 0 < ℓ) {z : ℂ} (hz : z ∈ Complex.im ⁻¹' Ioo (-ℓ) ℓ) : ContinuousOn (fun y : ℝ => stripRegularizedHolomorphicPoissonKernel ℓ z y) (Iio (0 : ℝ))"},{"kind":"theorem","name":"strip_exp_abs_integrable","statement":"{a : ℝ} (ha : 0 < a) : Integrable (fun y : ℝ => Real.exp ((-a) * |y|))"},{"kind":"theorem","name":"strip_abs_log_le_add_rpow","statement":"{x : ℝ} (hx : 0 < x) : |Real.log x| ≤ x + 2 * x ^ (-(1 / 2 : ℝ))"},{"kind":"theorem","name":"strip_exp_abs_log_integrableOn_Ioi","statement":"{a : ℝ} (ha : 0 < a) : IntegrableOn (fun x : ℝ => Real.exp ((-a) * x) * |Real.log x|) (Ioi (0 : ℝ))"},{"kind":"theorem","name":"strip_exp_abs_log_integrableOn_Iio","statement":"{a : ℝ} (ha : 0 < a) : IntegrableOn (fun x : ℝ => Real.exp (a * x) * |Real.log (-x)|) (Iio (0 : ℝ))"},{"kind":"theorem","name":"strip_exp_abs_log_abs_integrable","statement":"{a : ℝ} (ha : 0 < a) : Integrable (fun x : ℝ => Real.exp ((-a) * |x|) * |Real.log (|x|)|)"},{"kind":"theorem","name":"stripRegularizedHolomorphicPoissonKernel_re","statement":"{ℓ σ : ℝ} (hℓ : 0 < ℓ) (hbelow : -1 < σ) (habove : σ < 1) (s y : ℝ) : (stripRegularizedHolomorphicPoissonKernel ℓ ((s : ℂ) + Complex.I * ((σ * ℓ : ℝ) : ℂ)) y).re = stripPoissonKernel σ ((s - y) / ℓ) / ℓ"},{"kind":"theorem","name":"profileNegativePart_integrable","statement":"{φ : ℝ → ℝ} (hφ : Integrable φ) : Integrable (profileNegativePart φ)"},{"kind":"theorem","name":"abs_sub_eq_two_profileNegativePart","statement":"(φ : ℝ → ℝ) (v : ℝ) : |φ v| - φ v = 2 * profileNegativePart φ v"},{"kind":"theorem","name":"integral_profileNegativePart_eq_half","statement":"{φ : ℝ → ℝ} (hφ : Integrable φ) (hmean : (∫ v : ℝ, φ v) = 0) (hmass : (∫ v : ℝ, |φ v|) = 1) : (∫ v : ℝ, profileNegativePart φ v) = (1 / 2 : ℝ)"},{"kind":"theorem","name":"profileNegativePart_setIntegral_Iic_eq_integral","statement":"{φ : ℝ → ℝ} (hsign : ∀ v : ℝ, 0 ≤ v → 0 ≤ φ v) : (∫ v in Iic (0 : ℝ), profileNegativePart φ v) = ∫ v : ℝ, profileNegativePart φ v"},{"kind":"theorem","name":"normalizedProfile_negativeHalfline_mass_ge_half","statement":"{φ : ℝ → ℝ} (hφ : Integrable φ) (hmean : (∫ v : ℝ, φ v) = 0) (hmass : (∫ v : ℝ, |φ v|) = 1) (hsign : ∀ v : ℝ, 0 ≤ v → 0 ≤ φ v) : (1 / 2 : ℝ) ≤ ∫ v in Iic (0 : ℝ), |φ v|"},{"kind":"theorem","name":"normalizedProfile_negativeHalfline_le_of_exp_majorant","statement":"{φ : ℝ → ℝ} (hφ : Integrable φ) {a B : ℝ} (ha : 0 < a) (hbound : ∀ v : ℝ, v ≤ 0 → |φ v| ≤ B * Real.exp (a * v)) : (∫ v in Iic (0 : ℝ), |φ v|) ≤ B / a"},{"kind":"theorem","name":"norm_fourierInv_le_integral_norm","statement":"(F : ℝ → ℂ) (v : ℝ) : ‖((𝓕⁻ F : ℝ → ℂ) v)‖ ≤ ∫ s : ℝ, ‖F s‖"},{"kind":"theorem","name":"norm_scaled_fourierInv_le_integral_norm","statement":"(Z : ℝ → ℂ) (v : ℝ) : ‖((𝓕⁻ (fun ξ : ℝ => Z (2 * Real.pi * ξ)) : ℝ → ℂ) v)‖ ≤ (2 * Real.pi)⁻¹ * ∫ s : ℝ, ‖Z s‖"},{"kind":"theorem","name":"negativeHalfline_le_of_fourierInversion","statement":"{φ : ℝ → ℝ} (hφ : Integrable φ) {a : ℝ} (ha : 0 < a) (Z : ℝ → ℂ) (hinversion : ∀ v : ℝ, (φ v : ℂ) = (Real.exp (a * v) : ℂ) * ((𝓕⁻ (fun ξ : ℝ => Z (2 * Real.pi * ξ)) : ℝ → ℂ) v)) : (∫ v in Iic (0 : ℝ), |φ v|) ≤ ((2 * Real.pi)⁻¹ * ∫ s : ℝ, ‖Z s‖) / a"},{"kind":"theorem","name":"no_normalizedProfile_of_fourierInversion_lt_half","statement":"{φ : ℝ → ℝ} (hφ : Integrable φ) (hmean : (∫ v : ℝ, φ v) = 0) (hmass : (∫ v : ℝ, |φ v|) = 1) (hsign : ∀ v : ℝ, 0 ≤ v → 0 ≤ φ v) {a : ℝ} (ha : 0 < a) (Z : ℝ → ℂ) (hinversion : ∀ v : ℝ, (φ v : ℂ) = (Real.exp (a * v) : ℂ) * ((𝓕⁻ (fun ξ : ℝ => Z (2 * Real.pi * ξ)) : ℝ → ℂ) v)) (hsmall : ((2 * Real.pi)⁻¹ * ∫ s : ℝ, ‖Z s‖) / a < (1 / 2 : ℝ)) : False"},{"kind":"theorem","name":"no_antiFourierWitness_of_fourierInversion_lt_half","statement":"{d : ℕ} (hd : 0 < d) {R : ℝ} (hR : 0 < R) (w : AntiFourierWitness d R) {a : ℝ} (ha : 0 < a) (Z : ℝ → ℂ) (hinversion : ∀ v : ℝ, (normalizedRadialLogProfile hd w.function R v : ℂ) = (Real.exp (a * v) : ℂ) * ((𝓕⁻ (fun ξ : ℝ => Z (2 * Real.pi * ξ)) : ℝ → ℂ) v)) (hsmall : ((2 * Real.pi)⁻¹ * ∫ s : ℝ, ‖Z s‖) / a < (1 / 2 : ℝ)) : False"},{"kind":"theorem","name":"antiFourierWitness_normalizedMellinStrip_diffContOnCl","statement":"{d : ℕ} (hd : 0 < d) {R : ℝ} (w : AntiFourierWitness d R) : DiffContOnCl ℂ (normalizedRadialMellinStrip hd w.function R) (Complex.im ⁻¹' Ioo (-((d : ℝ) / 2)) ((d : ℝ) / 2))"},{"kind":"theorem","name":"antiFourierWitness_normalizedMellinStrip_top_norm_le_one","statement":"{d : ℕ} (hd : 0 < d) {R : ℝ} (w : AntiFourierWitness d R) (y : ℝ) : ‖normalizedRadialMellinStrip hd w.function R ((y : ℂ) + Complex.I * (((d : ℝ) / 2 : ℝ) : ℂ))‖ ≤ 1"},{"kind":"theorem","name":"antiFourierWitness_normalizedMellinStrip_uniform_bound","statement":"{d : ℕ} (hd : 0 < d) {R : ℝ} (w : AntiFourierWitness d R) : ∃ C : ℝ, 0 ≤ C ∧ ∀ z : ℂ, -((d : ℝ) / 2) ≤ z.im → z.im ≤ (d : ℝ) / 2 → ‖normalizedRadialMellinStrip hd w.function R z‖ ≤ C"},{"kind":"theorem","name":"antiFourierWitness_normalizedMellinStrip_shifted_integrable","statement":"{d : ℕ} (hd : 0 < d) {R : ℝ} (hR : 0 < R) (w : AntiFourierWitness d R) {a : ℝ} (ha : a < (d : ℝ)) : Integrable (fun t : ℝ => normalizedRadialMellinStrip hd w.function R ((t : ℂ) + Complex.I * ((((d : ℝ) / 2 - a : ℝ) : ℂ))))"},{"kind":"theorem","name":"antiFourierWitness_normalizedMellinStrip_shifted_fourier_inversion","statement":"{d : ℕ} (hd : 0 < d) {R : ℝ} (hR : 0 < R) (w : AntiFourierWitness d R) {a : ℝ} (ha : a < (d : ℝ)) (v : ℝ) : (normalizedRadialLogProfile hd w.function R v : ℂ) = (Real.exp (a * v) : ℂ) * ((𝓕⁻ (fun ξ : ℝ => normalizedRadialMellinStrip hd w.function R (((2 * Real.pi * ξ : ℝ) : ℂ) + Complex.I * ((((d : ℝ) / 2 - a : ℝ) : ℂ)))) : ℝ → ℂ) v)"},{"kind":"theorem","name":"no_antiFourierWitness_of_shiftedMellinL1_lt_half","statement":"{d : ℕ} (hd : 0 < d) {R : ℝ} (hR : 0 < R) (w : AntiFourierWitness d R) {a : ℝ} (hapos : 0 < a) (haless : a < (d : ℝ)) (hsmall : ((2 * Real.pi)⁻¹ * ∫ s : ℝ, ‖normalizedRadialMellinStrip hd w.function R ((s : ℂ) + Complex.I * ((((d : ℝ) / 2 - a : ℝ) : ℂ)))‖) / a < (1 / 2 : ℝ)) : False"},{"kind":"theorem","name":"no_antiFourierWitness_of_interiorMellinL1_lt_half","statement":"{d : ℕ} (hd : 0 < d) {R σ : ℝ} (hR : 0 < R) (hσbelow : -1 < σ) (hσabove : σ < 1) (w : AntiFourierWitness d R) (hsmall : ((2 * Real.pi)⁻¹ * ∫ s : ℝ, ‖normalizedRadialMellinStrip hd w.function R ((s : ℂ) + Complex.I * (((σ * ((d : ℝ) / 2) : ℝ) : ℂ)))‖) / ((1 - σ) * ((d : ℝ) / 2)) < (1 / 2 : ℝ)) : False"},{"kind":"theorem","name":"lowerGammaBoundaryLog_continuousOn","statement":"{ℓ : ℝ} (hℓ : 0 < ℓ) (R : ℝ) {S : Set ℝ} (hS : ∀ y ∈ S, y ≠ 0) : ContinuousOn (lowerGammaBoundaryLog ℓ R) S"},{"kind":"theorem","name":"lowerGammaBoundaryLog_measurable","statement":"{ℓ : ℝ} (hℓ : 0 < ℓ) (R : ℝ) : Measurable (lowerGammaBoundaryLog ℓ R)"},{"kind":"theorem","name":"antiFourierWitness_normalizedMellinStrip_bottom_norm_le_gamma","statement":"{d : ℕ} (hd : 0 < d) {R : ℝ} (hR : 0 < R) (w : AntiFourierWitness d R) (y : ℝ) (hy : y ≠ 0) : ‖normalizedRadialMellinStrip hd w.function R ((y : ℂ) - Complex.I * (((d : ℝ) / 2 : ℝ) : ℂ))‖ ≤ Real.exp (lowerGammaBoundaryLog ((d : ℝ) / 2) R y)"},{"kind":"theorem","name":"stripPoisson_integral_changeVariables","statement":"{ℓ : ℝ} (hℓ : 0 < ℓ) (σ s : ℝ) (h : ℝ → ℝ) : (∫ y : ℝ, stripPoissonKernel σ ((s - y) / ℓ) / ℓ * h y) = ∫ T : ℝ, stripPoissonKernel σ T * h (s - ℓ * T)"},{"kind":"theorem","name":"norm_integerGammaFactor","statement":"(j : ℕ) (y : ℝ) : ‖(j : ℂ) + Complex.I * (y : ℂ) / 2‖ = Real.sqrt ((j : ℝ) ^ 2 + (y / 2) ^ 2)"},{"kind":"theorem","name":"integerGammaFactor_ne_zero","statement":"(j : ℕ) {y : ℝ} (hy : y ≠ 0) : (j : ℂ) + Complex.I * (y : ℂ) / 2 ≠ 0"},{"kind":"theorem","name":"gamma_imaginary_ne_zero","statement":"{y : ℝ} (hy : y ≠ 0) : Complex.Gamma (Complex.I * (y : ℂ) / 2) ≠ 0"},{"kind":"theorem","name":"norm_gamma_neg_imaginary","statement":"(y : ℝ) : ‖Complex.Gamma (-Complex.I * (y : ℂ) / 2)‖ = ‖Complex.Gamma (Complex.I * (y : ℂ) / 2)‖"},{"kind":"theorem","name":"lowerGammaBoundaryLog_integer","statement":"(k : ℕ) (R : ℝ) {y : ℝ} (hy : y ≠ 0) : lowerGammaBoundaryLog (k : ℝ) R y = (k : ℝ) * Real.log (Real.pi * R ^ 2) - ∑ j ∈ Finset.range k, Real.log (Real.sqrt ((j : ℝ) ^ 2 + (y / 2) ^ 2))"},{"kind":"theorem","name":"lower_sqrtFactor_ge_abs_half","statement":"(c y : ℝ) : |y| / 2 ≤ Real.sqrt (c ^ 2 + (y / 2) ^ 2)"},{"kind":"theorem","name":"lowerGammaBoundaryLog_integer_log_tail","statement":"(k : ℕ) {R y : ℝ} (hR : 0 < R) (hy : y ≠ 0) : lowerGammaBoundaryLog (k : ℝ) R y ≤ (k : ℝ) * Real.log (2 * Real.pi * R ^ 2 / |y|)"},{"kind":"theorem","name":"lower_abs_log_sqrtFactor_le","statement":"{c y : ℝ} (hc : 0 ≤ c) (hy : 0 < y) : |Real.log (Real.sqrt (c ^ 2 + (y / 2) ^ 2))| ≤ c + y / 2 + |Real.log (y / 2)|"},{"kind":"theorem","name":"lower_exp_abs_log_div_two_integrableOn_Ioi","statement":"{a : ℝ} (ha : 0 < a) : IntegrableOn (fun y : ℝ => Real.exp ((-a) * y) * |Real.log (y / 2)|) (Ioi (0 : ℝ))"},{"kind":"theorem","name":"lower_exp_log_sqrtFactor_integrableOn_Ioi","statement":"{a c : ℝ} (ha : 0 < a) (hc : 0 ≤ c) : IntegrableOn (fun y : ℝ => Real.exp ((-a) * y) * Real.log (Real.sqrt (c ^ 2 + (y / 2) ^ 2))) (Ioi (0 : ℝ))"},{"kind":"theorem","name":"lower_exp_log_sqrtFactor_integrable","statement":"{a c : ℝ} (ha : 0 < a) (hc : 0 ≤ c) : Integrable (fun y : ℝ => Real.exp ((-a) * |y|) * Real.log (Real.sqrt (c ^ 2 + (y / 2) ^ 2)))"},{"kind":"theorem","name":"lowerGammaBoundaryLog_integer_exp_integrable","statement":"{a : ℝ} (ha : 0 < a) (k : ℕ) (R : ℝ) : Integrable (fun y : ℝ => Real.exp ((-a) * |y|) * lowerGammaBoundaryLog (k : ℝ) R y)"},{"kind":"theorem","name":"lowerStripGammaOuter_integrable_of_exp_integrable","statement":"{ℓ R : ℝ} (hℓ : 0 < ℓ) {z : ℂ} (hz : z ∈ Complex.im ⁻¹' Ioo (-ℓ) ℓ) (hgamma : Integrable (fun y : ℝ => Real.exp (-(Real.pi / (2 * ℓ)) * |y|) * lowerGammaBoundaryLog ℓ R y)) : Integrable (fun y : ℝ => stripRegularizedHolomorphicPoissonKernel ℓ z y * (lowerGammaBoundaryLog ℓ R y : ℂ))"},{"kind":"theorem","name":"norm_halfIntegerGammaFactor","statement":"(j : ℕ) (y : ℝ) : ‖(j : ℂ) + (1 / 2 : ℂ) + Complex.I * (y : ℂ) / 2‖ = Real.sqrt (((j : ℝ) + 1 / 2) ^ 2 + (y / 2) ^ 2)"},{"kind":"theorem","name":"norm_gamma_half_add_imaginary_sq","statement":"(x : ℝ) : ‖Complex.Gamma ((1 / 2 : ℂ) + Complex.I * (x : ℂ))‖ ^ 2 = Real.pi / Real.cosh (Real.pi * x)"},{"kind":"theorem","name":"norm_gamma_imaginary_sq","statement":"{x : ℝ} (hx : x ≠ 0) : ‖Complex.Gamma (Complex.I * (x : ℂ))‖ ^ 2 = Real.pi / (x * Real.sinh (Real.pi * x))"},{"kind":"theorem","name":"halfIntegerGammaFactor_ne_zero","statement":"(j : ℕ) (y : ℝ) : (j : ℂ) + (1 / 2 : ℂ) + Complex.I * (y : ℂ) / 2 ≠ 0"},{"kind":"theorem","name":"lowerGammaBoundaryLog_halfInteger_factorized","statement":"(k : ℕ) (R : ℝ) {y : ℝ} (hy : y ≠ 0) : lowerGammaBoundaryLog ((k : ℝ) + 1 / 2) R y = ((k : ℝ) + 1 / 2) * Real.log (Real.pi * R ^ 2) - ∑ j ∈ Finset.range k, Real.log (Real.sqrt (((j : ℝ) + 1 / 2) ^ 2 + (y / 2) ^ 2)) + (Real.log ‖Complex.Gamma (Complex.I * (y : ℂ) / 2)‖ - Real.log ‖Complex.Gamma ((1 / 2 : ℂ) + Complex.I * (y : ℂ) / 2)‖)"},{"kind":"theorem","name":"lowerCoth_pos","statement":"{x : ℝ} (hx : 0 < x) : 0 < lowerCoth x"},{"kind":"theorem","name":"lowerCoth_one_le","statement":"{x : ℝ} (hx : 0 < x) : 1 ≤ lowerCoth x"},{"kind":"theorem","name":"lowerCoth_log_nonneg","statement":"{x : ℝ} (hx : 0 < x) : 0 ≤ Real.log (lowerCoth x)"},{"kind":"theorem","name":"lowerCoth_hasDerivAt","statement":"{x : ℝ} (hx : 0 < x) : HasDerivAt lowerCoth (-(Real.sinh x)⁻¹ ^ 2) x"},{"kind":"theorem","name":"lowerCoth_antitoneOn","statement":"AntitoneOn lowerCoth (Ioi (0 : ℝ))"},{"kind":"theorem","name":"lowerCoth_log_antitoneOn","statement":"AntitoneOn (fun x : ℝ => Real.log (lowerCoth x)) (Ioi (0 : ℝ))"},{"kind":"theorem","name":"lower_cosh_le_exp","statement":"{x : ℝ} (hx : 0 ≤ x) : Real.cosh x ≤ Real.exp x"},{"kind":"theorem","name":"lower_sinh_le_exp","statement":"(x : ℝ) : Real.sinh x ≤ Real.exp x"},{"kind":"theorem","name":"lower_abs_log_cosh_le","statement":"{x : ℝ} (hx : 0 ≤ x) : |Real.log (Real.cosh x)| ≤ x"},{"kind":"theorem","name":"lower_abs_log_sinh_le","statement":"{x : ℝ} (hx : 0 < x) : |Real.log (Real.sinh x)| ≤ x + |Real.log x|"},{"kind":"theorem","name":"lower_abs_log_coth_div_le","statement":"{x : ℝ} (hx : 0 < x) : |Real.log (lowerCoth (Real.pi * x) / x)| ≤ 2 * (Real.pi * x) + |Real.log Real.pi| + 2 * |Real.log x|"},{"kind":"theorem","name":"lowerCoth_sub_one_eq","statement":"{x : ℝ} (hx : 0 < x) : lowerCoth x - 1 = Real.exp (-x) / Real.sinh x"},{"kind":"theorem","name":"lower_sinh_ge_exp_quarter","statement":"{x : ℝ} (hx : 1 ≤ x) : Real.exp x / 4 ≤ Real.sinh x"},{"kind":"theorem","name":"lowerCoth_log_le_four_exp_neg_two","statement":"{x : ℝ} (hx : 1 ≤ x) : Real.log (lowerCoth x) ≤ 4 * Real.exp (-2 * x)"},{"kind":"theorem","name":"lowerCoth_log_small_abs_bound","statement":"{y : ℝ} (hy : y ≠ 0) (hsmall : |y| ≤ 1) : Real.log (lowerCoth (Real.pi * |y| / 2)) ≤ Real.pi + |Real.log Real.pi| + 3 * (|Real.log (|y|)| + |Real.log (2 : ℝ)|)"},{"kind":"theorem","name":"lowerCoth_log_abs_integrable","statement":"Integrable (fun y : ℝ => Real.log (lowerCoth (Real.pi * |y| / 2)))"},{"kind":"theorem","name":"lower_exp_log_coth_div_integrableOn_Ioi","statement":"{a : ℝ} (ha : 0 < a) : IntegrableOn (fun y : ℝ => Real.exp ((-a) * y) * Real.log (lowerCoth (Real.pi * y / 2) / (y / 2))) (Ioi (0 : ℝ))"},{"kind":"theorem","name":"lower_exp_log_coth_div_integrable","statement":"{a : ℝ} (ha : 0 < a) : Integrable (fun y : ℝ => Real.exp ((-a) * |y|) * Real.log (lowerCoth (Real.pi * |y| / 2) / (|y| / 2)))"},{"kind":"theorem","name":"gamma_log_coth_ratio","statement":"{x : ℝ} (hx : x ≠ 0) : Real.log ‖Complex.Gamma (Complex.I * (x : ℂ))‖ - Real.log ‖Complex.Gamma ((1 / 2 : ℂ) + Complex.I * (x : ℂ))‖ = (1 / 2 : ℝ) * Real.log (lowerCoth (Real.pi * |x|) / |x|)"},{"kind":"theorem","name":"lowerGammaBoundaryLog_halfInteger","statement":"(k : ℕ) (R : ℝ) {y : ℝ} (hy : y ≠ 0) : lowerGammaBoundaryLog ((k : ℝ) + 1 / 2) R y = ((k : ℝ) + 1 / 2) * Real.log (Real.pi * R ^ 2) - ∑ j ∈ Finset.range k, Real.log (Real.sqrt (((j : ℝ) + 1 / 2) ^ 2 + (y / 2) ^ 2)) + (1 / 2 : ℝ) * Real.log (lowerCoth (Real.pi * |y| / 2) / (|y| / 2))"},{"kind":"theorem","name":"lowerGammaBoundaryLog_halfInteger_log_tail","statement":"(k : ℕ) {R y : ℝ} (hR : 0 < R) (hy : y ≠ 0) : lowerGammaBoundaryLog ((k : ℝ) + 1 / 2) R y ≤ ((k : ℝ) + 1 / 2) * Real.log (2 * Real.pi * R ^ 2 / |y|) + (1 / 2 : ℝ) * Real.log (lowerCoth (Real.pi * |y| / 2))"},{"kind":"theorem","name":"lowerGammaBoundaryLog_dimension_log_tail","statement":"{d : ℕ} (_hd : 0 < d) {R y : ℝ} (hR : 0 < R) (hy : y ≠ 0) : lowerGammaBoundaryLog ((d : ℝ) / 2) R y ≤ ((d : ℝ) / 2) * Real.log (2 * Real.pi * R ^ 2 / |y|) + (1 / 2 : ℝ) * Real.log (lowerCoth (Real.pi * |y| / 2))"},{"kind":"theorem","name":"lowerGammaBoundaryLog_dimension_scaled_log_tail","statement":"{d : ℕ} (hd : 0 < d) {c Y : ℝ} (hc : 0 < c) (hY : Y ≠ 0) : lowerGammaBoundaryLog ((d : ℝ) / 2) (c * Real.sqrt d) (((d : ℝ) / 2) * Y) ≤ ((d : ℝ) / 2) * Real.log (4 * Real.pi * c ^ 2 / |Y|) + (1 / 2 : ℝ) * Real.log (lowerCoth (Real.pi * |((d : ℝ) / 2) * Y| / 2))"},{"kind":"theorem","name":"lowerGammaBoundaryLog_dimension_scaled_log_tail_uniform","statement":"{d : ℕ} (hd : 2 ≤ d) {c Y : ℝ} (hc : 0 < c) (hY : Y ≠ 0) : lowerGammaBoundaryLog ((d : ℝ) / 2) (c * Real.sqrt d) (((d : ℝ) / 2) * Y) ≤ ((d : ℝ) / 2) * Real.log (4 * Real.pi * c ^ 2 / |Y|) + (1 / 2 : ℝ) * Real.log (lowerCoth (Real.pi * |Y| / 2))"},{"kind":"theorem","name":"lower_positiveLogRatio_integrable","statement":"{A : ℝ} (hA : 0 < A) : Integrable (fun y : ℝ => max (Real.log (A / |y|)) 0)"},{"kind":"theorem","name":"lowerGammaScaledPositivePart_le","statement":"{d : ℕ} (hd : 2 ≤ d) {c Y : ℝ} (hc : 0 < c) (hY : Y ≠ 0) : lowerGammaScaledPositivePart d c Y ≤ ((d : ℝ) / 2) * max (Real.log (4 * Real.pi * c ^ 2 / |Y|)) 0 + (1 / 2 : ℝ) * Real.log (lowerCoth (Real.pi * |Y| / 2))"},{"kind":"theorem","name":"lowerGammaScaledPositivePart_integrable","statement":"{d : ℕ} (hd : 2 ≤ d) {c : ℝ} (hc : 0 < c) : Integrable (lowerGammaScaledPositivePart d c)"},{"kind":"theorem","name":"lowerGammaScaledPositivePart_integral_le","statement":"{d : ℕ} (hd : 2 ≤ d) {c : ℝ} (hc : 0 < c) : (∫ Y : ℝ, lowerGammaScaledPositivePart d c Y) ≤ ((d : ℝ) / 2) * (∫ Y : ℝ, max (Real.log (4 * Real.pi * c ^ 2 / |Y|)) 0) + (1 / 2 : ℝ) * (∫ Y : ℝ, Real.log (lowerCoth (Real.pi * |Y| / 2)))"},{"kind":"theorem","name":"lowerGammaBoundaryLog_dimension_scaled_nonpos_of_large","statement":"{d : ℕ} (hd : 2 ≤ d) {c Y : ℝ} (hc : 0 < c) (hlarge : max 1 (8 * Real.pi * c ^ 2) ≤ |Y|) : lowerGammaBoundaryLog ((d : ℝ) / 2) (c * Real.sqrt d) (((d : ℝ) / 2) * Y) ≤ 0"},{"kind":"theorem","name":"lowerGammaScaledPositivePart_support","statement":"{d : ℕ} (hd : 2 ≤ d) {c : ℝ} (hc : 0 < c) : Function.support (lowerGammaScaledPositivePart d c) ⊆ Icc (-(max 1 (8 * Real.pi * c ^ 2))) (max 1 (8 * Real.pi * c ^ 2))"},{"kind":"theorem","name":"exists_lowerGammaScaledPositivePart_uniform_bound","statement":"{c : ℝ} (hc : 0 < c) : ∃ C : ℝ, 0 < C ∧ ∀ d : ℕ, 2 ≤ d → Function.support (lowerGammaScaledPositivePart d c) ⊆ Icc (-C) C ∧ (∫ Y : ℝ, lowerGammaScaledPositivePart d c Y) ≤ C * ((d : ℝ) / 2)"},{"kind":"theorem","name":"lowerGammaBoundaryLog_integer_neg","statement":"(k : ℕ) (R : ℝ) {y : ℝ} (hy : y ≠ 0) : lowerGammaBoundaryLog (k : ℝ) R (-y) = lowerGammaBoundaryLog (k : ℝ) R y"},{"kind":"theorem","name":"lowerGammaBoundaryLog_halfInteger_neg","statement":"(k : ℕ) (R : ℝ) {y : ℝ} (hy : y ≠ 0) : lowerGammaBoundaryLog ((k : ℝ) + 1 / 2) R (-y) = lowerGammaBoundaryLog ((k : ℝ) + 1 / 2) R y"},{"kind":"theorem","name":"lowerGammaBoundaryLog_dimension_neg","statement":"{d : ℕ} (R : ℝ) {y : ℝ} (hy : y ≠ 0) : lowerGammaBoundaryLog ((d : ℝ) / 2) R (-y) = lowerGammaBoundaryLog ((d : ℝ) / 2) R y"},{"kind":"theorem","name":"lowerGammaBoundaryLog_integer_antitoneOn","statement":"(k : ℕ) (R : ℝ) : AntitoneOn (lowerGammaBoundaryLog (k : ℝ) R) (Ioi (0 : ℝ))"},{"kind":"theorem","name":"lowerGammaBoundaryLog_halfInteger_antitoneOn","statement":"(k : ℕ) (R : ℝ) : AntitoneOn (lowerGammaBoundaryLog ((k : ℝ) + 1 / 2) R) (Ioi (0 : ℝ))"},{"kind":"theorem","name":"lowerGammaBoundaryLog_dimension_antitoneOn","statement":"{d : ℕ} (R : ℝ) : AntitoneOn (lowerGammaBoundaryLog ((d : ℝ) / 2) R) (Ioi (0 : ℝ))"},{"kind":"theorem","name":"even_antitone_superlevel_interval","statement":"{f : ℝ → ℝ} {B t : ℝ} (heven : ∀ x : ℝ, f (-x) = f x) (hanti : AntitoneOn f (Ici (0 : ℝ))) (hsupport : Function.support f ⊆ Icc (-B) B) (ht : 0 < t) : ∃ r : ℝ, 0 ≤ r ∧ Ioo (-r) r ⊆ {x : ℝ | t < f x} ∧ {x : ℝ | t < f x} ⊆ Icc (-r) r"},{"kind":"theorem","name":"lowerGammaBoundaryLog_halfInteger_exp_integrable","statement":"{a : ℝ} (ha : 0 < a) (k : ℕ) (R : ℝ) : Integrable (fun y : ℝ => Real.exp ((-a) * |y|) * lowerGammaBoundaryLog ((k : ℝ) + 1 / 2) R y)"},{"kind":"theorem","name":"lowerGammaBoundaryLog_dimension_exp_integrable","statement":"{d : ℕ} (hd : 0 < d) {a : ℝ} (ha : 0 < a) (R : ℝ) : Integrable (fun y : ℝ => Real.exp ((-a) * |y|) * lowerGammaBoundaryLog ((d : ℝ) / 2) R y)"},{"kind":"theorem","name":"lowerStripGammaOuter_integrable_dimension","statement":"{d : ℕ} (hd : 0 < d) {R : ℝ} {z : ℂ} (hz : z ∈ Complex.im ⁻¹' Ioo (-((d : ℝ) / 2)) ((d : ℝ) / 2)) : Integrable (fun y : ℝ => stripRegularizedHolomorphicPoissonKernel ((d : ℝ) / 2) z y * (lowerGammaBoundaryLog ((d : ℝ) / 2) R y : ℂ))"},{"kind":"theorem","name":"lowerRiemannLog_monotoneOn","statement":"{T : ℝ} (hT : T ≠ 0) : MonotoneOn (lowerRiemannLog T) (Ici (0 : ℝ))"},{"kind":"theorem","name":"monotone_leftRiemann_error","statement":"(f : ℝ → ℝ) {k : ℕ} (hk : 0 < k) (hf : MonotoneOn f (Icc (0 : ℝ) 1)) : 0 ≤ (k : ℝ) * (∫ x in (0 : ℝ)..1, f x) - ∑ j ∈ Finset.range k, f ((j : ℝ) / (k : ℝ)) ∧ (k : ℝ) * (∫ x in (0 : ℝ)..1, f x) - ∑ j ∈ Finset.range k, f ((j : ℝ) / (k : ℝ)) ≤ f 1 - f 0"},{"kind":"theorem","name":"lower_integer_leftRiemann_error","statement":"{T : ℝ} (hT : T ≠ 0) {k : ℕ} (hk : 0 < k) : 0 ≤ (k : ℝ) * (∫ x in (0 : ℝ)..1, lowerRiemannLog T x) - ∑ j ∈ Finset.range k, lowerRiemannLog T ((j : ℝ) / (k : ℝ)) ∧ (k : ℝ) * (∫ x in (0 : ℝ)..1, lowerRiemannLog T x) - ∑ j ∈ Finset.range k, lowerRiemannLog T ((j : ℝ) / (k : ℝ)) ≤ lowerRiemannLog T 1 - lowerRiemannLog T 0"},{"kind":"theorem","name":"monotone_midpointIntegral_error","statement":"(f : ℝ → ℝ) (k : ℕ) (hf : MonotoneOn f (Icc (0 : ℝ) (k : ℝ))) : |(∫ x in (0 : ℝ)..(k : ℝ), f x) - ∑ j ∈ Finset.range k, f ((j : ℝ) + 1 / 2)| ≤ f (k : ℝ) - f 0"},{"kind":"theorem","name":"lower_halfInteger_midpointRiemann_error","statement":"{T : ℝ} (hT : T ≠ 0) {ℓ : ℝ} (hℓ : 0 < ℓ) (k : ℕ) : |ℓ * (∫ x in (0 : ℝ)..((k : ℝ) / ℓ), lowerRiemannLog T x) - ∑ j ∈ Finset.range k, lowerRiemannLog T (((j : ℝ) + 1 / 2) / ℓ)| ≤ lowerRiemannLog T ((k : ℝ) / ℓ) - lowerRiemannLog T 0"},{"kind":"theorem","name":"lowerRiemannLogPrimitive_hasDerivAt","statement":"{T : ℝ} (hT : T ≠ 0) (x : ℝ) : HasDerivAt (lowerRiemannLogPrimitive T) (lowerRiemannLog T x) x"},{"kind":"theorem","name":"integral_lowerRiemannLog","statement":"{T : ℝ} (hT : T ≠ 0) : -(∫ x in (0 : ℝ)..1, lowerRiemannLog T x) = 1 + lowerEndpointPhase T"},{"kind":"theorem","name":"complexLaplaceKernel_integrable","statement":"{z : ℂ} (hz : 0 < z.re) : IntegrableOn (fun x : ℝ => Complex.exp (-z * (x : ℂ))) (Ioi 0)"},{"kind":"theorem","name":"integral_complexLaplaceKernel","statement":"{z : ℂ} (hz : 0 < z.re) : (∫ x : ℝ in Ioi 0, Complex.exp (-z * (x : ℂ))) = z⁻¹"},{"kind":"theorem","name":"complexFrullaniSegment_re_pos","statement":"{z w : ℂ} (hz : 0 < z.re) (hw : 0 < w.re) {s : ℝ} (hs : s ∈ Icc (0 : ℝ) 1) : 0 < (complexFrullaniSegment z w s).re"},{"kind":"theorem","name":"complexFrullaniSegment_hasDerivAt","statement":"(z w : ℂ) (s : ℝ) : HasDerivAt (complexFrullaniSegment z w) (w - z) s"},{"kind":"theorem","name":"intervalIntegral_complexLaplaceSegment","statement":"(z w : ℂ) {x : ℝ} (hx : x ≠ 0) : (∫ s in (0 : ℝ)..1, (w - z) * Complex.exp (-complexFrullaniSegment z w s * (x : ℂ))) = complexFrullaniKernel z w x"},{"kind":"theorem","name":"norm_complexLaplaceKernel","statement":"(z : ℂ) (x : ℝ) : ‖Complex.exp (-z * (x : ℂ))‖ = Real.exp (-z.re * x)"},{"kind":"theorem","name":"complexFrullaniSegment_min_re_le","statement":"(z w : ℂ) {s : ℝ} (hs : s ∈ Icc (0 : ℝ) 1) : min z.re w.re ≤ (complexFrullaniSegment z w s).re"},{"kind":"theorem","name":"complexFrullaniKernel_norm_le_exp","statement":"(z w : ℂ) {x : ℝ} (hx : 0 < x) : ‖complexFrullaniKernel z w x‖ ≤ ‖w - z‖ * Real.exp (-(min z.re w.re) * x)"},{"kind":"theorem","name":"integral_norm_complexFrullaniSegment","statement":"{z w : ℂ} (hz : 0 < z.re) (hw : 0 < w.re) {s : ℝ} (hs : s ∈ Icc (0 : ℝ) 1) : (∫ x : ℝ in Ioi 0, ‖(w - z) * Complex.exp (-complexFrullaniSegment z w s * (x : ℂ))‖) = ‖w - z‖ * (complexFrullaniSegment z w s).re⁻¹"},{"kind":"theorem","name":"complexFrullaniParameter_integrable","statement":"{z w : ℂ} (hz : 0 < z.re) (hw : 0 < w.re) : Integrable (Function.uncurry (fun s x : ℝ => (w - z) * Complex.exp (-complexFrullaniSegment z w s * (x : ℂ)))) ((volume.restrict (Set.uIoc (0 : ℝ) 1)).prod (volume.restrict (Ioi 0)))"},{"kind":"theorem","name":"complexFrullaniKernel_integrable","statement":"{z w : ℂ} (hz : 0 < z.re) (hw : 0 < w.re) : IntegrableOn (complexFrullaniKernel z w) (Ioi 0)"},{"kind":"theorem","name":"intervalIntegral_complexFrullaniLogDerivative","statement":"{z w : ℂ} (hz : 0 < z.re) (hw : 0 < w.re) : (∫ s in (0 : ℝ)..1, (w - z) * (complexFrullaniSegment z w s)⁻¹) = Complex.log w - Complex.log z"},{"kind":"theorem","name":"integral_complexFrullaniKernel","statement":"{z w : ℂ} (hz : 0 < z.re) (hw : 0 < w.re) : (∫ x : ℝ in Ioi 0, complexFrullaniKernel z w x) = Complex.log w - Complex.log z"},{"kind":"theorem","name":"complexFrullaniShiftKernel_norm_le_exp","statement":"(z : ℂ) {s x : ℝ} (hs : s ∈ Icc (0 : ℝ) 1) (hx : 0 < x) : ‖complexFrullaniKernel (z + (s : ℂ)) 1 x‖ ≤ (‖(1 : ℂ) - z‖ + 1) * Real.exp (-(min z.re 1) * x)"},{"kind":"theorem","name":"complexFrullaniShiftParameter_integrable","statement":"{z : ℂ} (hz : 0 < z.re) : Integrable (Function.uncurry (fun s x : ℝ => complexFrullaniKernel (z + (s : ℂ)) 1 x)) ((volume.restrict (Set.uIoc (0 : ℝ) 1)).prod (volume.restrict (Ioi 0)))"},{"kind":"theorem","name":"intervalIntegral_complexFrullaniShift","statement":"(z : ℂ) {x : ℝ} (hx : x ≠ 0) : (∫ s in (0 : ℝ)..1, complexFrullaniKernel (z + (s : ℂ)) 1 x) = complexWallisPhaseKernel z x"},{"kind":"theorem","name":"complexWallisPhaseKernel_integrable","statement":"{z : ℂ} (hz : 0 < z.re) : IntegrableOn (complexWallisPhaseKernel z) (Ioi 0)"},{"kind":"theorem","name":"complexWallisTranslatedSegment_hasDerivAt","statement":"(z : ℂ) (s : ℝ) : HasDerivAt (fun r : ℝ => z + (r : ℂ)) (1 : ℂ) s"},{"kind":"theorem","name":"complexWallisLogPrimitive_hasDerivAt","statement":"{z : ℂ} (hz : 0 < z.re) (s : ℝ) (hs : s ∈ Icc (0 : ℝ) 1) : HasDerivAt (fun r : ℝ => (z + (r : ℂ)) * Complex.log (z + (r : ℂ)) - (z + (r : ℂ))) (Complex.log (z + (s : ℂ))) s"},{"kind":"theorem","name":"intervalIntegral_complexWallisLog","statement":"{z : ℂ} (hz : 0 < z.re) : (∫ s in (0 : ℝ)..1, Complex.log (z + (s : ℂ))) = (z + 1) * Complex.log (z + 1) - z * Complex.log z - 1"},{"kind":"theorem","name":"integral_complexWallisPhaseKernel","statement":"{z : ℂ} (hz : 0 < z.re) : (∫ x : ℝ in Ioi 0, complexWallisPhaseKernel z x) = 1 + z * Complex.log z - (z + 1) * Complex.log (z + 1)"},{"kind":"theorem","name":"stripAngle_eq_pi_sub","statement":"(σ : ℝ) : stripAngle σ = Real.pi - Real.pi * (1 - σ) / 2"},{"kind":"theorem","name":"stripNormalizedPoissonKernel_eq_extension","statement":"{σ : ℝ} (_hbelow : -1 < σ) (habove : σ < 1) (T : ℝ) : stripNormalizedPoissonKernel σ T = stripNormalizedPoissonExtension σ T"},{"kind":"theorem","name":"stripNormalizedPoissonExtension_one","statement":"(T : ℝ) : stripNormalizedPoissonExtension 1 T = limitingStripPoissonDensity T"},{"kind":"theorem","name":"stripNormalizedPoissonExtension_continuousAt_one","statement":"(T : ℝ) : ContinuousAt (fun σ : ℝ => stripNormalizedPoissonExtension σ T) 1"},{"kind":"theorem","name":"tendsto_stripNormalizedPoissonKernel","statement":"(T : ℝ) : Tendsto (fun σ : ℝ => stripNormalizedPoissonKernel σ T) (𝓝[<] 1) (𝓝 (limitingStripPoissonDensity T))"},{"kind":"theorem","name":"stripNormalizedPoissonKernel_integrable","statement":"{σ : ℝ} (hbelow : -1 < σ) (habove : σ < 1) : Integrable (stripNormalizedPoissonKernel σ)"},{"kind":"theorem","name":"inv_cosh_le_two_exp_neg_abs","statement":"(u : ℝ) : (Real.cosh u)⁻¹ ≤ 2 * Real.exp (-|u|)"},{"kind":"theorem","name":"stripNormalizedPoissonExtension_le_majorant","statement":"{σ : ℝ} (hzero : 0 ≤ σ) (hone : σ ≤ 1) (T : ℝ) : 0 ≤ stripNormalizedPoissonExtension σ T ∧ stripNormalizedPoissonExtension σ T ≤ stripPoissonExponentialMajorant T"},{"kind":"theorem","name":"integrable_exp_neg_mul_abs","statement":"{a : ℝ} (ha : 0 < a) : Integrable (fun T : ℝ => Real.exp (-a * |T|))"},{"kind":"theorem","name":"stripPoissonExponentialMajorant_integrable","statement":"Integrable stripPoissonExponentialMajorant"},{"kind":"theorem","name":"integrable_abs_pow_mul_exp_neg_mul_abs","statement":"(n : ℕ) {a : ℝ} (ha : 0 < a) : Integrable (fun T : ℝ => |T| ^ n * Real.exp (-a * |T|))"},{"kind":"theorem","name":"limitingStripPoissonDensity_integrable","statement":"Integrable limitingStripPoissonDensity"},{"kind":"theorem","name":"poissonLogisticDensity_eq_limitingStripPoissonDensity","statement":"(u : ℝ) : poissonLogisticDensity u = 2 * limitingStripPoissonDensity (2 * u)"},{"kind":"theorem","name":"poissonLogistic_image_univ","statement":"poissonLogistic '' (Set.univ : Set ℝ) = Ioo (0 : ℝ) 1"},{"kind":"theorem","name":"poissonLogistic_hasDerivAt","statement":"(u : ℝ) : HasDerivAt poissonLogistic (poissonLogisticDensity u) u"},{"kind":"theorem","name":"poissonLogistic_injective","statement":"Function.Injective poissonLogistic"},{"kind":"theorem","name":"poissonLogistic_mem_Ioo","statement":"(u : ℝ) : poissonLogistic u ∈ Ioo (0 : ℝ) 1"},{"kind":"theorem","name":"poissonLogistic_odds","statement":"(u : ℝ) : poissonLogistic u / (1 - poissonLogistic u) = Real.exp (Real.pi * u)"},{"kind":"theorem","name":"poissonLogistic_cpow_ratio","statement":"(u : ℝ) (w : ℂ) : ((poissonLogistic u : ℝ) : ℂ) ^ w * (((1 - poissonLogistic u : ℝ) : ℂ) ^ (-w)) = Complex.exp (((Real.pi * u : ℝ) : ℂ) * w)"},{"kind":"theorem","name":"integral_poissonLogistic_change_Ioo","statement":"{E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] (f : ℝ → E) : (∫ x : ℝ in Ioo 0 1, f x) = ∫ u : ℝ, poissonLogisticDensity u • f (poissonLogistic u)"},{"kind":"theorem","name":"poissonLogisticDensity_integrable","statement":"Integrable poissonLogisticDensity"},{"kind":"theorem","name":"integral_poissonLogisticDensity","statement":"(∫ u : ℝ, poissonLogisticDensity u) = 1"},{"kind":"theorem","name":"poissonLogistic_betaIntegral","statement":"(w : ℂ) : Complex.betaIntegral (1 + w) (1 - w) = ∫ u : ℝ, (poissonLogisticDensity u : ℂ) * Complex.exp (((Real.pi * u : ℝ) : ℂ) * w)"},{"kind":"theorem","name":"gamma_one_add_imaginary_mul_gamma_one_sub","statement":"{x : ℝ} (hx : x ≠ 0) : Complex.Gamma (1 + Complex.I * (x : ℂ)) * Complex.Gamma (1 - Complex.I * (x : ℂ)) = ((Real.pi * x / Real.sinh (Real.pi * x) : ℝ) : ℂ)"},{"kind":"theorem","name":"poissonLogistic_characteristic_of_ne_zero","statement":"{t : ℝ} (ht : t ≠ 0) : (∫ u : ℝ, (poissonLogisticDensity u : ℂ) * Complex.exp (Complex.I * (t : ℂ) * (u : ℂ))) = ((t / Real.sinh t : ℝ) : ℂ)"},{"kind":"theorem","name":"poissonLogistic_characteristic","statement":"(t : ℝ) : (∫ u : ℝ, (poissonLogisticDensity u : ℂ) * Complex.exp (Complex.I * (t : ℂ) * (u : ℂ))) = if t = 0 then 1 else ((t / Real.sinh t : ℝ) : ℂ)"},{"kind":"theorem","name":"poissonLogistic_characteristic_integrable","statement":"(t : ℝ) : Integrable (fun u : ℝ => (poissonLogisticDensity u : ℂ) * Complex.exp (Complex.I * (t : ℂ) * (u : ℂ)))"},{"kind":"theorem","name":"poissonLogistic_cosine_transform","statement":"(t : ℝ) : (∫ u : ℝ, poissonLogisticDensity u * Real.cos (t * u)) = if t = 0 then 1 else t / Real.sinh t"},{"kind":"theorem","name":"lowerEndpointPhase_continuous","statement":"Continuous lowerEndpointPhase"},{"kind":"theorem","name":"abs_lowerEndpointPhase_le","statement":"(T : ℝ) : |lowerEndpointPhase T| ≤ Real.pi * |T| + T ^ 2"},{"kind":"theorem","name":"stripPoissonExponentialMajorant_mul_lowerEndpointPhase_integrable","statement":"Integrable (fun T : ℝ => stripPoissonExponentialMajorant T * ‖lowerEndpointPhase T‖)"},{"kind":"theorem","name":"tendsto_integral_stripNormalizedPoissonKernel_mul","statement":"(f : ℝ → ℝ) (hf : AEStronglyMeasurable f volume) (hmajor : Integrable (fun T : ℝ => stripPoissonExponentialMajorant T * ‖f T‖)) : Tendsto (fun σ : ℝ => ∫ T : ℝ, stripNormalizedPoissonKernel σ T * f T) (𝓝[<] 1) (𝓝 (∫ T : ℝ, limitingStripPoissonDensity T * f T))"},{"kind":"theorem","name":"tendsto_lowerPoissonEndpointExpectation","statement":"Tendsto lowerPoissonEndpointExpectation (𝓝[<] 1) (𝓝 limitingPoissonEndpointExpectation)"},{"kind":"theorem","name":"poissonLogistic_cosine_integrable","statement":"(t : ℝ) : Integrable (fun u : ℝ => poissonLogisticDensity u * Real.cos (t * u))"},{"kind":"theorem","name":"poissonLogisticDensity_le_pi_exp","statement":"(u : ℝ) : poissonLogisticDensity u ≤ Real.pi * Real.exp (-Real.pi * |u|)"},{"kind":"theorem","name":"poissonLogisticDensity_abs_moment_integrable","statement":"(n : ℕ) : Integrable (fun u : ℝ => poissonLogisticDensity u * |u| ^ n)"},{"kind":"theorem","name":"lowerWallisPhaseKernel_abs_le_moment","statement":"(u : ℝ) {t : ℝ} (ht : 0 < t) : |lowerWallisPhaseKernel u t| ≤ |u| + 1"},{"kind":"theorem","name":"lowerWallisPhaseKernel_abs_le_tail","statement":"(u : ℝ) {t : ℝ} (ht : 1 ≤ t) : |lowerWallisPhaseKernel u t| ≤ 1 / t ^ 2 + Real.exp (-t)"},{"kind":"theorem","name":"lowerWallisPhaseTail_integrable","statement":"IntegrableOn (fun t : ℝ => 1 / t ^ 2 + Real.exp (-t)) (Ioi 1)"},{"kind":"theorem","name":"poissonLogistic_lowerWallisPhase_product_integrable","statement":"Integrable (fun p : ℝ × ℝ => poissonLogisticDensity p.1 * lowerWallisPhaseKernel p.1 p.2) (volume.prod (volume.restrict (Ioi 0)))"},{"kind":"theorem","name":"integral_poissonLogistic_mul_lowerWallisPhaseKernel","statement":"{t : ℝ} (ht : 0 < t) : (∫ u : ℝ, poissonLogisticDensity u * lowerWallisPhaseKernel u t) = wallisLaplaceKernel t"},{"kind":"theorem","name":"complexWallisPhaseKernel_re","statement":"(a u t : ℝ) : (complexWallisPhaseKernel ((a : ℂ) - Complex.I * (u : ℂ)) t).re = lowerWallisRegularizedPhaseKernel a u t"},{"kind":"theorem","name":"lowerWallisRegularizedPhaseKernel_eq_add","statement":"(a u t : ℝ) : lowerWallisRegularizedPhaseKernel a u t = lowerWallisPhaseKernel u t + ((1 - Real.exp (-t)) * (Real.exp (-a * t) - 1) * Real.cos (u * t)) / t ^ 2"},{"kind":"theorem","name":"lowerWallisRegularizedPhaseKernel_abs_le_moment","statement":"{a : ℝ} (hazero : 0 ≤ a) (haone : a ≤ 1) (u : ℝ) {t : ℝ} (ht : 0 < t) : |lowerWallisRegularizedPhaseKernel a u t| ≤ |u| + 2"},{"kind":"theorem","name":"lowerWallisRegularizedPhaseKernel_abs_le_tail","statement":"{a : ℝ} (hazero : 0 ≤ a) (u : ℝ) {t : ℝ} (ht : 1 ≤ t) : |lowerWallisRegularizedPhaseKernel a u t| ≤ 1 / t ^ 2 + Real.exp (-t)"},{"kind":"theorem","name":"lowerWallisRegularizedPhaseMajorant_integrable","statement":"(u : ℝ) : IntegrableOn (lowerWallisRegularizedPhaseMajorant u) (Ioi 0)"},{"kind":"theorem","name":"tendsto_integral_lowerWallisRegularizedPhaseKernel","statement":"(u : ℝ) : Tendsto (fun n : ℕ => ∫ t : ℝ in Ioi 0, lowerWallisRegularizedPhaseKernel (1 / ((n : ℝ) + 1)) u t) atTop (𝓝 (∫ t : ℝ in Ioi 0, lowerWallisPhaseKernel u t))"},{"kind":"theorem","name":"integral_lowerWallisRegularizedPhaseKernel","statement":"{a : ℝ} (ha : 0 < a) (u : ℝ) : (∫ t : ℝ in Ioi 0, lowerWallisRegularizedPhaseKernel a u t) = (1 + ((a : ℂ) - Complex.I * (u : ℂ)) * Complex.log ((a : ℂ) - Complex.I * (u : ℂ)) - (((a : ℂ) - Complex.I * (u : ℂ)) + 1) * Complex.log (((a : ℂ) - Complex.I * (u : ℂ)) + 1)).re"},{"kind":"theorem","name":"lowerWallis_arg_one_sub_I_mul","statement":"(u : ℝ) : Complex.arg (1 - Complex.I * (u : ℂ)) = -Real.arctan u"},{"kind":"theorem","name":"lowerWallis_imaginary_log_mul_re","statement":"(u : ℝ) : ((-Complex.I * (u : ℂ)) * Complex.log (-Complex.I * (u : ℂ))).re = -Real.pi * |u| / 2"},{"kind":"theorem","name":"lowerWallis_norm_one_sub_I_mul","statement":"(u : ℝ) : ‖1 - Complex.I * (u : ℂ)‖ = Real.sqrt (1 + u ^ 2)"},{"kind":"theorem","name":"lowerWallis_shifted_log_mul_re","statement":"(u : ℝ) : ((1 - Complex.I * (u : ℂ)) * Complex.log (1 - Complex.I * (u : ℂ))).re = Real.log (1 + u ^ 2) / 2 - u * Real.arctan u"},{"kind":"theorem","name":"lowerWallis_abs_mul_arctan_abs","statement":"(u : ℝ) : |u| * Real.arctan |u| = u * Real.arctan u"},{"kind":"theorem","name":"lowerWallis_complexEndpointPhase_re","statement":"(u : ℝ) : (1 + (-Complex.I * (u : ℂ)) * Complex.log (-Complex.I * (u : ℂ)) - ((-Complex.I * (u : ℂ)) + 1) * Complex.log ((-Complex.I * (u : ℂ)) + 1)).re = 1 + lowerEndpointPhase (2 * u)"},{"kind":"theorem","name":"lowerWallisComplexLogPhase_ofReal","statement":"{a : ℝ} (ha : 0 ≤ a) : lowerWallisComplexLogPhase (a : ℂ) = 1 + a * Real.log a - (a + 1) * Real.log (a + 1)"},{"kind":"theorem","name":"tendsto_lowerWallisComplexLogPhase_regularized","statement":"(u : ℝ) : Tendsto (fun n : ℕ => lowerWallisComplexLogPhase (((1 / ((n : ℝ) + 1) : ℝ) : ℂ) - Complex.I * (u : ℂ))) atTop (𝓝 (1 + lowerEndpointPhase (2 * u)))"},{"kind":"theorem","name":"integral_lowerWallisPhaseKernel","statement":"(u : ℝ) : (∫ t : ℝ in Ioi 0, lowerWallisPhaseKernel u t) = 1 + lowerEndpointPhase (2 * u)"},{"kind":"theorem","name":"integral_poissonLogistic_one_add_lowerEndpointPhase","statement":"(∫ u : ℝ, poissonLogisticDensity u * (1 + lowerEndpointPhase (2 * u))) = Real.log (Real.pi / 2)"},{"kind":"theorem","name":"poissonLogistic_lowerEndpointPhase_integrable","statement":"Integrable (fun u : ℝ => poissonLogisticDensity u * lowerEndpointPhase (2 * u))"},{"kind":"theorem","name":"integral_poissonLogistic_lowerEndpointPhase","statement":"(∫ u : ℝ, poissonLogisticDensity u * lowerEndpointPhase (2 * u)) = Real.log (Real.pi / 2) - 1"},{"kind":"theorem","name":"limitingPoissonEndpointExpectation_eq_log_pi_div_two_sub_one","statement":"limitingPoissonEndpointExpectation = Real.log (Real.pi / 2) - 1"},{"kind":"theorem","name":"lowerPoissonEndpointSharpCoefficient_eq","statement":"{c : ℝ} (hc : 0 < c) : Real.log (2 * Real.pi * Real.exp 1 * c ^ 2) + limitingPoissonEndpointExpectation = Real.log (Real.pi ^ 2 * c ^ 2)"},{"kind":"theorem","name":"lowerPoissonEndpointSharpCoefficient_neg","statement":"{c : ℝ} (hc : 0 < c) (hsharp : c < Real.pi⁻¹) : Real.log (2 * Real.pi * Real.exp 1 * c ^ 2) + limitingPoissonEndpointExpectation < 0"},{"kind":"theorem","name":"tendsto_lowerPoissonEndpointSharpCoefficient","statement":"{c : ℝ} (hc : 0 < c) : Tendsto (fun σ : ℝ => Real.log (2 * Real.pi * Real.exp 1 * c ^ 2) + lowerPoissonEndpointExpectation σ) (𝓝[<] 1) (𝓝 (Real.log (Real.pi ^ 2 * c ^ 2)))"},{"kind":"theorem","name":"eventually_lowerPoissonEndpointSharpCoefficient_neg","statement":"{c : ℝ} (hc : 0 < c) (hsharp : c < Real.pi⁻¹) : ∀ᶠ σ : ℝ in 𝓝[<] 1, Real.log (2 * Real.pi * Real.exp 1 * c ^ 2) + lowerPoissonEndpointExpectation σ < 0"},{"kind":"theorem","name":"saddle_one_add_abs_cube_le","statement":"(T : ℝ) : (1 + |T|) ^ 3 ≤ 4 * (1 + |T| ^ 3)"},{"kind":"theorem","name":"plusPolynomial_imaginary_norm_ge_beta","statement":"{ε u : ℝ} (hε : 0 < ε) (hu : -1 ≤ u) : beta ε ≤ ‖plusPolynomial ε (Complex.I * (u : ℂ))‖"},{"kind":"theorem","name":"plusPolynomial_imaginary_cubic_growth_le","statement":"{ε u : ℝ} (hε : 0 < ε) (hu : -1 ≤ u) : (1 + |u|) ^ 3 ≤ (27 / beta ε + 9) * ‖plusPolynomial ε (Complex.I * (u : ℂ))‖"},{"kind":"theorem","name":"minusPolynomial_imaginary_norm_ge_three_beta","statement":"{ε u : ℝ} (hε : 0 < ε) (hu : 1 + ε / 4 ≤ u) : 3 * beta ε ≤ ‖minusPolynomial ε (Complex.I * (u : ℂ))‖"},{"kind":"theorem","name":"minusPolynomial_imaginary_cubic_growth_le","statement":"{ε u : ℝ} (hε : 0 < ε) (hu : 1 + ε / 4 ≤ u) : (1 + |u|) ^ 3 ≤ (9 / beta ε + 6) * ‖minusPolynomial ε (Complex.I * (u : ℂ))‖"},{"kind":"theorem","name":"saddle_complex_frequency_norm_le","statement":"(T u : ℝ) : ‖(T : ℂ) + Complex.I * (u : ℂ)‖ ≤ |T| + |u|"},{"kind":"theorem","name":"exists_plusPolynomial_uniform_norm_ratio","statement":"{ε : ℝ} (hε : 0 < ε) : ∃ C : ℝ, 0 < C ∧ ∀ u : ℝ, -1 ≤ u → ∀ T : ℝ, ‖plusPolynomial ε ((T : ℂ) + Complex.I * (u : ℂ))‖ / ‖plusPolynomial ε (Complex.I * (u : ℂ))‖ ≤ C * (1 + |T| ^ 3)"},{"kind":"theorem","name":"exists_minusPolynomial_uniform_norm_ratio","statement":"{ε : ℝ} (hε : 0 < ε) : ∃ C : ℝ, 0 < C ∧ ∀ u : ℝ, 1 + ε / 4 ≤ u → ∀ T : ℝ, ‖minusPolynomial ε ((T : ℂ) + Complex.I * (u : ℂ))‖ / ‖minusPolynomial ε (Complex.I * (u : ℂ))‖ ≤ C * (1 + |T| ^ 3)"},{"kind":"theorem","name":"plusPolynomial_add_sub","statement":"(ε : ℝ) (z w : ℂ) : plusPolynomial ε (z + w) - plusPolynomial ε z = w * (2 * z + Complex.I * (1 + 3 * z ^ 2)) + w ^ 2 * (1 + 3 * Complex.I * z) + Complex.I * w ^ 3"},{"kind":"theorem","name":"minusPolynomial_add_sub","statement":"(ε : ℝ) (z w : ℂ) : minusPolynomial ε (z + w) - minusPolynomial ε z = w * (2 * z - Complex.I * (1 + 3 * z ^ 2)) + w ^ 2 * (1 - 3 * Complex.I * z) - Complex.I * w ^ 3"},{"kind":"theorem","name":"plusSaddleLinearCoefficient_norm_le","statement":"(z : ℂ) : ‖2 * z + Complex.I * (1 + 3 * z ^ 2)‖ ≤ 3 * (1 + ‖z‖) ^ 2"},{"kind":"theorem","name":"minusSaddleLinearCoefficient_norm_le","statement":"(z : ℂ) : ‖2 * z - Complex.I * (1 + 3 * z ^ 2)‖ ≤ 3 * (1 + ‖z‖) ^ 2"},{"kind":"theorem","name":"plusSaddleQuadraticCoefficient_norm_le","statement":"(z : ℂ) : ‖1 + 3 * Complex.I * z‖ ≤ 3 * (1 + ‖z‖) ^ 2"},{"kind":"theorem","name":"minusSaddleQuadraticCoefficient_norm_le","statement":"(z : ℂ) : ‖1 - 3 * Complex.I * z‖ ≤ 3 * (1 + ‖z‖) ^ 2"},{"kind":"theorem","name":"saddle_abs_sq_le_add_cube","statement":"(T : ℝ) : |T| ^ 2 ≤ |T| + |T| ^ 3"},{"kind":"theorem","name":"saddle_cubic_translation_norm_le","statement":"(u T : ℝ) (A B C : ℂ) (hA : ‖A‖ ≤ 3 * (1 + |u|) ^ 2) (hB : ‖B‖ ≤ 3 * (1 + |u|) ^ 2) (hC : ‖C‖ ≤ 1) : ‖(T : ℂ) * A + (T : ℂ) ^ 2 * B + C * (T : ℂ) ^ 3‖ ≤ 9 * (1 + |u|) ^ 2 * (|T| + |T| ^ 3)"},{"kind":"theorem","name":"plusPolynomial_translation_norm_le","statement":"(ε u T : ℝ) : ‖plusPolynomial ε ((T : ℂ) + Complex.I * (u : ℂ)) - plusPolynomial ε (Complex.I * (u : ℂ))‖ ≤ 9 * (1 + |u|) ^ 2 * (|T| + |T| ^ 3)"},{"kind":"theorem","name":"minusPolynomial_translation_norm_le","statement":"(ε u T : ℝ) : ‖minusPolynomial ε ((T : ℂ) + Complex.I * (u : ℂ)) - minusPolynomial ε (Complex.I * (u : ℂ))‖ ≤ 9 * (1 + |u|) ^ 2 * (|T| + |T| ^ 3)"},{"kind":"theorem","name":"exists_plusPolynomial_uniform_difference_ratio","statement":"{ε : ℝ} (hε : 0 < ε) : ∃ C : ℝ, 0 < C ∧ ∀ u : ℝ, -1 ≤ u → ∀ T : ℝ, ‖plusPolynomial ε ((T : ℂ) + Complex.I * (u : ℂ)) - plusPolynomial ε (Complex.I * (u : ℂ))‖ / ‖plusPolynomial ε (Complex.I * (u : ℂ))‖ ≤ C * (|T| + |T| ^ 3)"},{"kind":"theorem","name":"exists_minusPolynomial_uniform_difference_ratio","statement":"{ε : ℝ} (hε : 0 < ε) : ∃ C : ℝ, 0 < C ∧ ∀ u : ℝ, 1 + ε / 4 ≤ u → ∀ T : ℝ, ‖minusPolynomial ε ((T : ℂ) + Complex.I * (u : ℂ)) - minusPolynomial ε (Complex.I * (u : ℂ))‖ / ‖minusPolynomial ε (Complex.I * (u : ℂ))‖ ≤ C * (|T| + |T| ^ 3)"},{"kind":"theorem","name":"upperNegativeHalfGammaArgument_ne_zero","statement":"(N : ℕ) (s : ℝ) : upperNegativeHalfGammaArgument N s ≠ 0"},{"kind":"theorem","name":"upperNegativeHalfGammaArgument_succ_add_one","statement":"(N : ℕ) (s : ℝ) : upperNegativeHalfGammaArgument (N + 1) s + 1 = upperNegativeHalfGammaArgument N s"},{"kind":"theorem","name":"tendsto_upper_shortEndpoint_scaled","statement":"Tendsto (fun ε : ℝ => ε * shortEndpoint ε) (𝓝[>] (0 : ℝ)) (𝓝 (0 : ℝ))"},{"kind":"theorem","name":"tendsto_upper_one_add_shortEndpoint_scaled","statement":"Tendsto (fun ε : ℝ => ε * (1 + shortEndpoint ε)) (𝓝[>] (0 : ℝ)) (𝓝 (0 : ℝ))"},{"kind":"theorem","name":"eventually_upper_shortMargin_positive","statement":"∀ᶠ ε : ℝ in 𝓝[>] (0 : ℝ), ∀ a ∈ Set.Icc (shortCutoff ε) (shortEndpoint ε), (1 / 2 : ℝ) ≤ shortMargin ε a"},{"kind":"theorem","name":"eventually_upper_shellLocation_gt_shortEndpoint","statement":"∀ᶠ ε : ℝ in 𝓝[>] (0 : ℝ), shortEndpoint ε + 1 < shellLocation ε"},{"kind":"theorem","name":"upperShellMarginRatio_inv","statement":"{x : ℝ} (hx : x ≠ 0) : upperShellMarginRatio x⁻¹ = 5000 * (10 * Real.log x + x ^ 3) * Real.exp (-(x ^ 2) / 8) * Real.exp (5 * Real.log x / x)"},{"kind":"theorem","name":"tendsto_upper_log_cubic_gaussian_atTop","statement":"Tendsto (fun x : ℝ => (10 * Real.log x + x ^ 3) * Real.exp (-(x ^ 2) / 8)) atTop (𝓝 (0 : ℝ))"},{"kind":"theorem","name":"tendsto_upper_shell_log_correction_atTop","statement":"Tendsto (fun x : ℝ => Real.exp (5 * Real.log x / x)) atTop (𝓝 (1 : ℝ))"},{"kind":"theorem","name":"tendsto_upperShellMarginRatio","statement":"Tendsto upperShellMarginRatio (𝓝[>] (0 : ℝ)) (𝓝 (0 : ℝ))"},{"kind":"theorem","name":"eventually_upper_shell_parameter_margin","statement":"∀ᶠ ε : ℝ in 𝓝[>] (0 : ℝ), upperShellShortCoefficient ε * Real.exp ((ε / 2) * shortEndpoint ε) ≤ (1 / 5000 : ℝ) * shellWeight ε * Real.exp ((ε / 2) * shellLocation ε)"},{"kind":"theorem","name":"upper_one_sub_cos_le_min","statement":"(x : ℝ) : 1 - Real.cos x ≤ min (x ^ 2 / 2) 2"},{"kind":"theorem","name":"upper_min_frequency_inverse_sq_le","statement":"{a : ℝ} (ha : 0 < a) (T : ℝ) : min (T ^ 2) ((a ^ 2)⁻¹) ≤ min (T ^ 2) 1 * (1 + (a ^ 2)⁻¹)"},{"kind":"theorem","name":"upper_shortShell_oscillation_div_sq_le","statement":"{a : ℝ} (ha : 0 < a) (T : ℝ) : (1 - Real.cos (a * T)) / (2 * a ^ 2) ≤ min (T ^ 2) ((a ^ 2)⁻¹)"},{"kind":"theorem","name":"upper_shortShellDensity_damping_le","statement":"{ε δ a A : ℝ} (hε : 0 < ε) (hδ : 0 ≤ δ) (ha : 0 < a) (haA : a ≤ A) (hmargin : 0 ≤ shortMargin ε a) (T : ℝ) : (-shortShellDensity ε a) * Real.cosh ((1 + δ) * a) * (1 - Real.cos (a * T)) ≤ Real.exp (δ * A) * min (T ^ 2) 1 * (1 + (a ^ 2)⁻¹)"},{"kind":"theorem","name":"upper_intervalIntegral_one_add_inv_sq","statement":"{a b : ℝ} (ha : 0 < a) (hab : a ≤ b) : (∫ x in a..b, 1 + (x ^ 2)⁻¹) = b - a + a⁻¹ - b⁻¹"},{"kind":"theorem","name":"upperShortShellDamping_global_bound","statement":"{ε ℓ δ T : ℝ} (hε : 0 < ε) (hℓ : 0 ≤ ℓ) (hδ : 0 ≤ δ) (horder : shortCutoff ε ≤ shortEndpoint ε) (hmargin : ∀ a ∈ Set.Icc (shortCutoff ε) (shortEndpoint ε), 0 ≤ shortMargin ε a) : upperShortShellDamping ε ℓ δ T ≤ ℓ * upperShellShortCoefficient ε * Real.exp (δ * shortEndpoint ε) * min (T ^ 2) 1"},{"kind":"theorem","name":"eventually_upper_shortCutoff_le_shortEndpoint","statement":"∀ᶠ ε : ℝ in 𝓝[>] (0 : ℝ), shortCutoff ε ≤ shortEndpoint ε"},{"kind":"theorem","name":"upper_shell_parameter_margin_propagate","statement":"{ε δ : ℝ} (hδ : ε / 2 ≤ δ) (hseparation : shortEndpoint ε ≤ shellLocation ε) (hmargin : upperShellShortCoefficient ε * Real.exp ((ε / 2) * shortEndpoint ε) ≤ (1 / 5000 : ℝ) * shellWeight ε * Real.exp ((ε / 2) * shellLocation ε)) : upperShellShortCoefficient ε * Real.exp (δ * shortEndpoint ε) ≤ (1 / 5000 : ℝ) * shellWeight ε * Real.exp (δ * shellLocation ε)"},{"kind":"theorem","name":"eventually_upper_shortShell_domination","statement":"∀ᶠ ε : ℝ in 𝓝[>] (0 : ℝ), ∀ ℓ : ℝ, 0 ≤ ℓ → ∀ δ : ℝ, ε / 2 ≤ δ → ∀ T : ℝ, upperShortShellDamping ε ℓ δ T ≤ (1 / 100 : ℝ) * positiveShellDamping ε ℓ δ T"},{"kind":"theorem","name":"upperPositiveShellVariance_bounds","statement":"{ε δ : ℝ} (hε : 0 < ε) (hδ : 0 ≤ δ) : (1 / 2 : ℝ) * (shellLocation ε) ^ 2 * shellWeight ε * Real.exp (δ * shellLocation ε) ≤ upperPositiveShellVariance ε δ ∧ upperPositiveShellVariance ε δ ≤ (shellLocation ε + 1) ^ 2 * shellWeight ε * Real.exp (δ * (shellLocation ε + 1))"},{"kind":"theorem","name":"upper_shortShellDensity_variance_le","statement":"{ε δ a A : ℝ} (hε : 0 < ε) (hδ : 0 ≤ δ) (ha : 0 < a) (haA : a ≤ A) : (-shortShellDensity ε a) * a ^ 2 * Real.cosh ((1 + δ) * a) ≤ (1 / 2 : ℝ) * Real.exp (δ * A)"},{"kind":"theorem","name":"upperShortShellVariance_global_bound","statement":"{ε δ : ℝ} (hε : 0 < ε) (hδ : 0 ≤ δ) (horder : shortCutoff ε ≤ shortEndpoint ε) : upperShortShellVariance ε δ ≤ (1 / 2 : ℝ) * upperShellShortCoefficient ε * Real.exp (δ * shortEndpoint ε)"},{"kind":"theorem","name":"upperShortShellVariance_nonneg","statement":"{ε δ : ℝ} (hε : 0 < ε) (horder : shortCutoff ε ≤ shortEndpoint ε) (hmargin : ∀ a ∈ Set.Icc (shortCutoff ε) (shortEndpoint ε), 0 ≤ shortMargin ε a) : 0 ≤ upperShortShellVariance ε δ"},{"kind":"theorem","name":"upper_shellLocation_one_le","statement":"{ε : ℝ} (hε : 0 < ε) (hεone : ε ≤ 1) : 1 ≤ shellLocation ε"},{"kind":"theorem","name":"eventually_upper_shortShellVariance_domination","statement":"∀ᶠ ε : ℝ in 𝓝[>] (0 : ℝ), ∀ δ : ℝ, ε / 2 ≤ δ → upperShortShellVariance ε δ ≤ (1 / 100 : ℝ) * upperPositiveShellVariance ε δ"},{"kind":"theorem","name":"eventually_upper_netShellVariance_bounds","statement":"∀ᶠ ε : ℝ in 𝓝[>] (0 : ℝ), ∀ δ : ℝ, ε / 2 ≤ δ → (99 / 100 : ℝ) * upperPositiveShellVariance ε δ ≤ upperNetShellVariance ε δ ∧ upperNetShellVariance ε δ ≤ upperPositiveShellVariance ε δ"},{"kind":"theorem","name":"upperPositiveShellThirdMoment_le","statement":"{ε δ : ℝ} (hε : 0 < ε) : upperPositiveShellThirdMoment ε δ ≤ (shellLocation ε + 1) * upperPositiveShellVariance ε δ"},{"kind":"theorem","name":"upperShortShellThirdMoment_le","statement":"{ε δ : ℝ} (hε : 0 < ε) (horder : shortCutoff ε ≤ shortEndpoint ε) (hmargin : ∀ a ∈ Set.Icc (shortCutoff ε) (shortEndpoint ε), 0 ≤ shortMargin ε a) : upperShortShellThirdMoment ε δ ≤ shortEndpoint ε * upperShortShellVariance ε δ"},{"kind":"theorem","name":"eventually_upper_shortShellThirdMoment_domination","statement":"∀ᶠ ε : ℝ in 𝓝[>] (0 : ℝ), ∀ δ : ℝ, ε / 2 ≤ δ → upperShortShellThirdMoment ε δ ≤ (shortEndpoint ε / 100) * upperPositiveShellVariance ε δ"},{"kind":"theorem","name":"eventually_upper_netShellThirdMoment_bound","statement":"∀ᶠ ε : ℝ in 𝓝[>] (0 : ℝ), ∀ δ : ℝ, ε / 2 ≤ δ → upperNetShellThirdMoment ε δ ≤ (shellLocation ε + 1 + shortEndpoint ε / 100) * upperPositiveShellVariance ε δ"},{"kind":"theorem","name":"upper_inv_one_sub_exp_neg_bounds","statement":"{x : ℝ} (hx : 0 < x) : x⁻¹ ≤ (1 - Real.exp (-x))⁻¹ ∧ (1 - Real.exp (-x))⁻¹ ≤ 1 + x⁻¹"},{"kind":"theorem","name":"upper_laplace_monomial_integrable","statement":"{η : ℝ} (hη : 0 < η) (k : ℕ) : IntegrableOn (fun a : ℝ => a ^ k * Real.exp (-η * a)) (Set.Ioi 0)"},{"kind":"theorem","name":"upper_laplace_monomial_integral","statement":"{η : ℝ} (hη : 0 < η) (k : ℕ) : (∫ a : ℝ in Set.Ioi 0, a ^ k * Real.exp (-η * a)) = (k.factorial : ℝ) / η ^ (k + 1)"},{"kind":"theorem","name":"upperGammaVarianceDensity_pointwise_bounds","statement":"{ℓ η a : ℝ} (hℓ : 0 < ℓ) (ha : 0 < a) : (ℓ / 2) * Real.exp (-η * a) ≤ a ^ 2 * upperGammaMeasureDensity ℓ η a ∧ a ^ 2 * upperGammaMeasureDensity ℓ η a ≤ (a + ℓ / 2) * Real.exp (-η * a)"},{"kind":"theorem","name":"upperGammaThirdMomentDensity_pointwise_bounds","statement":"{ℓ η a : ℝ} (hℓ : 0 < ℓ) (ha : 0 < a) : (ℓ / 2) * a * Real.exp (-η * a) ≤ a ^ 3 * upperGammaMeasureDensity ℓ η a ∧ a ^ 3 * upperGammaMeasureDensity ℓ η a ≤ (a ^ 2 + (ℓ / 2) * a) * Real.exp (-η * a)"},{"kind":"theorem","name":"upperGammaVarianceDensity_integrable","statement":"{ℓ η : ℝ} (hℓ : 0 < ℓ) (hη : 0 < η) : IntegrableOn (fun a : ℝ => a ^ 2 * upperGammaMeasureDensity ℓ η a) (Set.Ioi 0)"},{"kind":"theorem","name":"upperGammaThirdMomentDensity_integrable","statement":"{ℓ η : ℝ} (hℓ : 0 < ℓ) (hη : 0 < η) : IntegrableOn (fun a : ℝ => a ^ 3 * upperGammaMeasureDensity ℓ η a) (Set.Ioi 0)"},{"kind":"theorem","name":"upperGammaVariance_bounds","statement":"{ℓ η : ℝ} (hℓ : 0 < ℓ) (hη : 0 < η) : 1 / (2 * η) ≤ upperGammaVariance ℓ η ∧ upperGammaVariance ℓ η ≤ 1 / (2 * η) + 1 / (ℓ * η ^ 2)"},{"kind":"theorem","name":"upperGammaThirdMoment_bounds","statement":"{ℓ η : ℝ} (hℓ : 0 < ℓ) (hη : 0 < η) : 1 / (2 * η ^ 2) ≤ upperGammaThirdMoment ℓ η ∧ upperGammaThirdMoment ℓ η ≤ 1 / (2 * η ^ 2) + 2 / (ℓ * η ^ 3)"},{"kind":"theorem","name":"plusPolynomial_negative_imaginary_residue","statement":"(ε s : ℝ) : plusPolynomial ε (Complex.I * ((-(1 + s) : ℝ) : ℂ)) = ((beta ε - s * (2 + s) ^ 2 : ℝ) : ℂ)"},{"kind":"theorem","name":"plusSaddlePoleResidue_explicit_real","statement":"{ε ℓ : ℝ} (hℓ : 0 < ℓ) (n : ℕ) : plusSaddlePoleResidue ε ℓ n = ((2 * (-1 : ℝ) ^ n / (n.factorial : ℝ) * (Real.pi ^ (ℓ / 2 + (n : ℝ)) * Real.exp (ℓ * realHyperbolicShellPhase ε (1 + 2 * (n : ℝ) / ℓ))) * (beta ε - (2 * (n : ℝ) / ℓ) * (2 + 2 * (n : ℝ) / ℓ) ^ 2) : ℝ) : ℂ)"},{"kind":"theorem","name":"saddleSmallRadiusVariable_nonneg","statement":"(ε r : ℝ) : 0 ≤ saddleSmallRadiusVariable ε r"},{"kind":"theorem","name":"saddleSmallRadiusVariable_neg_pow","statement":"(ε r : ℝ) (n : ℕ) : (-saddleSmallRadiusVariable ε r) ^ n = (-1 : ℝ) ^ n * Real.pi ^ n * Real.exp (2 * saddleShellDerivativeOne ε) ^ n * r ^ (2 * n)"},{"kind":"theorem","name":"saddleSmallRadiusPhase_pole_factorization","statement":"(ε ℓ : ℝ) (n : ℕ) : Real.exp (ℓ * realHyperbolicShellPhase ε (1 + 2 * (n : ℝ) / ℓ)) = Real.exp (ℓ * realHyperbolicShellPhase ε 1) * Real.exp (2 * saddleShellDerivativeOne ε) ^ n * Real.exp (ℓ * (realHyperbolicShellPhase ε (1 + 2 * (n : ℝ) / ℓ) - realHyperbolicShellPhase ε 1) - 2 * (n : ℝ) * saddleShellDerivativeOne ε)"},{"kind":"theorem","name":"plusSaddlePoleResidue_mul_pow_eq_smallCoefficient","statement":"{ε ℓ : ℝ} (hε : 0 < ε) (hℓ : 0 < ℓ) (n : ℕ) (r : ℝ) : plusSaddlePoleResidue ε ℓ n * ((r ^ (2 * n) : ℝ) : ℂ) = ((saddleOriginValue ε ℓ * ((-saddleSmallRadiusVariable ε r) ^ n / (n.factorial : ℝ)) * plusSaddleSmallRadiusCoefficient ε ℓ n : ℝ) : ℂ)"},{"kind":"theorem","name":"plusSaddleProfile_eq_small_radius_residue_series","statement":"{ε ℓ r : ℝ} (hε : 0 < ε) (hℓ : 0 < ℓ) (horder : shortCutoff ε ≤ shortEndpoint ε) (hr : 0 < r) (N : ℕ) : plusSaddleProfile ε ℓ r = (saddleOriginValue ε ℓ : ℂ) * ((∑ n ∈ Finset.range (N + 1), (-saddleSmallRadiusVariable ε r) ^ n / (n.factorial : ℝ) * plusSaddleSmallRadiusCoefficient ε ℓ n : ℝ) : ℂ) + plusSaddleTaylorRemainder ε ℓ N r"},{"kind":"theorem","name":"plusSaddleProfile_div_origin_eq_small_radius_residue_series","statement":"{ε ℓ r : ℝ} (hε : 0 < ε) (hℓ : 0 < ℓ) (horder : shortCutoff ε ≤ shortEndpoint ε) (hr : 0 < r) (N : ℕ) : plusSaddleProfile ε ℓ r / (saddleOriginValue ε ℓ : ℂ) = ((∑ n ∈ Finset.range (N + 1), (-saddleSmallRadiusVariable ε r) ^ n / (n.factorial : ℝ) * plusSaddleSmallRadiusCoefficient ε ℓ n : ℝ) : ℂ) + plusSaddleTaylorRemainder ε ℓ N r / (saddleOriginValue ε ℓ : ℂ)"},{"kind":"theorem","name":"realHyperbolicShellPhase_contDiff","statement":"{ε : ℝ} (hε : 0 < ε) (horder : shortCutoff ε ≤ shortEndpoint ε) (n : WithTop ℕ∞) : ContDiff ℝ n (realHyperbolicShellPhase ε)"},{"kind":"theorem","name":"realHyperbolicShellInterval_hasDerivAt","statement":"(w : ℝ → ℝ) (hw : Continuous w) {a b : ℝ} (hab : a ≤ b) (u : ℝ) : HasDerivAt (fun v : ℝ => ∫ x in a..b, w x * (Real.cosh (x * v) - 1)) (∫ x in a..b, w x * x * Real.sinh (x * u)) u"},{"kind":"theorem","name":"realHyperbolicShellPhase_hasDerivAt","statement":"{ε : ℝ} (hε : 0 < ε) (horder : shortCutoff ε ≤ shortEndpoint ε) (u : ℝ) : HasDerivAt (realHyperbolicShellPhase ε) ((∫ a in shortCutoff ε..shortEndpoint ε, shortShellDensity ε a * a * Real.sinh (a * u)) + (∫ a in shellLocation ε..shellLocation ε + 1, positiveShellDensity ε a * a * Real.sinh (a * u))) u"},{"kind":"theorem","name":"realHyperbolicShellPhase_hasDerivAt_one","statement":"{ε : ℝ} (hε : 0 < ε) (horder : shortCutoff ε ≤ shortEndpoint ε) : HasDerivAt (realHyperbolicShellPhase ε) (saddleShellDerivativeOne ε) 1"},{"kind":"theorem","name":"exists_realHyperbolicShellPhase_quadratic_remainder","statement":"{ε : ℝ} (hε : 0 < ε) (horder : shortCutoff ε ≤ shortEndpoint ε) : ∃ C : ℝ, 0 ≤ C ∧ ∀ x ∈ Set.Icc (1 : ℝ) 2, |realHyperbolicShellPhase ε x - realHyperbolicShellPhase ε 1 - (x - 1) * saddleShellDerivativeOne ε| ≤ C * (x - 1) ^ 2"},{"kind":"theorem","name":"exists_plusSaddleSmallRadiusPhase_error","statement":"{ε : ℝ} (hε : 0 < ε) (horder : shortCutoff ε ≤ shortEndpoint ε) : ∃ C : ℝ, 0 ≤ C ∧ ∀ (ℓ : ℝ), 0 < ℓ → ∀ n : ℕ, 2 * (n : ℝ) ≤ ℓ → |ℓ * (realHyperbolicShellPhase ε (1 + 2 * (n : ℝ) / ℓ) - realHyperbolicShellPhase ε 1) - 2 * (n : ℝ) * saddleShellDerivativeOne ε| ≤ C * (n : ℝ) ^ 2 / ℓ"},{"kind":"theorem","name":"plusSaddleSmallRadiusPolynomial_error","statement":"{ε ℓ : ℝ} (hε : 0 < ε) (hℓ : 0 < ℓ) (n : ℕ) (hn : 2 * (n : ℝ) ≤ ℓ) : |((beta ε - (2 * (n : ℝ) / ℓ) * (2 + 2 * (n : ℝ) / ℓ) ^ 2) / beta ε) - 1| ≤ (18 / beta ε) * ((n : ℝ) / ℓ)"},{"kind":"theorem","name":"abs_exp_sub_one_le_abs_mul_exp_abs","statement":"(t : ℝ) : |Real.exp t - 1| ≤ |t| * Real.exp |t|"},{"kind":"theorem","name":"plusSaddleSmallRadiusCoefficient_error_of_phase","statement":"{ε ℓ : ℝ} (hε : 0 < ε) (hℓ : 0 < ℓ) (n : ℕ) (hn : 2 * (n : ℝ) ≤ ℓ) (C : ℝ) (hC : 0 ≤ C) (hphase : |ℓ * (realHyperbolicShellPhase ε (1 + 2 * (n : ℝ) / ℓ) - realHyperbolicShellPhase ε 1) - 2 * (n : ℝ) * saddleShellDerivativeOne ε| ≤ C * (n : ℝ) ^ 2 / ℓ) : |plusSaddleSmallRadiusCoefficient ε ℓ n - 1| ≤ (C * (n : ℝ) ^ 2 / ℓ + (18 / beta ε) * ((n : ℝ) / ℓ)) * Real.exp (C * (n : ℝ) ^ 2 / ℓ)"},{"kind":"theorem","name":"exists_plusSaddleSmallRadiusCoefficient_error","statement":"{ε : ℝ} (hε : 0 < ε) (horder : shortCutoff ε ≤ shortEndpoint ε) : ∃ C : ℝ, 0 ≤ C ∧ ∀ (ℓ : ℝ), 0 < ℓ → ∀ n : ℕ, 2 * (n : ℝ) ≤ ℓ → |plusSaddleSmallRadiusCoefficient ε ℓ n - 1| ≤ (C * ((n : ℝ) + (n : ℝ) ^ 2) / ℓ) * Real.exp (C * (n : ℝ) ^ 2 / ℓ)"},{"kind":"theorem","name":"saddleExpSeries_hasSum","statement":"(y : ℝ) : HasSum (fun n : ℕ => y ^ n / (n.factorial : ℝ)) (Real.exp y)"},{"kind":"theorem","name":"saddleExpSeries_firstMoment_hasSum","statement":"(y : ℝ) : HasSum (fun n : ℕ => (n : ℝ) * (y ^ n / (n.factorial : ℝ))) (y * Real.exp y)"},{"kind":"theorem","name":"saddleExpSeries_secondFallingMoment_hasSum","statement":"(y : ℝ) : HasSum (fun n : ℕ => (n : ℝ) * ((n : ℝ) - 1) * (y ^ n / (n.factorial : ℝ))) (y ^ 2 * Real.exp y)"},{"kind":"theorem","name":"saddleExpSeries_polynomialMoment_hasSum","statement":"(y : ℝ) : HasSum (fun n : ℕ => ((n : ℝ) + (n : ℝ) ^ 2) * (y ^ n / (n.factorial : ℝ))) ((2 * y + y ^ 2) * Real.exp y)"},{"kind":"theorem","name":"saddleExpSeries_polynomialMoment_sum_range_le","statement":"{y : ℝ} (hy : 0 ≤ y) (N : ℕ) : (∑ n ∈ Finset.range N, ((n : ℝ) + (n : ℝ) ^ 2) * (y ^ n / (n.factorial : ℝ))) ≤ (2 * y + y ^ 2) * Real.exp y"},{"kind":"theorem","name":"exists_plusSaddleSmallRadius_weightedCoefficient_error","statement":"{ε : ℝ} (hε : 0 < ε) (horder : shortCutoff ε ≤ shortEndpoint ε) : ∃ C : ℝ, 0 ≤ C ∧ ∀ (ℓ : ℝ), 0 < ℓ → ∀ N : ℕ, 2 * (N : ℝ) ≤ ℓ → ∀ y : ℝ, 0 ≤ y → (∑ n ∈ Finset.range (N + 1), (y ^ n / (n.factorial : ℝ)) * |plusSaddleSmallRadiusCoefficient ε ℓ n - 1|) ≤ (C / ℓ) * Real.exp (C * (N : ℝ) ^ 2 / ℓ) * (2 * y + y ^ 2) * Real.exp y"},{"kind":"theorem","name":"saddleExpSeries_tail_term_le_geometric","statement":"{y : ℝ} (hy : 0 ≤ y) (m : ℕ) (hym : 2 * y ≤ (m : ℝ) + 1) (k : ℕ) : y ^ (m + k) / ((m + k).factorial : ℝ) ≤ (y ^ m / (m.factorial : ℝ)) * ((1 / 2 : ℝ) ^ k)"},{"kind":"theorem","name":"saddleExpSeries_alternating_tail_bound","statement":"{y : ℝ} (hy : 0 ≤ y) (m : ℕ) (hym : 2 * y ≤ (m : ℝ) + 1) : |Real.exp (-y) - (∑ n ∈ Finset.range m, (-y) ^ n / (n.factorial : ℝ))| ≤ 2 * (y ^ m / (m.factorial : ℝ))"},{"kind":"theorem","name":"exists_plusSaddleSmallRadius_finiteResidue_error","statement":"{ε : ℝ} (hε : 0 < ε) (horder : shortCutoff ε ≤ shortEndpoint ε) : ∃ C : ℝ, 0 ≤ C ∧ ∀ (ℓ : ℝ), 0 < ℓ → ∀ N : ℕ, 2 * (N : ℝ) ≤ ℓ → ∀ y : ℝ, 0 ≤ y → 2 * y ≤ (N : ℝ) + 2 → |(∑ n ∈ Finset.range (N + 1), ((-y) ^ n / (n.factorial : ℝ)) * plusSaddleSmallRadiusCoefficient ε ℓ n) - Real.exp (-y)| ≤ (C / ℓ) * Real.exp (C * (N : ℝ) ^ 2 / ℓ) * (2 * y + y ^ 2) * Real.exp y + 2 * (y ^ (N + 1) / ((N + 1).factorial : ℝ))"},{"kind":"theorem","name":"exists_plusSaddleSmallRadius_relativeFiniteResidue_error","statement":"{ε : ℝ} (hε : 0 < ε) (horder : shortCutoff ε ≤ shortEndpoint ε) : ∃ C : ℝ, 0 ≤ C ∧ ∀ (ℓ : ℝ), 0 < ℓ → ∀ N : ℕ, 2 * (N : ℝ) ≤ ℓ → ∀ y : ℝ, 0 ≤ y → 2 * y ≤ (N : ℝ) + 2 → Real.exp y * |(∑ n ∈ Finset.range (N + 1), ((-y) ^ n / (n.factorial : ℝ)) * plusSaddleSmallRadiusCoefficient ε ℓ n) - Real.exp (-y)| ≤ (C / ℓ) * Real.exp (C * (N : ℝ) ^ 2 / ℓ) * (2 * y + y ^ 2) * Real.exp (2 * y) + 2 * Real.exp y * (y ^ (N + 1) / ((N + 1).factorial : ℝ))"},{"kind":"theorem","name":"upperGammaMeasureDensity_pos","statement":"{ℓ η a : ℝ} (hℓ : 0 < ℓ) (ha : 0 < a) : 0 < upperGammaMeasureDensity ℓ η a"},{"kind":"theorem","name":"upper_one_sub_cos_quadratic_lower","statement":"{x : ℝ} (hx : |x| ≤ 1) : x ^ 2 / 4 ≤ 1 - Real.cos x"},{"kind":"theorem","name":"upperGammaDampingIntegrand_integrable","statement":"{ℓ η : ℝ} (hℓ : 0 < ℓ) (hη : 0 < η) (T : ℝ) : IntegrableOn (upperGammaDampingIntegrand ℓ η T) (Ioi 0)"},{"kind":"theorem","name":"upperGammaDamping_nonneg","statement":"{ℓ η : ℝ} (hℓ : 0 < ℓ) (T : ℝ) : 0 ≤ upperGammaDamping ℓ η T"},{"kind":"theorem","name":"upperGammaDampingIntegrand_lower_on_window","statement":"{ℓ η T a : ℝ} (hℓ : 0 < ℓ) (hη : 0 < η) (ha : 0 < a) (haη : a ≤ η⁻¹) (haT : a ≤ |T|⁻¹) (hT : T ≠ 0) : (ℓ / (8 * Real.exp 1)) * T ^ 2 ≤ upperGammaDampingIntegrand ℓ η T a"},{"kind":"theorem","name":"upperGammaDamping_lower_bound","statement":"{ℓ η : ℝ} (hℓ : 0 < ℓ) (hη : 0 < η) (T : ℝ) : (ℓ / (8 * Real.exp 1)) * min (T ^ 2 / η) |T| ≤ upperGammaDamping ℓ η T"},{"kind":"theorem","name":"eventually_upperSaddleDamping_gamma_add_shell","statement":"∀ᶠ ε : ℝ in 𝓝[>] (0 : ℝ), ∀ ℓ : ℝ, 0 < ℓ → ∀ δ : ℝ, ε / 2 ≤ δ → ∀ T : ℝ, upperGammaDamping ℓ (2 + δ) T + (99 / 100 : ℝ) * positiveShellDamping ε ℓ δ T ≤ upperSaddleDamping ε ℓ δ T"},{"kind":"theorem","name":"eventually_upperSaddleVariance_bounds","statement":"∀ᶠ ε : ℝ in 𝓝[>] (0 : ℝ), ∀ ℓ : ℝ, 0 < ℓ → ∀ δ : ℝ, ε / 2 ≤ δ → 1 / (2 * (2 + δ)) + (99 / 100 : ℝ) * upperPositiveShellVariance ε δ ≤ upperSaddleVariance ε ℓ δ ∧ upperSaddleVariance ε ℓ δ ≤ (1 / (2 * (2 + δ)) + 1 / (ℓ * (2 + δ) ^ 2)) + upperPositiveShellVariance ε δ"},{"kind":"theorem","name":"upperPositiveShellVariance_pos","statement":"{ε δ : ℝ} (hε : 0 < ε) (hδ : 0 ≤ δ) : 0 < upperPositiveShellVariance ε δ"},{"kind":"theorem","name":"eventually_upperSaddleVariance_pos","statement":"∀ᶠ ε : ℝ in 𝓝[>] (0 : ℝ), ∀ ℓ : ℝ, 0 < ℓ → ∀ δ : ℝ, ε / 2 ≤ δ → 0 < upperSaddleVariance ε ℓ δ"},{"kind":"theorem","name":"upperGammaThirdMoment_le_two_mul_variance","statement":"{ℓ η : ℝ} (hℓ : 1 ≤ ℓ) (hη : 2 ≤ η) : upperGammaThirdMoment ℓ η ≤ 2 * upperGammaVariance ℓ η"},{"kind":"theorem","name":"eventually_upperSaddleThirdMoment_le_variance","statement":"∀ᶠ ε : ℝ in 𝓝[>] (0 : ℝ), ∀ ℓ : ℝ, 1 ≤ ℓ → ∀ δ : ℝ, ε / 2 ≤ δ → upperSaddleThirdMoment ε ℓ δ ≤ (2 + (100 / 99 : ℝ) * upperSaddleShellThirdCoefficient ε) * upperSaddleVariance ε ℓ δ"},{"kind":"theorem","name":"upperShortMargin_mul_exp_antitone","statement":"{ε : ℝ} (hε : 0 < ε) : AntitoneOn (fun a : ℝ => shortMargin ε a * Real.exp (ε * a)) (Ici (0 : ℝ))"},{"kind":"theorem","name":"upperShortMargin_mul_exp_le_zero_value","statement":"{ε a : ℝ} (hε : 0 < ε) (ha : 0 ≤ a) : shortMargin ε a * Real.exp (ε * a) ≤ 1 - 10 * ε"},{"kind":"theorem","name":"upperFirstBranch_shortRatio_le","statement":"{ε u a : ℝ} (hε : 0 < ε) (ha : 0 ≤ a) (hulower : -1 ≤ u) (huupper : u ≤ 1 + ε / 2) (hmargin : 0 ≤ shortMargin ε a) : shortMargin ε a * Real.exp ((u - 1) * a) * (Real.cosh (u * a) / Real.cosh a) ≤ 1 - 4 * ε"},{"kind":"theorem","name":"upperFirstBranch_shortMeasure_pointwise","statement":"{ε ℓ u a : ℝ} (hε : 0 < ε) (hεsmall : ε ≤ 1 / 4) (hℓ : 0 < ℓ) (ha : 0 < a) (hulower : -1 ≤ u) (huupper : u ≤ 1 + ε / 2) (hmargin : 0 ≤ shortMargin ε a) : ℓ * (-shortShellDensity ε a) * Real.cosh (u * a) ≤ (1 - 4 * ε) * upperGammaMeasureDensity ℓ (1 + u) a"},{"kind":"theorem","name":"upperFirstBranch_shortDamping_le_gamma","statement":"{ε ℓ u : ℝ} (hε : 0 < ε) (hεsmall : ε ≤ 1 / 4) (hℓ : 0 < ℓ) (hulower : -1 < u) (huupper : u ≤ 1 + ε / 2) (horder : shortCutoff ε ≤ shortEndpoint ε) (hmargin : ∀ a ∈ Icc (shortCutoff ε) (shortEndpoint ε), 0 ≤ shortMargin ε a) (T : ℝ) : upperShortShellDamping ε ℓ (u - 1) T ≤ (1 - 4 * ε) * upperGammaDamping ℓ (1 + u) T"},{"kind":"theorem","name":"positiveShellDamping_nonneg","statement":"{ε ℓ δ T : ℝ} (hℓ : 0 ≤ ℓ) : 0 ≤ positiveShellDamping ε ℓ δ T"},{"kind":"theorem","name":"upperFirstBranchSaddleDamping_lower_bound","statement":"{ε ℓ u : ℝ} (hε : 0 < ε) (hεsmall : ε ≤ 1 / 4) (hℓ : 0 < ℓ) (hulower : -1 < u) (huupper : u ≤ 1 + ε / 2) (horder : shortCutoff ε ≤ shortEndpoint ε) (hmargin : ∀ a ∈ Icc (shortCutoff ε) (shortEndpoint ε), 0 ≤ shortMargin ε a) (T : ℝ) : 4 * ε * upperGammaDamping ℓ (1 + u) T ≤ upperFirstBranchSaddleDamping ε ℓ u T"},{"kind":"theorem","name":"saddle_shifted_complexCos_re","statement":"(a T u : ℝ) : (Complex.cos ((a : ℂ) * ((T : ℂ) + Complex.I * (u : ℂ)))).re = Real.cos (a * T) * Real.cosh (a * u)"},{"kind":"theorem","name":"saddle_complexShellInterval_re","statement":"(w : ℝ → ℝ) {a b : ℝ} (hab : a ≤ b) (hw : ContinuousOn w (Icc a b)) (T u : ℝ) : (∫ x in a..b, (w x : ℂ) * (Complex.cos ((x : ℂ) * ((T : ℂ) + Complex.I * (u : ℂ))) - 1)).re = ∫ x in a..b, w x * (Real.cos (x * T) * Real.cosh (x * u) - 1)"},{"kind":"theorem","name":"shortShellDensity_continuousOn_support","statement":"{ε : ℝ} (hε : 0 < ε) : ContinuousOn (shortShellDensity ε) (Icc (shortCutoff ε) (shortEndpoint ε))"},{"kind":"theorem","name":"mellinShellPhase_shifted_re","statement":"{ε : ℝ} (hε : 0 < ε) (horder : shortCutoff ε ≤ shortEndpoint ε) (T u : ℝ) : (mellinShellPhase ε ((T : ℂ) + Complex.I * (u : ℂ))).re = (∫ a in shortCutoff ε..shortEndpoint ε, shortShellDensity ε a * (Real.cos (a * T) * Real.cosh (a * u) - 1)) + (∫ a in shellLocation ε..shellLocation ε + 1, positiveShellDensity ε a * (Real.cos (a * T) * Real.cosh (a * u) - 1))"},{"kind":"theorem","name":"saddle_shellInterval_hyperbolic_sub_oscillatory","statement":"(w : ℝ → ℝ) {a b : ℝ} (hab : a ≤ b) (hw : ContinuousOn w (Icc a b)) (T u : ℝ) : (∫ x in a..b, w x * (Real.cosh (x * u) - 1)) - (∫ x in a..b, w x * (Real.cos (x * T) * Real.cosh (x * u) - 1)) = ∫ x in a..b, w x * Real.cosh (x * u) * (1 - Real.cos (x * T))"},{"kind":"theorem","name":"saddleShellPhase_damping_identity","statement":"{ε : ℝ} (hε : 0 < ε) (horder : shortCutoff ε ≤ shortEndpoint ε) (ℓ T u : ℝ) : ℓ * (realHyperbolicShellPhase ε u - (mellinShellPhase ε ((T : ℂ) + Complex.I * (u : ℂ))).re) = positiveShellDamping ε ℓ (u - 1) T - upperShortShellDamping ε ℓ (u - 1) T"},{"kind":"theorem","name":"radialCriticalLogProfile_eq_reflected_tilt","statement":"{d : ℕ} (hd : 0 < d) (f : TestFunction d) (u : ℝ) : radialCriticalLogProfile hd f u = schwartzExponentialTilt (radialSchwartzProfile hd f) ((d : ℝ) / 2) 1 (-u)"},{"kind":"theorem","name":"radialCriticalLogProfile_integrable","statement":"{d : ℕ} (hd : 0 < d) (f : TestFunction d) : Integrable (radialCriticalLogProfile hd f)"},{"kind":"theorem","name":"radialCriticalLogProfile_continuous","statement":"{d : ℕ} (hd : 0 < d) (f : TestFunction d) : Continuous (radialCriticalLogProfile hd f)"},{"kind":"theorem","name":"radialCriticalLogProfile_fourier_integrable","statement":"{d : ℕ} (hd : 0 < d) (f : TestFunction d) : Integrable (𝓕 (radialCriticalLogProfile hd f) : ℝ → ℂ)"},{"kind":"theorem","name":"radialMellinFrequency_eq_criticalLogFourier","statement":"{d : ℕ} (hd : 0 < d) (f : TestFunction d) (t : ℝ) : radialMellinFrequency hd f t = (𝓕 (radialCriticalLogProfile hd f) : ℝ → ℂ) (-t / (2 * Real.pi))"},{"kind":"theorem","name":"plusSaddleFourierData_continuous","statement":"{ε ℓ : ℝ} (hε : 0 < ε) (hℓ : 0 < ℓ) (horder : shortCutoff ε ≤ shortEndpoint ε) : Continuous (plusSaddleFourierData ε ℓ)"},{"kind":"theorem","name":"minusSaddleFourierData_continuous","statement":"{ε ℓ : ℝ} (hε : 0 < ε) (hℓ : 0 < ℓ) (horder : shortCutoff ε ≤ shortEndpoint ε) : Continuous (minusSaddleFourierData ε ℓ)"},{"kind":"theorem","name":"plusSaddleFourierData_integrable","statement":"{ε ℓ : ℝ} (hε : 0 < ε) (hℓ : 0 < ℓ) (horder : shortCutoff ε ≤ shortEndpoint ε) : Integrable (plusSaddleFourierData ε ℓ)"},{"kind":"theorem","name":"minusSaddleFourierData_integrable","statement":"{ε ℓ : ℝ} (hε : 0 < ε) (hℓ : 0 < ℓ) (horder : shortCutoff ε ≤ shortEndpoint ε) : Integrable (minusSaddleFourierData ε ℓ)"},{"kind":"theorem","name":"radialProfile_eq_plusSaddleProfile_of_source","statement":"{ε : ℝ} {d : ℕ} (hd : 0 < d) (f : TestFunction d) (hf : ∀ x : Euclidean d, f x = plusSaddleFunction ε d x) {r : ℝ} (hr : 0 ≤ r) : radialProfile hd f r = plusSaddleProfile ε ((d : ℝ) / 2) r"},{"kind":"theorem","name":"radialProfile_eq_minusSaddleProfile_of_source","statement":"{ε : ℝ} {d : ℕ} (hd : 0 < d) (f : TestFunction d) (hf : ∀ x : Euclidean d, f x = minusSaddleFunction ε d x) {r : ℝ} (hr : 0 ≤ r) : radialProfile hd f r = minusSaddleProfile ε ((d : ℝ) / 2) r"},{"kind":"theorem","name":"exp_neg_rpow_neg_half_dimension","statement":"{d : ℕ} (u : ℝ) : (Real.exp (-u)) ^ (-((d : ℝ) / 2)) = Real.exp (((d : ℝ) / 2) * u)"},{"kind":"theorem","name":"plusSaddleCriticalLogProfile_eq_fourierInv","statement":"{ε : ℝ} {d : ℕ} (hd : 0 < d) (f : TestFunction d) (hf : ∀ x : Euclidean d, f x = plusSaddleFunction ε d x) : radialCriticalLogProfile hd f = (𝓕⁻ (plusSaddleFourierData ε ((d : ℝ) / 2)) : ℝ → ℂ)"},{"kind":"theorem","name":"minusSaddleCriticalLogProfile_eq_fourierInv","statement":"{ε : ℝ} {d : ℕ} (hd : 0 < d) (f : TestFunction d) (hf : ∀ x : Euclidean d, f x = minusSaddleFunction ε d x) : radialCriticalLogProfile hd f = (𝓕⁻ (minusSaddleFourierData ε ((d : ℝ) / 2)) : ℝ → ℂ)"},{"kind":"theorem","name":"plusSaddleFourierData_fourier_integrable_of_source","statement":"{ε : ℝ} {d : ℕ} (hd : 0 < d) (f : TestFunction d) (hf : ∀ x : Euclidean d, f x = plusSaddleFunction ε d x) : Integrable (𝓕 (plusSaddleFourierData ε ((d : ℝ) / 2)) : ℝ → ℂ)"},{"kind":"theorem","name":"minusSaddleFourierData_fourier_integrable_of_source","statement":"{ε : ℝ} {d : ℕ} (hd : 0 < d) (f : TestFunction d) (hf : ∀ x : Euclidean d, f x = minusSaddleFunction ε d x) : Integrable (𝓕 (minusSaddleFourierData ε ((d : ℝ) / 2)) : ℝ → ℂ)"},{"kind":"theorem","name":"plusSaddle_radialMellinFrequency_of_source","statement":"{ε : ℝ} (hε : 0 < ε) {d : ℕ} (hd : 0 < d) (horder : shortCutoff ε ≤ shortEndpoint ε) (f : TestFunction d) (hf : ∀ x : Euclidean d, f x = plusSaddleFunction ε d x) (t : ℝ) : radialMellinFrequency hd f t = plusSaddleSpectrum ε ((d : ℝ) / 2) t"},{"kind":"theorem","name":"minusSaddle_radialMellinFrequency_of_source","statement":"{ε : ℝ} (hε : 0 < ε) {d : ℕ} (hd : 0 < d) (horder : shortCutoff ε ≤ shortEndpoint ε) (f : TestFunction d) (hf : ∀ x : Euclidean d, f x = minusSaddleFunction ε d x) (t : ℝ) : radialMellinFrequency hd f t = minusSaddleSpectrum ε ((d : ℝ) / 2) t"},{"kind":"theorem","name":"radialMellinFrequency_injective","statement":"{d : ℕ} (hd : 0 < d) {f g : TestFunction d} (hf : IsRadial f) (hg : IsRadial g) (hfrequency : ∀ t : ℝ, radialMellinFrequency hd f t = radialMellinFrequency hd g t) : f = g"},{"kind":"theorem","name":"plusSaddle_radial_of_source","statement":"{ε : ℝ} {d : ℕ} (f : TestFunction d) (hf : ∀ x : Euclidean d, f x = plusSaddleFunction ε d x) : IsRadial f"},{"kind":"theorem","name":"minusSaddle_radial_of_source","statement":"{ε : ℝ} {d : ℕ} (f : TestFunction d) (hf : ∀ x : Euclidean d, f x = minusSaddleFunction ε d x) : IsRadial f"},{"kind":"theorem","name":"plusSaddle_real_of_source","statement":"{ε : ℝ} {d : ℕ} (f : TestFunction d) (hf : ∀ x : Euclidean d, f x = plusSaddleFunction ε d x) : IsRealValued f"},{"kind":"theorem","name":"minusSaddle_real_of_source","statement":"{ε : ℝ} {d : ℕ} (f : TestFunction d) (hf : ∀ x : Euclidean d, f x = minusSaddleFunction ε d x) : IsRealValued f"},{"kind":"theorem","name":"saddleSource_fourier_minus_eq_plus","statement":"{ε : ℝ} (hε : 0 < ε) {d : ℕ} (hd : 0 < d) (horder : shortCutoff ε ≤ shortEndpoint ε) (fminus fplus : TestFunction d) (hminus : ∀ x : Euclidean d, fminus x = minusSaddleFunction ε d x) (hplus : ∀ x : Euclidean d, fplus x = plusSaddleFunction ε d x) : (𝓕 fminus : TestFunction d) = fplus"},{"kind":"theorem","name":"saddleSource_zero_pos","statement":"{ε : ℝ} (hε : 0 < ε) {d : ℕ} (fminus fplus : TestFunction d) (hminus : ∀ x : Euclidean d, fminus x = minusSaddleFunction ε d x) (hplus : ∀ x : Euclidean d, fplus x = plusSaddleFunction ε d x) : 0 < (fminus (0 : Euclidean d)).re ∧ 0 < (fplus (0 : Euclidean d)).re"},{"kind":"theorem","name":"saddleSource_zero_eq","statement":"{ε : ℝ} {d : ℕ} (fminus fplus : TestFunction d) (hminus : ∀ x : Euclidean d, fminus x = minusSaddleFunction ε d x) (hplus : ∀ x : Euclidean d, fplus x = plusSaddleFunction ε d x) : fminus (0 : Euclidean d) = fplus (0 : Euclidean d)"},{"kind":"theorem","name":"saddleSourceAdmissible_quotient","statement":"{ε : ℝ} (hε : 0 < ε) {d : ℕ} (hd : 0 < d) (horder : shortCutoff ε ≤ shortEndpoint ε) {R : ℝ} (hR : 0 < R) (fminus fplus : TestFunction d) (hminus : ∀ x : Euclidean d, fminus x = minusSaddleFunction ε d x) (hplus : ∀ x : Euclidean d, fplus x = plusSaddleFunction ε d x) (hplusnonneg : ∀ x : Euclidean d, 0 ≤ (plusSaddleFunction ε d x).re) (hminusoutside : ∀ x : Euclidean d, R ≤ ‖x‖ → (minusSaddleFunction ε d x).re ≤ 0) : quotient (saddleSourceAdmissible hε hd horder hR fminus fplus hminus hplus hplusnonneg hminusoutside) = R ^ d"},{"kind":"theorem","name":"saddleSourceAdmissible_normalizedCost","statement":"{ε : ℝ} (hε : 0 < ε) {d : ℕ} (hd : 0 < d) (horder : shortCutoff ε ≤ shortEndpoint ε) {R : ℝ} (hR : 0 < R) (fminus fplus : TestFunction d) (hminus : ∀ x : Euclidean d, fminus x = minusSaddleFunction ε d x) (hplus : ∀ x : Euclidean d, fplus x = plusSaddleFunction ε d x) (hplusnonneg : ∀ x : Euclidean d, 0 ≤ (plusSaddleFunction ε d x).re) (hminusoutside : ∀ x : Euclidean d, R ≤ ‖x‖ → (minusSaddleFunction ε d x).re ≤ 0) : normalizedCost (saddleSourceAdmissible hε hd horder hR fminus fplus hminus hplus hplusnonneg hminusoutside) = R / Real.sqrt (d : ℝ)"},{"kind":"theorem","name":"saddleSourceRadius_pos","statement":"(ε : ℝ) (d : ℕ) : 0 < saddleSourceRadius ε d"},{"kind":"theorem","name":"saddleLogGamma_add_one","statement":"{x : ℝ} (hx : 0 < x) : (Real.log ∘ Real.Gamma) (x + 1) = (Real.log ∘ Real.Gamma) x + Real.log x"},{"kind":"theorem","name":"saddleLogGamma_differentiableAt","statement":"{x : ℝ} (hx : 0 < x) : DifferentiableAt ℝ (Real.log ∘ Real.Gamma) x"},{"kind":"theorem","name":"saddleDigamma_bounds","statement":"{x : ℝ} (hx : 1 < x) : Real.log (x - 1) ≤ saddleDigamma x ∧ saddleDigamma x ≤ Real.log x"},{"kind":"theorem","name":"tendsto_saddleDigamma_sub_log","statement":"Tendsto (fun x : ℝ => saddleDigamma x - Real.log x) atTop (𝓝 (0 : ℝ))"},{"kind":"theorem","name":"saddle_exp_half_log_eq_sqrt","statement":"{x : ℝ} (hx : 0 < x) : Real.exp (Real.log x / 2) = Real.sqrt x"},{"kind":"theorem","name":"saddleCriticalGammaArgument_pos","statement":"{ε : ℝ} (hε : 0 < ε) {d : ℕ} (hd : 0 < d) : 0 < saddleCriticalGammaArgument ε d"},{"kind":"theorem","name":"tendsto_saddleCriticalGammaArgument_atTop","statement":"{ε : ℝ} (hε : 0 < ε) : Tendsto (saddleCriticalGammaArgument ε) atTop atTop"},{"kind":"theorem","name":"saddleLogRadius_critical_eq","statement":"(ε : ℝ) (d : ℕ) : saddleLogRadius ε d (1 + ε / 4) = -(Real.log Real.pi) / 2 + saddleDigamma (saddleCriticalGammaArgument ε d) / 2 + shortShellRadiusContribution ε + positiveShellRadiusContribution ε"},{"kind":"theorem","name":"saddleSourceRadius_div_sqrt_eq","statement":"{ε : ℝ} (hε : 0 < ε) {d : ℕ} (hd : 0 < d) : saddleSourceRadius ε d / Real.sqrt (d : ℝ) = Real.exp ((saddleDigamma (saddleCriticalGammaArgument ε d) - Real.log (saddleCriticalGammaArgument ε d)) / 2) * limitingSaddleRadius ε"},{"kind":"theorem","name":"tendsto_saddleSourceRadius_normalized","statement":"{ε : ℝ} (hε : 0 < ε) : Tendsto (fun d : ℕ => saddleSourceRadius ε d / Real.sqrt (d : ℝ)) atTop (𝓝 (limitingSaddleRadius ε))"},{"kind":"theorem","name":"saddleSourceMellinContour_shellArgument","statement":"{ℓ : ℝ} (hℓ : 0 < ℓ) (u T : ℝ) : Complex.I * (saddleSourceMellinContour ℓ u T - (ℓ : ℂ)) / (ℓ : ℂ) = (T : ℂ) + Complex.I * (u : ℂ)"},{"kind":"theorem","name":"saddleSourceMellinContour_gammaArgument","statement":"(ℓ u T : ℝ) : saddleSourceMellinContour ℓ u T / 2 = ((ℓ * (1 + u) / 2 : ℝ) : ℂ) - Complex.I * ((ℓ * T / 2 : ℝ) : ℂ)"},{"kind":"theorem","name":"norm_saddleShellExponential_eq_exp_neg_damping","statement":"{ε : ℝ} (hε : 0 < ε) (horder : shortCutoff ε ≤ shortEndpoint ε) (ℓ T u : ℝ) : ‖Complex.exp ((ℓ : ℂ) * mellinShellPhase ε ((T : ℂ) + Complex.I * (u : ℂ)))‖ = Real.exp (ℓ * realHyperbolicShellPhase ε u) * Real.exp (-(positiveShellDamping ε ℓ (u - 1) T - upperShortShellDamping ε ℓ (u - 1) T))"},{"kind":"theorem","name":"saddleSourceShellDerivative_one","statement":"(ε : ℝ) : saddleSourceShellDerivative ε 1 = saddleShellDerivativeOne ε"},{"kind":"theorem","name":"saddleSourceShellDerivative_neg","statement":"(ε u : ℝ) : saddleSourceShellDerivative ε (-u) = -saddleSourceShellDerivative ε u"},{"kind":"theorem","name":"saddleLogRadius_eq_digamma_add_shellDerivative","statement":"(ε : ℝ) (d : ℕ) (u : ℝ) : saddleLogRadius ε d u = -(Real.log Real.pi) / 2 + saddleDigamma (((d : ℝ) / 2) * (1 + u) / 2) / 2 + saddleSourceShellDerivative ε u"},{"kind":"theorem","name":"saddleSmallRadiusStar_pos","statement":"(ε : ℝ) (d : ℕ) : 0 < saddleSmallRadiusStar ε d"},{"kind":"theorem","name":"saddleSmallRadiusStar_gammaArgument","statement":"{d : ℕ} (hd : 0 < d) (ε : ℝ) : ((d : ℝ) / 2) * (1 + saddleSmallRadiusStarOrdinate ε d) / 2 = Real.log ((d : ℝ) / 2) / 8"},{"kind":"theorem","name":"saddleSourceShellDerivative_eq_deriv","statement":"{ε : ℝ} (hε : 0 < ε) (horder : shortCutoff ε ≤ shortEndpoint ε) (u : ℝ) : saddleSourceShellDerivative ε u = deriv (realHyperbolicShellPhase ε) u"},{"kind":"theorem","name":"saddleSourceShellDerivative_contDiff_one","statement":"{ε : ℝ} (hε : 0 < ε) (horder : shortCutoff ε ≤ shortEndpoint ε) : ContDiff ℝ (1 : WithTop ℕ∞) (saddleSourceShellDerivative ε)"},{"kind":"theorem","name":"saddleSmallRadiusVariable_star_eq","statement":"{ε : ℝ} {d : ℕ} (hd : 0 < d) : saddleSmallRadiusVariable ε (saddleSmallRadiusStar ε d) = Real.exp (saddleDigamma (Real.log ((d : ℝ) / 2) / 8) + 2 * (saddleShellDerivativeOne ε + saddleSourceShellDerivative ε (saddleSmallRadiusStarOrdinate ε d)))"},{"kind":"theorem","name":"saddleSourceShellDerivative_neg_one","statement":"(ε : ℝ) : saddleSourceShellDerivative ε (-1) = -saddleShellDerivativeOne ε"},{"kind":"theorem","name":"exists_saddleSourceShellDerivative_endpoint_bound","statement":"{ε : ℝ} (hε : 0 < ε) (horder : shortCutoff ε ≤ shortEndpoint ε) : ∃ C : ℝ, 0 ≤ C ∧ ∀ u ∈ Icc (-1 : ℝ) 0, |saddleShellDerivativeOne ε + saddleSourceShellDerivative ε u| ≤ C * (u + 1)"},{"kind":"theorem","name":"saddle_log_sq_le_four_mul","statement":"{x : ℝ} (hx : 1 ≤ x) : (Real.log x) ^ 2 ≤ 4 * x"},{"kind":"theorem","name":"exists_saddleSmallRadiusStar_coordinate_bound","statement":"{ε : ℝ} (hε : 0 < ε) (horder : shortCutoff ε ≤ shortEndpoint ε) : ∃ C : ℝ, 0 ≤ C ∧ ∀ d : ℕ, 8 < Real.log ((d : ℝ) / 2) → saddleSmallRadiusVariable ε (saddleSmallRadiusStar ε d) ≤ Real.log ((d : ℝ) / 2) / 8 + C"},{"kind":"theorem","name":"exists_eventually_y_star_le_log_eighth_add","statement":"{ε : ℝ} (hε : 0 < ε) (horder : shortCutoff ε ≤ shortEndpoint ε) : ∃ C : ℝ, 0 ≤ C ∧ ∀ᶠ d : ℕ in atTop, ∀ r : ℝ, 0 ≤ r → r ≤ saddleSmallRadiusStar ε d → saddleSmallRadiusVariable ε r ≤ Real.log ((d : ℝ) / 2) / 8 + C"},{"kind":"theorem","name":"saddleSmallResidueTruncation_lower","statement":"(ℓ : ℝ) : 20 * Real.log ℓ ≤ (saddleSmallResidueTruncation ℓ : ℝ)"},{"kind":"theorem","name":"saddleSmallResidueTruncation_upper","statement":"{ℓ : ℝ} (hℓ : 1 ≤ ℓ) : (saddleSmallResidueTruncation ℓ : ℝ) ≤ 20 * Real.log ℓ + 1"},{"kind":"theorem","name":"tendsto_logLinear_div_atTop","statement":"Tendsto (fun ℓ : ℝ => (20 * Real.log ℓ + 1) / ℓ) atTop (𝓝 0)"},{"kind":"theorem","name":"tendsto_logLinear_sq_div_atTop","statement":"Tendsto (fun ℓ : ℝ => (20 * Real.log ℓ + 1) ^ 2 / ℓ) atTop (𝓝 0)"},{"kind":"theorem","name":"tendsto_saddleSmallResidueTruncation_div","statement":"Tendsto (fun ℓ : ℝ => (saddleSmallResidueTruncation ℓ : ℝ) / ℓ) atTop (𝓝 0)"},{"kind":"theorem","name":"tendsto_saddleSmallResidueTruncation_sq_div","statement":"Tendsto (fun ℓ : ℝ => (saddleSmallResidueTruncation ℓ : ℝ) ^ 2 / ℓ) atTop (𝓝 0)"},{"kind":"theorem","name":"eventually_saddleSmallResidueTruncation_double_le","statement":"∀ᶠ ℓ : ℝ in atTop, 2 * (saddleSmallResidueTruncation ℓ : ℝ) ≤ ℓ"},{"kind":"theorem","name":"eventually_saddleSmallResidueTruncation_succ_double_le","statement":"∀ᶠ ℓ : ℝ in atTop, 2 * ((saddleSmallResidueTruncation ℓ + 1 : ℕ) : ℝ) ≤ ℓ"},{"kind":"theorem","name":"eventually_saddleSmallResidueTruncation_dominates_window","statement":"{C : ℝ} (hC : 0 ≤ C) : ∀ᶠ ℓ : ℝ in atTop, ∀ y : ℝ, 0 ≤ y → y ≤ Real.log ℓ / 8 + C → 2 * y ≤ (saddleSmallResidueTruncation ℓ : ℝ) + 2"},{"kind":"theorem","name":"saddleExpSeries_term_le_exp_mul_half_pow","statement":"{y : ℝ} (hy : 0 ≤ y) (m : ℕ) : y ^ m / (m.factorial : ℝ) ≤ Real.exp (2 * y) * (1 / 2 : ℝ) ^ m"},{"kind":"theorem","name":"saddleSmallResidue_half_log_le","statement":"Real.log (1 / 2 : ℝ) ≤ -(1 / 2 : ℝ)"},{"kind":"theorem","name":"saddleSmallResidueTruncation_half_pow_le","statement":"(ℓ : ℝ) : (1 / 2 : ℝ) ^ (saddleSmallResidueTruncation ℓ + 1) ≤ Real.exp (-10 * Real.log ℓ)"},{"kind":"theorem","name":"saddleSmallResidue_tail_le_majorant","statement":"{C ℓ y : ℝ} (hy : 0 ≤ y) (hyupper : y ≤ Real.log ℓ / 8 + C) : Real.exp y * (y ^ (saddleSmallResidueTruncation ℓ + 1) / ((saddleSmallResidueTruncation ℓ + 1).factorial : ℝ)) ≤ saddleSmallResidueTailMajorant C ℓ"},{"kind":"theorem","name":"tendsto_saddleSmallResidueTailMajorant","statement":"(C : ℝ) : Tendsto (saddleSmallResidueTailMajorant C) atTop (𝓝 0)"},{"kind":"theorem","name":"saddleSmallResidue_coefficient_le_majorant","statement":"{K C ℓ y : ℝ} (hK : 0 ≤ K) (hC : 0 ≤ C) (hℓ : 1 ≤ ℓ) (hy : 0 ≤ y) (hyupper : y ≤ Real.log ℓ / 8 + C) : (K / ℓ) * Real.exp (K * (saddleSmallResidueTruncation ℓ : ℝ) ^ 2 / ℓ) * (2 * y + y ^ 2) * Real.exp (2 * y) ≤ saddleSmallResidueCoefficientMajorant K C ℓ"},{"kind":"theorem","name":"tendsto_saddleLogWindowPolynomial_exp_neg","statement":"(C : ℝ) : Tendsto (fun t : ℝ => (2 * (t / 8 + C) + (t / 8 + C) ^ 2) * Real.exp (-(3 / 4 : ℝ) * t)) atTop (𝓝 0)"},{"kind":"theorem","name":"tendsto_saddleSmallResidueCoefficientMajorant","statement":"(K C : ℝ) : Tendsto (saddleSmallResidueCoefficientMajorant K C) atTop (𝓝 0)"},{"kind":"theorem","name":"tendsto_saddleSmallResidueRelativeErrorMajorant","statement":"(K C : ℝ) : Tendsto (saddleSmallResidueRelativeErrorMajorant K C) atTop (𝓝 0)"},{"kind":"theorem","name":"eventually_plusSaddleSmallRadius_relativeFiniteResidue_lt_half","statement":"{ε : ℝ} (hε : 0 < ε) (horder : shortCutoff ε ≤ shortEndpoint ε) {C : ℝ} (hC : 0 ≤ C) : ∀ᶠ ℓ : ℝ in atTop, ∀ y : ℝ, 0 ≤ y → y ≤ Real.log ℓ / 8 + C → Real.exp y * |(∑ n ∈ Finset.range (saddleSmallResidueTruncation ℓ + 1), ((-y) ^ n / (n.factorial : ℝ)) * plusSaddleSmallRadiusCoefficient ε ℓ n) - Real.exp (-y)| < 1 / 2"},{"kind":"theorem","name":"tendsto_saddleResidue_dimension_half","statement":"Tendsto (fun d : ℕ => (d : ℝ) / 2) atTop atTop"},{"kind":"theorem","name":"eventually_plusSaddleSmallRadius_relativeFiniteResidue_lt_half_on_star","statement":"{ε : ℝ} (hε : 0 < ε) (horder : shortCutoff ε ≤ shortEndpoint ε) : ∀ᶠ d : ℕ in atTop, ∀ r : ℝ, 0 ≤ r → r ≤ saddleSmallRadiusStar ε d → let ℓ : ℝ"},{"kind":"theorem","name":"gamma_half_factorial_lower","statement":"(N : ℕ) : Real.Gamma (3 / 2 : ℝ) * (N.factorial : ℝ) ≤ Real.Gamma ((N : ℝ) + 3 / 2)"},{"kind":"theorem","name":"saddleNegativeTruncation_half_pow_le","statement":"(ℓ : ℝ) : (1 / 2 : ℝ) ^ saddleSmallResidueTruncation ℓ ≤ 2 * Real.exp (-10 * Real.log ℓ)"},{"kind":"theorem","name":"saddleNegative_factorialTail_le_majorant","statement":"{C ℓ y : ℝ} (hy : 0 ≤ y) (hyupper : y ≤ Real.log ℓ / 8 + C) : Real.exp y * (y ^ saddleSmallResidueTruncation ℓ / ((saddleSmallResidueTruncation ℓ).factorial : ℝ)) ≤ 2 * saddleSmallResidueTailMajorant C ℓ"},{"kind":"theorem","name":"saddleNegative_sqrt_le_one_add","statement":"{y : ℝ} (hy : 0 ≤ y) : Real.sqrt y ≤ 1 + y"},{"kind":"theorem","name":"saddleNegative_relativeGammaTail_le_majorant","statement":"{C K Kε ℓ y : ℝ} (hKε : 0 ≤ Kε) (hC : 0 ≤ C) (hℓ : 1 ≤ ℓ) (hy : 0 ≤ y) (hyupper : y ≤ Real.log ℓ / 8 + C) : Real.exp y * (Kε * Real.sqrt y * y ^ saddleSmallResidueTruncation ℓ / Real.Gamma ((saddleSmallResidueTruncation ℓ : ℝ) + 3 / 2) * Real.exp (K * (2 * (saddleSmallResidueTruncation ℓ : ℝ) + 1) ^ 2 / ℓ)) ≤ saddleNegativeRelativeGammaTailMajorant C K Kε ℓ"},{"kind":"theorem","name":"tendsto_saddleNegativeTruncation_odd_sq_div","statement":"Tendsto (fun ℓ : ℝ => (2 * (saddleSmallResidueTruncation ℓ : ℝ) + 1) ^ 2 / ℓ) atTop (𝓝 0)"},{"kind":"theorem","name":"tendsto_saddleNegativeLogWindowTailMajorant","statement":"(C : ℝ) : Tendsto (fun ℓ : ℝ => (1 + (Real.log ℓ / 8 + C)) * saddleSmallResidueTailMajorant C ℓ) atTop (𝓝 0)"},{"kind":"theorem","name":"tendsto_saddleNegativeRelativeGammaTailMajorant","statement":"(C K Kε : ℝ) : Tendsto (saddleNegativeRelativeGammaTailMajorant C K Kε) atTop (𝓝 0)"},{"kind":"theorem","name":"eventually_saddleNegative_relativeGammaTail_lt_half","statement":"{ε : ℝ} (hε : 0 < ε) (C K Kε : ℝ) (hC : 0 ≤ C) (hK : 0 ≤ K) (hKε : 0 ≤ Kε) : ∀ᶠ ℓ : ℝ in atTop, ∀ y : ℝ, 0 ≤ y → y ≤ Real.log ℓ / 8 + C → Real.exp y * (Kε * Real.sqrt y * y ^ saddleSmallResidueTruncation ℓ / Real.Gamma ((saddleSmallResidueTruncation ℓ : ℝ) + 3 / 2) * Real.exp (K * (2 * (saddleSmallResidueTruncation ℓ : ℝ) + 1) ^ 2 / ℓ)) < 1 / 2"},{"kind":"theorem","name":"upperCosLaplaceKernel_eq_frullani_re","statement":"(c T a : ℝ) : upperCosLaplaceKernel c T a = (complexFrullaniKernel (c : ℂ) ((c : ℂ) + Complex.I * (T : ℂ)) a).re"},{"kind":"theorem","name":"upperCosLaplaceKernel_integrable","statement":"{c : ℝ} (hc : 0 < c) (T : ℝ) : IntegrableOn (upperCosLaplaceKernel c T) (Ioi 0)"},{"kind":"theorem","name":"integral_upperCosLaplaceKernel","statement":"{c : ℝ} (hc : 0 < c) (T : ℝ) : (∫ a : ℝ in Ioi 0, upperCosLaplaceKernel c T a) = Real.log (‖((c : ℂ) + Complex.I * (T : ℂ))‖ / c)"},{"kind":"theorem","name":"upperGammaTruncatedDampingIntegrand_eq_sum","statement":"(ℓ η T : ℝ) (n : ℕ) (a : ℝ) : upperGammaTruncatedDampingIntegrand ℓ η T n a = ∑ k ∈ Finset.range (n + 1), upperCosLaplaceKernel (η + 2 * (k : ℝ) / ℓ) T a"},{"kind":"theorem","name":"upperGammaGeometricLimit_eq_integrand","statement":"(ℓ η T a : ℝ) : upperCosLaplaceKernel η T a * (1 - Real.exp (-(2 * a / ℓ)))⁻¹ = upperGammaDampingIntegrand ℓ η T a"},{"kind":"theorem","name":"tendsto_integral_upperGammaTruncatedDampingIntegrand","statement":"{ℓ η : ℝ} (hℓ : 0 < ℓ) (hη : 0 < η) (T : ℝ) : Tendsto (fun n : ℕ => ∫ a : ℝ in Ioi 0, upperGammaTruncatedDampingIntegrand ℓ η T n a) atTop (𝓝 (upperGammaDamping ℓ η T))"},{"kind":"theorem","name":"upperGammaLaplaceRate_pos","statement":"{ℓ η : ℝ} (hℓ : 0 < ℓ) (hη : 0 < η) (k : ℕ) : 0 < η + 2 * (k : ℝ) / ℓ"},{"kind":"theorem","name":"integral_upperGammaTruncatedDampingIntegrand","statement":"{ℓ η : ℝ} (hℓ : 0 < ℓ) (hη : 0 < η) (T : ℝ) (n : ℕ) : (∫ a : ℝ in Ioi 0, upperGammaTruncatedDampingIntegrand ℓ η T n a) = ∑ k ∈ Finset.range (n + 1), Real.log (‖((η + 2 * (k : ℝ) / ℓ : ℝ) : ℂ) + Complex.I * (T : ℂ)‖ / (η + 2 * (k : ℝ) / ℓ))"},{"kind":"theorem","name":"upperComplex_norm_ratio_scale","statement":"{s c : ℝ} (hs : 0 < s) (hc : 0 < c) (T : ℝ) : ‖((s * c : ℝ) : ℂ) + Complex.I * ((s * T : ℝ) : ℂ)‖ / (s * c) = ‖(c : ℂ) + Complex.I * (T : ℂ)‖ / c"},{"kind":"theorem","name":"upperGammaLaplaceRate_log_ratio","statement":"{ℓ η : ℝ} (hℓ : 0 < ℓ) (hη : 0 < η) (T : ℝ) (k : ℕ) : Real.log (‖((η + 2 * (k : ℝ) / ℓ : ℝ) : ℂ) + Complex.I * (T : ℂ)‖ / (η + 2 * (k : ℝ) / ℓ)) = Real.log (‖((ℓ * η / 2 : ℝ) : ℂ) + Complex.I * ((ℓ * T / 2 : ℝ) : ℂ) + (k : ℂ)‖ / (ℓ * η / 2 + (k : ℝ)))"},{"kind":"theorem","name":"upperGammaEuler_real_factor_norm","statement":"{m : ℝ} (hm : 0 < m) (k : ℕ) : ‖(m : ℂ) + (k : ℂ)‖ = m + (k : ℝ)"},{"kind":"theorem","name":"upperGammaEuler_complex_factor_pos","statement":"{m : ℝ} (hm : 0 < m) (b : ℝ) (k : ℕ) : 0 < ‖(m : ℂ) + Complex.I * (b : ℂ) + (k : ℂ)‖"},{"kind":"theorem","name":"upperGammaEuler_log_norm_ratio","statement":"{m : ℝ} (hm : 0 < m) (b : ℝ) {n : ℕ} (hn : 0 < n) : Real.log (‖Complex.GammaSeq ((m : ℂ) + Complex.I * (b : ℂ)) n‖ / ‖Complex.GammaSeq (m : ℂ) n‖) = -(∑ k ∈ Finset.range (n + 1), Real.log (‖(m : ℂ) + Complex.I * (b : ℂ) + (k : ℂ)‖ / (m + (k : ℝ))))"},{"kind":"theorem","name":"tendsto_upperGammaEuler_log_norm_ratio","statement":"{m : ℝ} (hm : 0 < m) (b : ℝ) : Tendsto (fun n : ℕ => Real.log (‖Complex.GammaSeq ((m : ℂ) + Complex.I * (b : ℂ)) n‖ / ‖Complex.GammaSeq (m : ℂ) n‖)) atTop (𝓝 (Real.log (‖Complex.Gamma ((m : ℂ) + Complex.I * (b : ℂ))‖ / ‖Complex.Gamma (m : ℂ)‖)))"},{"kind":"theorem","name":"upperGammaPositiveShifted_log_norm_eq_neg_damping","statement":"{ℓ η : ℝ} (hℓ : 0 < ℓ) (hη : 0 < η) (T : ℝ) : Real.log (‖Complex.Gamma (((ℓ * η / 2 : ℝ) : ℂ) + Complex.I * ((ℓ * T / 2 : ℝ) : ℂ))‖ / Real.Gamma (ℓ * η / 2)) = -upperGammaDamping ℓ η T"},{"kind":"theorem","name":"upperGammaShifted_log_norm_eq_neg_damping","statement":"{ℓ η : ℝ} (hℓ : 0 < ℓ) (hη : 0 < η) (T : ℝ) : Real.log (‖Complex.Gamma (((ℓ * η / 2 : ℝ) : ℂ) - Complex.I * ((ℓ * T / 2 : ℝ) : ℂ))‖ / Real.Gamma (ℓ * η / 2)) = -upperGammaDamping ℓ η T"},{"kind":"theorem","name":"upperGammaShifted_modulus_eq_exp_neg_damping","statement":"{ℓ η : ℝ} (hℓ : 0 < ℓ) (hη : 0 < η) (T : ℝ) : ‖Complex.Gamma (((ℓ * η / 2 : ℝ) : ℂ) - Complex.I * ((ℓ * T / 2 : ℝ) : ℂ))‖ = Real.Gamma (ℓ * η / 2) * Real.exp (-upperGammaDamping ℓ η T)"},{"kind":"theorem","name":"plusSaddleProfile_re_pos_of_relative_residue_bounds","statement":"{ε ℓ r : ℝ} (hε : 0 < ε) (hℓ : 0 < ℓ) (horder : shortCutoff ε ≤ shortEndpoint ε) (hr : 0 < r) (N : ℕ) (hfinite : Real.exp (saddleSmallRadiusVariable ε r) * |(∑ n ∈ Finset.range (N + 1), (-saddleSmallRadiusVariable ε r) ^ n / (n.factorial : ℝ) * plusSaddleSmallRadiusCoefficient ε ℓ n) - Real.exp (-(saddleSmallRadiusVariable ε r))| < (1 / 2 : ℝ)) (hremainder : Real.exp (saddleSmallRadiusVariable ε r) * ‖plusSaddleTaylorRemainder ε ℓ N r / (saddleOriginValue ε ℓ : ℂ)‖ < (1 / 2 : ℝ)) : 0 < (plusSaddleProfile ε ℓ r).re"},{"kind":"theorem","name":"upperPositiveHalfGamma_scaled_sq_le","statement":"(n : ℕ) (x : ℝ) : Real.Gamma ((n : ℝ) + 1 / 2) ^ 2 ≤ ‖Complex.Gamma (((((n : ℝ) + 1 / 2) : ℝ) : ℂ) + Complex.I * (x : ℂ))‖ ^ 2 * Real.cosh (Real.pi * x)"},{"kind":"theorem","name":"upperNegativeContour_shortMeasure_pointwise","statement":"{ε ℓ κ η a : ℝ} (hε : 0 < ε) (hεsmall : ε ≤ 1 / 4) (hℓ : 0 < ℓ) (hκ : 1 ≤ κ) (hη : 0 < η) (hκη : κ + η ≤ 3) (ha : 0 < a) (hmargin : 0 ≤ shortMargin ε a) : ℓ * (-shortShellDensity ε a) * Real.cosh (κ * a) ≤ (1 - 4 * ε) * upperGammaMeasureDensity ℓ η a"},{"kind":"theorem","name":"upperNegativeContour_shortDamping_le_gamma","statement":"{ε ℓ κ η : ℝ} (hε : 0 < ε) (hεsmall : ε ≤ 1 / 4) (hℓ : 0 < ℓ) (hκ : 1 ≤ κ) (hη : 0 < η) (hκη : κ + η ≤ 3) (horder : shortCutoff ε ≤ shortEndpoint ε) (hmargin : ∀ a ∈ Icc (shortCutoff ε) (shortEndpoint ε), 0 ≤ shortMargin ε a) (T : ℝ) : upperShortShellDamping ε ℓ (-κ - 1) T ≤ (1 - 4 * ε) * upperGammaDamping ℓ η T"},{"kind":"theorem","name":"saddleNegativeGammaRate_pos","statement":"{ℓ : ℝ} (hℓ : 0 < ℓ) (N : ℕ) : 0 < saddleNegativeGammaRate ℓ N"},{"kind":"theorem","name":"one_le_saddleNegativeContourOrdinate","statement":"{ℓ : ℝ} (hℓ : 0 < ℓ) (N : ℕ) : 1 ≤ saddleNegativeContourOrdinate ℓ N"},{"kind":"theorem","name":"saddleNegativeContourOrdinate_add_rate_le_three","statement":"{ℓ : ℝ} (hℓ : 0 < ℓ) (N : ℕ) (hN : 2 * (((N + 1 : ℕ) : ℝ)) ≤ ℓ) : saddleNegativeContourOrdinate ℓ N + saddleNegativeGammaRate ℓ N ≤ 3"},{"kind":"theorem","name":"upperNegativeContour_reflectedGamma_damping_exp_le_cosh","statement":"{ℓ : ℝ} (hℓ : 0 < ℓ) (N : ℕ) (s : ℝ) : Real.exp (2 * upperGammaDamping ℓ (saddleNegativeGammaRate ℓ N) (-s / ℓ)) ≤ Real.cosh (Real.pi * (s / 2))"},{"kind":"theorem","name":"upperNegativeHalfGamma_reflection_norm","statement":"(N : ℕ) (s : ℝ) : ‖Complex.Gamma (upperNegativeHalfGammaArgument N s)‖ * ‖Complex.Gamma (((((N : ℝ) + 3 / 2) : ℝ) : ℂ) + Complex.I * (((s / 2 : ℝ) : ℂ)))‖ = Real.pi / Real.cosh (Real.pi * (s / 2))"},{"kind":"theorem","name":"upperNegativeHalfGamma_norm_eq_reflected_damping","statement":"{ℓ : ℝ} (hℓ : 0 < ℓ) (N : ℕ) (s : ℝ) : ‖Complex.Gamma (upperNegativeHalfGammaArgument N s)‖ = (Real.pi / Real.Gamma ((N : ℝ) + 3 / 2)) * Real.exp (upperGammaDamping ℓ (saddleNegativeGammaRate ℓ N) (-s / ℓ)) / Real.cosh (Real.pi * (s / 2))"},{"kind":"theorem","name":"upper_log_cosh_ge_abs_sub_log_two","statement":"(x : ℝ) : |x| - Real.log 2 ≤ Real.log (Real.cosh x)"},{"kind":"theorem","name":"upperNegativeContour_gamma_mul_exp_short_le","statement":"{ε ℓ : ℝ} (hε : 0 < ε) (hεsmall : ε ≤ 1 / 4) (hℓ : 0 < ℓ) (N : ℕ) (hN : 2 * (((N + 1 : ℕ) : ℝ)) ≤ ℓ) (horder : shortCutoff ε ≤ shortEndpoint ε) (hmargin : ∀ a ∈ Icc (shortCutoff ε) (shortEndpoint ε), 0 ≤ shortMargin ε a) (s : ℝ) : ‖Complex.Gamma (upperNegativeHalfGammaArgument N s)‖ * Real.exp (upperShortShellDamping ε ℓ (-saddleNegativeContourOrdinate ℓ N - 1) (-s / ℓ)) ≤ (Real.pi / Real.Gamma ((N : ℝ) + 3 / 2)) * Real.exp (2 * ε * Real.log 2) * Real.exp (-ε * Real.pi * |s|)"},{"kind":"theorem","name":"upperShortShellDamping_neg_frequency","statement":"(ε ℓ δ T : ℝ) : upperShortShellDamping ε ℓ δ (-T) = upperShortShellDamping ε ℓ δ T"},{"kind":"theorem","name":"saddleTaylorContour_gammaArgument","statement":"(N : ℕ) (s : ℝ) : (((saddleTaylorContour N : ℂ) + (s : ℂ) * Complex.I) / 2) = upperNegativeHalfGammaArgument N (-s)"},{"kind":"theorem","name":"saddleTaylorContour_shellArgument","statement":"{ℓ : ℝ} (hℓ : 0 < ℓ) (N : ℕ) (s : ℝ) : Complex.I * (((saddleTaylorContour N : ℂ) + (s : ℂ) * Complex.I) - (ℓ : ℂ)) / (ℓ : ℂ) = ((-s / ℓ : ℝ) : ℂ) + Complex.I * (((-saddleNegativeContourOrdinate ℓ N : ℝ) : ℂ))"},{"kind":"theorem","name":"saddleNegativeContourOrdinate_le_two","statement":"{ℓ : ℝ} (hℓ : 0 < ℓ) (N : ℕ) (hN : 2 * (((N + 1 : ℕ) : ℝ)) ≤ ℓ) : saddleNegativeContourOrdinate ℓ N ≤ 2"},{"kind":"theorem","name":"upperNegativeContour_gamma_mul_shellExponential_le","statement":"{ε ℓ : ℝ} (hε : 0 < ε) (hεsmall : ε ≤ 1 / 4) (hℓ : 0 < ℓ) (N : ℕ) (hN : 2 * (((N + 1 : ℕ) : ℝ)) ≤ ℓ) (horder : shortCutoff ε ≤ shortEndpoint ε) (hmargin : ∀ a ∈ Icc (shortCutoff ε) (shortEndpoint ε), 0 ≤ shortMargin ε a) (s : ℝ) : ‖Complex.Gamma (((saddleTaylorContour N : ℂ) + (s : ℂ) * Complex.I) / 2) * Complex.exp ((ℓ : ℂ) * mellinShellPhase ε (Complex.I * (((saddleTaylorContour N : ℂ) + (s : ℂ) * Complex.I) - (ℓ : ℂ)) / (ℓ : ℂ)))‖ ≤ Real.exp (ℓ * realHyperbolicShellPhase ε (saddleNegativeContourOrdinate ℓ N)) * ((Real.pi / Real.Gamma ((N : ℝ) + 3 / 2)) * Real.exp (2 * ε * Real.log 2) * Real.exp (-ε * Real.pi * |s|))"},{"kind":"theorem","name":"saddleNegativeFrequencyMajorant_integrable","statement":"{ε : ℝ} (hε : 0 < ε) : Integrable (saddleNegativeFrequencyMajorant ε)"},{"kind":"theorem","name":"norm_plusPolynomial_negativeContour_le","statement":"{ε ℓ : ℝ} (hℓ : 0 < ℓ) (N : ℕ) (hN : 2 * (((N + 1 : ℕ) : ℝ)) ≤ ℓ) (s : ℝ) : ‖plusPolynomial ε (Complex.I * (((saddleTaylorContour N : ℂ) + (s : ℂ) * Complex.I) - (ℓ : ℂ)) / (ℓ : ℂ))‖ ≤ 27 * (1 + |beta ε|) * (1 + |s|) ^ 3"},{"kind":"theorem","name":"saddleNegativeContour_piExponential_norm","statement":"(ℓ : ℝ) (N : ℕ) (s : ℝ) : ‖Complex.exp ((((ℓ : ℂ) - ((saddleTaylorContour N : ℂ) + (s : ℂ) * Complex.I)) * (Real.log Real.pi : ℂ) / 2))‖ = Real.exp ((ℓ - saddleTaylorContour N) * Real.log Real.pi / 2)"},{"kind":"theorem","name":"plusSaddleMellinData_negativeContour_norm_le","statement":"{ε ℓ : ℝ} (hε : 0 < ε) (hεsmall : ε ≤ 1 / 4) (hℓ : 0 < ℓ) (N : ℕ) (hN : 2 * (((N + 1 : ℕ) : ℝ)) ≤ ℓ) (horder : shortCutoff ε ≤ shortEndpoint ε) (hmargin : ∀ a ∈ Icc (shortCutoff ε) (shortEndpoint ε), 0 ≤ shortMargin ε a) (s : ℝ) : ‖plusSaddleMellinData ε ℓ ((saddleTaylorContour N : ℂ) + (s : ℂ) * Complex.I)‖ ≤ saddleNegativeMellinMajorantCoefficient ε ℓ N * saddleNegativeFrequencyMajorant ε s"},{"kind":"theorem","name":"saddleNegativeFrequencyMass_nonneg","statement":"(ε : ℝ) : 0 ≤ saddleNegativeFrequencyMass ε"},{"kind":"theorem","name":"plusSaddleMellinData_negativeContour_integral_norm_le","statement":"{ε ℓ : ℝ} (hε : 0 < ε) (hεsmall : ε ≤ 1 / 4) (hℓ : 0 < ℓ) (N : ℕ) (hN : 2 * (((N + 1 : ℕ) : ℝ)) ≤ ℓ) (horder : shortCutoff ε ≤ shortEndpoint ε) (hmargin : ∀ a ∈ Icc (shortCutoff ε) (shortEndpoint ε), 0 ≤ shortMargin ε a) : (∫ s : ℝ, ‖plusSaddleMellinData ε ℓ ((saddleTaylorContour N : ℂ) + (s : ℂ) * Complex.I)‖) ≤ saddleNegativeMellinMajorantCoefficient ε ℓ N * saddleNegativeFrequencyMass ε"},{"kind":"theorem","name":"plusSaddleTaylorRemainder_negativeContour_bound","statement":"{ε ℓ : ℝ} (hε : 0 < ε) (hεsmall : ε ≤ 1 / 4) (hℓ : 0 < ℓ) (N : ℕ) (hN : 2 * (((N + 1 : ℕ) : ℝ)) ≤ ℓ) (horder : shortCutoff ε ≤ shortEndpoint ε) (hmargin : ∀ a ∈ Icc (shortCutoff ε) (shortEndpoint ε), 0 ≤ shortMargin ε a) {r : ℝ} (hr : 0 < r) : ‖plusSaddleTaylorRemainder ε ℓ N r‖ ≤ (1 / (2 * Real.pi)) * r ^ (2 * N + 1) * saddleNegativeMellinMajorantCoefficient ε ℓ N * saddleNegativeFrequencyMass ε"},{"kind":"theorem","name":"saddleSmallRadiusVariable_sqrt_eq_source","statement":"(ε : ℝ) {r : ℝ} (hr : 0 ≤ r) : Real.sqrt (saddleSmallRadiusVariable ε r) = r * Real.exp (Real.log Real.pi / 2 + saddleShellDerivativeOne ε)"},{"kind":"theorem","name":"saddleSmallRadiusVariable_halfIntegerFactor","statement":"(ε : ℝ) {r : ℝ} (hr : 0 ≤ r) (N : ℕ) : r ^ (2 * N + 1) * Real.exp (((2 * N + 1 : ℕ) : ℝ) * (Real.log Real.pi / 2 + saddleShellDerivativeOne ε)) = Real.sqrt (saddleSmallRadiusVariable ε r) * saddleSmallRadiusVariable ε r ^ N"},{"kind":"theorem","name":"saddleNegativeContour_sourceNormalizationFactor","statement":"(ε ℓ : ℝ) (N : ℕ) {r : ℝ} (hr : 0 ≤ r) : r ^ (2 * N + 1) * Real.exp ((ℓ - saddleTaylorContour N) * Real.log Real.pi / 2) * Real.exp (ℓ * realHyperbolicShellPhase ε (saddleNegativeContourOrdinate ℓ N)) / (Real.exp ((ℓ / 2) * Real.log Real.pi) * Real.exp (ℓ * realHyperbolicShellPhase ε 1)) = Real.sqrt (saddleSmallRadiusVariable ε r) * saddleSmallRadiusVariable ε r ^ N * Real.exp (saddleNegativeContourPhaseError ε ℓ N)"},{"kind":"theorem","name":"saddleNegativeRelativeCoefficient_nonneg","statement":"{ε : ℝ} (hε : 0 < ε) : 0 ≤ saddleNegativeRelativeCoefficient ε"},{"kind":"theorem","name":"saddleNegativeContour_normalizedMajorant_eq","statement":"{ε : ℝ} (hε : 0 < ε) (ℓ : ℝ) (N : ℕ) {r : ℝ} (hr : 0 ≤ r) : ((1 / (2 * Real.pi)) * r ^ (2 * N + 1) * saddleNegativeMellinMajorantCoefficient ε ℓ N * saddleNegativeFrequencyMass ε) / saddleOriginValue ε ℓ = saddleNegativeRelativeCoefficient ε * Real.sqrt (saddleSmallRadiusVariable ε r) * saddleSmallRadiusVariable ε r ^ N / Real.Gamma ((N : ℝ) + 3 / 2) * Real.exp (saddleNegativeContourPhaseError ε ℓ N)"},{"kind":"theorem","name":"plusSaddleTaylorRemainder_negativeContour_relative_bound","statement":"{ε ℓ : ℝ} (hε : 0 < ε) (hεsmall : ε ≤ 1 / 4) (hℓ : 0 < ℓ) (N : ℕ) (hN : 2 * (((N + 1 : ℕ) : ℝ)) ≤ ℓ) (horder : shortCutoff ε ≤ shortEndpoint ε) (hmargin : ∀ a ∈ Icc (shortCutoff ε) (shortEndpoint ε), 0 ≤ shortMargin ε a) {r : ℝ} (hr : 0 < r) : ‖plusSaddleTaylorRemainder ε ℓ N r / (saddleOriginValue ε ℓ : ℂ)‖ ≤ saddleNegativeRelativeCoefficient ε * Real.sqrt (saddleSmallRadiusVariable ε r) * saddleSmallRadiusVariable ε r ^ N / Real.Gamma ((N : ℝ) + 3 / 2) * Real.exp (saddleNegativeContourPhaseError ε ℓ N)"},{"kind":"theorem","name":"exists_saddleNegativeContourPhaseError_bound","statement":"{ε : ℝ} (hε : 0 < ε) (horder : shortCutoff ε ≤ shortEndpoint ε) : ∃ K : ℝ, 0 ≤ K ∧ ∀ (ℓ : ℝ), 0 < ℓ → ∀ N : ℕ, 2 * (((N + 1 : ℕ) : ℝ)) ≤ ℓ → |saddleNegativeContourPhaseError ε ℓ N| ≤ K * (2 * (N : ℝ) + 1) ^ 2 / ℓ"},{"kind":"theorem","name":"eventually_plusSaddleTaylorRemainder_relative_lt_half_on_star","statement":"{ε : ℝ} (hε : 0 < ε) (hεsmall : ε ≤ 1 / 4) (horder : shortCutoff ε ≤ shortEndpoint ε) (hmargin : ∀ a ∈ Icc (shortCutoff ε) (shortEndpoint ε), 0 ≤ shortMargin ε a) : ∀ᶠ d : ℕ in atTop, ∀ r : ℝ, 0 < r → r ≤ saddleSmallRadiusStar ε d → let ℓ : ℝ"},{"kind":"theorem","name":"eventually_plusSaddleProfile_re_pos_on_star_fixed","statement":"{ε : ℝ} (hε : 0 < ε) (hεsmall : ε ≤ 1 / 4) (horder : shortCutoff ε ≤ shortEndpoint ε) (hmargin : ∀ a ∈ Icc (shortCutoff ε) (shortEndpoint ε), 0 ≤ shortMargin ε a) : ∀ᶠ d : ℕ in atTop, ∀ r : ℝ, 0 ≤ r → r ≤ saddleSmallRadiusStar ε d → 0 < (plusSaddleProfile ε ((d : ℝ) / 2) r).re"},{"kind":"theorem","name":"eventually_plusSaddleProfile_re_pos_on_star","statement":"∀ᶠ ε : ℝ in 𝓝[>] (0 : ℝ), ∀ᶠ d : ℕ in atTop, ∀ r : ℝ, 0 ≤ r → r ≤ saddleSmallRadiusStar ε d → 0 < (plusSaddleProfile ε ((d : ℝ) / 2) r).re"},{"kind":"theorem","name":"saddleRealCpow_hasDerivAt_zero","statement":"{z : ℂ} (hz : 1 < z.re) : HasDerivAt (fun x : ℝ => (x : ℂ) ^ z) (0 : ℂ) (0 : ℝ)"},{"kind":"theorem","name":"saddleRealCpow_hasDerivAt","statement":"{z : ℂ} (hz : 1 < z.re) (x : ℝ) : HasDerivAt (fun y : ℝ => (y : ℂ) ^ z) (z * (x : ℂ) ^ (z - 1)) x"},{"kind":"theorem","name":"saddlePositiveCpow_continuous","statement":"{z : ℂ} (hz : 0 < z.re) : Continuous (saddlePositiveCpow z)"},{"kind":"theorem","name":"saddlePositiveCpow_hasDerivAt_zero","statement":"{z : ℂ} (hz : 1 < z.re) : HasDerivAt (saddlePositiveCpow z) (0 : ℂ) (0 : ℝ)"},{"kind":"theorem","name":"saddlePositiveCpow_hasDerivAt","statement":"{z : ℂ} (hz : 1 < z.re) (x : ℝ) : HasDerivAt (saddlePositiveCpow z) (z * saddlePositiveCpow (z - 1) x) x"},{"kind":"theorem","name":"saddleContourExponentPolynomial_eval","statement":"(a t : ℝ) : (saddleContourExponentPolynomial a).eval (t : ℂ) = saddleContourExponent a t"},{"kind":"theorem","name":"saddleContourFallingPolynomial_eval_succ","statement":"(a t : ℝ) (j : ℕ) : (saddleContourFallingPolynomial a (j + 1)).eval (t : ℂ) = (saddleContourFallingPolynomial a j).eval (t : ℂ) * (saddleContourExponent a t - (j : ℂ))"},{"kind":"theorem","name":"saddlePolynomialWeightedData_integrable","statement":"{D : ℝ → ℂ} (hD : ∀ j : ℕ, Integrable (fun t : ℝ => (t : ℂ) ^ j * D t)) (P : Polynomial ℂ) : Integrable (fun t : ℝ => P.eval (t : ℂ) * D t)"},{"kind":"theorem","name":"saddlePositiveCpow_norm_le_one","statement":"{z : ℂ} (hz : 0 < z.re) {u : ℝ} (hu : u ∈ Set.Ioo (-1 : ℝ) 1) : ‖saddlePositiveCpow z u‖ ≤ 1"},{"kind":"theorem","name":"saddlePositiveContourPower_frequency_continuous","statement":"{a : ℝ} (j : ℕ) (ha : (j : ℝ) < -a / 2) (u : ℝ) : Continuous (fun t : ℝ => saddlePositiveCpow (saddleContourExponent a t - (j : ℂ)) u)"},{"kind":"theorem","name":"saddlePositiveContourMoment_hasDerivAt","statement":"{D : ℝ → ℂ} (hD : ∀ k : ℕ, Integrable (fun t : ℝ => (t : ℂ) ^ k * D t)) {a : ℝ} (j : ℕ) (ha : (j : ℝ) + 1 < -a / 2) {u : ℝ} (hu : u ∈ Set.Ioo (-1 : ℝ) 1) : HasDerivAt (saddlePositiveContourMoment a j D) (saddlePositiveContourMoment a (j + 1) D u) u"},{"kind":"theorem","name":"saddlePositiveContourMoment_contDiffOn","statement":"{D : ℝ → ℂ} (hD : ∀ k : ℕ, Integrable (fun t : ℝ => (t : ℂ) ^ k * D t)) {a : ℝ} (n j : ℕ) (ha : (n : ℝ) + (j : ℝ) + 1 < -a / 2) : ContDiffOn ℝ n (saddlePositiveContourMoment a j D) (Set.Ioo (-1 : ℝ) 1)"},{"kind":"theorem","name":"saddleMellinInversePower_eq_squaredPositiveCpow","statement":"{r : ℝ} (hr : 0 < r) (z : ℂ) : saddleMellinInversePower r z = saddlePositiveCpow (-z / 2) (r ^ 2)"},{"kind":"theorem","name":"plusSaddleTaylorRemainder_eq_squared","statement":"(ε ℓ : ℝ) (N : ℕ) {r : ℝ} (hr : 0 < r) : plusSaddleTaylorRemainder ε ℓ N r = plusSaddleSquaredRemainder ε ℓ N (r ^ 2)"},{"kind":"theorem","name":"minusSaddleTaylorRemainder_eq_squared","statement":"(ε ℓ : ℝ) (N : ℕ) {r : ℝ} (hr : 0 < r) : minusSaddleTaylorRemainder ε ℓ N r = minusSaddleSquaredRemainder ε ℓ N (r ^ 2)"},{"kind":"theorem","name":"plusSaddleSquaredRemainder_contDiffOn","statement":"{ε ℓ : ℝ} (hε : 0 < ε) (hℓ : 0 < ℓ) (horder : shortCutoff ε ≤ shortEndpoint ε) (n N : ℕ) (hshift : (n : ℝ) + 1 < -(saddleTaylorContour N) / 2) : ContDiffOn ℝ n (plusSaddleSquaredRemainder ε ℓ N) (Set.Ioo (-1 : ℝ) 1)"},{"kind":"theorem","name":"minusSaddleSquaredRemainder_contDiffOn","statement":"{ε ℓ : ℝ} (hε : 0 < ε) (hℓ : 0 < ℓ) (horder : shortCutoff ε ≤ shortEndpoint ε) (n N : ℕ) (hshift : (n : ℝ) + 1 < -(saddleTaylorContour N) / 2) : ContDiffOn ℝ n (minusSaddleSquaredRemainder ε ℓ N) (Set.Ioo (-1 : ℝ) 1)"},{"kind":"theorem","name":"saddleTaylorContour_negativeHalf_pos","statement":"(N : ℕ) : 0 < -(saddleTaylorContour N) / 2"},{"kind":"theorem","name":"saddleSquaredResiduePolynomial_contDiff","statement":"(c : ℕ → ℂ) (N n : ℕ) : ContDiff ℝ n (saddleSquaredResiduePolynomial c N)"},{"kind":"theorem","name":"plusSaddleProfile_eq_squaredTaylor","statement":"{ε ℓ : ℝ} (hε : 0 < ε) (hℓ : 0 < ℓ) (horder : shortCutoff ε ≤ shortEndpoint ε) (N : ℕ) {r : ℝ} (hr : 0 ≤ r) : plusSaddleProfile ε ℓ r = saddleSquaredResiduePolynomial (plusSaddlePoleResidue ε ℓ) N (r ^ 2) + plusSaddleSquaredRemainder ε ℓ N (r ^ 2)"},{"kind":"theorem","name":"minusSaddleProfile_eq_squaredTaylor","statement":"{ε ℓ : ℝ} (hε : 0 < ε) (hℓ : 0 < ℓ) (horder : shortCutoff ε ≤ shortEndpoint ε) (N : ℕ) {r : ℝ} (hr : 0 ≤ r) : minusSaddleProfile ε ℓ r = saddleSquaredResiduePolynomial (minusSaddlePoleResidue ε ℓ) N (r ^ 2) + minusSaddleSquaredRemainder ε ℓ N (r ^ 2)"},{"kind":"theorem","name":"saddleTaylorContour_smoothShift","statement":"(n : ℕ) : (n : ℝ) + 1 < -(saddleTaylorContour (n + 2)) / 2"},{"kind":"theorem","name":"plusSaddleFunction_contDiff_nat","statement":"{ε : ℝ} (hε : 0 < ε) {d : ℕ} (hd : 0 < d) (horder : shortCutoff ε ≤ shortEndpoint ε) (n : ℕ) : ContDiff ℝ n (plusSaddleFunction ε d)"},{"kind":"theorem","name":"minusSaddleFunction_contDiff_nat","statement":"{ε : ℝ} (hε : 0 < ε) {d : ℕ} (hd : 0 < d) (horder : shortCutoff ε ≤ shortEndpoint ε) (n : ℕ) : ContDiff ℝ n (minusSaddleFunction ε d)"},{"kind":"theorem","name":"plusSaddleFunction_contDiff","statement":"{ε : ℝ} (hε : 0 < ε) {d : ℕ} (hd : 0 < d) (horder : shortCutoff ε ≤ shortEndpoint ε) : ContDiff ℝ ∞ (plusSaddleFunction ε d)"},{"kind":"theorem","name":"minusSaddleFunction_contDiff","statement":"{ε : ℝ} (hε : 0 < ε) {d : ℕ} (hd : 0 < d) (horder : shortCutoff ε ≤ shortEndpoint ε) : ContDiff ℝ ∞ (minusSaddleFunction ε d)"},{"kind":"theorem","name":"saddleRightHalfPlane_boundary_rectangle","statement":"{F : ℂ → ℂ} (hF : DifferentiableOn ℂ F {z : ℂ | 0 < z.re}) {A B : ℝ} (hA : 0 < A) (hB : 0 < B) (T : ℝ) : (∫ a in A..B, F ((a : ℂ) + ((-T : ℝ) : ℂ) * Complex.I)) - (∫ a in A..B, F ((a : ℂ) + (T : ℂ) * Complex.I)) + Complex.I * (∫ t in -T..T, F ((B : ℂ) + (t : ℂ) * Complex.I)) - Complex.I * (∫ t in -T..T, F ((A : ℂ) + (t : ℂ) * Complex.I)) = 0"},{"kind":"theorem","name":"plusSaddleMellinData_positive_vertical_integral_eq","statement":"{ε ℓ r A B : ℝ} (hε : 0 < ε) (hℓ : 0 < ℓ) (horder : shortCutoff ε ≤ shortEndpoint ε) (hr : 0 < r) (hA : 0 < A) (hB : 0 < B) (hAB : A ≤ B) : (∫ t : ℝ, saddleMellinInversePower r ((B : ℂ) + (t : ℂ) * Complex.I) * plusSaddleMellinData ε ℓ ((B : ℂ) + (t : ℂ) * Complex.I)) = (∫ t : ℝ, saddleMellinInversePower r ((A : ℂ) + (t : ℂ) * Complex.I) * plusSaddleMellinData ε ℓ ((A : ℂ) + (t : ℂ) * Complex.I))"},{"kind":"theorem","name":"minusSaddleMellinData_positive_vertical_integral_eq","statement":"{ε ℓ r A B : ℝ} (hε : 0 < ε) (hℓ : 0 < ℓ) (horder : shortCutoff ε ≤ shortEndpoint ε) (hr : 0 < r) (hA : 0 < A) (hB : 0 < B) (hAB : A ≤ B) : (∫ t : ℝ, saddleMellinInversePower r ((B : ℂ) + (t : ℂ) * Complex.I) * minusSaddleMellinData ε ℓ ((B : ℂ) + (t : ℂ) * Complex.I)) = (∫ t : ℝ, saddleMellinInversePower r ((A : ℂ) + (t : ℂ) * Complex.I) * minusSaddleMellinData ε ℓ ((A : ℂ) + (t : ℂ) * Complex.I))"},{"kind":"theorem","name":"plusSaddleProfile_eq_positive_contour","statement":"{ε ℓ r a : ℝ} (hε : 0 < ε) (hℓ : 0 < ℓ) (horder : shortCutoff ε ≤ shortEndpoint ε) (hr : 0 < r) (ha : 0 < a) : plusSaddleProfile ε ℓ r = ((1 / (2 * Real.pi) : ℝ) : ℂ) * (∫ t : ℝ, saddleMellinInversePower r ((a : ℂ) + (t : ℂ) * Complex.I) * plusSaddleMellinData ε ℓ ((a : ℂ) + (t : ℂ) * Complex.I))"},{"kind":"theorem","name":"minusSaddleProfile_eq_positive_contour","statement":"{ε ℓ r a : ℝ} (hε : 0 < ε) (hℓ : 0 < ℓ) (horder : shortCutoff ε ≤ shortEndpoint ε) (hr : 0 < r) (ha : 0 < a) : minusSaddleProfile ε ℓ r = ((1 / (2 * Real.pi) : ℝ) : ℂ) * (∫ t : ℝ, saddleMellinInversePower r ((a : ℂ) + (t : ℂ) * Complex.I) * minusSaddleMellinData ε ℓ ((a : ℂ) + (t : ℂ) * Complex.I))"},{"kind":"theorem","name":"plusSaddleProfile_eq_positive_squaredContour","statement":"{ε ℓ r a : ℝ} (hε : 0 < ε) (hℓ : 0 < ℓ) (horder : shortCutoff ε ≤ shortEndpoint ε) (hr : 0 < r) (ha : 0 < a) : plusSaddleProfile ε ℓ r = plusSaddlePositiveSquaredContour ε ℓ a (r ^ 2)"},{"kind":"theorem","name":"minusSaddleProfile_eq_positive_squaredContour","statement":"{ε ℓ r a : ℝ} (hε : 0 < ε) (hℓ : 0 < ℓ) (horder : shortCutoff ε ≤ shortEndpoint ε) (hr : 0 < r) (ha : 0 < a) : minusSaddleProfile ε ℓ r = minusSaddlePositiveSquaredContour ε ℓ a (r ^ 2)"},{"kind":"theorem","name":"saddlePositiveCpow_hasDerivAt_of_pos","statement":"{z : ℂ} (hz : z ≠ 0) {u : ℝ} (hu : 0 < u) : HasDerivAt (saddlePositiveCpow z) (z * saddlePositiveCpow (z - 1) u) u"},{"kind":"theorem","name":"saddlePositiveContourPower_frequency_continuous_of_pos","statement":"(a : ℝ) (j : ℕ) {u : ℝ} (hu : 0 < u) : Continuous (fun t : ℝ => saddlePositiveCpow (saddleContourExponent a t - (j : ℂ)) u)"},{"kind":"theorem","name":"saddlePositiveCpow_norm_le_one_of_nonpos","statement":"{z : ℂ} (hz : z.re ≤ 0) {u : ℝ} (hu : u ∈ Set.Ioi (1 : ℝ)) : ‖saddlePositiveCpow z u‖ ≤ 1"},{"kind":"theorem","name":"saddlePositiveContourMoment_hasDerivAt_of_positiveContour","statement":"{D : ℝ → ℂ} (hD : ∀ k : ℕ, Integrable (fun t : ℝ => (t : ℂ) ^ k * D t)) {a : ℝ} (ha : 0 < a) (j : ℕ) {u : ℝ} (hu : u ∈ Set.Ioi (1 : ℝ)) : HasDerivAt (saddlePositiveContourMoment a j D) (saddlePositiveContourMoment a (j + 1) D u) u"},{"kind":"theorem","name":"saddlePositiveContourMoment_contDiffOn_of_positiveContour","statement":"{D : ℝ → ℂ} (hD : ∀ k : ℕ, Integrable (fun t : ℝ => (t : ℂ) ^ k * D t)) {a : ℝ} (ha : 0 < a) (n j : ℕ) : ContDiffOn ℝ n (saddlePositiveContourMoment a j D) (Set.Ioi (1 : ℝ))"},{"kind":"theorem","name":"saddlePositiveContourMoment_contDiffOn_infty_of_positiveContour","statement":"{D : ℝ → ℂ} (hD : ∀ k : ℕ, Integrable (fun t : ℝ => (t : ℂ) ^ k * D t)) {a : ℝ} (ha : 0 < a) (j : ℕ) : ContDiffOn ℝ ∞ (saddlePositiveContourMoment a j D) (Set.Ioi (1 : ℝ))"},{"kind":"theorem","name":"saddlePositiveContourMoment_iteratedDeriv_of_positiveContour","statement":"{D : ℝ → ℂ} (hD : ∀ k : ℕ, Integrable (fun t : ℝ => (t : ℂ) ^ k * D t)) {a : ℝ} (ha : 0 < a) (n j : ℕ) {u : ℝ} (hu : u ∈ Set.Ioi (1 : ℝ)) : iteratedDeriv n (saddlePositiveContourMoment a j D) u = saddlePositiveContourMoment a (j + n) D u"},{"kind":"theorem","name":"saddlePositiveContourMoment_norm_le","statement":"{D : ℝ → ℂ} (hD : ∀ k : ℕ, Integrable (fun t : ℝ => (t : ℂ) ^ k * D t)) (a : ℝ) (j : ℕ) {u : ℝ} (hu : 0 < u) : ‖saddlePositiveContourMoment a j D u‖ ≤ u ^ (-a / 2 - (j : ℝ)) * saddleContourMomentL1 a j D"},{"kind":"theorem","name":"plusSaddlePositiveSquaredContour_contDiffOn","statement":"{ε ℓ a : ℝ} (hε : 0 < ε) (hℓ : 0 < ℓ) (horder : shortCutoff ε ≤ shortEndpoint ε) (ha : 0 < a) : ContDiffOn ℝ ∞ (plusSaddlePositiveSquaredContour ε ℓ a) (Set.Ioi (1 : ℝ))"},{"kind":"theorem","name":"minusSaddlePositiveSquaredContour_contDiffOn","statement":"{ε ℓ a : ℝ} (hε : 0 < ε) (hℓ : 0 < ℓ) (horder : shortCutoff ε ≤ shortEndpoint ε) (ha : 0 < a) : ContDiffOn ℝ ∞ (minusSaddlePositiveSquaredContour ε ℓ a) (Set.Ioi (1 : ℝ))"},{"kind":"theorem","name":"plusSaddlePositiveSquaredContour_eq_of_pos","statement":"{ε ℓ a b u : ℝ} (hε : 0 < ε) (hℓ : 0 < ℓ) (horder : shortCutoff ε ≤ shortEndpoint ε) (ha : 0 < a) (hb : 0 < b) (hu : 0 < u) : plusSaddlePositiveSquaredContour ε ℓ a u = plusSaddlePositiveSquaredContour ε ℓ b u"},{"kind":"theorem","name":"minusSaddlePositiveSquaredContour_eq_of_pos","statement":"{ε ℓ a b u : ℝ} (hε : 0 < ε) (hℓ : 0 < ℓ) (horder : shortCutoff ε ≤ shortEndpoint ε) (ha : 0 < a) (hb : 0 < b) (hu : 0 < u) : minusSaddlePositiveSquaredContour ε ℓ a u = minusSaddlePositiveSquaredContour ε ℓ b u"},{"kind":"theorem","name":"saddleOuterCutoff_contDiff","statement":"ContDiff ℝ ∞ saddleOuterCutoff"},{"kind":"theorem","name":"plusSaddleOuterSquaredProfile_contDiff","statement":"{ε ℓ : ℝ} (hε : 0 < ε) (hℓ : 0 < ℓ) (horder : shortCutoff ε ≤ shortEndpoint ε) : ContDiff ℝ ∞ (plusSaddleOuterSquaredProfile ε ℓ)"},{"kind":"theorem","name":"minusSaddleOuterSquaredProfile_contDiff","statement":"{ε ℓ : ℝ} (hε : 0 < ε) (hℓ : 0 < ℓ) (horder : shortCutoff ε ≤ shortEndpoint ε) : ContDiff ℝ ∞ (minusSaddleOuterSquaredProfile ε ℓ)"},{"kind":"theorem","name":"plusSaddleOuterSquaredProfile_eq_zero","statement":"(ε ℓ : ℝ) {u : ℝ} (hu : u < 2) : plusSaddleOuterSquaredProfile ε ℓ u = 0"},{"kind":"theorem","name":"minusSaddleOuterSquaredProfile_eq_zero","statement":"(ε ℓ : ℝ) {u : ℝ} (hu : u < 2) : minusSaddleOuterSquaredProfile ε ℓ u = 0"},{"kind":"theorem","name":"plusSaddleOuterSquaredProfile_eq_positiveContour","statement":"{ε ℓ a u : ℝ} (hε : 0 < ε) (hℓ : 0 < ℓ) (horder : shortCutoff ε ≤ shortEndpoint ε) (ha : 0 < a) (hu : 3 < u) : plusSaddleOuterSquaredProfile ε ℓ u = plusSaddlePositiveSquaredContour ε ℓ a u"},{"kind":"theorem","name":"minusSaddleOuterSquaredProfile_eq_positiveContour","statement":"{ε ℓ a u : ℝ} (hε : 0 < ε) (hℓ : 0 < ℓ) (horder : shortCutoff ε ≤ shortEndpoint ε) (ha : 0 < a) (hu : 3 < u) : minusSaddleOuterSquaredProfile ε ℓ u = minusSaddlePositiveSquaredContour ε ℓ a u"},{"kind":"theorem","name":"saddleOuterSquaredProfile_schwartz_decay","statement":"{G : ℝ → ℂ} (hG : ContDiff ℝ ∞ G) (hzero : ∀ u : ℝ, u < 2 → G u = 0) (D : ℝ → ℝ → ℂ) (hD : ∀ a : ℝ, 0 < a → ∀ j : ℕ, Integrable (fun t : ℝ => (t : ℂ) ^ j * D a t)) (htail : ∀ a : ℝ, 0 < a → ∀ u : ℝ, 3 < u → G u = ((1 / (2 * Real.pi) : ℝ) : ℂ) * saddlePositiveContourMoment a 0 (D a) u) (k n : ℕ) : ∃ C : ℝ, ∀ u : ℝ, ‖u‖ ^ k * ‖iteratedFDeriv ℝ n G u‖ ≤ C"},{"kind":"theorem","name":"plusSaddleOuterSquaredProfile_schwartz_decay","statement":"{ε ℓ : ℝ} (hε : 0 < ε) (hℓ : 0 < ℓ) (horder : shortCutoff ε ≤ shortEndpoint ε) (k n : ℕ) : ∃ C : ℝ, ∀ u : ℝ, ‖u‖ ^ k * ‖iteratedFDeriv ℝ n (plusSaddleOuterSquaredProfile ε ℓ) u‖ ≤ C"},{"kind":"theorem","name":"minusSaddleOuterSquaredProfile_schwartz_decay","statement":"{ε ℓ : ℝ} (hε : 0 < ε) (hℓ : 0 < ℓ) (horder : shortCutoff ε ≤ shortEndpoint ε) (k n : ℕ) : ∃ C : ℝ, ∀ u : ℝ, ‖u‖ ^ k * ‖iteratedFDeriv ℝ n (minusSaddleOuterSquaredProfile ε ℓ) u‖ ≤ C"},{"kind":"theorem","name":"plusSaddleOuterDifference_hasCompactSupport","statement":"{ε ℓ : ℝ} (hε : 0 < ε) (hℓ : 0 < ℓ) (horder : shortCutoff ε ≤ shortEndpoint ε) (d : ℕ) : HasCompactSupport (fun x : Euclidean d => plusSaddleProfile ε ℓ ‖x‖ - plusSaddleOuterSchwartz hε hℓ horder d x)"},{"kind":"theorem","name":"minusSaddleOuterDifference_hasCompactSupport","statement":"{ε ℓ : ℝ} (hε : 0 < ε) (hℓ : 0 < ℓ) (horder : shortCutoff ε ≤ shortEndpoint ε) (d : ℕ) : HasCompactSupport (fun x : Euclidean d => minusSaddleProfile ε ℓ ‖x‖ - minusSaddleOuterSchwartz hε hℓ horder d x)"},{"kind":"theorem","name":"saddleSourceContourEnvelopeScale_pos","statement":"{ε ℓ u : ℝ} (hℓ : 0 < ℓ) (hu : -1 < u) : 0 < saddleSourceContourEnvelopeScale ε ℓ u"},{"kind":"theorem","name":"saddleSourceContour_piExponential_norm","statement":"(ℓ u T : ℝ) : ‖Complex.exp (((ℓ : ℂ) - saddleSourceMellinContour ℓ u T) * (Real.log Real.pi : ℂ) / 2)‖ = Real.exp (-(ℓ * u) * Real.log Real.pi / 2)"},{"kind":"theorem","name":"saddleSourceContour_gamma_norm","statement":"{ℓ u : ℝ} (hℓ : 0 < ℓ) (hu : -1 < u) (T : ℝ) : ‖Complex.Gamma (saddleSourceMellinContour ℓ u T / 2)‖ = Real.Gamma (ℓ * (1 + u) / 2) * Real.exp (-upperGammaDamping ℓ (1 + u) T)"},{"kind":"theorem","name":"saddleSourceContour_shellExponential_norm","statement":"{ε ℓ u : ℝ} (hε : 0 < ε) (hℓ : 0 < ℓ) (horder : shortCutoff ε ≤ shortEndpoint ε) (T : ℝ) : ‖Complex.exp ((ℓ : ℂ) * mellinShellPhase ε (Complex.I * (saddleSourceMellinContour ℓ u T - (ℓ : ℂ)) / (ℓ : ℂ)))‖ = Real.exp (ℓ * realHyperbolicShellPhase ε u) * Real.exp (-(positiveShellDamping ε ℓ (u - 1) T - upperShortShellDamping ε ℓ (u - 1) T))"},{"kind":"theorem","name":"saddleSourceContour_mellinEnvelope_norm","statement":"{ε ℓ u : ℝ} (hε : 0 < ε) (hℓ : 0 < ℓ) (hu : -1 < u) (horder : shortCutoff ε ≤ shortEndpoint ε) (T : ℝ) : ‖saddleMellinEnvelope ε ℓ (saddleSourceMellinContour ℓ u T)‖ = saddleSourceContourEnvelopeScale ε ℓ u * Real.exp (-saddleSourceContourDamping ε ℓ u T)"},{"kind":"theorem","name":"saddleSourceNormalizedEnvelope_norm","statement":"{ε ℓ u : ℝ} (hε : 0 < ε) (hℓ : 0 < ℓ) (hu : -1 < u) (horder : shortCutoff ε ≤ shortEndpoint ε) (T : ℝ) : ‖saddleSourceNormalizedEnvelope ε ℓ u T‖ = Real.exp (-saddleSourceContourDamping ε ℓ u T)"},{"kind":"theorem","name":"saddleSourceCenteredEnvelope_norm","statement":"{ε ℓ u : ℝ} (hε : 0 < ε) (hℓ : 0 < ℓ) (hu : -1 < u) (horder : shortCutoff ε ≤ shortEndpoint ε) (v T : ℝ) : ‖saddleSourceCenteredEnvelope ε ℓ u v T‖ = Real.exp (-saddleSourceContourDamping ε ℓ u T)"},{"kind":"theorem","name":"saddleSourceCenteredPlusIntegrand_norm","statement":"{ε ℓ u : ℝ} (hε : 0 < ε) (hℓ : 0 < ℓ) (hu : -1 < u) (horder : shortCutoff ε ≤ shortEndpoint ε) (v T : ℝ) : ‖saddleSourceCenteredPlusIntegrand ε ℓ u v T‖ = Real.exp (-saddleSourceContourDamping ε ℓ u T) * ‖plusPolynomial ε ((T : ℂ) + Complex.I * (u : ℂ))‖"},{"kind":"theorem","name":"saddleSourceCenteredMinusIntegrand_norm","statement":"{ε ℓ u : ℝ} (hε : 0 < ε) (hℓ : 0 < ℓ) (hu : -1 < u) (horder : shortCutoff ε ≤ shortEndpoint ε) (v T : ℝ) : ‖saddleSourceCenteredMinusIntegrand ε ℓ u v T‖ = Real.exp (-saddleSourceContourDamping ε ℓ u T) * ‖minusPolynomial ε ((T : ℂ) + Complex.I * (u : ℂ))‖"},{"kind":"theorem","name":"saddleSourceMellinContour_integral_change","statement":"{ℓ : ℝ} (hℓ : 0 < ℓ) (u : ℝ) (F : ℂ → ℂ) : (∫ t : ℝ, F (((ℓ * (1 + u) : ℝ) : ℂ) + (t : ℂ) * Complex.I)) = (ℓ : ℂ) * (∫ T : ℝ, F (saddleSourceMellinContour ℓ u T))"},{"kind":"theorem","name":"plusSaddleProfile_eq_sourceContourIntegral","statement":"{ε ℓ r u : ℝ} (hε : 0 < ε) (hℓ : 0 < ℓ) (horder : shortCutoff ε ≤ shortEndpoint ε) (hr : 0 < r) (hu : -1 < u) : plusSaddleProfile ε ℓ r = ((ℓ / (2 * Real.pi) : ℝ) : ℂ) * (∫ T : ℝ, saddleMellinInversePower r (saddleSourceMellinContour ℓ u T) * plusSaddleMellinData ε ℓ (saddleSourceMellinContour ℓ u T))"},{"kind":"theorem","name":"minusSaddleProfile_eq_sourceContourIntegral","statement":"{ε ℓ r u : ℝ} (hε : 0 < ε) (hℓ : 0 < ℓ) (horder : shortCutoff ε ≤ shortEndpoint ε) (hr : 0 < r) (hu : -1 < u) : minusSaddleProfile ε ℓ r = ((ℓ / (2 * Real.pi) : ℝ) : ℂ) * (∫ T : ℝ, saddleMellinInversePower r (saddleSourceMellinContour ℓ u T) * minusSaddleMellinData ε ℓ (saddleSourceMellinContour ℓ u T))"},{"kind":"theorem","name":"saddleSourceContour_inversePower_exp","statement":"(ℓ u v T : ℝ) : saddleMellinInversePower (Real.exp v) (saddleSourceMellinContour ℓ u T) = ((Real.exp (-(ℓ * (1 + u) * v)) : ℝ) : ℂ) * Complex.exp (Complex.I * ((ℓ * T * v : ℝ) : ℂ))"},{"kind":"theorem","name":"saddleSourceCenteredPrefactor_pos","statement":"{ε ℓ u : ℝ} (hℓ : 0 < ℓ) (hu : -1 < u) (v : ℝ) : 0 < saddleSourceCenteredPrefactor ε ℓ u v"},{"kind":"theorem","name":"saddleSourceContour_envelope_eq_scale_mul_normalized","statement":"{ε ℓ u : ℝ} (hℓ : 0 < ℓ) (hu : -1 < u) (T : ℝ) : saddleMellinEnvelope ε ℓ (saddleSourceMellinContour ℓ u T) = (saddleSourceContourEnvelopeScale ε ℓ u : ℂ) * saddleSourceNormalizedEnvelope ε ℓ u T"},{"kind":"theorem","name":"plusSaddleProfile_exp_eq_centeredIntegral","statement":"{ε ℓ u : ℝ} (hε : 0 < ε) (hℓ : 0 < ℓ) (hu : -1 < u) (horder : shortCutoff ε ≤ shortEndpoint ε) (v : ℝ) : plusSaddleProfile ε ℓ (Real.exp v) = (saddleSourceCenteredPrefactor ε ℓ u v : ℂ) * (∫ T : ℝ, saddleSourceCenteredPlusIntegrand ε ℓ u v T)"},{"kind":"theorem","name":"minusSaddleProfile_exp_eq_centeredIntegral","statement":"{ε ℓ u : ℝ} (hε : 0 < ε) (hℓ : 0 < ℓ) (hu : -1 < u) (horder : shortCutoff ε ≤ shortEndpoint ε) (v : ℝ) : minusSaddleProfile ε ℓ (Real.exp v) = (saddleSourceCenteredPrefactor ε ℓ u v : ℂ) * (∫ T : ℝ, saddleSourceCenteredMinusIntegrand ε ℓ u v T)"},{"kind":"theorem","name":"saddleSourceGaussianKernel_integrable","statement":"{ε ℓ u : ℝ} (hℓ : 0 < ℓ) (hV : 0 < saddleSourceGaussianVariance ε ℓ u) : Integrable (saddleSourceGaussianKernel ε ℓ u)"},{"kind":"theorem","name":"saddleSourceGaussianKernel_integral","statement":"(ε ℓ u : ℝ) : (∫ T : ℝ, saddleSourceGaussianKernel ε ℓ u T) = Real.sqrt (Real.pi / (ℓ * saddleSourceGaussianVariance ε ℓ u / 2))"},{"kind":"theorem","name":"saddleSourceGaussianKernel_integral_pos","statement":"{ε ℓ u : ℝ} (hℓ : 0 < ℓ) (hV : 0 < saddleSourceGaussianVariance ε ℓ u) : 0 < ∫ T : ℝ, saddleSourceGaussianKernel ε ℓ u T"},{"kind":"theorem","name":"saddleSourceGaussianPlusIntegrand_integrable","statement":"{ε ℓ u : ℝ} (hℓ : 0 < ℓ) (hV : 0 < saddleSourceGaussianVariance ε ℓ u) : Integrable (saddleSourceGaussianPlusIntegrand ε ℓ u)"},{"kind":"theorem","name":"saddleSourceGaussianMinusIntegrand_integrable","statement":"{ε ℓ u : ℝ} (hℓ : 0 < ℓ) (hV : 0 < saddleSourceGaussianVariance ε ℓ u) : Integrable (saddleSourceGaussianMinusIntegrand ε ℓ u)"},{"kind":"theorem","name":"saddleSourceGaussianPlusIntegrand_integral","statement":"(ε ℓ u : ℝ) : (∫ T : ℝ, saddleSourceGaussianPlusIntegrand ε ℓ u T) = (Real.sqrt (Real.pi / (ℓ * saddleSourceGaussianVariance ε ℓ u / 2)) : ℂ) * plusPolynomial ε (Complex.I * (u : ℂ))"},{"kind":"theorem","name":"saddleSourceGaussianMinusIntegrand_integral","statement":"(ε ℓ u : ℝ) : (∫ T : ℝ, saddleSourceGaussianMinusIntegrand ε ℓ u T) = (Real.sqrt (Real.pi / (ℓ * saddleSourceGaussianVariance ε ℓ u / 2)) : ℂ) * minusPolynomial ε (Complex.I * (u : ℂ))"},{"kind":"theorem","name":"eventually_saddleSourceGaussianVariance_secondBranch_pos","statement":"∀ᶠ ε : ℝ in 𝓝[>] (0 : ℝ), ∀ ℓ : ℝ, 0 < ℓ → ∀ δ : ℝ, ε / 2 ≤ δ → 0 < saddleSourceGaussianVariance ε ℓ (1 + δ)"},{"kind":"theorem","name":"plusSaddleProfile_exp_re_pos_of_gaussian_error","statement":"{ε ℓ u v : ℝ} (hε : 0 < ε) (hℓ : 0 < ℓ) (hu : -1 < u) (horder : shortCutoff ε ≤ shortEndpoint ε) (hV : 0 < saddleSourceGaussianVariance ε ℓ u) (herror : ‖(∫ T : ℝ, saddleSourceCenteredPlusIntegrand ε ℓ u v T) - (∫ T : ℝ, saddleSourceGaussianPlusIntegrand ε ℓ u T)‖ < (∫ T : ℝ, saddleSourceGaussianPlusIntegrand ε ℓ u T).re) : 0 < (plusSaddleProfile ε ℓ (Real.exp v)).re"},{"kind":"theorem","name":"minusSaddleProfile_exp_re_neg_of_gaussian_error","statement":"{ε ℓ u v : ℝ} (hε : 0 < ε) (hℓ : 0 < ℓ) (hu : -1 < u) (horder : shortCutoff ε ≤ shortEndpoint ε) (hV : 0 < saddleSourceGaussianVariance ε ℓ u) (herror : ‖(∫ T : ℝ, saddleSourceCenteredMinusIntegrand ε ℓ u v T) - (∫ T : ℝ, saddleSourceGaussianMinusIntegrand ε ℓ u T)‖ < -(∫ T : ℝ, saddleSourceGaussianMinusIntegrand ε ℓ u T).re) : (minusSaddleProfile ε ℓ (Real.exp v)).re < 0"},{"kind":"theorem","name":"saddleSourcePositiveShellVariance_nonneg","statement":"(ε δ : ℝ) : 0 ≤ upperPositiveShellVariance ε δ"},{"kind":"theorem","name":"upperFirstBranch_shortVariance_le_gamma","statement":"{ε ℓ u : ℝ} (hε : 0 < ε) (hεsmall : ε ≤ 1 / 4) (hℓ : 0 < ℓ) (hulower : -1 < u) (huupper : u ≤ 1 + ε / 2) (horder : shortCutoff ε ≤ shortEndpoint ε) (hmargin : ∀ a ∈ Icc (shortCutoff ε) (shortEndpoint ε), 0 ≤ shortMargin ε a) : upperShortShellVariance ε (u - 1) ≤ (1 - 4 * ε) * upperGammaVariance ℓ (1 + u)"},{"kind":"theorem","name":"upperFirstBranch_saddleSourceGaussianVariance_lower_bound","statement":"{ε ℓ u : ℝ} (hε : 0 < ε) (hεsmall : ε ≤ 1 / 4) (hℓ : 0 < ℓ) (hulower : -1 < u) (huupper : u ≤ 1 + ε / 2) (horder : shortCutoff ε ≤ shortEndpoint ε) (hmargin : ∀ a ∈ Icc (shortCutoff ε) (shortEndpoint ε), 0 ≤ shortMargin ε a) : 4 * ε * upperGammaVariance ℓ (1 + u) ≤ saddleSourceGaussianVariance ε ℓ u"},{"kind":"theorem","name":"eventually_saddleSourceGaussianVariance_firstBranch_pos","statement":"∀ᶠ ε : ℝ in 𝓝[>] (0 : ℝ), ∀ ℓ : ℝ, 0 < ℓ → ∀ u : ℝ, -1 < u → u ≤ 1 + ε / 2 → 0 < saddleSourceGaussianVariance ε ℓ u"},{"kind":"theorem","name":"saddleSourceCenteredPlusIntegrand_sourcePointwise","statement":"{ε ℓ u : ℝ} (hℓ : 0 < ℓ) (hu : -1 < u) (v T : ℝ) : saddleMellinInversePower (Real.exp v) (saddleSourceMellinContour ℓ u T) * plusSaddleMellinData ε ℓ (saddleSourceMellinContour ℓ u T) = ((Real.exp (-(ℓ * (1 + u) * v)) * saddleSourceContourEnvelopeScale ε ℓ u : ℝ) : ℂ) * saddleSourceCenteredPlusIntegrand ε ℓ u v T"},{"kind":"theorem","name":"saddleSourceCenteredMinusIntegrand_sourcePointwise","statement":"{ε ℓ u : ℝ} (hℓ : 0 < ℓ) (hu : -1 < u) (v T : ℝ) : saddleMellinInversePower (Real.exp v) (saddleSourceMellinContour ℓ u T) * minusSaddleMellinData ε ℓ (saddleSourceMellinContour ℓ u T) = ((Real.exp (-(ℓ * (1 + u) * v)) * saddleSourceContourEnvelopeScale ε ℓ u : ℝ) : ℂ) * saddleSourceCenteredMinusIntegrand ε ℓ u v T"},{"kind":"theorem","name":"saddleSourceCenteredPlusIntegrand_integrable","statement":"{ε ℓ u : ℝ} (hε : 0 < ε) (hℓ : 0 < ℓ) (hu : -1 < u) (horder : shortCutoff ε ≤ shortEndpoint ε) (v : ℝ) : Integrable (saddleSourceCenteredPlusIntegrand ε ℓ u v)"},{"kind":"theorem","name":"saddleSourceCenteredMinusIntegrand_integrable","statement":"{ε ℓ u : ℝ} (hε : 0 < ε) (hℓ : 0 < ℓ) (hu : -1 < u) (horder : shortCutoff ε ≤ shortEndpoint ε) (v : ℝ) : Integrable (saddleSourceCenteredMinusIntegrand ε ℓ u v)"},{"kind":"theorem","name":"upperImaginaryExp_hasDerivAt","statement":"(x : ℝ) : HasDerivAt upperImaginaryExp (Complex.I * upperImaginaryExp x) x"},{"kind":"theorem","name":"upperImaginaryExp_iteratedDeriv","statement":"(n : ℕ) (x : ℝ) : iteratedDeriv n upperImaginaryExp x = Complex.I ^ n * upperImaginaryExp x"},{"kind":"theorem","name":"upperImaginaryExp_norm","statement":"(x : ℝ) : ‖upperImaginaryExp x‖ = 1"},{"kind":"theorem","name":"upperImaginaryExp_contDiff","statement":"ContDiff ℝ (⊤ : WithTop ℕ∞) upperImaginaryExp"},{"kind":"theorem","name":"upperImaginaryExp_iteratedDeriv_norm","statement":"(n : ℕ) (x : ℝ) : ‖iteratedDeriv n upperImaginaryExp x‖ = 1"},{"kind":"theorem","name":"upperImaginaryExp_iteratedDerivWithin_Icc","statement":"{a b x : ℝ} (hab : a < b) (hx : x ∈ Icc a b) (n : ℕ) : iteratedDerivWithin n upperImaginaryExp (Icc a b) x = Complex.I ^ n * upperImaginaryExp x"},{"kind":"theorem","name":"upperImaginaryExp_taylorWithinEval_two","statement":"{x : ℝ} (hx : 0 < x) : taylorWithinEval upperImaginaryExp 2 (Icc (0 : ℝ) x) 0 x = 1 + Complex.I * (x : ℂ) - ((x ^ 2 / 2 : ℝ) : ℂ)"},{"kind":"theorem","name":"upperImaginaryExp_cubicIntegral_norm_le","statement":"{x : ℝ} (hx : 0 ≤ x) : ‖∫ t in (0 : ℝ)..x, ((x - t) ^ 2 / 2 : ℝ) • iteratedDeriv 3 upperImaginaryExp t‖ ≤ x ^ 3 / 6"},{"kind":"theorem","name":"upperImaginaryExp_neg","statement":"(x : ℝ) : upperImaginaryExp (-x) = starRingEnd ℂ (upperImaginaryExp x)"},{"kind":"theorem","name":"upperImaginaryExp_quadratic_remainder_norm_le_of_nonneg","statement":"{x : ℝ} (hx : 0 ≤ x) : ‖upperImaginaryExp x - 1 - Complex.I * (x : ℂ) + ((x ^ 2 / 2 : ℝ) : ℂ)‖ ≤ x ^ 3 / 6"},{"kind":"theorem","name":"upperImaginaryExp_quadratic_remainder_norm_le","statement":"(x : ℝ) : ‖upperImaginaryExp x - 1 - Complex.I * (x : ℂ) + ((x ^ 2 / 2 : ℝ) : ℂ)‖ ≤ |x| ^ 3 / 6"},{"kind":"theorem","name":"saddleSourceShiftedCosine_eq_imaginaryExponentials","statement":"(a u T : ℝ) : Complex.cos ((a : ℂ) * ((T : ℂ) + Complex.I * (u : ℂ))) = ((Real.exp (-(u * a)) / 2 : ℝ) : ℂ) * upperImaginaryExp (a * T) + ((Real.exp (u * a) / 2 : ℝ) : ℂ) * upperImaginaryExp (-(a * T))"},{"kind":"theorem","name":"saddleSourceCosineQuadraticRemainder_eq","statement":"(a u T : ℝ) : saddleSourceCosineQuadraticRemainder a u T = ((Real.exp (-(u * a)) / 2 : ℝ) : ℂ) * (upperImaginaryExp (a * T) - 1 - Complex.I * ((a * T : ℝ) : ℂ) + (((a * T) ^ 2 / 2 : ℝ) : ℂ)) + ((Real.exp (u * a) / 2 : ℝ) : ℂ) * (upperImaginaryExp (-(a * T)) - 1 - Complex.I * ((-(a * T) : ℝ) : ℂ) + (((-(a * T)) ^ 2 / 2 : ℝ) : ℂ))"},{"kind":"theorem","name":"saddleSourceCosineQuadraticRemainder_norm_le","statement":"(a u T : ℝ) : ‖saddleSourceCosineQuadraticRemainder a u T‖ ≤ Real.cosh (u * a) * |a * T| ^ 3 / 6"},{"kind":"theorem","name":"saddleSourceWeightedCosineQuadraticRemainder_norm_le","statement":"(w : ℝ → ℝ) {b c : ℝ} (hbc : b ≤ c) (hb : 0 ≤ b) (hw : ContinuousOn w (Icc b c)) (hwnonneg : ∀ a ∈ Icc b c, 0 ≤ w a) (u T : ℝ) : ‖∫ a in b..c, (w a : ℂ) * saddleSourceCosineQuadraticRemainder a u T‖ ≤ (|T| ^ 3 / 6) * ∫ a in b..c, w a * a ^ 3 * Real.cosh (u * a)"},{"kind":"theorem","name":"saddleSourcePositiveShellQuadraticRemainder_norm_le","statement":"{ε : ℝ} (hε : 0 < ε) (u T : ℝ) : ‖∫ a in shellLocation ε..shellLocation ε + 1, (positiveShellDensity ε a : ℂ) * saddleSourceCosineQuadraticRemainder a u T‖ ≤ (|T| ^ 3 / 6) * upperPositiveShellThirdMoment ε (u - 1)"},{"kind":"theorem","name":"saddleSourceShortShellQuadraticRemainder_norm_le","statement":"{ε : ℝ} (hε : 0 < ε) (horder : shortCutoff ε ≤ shortEndpoint ε) (hmargin : ∀ a ∈ Icc (shortCutoff ε) (shortEndpoint ε), 0 ≤ shortMargin ε a) (u T : ℝ) : ‖∫ a in shortCutoff ε..shortEndpoint ε, (shortShellDensity ε a : ℂ) * saddleSourceCosineQuadraticRemainder a u T‖ ≤ (|T| ^ 3 / 6) * upperShortShellThirdMoment ε (u - 1)"},{"kind":"theorem","name":"saddleSourceWeightedCosineQuadraticRemainder_integral_eq","statement":"(w : ℝ → ℝ) {b c : ℝ} (hbc : b ≤ c) (hw : ContinuousOn w (Icc b c)) (u T : ℝ) : (∫ a in b..c, (w a : ℂ) * saddleSourceCosineQuadraticRemainder a u T) = (∫ a in b..c, (w a : ℂ) * (Complex.cos ((a : ℂ) * ((T : ℂ) + Complex.I * (u : ℂ))) - 1)) - (∫ a in b..c, (w a : ℂ) * ((Real.cosh (u * a) : ℂ) - 1)) + Complex.I * ((T * ∫ a in b..c, w a * a * Real.sinh (u * a) : ℝ) : ℂ) + ((T ^ 2 / 2 * ∫ a in b..c, w a * a ^ 2 * Real.cosh (u * a) : ℝ) : ℂ)"},{"kind":"theorem","name":"saddleSourceShellQuadraticRemainder_eq","statement":"{ε : ℝ} (hε : 0 < ε) (horder : shortCutoff ε ≤ shortEndpoint ε) (u T : ℝ) : saddleSourceShellQuadraticRemainder ε u T = mellinShellPhase ε ((T : ℂ) + Complex.I * (u : ℂ)) - (realHyperbolicShellPhase ε u : ℂ) + Complex.I * ((T * saddleSourceShellDerivative ε u : ℝ) : ℂ) + ((T ^ 2 / 2 * upperNetShellVariance ε (u - 1) : ℝ) : ℂ)"},{"kind":"theorem","name":"saddleSourceShellCenteredPhase_cubic_remainder_norm_le","statement":"{ε ℓ : ℝ} (hε : 0 < ε) (hℓ : 0 ≤ ℓ) (horder : shortCutoff ε ≤ shortEndpoint ε) (hmargin : ∀ a ∈ Icc (shortCutoff ε) (shortEndpoint ε), 0 ≤ shortMargin ε a) (u T : ℝ) : ‖saddleSourceShellCenteredPhase ε ℓ u T + ((ℓ * upperNetShellVariance ε (u - 1) / 2 * T ^ 2 : ℝ) : ℂ)‖ ≤ (ℓ * upperNetShellThirdMoment ε (u - 1) / 6) * |T| ^ 3"},{"kind":"theorem","name":"upperImaginaryExp_centered_norm_le","statement":"(x : ℝ) : ‖upperImaginaryExp x - 1 - Complex.I * (x : ℂ)‖ ≤ x ^ 2 / 2 + |x| ^ 3 / 6"},{"kind":"theorem","name":"upperGammaCenteredKernel_integrable","statement":"{ℓ η : ℝ} (hℓ : 0 < ℓ) (hη : 0 < η) (T : ℝ) : IntegrableOn (upperGammaCenteredKernel ℓ η T) (Ioi 0)"},{"kind":"theorem","name":"upperGammaQuadraticKernel_integrable","statement":"{ℓ η : ℝ} (hℓ : 0 < ℓ) (hη : 0 < η) (T : ℝ) : IntegrableOn (upperGammaQuadraticKernel ℓ η T) (Ioi 0)"},{"kind":"theorem","name":"integral_upperGammaQuadraticKernel","statement":"{ℓ η : ℝ} (hℓ : 0 < ℓ) (T : ℝ) : (∫ a : ℝ in Ioi 0, upperGammaQuadraticKernel ℓ η T a) = ((ℓ * upperGammaVariance ℓ η / 2 * T ^ 2 : ℝ) : ℂ)"},{"kind":"theorem","name":"upperGammaCubicRemainderKernel_norm_le","statement":"{ℓ η a : ℝ} (hℓ : 0 < ℓ) (ha : 0 < a) (T : ℝ) : ‖upperGammaCubicRemainderKernel ℓ η T a‖ ≤ (|T| ^ 3 / 6) * (a ^ 3 * upperGammaMeasureDensity ℓ η a)"},{"kind":"theorem","name":"upperGammaCenteredPhase_add_quadratic_eq_integral","statement":"{ℓ η : ℝ} (hℓ : 0 < ℓ) (hη : 0 < η) (T : ℝ) : upperGammaCenteredPhase ℓ η T + ((ℓ * upperGammaVariance ℓ η / 2 * T ^ 2 : ℝ) : ℂ) = ∫ a : ℝ in Ioi 0, upperGammaCubicRemainderKernel ℓ η T a"},{"kind":"theorem","name":"upperGammaCenteredPhase_cubic_remainder_norm_le","statement":"{ℓ η : ℝ} (hℓ : 0 < ℓ) (hη : 0 < η) (T : ℝ) : ‖upperGammaCenteredPhase ℓ η T + ((ℓ * upperGammaVariance ℓ η / 2 * T ^ 2 : ℝ) : ℂ)‖ ≤ (ℓ * upperGammaThirdMoment ℓ η / 6) * |T| ^ 3"},{"kind":"theorem","name":"saddleDigamma_add_one","statement":"{m : ℝ} (hm : 0 < m) : saddleDigamma (m + 1) = saddleDigamma m + m⁻¹"},{"kind":"theorem","name":"saddleDigamma_add_nat","statement":"{m : ℝ} (hm : 0 < m) (n : ℕ) : saddleDigamma (m + (n : ℝ)) = saddleDigamma m + ∑ k ∈ Finset.range n, (m + (k : ℝ))⁻¹"},{"kind":"theorem","name":"tendsto_saddleEulerHarmonicCorrection","statement":"{m : ℝ} (hm : 0 < m) : Tendsto (fun n : ℕ => Real.log (n : ℝ) - ∑ k ∈ Finset.range (n + 1), (m + (k : ℝ))⁻¹) atTop (𝓝 (saddleDigamma m))"},{"kind":"theorem","name":"upperCenteredLaplaceKernel_eq_frullani_sub_laplace","statement":"(c T : ℝ) {a : ℝ} (ha : a ≠ 0) : upperCenteredLaplaceKernel c T a = complexFrullaniKernel ((c : ℂ) - Complex.I * (T : ℂ)) (c : ℂ) a - Complex.I * (T : ℂ) * Complex.exp (-(c : ℂ) * (a : ℂ))"},{"kind":"theorem","name":"upperCenteredLaplaceKernel_integrable","statement":"{c : ℝ} (hc : 0 < c) (T : ℝ) : IntegrableOn (upperCenteredLaplaceKernel c T) (Ioi 0)"},{"kind":"theorem","name":"integral_upperCenteredLaplaceKernel","statement":"{c : ℝ} (hc : 0 < c) (T : ℝ) : (∫ a : ℝ in Ioi 0, upperCenteredLaplaceKernel c T a) = Complex.log (c : ℂ) - Complex.log ((c : ℂ) - Complex.I * (T : ℂ)) - Complex.I * (T : ℂ) * (c : ℂ)⁻¹"},{"kind":"theorem","name":"upperGammaCenteredTruncatedKernel_eq_sum","statement":"(ℓ η T : ℝ) (n : ℕ) (a : ℝ) : upperGammaCenteredTruncatedKernel ℓ η T n a = ∑ k ∈ Finset.range (n + 1), upperCenteredLaplaceKernel (η + 2 * (k : ℝ) / ℓ) T a"},{"kind":"theorem","name":"upperGammaCenteredGeometricLimit_eq_kernel","statement":"(ℓ η T a : ℝ) : upperCenteredLaplaceKernel η T a * (((1 - Real.exp (-(2 * a / ℓ)))⁻¹ : ℝ) : ℂ) = upperGammaCenteredKernel ℓ η T a"},{"kind":"theorem","name":"tendsto_integral_upperGammaCenteredTruncatedKernel","statement":"{ℓ η : ℝ} (hℓ : 0 < ℓ) (hη : 0 < η) (T : ℝ) : Tendsto (fun n : ℕ => ∫ a : ℝ in Ioi 0, upperGammaCenteredTruncatedKernel ℓ η T n a) atTop (𝓝 (upperGammaCenteredPhase ℓ η T))"},{"kind":"theorem","name":"exp_integral_upperCenteredLaplaceKernel","statement":"{c : ℝ} (hc : 0 < c) (T : ℝ) : Complex.exp (∫ a : ℝ in Ioi 0, upperCenteredLaplaceKernel c T a) = ((c : ℂ) / ((c : ℂ) - Complex.I * (T : ℂ))) * Complex.exp (-Complex.I * ((T / c : ℝ) : ℂ))"},{"kind":"theorem","name":"upperGammaEuler_centered_cpow_ratio","statement":"(m b : ℝ) {n : ℕ} (hn : 0 < n) : (n : ℂ) ^ ((m : ℂ) - Complex.I * (b : ℂ)) / (n : ℂ) ^ (m : ℂ) = Complex.exp (-Complex.I * ((b * Real.log (n : ℝ) : ℝ) : ℂ))"},{"kind":"theorem","name":"exp_integral_upperCenteredLaplaceKernel_scale","statement":"{c s : ℝ} (hc : 0 < c) (hs : 0 < s) (T : ℝ) : Complex.exp (∫ a : ℝ in Ioi 0, upperCenteredLaplaceKernel c T a) = (((s * c : ℝ) : ℂ) / (((s * c : ℝ) : ℂ) - Complex.I * ((s * T : ℝ) : ℂ))) * Complex.exp (-Complex.I * (((s * T / (s * c) : ℝ) : ℂ)))"},{"kind":"theorem","name":"exp_integral_upperGammaCenteredLaplaceRate","statement":"{ℓ η : ℝ} (hℓ : 0 < ℓ) (hη : 0 < η) (T : ℝ) (k : ℕ) : Complex.exp (∫ a : ℝ in Ioi 0, upperCenteredLaplaceKernel (η + 2 * (k : ℝ) / ℓ) T a) = ((((ℓ * η / 2 + (k : ℝ) : ℝ) : ℂ) / (((ℓ * η / 2 : ℝ) : ℂ) - Complex.I * ((ℓ * T / 2 : ℝ) : ℂ) + (k : ℂ)))) * Complex.exp (-Complex.I * (((ℓ * T / 2 / (ℓ * η / 2 + (k : ℝ)) : ℝ) : ℂ)))"},{"kind":"theorem","name":"upperGammaEuler_centered_ratio","statement":"{m : ℝ} (hm : 0 < m) (b : ℝ) {n : ℕ} (hn : 0 < n) : Complex.GammaSeq ((m : ℂ) - Complex.I * (b : ℂ)) n / Complex.GammaSeq (m : ℂ) n = Complex.exp (-Complex.I * ((b * Real.log (n : ℝ) : ℝ) : ℂ)) * ∏ k ∈ Finset.range (n + 1), (((m : ℂ) + (k : ℂ)) / ((m : ℂ) - Complex.I * (b : ℂ) + (k : ℂ)))"},{"kind":"theorem","name":"integral_upperGammaCenteredTruncatedKernel_eq_shell_sum","statement":"{ℓ η : ℝ} (hℓ : 0 < ℓ) (hη : 0 < η) (T : ℝ) (n : ℕ) : (∫ a : ℝ in Ioi 0, upperGammaCenteredTruncatedKernel ℓ η T n a) = ∑ k ∈ Finset.range (n + 1), (∫ a : ℝ in Ioi 0, upperCenteredLaplaceKernel (η + 2 * (k : ℝ) / ℓ) T a)"},{"kind":"theorem","name":"exp_integral_upperGammaCenteredTruncatedKernel_eq_product","statement":"{ℓ η : ℝ} (hℓ : 0 < ℓ) (hη : 0 < η) (T : ℝ) (n : ℕ) : Complex.exp (∫ a : ℝ in Ioi 0, upperGammaCenteredTruncatedKernel ℓ η T n a) = (∏ k ∈ Finset.range (n + 1), ((((ℓ * η / 2 + (k : ℝ) : ℝ) : ℂ) / (((ℓ * η / 2 : ℝ) : ℂ) - Complex.I * ((ℓ * T / 2 : ℝ) : ℂ) + (k : ℂ))))) * Complex.exp (-Complex.I * (((ℓ * T / 2 * (∑ k ∈ Finset.range (n + 1), (ℓ * η / 2 + (k : ℝ))⁻¹) : ℝ) : ℂ)))"},{"kind":"theorem","name":"exp_integral_upperGammaCenteredTruncatedKernel","statement":"{ℓ η : ℝ} (hℓ : 0 < ℓ) (hη : 0 < η) (T : ℝ) {n : ℕ} (hn : 0 < n) : Complex.exp (∫ a : ℝ in Ioi 0, upperGammaCenteredTruncatedKernel ℓ η T n a) = (Complex.GammaSeq (((ℓ * η / 2 : ℝ) : ℂ) - Complex.I * ((ℓ * T / 2 : ℝ) : ℂ)) n / Complex.GammaSeq ((ℓ * η / 2 : ℝ) : ℂ) n) * Complex.exp (Complex.I * (((ℓ * T / 2 * (Real.log (n : ℝ) - ∑ k ∈ Finset.range (n + 1), (ℓ * η / 2 + (k : ℝ))⁻¹) : ℝ) : ℂ)))"},{"kind":"theorem","name":"exp_upperGammaCenteredPhase","statement":"{ℓ η : ℝ} (hℓ : 0 < ℓ) (hη : 0 < η) (T : ℝ) : Complex.exp (upperGammaCenteredPhase ℓ η T) = (Complex.Gamma (((ℓ * η / 2 : ℝ) : ℂ) - Complex.I * ((ℓ * T / 2 : ℝ) : ℂ)) / (Real.Gamma (ℓ * η / 2) : ℂ)) * Complex.exp (Complex.I * ((ℓ * T / 2 * saddleDigamma (ℓ * η / 2) : ℝ) : ℂ))"},{"kind":"theorem","name":"saddleSourceStationaryLogRadius_eq_saddleLogRadius","statement":"(ε : ℝ) (d : ℕ) (u : ℝ) : saddleSourceStationaryLogRadius ε ((d : ℝ) / 2) u = saddleLogRadius ε d u"},{"kind":"theorem","name":"saddleSourceCenteredPhase_cubic_remainder_norm_le","statement":"{ε ℓ u : ℝ} (hε : 0 < ε) (hℓ : 0 < ℓ) (hu : -1 < u) (horder : shortCutoff ε ≤ shortEndpoint ε) (hmargin : ∀ a ∈ Icc (shortCutoff ε) (shortEndpoint ε), 0 ≤ shortMargin ε a) (T : ℝ) : ‖saddleSourceCenteredPhase ε ℓ u T + ((ℓ * saddleSourceGaussianVariance ε ℓ u / 2 * T ^ 2 : ℝ) : ℂ)‖ ≤ (ℓ * upperSaddleThirdMoment ε ℓ (u - 1) / 6) * |T| ^ 3"},{"kind":"theorem","name":"saddleSourceContour_piExponential_eq","statement":"(ℓ u T : ℝ) : Complex.exp (((ℓ : ℂ) - saddleSourceMellinContour ℓ u T) * (Real.log Real.pi : ℂ) / 2) = (Real.exp (-(ℓ * u) * Real.log Real.pi / 2) : ℂ) * Complex.exp (Complex.I * ((ℓ * T * Real.log Real.pi / 2 : ℝ) : ℂ))"},{"kind":"theorem","name":"saddleSourceContour_shellExponential_eq","statement":"(ε ℓ u T : ℝ) : Complex.exp ((ℓ : ℂ) * mellinShellPhase ε ((T : ℂ) + Complex.I * (u : ℂ))) = (Real.exp (ℓ * realHyperbolicShellPhase ε u) : ℂ) * Complex.exp ((ℓ : ℂ) * (mellinShellPhase ε ((T : ℂ) + Complex.I * (u : ℂ)) - (realHyperbolicShellPhase ε u : ℂ)))"},{"kind":"theorem","name":"saddleSourceCenteredEnvelope_eq_gamma_shell","statement":"{ε ℓ u : ℝ} (hℓ : 0 < ℓ) (hu : -1 < u) (v T : ℝ) : saddleSourceCenteredEnvelope ε ℓ u v T = (Complex.Gamma (((ℓ * (1 + u) / 2 : ℝ) : ℂ) - Complex.I * ((ℓ * T / 2 : ℝ) : ℂ)) / (Real.Gamma (ℓ * (1 + u) / 2) : ℂ)) * Complex.exp ((ℓ : ℂ) * (mellinShellPhase ε ((T : ℂ) + Complex.I * (u : ℂ)) - (realHyperbolicShellPhase ε u : ℂ))) * (Complex.exp (Complex.I * ((ℓ * T * Real.log Real.pi / 2 : ℝ) : ℂ)) * Complex.exp (Complex.I * ((ℓ * T * v : ℝ) : ℂ)))"},{"kind":"theorem","name":"saddleSourceStationaryFrequencyPhase_eq","statement":"(ε ℓ u T : ℝ) : Complex.exp (Complex.I * ((ℓ * T * Real.log Real.pi / 2 : ℝ) : ℂ)) * Complex.exp (Complex.I * ((ℓ * T * saddleSourceStationaryLogRadius ε ℓ u : ℝ) : ℂ)) = Complex.exp (Complex.I * ((ℓ * T / 2 * saddleDigamma (ℓ * (1 + u) / 2) : ℝ) : ℂ)) * Complex.exp (Complex.I * ((ℓ * T * saddleSourceShellDerivative ε u : ℝ) : ℂ))"},{"kind":"theorem","name":"exp_saddleSourceShellCenteredPhase","statement":"(ε ℓ u T : ℝ) : Complex.exp (saddleSourceShellCenteredPhase ε ℓ u T) = Complex.exp ((ℓ : ℂ) * (mellinShellPhase ε ((T : ℂ) + Complex.I * (u : ℂ)) - (realHyperbolicShellPhase ε u : ℂ))) * Complex.exp (Complex.I * ((ℓ * T * saddleSourceShellDerivative ε u : ℝ) : ℂ))"},{"kind":"theorem","name":"saddleSourceCenteredEnvelope_stationary_eq_exp_phase","statement":"{ε ℓ u : ℝ} (hℓ : 0 < ℓ) (hu : -1 < u) (T : ℝ) : saddleSourceCenteredEnvelope ε ℓ u (saddleSourceStationaryLogRadius ε ℓ u) T = Complex.exp (saddleSourceCenteredPhase ε ℓ u T)"},{"kind":"theorem","name":"exp_saddleSourceCenteredPhase_eq_gaussian_mul","statement":"(ε ℓ u T : ℝ) : Complex.exp (saddleSourceCenteredPhase ε ℓ u T) = (saddleSourceGaussianKernel ε ℓ u T : ℂ) * Complex.exp (saddleSourceGaussianPhaseRemainder ε ℓ u T)"},{"kind":"theorem","name":"saddleSourceCenteredEnvelope_stationary_gaussian_error_le","statement":"{ε ℓ u : ℝ} (hε : 0 < ε) (hℓ : 0 < ℓ) (hu : -1 < u) (horder : shortCutoff ε ≤ shortEndpoint ε) (hmargin : ∀ a ∈ Icc (shortCutoff ε) (shortEndpoint ε), 0 ≤ shortMargin ε a) (T : ℝ) (hsmall : (ℓ * upperSaddleThirdMoment ε ℓ (u - 1) / 6) * |T| ^ 3 ≤ 1) : ‖saddleSourceCenteredEnvelope ε ℓ u (saddleSourceStationaryLogRadius ε ℓ u) T - (saddleSourceGaussianKernel ε ℓ u T : ℂ)‖ ≤ 2 * saddleSourceGaussianKernel ε ℓ u T * ((ℓ * upperSaddleThirdMoment ε ℓ (u - 1) / 6) * |T| ^ 3)"},{"kind":"theorem","name":"saddleSourceCenteredPolynomial_centralGaussianError_le","statement":"{ε ℓ u R q p : ℝ} (hε : 0 < ε) (hℓ : 0 < ℓ) (hu : -1 < u) (horder : shortCutoff ε ≤ shortEndpoint ε) (hmargin : ∀ a ∈ Icc (shortCutoff ε) (shortEndpoint ε), 0 ≤ shortMargin ε a) (hV : 0 < saddleSourceGaussianVariance ε ℓ u) (hR : 0 ≤ R) (hq : 0 ≤ q) (hqone : q ≤ 1) (hp : 0 ≤ p) (P : ℂ → ℂ) (hsource : Integrable (fun T : ℝ => saddleSourceCenteredEnvelope ε ℓ u (saddleSourceStationaryLogRadius ε ℓ u) T * P ((T : ℂ) + Complex.I * (u : ℂ)))) (hcubic : ∀ T : ℝ, |T| ≤ R → (ℓ * upperSaddleThirdMoment ε ℓ (u - 1) / 6) * |T| ^ 3 ≤ q) (hpoly : ∀ T : ℝ, |T| ≤ R → ‖P ((T : ℂ) + Complex.I * (u : ℂ)) - P (Complex.I * (u : ℂ))‖ ≤ p * ‖P (Complex.I * (u : ℂ))‖) : ‖∫ T : ℝ in Icc (-R) R, (saddleSourceCenteredEnvelope ε ℓ u (saddleSourceStationaryLogRadius ε ℓ u) T * P ((T : ℂ) + Complex.I * (u : ℂ)) - (saddleSourceGaussianKernel ε ℓ u T : ℂ) * P (Complex.I * (u : ℂ)))‖ ≤ (2 * q + (1 + 2 * q) * p) * ‖P (Complex.I * (u : ℂ))‖ * ∫ T : ℝ, saddleSourceGaussianKernel ε ℓ u T"},{"kind":"theorem","name":"saddleSourceCenteredPlusIntegrand_centralGaussianError_le","statement":"{ε ℓ u R q p : ℝ} (hε : 0 < ε) (hℓ : 0 < ℓ) (hu : -1 < u) (horder : shortCutoff ε ≤ shortEndpoint ε) (hmargin : ∀ a ∈ Icc (shortCutoff ε) (shortEndpoint ε), 0 ≤ shortMargin ε a) (hV : 0 < saddleSourceGaussianVariance ε ℓ u) (hR : 0 ≤ R) (hq : 0 ≤ q) (hqone : q ≤ 1) (hp : 0 ≤ p) (hcubic : ∀ T : ℝ, |T| ≤ R → (ℓ * upperSaddleThirdMoment ε ℓ (u - 1) / 6) * |T| ^ 3 ≤ q) (hpoly : ∀ T : ℝ, |T| ≤ R → ‖plusPolynomial ε ((T : ℂ) + Complex.I * (u : ℂ)) - plusPolynomial ε (Complex.I * (u : ℂ))‖ ≤ p * ‖plusPolynomial ε (Complex.I * (u : ℂ))‖) : ‖∫ T : ℝ in Icc (-R) R, (saddleSourceCenteredPlusIntegrand ε ℓ u (saddleSourceStationaryLogRadius ε ℓ u) T - saddleSourceGaussianPlusIntegrand ε ℓ u T)‖ ≤ (2 * q + (1 + 2 * q) * p) * ‖plusPolynomial ε (Complex.I * (u : ℂ))‖ * ∫ T : ℝ, saddleSourceGaussianKernel ε ℓ u T"},{"kind":"theorem","name":"saddleSourceCenteredMinusIntegrand_centralGaussianError_le","statement":"{ε ℓ u R q p : ℝ} (hε : 0 < ε) (hℓ : 0 < ℓ) (hu : -1 < u) (horder : shortCutoff ε ≤ shortEndpoint ε) (hmargin : ∀ a ∈ Icc (shortCutoff ε) (shortEndpoint ε), 0 ≤ shortMargin ε a) (hV : 0 < saddleSourceGaussianVariance ε ℓ u) (hR : 0 ≤ R) (hq : 0 ≤ q) (hqone : q ≤ 1) (hp : 0 ≤ p) (hcubic : ∀ T : ℝ, |T| ≤ R → (ℓ * upperSaddleThirdMoment ε ℓ (u - 1) / 6) * |T| ^ 3 ≤ q) (hpoly : ∀ T : ℝ, |T| ≤ R → ‖minusPolynomial ε ((T : ℂ) + Complex.I * (u : ℂ)) - minusPolynomial ε (Complex.I * (u : ℂ))‖ ≤ p * ‖minusPolynomial ε (Complex.I * (u : ℂ))‖) : ‖∫ T : ℝ in Icc (-R) R, (saddleSourceCenteredMinusIntegrand ε ℓ u (saddleSourceStationaryLogRadius ε ℓ u) T - saddleSourceGaussianMinusIntegrand ε ℓ u T)‖ ≤ (2 * q + (1 + 2 * q) * p) * ‖minusPolynomial ε (Complex.I * (u : ℂ))‖ * ∫ T : ℝ, saddleSourceGaussianKernel ε ℓ u T"},{"kind":"theorem","name":"saddleGaussianTailWeight_nonneg","statement":"(T : ℝ) : 0 ≤ saddleGaussianTailWeight T"},{"kind":"theorem","name":"saddle_abs_le_exp_sq","statement":"(T : ℝ) : |T| ≤ Real.exp (T ^ 2)"},{"kind":"theorem","name":"saddleGaussianTailWeight_le_two_exp_three_sq","statement":"(T : ℝ) : saddleGaussianTailWeight T ≤ 2 * Real.exp (3 * T ^ 2)"},{"kind":"theorem","name":"saddleGaussianTailWeight_le_two_exp_three_abs","statement":"(T : ℝ) : saddleGaussianTailWeight T ≤ 2 * Real.exp (3 * |T|)"},{"kind":"theorem","name":"saddle_integral_exp_neg_mul_abs","statement":"{a : ℝ} (ha : 0 < a) : (∫ T : ℝ, Real.exp (-a * |T|)) = 2 / a"},{"kind":"theorem","name":"saddleGaussianTailWeight_mul_gaussian_integrable","statement":"{k : ℝ} (hk : 0 < k) : Integrable (fun T : ℝ => saddleGaussianTailWeight T * Real.exp (-k * T ^ 2))"},{"kind":"theorem","name":"saddleGaussianTailWeight_mul_exp_abs_integrable","statement":"{k : ℝ} (hk : 0 < k) : Integrable (fun T : ℝ => saddleGaussianTailWeight T * Real.exp (-k * |T|))"},{"kind":"theorem","name":"saddleGaussianTailSet_measurable","statement":"(R : ℝ) : MeasurableSet (saddleGaussianTailSet R)"},{"kind":"theorem","name":"saddleGaussian_cubic_tail_integral_le","statement":"{k R : ℝ} (hk : 6 ≤ k) (hR : 0 ≤ R) : (∫ T : ℝ in saddleGaussianTailSet R, saddleGaussianTailWeight T * Real.exp (-k * T ^ 2)) ≤ 2 * Real.exp (-(k / 4) * R ^ 2) * Real.sqrt (Real.pi / (k / 4))"},{"kind":"theorem","name":"saddleExponential_cubic_tail_integral_le","statement":"{k R : ℝ} (hk : 6 ≤ k) (hR : 0 ≤ R) : (∫ T : ℝ in saddleGaussianTailSet R, saddleGaussianTailWeight T * Real.exp (-k * |T|)) ≤ 2 * Real.exp (-(k / 4) * R) * (2 / (k / 4))"},{"kind":"theorem","name":"saddleGaussianOuterPhi_le_endpointBarrier","statement":"{B Q c ℓ δ₀ δ : ℝ} (hB : 0 < B) (hQ : 0 < Q) (hc : 0 < c) (hℓ : 0 ≤ ℓ) (hδ₀ : 0 ≤ δ₀) (hδ : δ₀ ≤ δ) (hscale : (B + 1) / 2 + 4 ≤ c * ℓ * Q * B * Real.exp (B * δ₀)) : saddleGaussianOuterPhi B Q c ℓ δ ≤ ((B + 1) / 2 + 4) * δ₀ + 4 - c * ℓ * Q * Real.exp (B * δ₀)"},{"kind":"theorem","name":"eventually_saddleGaussianOuterPhi_uniform","statement":"{B Q c δ₀ : ℝ} (hB : 0 < B) (hQ : 0 < Q) (hc : 0 < c) (hδ₀ : 0 ≤ δ₀) : ∀ κ : ℝ, 0 < κ → ∀ᶠ ℓ : ℝ in atTop, ∀ δ : ℝ, δ₀ ≤ δ → Real.sqrt ℓ * Real.exp (saddleGaussianOuterPhi B Q c ℓ δ) < κ"},{"kind":"theorem","name":"upperPositiveShellVariance_firstBranch_le","statement":"{ε u : ℝ} (hε : 0 < ε) (hulower : -1 < u) (huupper : u ≤ 1 + ε / 2) : upperPositiveShellVariance ε (u - 1) ≤ upperPositiveShellVariance ε (ε / 2)"},{"kind":"theorem","name":"upperFirstBranch_saddleSourceGaussianVariance_upper_bound","statement":"{ε ℓ u : ℝ} (hε : 0 < ε) (hℓ : 0 < ℓ) (hulower : -1 < u) (huupper : u ≤ 1 + ε / 2) (horder : shortCutoff ε ≤ shortEndpoint ε) (hmargin : ∀ a ∈ Icc (shortCutoff ε) (shortEndpoint ε), 0 ≤ shortMargin ε a) (hscale : 1 ≤ ℓ * (1 + u)) : saddleSourceGaussianVariance ε ℓ u ≤ ((3 / 2 : ℝ) + (2 + ε / 2) * upperPositiveShellVariance ε (ε / 2)) / (1 + u)"},{"kind":"theorem","name":"saddle_exp_neg_mul_min_le_add","statement":"{a x y : ℝ} (ha : 0 ≤ a) : Real.exp (-a * min x y) ≤ Real.exp (-a * x) + Real.exp (-a * y)"},{"kind":"theorem","name":"saddleSourceNormalizedEnvelope_continuous","statement":"{ε ℓ u : ℝ} (hε : 0 < ε) (hℓ : 0 < ℓ) (hu : -1 < u) (horder : shortCutoff ε ≤ shortEndpoint ε) : Continuous (saddleSourceNormalizedEnvelope ε ℓ u)"},{"kind":"theorem","name":"saddleSourceDampingExponential_continuous","statement":"{ε ℓ u : ℝ} (hε : 0 < ε) (hℓ : 0 < ℓ) (hu : -1 < u) (horder : shortCutoff ε ≤ shortEndpoint ε) : Continuous (fun T : ℝ => Real.exp (-saddleSourceContourDamping ε ℓ u 