"statement":"(L : ℝ) : volume (((uniformShellShift d (- (1 / 2 : ℝ))) +ᵥ insetAxisAlignedCell (d"},{"kind":"lemma","name":"boundary_count_mul_ball_volume_le_shell","statement":"{L : ℝ} (hL : 0 < L) (hSsep : S.separation = 1) {g : axisCellLattice (d"},{"kind":"lemma","name":"axis_lattice_covolume_eq_cell_volume","statement":"(L : ℝ) (hL : 0 < L) : ZLattice.covolume (axisCellLattice (d"},{"kind":"lemma","name":"axis_lattice_covolume_toNNReal","statement":"(L : ℝ) (hL : 0 < L) : Real.toNNReal (ZLattice.covolume (axisCellLattice (d"},{"kind":"lemma","name":"replicated_cell_packing_density_formula","statement":"(hd : 0 < d) (S : SpherePacking d) (hSsep : S.separation = 1) {L : ℝ} (hL : 0 < L) {g : axisCellLattice (d"},{"kind":"lemma","name":"axis_shell_volume_ratio_tends_zero","statement":"Tendsto (fun L : ℝ => ((L + 1) ^ d - (L - 2) ^ d) / (L ^ d)) atTop (𝓝 (0 : ℝ))"},{"kind":"lemma","name":"axis_shell_relative_cell_volume_tends_zero","statement":"Tendsto (fun L : ℝ => volume (((uniformShellShift d (- (1 / 2 : ℝ))) +ᵥ insetAxisAlignedCell (d"},{"kind":"lemma","name":"cancel_common_denominator_in_product_ratio","statement":"{a b c : ℝ≥0∞} (hb0 : b ≠ 0) (hb : b ≠ ∞) : ((a * b) / c) / b = a / c"},{"kind":"theorem","name":"exists_periodic_unit_packing_above_density_threshold","statement":"(hd : 0 < d) (S : SpherePacking d) (hSsep : S.separation = 1) {b : ℝ≥0∞} (hb : b < S.upperPackingDensity) : ∃ P : PeriodicSpherePacking d, P.separation = 1 ∧ b < P.upperPackingDensity"},{"kind":"theorem","name":"periodic_packing_supremum_eq_unrestricted","statement":"(hd : 0 < d) : PeriodicSpherePackingConstant d = SpherePackingConstant d"},{"kind":"theorem","name":"continuous_coordinate_torus_projection","statement":"{n : ℕ} : Continuous (coordinateTorusProjection n)"},{"kind":"theorem","name":"coordinate_torus_projection_is_open_quotient","statement":"(n : ℕ) : IsOpenQuotientMap (coordinateTorusProjection n)"},{"kind":"theorem","name":"coordinate_torus_projection_measure_preserving","sta