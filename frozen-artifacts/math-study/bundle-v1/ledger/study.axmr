l.exp (-u)))) (-t / (2 * Real.pi))"},{"kind":"theorem","name":"mellinDenominator_re_pos","statement":"{ℓ : ℝ} (hℓ : 0 < ℓ) (t : ℝ) : 0 < (((ℓ : ℂ) + Complex.I * (t : ℂ)) / 2).re"},{"kind":"theorem","name":"mellinMultiplier_denominator_ne_zero","statement":"{ℓ : ℝ} (hℓ : 0 < ℓ) (t : ℝ) : Complex.Gamma (((ℓ : ℂ) + Complex.I * (t : ℂ)) / 2) ≠ 0"},{"kind":"theorem","name":"gamma_add_nat_eq_product","statement":"(z : ℂ) (hz : ∀ j : ℕ, z + (j : ℂ) ≠ 0) (k : ℕ) : Complex.Gamma (z + (k : ℂ)) = Complex.Gamma z * ∏ j ∈ Finset.range k, (z + (j : ℂ))"},{"kind":"theorem","name":"integer_gamma_product","statement":"(k : ℕ) {y : ℝ} (hy : y ≠ 0) : Complex.Gamma ((k : ℂ) + Complex.I * (y : ℂ) / 2) = Complex.Gamma (Complex.I * (y : ℂ) / 2) * ∏ j ∈ Finset.range k, ((j : ℂ) + Complex.I * (y : ℂ) / 2)"},{"kind":"theorem","name":"half_integer_gamma_product","statement":"(k : ℕ) (y : ℝ) : Complex.Gamma ((k : ℂ) + (1 / 2 : ℂ) + Complex.I * (y : ℂ) / 2) = Complex.Gamma ((1 / 2 : ℂ) + Complex.I * (y : ℂ) / 2) * ∏ j ∈ Finset.range k, ((j : ℂ) + (1 / 2 : ℂ) + Complex.I * (y : ℂ) / 2)"},{"kind":"theorem","name":"IsRadial.even","statement":"{d : ℕ} {f : TestFunction d} (hf : IsRadial f) : IsEven f"},{"kind":"theorem","name":"fourierInv_apply_zero","statement":"{d : ℕ} (f : TestFunction d) : (𝓕⁻ f : TestFunction d) (0 : Euclidean d) = ∫ x : Euclidean d, f x"},{"kind":"theorem","name":"admissible_zero_pos","statement":"{d : ℕ} (f : Admissible d) : 0 < (f.function (0 : Euclidean d)).re"},{"kind":"theorem","name":"quotient_pos","statement":"{d : ℕ} (f : Admissible d) : 0 < quotient f"},{"kind":"theorem","name":"quotientSet_bddBelow","statement":"(d : ℕ) : BddBelow (quotientSet d)"},{"kind":"theorem","name":"normalizedCost_nonneg","statement":"{d : ℕ} (f : Admissible d) : 0 ≤ normalizedCost f"},{"kind":"theorem","name":"normalizedCostSet_bddBelow","statement":"(d : ℕ) : BddBelow (Set.range (normalizedCost (d"},{"kind":"theorem","name":"fourier_sq_apply","statement":"{d : ℕ} (f : TestFunction d) (x : 