inate","statement":"(k : Fin d → ℤ) (i : Fin d) : embeddedIntegerVector (d"},{"kind":"lemma","name":"embedded_integer_vector_mem_reference_lattice","statement":"(k : Fin d → ℤ) : embeddedIntegerVector (d"},{"kind":"lemma","name":"half_open_unit_cell_measurable","statement":"MeasurableSet (halfOpenUnitCell (d"},{"kind":"lemma","name":"half_open_unit_cell_null_measurable","statement":"NullMeasurableSet (halfOpenUnitCell (d"},{"kind":"lemma","name":"unique_integer_shift_into_half_open_cell","statement":"(x : (EuclideanSpace ℝ (Fin d))) : ∃! n : Fin d → ℤ, x + SchwartzMap.PoissonSummation.Standard.embeddedIntegerVector (d"},{"kind":"lemma","name":"reference_lattice_element_eq_integer_vector","statement":"(x : (EuclideanSpace ℝ (Fin d))) (hx : x ∈ SchwartzMap.referenceIntegerLattice d) : ∃ n : Fin d → ℤ, x = SchwartzMap.PoissonSummation.Standard.embeddedIntegerVector (d"},{"kind":"lemma","name":"reference_lattice_dual_self","statement":"LinearMap.BilinForm.dualSubmodule (B"},{"kind":"theorem","name":"continuous_euclidean_torus_projection","statement":"Continuous (euclideanTorusProjection (d"},{"kind":"theorem","name":"euclidean_torus_projection_is_open_quotient","statement":"IsOpenQuotientMap (euclideanTorusProjection (d"},{"kind":"theorem","name":"torus_projection_add_integer_vector","statement":"(x : (EuclideanSpace ℝ (Fin d))) (n : Fin d → ℤ) : euclideanTorusProjection (d"},{"kind":"theorem","name":"equal_torus_projections_differ_by_integer_vector","statement":"{x y : (EuclideanSpace ℝ (Fin d))} (h : euclideanTorusProjection (d"},{"kind":"theorem","name":"half_open_cell_is_fundamental_region","statement":"MeasureTheory.IsAddFundamentalDomain (SchwartzMap.referenceIntegerLattice d) (SchwartzMap.PoissonSummation.Standard.halfOpenUnitCell (d"},{"kind":"theorem","name":"torus_integral_eq_euclidean_cell_integral","statement":"(g : UnitAddTorus (Fin d) → ℂ) (hg : AEStronglyMeasurable g (volume : Measure (UnitAddTorus (Fin d)))) : (∫ y : UnitAddTorus (Fin d), g y) = ∫ x, g (euclideanTorusProjection (d"},{"kind":"lemma","name":"finite_reference_lattice_points_of_norm_bound","statement":"(r : ℝ) : ( {ℓ : (SchwartzMap.referenceIntegerLattice d) | ‖(ℓ : (EuclideanSpace ℝ (Fin d)))‖ ≤ r} : Set _ ).Finite"},{"kind":"lemma","name":"summable_restricted_lattice_translate_norms","statement":"(K : TopologicalSpace.Compacts (EuclideanSpace ℝ (Fin d))) : Summable (fun ℓ : (SchwartzMap.referenceIntegerLattice d) => ‖(latticeTranslatedMap (d"},{"kind":"lemma","name":"lattice_periodized_map_apply","statement":"(x : (EuclideanSpace ℝ (Fin d))) : latticePeriodizedMap (d"},{"kind":"lemma","name":"continuous_torus_projection_is_quotient","statement":"Topology.IsQuotientMap (euclideanTorusProjectionContinuous (d"},{"kind":"lemma","name":"lattice_periodization_factors_through_torus","statement":"Function.FactorsThrough (latticePeriodizedMap (d"},{"kind":"lemma","name":"torus_descended_periodization_comp_projection","statement":"(x : (EuclideanSpace ℝ (Fin d))) : torusDescendedPeriodization (d"},{"kind":"lemma","name":"negative_fourier_character_projection","statement":"(n : Fin d → ℤ) (x : (EuclideanSpace ℝ (Fin d))) : UnitAddTorus.mFourier (-n) (PoissonSummation.Standard.euclideanTorusProjection (d"},{"kind":"lemma","name":"fourier_character_euclidean_projection","statement":"(n : Fin d → ℤ) (x : (EuclideanSpace ℝ (Fin d))) : UnitAddTorus.mFourier n (PoissonSummation.Standard.euclideanTorusProjection (d"},{"kind":"lemma","name":"fourier_character_projection_exponential","statement":"(n : Fin d → ℤ) (x : (EuclideanSpace ℝ (Fin d))) : UnitAddTorus.mFourier n (PoissonSummation.Standard.euclideanTorusProjection (d"},{"kind":"lemma","name":"negative_character_invariant_under_lattice_shift","statement":"(n : Fin d → ℤ) (ℓ : (SchwartzMap.referenceIntegerLattice d)) (x : (EuclideanSpace ℝ (Fin d))) : UnitAddTorus.mFourier (-n) (PoissonSummation.Standard.euclideanTorusProjection (d"},{"kind":"lemma","name":"half_open_unit_cell_subset_closed_ball","statement":"SchwartzMap.PoissonSummation.Standard.halfOpenUnitCell (d"},{"kind":"lemma","name":"half_open_unit_cell_volume_finite","statement":"(volume : Measure (EuclideanSpace ℝ (Fin d))) (SchwartzMap.PoissonSummation.Standard.halfOpenUnitCell (d"},{"kind":"lemma","name":"fourier_character_translate_integrable_on_cell","statement":"(n : Fin d → ℤ) (ℓ : (SchwartzMap.referenceIntegerLattice d)) : IntegrableOn (fun x : (EuclideanSpace ℝ (Fin d)) => UnitAddTorus.mFourier (-n) (PoissonSummation.Standard.euclideanTorusProjection (d"},{"kind":"lemma","name":"fourier_weighted_translate_norm_bound","statement":"(n : Fin d → ℤ) (ℓ : (SchwartzMap.referenceIntegerLattice d)) (x : (EuclideanSpace ℝ (Fin d))) (hx : x ∈ SchwartzMap.PoissonSummation.Standard.halfOpenUnitCell (d"},{"kind":"lemma","name":"summable_cell_integrals_of_weighted_translates","statement":"(n : Fin d → ℤ) : Summable (fun ℓ : (SchwartzMap.referenceIntegerLattice d) => ∫ x in SchwartzMap.PoissonSummation.Standard.halfOpenUnitCell (d"},{"kind":"lemma","name":"fourier_coefficient_torus_periodization","statement":"(n : Fin d → ℤ) : UnitAddTorus.mFourierCoeff (torusDescendedPeriodization (d"},{"kind":"lemma","name":"summable_fourier_coefficients_torus_periodization","statement":"Summable (UnitAddTorus.mFourierCoeff (torusDescendedPeriodization (d"},{"kind":"theorem","name":"reference_lattice_poisson_formula","statement":"(v : (EuclideanSpace ℝ (Fin d))) : (∑' ℓ : (SchwartzMap.referenceIntegerLattice d), f (v + (ℓ : (EuclideanSpace ℝ (Fin d))))) = ∑' n : Fin d → ℤ, (𝓕 (fun x : (EuclideanSpace ℝ (Fin d)) => f x) (SchwartzMap.PoissonSummation.Standard.embeddedIntegerVector (d"},{"kind":"lemma","name":"coordinate_transport_maps_reference_lattice","statement":"(L : Submodule ℤ (EuclideanSpace ℝ (Fin d))) [DiscreteTopology L] [IsZLattice ℝ L] : Submodule.map ((latticeCoordinateEquiv (d"},{"kind":"lemma","name":"reference_basis_fundamental_region_volume","statement":"(volume : Measure (EuclideanSpace ℝ (Fin d))).real (ZSpan.fundamentalDomain ((EuclideanSpace.basisFun (Fin d) ℝ).toBasis)) = 1"},{"kind":"lemma","name":"lattice_covolume_eq_coordinate_determinant","statement":"ZLattice.covolume L = abs ((LinearMap.det : ((EuclideanSpace ℝ (Fin d)) →ₗ[ℝ] (EuclideanSpace ℝ (Fin d))) →* ℝ) ((latticeCoordinateEquiv L).toLinearMap))"},{"kind":"lemma","name":"reference_lattice_coordinate_equiv_apply","statement":"(x : SchwartzMap.referenceIntegerLattice d) : ((referenceLatticeCoordinateEquiv (d"},{"kind":"lemma","name":"dual_transport_comp_coordinate_adjoint","statement":"(dualCoordinateTransport (d"},{"kind":"lemma","name":"coordinate_adjoint_comp_dual_transport","statement":"(latticeCoordinateAdjoint (d"},{"kind":"lemma","name":"dual_coordinate_transport_maps_reference_lattice","statement":"Submodule.map ((dualCoordinateTransport (d"},{"kind":"lemma","name":"reference_lattice_polar_equiv_apply","statement":"(x : SchwartzMap.referenceIntegerLattice d) : ((referenceLatticePolarEquiv (d"},{"kind":"lemma","name":"integer_vector_polar_equiv_coe","statement":"(n : Fin d → ℤ) : ((integerVectorPolarLatticeEquiv (d"},{"kind":"theorem","name":"integer_lattice_poisson_identity","statement":"(f : SchwartzMap (EuclideanSpace ℝ (Fin d)) ℂ) (v : (EuclideanSpace ℝ (Fin d))) : (∑' ℓ : L, f (v + (ℓ : (EuclideanSpace ℝ (Fin d))))) = (1 / ZLattice.covolume L) * ∑' m : polarIntegerLattice (d"},{"kind":"theorem","name":"latticePoissonSummationFormula","statement":"(f : SchwartzMap (EuclideanSpace ℝ (Fin d)) ℂ) (v : EuclideanSpace ℝ (Fin d)) : ∑' ℓ : Λ, f (v + ℓ) = (1 / ZLattice.covolume Λ) * ∑' m : polarIntegerLattice (d"},{"kind":"theorem","name":"schwartz_fourier_inverse_identity","statement":"𝓕⁻ (𝓕 ⇑f) = f"},{"kind":"theorem","name":"Continuous.positive_iff_positive_on_neighborhood","statement":"{f : E → ℝ} (hf₁ : Continuous f) (x : E) : 0 < f x ↔ ∃ U ∈ (nhds x), ∀ y ∈ U, 0 < f y"},{"kind":"theorem","name":"Continuous.nonnegative_integral_vanishes_iff_function_vanishes","statement":"{f : E → ℝ} (hf₁ : Continuous f) (hf₂ : Integrable f) (hnn : ∀ x, 0 ≤ f x) : ∫ (v : E), f v = 0 ↔ f = 0"},{"kind":"theorem","name":"Complex.negative_imaginary_exponential_eq_conjugate","statement":"(x m : EuclideanSpace ℝ (Fin d)) : Complex.exp (-(2 * (Real.pi : ℂ) * Complex.I * (⟪x, m⟫_[ℝ] : ℂ))) = (starRingEnd ℂ) (Complex.exp (2 * (Real.pi : ℂ) * Complex.I * (⟪x, m⟫_[ℝ] : ℂ)))"},{"kind":"lemma","name":"summable_norm_on_translated_integral_lattice","statement":"(f : 𝓢(EuclideanSpace ℝ (Fin d), ℂ)) (a : EuclideanSpace ℝ (Fin d)) : Summable (fun ℓ : Λ => ‖f (a + (ℓ : EuclideanSpace ℝ (Fin d)))‖)"},{"kind":"lemma","name":"origin_character_sum_norm_sq_eq_orbit_count_sq","statement":"{d : ℕ} (P : PeriodicSpherePacking d) {D : Set (EuclideanSpace ℝ (Fin d))} (hd : 0 < d) (hD_isBounded : Bornology.IsBounded D) : norm (∑' x : ↑(P.centers ∩ D), Complex.exp (2 * π * Complex.I * ⟪(x : EuclideanSpace ℝ (Fin d)), (0 : EuclideanSpace ℝ (Fin d))⟫_[ℝ])) ^ 2 = (P.boundedCenterRepresentativeCount hd hD_isBounded : ℝ) ^ 2"},{"kind":"lemma","name":"inverse_product_rearrangement","statement":"{α : Type*} [DivisionCommMonoid α] (c a b : α) : (1 / c) * a * b = b * a / c"},{"kind":"lemma","name":"nonnegative_weighted_nonzero_frequency_sum","statement":"{d : ℕ} (f : 𝓢(EuclideanSpace ℝ (Fin d), ℂ)) (P : PeriodicSpherePacking d) (D : Set (EuclideanSpace ℝ (Fin d))) (hCohnElkies₂ : ∀ x : EuclideanSpace ℝ (Fin d), (𝓕 f x).re ≥ 0) : 0 ≤ ∑' m : ↥(SchwartzMap.polarIntegerLattice (d"},{"kind":"lemma","name":"packing_spectral_sum_exchange","statement":"(f : 𝓢(EuclideanSpace ℝ (Fin d), ℂ)) (hRealFourier : ∀ x : EuclideanSpace ℝ (Fin d), (((𝓕 f) x).re : ℂ) = (𝓕 f) x) (P : PeriodicSpherePacking d) {D : Set (EuclideanSpace ℝ (Fin d))} (hD_isBounded : Bornology.IsBounded D) (hd : 0 < d) : (∑' x : ↑(P.centers ∩ D), ∑' y : ↑(P.centers ∩ D), (1 / ZLattice.covolume P.lattice volume) * ∑' m : SchwartzMap.polarIntegerLattice (d"},{"kind":"theorem","name":"summable_lattice_shift_values","statement":"Summable (fun ℓ : Λ => f (a + (ℓ : EuclideanSpace ℝ (Fin d))))"},{"kind":"theorem","name":"summable_lattice_shift_real_parts","statement":"Summable (fun ℓ : Λ => (f (a + (ℓ : EuclideanSpace ℝ (Fin d)))).re)"},{"kind":"lemma","name":"center_double_sum_eq_region_lattice_sum","statement":"(f : 𝓢(EuclideanSpace ℝ (Fin d), ℂ)) (P : PeriodicSpherePacking d) [Nonempty P.centers] {D : Set (EuclideanSpace ℝ (Fin d))} (hD_isBounded : Bornology.IsBounded D) (hD_unique_covers : ∀ x, ∃! g : P.lattice, g +ᵥ x ∈ D) (hd : 0 < d) : ∑' (x : P.centers) (y : ↑(P.centers ∩ D)), (f (x - (y : EuclideanSpace ℝ (Fin d)))).re = ∑' (x : ↑(P.centers ∩ D)) (y : ↑(P.centers ∩ D)) (ℓ : P.lattice), (f ((x : EuclideanSpace ℝ (Fin d)) - (y : EuclideanSpace ℝ (Fin d)) + (ℓ : EuclideanSpace ℝ (Fin d)))).re"},{"kind":"lemma","name":"real_lattice_sum_bounded_by_origin_term","statement":"(hP : P.separation = 1) (hD_unique_covers : ∀ x, ∃! g : P.lattice, g +ᵥ x ∈ D) (hCohnElkies₁ : ∀ x : EuclideanSpace ℝ (Fin d), ‖x‖ ≥ 1 → (f x).re ≤ 0) (x y : ↑(P.centers ∩ D)) : (∑' ℓ : P.lattice, (f ((x : EuclideanSpace ℝ (Fin d)) - (y : EuclideanSpace ℝ (Fin d)) + (ℓ : EuclideanSpace ℝ (Fin d)))).re) ≤ ite (x = y) (f 0).re 0"},{"kind":"theorem","name":"imaginary_part_vanishes_of_real_valued","statement":"(g : EuclideanSpace ℝ (Fin d) → ℂ) : (∀ x : EuclideanSpace ℝ (Fin d), ↑(g x).re = (g x)) → (∀ x : EuclideanSpace ℝ (Fin d), (g x).im = 0)"},{"kind":"theorem","name":"fourier_imaginary_component_vanishes","statement":"∀ x : EuclideanSpace ℝ (Fin d), (𝓕 f x).im = 0"},{"kind":"theorem","name":"fourier_transform_is_integrable","statement":"MeasureTheory.Integrable (𝓕 ⇑f)"},{"kind":"theorem","name":"fourier_transform_nonzero","statement":"𝓕 f ≠ 0"},{"kind":"theorem","name":"test_function_nonnegative_at_origin","statement":"0 ≤ (f 0).re"},{"kind":"theorem","name":"test_function_positive_at_origin","statement":"0 < (f 0).re"},{"kind":"theorem","name":"packing_bound_auxiliary_estimate","statement":"(hd : 0 < d) (hD_unique_covers : ∀ x, ∃! g : P.lattice, g +ᵥ x ∈ D) : ∑' x : P.centers, ∑' y : ↑(P.centers ∩ D), (f (x - (y : EuclideanSpace ℝ (Fin d)))).re ≤ ↑(P.boundedCenterRepresentativeCount hd hD_isBounded) * (f 0).re"},{"kind":"lemma","name":"packing_bound_complete_estimate_refined","statement":"(hd : 0 < d) : ∑' (x : ↑(P.centers ∩ D)) (y : ↑(P.centers ∩ D)) (ℓ : ↥P.lattice), (f (↑x - ↑y + ↑ℓ)).re = (∑' (x : ↑(P.centers ∩ D)) (y : ↑(P.centers ∩ D)) (ℓ : ↥P.lattice), f (↑x - ↑y + ↑ℓ)).re"},{"kind":"theorem","name":"packing_bound_geometric_estimate","statement":"(hd : 0 < d) : ↑(P.boundedCenterRepresentativeCount hd hD_isBounded) * (f 0).re ≥ (1 / ZLattice.covolume P.lattice volume) * ∑' m : SchwartzMap.polarIntegerLattice (d"},{"kind":"theorem","name":"packing_bound_spectral_estimate","statement":"(hd : 0 < d) : (1 / ZLattice.covolume P.lattice volume) * ∑' m : SchwartzMap.polarIntegerLattice (d"},{"kind":"theorem","name":"packing_bound_complete_estimate","statement":"(hd : 0 < d) : ↑(P.boundedCenterRepresentativeCount hd hD_isBounded) * (f 0).re ≥ ↑(P.boundedCenterRepresentativeCount hd hD_isBounded) ^ 2 * (𝓕 f 0).re / ZLattice.covolume P.lattice volume"},{"kind":"theorem","name":"LinearProgrammingBound'","statement":"(hd : 0 < d) : P.upperPackingDensity ≤ (f 0).re.toNNReal / (𝓕 f 0).re.toNNReal * volume (Metric.ball (0 : EuclideanSpace ℝ (Fin d)) (1 / 2))"},{"kind":"theorem","name":"LinearProgrammingBound","statement":"(hd : 0 < d) : SpherePackingConstant d ≤ (f 0).re.toNNReal / (𝓕 ⇑f 0).re.toNNReal * volume (Metric.ball (0 : EuclideanSpace ℝ (Fin d)) (1 / 2))"},{"kind":"theorem","name":"exact_limit","statement":"Tendsto (fun d : ℕ => CohnElkies.linearProgram d ^ ((d : ℝ)⁻¹)) atTop (nhds (Real.sqrt (Real.exp 1 / (2 * Real.pi))))"},{"kind":"theorem","name":"exact_binary_exponent","statement":"Tendsto (fun d : ℕ => Real.logb 2 (CohnElkies.linearProgram d) / (d : ℝ)) atTop (nhds (-(1 / 2 : ℝ) * Real.logb 2 (2 * Real.pi / Real.exp 1)))"},{"kind":"theorem","name":"volume_half_ball","statement":"{d : ℕ} (hd : 0 < d) : volume (ball (0 : CohnElkies.Euclidean d) (1 / 2 : ℝ)) = ENNReal.ofReal (CohnElkies.unitBallVolume d / (2 : ℝ) ^ d)"},{"kind":"theorem","name":"sphere_packing_le_admissible","statement":"{d : ℕ} (hd : 0 < d) (f : CohnElkies.Admissible d) : SpherePackingConstant d ≤ ENNReal.ofReal (CohnElkies.unitBallVolume d / (2 : ℝ) ^ d * CohnElkies.quotient f)"},{"kind":"theorem","name":"sphere_packing_le_radial_linear_program","statement":"{d : ℕ} (hd : 0 < d) : (SpherePackingConstant d).toReal ≤ CohnElkies.linearProgram d"},{"kind":"theorem","name":"sphere_packing_le_radial_linear_program_ennreal","statement":"{d : ℕ} (hd : 0 < d) : SpherePackingConstant d ≤ ENNReal.ofReal (CohnElkies.linearProgram d)"},{"kind":"theorem","name":"sphere_packing_sharp_asymptotic_upper","statement":"∃ e : ℕ → ℝ, Asymptotics.IsLittleO atTop e (fun _ : ℕ => (1 : ℝ)) ∧ ∀ d : ℕ, 0 < d → SpherePackingConstant d ≤ ENNReal.ofReal ((Real.sqrt (Real.exp 1 / (2 * Real.pi)) + e d) ^ d)"},{"kind":"theorem","name":"fullQuotient_radialToFull","statement":"{d : ℕ} (f : CohnElkies.Admissible d) : fullQuotient (radialToFull f) = CohnElkies.quotient f"},{"kind":"theorem","name":"fullQuotientSet_eq_radial_iff","statement":"(d : ℕ) : fullQuotientSet d = CohnElkies.quotientSet d ↔ ∀ f : FullAdmissible d, ∃ g : CohnElkies.Admissible d, CohnElkies.quotient g = fullQuotient f"},{"kind":"theorem","name":"orthogonal_entry_abs_le_one","statement":"{d : ℕ} {A : Matrix (Fin d) (Fin d) ℝ} (hA : A ∈ Matrix.orthogonalGroup (Fin d) ℝ) (i j : Fin d) : |A i j| ≤ (1 : ℝ)"},{"kind":"theorem","name":"orthogonal_isCompact","statement":"(d : ℕ) : IsCompact (Matrix.orthogonalGroup (Fin d) ℝ : Set (Matrix (Fin d) (Fin d) ℝ))"},{"kind":"theorem","name":"orthogonalAction_continuous","statement":"{d : ℕ} (x : Ambient d) : Continuous (fun U : OrthogonalGroup d => orthogonalAction U x)"},{"kind":"theorem","name":"continuous_orthogonalAction_apply","statement":"{d : ℕ} (x : Ambient d) : Continuous (fun U : OrthogonalGroup d => orthogonalAction U x)"},{"kind":"theorem","name":"orthogonalAction_joint_continuous","statement":"(d : ℕ) : Continuous (fun p : OrthogonalGroup d × Ambient d => orthogonalAction p.1 p.2)"},{"kind":"theorem","name":"orthogonal_transitive","statement":"{d : ℕ} {x y : Ambient d} (hxy : ‖x‖ = ‖y‖) : ∃ U : OrthogonalGroup d, orthogonalAction U x = y"},{"kind":"theorem","name":"radialIsometrySchwartzOrbit_apply","statement":"{d : ℕ} (U : Ambient d ≃ₗᵢ[ℝ] Ambient d) (f : Schwartz d) (x : Ambient d) : radialIsometrySchwartzOrbit U f x = f (U x)"},{"kind":"theorem","name":"radialIsometrySchwartzOrbit_symm_apply","statement":"{d : ℕ} (U : Ambient d ≃ₗᵢ[ℝ] Ambient d) (f : Schwartz d) : radialIsometrySchwartzOrbit U.symm (radialIsometrySchwartzOrbit U f) = f"},{"kind":"theorem","name":"radialIsometrySchwartzOrbit_iteratedFDeriv_norm","statement":"{d : ℕ} (U : Ambient d ≃ₗᵢ[ℝ] Ambient d) (f : Schwartz d) (n : ℕ) (x : Ambient d) : ‖iteratedFDeriv ℝ n (radialIsometrySchwartzOrbit U f : Ambient d → ℂ) x‖ = ‖iteratedFDeriv ℝ n (f : Ambient d → ℂ) (U x)‖"},{"kind":"theorem","name":"radialIsometrySchwartzOrbit_iteratedFDeriv","statement":"{d : ℕ} (U : Ambient d ≃ₗᵢ[ℝ] Ambient d) (f : Schwartz d) (n : ℕ) (x : Ambient d) : iteratedFDeriv ℝ n (radialIsometrySchwartzOrbit U f : Ambient d → ℂ) x = (iteratedFDeriv ℝ n (f : Ambient d → ℂ) (U x)).compContinuousLinearMap (fun _ ↦ U.toContinuousLinearMap)"},{"kind":"theorem","name":"radialIsometrySchwartzOrbit_weighted_iteratedFDeriv_le","statement":"{d : ℕ} (U : Ambient d ≃ₗᵢ[ℝ] Ambient d) (f : Schwartz d) (k n : ℕ) (x : Ambient d) : ‖x‖ ^ k * ‖iteratedFDeriv ℝ n (radialIsometrySchwartzOrbit U f : Ambient d → ℂ) x‖ ≤ SchwartzMap.seminorm ℂ k n f"},{"kind":"theorem","name":"radialIsometrySchwartzOrbit_seminorm_le","statement":"{d : ℕ} (U : Ambient d ≃ₗᵢ[ℝ] Ambient d) (f : Schwartz d) (k n : ℕ) : SchwartzMap.seminorm ℂ k n (radialIsometrySchwartzOrbit U f) ≤ SchwartzMap.seminorm ℂ k n f"},{"kind":"theorem","name":"radialIsometrySchwartzOrbit_seminorm_eq","statement":"{d : ℕ} (U : Ambient d ≃ₗᵢ[ℝ] Ambient d) (f : Schwartz d) (k n : ℕ) : SchwartzMap.seminorm ℂ k n (radialIsometrySchwartzOrbit U f) = SchwartzMap.seminorm ℂ k n f"},{"kind":"theorem","name":"orthogonalLinearIsometry_continuousLinearMap_continuous","statement":"(d : ℕ) : Continuous (fun U : OrthogonalGroup d => (orthogonalLinearIsometry U).toContinuousLinearMap)"},{"kind":"theorem","name":"orthogonalSchwartzIteratedFDeriv_continuous","statement":"{d : ℕ} (f : Schwartz d) (n : ℕ) (x : Ambient d) : Continuous (fun U : OrthogonalGroup d => iteratedFDeriv ℝ n (radialIsometrySchwartzOrbit (orthogonalLinearIsometry U) f : Ambient d → ℂ) x)"},{"kind":"theorem","name":"orthogonalSchwartzInverseIteratedFDeriv_continuous","statement":"{d : ℕ} (f : Schwartz d) (n : ℕ) (x : Ambient d) : Continuous (fun U : OrthogonalGroup d => iteratedFDeriv ℝ n (radialIsometrySchwartzOrbit (orthogonalLinearIsometry U⁻¹) f : Ambient d → ℂ) x)"},{"kind":"theorem","name":"orthogonalSchwartzInverseIteratedFDeriv_aestronglyMeasurable","statement":"{d : ℕ} (f : Schwartz d) (n : ℕ) (x : Ambient d) : AEStronglyMeasurable (fun U : OrthogonalGroup d => iteratedFDeriv ℝ n (radialIsometrySchwartzOrbit (orthogonalLinearIsometry U⁻¹) f : Ambient d → ℂ) x) (radialOrthogonalHaar d)"},{"kind":"theorem","name":"radialSchwartzParametricDerivativeIntegrable","statement":"(hmeas : ∀ (n : ℕ) (x : Ambient d), AEStronglyMeasurable (fun a : α ↦ iteratedFDeriv ℝ n (g a : Ambient d → ℂ) x) μ) (hbound : ∀ (a : α) (k n : ℕ), SchwartzMap.seminorm ℂ k n (g a) ≤ C k n) (n : ℕ) (x : Ambient d) : Integrable (fun a : α ↦ iteratedFDeriv ℝ n (g a : Ambient d → ℂ) x) μ"},{"kind":"theorem","name":"radialSchwartzParametric_hasFDerivAt_iteratedIntegral","statement":"(hmeas : ∀ (n : ℕ) (x : Ambient d), AEStronglyMeasurable (fun a : α ↦ iteratedFDeriv ℝ n (g a : Ambient d → ℂ) x) μ) (hbound : ∀ (a : α) (k n : ℕ), SchwartzMap.seminorm ℂ k n (g a) ≤ C k n) (n : ℕ) (x : Ambient d) : HasFDerivAt (fun y : Ambient d ↦ ∫ a : α, iteratedFDeriv ℝ n (g a : Ambient d → ℂ) y ∂μ) (∫ a : α, fderiv ℝ (iteratedFDeriv ℝ n (g a : Ambient d → ℂ)) x ∂μ) x"},{"kind":"theorem","name":"radialSchwartzParametric_iteratedFDeriv_integral","statement":"(hmeas : ∀ (n : ℕ) (x : Ambient d), AEStronglyMeasurable (fun a : α ↦ iteratedFDeriv ℝ n (g a : Ambient d → ℂ) x) μ) (hbound : ∀ (a : α) (k n : ℕ), SchwartzMap.seminorm ℂ k n (g a) ≤ C k n) (n : ℕ) (x : Ambient d) : iteratedFDeriv ℝ n (fun y : Ambient d ↦ ∫ a : α, (g a) y ∂μ) x = ∫ a : α, iteratedFDeriv ℝ n (g a : Ambient d → ℂ) x ∂μ"},{"kind":"theorem","name":"radialSymmetrizationAverage_integrable","statement":"{d : ℕ} (f : Schwartz d) (x : Ambient d) : Integrable (fun U : OrthogonalGroup d ↦ f (orthogonalAction U⁻¹ x)) (radialOrthogonalHaar d)"},{"kind":"theorem","name":"radialSymmetrizationAverage_comp_orthogonal","statement":"{d : ℕ} (f : Schwartz d) (A : OrthogonalGroup d) (x : Ambient d) : radialSymmetrizationAverage f (orthogonalAction A x) = radialSymmetrizationAverage f x"},{"kind":"theorem","name":"radialSymmetrizationAverage_eq_of_norm_eq","statement":"{d : ℕ} (f : Schwartz d) {x y : Ambient d} (hxy : ‖x‖ = ‖y‖) : radialSymmetrizationAverage f x = radialSymmetrizationAverage f y"},{"kind":"theorem","name":"scalarProbabilityAverage_weighted_iteratedFDeriv_le","statement":"{ι : Type*} [MeasurableSpace ι] (μ : Measure ι) [IsProbabilityMeasure μ] {d : ℕ} (F : ι → Schwartz d) (C : ℕ → ℕ → ℝ) (hbound : ∀ (k n : ℕ) (a : ι) (x : Ambient d), ‖x‖ ^ k * ‖iteratedFDeriv ℝ n (fun y : Ambient d ↦ F a y) x‖ ≤ C k n) (hderiv : ∀ (n : ℕ) (x : Ambient d), iteratedFDeriv ℝ n (fun y : Ambient d ↦ ∫ a, F a y ∂μ) x = ∫ a, iteratedFDeriv ℝ n (fun y : Ambient d ↦ F a y) x ∂μ) (k n : ℕ) (x : Ambient d) : ‖x‖ ^ k * ‖iteratedFDeriv ℝ n (fun y : Ambient d ↦ ∫ a, F a y ∂μ) x‖ ≤ C k n"},{"kind":"theorem","name":"radialSymmetrization_apply","statement":"{d : ℕ} (f : Schwartz d) (x : Ambient d) : radialSymmetrization f x = radialSymmetrizationAverage f x"},{"kind":"theorem","name":"orthogonalScalarAverage_im_eq_zero","statement":"{d : ℕ} {G : Type*} [MeasurableSpace G] {μ : Measure G} (A : G → (Ambient d ≃ₗᵢ[ℝ] Ambient d)) {f : Schwartz d} (hf : IsRealValued f) (x : Ambient d) (hint : Integrable (fun U : G ↦ f (A U x)) μ) : (orthogonalScalarAverage μ A f x).im = 0"},{"kind":"theorem","name":"orthogonalScalarAverage_re","statement":"{d : ℕ} {G : Type*} [MeasurableSpace G] {μ : Measure G} (A : G → (Ambient d ≃ₗᵢ[ℝ] Ambient d)) (f : Schwartz d) (x : Ambient d) (hint : Integrable (fun U : G ↦ f (A U x)) μ) : (orthogonalScalarAverage μ A f x).re = ∫ U : G, (f (A U x)).re ∂μ"},{"kind":"theorem","name":"orthogonalScalarAverage_nonneg_of_nonneg","statement":"{d : ℕ} {G : Type*} [MeasurableSpace G] {μ : Measure G} (A : G → (Ambient d ≃ₗᵢ[ℝ] Ambient d)) {f : Schwartz d} (hf : ∀ y : Ambient d, 0 ≤ (f y).re) (x : Ambient d) (hint : Integrable (fun U : G ↦ f (A U x)) μ) : 0 ≤ (orthogonalScalarAverage μ A f x).re"},{"kind":"theorem","name":"orthogonalScalarAverage_nonpos_of_norm_ge","statement":"{d : ℕ} {G : Type*} [MeasurableSpace G] {μ : Measure G} (A : G → (Ambient d ≃ₗᵢ[ℝ] Ambient d)) {f : Schwartz d} {R : ℝ} (hf : ∀ y : Ambient d, R ≤ ‖y‖ → (f y).re ≤ 0) {x : Ambient d} (hx : R ≤ ‖x‖) (hint : Integrable (fun U : G ↦ f (A U x)) μ) : (orthogonalScalarAverage μ A f x).re ≤ 0"},{"kind":"theorem","name":"radialSymmetrizationAverage_eq_orthogonalScalarAverage","statement":"{d : ℕ} (f : Schwartz d) (x : Ambient d) : radialSymmetrizationAverage f x = orthogonalScalarAverage (radialOrthogonalHaar d) (fun U : OrthogonalGroup d ↦ orthogonalLinearIsometry U⁻¹) f x"},{"kind":"theorem","name":"radialSymmetrizationAverage_im_eq_zero","statement":"{d : ℕ} {f : Schwartz d} (hf : IsRealValued f) (x : Ambient d) : (radialSymmetrizationAverage f x).im = 0"},{"kind":"theorem","name":"radialSymmetrizationAverage_nonneg_of_nonneg","statement":"{d : ℕ} {f : Schwartz d} (hf : ∀ y : Ambient d, 0 ≤ (f y).re) (x : Ambient d) : 0 ≤ (radialSymmetrizationAverage f x).re"},{"kind":"theorem","name":"radialSymmetrizationAverage_nonpos_of_norm_ge","statement":"{d : ℕ} {f : Schwartz d} {R : ℝ} (hf : ∀ y : Ambient d, R ≤ ‖y‖ → (f y).re ≤ 0) {x : Ambient d} (hx : R ≤ ‖x‖) : (radialSymmetrizationAverage f x).re ≤ 0"},{"kind":"theorem","name":"radialSymmetrizationAverage_nonpos_of_one_le_norm","statement":"{d : ℕ} {f : Schwartz d} (hf : ∀ y : Ambient d, 1 ≤ ‖y‖ → (f y).re ≤ 0) {x : Ambient d} (hx : 1 ≤ ‖x‖) : (radialSymmetrizationAverage f x).re ≤ 0"},{"kind":"theorem","name":"IsRadial.neg_apply","statement":"{d : ℕ} {f : Schwartz d} (hf : IsRadial f) (x : Ambient d) : f (-x) = f x"},{"kind":"theorem","name":"IsRealValued.fourier_conj","statement":"{d : ℕ} {f : Schwartz d} (hf : IsRealValued f) (x : Ambient d) : (starRingEnd ℂ) ((𝓕 f : Schwartz d) x) = (𝓕 f : Schwartz d) (-x)"},{"kind":"theorem","name":"IsRadial.fourier_realValued","statement":"{d : ℕ} {f : Schwartz d} (hradial : IsRadial f) (hreal : IsRealValued f) : IsRealValued (𝓕 f : Schwartz d)"},{"kind":"theorem","name":"radialFourierCharacter_continuous","statement":"{d : ℕ} (ξ : Ambient d) : Continuous (radialFourierCharacter ξ)"},{"kind":"theorem","name":"radialFourierCharacter_norm","statement":"{d : ℕ} (ξ x : Ambient d) : ‖radialFourierCharacter ξ x‖ = 1"},{"kind":"theorem","name":"radialFourier_orthogonalOrbit_integrable","statement":"{d : ℕ} (f : Schwartz d) (A : Ambient d ≃ₗᵢ[ℝ] Ambient d) : Integrable (fun x : Ambient d ↦ f (A x))"},{"kind":"theorem","name":"radialFourier_orthogonalCharacterOrbit_integrable","statement":"{d : ℕ} (f : Schwartz d) (ξ : Ambient d) (A : Ambient d ≃ₗᵢ[ℝ] Ambient d) : Integrable (fun x : Ambient d ↦ radialFourierCharacter ξ x * f (A x))"},{"kind":"theorem","name":"radialFourier_orthogonalCharacterOrbit_integral_norm","statement":"{d : ℕ} (f : Schwartz d) (ξ : Ambient d) (A : Ambient d ≃ₗᵢ[ℝ] Ambient d) : (∫ x : Ambient d, ‖radialFourierCharacter ξ x * f (A x)‖) = ∫ x : Ambient d, ‖f x‖"},{"kind":"theorem","name":"radialFourier_orthogonalCharacterOrbit_integral","statement":"{d : ℕ} (f : Schwartz d) (ξ : Ambient d) (A : Ambient d ≃ₗᵢ[ℝ] Ambient d) : (∫ x : Ambient d, radialFourierCharacter ξ x * f (A x)) = (𝓕 f : Schwartz d) (A ξ)"},{"kind":"theorem","name":"radialFourierOrbitKernel_integrable","statement":"{d : ℕ} {G : Type*} [MeasurableSpace G] (μ : Measure G) [IsFiniteMeasure μ] (A : G → (Ambient d ≃ₗᵢ[ℝ] Ambient d)) (f : Schwartz d) (ξ : Ambient d) (horbit : Measurable (fun p : G × Ambient d ↦ f (A p.1 p.2))) : Integrable (radialFourierOrbitKernel A f ξ) (μ.prod volume)"},{"kind":"theorem","name":"radialFourierOrbitAverage_fourier","statement":"{d : ℕ} {G : Type*} [MeasurableSpace G] (μ : Measure G) [IsFiniteMeasure μ] (A : G → (Ambient d ≃ₗᵢ[ℝ] Ambient d)) (f : Schwartz d) (ξ : Ambient d) (horbit : Measurable (fun p : G × Ambient d ↦ f (A p.1 p.2))) : (𝓕 (radialFourierOrbitAverage μ A f) : Ambient d → ℂ) ξ = ∫ g : G, (𝓕 f : Schwartz d) (A g ξ) ∂μ"},{"kind":"theorem","name":"radialOrthogonalHaarOrbit_measurable","statement":"{d : ℕ} (f : Schwartz d) : Measurable (fun p : OrthogonalGroup d × Ambient d ↦ f (orthogonalLinearIsometry (p.1⁻¹) p.2))"},{"kind":"theorem","name":"radialOrthogonalHaar_radialFourierOrbitAverage_eq","statement":"{d : ℕ} (f : Schwartz d) : radialFourierOrbitAverage (radialOrthogonalHaar d) (fun U : OrthogonalGroup d ↦ orthogonalLinearIsometry (U⁻¹)) f = fun x : Ambient d ↦ ∫ U : OrthogonalGroup d, f (orthogonalAction (U⁻¹) x) ∂radialOrthogonalHaar d"},{"kind":"theorem","name":"radialOrthogonalHaar_fourier_average","statement":"{d : ℕ} (f : Schwartz d) (ξ : Ambient d) : (𝓕 (fun x : Ambient d ↦ ∫ U : OrthogonalGroup d, f (orthogonalAction (U⁻¹) x) ∂radialOrthogonalHaar d) : Ambient d → ℂ) ξ = ∫ U : OrthogonalGroup d, (𝓕 f : Schwartz d) (orthogonalAction (U⁻¹) ξ) ∂radialOrthogonalHaar d"},{"kind":"theorem","name":"fourier_radialSymmetrizationAverage","statement":"{d : ℕ} (f : Schwartz d) (ξ : Ambient d) : (𝓕 (radialSymmetrizationAverage f) : Ambient d → ℂ) ξ = radialSymmetrizationAverage (𝓕 f : Schwartz d) ξ"},{"kind":"theorem","name":"manuscript_pi_gt_d40","statement":"(3.1415926535897932384626433832795028841971 : ℝ) < Real.pi"},{"kind":"theorem","name":"manuscript_pi_lt_d40","statement":"Real.pi < (3.1415926535897932384626433832795028841972 : ℝ)"},{"kind":"theorem","name":"criticalBinaryExponent_eq_log_div","statement":"criticalBinaryExponent = Real.log (2 * Real.pi / Real.exp 1) / (2 * Real.log 2)"},{"kind":"theorem","name":"criticalBinaryExponent_eq_three_halves_sub_logFourDivPi","statement":"criticalBinaryExponent = (3 / 2 : ℝ) - (Real.log (4 / Real.pi) + 1) / (2 * Real.log 2)"},{"kind":"theorem","name":"baseTwo_log_two_gt_d6","statement":"(0.693147 : ℝ) < Real.log 2"},{"kind":"theorem","name":"baseTwo_log_four_div_pi_lt_d7","statement":"Real.log (4 / Real.pi) < (0.2415647 : ℝ)"},{"kind":"theorem","name":"criticalBinaryExponent_gt_d4","statement":"(0.6044 : ℝ) < criticalBinaryExponent"},{"kind":"theorem","name":"baseTwo_log_two_gt_d36","statement":"(0.693147180559945309417232121458176568 : ℝ) < Real.log 2"},{"kind":"theorem","name":"baseTwo_log_two_lt_d36","statement":"Real.log 2 < (0.693147180559945309417232121458176569 : ℝ)"},{"kind":"theorem","name":"baseTwo_log_four_div_pi_gt_d36","statement":"(0.241564475270490444691036891563294424 : ℝ) < Real.log (4 / Real.pi)"},{"kind":"theorem","name":"baseTwo_log_four_div_pi_lt_d36","statement":"Real.log (4 / Real.pi) < (0.241564475270490444691036891563294425 : ℝ)"},{"kind":"theorem","name":"criticalBinaryExponent_gt_d33","statement":"(0.604400544291677695341677307053057 : ℝ) < criticalBinaryExponent"},{"kind":"theorem","name":"criticalBinaryExponent_lt_d33","statement":"criticalBinaryExponent < (0.604400544291677695341677307053058 : ℝ)"},{"kind":"theorem","name":"criticalBinaryExponent_gt_d30","statement":"(0.604400544291677695341677307053 : ℝ) < criticalBinaryExponent"},{"kind":"theorem","name":"criticalBinaryExponent_lt_d30","statement":"criticalBinaryExponent < (0.604400544291677695341677307054 : ℝ)"},{"kind":"theorem","name":"criticalBinaryExponent_mem_Ioo_d30","statement":"criticalBinaryExponent ∈ Set.Ioo (0.604400544291677695341677307053 : ℝ) 0.604400544291677695341677307054"},{"kind":"theorem","name":"manuscriptQuotientRootSet_eq_literal","statement":"(d : ℕ) : manuscriptQuotientRootSet d = {q : ℝ | ∃ f : Admissible d, quotient f ^ ((d : ℝ)⁻¹) = q}"},{"kind":"theorem","name":"sharpCohnElkiesManuscriptConclusions","statement":"SharpCohnElkiesManuscriptConclusions"},{"kind":"theorem","name":"quotient_eq_of_origin_and_fourier_origin","statement":"{d : ℕ} {f g : Schwartz d} (horigin : g 0 = f 0) (hfourier : fourierReal g 0 = fourierReal f 0) : quotient g = quotient f"},{"kind":"theorem","name":"IsUnrestrictedAdmissible.radialAdmissible_of_average_data","statement":"{d : ℕ} {f g : Schwartz d} (hf : IsUnrestrictedAdmissible f) (hreal : IsRealValued g) (hradial : IsRadial g) (hfourier_zero : fourierReal g 0 = fourierReal f 0) (hfourier_nonneg : ∀ x : Ambient d, 0 ≤ fourierReal g x) (hexterior : ∀ x : Ambient d, 1 ≤ ‖x‖ → (g x).re ≤ 0) : IsAdmissible g where real_valued"},{"kind":"theorem","name":"radial_of_radialSymmetrizationAverage","statement":"{d : ℕ} {f g : Schwartz d} (haverage : ∀ x : Ambient d, g x = radialSymmetrizationAverage f x) : IsRadial g"},{"kind":"theorem","name":"radialSymmetrizationAverage_schwartz_zero","statement":"{d : ℕ} {f g : Schwartz d} (haverage : ∀ x : Ambient d, g x = radialSymmetrizationAverage f x) : g 0 = f 0"},{"kind":"theorem","name":"radialSymmetrizationAverage_fourier_zero","statement":"{d : ℕ} {f g : Schwartz d} (hfourier : ∀ x : Ambient d, (𝓕 g : Schwartz d) x = radialSymmetrizationAverage (𝓕 f : Schwartz d) x) : fourierReal g 0 = fourierReal f 0"},{"kind":"theorem","name":"IsUnrestrictedAdmissible.radialAdmissible_of_radialSymmetrizationAverage","statement":"{d : ℕ} {f g : Schwartz d} (hf : IsUnrestrictedAdmissible f) (haverage : ∀ x : Ambient d, g x = radialSymmetrizationAverage f x) (hfourier : ∀ x : Ambient d, (𝓕 g : Schwartz d) x = radialSymmetrizationAverage (𝓕 f : Schwartz d) x) : IsAdmissible g"},{"kind":"theorem","name":"quotient_eq_of_radialSymmetrizationAverage","statement":"{d : ℕ} {f g : Schwartz d} (haverage : ∀ x : Ambient d, g x = radialSymmetrizationAverage f x) (hfourier : ∀ x : Ambient d, (𝓕 g : Schwartz d) x = radialSymmetrizationAverage (𝓕 f : Schwartz d) x) : quotient g = quotient f"},{"kind":"theorem","name":"radialSymmetrization_fourier_average_apply_for_admissibility","statement":"{d : ℕ} (f : Schwartz d) (x : Ambient d) : (𝓕 (radialSymmetrization f) : Schwartz d) x = radialSymmetrizationAverage (𝓕 f : Schwartz d) x"},{"kind":"theorem","name":"IsUnrestrictedAdmissible.radialSymmetrization_admissible","statement":"{d : ℕ} {f : Schwartz d} (hf : IsUnrestrictedAdmissible f) : IsAdmissible (radialSymmetrization f)"},{"kind":"theorem","name":"IsUnrestrictedAdmissible.quotient_radialSymmetrization","statement":"{d : ℕ} {f : Schwartz d} (_hf : IsUnrestrictedAdmissible f) : quotient (radialSymmetrization f) = quotient f"},{"kind":"theorem","name":"fourier_schwartzDilation_apply","statement":"{d : ℕ} (a : ℝ) (ha : 0 < a) (f : Schwartz d) (ξ : Ambient d) : (𝓕 (schwartzDilation a ha.ne' f) : Schwartz d) ξ = (a ^ d)⁻¹ • (𝓕 f : Schwartz d) (a⁻¹ • ξ)"},{"kind":"theorem","name":"fourierReal_schwartzDilation_apply","statement":"{d : ℕ} (a : ℝ) (ha : 0 < a) (f : Schwartz d) (ξ : Ambient d) : fourierReal (schwartzDilation a ha.ne' f) ξ = (a ^ d)⁻¹ * fourierReal f (a⁻¹ • ξ)"},{"kind":"theorem","name":"fourierReal_schwartzDilation_nonneg","statement":"{d : ℕ} {f : Schwartz d} (hf : ∀ ξ, 0 ≤ fourierReal f ξ) (a : ℝ) (ha : 0 < a) (ξ : Ambient d) : 0 ≤ fourierReal (schwartzDilation a ha.ne' f) ξ"},{"kind":"theorem","name":"fourierReal_schwartzDilation_zero_pos","statement":"{d : ℕ} {f : Schwartz d} (hf : 0 < fourierReal f 0) (a : ℝ) (ha : 0 < a) : 0 < fourierReal (schwartzDilation a ha.ne' f) 0"},{"kind":"theorem","name":"quotient_schwartzDilation","statement":"{d : ℕ} (a : ℝ) (ha : 0 < a) (f : Schwartz d) : quotient (schwartzDilation a ha.ne' f) = a ^ d * quotient f"},{"kind":"theorem","name":"FullAdmissible.toAlternative","statement":"{d : ℕ} (f : FullAdmissible d) : SpherePacking.Alternative.IsUnrestrictedAdmissible f.function where real_valued"},{"kind":"theorem","name":"FullAdmissible.quotient_radialization","statement":"{d : ℕ} (f : FullAdmissible d) : CohnElkies.quotient f.radialization = fullQuotient f"},{"kind":"theorem","name":"exists_radial_admissible_of_full","statement":"{d : ℕ} (f : FullAdmissible d) : ∃ g : CohnElkies.Admissible d, CohnElkies.quotient g = fullQuotient f"},{"kind":"theorem","name":"fullQuotientSet_eq_radial","statement":"(d : ℕ) : fullQuotientSet d = CohnElkies.quotientSet d"},{"kind":"theorem","name":"fullLinearProgram_eq_radial","statement":"(d : ℕ) : fullLinearProgram d = CohnElkies.linearProgram d"},{"kind":"theorem","name":"exact_limit","statement":"Tendsto (fun d : ℕ => fullLinearProgram d ^ ((d : ℝ)⁻¹)) atTop (nhds (Real.sqrt (Real.exp 1 / (2 * Real.pi))))"},{"kind":"theorem","name":"exact_binary_exponent","statement":"Tendsto (fun d : ℕ => Real.logb 2 (fullLinearProgram d) / (d : ℝ)) atTop (nhds (-(1 / 2 : ℝ) * Real.logb 2 (2 * Real.pi / Real.exp 1)))"},{"kind":"theorem","name":"fullQuotientRootSet_eq_radial","statement":"(d : ℕ) : {q : ℝ | ∃ f : FullAdmissible d, fullQuotient f ^ ((d : ℝ)⁻¹) = q} = {q : ℝ | ∃ f : CohnElkies.Admissible d, CohnElkies.quotient f ^ ((d : ℝ)⁻¹) = q}"},{"kind":"theorem","name":"SharpFullCohnElkiesManuscriptConclusions.ofRadial","statement":"SharpFullCohnElkiesManuscriptConclusions"},{"kind":"theorem","name":"SharpFullCohnElkiesManuscriptConclusions.components","statement":"Tendsto (fun d : ℕ => sInf {q : ℝ | ∃ f : FullAdmissible d, fullQuotient f ^ ((d : ℝ)⁻¹) = q} / Real.sqrt (d : ℝ)) atTop (𝓝 (1 / Real.pi)) ∧ (∃ err : ℕ → ℝ, Tendsto err atTop (𝓝 0) ∧ ∀ d : ℕ, 0 < d → sInf {q : ℝ | ∃ f : FullAdmissible d, fullQuotient f ^ ((d : ℝ)⁻¹) = q} = (1 / Real.pi + err d) * Real.sqrt (d : ℝ)) ∧ Tendsto (fun d : ℕ => (fullLinearProgram d) ^ ((d : ℝ)⁻¹)) atTop (𝓝 (Real.sqrt (Real.exp 1 / (2 * Real.pi)))) ∧ Tendsto (fun d : ℕ => Real.log (fullLinearProgram d) / (d : ℝ)) atTop (𝓝 ((1 / 2 : ℝ) * Real.log (Real.exp 1 / (2 * Real.pi)))) ∧ (∃ err : ℕ → ℝ, Tendsto err atTop (𝓝 0) ∧ (∀ᶠ d : ℕ in atTop, fullLinearProgram d = (Real.sqrt (Real.exp 1 / (2 * Real.pi)) + err d) ^ d)) ∧ (∃ δ : ℕ → ℝ, Tendsto δ atTop (𝓝 0) ∧ (∀ d : ℕ, 0 ≤ δ d) ∧ (∀ᶠ d : ℕ in atTop, ∀ f : FullAdmissible d, (2 : ℝ) ^ d / CohnElkies.unitBallVolume d * (Real.sqrt (Real.exp 1 / (2 * Real.pi)) - δ d) ^ d ≤ fullQuotient f)) ∧ 0 < (1 / 2 : ℝ) * Real.logb 2 (2 * Real.pi / Real.exp 1) ∧ (1 / 2 : ℝ) * Real.logb 2 (2 * Real.pi / Real.exp 1) ∈ Set.Ioo (0.604400544291677695341677307053 : ℝ) 0.604400544291677695341677307054 ∧ Tendsto (fun d : ℕ => Real.logb 2 (fullLinearProgram d) / (d : ℝ)) atTop (𝓝 (-((1 / 2 : ℝ) * Real.logb 2 (2 * Real.pi / Real.exp 1)))) ∧ (∃ err : ℕ → ℝ, Tendsto err atTop (𝓝 0) ∧ (∀ᶠ d : ℕ in atTop, fullLinearProgram d = (2 : ℝ) ^ (-((1 / 2 : ℝ) * Real.logb 2 (2 * Real.pi / Real.exp 1) + err d) * (d : ℝ))))"},{"kind":"theorem","name":"sharpFullCohnElkiesManuscriptConclusions","statement":"SharpFullCohnElkiesManuscriptConclusions"}],"retrieved":"2026-10-12","sha256":"5e8a4d4ffa0c3b8c488f99ecedc43943dff63513d65bd5bd70d5e33beccc2c0f","sorry_count":0,"url":"https://github.com/openai/ten-proofs/blob/main/SpherePacking.lean"}},"prev_hash":"eb6275cf5de9c3696a1b5a8f1f173fea3c450914eaaeec3d9571bf7722d2f5cf","seq":77,"ts":1791808604,"type":"math.lean_ingested"}
