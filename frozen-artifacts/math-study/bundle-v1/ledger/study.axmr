rt (2 * ε)) * (ℓ * (1 + u)) ^ (-(5 / 12 : ℝ))"},{"kind":"theorem","name":"saddleSourceSecondBranch_central_radius_le","statement":"{ε ℓ u : ℝ} (hℓ : 0 < ℓ) (hfloor : saddleSourceSecondBranchVarianceFloor ε ≤ saddleSourceGaussianVariance ε ℓ u) (hfloorpos : 0 < saddleSourceSecondBranchVarianceFloor ε) : saddleSourceSecondBranchCentralRadius ε ℓ u ≤ (1 / Real.sqrt (saddleSourceSecondBranchVarianceFloor ε)) * ℓ ^ (-(5 / 12 : ℝ))"},{"kind":"theorem","name":"eventually_saddleSourceFirstBranch_cubic_window","statement":"∀ᶠ ε : ℝ in 𝓝[>] (0 : ℝ), ∀ κ : ℝ, 0 < κ → ∀ᶠ ℓ : ℝ in atTop, ∀ u : ℝ, -1 < u → u ≤ 1 + ε / 2 → Real.log ℓ / 4 ≤ ℓ * (1 + u) → ∀ T : ℝ, |T| ≤ saddleSourceFirstBranchCentralRadius ε ℓ u → (ℓ * upperSaddleThirdMoment ε ℓ (u - 1) / 6) * |T| ^ 3 < κ"},{"kind":"theorem","name":"eventually_saddleSourceSecondBranch_cubic_window","statement":"∀ᶠ ε : ℝ in 𝓝[>] (0 : ℝ), ∀ κ : ℝ, 0 < κ → ∀ᶠ ℓ : ℝ in atTop, ∀ δ : ℝ, ε / 2 ≤ δ → ∀ T : ℝ, |T| ≤ saddleSourceSecondBranchCentralRadius ε ℓ (1 + δ) → (ℓ * upperSaddleThirdMoment ε ℓ δ / 6) * |T| ^ 3 < κ"},{"kind":"theorem","name":"eventually_saddleSourceFirstBranch_central_radius_lt","statement":"∀ᶠ ε : ℝ in 𝓝[>] (0 : ℝ), ∀ κ : ℝ, 0 < κ → ∀ᶠ ℓ : ℝ in atTop, ∀ u : ℝ, -1 < u → u ≤ 1 + ε / 2 → Real.log ℓ / 4 ≤ ℓ * (1 + u) → saddleSourceFirstBranchCentralRadius ε ℓ u < κ"},{"kind":"theorem","name":"eventually_saddleSourceSecondBranch_central_radius_lt","statement":"∀ᶠ ε : ℝ in 𝓝[>] (0 : ℝ), ∀ κ : ℝ, 0 < κ → ∀ᶠ ℓ : ℝ in atTop, ∀ δ : ℝ, ε / 2 ≤ δ → saddleSourceSecondBranchCentralRadius ε ℓ (1 + δ) < κ"},{"kind":"theorem","name":"exists_saddleSource_central_error_tolerance","statement":"{κ : ℝ} (hκ : 0 < κ) : ∃ q : ℝ, 0 < q ∧ q ≤ 1 ∧ 2 * q + (1 + 2 * q) * q < κ"},{"kind":"theorem","name":"eventually_saddleSourceFirstBranch_centralGaussianErrors","statement":"∀ᶠ ε : ℝ in 𝓝[>] (0 : ℝ), ∀ κ : ℝ, 0 < κ → ∀ᶠ ℓ : ℝ in atTop, ∀ u : ℝ, -1 < u → u ≤ 1 + ε / 2 → Real.log ℓ / 4 ≤ ℓ * (1 + u) → (‖∫ T : ℝ in Icc (-(saddleSourceFirstBranchCentralRadius ε ℓ u)) (saddleSourceFirstBranchCentralRadius ε ℓ u), (saddleSourceCenteredPlusIntegrand ε ℓ u (saddleSourceStationaryLogRadius ε ℓ u) T - saddleSourceGaussianPlusIntegrand ε ℓ u T)‖ < κ * ‖plusPolynomial ε (Complex.I * (u : ℂ))‖ * (∫ T : ℝ, saddleSourceGaussianKernel ε ℓ u T)) ∧ (1 + ε / 4 ≤ u → ‖∫ T : ℝ in Icc (-(saddleSourceFirstBranchCentralRadius ε ℓ u)) (saddleSourceFirstBranchCentralRadius ε ℓ u), (saddleSourceCenteredMinusIntegrand ε ℓ u (saddleSourceStationaryLogRadius ε ℓ u) T - saddleSourceGaussianMinusIntegrand ε ℓ u T)‖ < κ * ‖minusPolynomial ε (Complex.I * (u : ℂ))‖ * (∫ T : ℝ, saddleSourceGaussianKernel ε ℓ u T))"},{"kind":"theorem","name":"eventually_saddleSourceSecondBranch_centralGaussianErrors","statement":"∀ᶠ ε : ℝ in 𝓝[>] (0 : ℝ), ∀ κ : ℝ, 0 < κ → ∀ᶠ ℓ : ℝ in atTop, ∀ δ : ℝ, ε / 2 ≤ δ → (‖∫ T : ℝ in Icc (-(saddleSourceSecondBranchCentralRadius ε ℓ (1 + δ))) (saddleSourceSecondBranchCentralRadius ε ℓ (1 + δ)), (saddleSourceCenteredPlusIntegrand ε ℓ (1 + δ) (saddleSourceStationaryLogRadius ε ℓ (1 + δ)) T - saddleSourceGaussianPlusIntegrand ε ℓ (1 + δ) T)‖ < κ * ‖plusPolynomial ε (Complex.I * ((1 + δ : ℝ) : ℂ))‖ * (∫ T : ℝ, saddleSourceGaussianKernel ε ℓ (1 + δ) T)) ∧ (‖∫ T : ℝ in Icc (-(saddleSourceSecondBranchCentralRadius ε ℓ (1 + δ))) (saddleSourceSecondBranchCentralRadius ε ℓ (1 + δ)), (saddleSourceCenteredMinusIntegrand ε ℓ (1 + δ) (saddleSourceStationaryLogRadius ε ℓ (1 + δ)) T - saddleSourceGaussianMinusIntegrand ε ℓ (1 + δ) T)‖ < κ * ‖minusPolynomial ε (Complex.I * ((1 + δ : ℝ) : ℂ))‖ * (∫ T : ℝ, saddleSourceGaussianKernel ε ℓ (1 + δ) T))"},{"kind":"theorem","name":"upperPositiveShellDamping_local_variance_lower","statement":"{ε ℓ δ T : ℝ} (hε : 0 < ε) (hℓ : 0 ≤ ℓ) (hT : |T| ≤ 1 / (2 * (shellLocation ε + 1))) : (ℓ / 4) * upperPositiveShellVariance ε δ * T ^ 2 ≤ positiveShellDamping ε ℓ δ T"},{"kind":"theorem","name":"upperGammaVarianceDensity_laplace_linear_lower","statement":"{ℓ η a : ℝ} (hℓ : 0 < ℓ) (ha : 0 < a) : a * Real.exp (-η * a) ≤ a ^ 2 * upperGammaMeasureDensity ℓ η a"},{"kind":"theorem","name":"upperGammaDamping_local_variance_lower","statement":"{ℓ η T : ℝ} (hℓ : 0 < ℓ) (hη : 0 < η) (hT : |T| ≤ η) : (ℓ / (32 * Real.exp 1)) * upperGammaVariance ℓ η * T ^ 2 ≤ upperGammaDamping ℓ η T"},{"kind":"theorem","name":"eventually_saddleSourceContourDamping_secondBranch_local_coercivity","statement":"∀ᶠ ε : ℝ in 𝓝[>] (0 : ℝ), ∀ ℓ : ℝ, 0 < ℓ → ∀ δ : ℝ, ε / 2 ≤ δ → ∀ T : ℝ, |T| ≤ 1 / (2 * (shellLocation ε + 1)) → (ℓ / (100 * Real.exp 1)) * saddleSourceGaussianVariance ε ℓ (1 + δ) * T ^ 2 ≤ saddleSourceContourDamping ε ℓ (1 + δ) T"},{"kind":"theorem","name":"eventually_saddleSourceContourDamping_secondBranch_min_lower_bound","statement":"∀ᶠ ε : ℝ in 𝓝[>] (0 : ℝ), ∀ ℓ : ℝ, 0 < ℓ → ∀ δ : ℝ, ε / 2 ≤ δ → ∀ T : ℝ, (ℓ / (8 * Real.exp 1)) * min (T ^ 2 / (2 + δ)) |T| ≤ saddleSourceContourDamping ε ℓ (1 + δ) T"},{"kind":"theorem","name":"eventually_saddleSource_secondBranch_weighted_integrable","statement":"∀ᶠ ε : ℝ in 𝓝[>] (0 : ℝ), ∀ ℓ : ℝ, 0 < ℓ → ∀ δ : ℝ, ε / 2 ≤ δ → Integrable (fun T : ℝ => saddleGaussianTailWeight T * Real.exp (-saddleSourceContourDamping ε ℓ (1 + δ) T))"},{"kind":"theorem","name":"saddleGaussian_weighted_integral_le_rescaled","statement":"{k : ℝ} (hk : 0 < k) : (∫ T : ℝ, saddleGaussianTailWeight T * Real.exp (-k * T ^ 2)) ≤ 2 * max (1 : ℝ) ((Real.sqrt (k / 6) ^ 3)⁻¹) * Real.sqrt (Real.pi / (k / 2))"},{"kind":"theorem","name":"saddleExponential_weighted_integral_le_rescaled","statement":"{k : ℝ} (hk : 0 < k) : (∫ T : ℝ, saddleGaussianTailWeight T * Real.exp (-k * |T|)) ≤ 2 * max (1 : ℝ) (((k / 6) ^ 3)⁻¹) * (2 / (k / 2))"},{"kind":"theorem","name":"eventually_saddleSource_secondBranch_pointwise_gaussian_plus_outer","statement":"∀ᶠ ε : ℝ in 𝓝[>] (0 : ℝ), ∀ ℓ : ℝ, 0 < ℓ → ∀ δ : ℝ, ε / 2 ≤ δ → ∀ T : ℝ, saddleGaussianTailWeight T * Real.exp (-saddleSourceContourDamping ε ℓ (1 + δ) T) ≤ saddleGaussianTailWeight T * Real.exp (-saddleSourceSecondBranchGaussianRate ε ℓ δ * T ^ 2) + Real.exp (-saddleSourceSecondBranchOuterBarrier ε ℓ δ) * (saddleGaussianTailWeight T * Real.exp (-saddleSourceSecondBranchGammaGaussianRate ℓ δ * T ^ 2) + saddleGaussianTailWeight T * Real.exp (-saddleSourceSecondBranchGammaLinearRate ℓ * |T|))"},{"kind":"theorem","name":"eventually_saddleSource_secondBranch_weighted_tail_explicit","statement":"∀ᶠ ε : ℝ in 𝓝[>] (0 : ℝ), ∀ ℓ : ℝ, 0 < ℓ → ∀ δ : ℝ, ε / 2 ≤ δ → ∀ R : ℝ, 0 ≤ R → 6 ≤ saddleSourceSecondBranchGaussianRate ε ℓ δ → (∫ T : ℝ in saddleGaussianTailSet R, saddleGaussianTailWeight T * Real.exp (-saddleSourceContourDamping ε ℓ (1 + δ) T)) ≤ 2 * Real.exp (-(saddleSourceSecondBranchGaussianRate ε ℓ δ / 4) * R ^ 2) * Real.sqrt (Real.pi / (saddleSourceSecondBranchGaussianRate ε ℓ δ / 4)) + Real.exp (-saddleSourceSecondBranchOuterBarrier ε ℓ δ) * (2 * max (1 : ℝ) ((Real.sqrt (saddleSourceSecondBranchGammaGaussianRate ℓ δ / 6) ^ 3)⁻¹) * Real.sqrt (Real.pi / (saddleSourceSecondBranchGammaGaussianRate ℓ δ / 2)) + 2 * max (1 : ℝ) (((saddleSourceSecondBranchGammaLinearRate ℓ / 6) ^ 3)⁻¹) * (2 / (saddleSourceSecondBranchGammaLinearRate ℓ / 2)))"},{"kind":"theorem","name":"saddleSourceSecondBranch_normalizedGaussian_prefactor","statement":"{ε ℓ δ : ℝ} (hℓ : 0 < ℓ) (hV : 0 < saddleSourceGaussianVariance ε ℓ (1 + δ)) : Real.sqrt (ℓ * saddleSourceGaussianVariance ε ℓ (1 + δ)) * Real.sqrt (Real.pi / (saddleSourceSecondBranchGaussianRate ε ℓ δ / 4)) = Real.sqrt (400 * Real.exp 1 * Real.pi)"},{"kind":"theorem","name":"saddleSourceSecondBranch_normalizedGaussian_exponent","statement":"{ε ℓ δ z : ℝ} (hℓ : 0 < ℓ) (hV : 0 < saddleSourceGaussianVariance ε ℓ (1 + δ)) : (saddleSourceSecondBranchGaussianRate ε ℓ δ / 4) * (z / Real.sqrt (ℓ * saddleSourceGaussianVariance ε ℓ (1 + δ))) ^ 2 = z ^ 2 / (400 * Real.exp 1)"},{"kind":"theorem","name":"eventually_saddleSource_secondBranch_normalized_tail_bound","statement":"∀ᶠ ε : ℝ in 𝓝[>] (0 : ℝ), ∀ ℓ : ℝ, 0 < ℓ → ∀ δ : ℝ, ε / 2 ≤ δ → ∀ z : ℝ, 0 ≤ z → 6 ≤ saddleSourceSecondBranchGaussianRate ε ℓ δ → Real.sqrt (ℓ * saddleSourceGaussianVariance ε ℓ (1 + δ)) * (∫ T : ℝ in saddleGaussianTailSet (z / Real.sqrt (ℓ * saddleSourceGaussianVariance ε ℓ (1 + δ))), saddleGaussianTailWeight T * Real.exp (-saddleSourceContourDamping ε ℓ (1 + δ) T)) ≤ 2 * Real.sqrt (400 * Real.exp 1 * Real.pi) * Real.exp (-(z ^ 2 / (400 * Real.exp 1))) + Real.sqrt (ℓ * saddleSourceGaussianVariance ε ℓ (1 + δ)) * Real.exp (-saddleSourceSecondBranchOuterBarrier ε ℓ δ) * (2 * max (1 : ℝ) ((Real.sqrt (saddleSourceSecondBranchGammaGaussianRate ℓ δ / 6) ^ 3)⁻¹) * Real.sqrt (Real.pi / (saddleSourceSecondBranchGammaGaussianRate ℓ δ / 2)) + 2 * max (1 : ℝ) (((saddleSourceSecondBranchGammaLinearRate ℓ / 6) ^ 3)⁻¹) * (2 / (saddleSourceSecondBranchGammaLinearRate ℓ / 2)))"},{"kind":"theorem","name":"saddle_sqrt_le_one_add","statement":"{x : ℝ} (hx : 0 ≤ x) : Real.sqrt x ≤ 1 + x"},{"kind":"theorem","name":"saddle_inverse_sqrt_cube_le","statement":"{q : ℝ} (hq : 0 < q) : (Real.sqrt (q / 6) ^ 3)⁻¹ ≤ 1 + (6 / q) ^ 3"},{"kind":"theorem","name":"saddleSecondBranch_gammaWeightedCoefficient_le","statement":"{q η C : ℝ} (hq : 0 < q) (hη : 1 ≤ η) (hC : 0 < C) (hrate : 1 / q ≤ C * η) : 2 * max (1 : ℝ) ((Real.sqrt (q / 6) ^ 3)⁻¹) * Real.sqrt (Real.pi / (q / 2)) ≤ (2 * (1 + (6 * C) ^ 3) * (1 + 2 * Real.pi * C)) * η ^ 4"},{"kind":"theorem","name":"saddleSecondBranch_linearWeightedCoefficient_le","statement":"{a η C : ℝ} (ha : 0 < a) (hη : 1 ≤ η) (hC : 0 < C) (hrate : 1 / a ≤ C) : 2 * max (1 : ℝ) (((a / 6) ^ 3)⁻¹) * (2 / (a / 2)) ≤ (8 * C * (1 + (6 * C) ^ 3)) * η ^ 4"},{"kind":"theorem","name":"saddleSourceSecondBranchMomentCoefficient_pos","statement":"0 < saddleSourceSecondBranchMomentCoefficient"},{"kind":"theorem","name":"saddleSourceSecondBranch_outerMoment_le","statement":"{ℓ δ : ℝ} (hℓ : 1 ≤ ℓ) (hδ : 0 ≤ δ) : 2 * max (1 : ℝ) ((Real.sqrt (saddleSourceSecondBranchGammaGaussianRate ℓ δ / 6) ^ 3)⁻¹) * Real.sqrt (Real.pi / (saddleSourceSecondBranchGammaGaussianRate ℓ δ / 2)) + 2 * max (1 : ℝ) (((saddleSourceSecondBranchGammaLinearRate ℓ / 6) ^ 3)⁻¹) * (2 / (saddleSourceSecondBranchGammaLinearRate ℓ / 2)) ≤ saddleSourceSecondBranchMomentCoefficient * (2 + δ) ^ 4"},{"kind":"theorem","name":"saddleSourceSecondBranchVarianceCoefficient_pos","statement":"(ε : ℝ) : 0 < saddleSourceSecondBranchVarianceCoefficient ε"},{"kind":"theorem","name":"eventually_saddleSourceGaussianVariance_secondBranch_upper","statement":"∀ᶠ ε : ℝ in 𝓝[>] (0 : ℝ), ∀ ℓ : ℝ, 1 ≤ ℓ → ∀ δ : ℝ, ε / 2 ≤ δ → saddleSourceGaussianVariance ε ℓ (1 + δ) ≤ saddleSourceSecondBranchVarianceCoefficient ε * Real.exp ((shellLocation ε + 1) * δ)"},{"kind":"theorem","name":"eventually_saddleSource_secondBranch_sqrtVariance_le","statement":"∀ᶠ ε : ℝ in 𝓝[>] (0 : ℝ), ∀ ℓ : ℝ, 1 ≤ ℓ → ∀ δ : ℝ, ε / 2 ≤ δ → Real.sqrt (ℓ * saddleSourceGaussianVariance ε ℓ (1 + δ)) ≤ Real.sqrt (saddleSourceSecondBranchVarianceCoefficient ε) * Real.sqrt ℓ * Real.exp (((shellLocation ε + 1) / 2) * δ)"},{"kind":"theorem","name":"tendsto_saddleSourceSecondBranchLocalTailMajorant","statement":"Tendsto (fun ℓ : ℝ => 2 * Real.sqrt (400 * Real.exp 1 * Real.pi) * Real.exp (-(ℓ ^ (1 / 6 : ℝ) / (400 * Real.exp 1)))) atTop (𝓝 (0 : ℝ))"},{"kind":"theorem","name":"eventually_saddleSource_secondBranch_uniform_tail","statement":"∀ᶠ ε : ℝ in 𝓝[>] (0 : ℝ), ∀ κ : ℝ, 0 < κ → ∀ᶠ ℓ : ℝ in atTop, ∀ δ : ℝ, ε / 2 ≤ δ → Real.sqrt (ℓ * saddleSourceGaussianVariance ε ℓ (1 + δ)) * (∫ T : ℝ in saddleGaussianTailSet (ℓ ^ (1 / 12 : ℝ) / Real.sqrt (ℓ * saddleSourceGaussianVariance ε ℓ (1 + δ))), saddleGaussianTailWeight T * Real.exp (-saddleSourceContourDamping ε ℓ (1 + δ) T)) < κ"},{"kind":"theorem","name":"saddleGaussian_central_compl_subset_tail","statement":"(R : ℝ) : (Icc (-R) R)ᶜ ⊆ saddleGaussianTailSet R"},{"kind":"theorem","name":"saddleGaussian_fullLine_error_le_central_add_tails","statement":"{F G : ℝ → ℂ} (hF : Integrable F) (hG : Integrable G) (R : ℝ) : ‖(∫ T : ℝ, F T) - (∫ T : ℝ, G T)‖ ≤ ‖∫ T : ℝ in Icc (-R) R, (F T - G T)‖ + (∫ T : ℝ in saddleGaussianTailSet R, ‖F T‖) + (∫ T : ℝ in saddleGaussianTailSet R, ‖G T‖)"},{"kind":"theorem","name":"saddleSourceGaussianKernel_scaled_integral","statement":"{ε ℓ u : ℝ} (hℓ : 0 < ℓ) (hV : 0 < saddleSourceGaussianVariance ε ℓ u) : Real.sqrt (ℓ * saddleSourceGaussianVariance ε ℓ u) * (∫ T : ℝ, saddleSourceGaussianKernel ε ℓ u T) = Real.sqrt (2 * Real.pi)"},{"kind":"theorem","name":"saddleSource_scaled_tail_lt_relative_gaussian","statement":"{ε ℓ u C A κ X W : ℝ} (hℓ : 0 < ℓ) (hV : 0 < saddleSourceGaussianVariance ε ℓ u) (hC : 0 < C) (hA : 0 < A) (hbound : X ≤ C * A * W) (hnormalized : Real.sqrt (ℓ * saddleSourceGaussianVariance ε ℓ u) * W < κ) : X < (C * κ / Real.sqrt (2 * Real.pi)) * A * (∫ T : ℝ, saddleSourceGaussianKernel ε ℓ u T)"},{"kind":"theorem","name":"saddleSource_weighted_tail_integral_le","statement":"{F : ℝ → ℂ} {W : ℝ → ℝ} {C A R : ℝ} (hF : Integrable F) (hW : Integrable W) (hpoint : ∀ T ∈ saddleGaussianTailSet R, ‖F T‖ ≤ (C * A) * W T) : (∫ T : ℝ in saddleGaussianTailSet R, ‖F T‖) ≤ C * A * (∫ T : ℝ in saddleGaussianTailSet R, W T)"},{"kind":"theorem","name":"exists_saddleSourceCenteredPlusIntegrand_weighted_tail_integral_bound","statement":"{ε : ℝ} (hε : 0 < ε) (horder : shortCutoff ε ≤ shortEndpoint ε) : ∃ C : ℝ, 0 < C ∧ ∀ ℓ : ℝ, 0 < ℓ → ∀ u : ℝ, -1 < u → ∀ v R : ℝ, Integrable (fun T : ℝ => saddleGaussianTailWeight T * Real.exp (-saddleSourceContourDamping ε ℓ u T)) → (∫ T : ℝ in saddleGaussianTailSet R, ‖saddleSourceCenteredPlusIntegrand ε ℓ u v T‖) ≤ C * ‖plusPolynomial ε (Complex.I * (u : ℂ))‖ * (∫ T : ℝ in saddleGaussianTailSet R, saddleGaussianTailWeight T * Real.exp (-saddleSourceContourDamping ε ℓ u T))"},{"kind":"theorem","name":"exists_saddleSourceCenteredMinusIntegrand_weighted_tail_integral_bound","statement":"{ε : ℝ} (hε : 0 < ε) (horder : shortCutoff ε ≤ shortEndpoint ε) : ∃ C : ℝ, 0 < C ∧ ∀ ℓ : ℝ, 0 < ℓ → ∀ u : ℝ, 1 + ε / 4 ≤ u → ∀ v R : ℝ, Integrable (fun T : ℝ => saddleGaussianTailWeight T * Real.exp (-saddleSourceContourDamping ε ℓ u T)) → (∫ T : ℝ in saddleGaussianTailSet R, ‖saddleSourceCenteredMinusIntegrand ε ℓ u v T‖) ≤ C * ‖minusPolynomial ε (Complex.I * (u : ℂ))‖ * (∫ T : ℝ in saddleGaussianTailSet R, saddleGaussianTailWeight T * Real.exp (-saddleSourceContourDamping ε ℓ u T))"},{"kind":"theorem","name":"saddleSourceGaussianPlusIntegrand_tail_norm_eq","statement":"(ε ℓ u R : ℝ) : (∫ T : ℝ in saddleGaussianTailSet R, ‖saddleSourceGaussianPlusIntegrand ε ℓ u T‖) = ‖plusPolynomial ε (Complex.I * (u : ℂ))‖ * (∫ T : ℝ in saddleGaussianTailSet R, saddleSourceGaussianKernel ε ℓ u T)"},{"kind":"theorem","name":"saddleSourceGaussianMinusIntegrand_tail_norm_eq","statement":"(ε ℓ u R : ℝ) : (∫ T : ℝ in saddleGaussianTailSet R, ‖saddleSourceGaussianMinusIntegrand ε ℓ u T‖) = ‖minusPolynomial ε (Complex.I * (u : ℂ))‖ * (∫ T : ℝ in saddleGaussianTailSet R, saddleSourceGaussianKernel ε ℓ u T)"},{"kind":"theorem","name":"saddleGaussian_fullLine_error_lt_of_central_and_normalized_tails","statement":"{ε ℓ u R A κcentral κsource κgaussian : ℝ} {F G : ℝ → ℂ} (hF : Integrable F) (hG : Integrable G) (hℓ : 0 < ℓ) (hV : 0 < saddleSourceGaussianVariance ε ℓ u) (hcentral : ‖∫ T : ℝ in Icc (-R) R, (F T - G T)‖ < κcentral * A * (∫ T : ℝ, saddleSourceGaussianKernel ε ℓ u T)) (hsource : Real.sqrt (ℓ * saddleSourceGaussianVariance ε ℓ u) * (∫ T : ℝ in saddleGaussianTailSet R, ‖F T‖) < κsource * A) (hgaussian : Real.sqrt (ℓ * saddleSourceGaussianVariance ε ℓ u) * (∫ T : ℝ in saddleGaussianTailSet R, ‖G T‖) < κgaussian * A) : ‖(∫ T : ℝ, F T) - (∫ T : ℝ, G T)‖ < (κcentral + (κsource + κgaussian) / Real.sqrt (2 * Real.pi)) * A * (∫ T : ℝ, saddleSourceGaussianKernel ε ℓ u T)"},{"kind":"theorem","name":"saddleSourceGaussianKernel_normalized_tail_le","statement":"{ε ℓ u z : ℝ} (hℓ : 0 < ℓ) (hV : 0 < saddleSourceGaussianVariance ε ℓ u) (hz : 0 ≤ z) (hlarge : 12 ≤ ℓ * saddleSourceGaussianVariance ε ℓ u) : Real.sqrt (ℓ * saddleSourceGaussianVariance ε ℓ u) * (∫ T : ℝ in saddleGaussianTailSet (z / Real.sqrt (ℓ * saddleSourceGaussianVariance ε ℓ u)), saddleSourceGaussianKernel ε ℓ u T) ≤ 4 * Real.sqrt (2 * Real.pi) * Real.exp (-(z ^ 2) / 8)"},{"kind":"theorem","name":"tendsto_saddleSourceGaussianNormalizedTailMajorant","statement":"Tendsto saddleSourceGaussianNormalizedTailMajorant atTop (𝓝 (0 : ℝ))"},{"kind":"theorem","name":"eventually_saddleSource_firstBranch_uniform_gaussian_tail","statement":"∀ᶠ ε : ℝ in 𝓝[>] (0 : ℝ), ∀ κ : ℝ, 0 < κ → ∀ᶠ ℓ : ℝ in atTop, ∀ u : ℝ, -1 < u → u ≤ 1 + ε / 2 → Real.log ℓ / 4 ≤ ℓ * (1 + u) → Real.sqrt (ℓ * saddleSourceGaussianVariance ε ℓ u) * (∫ T : ℝ in saddleGaussianTailSet (saddleSourceFirstBranchCentralRadius ε ℓ u), saddleSourceGaussianKernel ε ℓ u T) < κ"},{"kind":"theorem","name":"eventually_saddleSource_secondBranch_uniform_gaussian_tail","statement":"∀ᶠ ε : ℝ in 𝓝[>] (0 : ℝ), ∀ κ : ℝ, 0 < κ → ∀ᶠ ℓ : ℝ in atTop, ∀ δ : ℝ, ε / 2 ≤ δ → Real.sqrt (ℓ * saddleSourceGaussianVariance ε ℓ (1 + δ)) * (∫ T : ℝ in saddleGaussianTailSet (saddleSourceSecondBranchCentralRadius ε ℓ (1 + δ)), saddleSourceGaussianKernel ε ℓ (1 + δ) T) < κ"},{"kind":"theorem","name":"eventually_saddleSourceFirstBranch_sourceL1Tails","statement":"∀ᶠ ε : ℝ in 𝓝[>] (0 : ℝ), ∀ κ : ℝ, 0 < κ → ∀ᶠ ℓ : ℝ in atTop, ∀ u : ℝ, -1 < u → u ≤ 1 + ε / 2 → Real.log ℓ / 4 ≤ ℓ * (1 + u) → (Real.sqrt (ℓ * saddleSourceGaussianVariance ε ℓ u) * (∫ T : ℝ in saddleGaussianTailSet (saddleSourceFirstBranchCentralRadius ε ℓ u), ‖saddleSourceCenteredPlusIntegrand ε ℓ u (saddleSourceStationaryLogRadius ε ℓ u) T‖) < κ * ‖plusPolynomial ε (Complex.I * (u : ℂ))‖) ∧ (1 + ε / 4 ≤ u → Real.sqrt (ℓ * saddleSourceGaussianVariance ε ℓ u) * (∫ T : ℝ in saddleGaussianTailSet (saddleSourceFirstBranchCentralRadius ε ℓ u), ‖saddleSourceCenteredMinusIntegrand ε ℓ u (saddleSourceStationaryLogRadius ε ℓ u) T‖) < κ * ‖minusPolynomial ε (Complex.I * (u : ℂ))‖)"},{"kind":"theorem","name":"eventually_saddleSourceFirstBranch_gaussianL1Tails","statement":"∀ᶠ ε : ℝ in 𝓝[>] (0 : ℝ), ∀ κ : ℝ, 0 < κ → ∀ᶠ ℓ : ℝ in atTop, ∀ u : ℝ, -1 < u → u ≤ 1 + ε / 2 → Real.log ℓ / 4 ≤ ℓ * (1 + u) → (Real.sqrt (ℓ * saddleSourceGaussianVariance ε ℓ u) * (∫ T : ℝ in saddleGaussianTailSet (saddleSourceFirstBranchCentralRadius ε ℓ u), ‖saddleSourceGaussianPlusIntegrand ε ℓ u T‖) < κ * ‖plusPolynomial ε (Complex.I * (u : ℂ))‖) ∧ (1 + ε / 4 ≤ u → Real.sqrt (ℓ * saddleSourceGaussianVariance ε ℓ u) * (∫ T : ℝ in saddleGaussianTailSet (saddleSourceFirstBranchCentralRadius ε ℓ u), ‖saddleSourceGaussianMinusIntegrand ε ℓ u T‖) < κ * ‖minusPolynomial ε (Complex.I * (u : ℂ))‖)"},{"kind":"theorem","name":"eventually_saddleSourceFirstBranch_fullGaussianErrors","statement":"∀ᶠ ε : ℝ in 𝓝[>] (0 : ℝ), ∀ᶠ ℓ : ℝ in atTop, ∀ u : ℝ, -1 < u → u ≤ 1 + ε / 2 → Real.log ℓ / 4 ≤ ℓ * (1 + u) → (‖(∫ T : ℝ, saddleSourceCenteredPlusIntegrand ε ℓ u (saddleSourceStationaryLogRadius ε ℓ u) T) - (∫ T : ℝ, saddleSourceGaussianPlusIntegrand ε ℓ u T)‖ < ‖plusPolynomial ε (Complex.I * (u : ℂ))‖ * (∫ T : ℝ, saddleSourceGaussianKernel ε ℓ u T)) ∧ (1 + ε / 4 ≤ u → ‖(∫ T : ℝ, saddleSourceCenteredMinusIntegrand ε ℓ u (saddleSourceStationaryLogRadius ε ℓ u) T) - (∫ T : ℝ, saddleSourceGaussianMinusIntegrand ε ℓ u T)‖ < ‖minusPolynomial ε (Complex.I * (u : ℂ))‖ * (∫ T : ℝ, saddleSourceGaussianKernel ε ℓ u T))"},{"kind":"theorem","name":"eventually_saddleSourceSecondBranch_sourceL1Tails_of_uniform_tail","statement":"(hweighted : ∀ᶠ ε : ℝ in 𝓝[>] (0 : ℝ), ∀ ℓ : ℝ, 0 < ℓ → ∀ δ : ℝ, ε / 2 ≤ δ → Integrable (fun T : ℝ => saddleGaussianTailWeight T * Real.exp (-saddleSourceContourDamping ε ℓ (1 + δ) T))) (htail : ∀ᶠ ε : ℝ in 𝓝[>] (0 : ℝ), ∀ κ : ℝ, 0 < κ → ∀ᶠ ℓ : ℝ in atTop, ∀ δ : ℝ, ε / 2 ≤ δ → Real.sqrt (ℓ * saddleSourceGaussianVariance ε ℓ (1 + δ)) * (∫ T : ℝ in saddleGaussianTailSet (saddleSourceSecondBranchCentralRadius ε ℓ (1 + δ)), saddleGaussianTailWeight T * Real.exp (-saddleSourceContourDamping ε ℓ (1 + δ) T)) < κ) : ∀ᶠ ε : ℝ in 𝓝[>] (0 : ℝ), ∀ κ : ℝ, 0 < κ → ∀ᶠ ℓ : ℝ in atTop, ∀ δ : ℝ, ε / 2 ≤ δ → (Real.sqrt (ℓ * saddleSourceGaussianVariance ε ℓ (1 + δ)) * (∫ T : ℝ in saddleGaussianTailSet (saddleSourceSecondBranchCentralRadius ε ℓ (1 + δ)), ‖saddleSourceCenteredPlusIntegrand ε ℓ (1 + δ) (saddleSourceStationaryLogRadius ε ℓ (1 + δ)) T‖) < κ * ‖plusPolynomial ε (Complex.I * ((1 + δ : ℝ) : ℂ))‖) ∧ (Real.sqrt (ℓ * saddleSourceGaussianVariance ε ℓ (1 + δ)) * (∫ T : ℝ in saddleGaussianTailSet (saddleSourceSecondBranchCentralRadius ε ℓ (1 + δ)), ‖saddleSourceCenteredMinusIntegrand ε ℓ (1 + δ) (saddleSourceStationaryLogRadius ε ℓ (1 + δ)) T‖) < κ * ‖minusPolynomial ε (Complex.I * ((1 + δ : ℝ) : ℂ))‖)"},{"kind":"theorem","name":"eventually_saddleSourceSecondBranch_gaussianL1Tails","statement":"∀ᶠ ε : ℝ in 𝓝[>] (0 : ℝ), ∀ κ : ℝ, 0 < κ → ∀ᶠ ℓ : ℝ in atTop, ∀ δ : ℝ, ε / 2 ≤ δ → (Real.sqrt (ℓ * saddleSourceGaussianVariance ε ℓ (1 + δ)) * (∫ T : ℝ in saddleGaussianTailSet (saddleSourceSecondBranchCentralRadius ε ℓ (1 + δ)), ‖saddleSourceGaussianPlusIntegrand ε ℓ (1 + δ) T‖) < κ * ‖plusPolynomial ε (Complex.I * ((1 + δ : ℝ) : ℂ))‖) ∧ (Real.sqrt (ℓ * saddleSourceGaussianVariance ε ℓ (1 + δ)) * (∫ T : ℝ in saddleGaussianTailSet (saddleSourceSecondBranchCentralRadius ε ℓ (1 + δ)), ‖saddleSourceGaussianMinusIntegrand ε ℓ (1 + δ) T‖) < κ * ‖minusPolynomial ε (Complex.I * ((1 + δ : ℝ) : ℂ))‖)"},{"kind":"theorem","name":"eventually_saddleSourceSecondBranch_fullGaussianErrors_of_sourceL1","statement":"(hsource : ∀ᶠ ε : ℝ in 𝓝[>] (0 : ℝ), ∀ κ : ℝ, 0 < κ → ∀ᶠ ℓ : ℝ in atTop, ∀ δ : ℝ, ε / 2 ≤ δ → (Real.sqrt (ℓ * saddleSourceGaussianVariance ε ℓ (1 + δ)) * (∫ T : ℝ in saddleGaussianTailSet (saddleSourceSecondBranchCentralRadius ε ℓ (1 + δ)), ‖saddleSourceCenteredPlusIntegrand ε ℓ (1 + δ) (saddleSourceStationaryLogRadius ε ℓ (1 + δ)) T‖) < κ * ‖plusPolynomial ε (Complex.I * ((1 + δ : ℝ) : ℂ))‖) ∧ (Real.sqrt (ℓ * saddleSourceGaussianVariance ε ℓ (1 + δ)) * (∫ T : ℝ in saddleGaussianTailSet (saddleSourceSecondBranchCentralRadius ε ℓ (1 + δ)), ‖saddleSourceCenteredMinusIntegrand ε ℓ (1 + δ) (saddleSourceStationaryLogRadius ε ℓ (1 + δ)) T‖) < κ * ‖minusPolynomial ε (Complex.I * ((1 + δ : ℝ) : ℂ))‖)) : ∀ᶠ ε : ℝ in 𝓝[>] (0 : ℝ), ∀ᶠ ℓ : ℝ in atTop, ∀ δ : ℝ, ε / 2 ≤ δ → (‖(∫ T : ℝ, saddleSourceCenteredPlusIntegrand ε ℓ (1 + δ) (saddleSourceStationaryLogRadius ε ℓ (1 + δ)) T) - (∫ T : ℝ, saddleSourceGaussianPlusIntegrand ε ℓ (1 + δ) T)‖ < ‖plusPolynomial ε (Complex.I * ((1 + δ : ℝ) : ℂ))‖ * (∫ T : ℝ, saddleSourceGaussianKernel ε ℓ (1 + δ) T)) ∧ (‖(∫ T : ℝ, saddleSourceCenteredMinusIntegrand ε ℓ (1 + δ) (saddleSourceStationaryLogRadius ε ℓ (1 + δ)) T) - (∫ T : ℝ, saddleSourceGaussianMinusIntegrand ε ℓ (1 + δ) T)‖ < ‖minusPolynomial ε (Complex.I * ((1 + δ : ℝ) : ℂ))‖ * (∫ T : ℝ, saddleSourceGaussianKernel ε ℓ (1 + δ) T))"},{"kind":"theorem","name":"eventually_saddleSourceSecondBranch_sourceL1Tails","statement":"∀ᶠ ε : ℝ in 𝓝[>] (0 : ℝ), ∀ κ : ℝ, 0 < κ → ∀ᶠ ℓ : ℝ in atTop, ∀ δ : ℝ, ε / 2 ≤ δ → (Real.sqrt (ℓ * saddleSourceGaussianVariance ε ℓ (1 + δ)) * (∫ T : ℝ in saddleGaussianTailSet (saddleSourceSecondBranchCentralRadius ε ℓ (1 + δ)), ‖saddleSourceCenteredPlusIntegrand ε ℓ (1 + δ) (saddleSourceStationaryLogRadius ε ℓ (1 + δ)) T‖) < κ * ‖plusPolynomial ε (Complex.I * ((1 + δ : ℝ) : ℂ))‖) ∧ (Real.sqrt (ℓ * saddleSourceGaussianVariance ε ℓ (1 + δ)) * (∫ T : ℝ in saddleGaussianTailSet (saddleSourceSecondBranchCentralRadius ε ℓ (1 + δ)), ‖saddleSourceCenteredMinusIntegrand ε ℓ (1 + δ) (saddleSourceStationaryLogRadius ε ℓ (1 + δ)) T‖) < κ * ‖minusPolynomial ε (Complex.I * ((1 + δ : ℝ) : ℂ))‖)"},{"kind":"theorem","name":"eventually_saddleSourceSecondBranch_fullGaussianErrors","statement":"∀ᶠ ε : ℝ in 𝓝[>] (0 : ℝ), ∀ᶠ ℓ : ℝ in atTop, ∀ δ : ℝ, ε / 2 ≤ δ → (‖(∫ T : ℝ, saddleSourceCenteredPlusIntegrand ε ℓ (1 + δ) (saddleSourceStationaryLogRadius ε ℓ (1 + δ)) T) - (∫ T : ℝ, saddleSourceGaussianPlusIntegrand ε ℓ (1 + δ) T)‖ < ‖plusPolynomial ε (Complex.I * ((1 + δ : ℝ) : ℂ))‖ * (∫ T : ℝ, saddleSourceGaussianKernel ε ℓ (1 + δ) T)) ∧ (‖(∫ T : ℝ, saddleSourceCenteredMinusIntegrand ε ℓ (1 + δ) (saddleSourceStationaryLogRadius ε ℓ (1 + δ)) T) - (∫ T : ℝ, saddleSourceGaussianMinusIntegrand ε ℓ (1 + δ) T)‖ < ‖minusPolynomial ε (Complex.I * ((1 + δ : ℝ) : ℂ))‖ * (∫ T : ℝ, saddleSourceGaussianKernel ε ℓ (1 + δ) T))"},{"kind":"theorem","name":"saddleDigamma_eq_complexDigamma_re","statement":"{x : ℝ} (hx : 0 < x) : saddleDigamma x = (Complex.digamma (x : ℂ)).re"},{"kind":"theorem","name":"complexGamma_differentiableOn_positiveHalfPlane","statement":"DifferentiableOn ℂ Complex.Gamma {z : ℂ | 0 < z.re}"},{"kind":"theorem","name":"complexDigamma_continuousOn_positiveHalfPlane","statement":"ContinuousOn Complex.digamma {z : ℂ | 0 < z.re}"},{"kind":"theorem","name":"saddleDigamma_continuousOn_Ioi","statement":"ContinuousOn saddleDigamma (Ioi (0 : ℝ))"},{"kind":"theorem","name":"tendsto_saddleDigamma_atTop","statement":"Tendsto saddleDigamma atTop atTop"},{"kind":"theorem","name":"saddleSinhShellInterval_hasDerivAt","statement":"(w : ℝ → ℝ) (hw : Continuous w) {a b : ℝ} (hab : a ≤ b) (u : ℝ) : HasDerivAt (fun v : ℝ => ∫ x in a..b, w x * x * Real.sinh (x * v)) (∫ x in a..b, w x * x ^ 2 * Real.cosh (x * u)) u"},{"kind":"theorem","name":"saddleSourceShellDerivative_hasDerivAt","statement":"{ε : ℝ} (hε : 0 < ε) (horder : shortCutoff ε ≤ shortEndpoint ε) (u : ℝ) : HasDerivAt (saddleSourceShellDerivative ε) (upperNetShellVariance ε (u - 1)) u"},{"kind":"theorem","name":"eventually_saddleSourceShellDerivative_monotone_secondBranch","statement":"∀ᶠ ε : ℝ in 𝓝[>] (0 : ℝ), MonotoneOn (saddleSourceShellDerivative ε) (Ici (1 + ε / 2))"},{"kind":"theorem","name":"saddleLogRadius_continuousOn_Ici","statement":"{ε : ℝ} (hε : 0 < ε) (horder : shortCutoff ε ≤ shortEndpoint ε) {d : ℕ} (hd : 0 < d) {u₀ : ℝ} (hu₀ : -1 < u₀) : ContinuousOn (saddleLogRadius ε d) (Ici u₀)"},{"kind":"theorem","name":"tendsto_saddleGammaArgument_atTop","statement":"{d : ℕ} (hd : 0 < d) : Tendsto (fun u : ℝ => ((d : ℝ) / 2) * (1 + u) / 2) atTop atTop"},{"kind":"theorem","name":"tendsto_saddleLogRadius_atTop_of_shell_monotone","statement":"{ε : ℝ} (hε : 0 < ε) (horder : shortCutoff ε ≤ shortEndpoint ε) {d : ℕ} (hd : 0 < d) (hmono : MonotoneOn (saddleSourceShellDerivative ε) (Ici (1 + ε / 2))) : Tendsto (saddleLogRadius ε d) atTop atTop"},{"kind":"theorem","name":"eventually_tendsto_saddleLogRadius_atTop","statement":"∀ᶠ ε : ℝ in 𝓝[>] (0 : ℝ), ∀ d : ℕ, 0 < d → Tendsto (saddleLogRadius ε d) atTop atTop"},{"kind":"theorem","name":"saddleLogRadius_covers_Ici","statement":"{ε : ℝ} (hε : 0 < ε) (horder : shortCutoff ε ≤ shortEndpoint ε) {d : ℕ} (hd : 0 < d) {u₀ : ℝ} (hu₀ : -1 < u₀) (htop : Tendsto (saddleLogRadius ε d) atTop atTop) {r : ℝ} (hr : Real.exp (saddleLogRadius ε d u₀) ≤ r) : ∃ u : ℝ, u₀ ≤ u ∧ saddleLogRadius ε d u = Real.log r"},{"kind":"theorem","name":"eventually_saddleLogRadius_covers_Ici","statement":"∀ᶠ ε : ℝ in 𝓝[>] (0 : ℝ), ∀ d : ℕ, 0 < d → ∀ u₀ : ℝ, -1 < u₀ → ∀ r : ℝ, Real.exp (saddleLogRadius ε d u₀) ≤ r → ∃ u : ℝ, u₀ ≤ u ∧ saddleLogRadius ε d u = Real.log r"},{"kind":"theorem","name":"eventually_saddleSmallRadiusStarOrdinate_gt_neg_one","statement":"(ε : ℝ) : ∀ᶠ d : ℕ in atTop, -1 < saddleSmallRadiusStarOrdinate ε d"},{"kind":"theorem","name":"eventually_saddleSmallRadiusStar_log_coverage","statement":"∀ᶠ ε : ℝ in 𝓝[>] (0 : ℝ), ∀ᶠ d : ℕ in atTop, ∀ r : ℝ, saddleSmallRadiusStar ε d ≤ r → ∃ u : ℝ, saddleSmallRadiusStarOrdinate ε d ≤ u ∧ saddleLogRadius ε d u = Real.log r"},{"kind":"theorem","name":"eventually_saddleSourceRadius_log_coverage","statement":"∀ᶠ ε : ℝ in 𝓝[>] (0 : ℝ), ∀ d : ℕ, 0 < d → ∀ r : ℝ, saddleSourceRadius ε d ≤ r → ∃ u : ℝ, 1 + ε / 4 ≤ u ∧ saddleLogRadius ε d u = Real.log r"},{"kind":"theorem","name":"normalizedProgram_le_normalizedCost","statement":"{d : ℕ} (f : Admissible d) : normalizedProgram d ≤ normalizedCost f"},{"kind":"theorem","name":"eventualUpperBound_of_constructivePrimal","statement":"(hupper : ConstructivePrimalUpperBound) : EventualUpperBound"},{"kind":"theorem","name":"eventualLowerBound_of_uniform_and_constructive","statement":"(hlower : UniformAdmissibleLowerBound) (hupper : ConstructivePrimalUpperBound) : EventualLowerBound"},{"kind":"theorem","name":"sharpQuotient_of_eventual_bounds","statement":"(hlower : EventualLowerBound) (hupper : EventualUpperBound) : SharpQuotientAsymptotic"},{"kind":"theorem","name":"sharpQuotient_of_uniform_lower_and_constructive_upper","statement":"(hlower : UniformAdmissibleLowerBound) (hupper : ConstructivePrimalUpperBound) : SharpQuotientAsymptotic"},{"kind":"theorem","name":"constructivePrimal_of_orderedEpsilon","statement":"(construction : OrderedEpsilonUpperConstruction) : ConstructivePrimalUpperBound"},{"kind":"theorem","name":"sharpQuotient_of_uniform_lower_and_ordered_upper","statement":"(hlower : UniformAdmissibleLowerBound) (construction : OrderedEpsilonUpperConstruction) : SharpQuotientAsymptotic"},{"kind":"theorem","name":"lowerGammaBoundaryLog_pole_decomposition","statement":"(ℓ R : ℝ) {y : ℝ} (hy : y ≠ 0) : lowerGammaBoundaryLog ℓ R y = ℓ * Real.log (Real.pi * R ^ 2) + Real.log ‖Complex.Gamma (1 - Complex.I * (y : ℂ) / 2)‖ - Real.log ‖Complex.Gamma ((ℓ : ℂ) + Complex.I * (y : ℂ) / 2)‖ - Real.log (|y| / 2)"},{"kind":"theorem","name":"lowerGammaBoundaryLog_tendsto_atTop_zero","statement":"{ℓ : ℝ} (hℓ : 0 < ℓ) (R : ℝ) : Tendsto (lowerGammaBoundaryLog ℓ R) (𝓝[≠] (0 : ℝ)) atTop"},{"kind":"theorem","name":"lowerGammaBoundaryCapped_continuous","statement":"{ℓ : ℝ} (hℓ : 0 < ℓ) (R D : ℝ) : Continuous (lowerGammaBoundaryCapped ℓ R D)"},{"kind":"theorem","name":"lowerGammaBoundaryCapped_exp_integrable_of_exp_integrable","statement":"{ℓ a : ℝ} (hℓ : 0 < ℓ) (ha : 0 < a) (R D : ℝ) (hgamma : Integrable (fun y : ℝ => Real.exp ((-a) * |y|) * lowerGammaBoundaryLog ℓ R y)) : Integrable (fun y : ℝ => Real.exp ((-a) * |y|) * lowerGammaBoundaryCapped ℓ R D y)"},{"kind":"theorem","name":"stripRegularizedOuter_integrable_of_exp_integrable","statement":"{ℓ : ℝ} (hℓ : 0 < ℓ) {z : ℂ} (hz : z ∈ Complex.im ⁻¹' Ioo (-ℓ) ℓ) (b : ℝ → ℝ) (hb : Continuous b) (hboundary : Integrable (fun y : ℝ => Real.exp (-(Real.pi / (2 * ℓ)) * |y|) * b y)) : Integrable (fun y : ℝ => stripRegularizedHolomorphicPoissonKernel ℓ z y * (b y : ℂ))"},{"kind":"theorem","name":"stripRegularizedOuter_differentiableAt_of_exp_integrable","statement":"{ℓ : ℝ} (hℓ : 0 < ℓ) {z : ℂ} (hz : z ∈ Complex.im ⁻¹' Ioo (-ℓ) ℓ) (b : ℝ → ℝ) (hb : Continuous b) (hboundary : Integrable (fun y : ℝ => Real.exp (-(Real.pi / (2 * ℓ)) * |y|) * b y)) : DifferentiableAt ℂ (stripRegularizedOuter ℓ b) z"},{"kind":"theorem","name":"lowerGammaBoundaryCapped_exp_integrable_dimension","statement":"{d : ℕ} (hd : 0 < d) {a : ℝ} (ha : 0 < a) (R D : ℝ) : Integrable (fun y : ℝ => Real.exp ((-a) * |y|) * lowerGammaBoundaryCapped ((d : ℝ) / 2) R D y)"},{"kind":"theorem","name":"lowerStripCappedGammaOuter_integrable_dimension","statement":"{d : ℕ} (hd : 0 < d) {R D : ℝ} {z : ℂ} (hz : z ∈ Complex.im ⁻¹' Ioo (-((d : ℝ) / 2)) ((d : ℝ) / 2)) : Integrable (fun y : ℝ => stripRegularizedHolomorphicPoissonKernel ((d : ℝ) / 2) z y * (lowerGammaBoundaryCapped ((d : ℝ) / 2) R D y : ℂ))"},{"kind":"theorem","name":"lowerStripCappedGammaOuter_differentiableOn_dimension","statement":"{d : ℕ} (hd : 0 < d) (R D : ℝ) : DifferentiableOn ℂ (lowerStripCappedGammaOuter ((d : ℝ) / 2) R D) (Complex.im ⁻¹' Ioo (-((d : ℝ) / 2)) ((d : ℝ) / 2))"},{"kind":"theorem","name":"stripRegularizedOuter_re","statement":"{ℓ σ : ℝ} (hℓ : 0 < ℓ) (hσbelow : -1 < σ) (hσabove : σ < 1) (s : ℝ) (b : ℝ → ℝ) (houter : Integrable (fun y : ℝ => stripRegularizedHolomorphicPoissonKernel ℓ ((s : ℂ) + Complex.I * ((σ * ℓ : ℝ) : ℂ)) y * (b y : ℂ))) : (stripRegularizedOuter ℓ b ((s : ℂ) + Complex.I * ((σ * ℓ : ℝ) : ℂ))).re = ∫ T : ℝ, stripPoissonKernel σ T * b (s - ℓ * T)"},{"kind":"theorem","name":"lowerStripCappedGammaOuter_re_dimension","statement":"{d : ℕ} (hd : 0 < d) {σ R D : ℝ} (hσbelow : -1 < σ) (hσabove : σ < 1) (s : ℝ) : (lowerStripCappedGammaOuter ((d : ℝ) / 2) R D ((s : ℂ) + Complex.I * ((σ * ((d : ℝ) / 2) : ℝ) : ℂ))).re = ∫ T : ℝ, stripPoissonKernel σ T * lowerGammaBoundaryCapped ((d : ℝ) / 2) R D (s - ((d : ℝ) / 2) * T)"},{"kind":"theorem","name":"stripPoissonKernel_tendsto_zero_bottom_of_ne","statement":"{T : ℝ} (hT : T ≠ 0) : Tendsto (fun σ : ℝ => stripPoissonKernel σ T) (𝓝 (-1 : ℝ)) (𝓝 (0 : ℝ))"},{"kind":"theorem","name":"stripPoissonKernel_le_center_of_lower_of_abs_ge","statement":"{σ δ T : ℝ} (hbelow : -1 < σ) (hnonpos : σ ≤ 0) (hδ : 0 < δ) (hT : δ ≤ |T|) : stripPoissonKernel σ T ≤ (1 / (1 - (Real.cosh (Real.pi * δ / 2))⁻¹)) * stripPoissonKernel 0 T"},{"kind":"theorem","name":"stripPoissonKernel_le_center_of_lower","statement":"{σ : ℝ} (hbelow : -1 < σ) (hnonpos : σ ≤ 0) (T : ℝ) : stripPoissonKernel σ T ≤ (1 / (1 - Real.cos (stripAngle σ))) * stripPoissonKernel 0 T"},{"kind":"theorem","name":"stripPoissonKernel_lower_product_integrable","statement":"{σ : ℝ} (hbelow : -1 < σ) (hnonpos : σ ≤ 0) {g : ℝ → ℝ} (hg : Continuous g) (hbase : Integrable (fun T : ℝ => stripPoissonKernel 0 T * g T)) : Integrable (fun T : ℝ => stripPoissonKernel σ T * g T)"},{"kind":"theorem","name":"lowerGammaBoundaryCapped_central_poisson_shift_integrable","statement":"{d : ℕ} (hd : 0 < d) (R D s : ℝ) : Integrable (fun T : ℝ => stripPoissonKernel 0 T * lowerGammaBoundaryCapped ((d : ℝ) / 2) R D (s - ((d : ℝ) / 2) * T))"},{"kind":"theorem","name":"norm_extension_le_of_frontier","statement":"{U : Set ℂ} (hopen : IsOpen U) (hconnected : IsPreconnected U) (hbounded : Bornology.IsBounded U) {f : ℂ → ℂ} (hf : DifferentiableOn ℂ f U) {N : ℂ → ℝ} (hN : ContinuousOn N (closure U)) (hinterior : ∀ z ∈ U, N z = ‖f z‖) {C : ℝ} (hfrontier : ∀ z ∈ frontier U, N z ≤ C) {z : ℂ} (hz : z ∈ closure U) : N z ≤ C"},{"kind":"theorem","name":"horizontalStrip_norm_extension_majorization","statement":"{a b C : ℝ} (hab : a < b) (hC : 0 < C) (f : ℂ → ℂ) (N : ℂ → ℝ) (hf : DifferentiableOn ℂ f (Complex.im ⁻¹' Ioo a b)) (hN : ContinuousOn N (Complex.im ⁻¹' Icc a b)) (hNnonneg : ∀ w : ℂ, w.im ∈ Icc a b → 0 ≤ N w) (hinterior : ∀ w : ℂ, w.im ∈ Ioo a b → N w = ‖f w‖) (hbottom : ∀ w : ℂ, w.im = a → N w ≤ C) (htop : ∀ w : ℂ, w.im = b → N w ≤ C) (hgrowth : ∃ c < Real.pi / (b - a), ∃ B : ℝ, Asymptotics.IsBigO (Filter.comap (fun w : ℂ => |w.re|) Filter.atTop ⊓ Filter.principal (Complex.im ⁻¹' Ioo a b)) f (fun w : ℂ => Real.exp (B * Real.exp (c * |w.re|)))) {z : ℂ} (hza : a ≤ z.im) (hzb : z.im ≤ b) : N z ≤ C"},{"kind":"theorem","name":"harmonic_abs_log_half_le_half","statement":"{x : ℝ} (hx : 2 ≤ x) : |Real.log (x / 2)| ≤ x / 2"},{"kind":"theorem","name":"harmonic_abs_log_sqrtFactor_le_linear","statement":"{c x : ℝ} (hc : 0 ≤ c) (hx : 2 ≤ x) : |Real.log (Real.sqrt (c ^ 2 + (x / 2) ^ 2))| ≤ c + x"},{"kind":"theorem","name":"harmonic_abs_log_coth_div_le_linear","statement":"{x : ℝ} (hx : 2 ≤ x) : |Real.log (lowerCoth (Real.pi * (x / 2)) / (x / 2))| ≤ Real.pi * x + |Real.log Real.pi| + x"},{"kind":"theorem","name":"harmonic_integerGammaBoundary_abs_le_linear","statement":"(k : ℕ) (R : ℝ) : ∃ A : ℝ, 0 ≤ A ∧ ∀ x : ℝ, 2 ≤ x → |lowerGammaBoundaryLog (k : ℝ) R x| ≤ A * (1 + x)"},{"kind":"theorem","name":"harmonic_halfIntegerGammaBoundary_abs_le_linear","statement":"(k : ℕ) (R : ℝ) : ∃ A : ℝ, 0 ≤ A ∧ ∀ x : ℝ, 2 ≤ x → |lowerGammaBoundaryLog ((k : ℝ) + 1 / 2) R x| ≤ A * (1 + x)"},{"kind":"theorem","name":"harmonic_dimensionGammaBoundary_eq_abs","statement":"{d : ℕ} (R : ℝ) {y : ℝ} (hy : y ≠ 0) : lowerGammaBoundaryLog ((d : ℝ) / 2) R y = lowerGammaBoundaryLog ((d : ℝ) / 2) R |y|"},{"kind":"theorem","name":"harmonic_dimensionGammaBoundary_abs_le_linear","statement":"(d : ℕ) (R : ℝ) : ∃ A : ℝ, 0 ≤ A ∧ ∀ y : ℝ, 2 ≤ |y| → |lowerGammaBoundaryLog ((d : ℝ) / 2) R y| ≤ A * (1 + |y|)"},{"kind":"theorem","name":"lowerGammaBoundaryCapped_dimension_abs_le_linear","statement":"{d : ℕ} (hd : 0 < d) (R D : ℝ) : ∃ A : ℝ, 0 ≤ A ∧ ∀ y : ℝ, |lowerGammaBoundaryCapped ((d : ℝ) / 2) R D y| ≤ A * (1 + |y|)"},{"kind":"theorem","name":"stripPoissonKernel_le_exponentialMajorant_of_nonneg","statement":"{σ : ℝ} (hσ : 0 ≤ σ) (hσone : σ < 1) (T : ℝ) : stripPoissonKernel σ T ≤ stripPoissonExponentialMajorant T"},{"kind":"theorem","name":"harmonic_stripPoissonExponentialMajorant_abs_integrable","statement":"Integrable (fun T : ℝ => stripPoissonExponentialMajorant T * |T|)"},{"kind":"theorem","name":"harmonic_stripPoissonKernel_zero_abs_integrable","statement":"Integrable (fun T : ℝ => stripPoissonKernel 0 T * |T|)"},{"kind":"theorem","name":"harmonic_stripPoissonKernel_abs_integrable","statement":"{σ : ℝ} (hbelow : -1 < σ) (habove : σ < 1) : Integrable (fun T : ℝ => stripPoissonKernel σ T * |T|)"},{"kind":"theorem","name":"exists_stripPoissonKernel_uniform_abs_moment","statement":"∃ M : ℝ, 0 ≤ M ∧ ∀ σ : ℝ, -1 < σ → σ < 1 → (∫ T : ℝ, stripPoissonKernel σ T * |T|) ≤ M"},{"kind":"theorem","name":"lowerGammaBoundaryCapped_poisson_abs_le_linear","statement":"{d : ℕ} (hd : 0 < d) (R D : ℝ) : ∃ B : ℝ, 0 ≤ B ∧ ∀ σ : ℝ, -1 < σ → σ < 1 → ∀ s : ℝ, |∫ T : ℝ, stripPoissonKernel σ T * lowerGammaBoundaryCapped ((d : ℝ) / 2) R D (s - ((d : ℝ) / 2) * T)| ≤ B * (1 + |s|)"},{"kind":"theorem","name":"lowerStripCappedGammaOuter_abs_re_le_linear","statement":"{d : ℕ} (hd : 0 < d) (R D : ℝ) : ∃ B : ℝ, 0 ≤ B ∧ ∀ z : ℂ, z ∈ Complex.im ⁻¹' Ioo (-((d : ℝ) / 2)) ((d : ℝ) / 2) → |(lowerStripCappedGammaOuter ((d : ℝ) / 2) R D z).re| ≤ B * (1 + |z.re|)"},{"kind":"theorem","name":"antiFourierWitness_cappedWeightedMellinStrip_growth","statement":"{d : ℕ} (hd : 0 < d) {R : ℝ} (w : AntiFourierWitness d R) (D : ℝ) : ∃ c < Real.pi / (((d : ℝ) / 2) - (-((d : ℝ) / 2))), ∃ B : ℝ, Asymptotics.IsBigO (Filter.comap (fun z : ℂ => |z.re|) Filter.atTop ⊓ Filter.principal (Complex.im ⁻¹' Ioo (-((d : ℝ) / 2)) ((d : ℝ) / 2))) (fun z : ℂ => Complex.exp (-(lowerStripCappedGammaOuter ((d : ℝ) / 2) R D z)) * normalizedRadialMellinStrip hd w.function R z) (fun z : ℂ => Real.exp (B * Real.exp (c * |z.re|)))"},{"kind":"theorem","name":"harmonic_bottom_normalized_height_tendsto","statement":"{ℓ : ℝ} (hℓ : 0 < ℓ) (s : ℝ) : Tendsto (fun z : ℂ => z.im / ℓ) (𝓝[Complex.im ⁻¹' Ioo (-ℓ) ℓ] ((s : ℂ) - Complex.I * (ℓ : ℂ))) (𝓝 (-1 : ℝ))"},{"kind":"theorem","name":"harmonic_bottom_real_tendsto","statement":"{ℓ : ℝ} (s : ℝ) : Tendsto Complex.re (𝓝[Complex.im ⁻¹' Ioo (-ℓ) ℓ] ((s : ℂ) - Complex.I * (ℓ : ℂ))) (𝓝 s)"},{"kind":"theorem","name":"harmonic_bottom_far_joint_tendsto_zero","statement":"{ℓ : ℝ} (hℓ : 0 < ℓ) {b : ℝ → ℝ} (hb : Continuous b) {A : ℝ} (hA : 0 ≤ A) (hbound : ∀ y : ℝ, |b y| ≤ A * (1 + |y|)) (s : ℝ) {δ : ℝ} (hδ : 0 < δ) : Tendsto (fun z : ℂ => ∫ T in {T : ℝ | δ ≤ |T|}, stripPoissonKernel (z.im / ℓ) T * b (z.re - ℓ * T)) (𝓝[Complex.im ⁻¹' Ioo (-ℓ) ℓ] ((s : ℂ) - Complex.I * (ℓ : ℂ))) (𝓝 (0 : ℝ))"},{"kind":"theorem","name":"harmonic_bottom_joint_tendsto_zero_of_zero","statement":"{ℓ : ℝ} (hℓ : 0 < ℓ) {b : ℝ → ℝ} (hb : Continuous b) {A : ℝ} (hA : 0 ≤ A) (hbound : ∀ y : ℝ, |b y| ≤ A * (1 + |y|)) (hcentral : ∀ t : ℝ, Integrable (fun T : ℝ => stripPoissonKernel 0 T * b (t - ℓ * T))) (s : ℝ) (hszero : b s = 0) : Tendsto (fun z : ℂ => ∫ T : ℝ, stripPoissonKernel (z.im / ℓ) T * b (z.re - ℓ * T)) (𝓝[Complex.im ⁻¹' Ioo (-ℓ) ℓ] ((s : ℂ) - Complex.I * (ℓ : ℂ))) (𝓝 (0 : ℝ))"},{"kind":"theorem","name":"lowerGammaBoundaryCapped_bottom_poisson_joint_tendsto","statement":"{d : ℕ} (hd : 0 < d) (R D s : ℝ) : Tendsto (fun z : ℂ => ∫ T : ℝ, stripPoissonKernel (z.im / ((d : ℝ) / 2)) T * lowerGammaBoundaryCapped ((d : ℝ) / 2) R D (z.re - ((d : ℝ) / 2) * T)) (𝓝[Complex.im ⁻¹' Ioo (-((d : ℝ) / 2)) ((d : ℝ) / 2)] ((s : ℂ) - Complex.I * (((d : ℝ) / 2 : ℝ) : ℂ))) (𝓝 (lowerGammaBoundaryCapped ((d : ℝ) / 2) R D s))"},{"kind":"theorem","name":"stripPoissonKernel_tendsto_zero_top","statement":"(T : ℝ) : Tendsto (fun σ : ℝ => stripPoissonKernel σ T) (𝓝 (1 : ℝ)) (𝓝 (0 : ℝ))"},{"kind":"theorem","name":"harmonic_top_normalized_height_tendsto","statement":"{ℓ : ℝ} (hℓ : 0 < ℓ) (s : ℝ) : Tendsto (fun z : ℂ => z.im / ℓ) (𝓝[Complex.im ⁻¹' Ioo (-ℓ) ℓ] ((s : ℂ) + Complex.I * (ℓ : ℂ))) (𝓝 (1 : ℝ))"},{"kind":"theorem","name":"harmonic_upper_joint_tendsto_zero","statement":"{ℓ : ℝ} (hℓ : 0 < ℓ) {b : ℝ → ℝ} (hb : Continuous b) {A : ℝ} (hA : 0 ≤ A) (hbound : ∀ y : ℝ, |b y| ≤ A * (1 + |y|)) (s : ℝ) : Tendsto (fun z : ℂ => ∫ T : ℝ, stripPoissonKernel (z.im / ℓ) T * b (z.re - ℓ * T)) (𝓝[Complex.im ⁻¹' Ioo (-ℓ) ℓ] ((s : ℂ) + Complex.I * (ℓ : ℂ))) (𝓝 (0 : ℝ))"},{"kind":"theorem","name":"exists_antiFourierWitness_eventually_capped_bottom_majorant","statement":"{d : ℕ} (hd : 0 < d) {R : ℝ} (hR : 0 < R) (w : AntiFourierWitness d R) : ∃ D₀ : ℝ, ∀ D : ℝ, D₀ ≤ D → ∀ y : ℝ, ‖normalizedRadialMellinStrip hd w.function R ((y : ℂ) - Complex.I * (((d : ℝ) / 2 : ℝ) : ℂ))‖ ≤ Real.exp (lowerGammaBoundaryCapped ((d : ℝ) / 2) R D y)"},{"kind":"theorem","name":"lowerStripCappedGammaOuter_bottom_re_joint_tendsto","statement":"{d : ℕ} (hd : 0 < d) (R D s : ℝ) : Tendsto (fun z : ℂ => (lowerStripCappedGammaOuter ((d : ℝ) / 2) R D z).re) (𝓝[Complex.im ⁻¹' Ioo (-((d : ℝ) / 2)) ((d : ℝ) / 2)] ((s : ℂ) - Complex.I * (((d : ℝ) / 2 : ℝ) : ℂ))) (𝓝 (lowerGammaBoundaryCapped ((d : ℝ) / 2) R D s))"},{"kind":"theorem","name":"lowerStripCappedGammaOuter_top_re_joint_tendsto","statement":"{d : ℕ} (hd : 0 < d) (R D s : ℝ) : Tendsto (fun z : ℂ => (lowerStripCappedGammaOuter ((d : ℝ) / 2) R D z).re) (𝓝[Complex.im ⁻¹' Ioo (-((d : ℝ) / 2)) ((d : ℝ) / 2)] ((s : ℂ) + Complex.I * (((d : ℝ) / 2 : ℝ) : ℂ))) (𝓝 (0 : ℝ))"},{"kind":"theorem","name":"horizontalStrip_closed_eq_open_union_edges","statement":"{a b : ℝ} (hab : a < b) : (Complex.im ⁻¹' Icc a b) = ((Complex.im ⁻¹' Ioo a b) ∪ (Complex.im ⁻¹' {a})) ∪ (Complex.im ⁻¹' {b})"},{"kind":"theorem","name":"horizontalStripRealTraceExtension_continuousOn","statement":"{a b : ℝ} (hab : a < b) (H : ℂ → ℝ) (bottom top : ℝ → ℝ) (hH : ContinuousOn H (Complex.im ⁻¹' Ioo a b)) (hbottom : Continuous bottom) (htop : Continuous top) (hbottomtrace : ∀ s : ℝ, Tendsto H (𝓝[Complex.im ⁻¹' Ioo a b] ((s : ℂ) + Complex.I * (a : ℂ))) (𝓝 (bottom s))) (htoptrace : ∀ s : ℝ, Tendsto H (𝓝[Complex.im ⁻¹' Ioo a b] ((s : ℂ) + Complex.I * (b : ℂ))) (𝓝 (top s))) : ContinuousOn (horizontalStripRealTraceExtension a b H bottom top) (Complex.im ⁻¹' Icc a b)"},{"kind":"theorem","name":"lowerStripCappedGammaHarmonic_continuousOn","statement":"{d : ℕ} (hd : 0 < d) (R D : ℝ) : ContinuousOn (lowerStripCappedGammaHarmonic d R D) (Complex.im ⁻¹' Icc (-((d : ℝ) / 2)) ((d : ℝ) / 2))"},{"kind":"theorem","name":"antiFourierWitness_capped_poisson_majorization_of_real_extension","statement":"{d : ℕ} (hd : 0 < d) {R : ℝ} (w : AntiFourierWitness d R) (D : ℝ) (E : ℂ → ℝ) (hE : ContinuousOn E (Complex.im ⁻¹' Icc (-((d : ℝ) / 2)) ((d : ℝ) / 2))) (hEinterior : ∀ z : ℂ, z.im ∈ Ioo (-((d : ℝ) / 2)) ((d : ℝ) / 2) → E z = (lowerStripCappedGammaOuter ((d : ℝ) / 2) R D z).re) (hEbottom : ∀ z : ℂ, z.im = -((d : ℝ) / 2) → E z = lowerGammaBoundaryCapped ((d : ℝ) / 2) R D z.re) (hEtop : ∀ z : ℂ, z.im = (d : ℝ) / 2 → E z = 0) (hcap : ∀ y : ℝ, ‖normalizedRadialMellinStrip hd w.function R ((y : ℂ) - Complex.I * (((d : ℝ) / 2 : ℝ) : ℂ))‖ ≤ Real.exp (lowerGammaBoundaryCapped ((d : ℝ) / 2) R D y)) {σ : ℝ} (hbelow : -1 < σ) (habove : σ < 1) (s : ℝ) : ‖normalizedRadialMellinStrip hd w.function R ((s : ℂ) + Complex.I * ((σ * ((d : ℝ) / 2) : ℝ) : ℂ))‖ ≤ Real.exp (∫ T : ℝ, stripPoissonKernel σ T * lowerGammaBoundaryCapped ((d : ℝ) / 2) R D (s - ((d : ℝ) / 2) * T))"},{"kind":"theorem","name":"exists_antiFourierWitness_capped_poisson_majorization","statement":"{d : ℕ} (hd : 0 < d) {R : ℝ} (hR : 0 < R) (w : AntiFourierWitness d R) : ∃ D₀ : ℝ, ∀ D : ℝ, D₀ ≤ D → ∀ {σ : ℝ}, -1 < σ → σ < 1 → ∀ s : ℝ, ‖normalizedRadialMellinStrip hd w.function R ((s : ℂ) + Complex.I * (((σ * ((d : ℝ) / 2) : ℝ) : ℂ)))‖ ≤ Real.exp (∫ T : ℝ, stripPoissonKernel σ T * lowerGammaBoundaryCapped ((d : ℝ) / 2) R D (s - ((d : ℝ) / 2) * T))"},{"kind":"theorem","name":"stripPoissonKernel_shifted_centered_interval_max","statement":"{σ : ℝ} (hbelow : -1 < σ) (habove : σ < 1) {r : ℝ} (hr : 0 ≤ r) (s : ℝ) : (∫ x in Icc (-r) r, stripPoissonKernel σ (s - x)) ≤ ∫ x in Icc (-r) r, stripPoissonKernel σ (0 - x)"},{"kind":"theorem","name":"stripPoissonWeightedMeasure_apply_Icc","statement":"{σ : ℝ} (hbelow : -1 < σ) (habove : σ < 1) (s a b : ℝ) : stripPoissonWeightedMeasure σ s (Icc a b) = ENNReal.ofReal (∫ x in Icc a b, stripPoissonKernel σ (s - x))"},{"kind":"theorem","name":"stripPoissonWeightedMeasure_centered_interval_max","statement":"{σ : ℝ} (hbelow : -1 < σ) (habove : σ < 1) {r : ℝ} (hr : 0 ≤ r) (s : ℝ) : stripPoissonWeightedMeasure σ s (Icc (-r) r) ≤ stripPoissonWeightedMeasure σ 0 (Icc (-r) r)"},{"kind":"theorem","name":"stripPoissonWeightedMeasure_superlevel_le","statement":"{σ : ℝ} (hbelow : -1 < σ) (habove : σ < 1) {f : ℝ → ℝ} {B t : ℝ} (heven : ∀ x : ℝ, f (-x) = f x) (hanti : AntitoneOn f (Ici (0 : ℝ))) (hsupport : Function.support f ⊆ Icc (-B) B) (ht : 0 < t) (s : ℝ) : stripPoissonWeightedMeasure σ s {x : ℝ | t < f x} ≤ stripPoissonWeightedMeasure σ 0 {x : ℝ | t < f x}"},{"kind":"theorem","name":"even_antitone_poisson_lintegral_max","statement":"{σ : ℝ} (hbelow : -1 < σ) (habove : σ < 1) {f : ℝ → ℝ} {B : ℝ} (hfmeas : Measurable f) (hfnonneg : ∀ x : ℝ, 0 ≤ f x) (heven : ∀ x : ℝ, f (-x) = f x) (hanti : AntitoneOn f (Ici (0 : ℝ))) (hsupport : Function.support f ⊆ Icc (-B) B) (s : ℝ) : (∫⁻ x : ℝ, ENNReal.ofReal (f x) ∂stripPoissonWeightedMeasure σ s) ≤ ∫⁻ x : ℝ, ENNReal.ofReal (f x) ∂stripPoissonWeightedMeasure σ 0"},{"kind":"theorem","name":"stripPoissonKernel_weighted_product_integrable","statement":"{σ : ℝ} (hbelow : -1 < σ) (habove : σ < 1) {f : ℝ → ℝ} (hf : Integrable f) (s : ℝ) : Integrable (fun x : ℝ => stripPoissonKernel σ (s - x) * f x)"},{"kind":"theorem","name":"stripPoissonWeightedMeasure_integrable","statement":"{σ : ℝ} (hbelow : -1 < σ) (habove : σ < 1) {f : ℝ → ℝ} (hf : Integrable f) (s : ℝ) : Integrable f (stripPoissonWeightedMeasure σ s)"},{"kind":"theorem","name":"stripPoissonWeightedMeasure_integral","statement":"{σ : ℝ} (hbelow : -1 < σ) (habove : σ < 1) (f : ℝ → ℝ) (s : ℝ) : (∫ x : ℝ, f x ∂stripPoissonWeightedMeasure σ s) = ∫ x : ℝ, stripPoissonKernel σ (s - x) * f x"},{"kind":"theorem","name":"even_antitone_poisson_convolution_max","statement":"{σ : ℝ} (hbelow : -1 < σ) (habove : σ < 1) {f : ℝ → ℝ} {B : ℝ} (hf : Integrable f) (hfmeas : Measurable f) (hfnonneg : ∀ x : ℝ, 0 ≤ f x) (heven : ∀ x : ℝ, f (-x) = f x) (hanti : AntitoneOn f (Ici (0 : ℝ))) (hsupport : Function.support f ⊆ Icc (-B) B) (s : ℝ) : (∫ x : ℝ, stripPoissonKernel σ (s - x) * f x) ≤ ∫ x : ℝ, stripPoissonKernel σ (0 - x) * f x"},{"kind":"theorem","name":"lowerGammaBoundaryCapped_dimension_neg","statement":"{d : ℕ} (R D y : ℝ) : lowerGammaBoundaryCapped ((d : ℝ) / 2) R D (-y) = lowerGammaBoundaryCapped ((d : ℝ) / 2) R D y"},{"kind":"theorem","name":"lowerGammaBoundaryCapped_dimension_antitoneOn","statement":"{d : ℕ} (R D : ℝ) : AntitoneOn (lowerGammaBoundaryCapped ((d : ℝ) / 2) R D) (Ici (0 : ℝ))"},{"kind":"theorem","name":"lowerGammaBoundaryLog_dimension_scaled_le_neg_of_large","statement":"{d : ℕ} (hd : 2 ≤ d) {c Y n : ℝ} (hc : 0 < c) (hn : 0 ≤ n) (hlarge : max 1 (8 * Real.pi * c ^ 2 * Real.exp n) ≤ |Y|) : lowerGammaBoundaryLog ((d : ℝ) / 2) (c * Real.sqrt d) (((d : ℝ) / 2) * Y) ≤ -n"},{"kind":"theorem","name":"lowerGammaScaledCappedClipped_continuous","statement":"{d : ℕ} (hd : 0 < d) (c D n : ℝ) : Continuous (lowerGammaScaledCappedClipped d c D n)"},{"kind":"theorem","name":"lowerGammaScaledCappedClipped_neg","statement":"(d : ℕ) (c D n Y : ℝ) : lowerGammaScaledCappedClipped d c D n (-Y) = lowerGammaScaledCappedClipped d c D n Y"},{"kind":"theorem","name":"lowerGammaScaledCappedClipped_antitoneOn","statement":"(d : ℕ) (c D n : ℝ) : AntitoneOn (lowerGammaScaledCappedClipped d c D n) (Ici (0 : ℝ))"},{"kind":"theorem","name":"lowerGammaScaledCappedClipped_support","statement":"{d : ℕ} (hd : 2 ≤ d) {c D n : ℝ} (hc : 0 < c) (hn : 0 ≤ n) : Function.support (lowerGammaScaledCappedClipped d c D n) ⊆ Icc (-(max 1 (8 * Real.pi * c ^ 2 * Real.exp n))) (max 1 (8 * Real.pi * c ^ 2 * Real.exp n))"},{"kind":"theorem","name":"lowerGammaScaledCappedClipped_integrable","statement":"{d : ℕ} (hd : 2 ≤ d) {c D n : ℝ} (hc : 0 < c) (hn : 0 ≤ n) : Integrable (lowerGammaScaledCappedClipped d c D n)"},{"kind":"theorem","name":"lowerGammaScaledCappedClipped_poisson_convolution_max","statement":"{d : ℕ} (hd : 2 ≤ d) {c D n σ : ℝ} (hc : 0 < c) (hn : 0 ≤ n) (hbelow : -1 < σ) (habove : σ < 1) (s : ℝ) : (∫ Y : ℝ, stripPoissonKernel σ (s - Y) * lowerGammaScaledCappedClipped d c D n Y) ≤ ∫ Y : ℝ, stripPoissonKernel σ (0 - Y) * lowerGammaScaledCappedClipped d c D n Y"},{"kind":"theorem","name":"lowerGammaScaledCapped_poisson_product_integrable","statement":"{d : ℕ} (hd : 0 < d) {R D σ : ℝ} (hbelow : -1 < σ) (habove : σ < 1) (s : ℝ) : Integrable (fun Y : ℝ => stripPoissonKernel σ (s - Y) * lowerGammaBoundaryCapped ((d : ℝ) / 2) R D (((d : ℝ) / 2) * Y))"},{"kind":"theorem","name":"lowerGammaScaled_poisson_product_integrable","statement":"{d : ℕ} (hd : 0 < d) {R σ : ℝ} (hbelow : -1 < σ) (habove : σ < 1) (s : ℝ) : Integrable (fun Y : ℝ => stripPoissonKernel σ (s - Y) * lowerGammaBoundaryLog ((d : ℝ) / 2) R (((d : ℝ) / 2) * Y))"},{"kind":"theorem","name":"lowerGammaScaledCappedClipped_eq_lowerClip_add","statement":"(d : ℕ) (c D n Y : ℝ) : lowerGammaScaledCappedClipped d c D n Y = lowerGammaScaledCappedLowerClip d c D n Y + n"},{"kind":"theorem","name":"lowerGammaScaledCappedLowerClip_poisson_integrable","statement":"{d : ℕ} (hd : 0 < d) {c D n σ : ℝ} (hbelow : -1 < σ) (habove : σ < 1) (s : ℝ) : Integrable (fun Y : ℝ => stripPoissonKernel σ (s - Y) * lowerGammaScaledCappedLowerClip d c D n Y)"},{"kind":"theorem","name":"lowerGammaScaledCappedClipped_integral_eq","statement":"{d : ℕ} (hd : 0 < d) {c D n σ : ℝ} (hbelow : -1 < σ) (habove : σ < 1) (s : ℝ) : (∫ Y : ℝ, stripPoissonKernel σ (s - Y) * lowerGammaScaledCappedClipped d c D n Y) = (∫ Y : ℝ, stripPoissonKernel σ (s - Y) * lowerGammaScaledCappedLowerClip d c D n Y) + n * stripBottomMass σ"},{"kind":"theorem","name":"lowerGammaScaledCappedLowerClip_poisson_convolution_max","statement":"{d : ℕ} (hd : 2 ≤ d) {c D n σ : ℝ} (hc : 0 < c) (hn : 0 ≤ n) (hbelow : -1 < σ) (habove : σ < 1) (s : ℝ) : (∫ Y : ℝ, stripPoissonKernel σ (s - Y) * lowerGammaScaledCappedLowerClip d c D n Y) ≤ ∫ Y : ℝ, stripPoissonKernel σ (0 - Y) * lowerGammaScaledCappedLowerClip d c D n Y"},{"kind":"theorem","name":"lowerGammaScaledCappedLowerClip_poisson_tendsto","statement":"{d : ℕ} (hd : 0 < d) {c D σ : ℝ} (hbelow : -1 < σ) (habove : σ < 1) (s : ℝ) : Tendsto (fun n : ℕ => ∫ Y : ℝ, stripPoissonKernel σ (s - Y) * lowerGammaScaledCappedLowerClip d c D (n : ℝ) Y) atTop (𝓝 (∫ Y : ℝ, stripPoissonKernel σ (s - Y) * lowerGammaBoundaryCapped ((d : ℝ) / 2) (c * Real.sqrt d) D (((d : ℝ) / 2) * Y)))"},{"kind":"theorem","name":"lowerGammaScaledCapped_poisson_convolution_max","statement":"{d : ℕ} (hd : 2 ≤ d) {c D σ : ℝ} (hc : 0 < c) (hbelow : -1 < σ) (habove : σ < 1) (s : ℝ) : (∫ Y : ℝ, stripPoissonKernel σ (s - Y) * lowerGammaBoundaryCapped ((d : ℝ) / 2) (c * Real.sqrt d) D (((d : ℝ) / 2) * Y)) ≤ ∫ Y : ℝ, stripPoissonKernel σ (0 - Y) * lowerGammaBoundaryCapped ((d : ℝ) / 2) (c * Real.sqrt d) D (((d : ℝ) / 2) * Y)"},{"kind":"theorem","name":"lowerGammaScaledCapped_poisson_tendsto","statement":"{d : ℕ} (hd : 0 < d) {c σ : ℝ} (hbelow : -1 < σ) (habove : σ < 1) (s : ℝ) : Tendsto (fun n : ℕ => ∫ Y : ℝ, stripPoissonKernel σ (s - Y) * lowerGammaBoundaryCapped ((d : ℝ) / 2) (c * Real.sqrt d) (n : ℝ) (((d : ℝ) / 2) * Y)) atTop (𝓝 (∫ Y : ℝ, stripPoissonKernel σ (s - Y) * lowerGammaBoundaryLog ((d : ℝ) / 2) (c * Real.sqrt d) (((d : ℝ) / 2) * Y)))"},{"kind":"theorem","name":"lowerGammaScaled_poisson_convolution_max","statement":"{d : ℕ} (hd : 2 ≤ d) {c σ : ℝ} (hc : 0 < c) (hbelow : -1 < σ) (habove : σ < 1) (s : ℝ) : (∫ Y : ℝ, stripPoissonKernel σ (s - Y) * lowerGammaBoundaryLog ((d : ℝ) / 2) (c * Real.sqrt d) (((d : ℝ) / 2) * Y)) ≤ ∫ Y : ℝ, stripPoissonKernel σ (0 - Y) * lowerGammaBoundaryLog ((d : ℝ) / 2) (c * Real.sqrt d) (((d : ℝ) / 2) * Y)"},{"kind":"theorem","name":"lowerStripPoissonMajorant_scaled_convolution","statement":"{ℓ : ℝ} (hℓ : 0 < ℓ) (R σ s : ℝ) : lowerStripPoissonMajorant ℓ R σ s = ∫ Y : ℝ, stripPoissonKernel σ (s / ℓ - Y) * lowerGammaBoundaryLog ℓ R (ℓ * Y)"},{"kind":"theorem","name":"lowerStripPoissonMajorant_dimension_centered_max","statement":"{d : ℕ} (hd : 2 ≤ d) {c σ : ℝ} (hc : 0 < c) (hbelow : -1 < σ) (habove : σ < 1) (s : ℝ) : lowerStripPoissonMajorant ((d : ℝ) / 2) (c * Real.sqrt d) σ s ≤ lowerStripPoissonMajorant ((d : ℝ) / 2) (c * Real.sqrt d) σ 0"},{"kind":"theorem","name":"lowerRiemannLog_zero","statement":"(T : ℝ) : lowerRiemannLog T 0 = Real.log (|T| / 2)"},{"kind":"theorem","name":"lowerRiemannLog_scaled_factor","statement":"{ℓ T : ℝ} (hℓ : 0 < ℓ) (j : ℝ) : Real.sqrt (j ^ 2 + (ℓ * T / 2) ^ 2) = ℓ * Real.sqrt ((j / ℓ) ^ 2 + T ^ 2 / 4)"},{"kind":"theorem","name":"lowerGammaBoundaryLog_integer_scaled","statement":"{k : ℕ} (hk : 0 < k) {R T : ℝ} (hR : 0 < R) (hT : T ≠ 0) : lowerGammaBoundaryLog (k : ℝ) R ((k : ℝ) * T) = (k : ℝ) * Real.log (Real.pi * R ^ 2 / (k : ℝ)) - ∑ j ∈ Finset.range k, lowerRiemannLog T ((j : ℝ) / (k : ℝ))"},{"kind":"theorem","name":"lowerGammaBoundaryLog_halfInteger_scaled","statement":"(k : ℕ) {ℓ R T : ℝ} (hℓeq : ℓ = (k : ℝ) + 1 / 2) (hR : 0 < R) (hT : T ≠ 0) : lowerGammaBoundaryLog ℓ R (ℓ * T) = ℓ * Real.log (Real.pi * R ^ 2 / ℓ) - ∑ j ∈ Finset.range k, lowerRiemannLog T (((j : ℝ) + 1 / 2) / ℓ) + (1 / 2 : ℝ) * Real.log (lowerCoth (Real.pi * ℓ * |T| / 2)) - (1 / 2 : ℝ) * Real.log (|T| / 2)"},{"kind":"theorem","name":"lowerRiemannLog_continuous","statement":"{T : ℝ} (hT : T ≠ 0) : Continuous (lowerRiemannLog T)"},{"kind":"theorem","name":"lowerGammaBoundaryLog_integer_riemann_le","statement":"{k : ℕ} (hk : 0 < k) {R T : ℝ} (hR : 0 < R) (hT : T ≠ 0) : lowerGammaBoundaryLog (k : ℝ) R ((k : ℝ) * T) ≤ (k : ℝ) * (Real.log (Real.pi * R ^ 2 / (k : ℝ)) + 1 + lowerEndpointPhase T) + lowerRiemannErrorMajorant T"},{"kind":"theorem","name":"lowerRiemannLog_halfInteger_tail_integral_le","statement":"(k : ℕ) {ℓ T : ℝ} (hℓeq : ℓ = (k : ℝ) + 1 / 2) (hT : T ≠ 0) : ℓ * (∫ x in ((k : ℝ) / ℓ)..1, lowerRiemannLog T x) ≤ (1 / 2 : ℝ) * lowerRiemannLog T 1"},{"kind":"theorem","name":"lowerGammaBoundaryLog_halfInteger_riemann_le","statement":"(k : ℕ) {ℓ R T : ℝ} (hℓeq : ℓ = (k : ℝ) + 1 / 2) (hℓone : 1 ≤ ℓ) (hR : 0 < R) (hT : T ≠ 0) : lowerGammaBoundaryLog ℓ R (ℓ * T) ≤ ℓ * (Real.log (Real.pi * R ^ 2 / ℓ) + 1 + lowerEndpointPhase T) + lowerRiemannErrorMajorant T"},{"kind":"theorem","name":"lowerGammaBoundaryLog_dimension_riemann_le","statement":"{d : ℕ} (hd : 2 ≤ d) {R T : ℝ} (hR : 0 < R) (hT : T ≠ 0) : lowerGammaBoundaryLog ((d : ℝ) / 2) R (((d : ℝ) / 2) * T) ≤ ((d : ℝ) / 2) * (Real.log (Real.pi * R ^ 2 / ((d : ℝ) / 2)) + 1 + lowerEndpointPhase T) + lowerRiemannErrorMajorant T"},{"kind":"theorem","name":"lowerGammaBoundaryLog_dimension_scaled_riemann_le","statement":"{d : ℕ} (hd : 2 ≤ d) {c T : ℝ} (hc : 0 < c) (hT : T ≠ 0) : lowerGammaBoundaryLog ((d : ℝ) / 2) (c * Real.sqrt d) (((d : ℝ) / 2) * T) ≤ ((d : ℝ) / 2) * (Real.log (2 * Real.pi * Real.exp 1 * c ^ 2) + lowerEndpointPhase T) + lowerRiemannErrorMajorant T"},{"kind":"theorem","name":"stripPoissonKernel_le_mass_mul_exponential","statement":"{σ : ℝ} (hzero : 0 ≤ σ) (habove : σ < 1) (T : ℝ) : stripPoissonKernel σ T ≤ stripBottomMass σ * stripPoissonExponentialMajorant T"},{"kind":"theorem","name":"stripPoissonExponentialMajorant_abs_moment_integrable","statement":"Integrable (fun T : ℝ => stripPoissonExponentialMajorant T * |T|)"},{"kind":"theorem","name":"stripPoissonKernel_abs_moment_integrable","statement":"{σ : ℝ} (hzero : 0 ≤ σ) (habove : σ < 1) : Integrable (fun T : ℝ => stripPoissonKernel σ T * |T|)"},{"kind":"theorem","name":"stripPoissonKernel_mul_lowerRiemannLog_zero_integrable","statement":"{σ : ℝ} (hbelow : -1 < σ) (habove : σ < 1) : Integrable (fun T : ℝ => stripPoissonKernel σ T * lowerRiemannLog T 0)"},{"kind":"theorem","name":"lowerRiemannLog_one_nonneg_le","statement":"(T : ℝ) : 0 ≤ lowerRiemannLog T 1 ∧ lowerRiemannLog T 1 ≤ |T| / 2"},{"kind":"theorem","name":"lowerRiemannLog_one_continuous","statement":"Continuous (fun T : ℝ => lowerRiemannLog T 1)"},{"kind":"theorem","name":"stripPoissonKernel_mul_abs_lowerRiemannLog_one_integrable","statement":"{σ : ℝ} (hzero : 0 ≤ σ) (habove : σ < 1) : Integrable (fun T : ℝ => stripPoissonKernel σ T * |lowerRiemannLog T 1|)"},{"kind":"theorem","name":"stripPoissonKernel_mul_abs_lowerRiemannLog_zero_integrable","statement":"{σ : ℝ} (hbelow : -1 < σ) (habove : σ < 1) : Integrable (fun T : ℝ => stripPoissonKernel σ T * |lowerRiemannLog T 0|)"},{"kind":"theorem","name":"stripPoissonKernel_mul_coth_log_integrable","statement":"{σ : ℝ} (hbelow : -1 < σ) (habove : σ < 1) : Integrable (fun T : ℝ => stripPoissonKernel σ T * Real.log (lowerCoth (Real.pi * |T| / 2)))"},{"kind":"theorem","name":"lowerRiemannErrorMajorant_poisson_integrable","statement":"{σ : ℝ} (hzero : 0 ≤ σ) (habove : σ < 1) : Integrable (fun T : ℝ => stripPoissonKernel σ T * lowerRiemannErrorMajorant T)"},{"kind":"theorem","name":"stripPoissonKernel_mul_lowerEndpointPhase_integrable","statement":"{σ : ℝ} (hzero : 0 ≤ σ) (habove : σ < 1) : Integrable (fun T : ℝ => stripPoissonKernel σ T * lowerEndpointPhase T)"},{"kind":"theorem","name":"integral_stripPoissonKernel_mul_lowerEndpointPhase","statement":"{σ : ℝ} (habove : σ < 1) : (∫ T : ℝ, stripPoissonKernel σ T * lowerEndpointPhase T) = stripBottomMass σ * lowerPoissonEndpointExpectation σ"},{"kind":"theorem","name":"lowerStripPoissonMajorant_dimension_central_bound","statement":"{d : ℕ} (hd : 2 ≤ d) {c σ : ℝ} (hc : 0 < c) (hzero : 0 ≤ σ) (habove : σ < 1) : lowerStripPoissonMajorant ((d : ℝ) / 2) (c * Real.sqrt d) σ 0 ≤ ((d : ℝ) / 2) * stripBottomMass σ * (Real.log (2 * Real.pi * Real.exp 1 * c ^ 2) + lowerPoissonEndpointExpectation σ) + lowerRiemannPoissonError σ"},{"kind":"theorem","name":"exists_lowerStripPoissonMajorant_uniform_negative","statement":"{c : ℝ} (hc : 0 < c) (hsharp : c < Real.pi⁻¹) : ∃ σ γ : ℝ, 0 < σ ∧ σ < 1 ∧ 0 < γ ∧ ∀ᶠ d : ℕ in atTop, ∀ s : ℝ, lowerStripPoissonMajorant ((d : ℝ) / 2) (c * Real.sqrt d) σ s ≤ -γ * ((d : ℝ) / 2)"},{"kind":"theorem","name":"lowerCoth_log_half_le_of_one_le_abs","statement":"{Y : ℝ} (hY : 1 ≤ |Y|) : (1 / 2 : ℝ) * Real.log (lowerCoth (Real.pi * |Y| / 2)) ≤ (1 / 2 : ℝ)"},{"kind":"theorem","name":"lowerGammaBoundaryLog_dimension_scaled_log_tail_simple","statement":"{d : ℕ} (hd : 2 ≤ d) {c Y : ℝ} (hc : 0 < c) (hY : 1 ≤ |Y|) : lowerGammaBoundaryLog ((d : ℝ) / 2) (c * Real.sqrt d) (((d : ℝ) / 2) * Y) ≤ ((d : ℝ) / 2) * Real.log (4 * Real.pi * Real.exp 1 * c ^ 2 / |Y|)"},{"kind":"theorem","name":"stripPoissonCoreMass_pos","statement":"{σ : ℝ} (hbelow : -1 < σ) (habove : σ < 1) : 0 < stripPoissonCoreMass σ"},{"kind":"theorem","name":"lowerGammaScaledPositivePart_poisson_exponential_tail","statement":"{d : ℕ} (hd : 2 ≤ d) {c σ C S : ℝ} (hc : 0 < c) (hσ : 0 ≤ σ) (hσone : σ < 1) (hC : 0 < C) (hsupport : Function.support (lowerGammaScaledPositivePart d c) ⊆ Icc (-C) C) (hmass : (∫ Y : ℝ, lowerGammaScaledPositivePart d c Y) ≤ C * ((d : ℝ) / 2)) (hS : C ≤ S) : (∫ Y : ℝ, stripPoissonKernel σ (S - Y) * lowerGammaScaledPositivePart d c Y) ≤ (stripBottomMass σ * (Real.pi / 2) * Real.exp (-(Real.pi / 2) * (S - C))) * (C * ((d : ℝ) / 2))"},{"kind":"theorem","name":"lowerStripPoissonMajorant_core_tail_split","statement":"{d : ℕ} (hd : 2 ≤ d) {c σ S : ℝ} (hc : 0 < c) (hσ : 0 ≤ σ) (hσone : σ < 1) (hS : 2 ≤ S) : lowerStripPoissonMajorant ((d : ℝ) / 2) (c * Real.sqrt d) σ (((d : ℝ) / 2) * S) ≤ (((d : ℝ) / 2) * Real.log ((8 * Real.pi * Real.exp 1 * c ^ 2) / S)) * stripPoissonCoreMass σ + ∫ Y : ℝ, stripPoissonKernel σ (S - Y) * lowerGammaScaledPositivePart d c Y"},{"kind":"theorem","name":"lowerStripPoissonMajorant_dimension_neg","statement":"{d : ℕ} (hd : 0 < d) (R σ s : ℝ) : lowerStripPoissonMajorant ((d : ℝ) / 2) R σ (-s) = lowerStripPoissonMajorant ((d : ℝ) / 2) R σ s"},{"kind":"theorem","name":"exists_lowerStripPoissonMajorant_positive_logarithmic_tail","statement":"{c σ : ℝ} (hc : 0 < c) (hσ : 0 ≤ σ) (hσone : σ < 1) : ∃ A B κ : ℝ, 0 < A ∧ 0 < B ∧ 0 < κ ∧ ∀ d : ℕ, 2 ≤ d → ∀ S : ℝ, B ≤ S → lowerStripPoissonMajorant ((d : ℝ) / 2) (c * Real.sqrt d) σ (((d : ℝ) / 2) * S) ≤ -κ * ((d : ℝ) / 2) * Real.log (S / A)"},{"kind":"theorem","name":"exists_lowerStripPoissonMajorant_logarithmic_tail","statement":"{c σ : ℝ} (hc : 0 < c) (hσ : 0 ≤ σ) (hσone : σ < 1) : ∃ A B κ : ℝ, 0 < A ∧ 0 < B ∧ 0 < κ ∧ ∀ d : ℕ, 2 ≤ d → ∀ S : ℝ, B ≤ |S| → lowerStripPoissonMajorant ((d : ℝ) / 2) (c * Real.sqrt d) σ (((d : ℝ) / 2) * S) ≤ -κ * ((d : ℝ) / 2) * Real.log (|S| / A)"},{"kind":"theorem","name":"inverseQuadraticAbs_integrable","statement":"Integrable (fun S : ℝ => 1 / (1 + |S|) ^ 2)"},{"kind":"theorem","name":"exists_lowerStripPoissonMajorant_integrable_majorant","statement":"{c : ℝ} (hc : 0 < c) (hsharp : c < Real.pi⁻¹) : ∃ σ γ C : ℝ, 0 < σ ∧ σ < 1 ∧ 0 < γ ∧ 0 < C ∧ ∀ᶠ d : ℕ in atTop, ∀ S : ℝ, Real.exp (lowerStripPoissonMajorant ((d : ℝ) / 2) (c * Real.sqrt d) σ (((d : ℝ) / 2) * S)) ≤ C * Real.exp (-γ * ((d : ℝ) / 2)) / (1 + |S|) ^ 2"},{"kind":"theorem","name":"antiFourierWitness_interiorMellinL1_le_of_integrable_majorant","statement":"{d : ℕ} (hd : 0 < d) {R σ γ C : ℝ} (hR : 0 < R) (hσbelow : -1 < σ) (hσabove : σ < 1) (w : AntiFourierWitness d R) (hpoint : ∀ s : ℝ, ‖normalizedRadialMellinStrip hd w.function R ((s : ℂ) + Complex.I * (((σ * ((d : ℝ) / 2) : ℝ) : ℂ)))‖ ≤ Real.exp (lowerStripPoissonMajorant ((d : ℝ) / 2) R σ s)) (hmajor : ∀ S : ℝ, Real.exp (lowerStripPoissonMajorant ((d : ℝ) / 2) R σ (((d : ℝ) / 2) * S)) ≤ C * Real.exp (-γ * ((d : ℝ) / 2)) / (1 + |S|) ^ 2) : (∫ s : ℝ, ‖normalizedRadialMellinStrip hd w.function R ((s : ℂ) + Complex.I * (((σ * ((d : ℝ) / 2) : ℝ) : ℂ)))‖) ≤ (C * lowerInverseQuadraticMass) * ((d : ℝ) / 2) * Real.exp (-γ * ((d : ℝ) / 2))"},{"kind":"theorem","name":"lowerStripCappedPoisson_tendsto","statement":"{d : ℕ} (hd : 0 < d) {c σ : ℝ} (hσbelow : -1 < σ) (hσabove : σ < 1) (s : ℝ) : Tendsto (fun n : ℕ => ∫ T : ℝ, stripPoissonKernel σ T * lowerGammaBoundaryCapped ((d : ℝ) / 2) (c * Real.sqrt d) (n : ℝ) (s - ((d : ℝ) / 2) * T)) atTop (𝓝 (lowerStripPoissonMajorant ((d : ℝ) / 2) (c * Real.sqrt d) σ s))"},{"kind":"theorem","name":"uniformAntiFourierSignRadius_of_poisson_majorization","statement":"(hpoisson : ∀ {d : ℕ} (hd : 0 < d) {R : ℝ} (_hR : 0 < R) (w : AntiFourierWitness d R) {σ : ℝ} (_hσbelow : -1 < σ) (_hσabove : σ < 1) (s : ℝ), ‖normalizedRadialMellinStrip hd w.function R ((s : ℂ) + Complex.I * (((σ * ((d : ℝ) / 2) : ℝ) : ℂ)))‖ ≤ Real.exp (lowerStripPoissonMajorant ((d : ℝ) / 2) R σ s)) : UniformAntiFourierSignRadius"},{"kind":"theorem","name":"lowerStripCappedPoisson_tendsto_radius","statement":"{d : ℕ} (hd : 0 < d) {R σ : ℝ} (hσbelow : -1 < σ) (hσabove : σ < 1) (s : ℝ) : Tendsto (fun n : ℕ => ∫ T : ℝ, stripPoissonKernel σ T * lowerGammaBoundaryCapped ((d : ℝ) / 2) R (n : ℝ) (s - ((d : ℝ) / 2) * T)) atTop (𝓝 (lowerStripPoissonMajorant ((d : ℝ) / 2) R σ s))"},{"kind":"theorem","name":"antiFourierWitness_norm_le_poisson_of_eventually_capped_radius","statement":"{d : ℕ} (hd : 0 < d) {R σ : ℝ} (w : AntiFourierWitness d R) (hσbelow : -1 < σ) (hσabove : σ < 1) (s : ℝ) (hcapped : ∀ᶠ n : ℕ in atTop, ‖normalizedRadialMellinStrip hd w.function R ((s : ℂ) + Complex.I * (((σ * ((d : ℝ) / 2) : ℝ) : ℂ)))‖ ≤ Real.exp (∫ T : ℝ, stripPoissonKernel σ T * lowerGammaBoundaryCapped ((d : ℝ) / 2) R (n : ℝ) (s - ((d : ℝ) / 2) * T))) : ‖normalizedRadialMellinStrip hd w.function R ((s : ℂ) + Complex.I * (((σ * ((d : ℝ) / 2) : ℝ) : ℂ)))‖ ≤ Real.exp (lowerStripPoissonMajorant ((d : ℝ) / 2) R σ s)"},{"kind":"theorem","name":"uniformAntiFourierSignRadius_of_capped_poisson_majorization","statement":"(hcap : ∀ {d : ℕ} (hd : 0 < d) {R : ℝ} (_hR : 0 < R) (w : AntiFourierWitness d R), ∃ D₀ : ℝ, ∀ D : ℝ, D₀ ≤ D → ∀ {σ : ℝ}, -1 < σ → σ < 1 → ∀ s : ℝ, ‖normalizedRadialMellinStrip hd w.function R ((s : ℂ) + Complex.I * (((σ * ((d : ℝ) / 2) : ℝ) : ℂ)))‖ ≤ Real.exp (∫ T : ℝ, stripPoissonKernel σ T * lowerGammaBoundaryCapped ((d : ℝ) / 2) R D (s - ((d : ℝ) / 2) * T))) : UniformAntiFourierSignRadius"},{"kind":"theorem","name":"uniformAntiFourierSignRadius","statement":"UniformAntiFourierSignRadius"},{"kind":"theorem","name":"continuous_quotientRootMap","statement":"(d : ℕ) : Continuous (quotientRootMap d)"},{"kind":"theorem","name":"monotoneOn_quotientRootMap","statement":"(d : ℕ) : MonotoneOn (quotientRootMap d) (quotientSet d)"},{"kind":"theorem","name":"normalizedCostRange_eq_quotientRootImage","statement":"(d : ℕ) : Set.range (normalizedCost (d"},{"kind":"theorem","name":"normalizedProgram_eq_quotientInf_root","statement":"(d : ℕ) (hadmissible : Nonempty (Admissible d)) : normalizedProgram d = quotientRootMap d (sInf (quotientSet d))"},{"kind":"theorem","name":"quotientInf_nonneg","statement":"(d : ℕ) (hadmissible : Nonempty (Admissible d)) : 0 ≤ sInf (quotientSet d)"},{"kind":"theorem","name":"linearProgram_root_eq_geometric_mul_normalizedProgram","statement":"{d : ℕ} (hd : 0 < d) (hadmissible : Nonempty (Admissible d)) : (linearProgram d) ^ ((d : ℝ)⁻¹) = packingGeometricRoot d * normalizedProgram d"},{"kind":"theorem","name":"unitBallVolume_odd","statement":"(k : ℕ) : unitBallVolume (2 * k + 1) = Real.pi ^ k * 2 ^ (k + 1) / ((2 * k + 1)‼ : ℝ)"},{"kind":"theorem","name":"oddDoubleFactorial_mul_two_pow_factorial","statement":"(k : ℕ) : ((2 * k + 1)‼ : ℝ) * (2 : ℝ) ^ k * (k.factorial : ℝ) = ((2 * k + 1).factorial : ℝ)"},{"kind":"theorem","name":"unitBallVolume_odd_factorial","statement":"(k : ℕ) : unitBallVolume (2 * k + 1) = Real.pi ^ k * (2 : ℝ) ^ (2 * k + 1) * (k.factorial : ℝ) / ((2 * k + 1).factorial : ℝ)"},{"kind":"theorem","name":"tendsto_factorialStirlingSequence","statement":"Tendsto Stirling.stirlingSeq atTop (nhds (Real.sqrt Real.pi))"},{"kind":"theorem","name":"tendsto_log_factorialStirlingSequence","statement":"Tendsto (fun k : ℕ => Real.log (Stirling.stirlingSeq k)) atTop (nhds (Real.log (Real.sqrt Real.pi)))"},{"kind":"theorem","name":"tendsto_log_nat_div_nat","statement":"Tendsto (fun k : ℕ => Real.log (k : ℝ) / (k : ℝ)) atTop (nhds 0)"},{"kind":"theorem","name":"tendsto_log_factorialStirlingSequence_div_nat","statement":"Tendsto (fun k : ℕ => Real.log (Stirling.stirlingSeq k) / (k : ℝ)) atTop (nhds 0)"},{"kind":"theorem","name":"tendsto_log_two_mul_nat_div_nat","statement":"Tendsto (fun k : ℕ => Real.log ((2 : ℝ) * (k : ℝ)) / (k : ℝ)) atTop (nhds 0)"},{"kind":"theorem","name":"tendsto_log_factorial_div_nat_sub_log_nat","statement":"Tendsto (fun k : ℕ => Real.log (k.factorial : ℝ) / (k : ℝ) - Real.log (k : ℝ)) atTop (nhds (-1))"},{"kind":"theorem","name":"tendsto_oddDimension_atTop","statement":"Tendsto (fun k : ℕ => 2 * k + 1) atTop atTop"},{"kind":"theorem","name":"tendsto_log_nat_div_oddDimension","statement":"Tendsto (fun k : ℕ => Real.log (k : ℝ) / (2 * (k : ℝ) + 1)) atTop (nhds 0)"},{"kind":"theorem","name":"tendsto_log_nat_sub_log_oddDimension","statement":"Tendsto (fun k : ℕ => Real.log (k : ℝ) - Real.log (2 * (k : ℝ) + 1)) atTop (nhds (Real.log (1 / 2 : ℝ)))"},{"kind":"theorem","name":"normalizedVolumeLog_odd_eq","statement":"(k : ℕ) (hk : 0 < k) : normalizedVolumeLog (2 * k + 1) = (k : ℝ) / (2 * (k : ℝ) + 1) * Real.log Real.pi + Real.log 2 + ((k : ℝ) / (2 * (k : ℝ) + 1)) * (Real.log (k.factorial : ℝ) / (k : ℝ) - Real.log (k : ℝ)) - (Real.log ((2 * k + 1).factorial : ℝ) / (2 * (k : ℝ) + 1) - Real.log (2 * (k : ℝ) + 1)) + ((k : ℝ) / (2 * (k : ℝ) + 1) - (1 / 2 : ℝ)) * Real.log (k : ℝ) + (1 / 2 : ℝ) * (Real.log (k : ℝ) - Real.log (2 * (k : ℝ) + 1))"},{"kind":"theorem","name":"tendsto_normalizedVolumeLog_even","statement":"Tendsto (fun k : ℕ => normalizedVolumeLog (2 * k)) atTop (nhds ((Real.log (2 * Real.pi) + 1) / 2))"},{"kind":"theorem","name":"tendsto_odd_halfDimension_log_correction","statement":"Tendsto (fun k : ℕ => ((k : ℝ) / (2 * (k : ℝ) + 1) - (1 / 2 : ℝ)) * Real.log (k : ℝ)) atTop (nhds 0)"},{"kind":"theorem","name":"tendsto_log_oddFactorial_div_oddDimension_sub_log","statement":"Tendsto (fun k : ℕ => Real.log ((2 * k + 1).factorial : ℝ) / (2 * (k : ℝ) + 1) - Real.log (2 * (k : ℝ) + 1)) atTop (nhds (-1))"},{"kind":"theorem","name":"tendsto_normalizedVolumeLog_odd","statement":"Tendsto (fun k : ℕ => normalizedVolumeLog (2 * k + 1)) atTop (nhds ((Real.log (2 * Real.pi) + 1) / 2))"},{"kind":"theorem","name":"tendsto_of_even_and_odd","statement":"{X : Type*} [TopologicalSpace X] {f : ℕ → X} {x : X} (heven : Tendsto (fun k : ℕ => f (2 * k)) atTop (nhds x)) (hodd : Tendsto (fun k : ℕ => f (2 * k + 1)) atTop (nhds x)) : Tendsto f atTop (nhds x)"},{"kind":"theorem","name":"tendsto_normalizedVolumeLog","statement":"Tendsto normalizedVolumeLog atTop (nhds ((Real.log (2 * Real.pi) + 1) / 2))"},{"kind":"theorem","name":"normalizedVolumeRoot_pos","statement":"{d : ℕ} (hd : 0 < d) : 0 < normalizedVolumeRoot d"},{"kind":"theorem","name":"log_normalizedVolumeRoot","statement":"{d : ℕ} (hd : 0 < d) : Real.log (normalizedVolumeRoot d) = normalizedVolumeLog d"},{"kind":"theorem","name":"exp_normalizedVolumeLog_limit","statement":"Real.exp ((Real.log (2 * Real.pi) + 1) / 2) = Real.sqrt (2 * Real.pi * Real.exp 1)"},{"kind":"theorem","name":"tendsto_normalizedVolumeRoot","statement":"Tendsto normalizedVolumeRoot atTop (nhds (Real.sqrt (2 * Real.pi * Real.exp 1)))"},{"kind":"theorem","name":"rpow_two_pow_inv_dimension","statement":"{d : ℕ} (hd : 0 < d) : ((2 : ℝ) ^ d) ^ ((d : ℝ)⁻¹) = 2"},{"kind":"theorem","name":"packingGeometricRoot_eq_normalizedVolumeRoot_div_two","statement":"{d : ℕ} (hd : 0 < d) : packingGeometricRoot d = normalizedVolumeRoot d / 2"},{"kind":"theorem","name":"tendsto_packingGeometricRoot","statement":"Tendsto packingGeometricRoot atTop (nhds (Real.sqrt (2 * Real.pi * Real.exp 1) / 2))"},{"kind":"theorem","name":"radialFlatBumpReal_nonneg","statement":"(d : ℕ) (x : Euclidean d) : 0 ≤ radialFlatBumpReal d x"},{"kind":"theorem","name":"radialFlatBumpReal_zero_pos","statement":"(d : ℕ) : 0 < radialFlatBumpReal d (0 : Euclidean d)"},{"kind":"theorem","name":"support_radialFlatBumpReal","statement":"(d : ℕ) : Function.support (radialFlatBumpReal d) = Metric.ball (0 : Euclidean d) (1 / 2 : ℝ)"},{"kind":"theorem","name":"support_radialFlatBumpFun","statement":"(d : ℕ) : Function.support (radialFlatBumpFun d) = Metric.ball (0 : Euclidean d) (1 / 2 : ℝ)"},{"kind":"theorem","name":"radialFlatBumpFun_contDiff","statement":"(d : ℕ) : ContDiff ℝ ∞ (radialFlatBumpFun d)"},{"kind":"theorem","name":"radialFlatBumpFun_hasCompactSupport","statement":"(d : ℕ) : HasCompactSupport (radialFlatBumpFun d)"},{"kind":"theorem","name":"radialFlatBump_real","statement":"(d : ℕ) : IsRealValued (radialFlatBump d)"},{"kind":"theorem","name":"radialFlatBump_radial","statement":"(d : ℕ) : IsRadial (radialFlatBump d)"},{"kind":"theorem","name":"integral_radialFlatBumpReal_pos","statement":"(d : ℕ) : 0 < ∫ x : Euclidean d, radialFlatBumpReal d x"},{"kind":"theorem","name":"IsRadial.fourier","statement":"{d : ℕ} {f : TestFunction d} (hf : IsRadial f) : IsRadial (𝓕 f : TestFunction d)"},{"kind":"theorem","name":"fourier_conj_apply_of_real","statement":"{d : ℕ} (f : TestFunction d) (hf : IsRealValued f) (ξ : Euclidean d) : starRingEnd ℂ ((𝓕 f : TestFunction d) ξ) = ((𝓕 f : TestFunction d) (-ξ))"},{"kind":"theorem","name":"IsRealValued.fourier_of_radial","statement":"{d : ℕ} {f : TestFunction d} (hf : IsRealValued f) (hrad : IsRadial f) : IsRealValued (𝓕 f : TestFunction d)"},{"kind":"theorem","name":"fourier_radialAutocorrelation_apply","statement":"(d : ℕ) (ξ : Euclidean d) : ((𝓕 (radialAutocorrelation d) : TestFunction d) ξ) = ((𝓕 (radialFlatBump d) : TestFunction d) ξ) ^ 2"},{"kind":"theorem","name":"fourier_radialFlatBump_real","statement":"(d : ℕ) : IsRealValued (𝓕 (radialFlatBump d) : TestFunction d)"},{"kind":"theorem","name":"fourier_radialAutocorrelation_real","statement":"(d : ℕ) : IsRealValued (𝓕 (radialAutocorrelation d) : TestFunction d)"},{"kind":"theorem","name":"fourier_radialAutocorrelation_nonneg","statement":"(d : ℕ) (ξ : Euclidean d) : 0 ≤ ((𝓕 (radialAutocorrelation d) : TestFunction d) ξ).re"},{"kind":"theorem","name":"fourier_radialFlatBump_zero","statement":"(d : ℕ) : ((𝓕 (radialFlatBump d) : TestFunction d) (0 : Euclidean d)) = (↑(∫ x : Euclidean d, radialFlatBumpReal d x) : ℂ)"},{"kind":"theorem","name":"fourier_radialAutocorrelation_zero_pos","statement":"(d : ℕ) : 0 < ((𝓕 (radialAutocorrelation d) : TestFunction d) (0 : Euclidean d)).re"},{"kind":"theorem","name":"support_radialFlatBump","statement":"(d : ℕ) : Function.support (radialFlatBump d : Euclidean d → ℂ) = Metric.ball (0 : Euclidean d) (1 / 2 : ℝ)"},{"kind":"theorem","name":"support_radialAutocorrelation_subset","statement":"(d : ℕ) : Function.support (radialAutocorrelation d : Euclidean d → ℂ) ⊆ Metric.ball (0 : Euclidean d) (1 : ℝ)"},{"kind":"theorem","name":"radialAutocorrelation_outside_eq_zero","statement":"(d : ℕ) (x : Euclidean d) (hx : 1 ≤ ‖x‖) : radialAutocorrelation d x = 0"},{"kind":"theorem","name":"radialAutocorrelation_real","statement":"(d : ℕ) : IsRealValued (radialAutocorrelation d)"},{"kind":"theorem","name":"fourier_radialAutocorrelation_radial","statement":"(d : ℕ) : IsRadial (𝓕 (radialAutocorrelation d) : TestFunction d)"},{"kind":"theorem","name":"radialAutocorrelation_radial","statement":"(d : ℕ) : IsRadial (radialAutocorrelation d)"},{"kind":"theorem","name":"admissible_nonempty","statement":"(d : ℕ) : Nonempty (Admissible d)"},{"kind":"theorem","name":"quotientSet_nonempty","statement":"(d : ℕ) : (quotientSet d).Nonempty"},{"kind":"theorem","name":"log_criticalPackingBase","statement":"Real.log criticalPackingBase = (1 / 2 : ℝ) * Real.log (Real.exp 1 / (2 * Real.pi))"},{"kind":"theorem","name":"logb_criticalPackingBase","statement":"Real.logb 2 criticalPackingBase = -criticalBinaryExponent"},{"kind":"theorem","name":"criticalPackingBase_lt_one","statement":"criticalPackingBase < 1"},{"kind":"theorem","name":"criticalBinaryExponent_pos","statement":"0 < criticalBinaryExponent"},{"kind":"theorem","name":"uniformAdmissibleLowerBound_of_signRadius","statement":"(hsign : UniformAntiFourierSignRadius) : UniformAdmissibleLowerBound"},{"kind":"theorem","name":"normalizedProgram_eq_quotientInf_root_unconditional","statement":"(d : ℕ) : normalizedProgram d = quotientRootMap d (sInf (quotientSet d))"},{"kind":"theorem","name":"quotientInf_nonneg_unconditional","statement":"(d : ℕ) : 0 ≤ sInf (quotientSet d)"},{"kind":"theorem","name":"linearProgram_nonneg","statement":"(d : ℕ) : 0 ≤ linearProgram d"},{"kind":"theorem","name":"linearProgram_root_eq_geometric_mul_normalizedProgram_unconditional","statement":"{d : ℕ} (hd : 0 < d) : (linearProgram d) ^ ((d : ℝ)⁻¹) = packingGeometricRoot d * normalizedProgram d"},{"kind":"theorem","name":"geometricLimit_mul_criticalRadius","statement":"(Real.sqrt (2 * Real.pi * Real.exp 1) / 2) * criticalRadius = criticalPackingBase"},{"kind":"theorem","name":"sharpPackingRoot_of_sharpQuotient","statement":"(hquotient : SharpQuotientAsymptotic) : SharpPackingRootAsymptotic"},{"kind":"theorem","name":"eventually_linearProgram_pos_of_sharpQuotient","statement":"(hquotient : SharpQuotientAsymptotic) : ∀ᶠ d : ℕ in atTop, 0 < linearProgram d"},{"kind":"theorem","name":"sharpLog_of_sharpQuotient","statement":"(hquotient : SharpQuotientAsymptotic) : SharpLogAsymptotic"},{"kind":"theorem","name":"sharpBinaryLog_of_sharpQuotient","statement":"(hquotient : SharpQuotientAsymptotic) : SharpBinaryLogAsymptotic"},{"kind":"theorem","name":"sharpAsymptotics_of_uniform_lower_and_ordered_upper","statement":"(hlower : UniformAdmissibleLowerBound) (construction : OrderedEpsilonUpperConstruction) : SharpQuotientAsymptotic ∧ SharpPackingRootAsymptotic ∧ SharpLogAsymptotic ∧ SharpBinaryLogAsymptotic"},{"kind":"theorem","name":"sharpAsymptotics_of_signRadius_and_ordered_upper","statement":"(hsign : UniformAntiFourierSignRadius) (construction : OrderedEpsilonUpperConstruction) : SharpQuotientAsymptotic ∧ SharpPackingRootAsymptotic ∧ SharpLogAsymptotic ∧ SharpBinaryLogAsymptotic"},{"kind":"theorem","name":"saddleSourceSchwartzRealization","statement":"SaddleSourceSchwartzRealization"},{"kind":"theorem","name":"sharpAsymptotics_of_saddleSourceEventualSigns","statement":"(hsigns : SaddleSourceEventualSigns) : SharpQuotientAsymptotic ∧ SharpPackingRootAsymptotic ∧ SharpLogAsymptotic ∧ SharpBinaryLogAsymptotic"},{"kind":"theorem","name":"eventually_plusSaddleProfile_nonneg_on_star","statement":"∀ᶠ ε : ℝ in 𝓝[>] (0 : ℝ), ∀ᶠ d : ℕ in atTop, ∀ r : ℝ, 0 ≤ r → r ≤ saddleSmallRadiusStar ε d → 0 ≤ (plusSaddleProfile ε ((d : ℝ) / 2) r).re"},{"kind":"theorem","name":"plusSaddleProfile_re_pos_at_sourceSaddle_of_gaussian_error","statement":"{ε : ℝ} {d : ℕ} {u : ℝ} (hε : 0 < ε) (hd : 0 < d) (hu : -1 < u) (horder : shortCutoff ε ≤ shortEndpoint ε) (hV : 0 < saddleSourceGaussianVariance ε ((d : ℝ) / 2) u) (herror : ‖(∫ T : ℝ, saddleSourceCenteredPlusIntegrand ε ((d : ℝ) / 2) u (saddleLogRadius ε d u) T) - (∫ T : ℝ, saddleSourceGaussianPlusIntegrand ε ((d : ℝ) / 2) u T)‖ < (∫ T : ℝ, saddleSourceGaussianPlusIntegrand ε ((d : ℝ) / 2) u T).re) : 0 < (plusSaddleProfile ε ((d : ℝ) / 2) (Real.exp (saddleLogRadius ε d u))).re"},{"kind":"theorem","name":"minusSaddleProfile_re_neg_at_sourceSaddle_of_gaussian_error","statement":"{ε : ℝ} {d : ℕ} {u : ℝ} (hε : 0 < ε) (hd : 0 < d) (hu : -1 < u) (horder : shortCutoff ε ≤ shortEndpoint ε) (hV : 0 < saddleSourceGaussianVariance ε ((d : ℝ) / 2) u) (herror : ‖(∫ T : ℝ, saddleSourceCenteredMinusIntegrand ε ((d : ℝ) / 2) u (saddleLogRadius ε d u) T) - (∫ T : ℝ, saddleSourceGaussianMinusIntegrand ε ((d : ℝ) / 2) u T)‖ < -(∫ T : ℝ, saddleSourceGaussianMinusIntegrand ε ((d : ℝ) / 2) u T).re) : (minusSaddleProfile ε ((d : ℝ) / 2) (Real.exp (saddleLogRadius ε d u))).re < 0"},{"kind":"theorem","name":"saddleSourceGaussianPlusIntegrand_integral_re_eq_norm","statement":"{ε ℓ u : ℝ} (hε : 0 < ε) (hu : -1 < u) : (∫ T : ℝ, saddleSourceGaussianPlusIntegrand ε ℓ u T).re = ‖plusPolynomial ε (Complex.I * (u : ℂ))‖ * (∫ T : ℝ, saddleSourceGaussianKernel ε ℓ u T)"},{"kind":"theorem","name":"saddleSourceGaussianMinusIntegrand_neg_integral_re_eq_norm","statement":"{ε ℓ u : ℝ} (hε : 0 < ε) (hu : 1 + ε / 4 ≤ u) : -(∫ T : ℝ, saddleSourceGaussianMinusIntegrand ε ℓ u T).re = ‖minusPolynomial ε (Complex.I * (u : ℂ))‖ * (∫ T : ℝ, saddleSourceGaussianKernel ε ℓ u T)"},{"kind":"theorem","name":"saddleSmallRadiusStarOrdinate_sourceScale","statement":"{d : ℕ} (hd : 0 < d) (ε : ℝ) {u : ℝ} (hu : saddleSmallRadiusStarOrdinate ε d ≤ u) : Real.log ((d : ℝ) / 2) / 4 ≤ ((d : ℝ) / 2) * (1 + u)"},{"kind":"theorem","name":"saddleSource_positiveOrdinate_sourceScale","statement":"{ℓ u : ℝ} (hℓ : 0 < ℓ) (hu : 1 ≤ u) : Real.log ℓ / 4 ≤ ℓ * (1 + u)"},{"kind":"theorem","name":"eventually_plusSaddleProfile_re_pos_at_firstBranchSaddles","statement":"∀ᶠ ε : ℝ in 𝓝[>] (0 : ℝ), ∀ᶠ d : ℕ in atTop, ∀ u : ℝ, saddleSmallRadiusStarOrdinate ε d ≤ u → u ≤ 1 + ε / 2 → 0 < (plusSaddleProfile ε ((d : ℝ) / 2) (Real.exp (saddleLogRadius ε d u))).re"},{"kind":"theorem","name":"eventually_minusSaddleProfile_re_neg_at_firstBranchSaddles","statement":"∀ᶠ ε : ℝ in 𝓝[>] (0 : ℝ), ∀ᶠ d : ℕ in atTop, ∀ u : ℝ, 1 + ε / 4 ≤ u → u ≤ 1 + ε / 2 → (minusSaddleProfile ε ((d : ℝ) / 2) (Real.exp (saddleLogRadius ε d u))).re < 0"},{"kind":"theorem","name":"eventually_plusSaddleProfile_re_pos_at_secondBranchSaddles","statement":"∀ᶠ ε : ℝ in 𝓝[>] (0 : ℝ), ∀ᶠ d : ℕ in atTop, ∀ u : ℝ, 1 + ε / 2 ≤ u → 0 < (plusSaddleProfile ε ((d : ℝ) / 2) (Real.exp (saddleLogRadius ε d u))).re"},{"kind":"theorem","name":"eventually_minusSaddleProfile_re_neg_at_secondBranchSaddles","statement":"∀ᶠ ε : ℝ in 𝓝[>] (0 : ℝ), ∀ᶠ d : ℕ in atTop, ∀ u : ℝ, 1 + ε / 2 ≤ u → (minusSaddleProfile ε ((d : ℝ) / 2) (Real.exp (saddleLogRadius ε d u))).re < 0"},{"kind":"theorem","name":"eventually_plusSaddleProfile_nonneg_of_star","statement":"∀ᶠ ε : ℝ in 𝓝[>] (0 : ℝ), ∀ᶠ d : ℕ in atTop, ∀ r : ℝ, saddleSmallRadiusStar ε d ≤ r → 0 ≤ (plusSaddleProfile ε ((d : ℝ) / 2) r).re"},{"kind":"theorem","name":"eventually_minusSaddleProfile_nonpos_of_sourceRadius","statement":"∀ᶠ ε : ℝ in 𝓝[>] (0 : ℝ), ∀ᶠ d : ℕ in atTop, ∀ r : ℝ, saddleSourceRadius ε d ≤ r → (minusSaddleProfile ε ((d : ℝ) / 2) r).re ≤ 0"},{"kind":"theorem","name":"saddleSourceEventualSigns","statement":"SaddleSourceEventualSigns"},{"kind":"theorem","name":"sharpAsymptotics","statement":"SharpQuotientAsymptotic ∧ SharpPackingRootAsymptotic ∧ SharpLogAsymptotic ∧ SharpBinaryLogAsymptotic"},{"kind":"theorem","name":"sharpQuotientAsymptotic","statement":"SharpQuotientAsymptotic"},{"kind":"theorem","name":"sharpPackingRootAsymptotic","statement":"SharpPackingRootAsymptotic"},{"kind":"theorem","name":"sharpLogAsymptotic","statement":"SharpLogAsymptotic"},{"kind":"theorem","name":"sharpBinaryLogAsymptotic","statement":"SharpBinaryLogAsymptotic"},{"kind":"theorem","name":"manuscriptQuotientRootSet_eq_image","statement":"(d : ℕ) : manuscriptQuotientRootSet d = (fun x : ℝ => x ^ ((d : ℝ)⁻¹)) '' quotientSet d"},{"kind":"theorem","name":"manuscriptQuotientRootInf_eq","statement":"(d : ℕ) : sInf (manuscriptQuotientRootSet d) = (sInf (quotientSet d)) ^ ((d : ℝ)⁻¹)"},{"kind":"theorem","name":"manuscriptNormalizedQuotientInfRoot_eq","statement":"(d : ℕ) : manuscriptNormalizedQuotientInfRoot d = normalizedProgram d"},{"kind":"theorem","name":"manuscriptQuotientRootInf_div_sqrt_eq","statement":"(d : ℕ) : sInf (manuscriptQuotientRootSet d) / Real.sqrt (d : ℝ) = normalizedProgram d"},{"kind":"theorem","name":"manuscriptQuotientRootInf_div_sqrt_tendsto","statement":"(hquotient : SharpQuotientAsymptotic) : Tendsto (fun d : ℕ => sInf (manuscriptQuotientRootSet d) / Real.sqrt (d : ℝ)) atTop (nhds ((Real.pi)⁻¹))"},{"kind":"theorem","name":"manuscriptPackingDeficit_nonneg","statement":"(d : ℕ) : 0 ≤ manuscriptPackingDeficit d"},{"kind":"theorem","name":"manuscriptPackingDeficit_le_criticalPackingBase","statement":"(d : ℕ) : manuscriptPackingDeficit d ≤ criticalPackingBase"},{"kind":"theorem","name":"tendsto_manuscriptPackingDeficit","statement":"(hpacking : SharpPackingRootAsymptotic) : Tendsto manuscriptPackingDeficit atTop (nhds (0 : ℝ))"},{"kind":"theorem","name":"manuscriptPackingRoot_sub_deficit_le","statement":"(d : ℕ) : criticalPackingBase - manuscriptPackingDeficit d ≤ (linearProgram d) ^ ((d : ℝ)⁻¹)"},{"kind":"theorem","name":"manuscriptPackingRoot_sub_deficit_pow_le","statement":"{d : ℕ} (hd : 0 < d) : (criticalPackingBase - manuscriptPackingDeficit d) ^ d ≤ linearProgram d"},{"kind":"theorem","name":"linearProgram_le_geometric_mul_quotient","statement":"{d : ℕ} (f : Admissible d) : linearProgram d ≤ (unitBallVolume d / (2 : ℝ) ^ d) * quotient f"},{"kind":"theorem","name":"manuscriptUniversalQuotientBound","statement":"{d : ℕ} (hd : 0 < d) (f : Admissible d) : (2 : ℝ) ^ d / unitBallVolume d * (criticalPackingBase - manuscriptPackingDeficit d) ^ d ≤ quotient f"},{"kind":"theorem","name":"tendsto_manuscriptPackingRootError","statement":"(hpacking : SharpPackingRootAsymptotic) : Tendsto manuscriptPackingRootError atTop (nhds (0 : ℝ))"},{"kind":"theorem","name":"manuscriptLinearProgram_eq_packing_error_pow","statement":"{d : ℕ} (hd : 0 < d) : linearProgram d = (criticalPackingBase + manuscriptPackingRootError d) ^ d"},{"kind":"theorem","name":"tendsto_manuscriptBinaryExponentError","statement":"(hbinary : SharpBinaryLogAsymptotic) : Tendsto manuscriptBinaryExponentError atTop (nhds (0 : ℝ))"},{"kind":"theorem","name":"manuscriptLinearProgram_eq_binary_error_rpow","statement":"{d : ℕ} (hd : 0 < d) (hpositive : 0 < linearProgram d) : linearProgram d = (2 : ℝ) ^ (-(criticalBinaryExponent + manuscriptBinaryExponentError d) * (d : ℝ))"},{"kind":"theorem","name":"tendsto_manuscriptQuotientRootError","statement":"Tendsto manuscriptQuotientRootError atTop (nhds (0 : ℝ))"},{"kind":"theorem","name":"manuscriptQuotientRootError_isLittleO","statement":"Asymptotics.IsLittleO atTop manuscriptQuotientRootError (fun _ : ℕ => (1 : ℝ))"},{"kind":"theorem","name":"manuscriptQuotientRootInf_eq_critical_add_error","statement":"{d : ℕ} (hd : 0 < d) : sInf (manuscriptQuotientRootSet d) = ((Real.pi)⁻¹ + manuscriptQuotientRootError d) * Real.sqrt (d : ℝ)"},{"kind":"theorem","name":"exists_manuscriptQuotientRootIsLittleO","statement":"∃ e : ℕ → ℝ, Asymptotics.IsLittleO atTop e (fun _ : ℕ => (1 : ℝ)) ∧ ∀ d : ℕ, 0 < d → sInf (manuscriptQuotientRootSet d) = ((Real.pi)⁻¹ + e d) * Real.sqrt (d : ℝ)"},{"kind":"theorem","name":"manuscriptPackingRootError_tendsto","statement":"Tendsto manuscriptPackingRootError atTop (nhds (0 : ℝ))"},{"kind":"theorem","name":"manuscriptPackingRootError_isLittleO","statement":"Asymptotics.IsLittleO atTop manuscriptPackingRootError (fun _ : ℕ => (1 : ℝ))"},{"kind":"theorem","name":"manuscriptLinearProgram_eq_canonicalPackingPow","statement":"{d : ℕ} (hd : 0 < d) : linearProgram d = (criticalPackingBase + manuscriptPackingRootError d) ^ d"},{"kind":"theorem","name":"exists_manuscriptPackingIsLittleO","statement":"∃ e : ℕ → ℝ, Asymptotics.IsLittleO atTop e (fun _ : ℕ => (1 : ℝ)) ∧ ∀ d : ℕ, 0 < d → linearProgram d = (criticalPackingBase + e d) ^ d"},{"kind":"theorem","name":"manuscriptPackingDeficit_isLittleO","statement":"Asymptotics.IsLittleO atTop manuscriptPackingDeficit (fun _ : ℕ => (1 : ℝ))"},{"kind":"theorem","name":"exists_manuscriptUniversalPackingIsLittleO","statement":"∃ δ : ℕ → ℝ, Asymptotics.IsLittleO atTop δ (fun _ : ℕ => (1 : ℝ)) ∧ (∀ d : ℕ, 0 ≤ δ d) ∧ (∀ d : ℕ, 0 < d → ∀ f : Admissible d, (2 : ℝ) ^ d / unitBallVolume d * (criticalPackingBase - δ d) ^ d ≤ quotient f)"},{"kind":"theorem","name":"manuscriptBinaryExponentError_tendsto","statement":"Tendsto manuscriptBinaryExponentError atTop (nhds (0 : ℝ))"},{"kind":"theorem","name":"manuscriptBinaryExponentError_isLittleO","statement":"Asymptotics.IsLittleO atTop manuscriptBinaryExponentError (fun _ : ℕ => (1 : ℝ))"},{"kind":"theorem","name":"eventually_manuscriptLinearProgram_pos","statement":"∀ᶠ d : ℕ in atTop, 0 < linearProgram d"},{"kind":"theorem","name":"manuscriptLinearProgram_eq_canonicalBinaryRpow","statement":"{d : ℕ} (hd : 0 < d) (hpositive : 0 < linearProgram d) : linearProgram d = (2 : ℝ) ^ (-(criticalBinaryExponent + manuscriptBinaryExponentError d) * (d : ℝ))"},{"kind":"theorem","name":"eventually_manuscriptLinearProgram_eq_canonicalBinaryRpow","statement":"∀ᶠ d : ℕ in atTop, linearProgram d = (2 : ℝ) ^ (-(criticalBinaryExponent + manuscriptBinaryExponentError d) * (d : ℝ))"},{"kind":"theorem","name":"exists_manuscriptBinaryIsLittleO","statement":"∃ e : ℕ → ℝ, Asymptotics.IsLittleO atTop e (fun _ : ℕ => (1 : ℝ)) ∧ ∀ᶠ d : ℕ in atTop, linearProgram d = (2 : ℝ) ^ (-(criticalBinaryExponent + e d) * (d : ℝ))"},{"kind":"theorem","name":"EuclideanSpace.euclidean_ball_volume_positive","statement":"[Nonempty ι] (x : EuclideanSpace ℝ ι) (hr : 0 < r) : 0 < volume (ball x r)"},{"kind":"theorem","name":"EuclideanSpace.euclidean_ball_volume_finite","statement":"[NullSingletonClass (volume : Measure (EuclideanSpace ℝ ι))] (x : EuclideanSpace ℝ ι) : volume (ball x r) < ⊤"},{"kind":"theorem","name":"SpherePacking.distinct_centers_separation_bound","statement":"(S : SpherePacking d) (x y : EuclideanSpace ℝ (Fin d)) (hx : x ∈ S.centers) (hy : y ∈ S.centers) (hxy : x ≠ y) : S.separation ≤ dist x y"},{"kind":"theorem","name":"PeriodicSpherePacking.integral_basis_spans_packing_lattice","statement":"(S : PeriodicSpherePacking d) {ι : Type*} (b : Basis ι ℤ S.lattice) : Submodule.span ℤ (Set.range (b.ofZLatticeBasis ℝ _)) = S.lattice"},{"kind":"theorem","name":"PeriodicSpherePacking.mem_integral_basis_span_iff","statement":"(S : PeriodicSpherePacking d) {ι : Type*} (b : Basis ι ℤ S.lattice) (v) : v ∈ Submodule.span ℤ (Set.range (b.ofZLatticeBasis ℝ _)) ↔ v ∈ S.lattice"},{"kind":"lemma","name":"SpherePacking.rescale_occupied_region","statement":"{S : SpherePacking d} {c : ℝ} (hc : 0 < c) : (S.rescaleConfiguration hc).occupiedBallRegion = c • S.occupiedBallRegion"},{"kind":"lemma","name":"local_density_le_one","statement":"{d : ℕ} (S : SpherePacking d) (R : ℝ) : S.densityInsideRadius R ≤ 1"},{"kind":"lemma","name":"upper_packing_density_le_one","statement":"{d : ℕ} (S : SpherePacking d) : S.upperPackingDensity ≤ 1"},{"kind":"lemma","name":"rescale_local_packing_density","statement":"{d : ℕ} (S : SpherePacking d) {c : ℝ} (hc : 0 < c) (R : ℝ) : (S.rescaleConfiguration hc).densityInsideRadius (c * R) = S.densityInsideRadius R"},{"kind":"lemma","name":"rescale_local_packing_density_radius","statement":"{d : ℕ} (S : SpherePacking d) {c : ℝ} (hc : 0 < c) (R : ℝ) : (S.rescaleConfiguration hc).densityInsideRadius R = S.densityInsideRadius (R / c)"},{"kind":"lemma","name":"rescale_upper_packing_density","statement":"{d : ℕ} (S : SpherePacking d) {c : ℝ} (hc : 0 < c) : (S.rescaleConfiguration hc).upperPackingDensity = S.upperPackingDensity"},{"kind":"theorem","name":"packing_supremum_eq_unit_separation","statement":"{d : ℕ} : SpherePackingConstant d = ⨆ (S : SpherePacking d) (_ : S.separation = 1), S.upperPackingDensity"},{"kind":"lemma","name":"nearby_ball_union_subset_clipped_union","statement":"(X : Set (EuclideanSpace ℝ (Fin d))) (r R : ℝ) : ⋃ x ∈ X ∩ ball 0 R, ball x r ⊆ (⋃ x ∈ X, ball x r) ∩ ball 0 (R + r)"},{"kind":"lemma","name":"clipped_ball_union_subset_nearby_union","statement":"(X : Set (EuclideanSpace ℝ (Fin d))) (r R : ℝ) : (⋃ x ∈ X, ball x r) ∩ ball 0 (R - r) ⊆ ⋃ x ∈ X ∩ ball 0 R, ball x r"},{"kind":"theorem","name":"SpherePacking.volume_center_ball_union_eq_tsum","statement":"(R : ℝ) {r' : ℝ} (hr' : r' ≤ S.separation / 2) : volume (⋃ x : ↑(S.centers ∩ ball 0 R), ball (x : EuclideanSpace ℝ (Fin d)) r') = ∑' x : ↑(S.centers ∩ ball 0 R), volume (ball (x : EuclideanSpace ℝ (Fin d)) r')"},{"kind":"theorem","name":"SpherePacking.center_count_in_ball_upper_bound","statement":"(hd : 0 < d) (R : ℝ) : (S.centers ∩ ball 0 R).encard ≤ volume (S.occupiedBallRegion ∩ ball 0 (R + S.separation / 2)) / volume (ball (0 : EuclideanSpace ℝ (Fin d)) (S.separation / 2))"},{"kind":"theorem","name":"SpherePacking.center_count_in_ball_lower_bound","statement":"(R : ℝ) : (S.centers ∩ ball 0 R).encard ≥ volume (S.occupiedBallRegion ∩ ball 0 (R - S.separation / 2)) / volume (ball (0 : EuclideanSpace ℝ (Fin d)) (S.separation / 2))"},{"kind":"theorem","name":"SpherePacking.finite_centers_inside_ball","statement":"(R : ℝ) : Finite ↑(S.centers ∩ ball 0 R)"},{"kind":"theorem","name":"SpherePacking.local_density_lower_bound","statement":"(hd : 0 < d) (R : ℝ) : S.densityInsideRadius R ≥ (S.centers ∩ ball 0 (R - S.separation / 2)).encard * volume (ball (0 : EuclideanSpace ℝ (Fin d)) (S.separation / 2)) / volume (ball (0 : EuclideanSpace ℝ (Fin d)) R)"},{"kind":"theorem","name":"SpherePacking.local_density_upper_bound","statement":"(hd : 0 < d) (R : ℝ) : S.densityInsideRadius R ≤ (S.centers ∩ ball 0 (R + S.separation / 2)).encard * volume (ball (0 : EuclideanSpace ℝ (Fin d)) (S.separation / 2)) / volume (ball (0 : EuclideanSpace ℝ (Fin d)) R)"},{"kind":"theorem","name":"ENNReal.cancel_common_numerator_in_division_ratio","statement":"{a b c : ENNReal} (ha : a ≠ 0) (ha' : a ≠ ⊤) (hc : c ≠ ⊤) : (a / b) / (a / c) = c / b"},{"kind":"theorem","name":"ENat.tsum_constant_eq_card_mul","statement":"{α : Type*} (c : ENat) : ∑' (_ : α), c = ENat.card α * c"},{"kind":"theorem","name":"ENat.tsum_subtype_constant_eq_encard_mul","statement":"{α : Type*} (s : Set α) (c : ENat) : ∑' (_ : s), c = s.encard * c"},{"kind":"theorem","name":"ENat.tsum_unit_eq_cardinality","statement":"{α : Type*} : ∑' (_ : α), 1 = ENat.card α"},{"kind":"theorem","name":"ENat.tsum_subtype_unit_eq_encard","statement":"{α : Type*} (s : Set α) : ∑' (_ : s), 1 = s.encard"},{"kind":"theorem","name":"tsum_disjoint_subtype_union","statement":"(f : α → ℕ∞) (t : ι → Set α) (ht : Pairwise (Disjoint on t)) : ∑' x : ⋃ i, t i, f x = ∑' i, ∑' x : t i, f x"},{"kind":"theorem","name":"Set.encard_disjoint_union_eq_tsum","statement":"{ι α : Type*} {s : ι → Set α} (hs : Set.PairwiseDisjoint Set.univ s) : (⋃ i, s i).encard = ∑' i, (s i).encard"},{"kind":"theorem","name":"ZSpan.fundamental_region_iff_coordinate_floor_zero","statement":"(v : E) : v ∈ fundamentalDomain b ↔ floor b v = 0"},{"kind":"lemma","name":"finite_centers_in_bounded_region","statement":"(hD_isBounded : IsBounded D) (hd : 0 < d) : Finite ↑(S.centers ∩ D)"},{"kind":"lemma","name":"finite_centers_in_fundamental_region","statement":"{ι : Type*} [Finite ι] (b : Basis ι ℤ S.lattice) (hd : 0 < d) : Finite ↑(S.centers ∩ fundamentalDomain (b.ofZLatticeBasis ℝ _))"},{"kind":"lemma","name":"finite_centers_in_translated_fundamental_region","statement":"{ι : Type*} [Finite ι] (b : Basis ι ℤ S.lattice) (hd : 0 < d) (v : EuclideanSpace ℝ (Fin d)) : Finite ↑(S.centers ∩ (v +ᵥ fundamentalDomain (b.ofZLatticeBasis ℝ _)))"},{"kind":"lemma","name":"translates_disjoint_of_unique_cover","statement":"{Λ : Submodule ℤ (EuclideanSpace ℝ (Fin d))} {D : Set (EuclideanSpace ℝ (Fin d))} (hD_unique_covers : ∀ x, ∃! g : Λ, g +ᵥ x ∈ D) {g h : Λ} (hgh : g ≠ h) : Disjoint (g +ᵥ D) (h +ᵥ D)"},{"kind":"theorem","name":"PeriodicSpherePacking.card_centers_in_fundamental_region","statement":"(hD_isBounded : IsBounded D) (hD_unique_covers : ∀ x, ∃! g : S.lattice, g +ᵥ x ∈ D) (hd : 0 < d) : haveI"},{"kind":"theorem","name":"PeriodicSpherePacking.encard_centers_in_fundamental_region","statement":"(hD_isBounded : IsBounded D) (hD_unique_covers : ∀ x, ∃! g : S.lattice, g +ᵥ x ∈ D) (hd : 0 < d) : (S.centers ∩ D).encard = S.centerOrbitCardinality"},{"kind":"theorem","name":"PeriodicSpherePacking.card_centers_in_translated_region","statement":"(hd : 0 < d) {ι : Type*} [Finite ι] (b : Basis ι ℤ S.lattice) (v : EuclideanSpace ℝ (Fin d)) : haveI"},{"kind":"theorem","name":"PeriodicSpherePacking.encard_centers_in_translated_region","statement":"(hd : 0 < d) {ι : Type*} [Finite ι] (b : Basis ι ℤ S.lattice) (v : EuclideanSpace ℝ (Fin d)) : (S.centers ∩ (v +ᵥ fundamentalDomain (b.ofZLatticeBasis ℝ _))).encard = S.centerOrbitCardinality"},{"kind":"theorem","name":"PeriodicSpherePacking.orbit_cardinality_eq_bounded_representatives","statement":"(S : PeriodicSpherePacking d) (hd : 0 < d) {D : Set (EuclideanSpace ℝ (Fin d))} (hD_isBounded : IsBounded D) (hD_unique_covers : ∀ x, ∃! g : S.lattice, g +ᵥ x ∈ D) : S.centerOrbitCardinality = S.boundedCenterRepresentativeCount hd hD_isBounded"},{"kind":"theorem","name":"PeriodicSpherePacking.encard_centers_inter_ball_ge_numReps_nsmul_encard_lattice_inter_ball","statement":"(hd : 0 < d) {ι : Type*} [Finite ι] (b : Basis ι ℤ S.lattice) {L : ℝ} (hL : ∀ x ∈ fundamentalDomain (b.ofZLatticeBasis ℝ _), ‖x‖ ≤ L) (R : ℝ) : (↑S.centers ∩ ball 0 R).encard ≥ S.centerOrbitCardinality • (↑S.lattice ∩ ball (0 : EuclideanSpace ℝ (Fin d)) (R - L)).encard"},{"kind":"theorem","name":"PeriodicSpherePacking.encard_centers_inter_ball_le_numReps_nsmul_encard_lattice_inter_ball","statement":"(hd : 0 < d) {ι : Type*} [Finite ι] (b : Basis ι ℤ S.lattice) {L : ℝ} (hL : ∀ x ∈ fundamentalDomain (b.ofZLatticeBasis ℝ _), ‖x‖ ≤ L) (R : ℝ) : (↑S.centers ∩ ball 0 R).encard ≤ S.centerOrbitCardinality • (↑S.lattice ∩ ball (0 : EuclideanSpace ℝ (Fin d)) (R + L)).encard"},{"kind":"theorem","name":"lattice_region_is_additive_fundamental_domain","statement":"(hD_unique_covers : ∀ x, ∃! g : S.lattice, g +ᵥ x ∈ D) (hD_measurable : MeasurableSet D) : IsAddFundamentalDomain S.lattice D"},{"kind":"theorem","name":"PeriodicSpherePacking.encard_lattice_inter_ball_ge_volume_ball_sub_div_volume","statement":"(hD_unique_covers : ∀ x, ∃! g : S.lattice, g +ᵥ x ∈ D) (hL : ∀ x ∈ D, ‖x‖ ≤ L) : (↑S.lattice ∩ ball (0 : EuclideanSpace ℝ (Fin d)) R).encard ≥ volume (ball (0 : EuclideanSpace ℝ (Fin d)) (R - L)) / volume D"},{"kind":"theorem","name":"PeriodicSpherePacking.encard_lattice_inter_ball_le_volume_ball_add_div_volume","statement":"(hD_unique_covers : ∀ x, ∃! g : S.lattice, g +ᵥ x ∈ D) (hD_measurable : MeasurableSet D) (hL : ∀ x ∈ D, ‖x‖ ≤ L) (hd : 0 < d) : (↑S.lattice ∩ ball (0 : EuclideanSpace ℝ (Fin d)) R).encard ≤ volume (ball (0 : EuclideanSpace ℝ (Fin d)) (R + L)) / volume D"},{"kind":"theorem","name":"PeriodicSpherePacking.encard_lattice_inter_ball_ge_volume_ball_sub_div_volume_fundamentalDomain","statement":"(hL : ∀ x ∈ fundamentalDomain (b.ofZLatticeBasis ℝ _), ‖x‖ ≤ L) : (↑S.lattice ∩ ball (0 : EuclideanSpace ℝ (Fin d)) R).encard ≥ volume (ball (0 : EuclideanSpace ℝ (Fin d)) (R - L)) / volume (fundamentalDomain (b.ofZLatticeBasis ℝ _))"},{"kind":"theorem","name":"PeriodicSpherePacking.encard_lattice_inter_ball_le_volume_ball_add_div_volume_fundamentalDomain","statement":"(hL : ∀ x ∈ fundamentalDomain (b.ofZLatticeBasis ℝ _), ‖x‖ ≤ L) (hd : 0 < d) : (↑S.lattice ∩ ball (0 : EuclideanSpace ℝ (Fin d)) R).encard ≤ volume (ball (0 : EuclideanSpace ℝ (Fin d)) (R + L)) / volume (fundamentalDomain (b.ofZLatticeBasis ℝ _))"},{"kind":"theorem","name":"finiteDensity_le_numReps_mul_volume_ball_ratio","statement":"(hL : ∀ x ∈ fundamentalDomain (b.ofZLatticeBasis ℝ _), ‖x‖ ≤ L) (hd : 0 < d) : S.densityInsideRadius R ≤ S.centerOrbitCardinality * volume (ball (0 : EuclideanSpace ℝ (Fin d)) (S.separation / 2)) / volume (fundamentalDomain (b.ofZLatticeBasis ℝ _)) * (volume (ball (0 : EuclideanSpace ℝ (Fin d)) (R + S.separation / 2 + L * 2)) / volume (ball (0 : EuclideanSpace ℝ (Fin d)) R))"},{"kind":"theorem","name":"finiteDensity_ge_numReps_mul_volume_ball_ratio","statement":"(hL : ∀ x ∈ fundamentalDomain (b.ofZLatticeBasis ℝ _), ‖x‖ ≤ L) (hd : 0 < d) : S.densityInsideRadius R ≥ S.centerOrbitCardinality * volume (ball (0 : EuclideanSpace ℝ (Fin d)) (S.separation / 2)) / volume (fundamentalDomain (b.ofZLatticeBasis ℝ _)) * (volume (ball (0 : EuclideanSpace ℝ (Fin d)) (R - S.separation / 2 - L * 2)) / volume (ball (0 : EuclideanSpace ℝ (Fin d)) R))"},{"kind":"lemma","name":"eventually_ofReal_div_add_one_rpow_mem_Icc","statement":"{d : ℝ} {ε : ℝ≥0∞} (hd : 0 ≤ d) (hε : 0 < ε) : ∃ k : ℝ, k ≥ 0 ∧ ∀ k' ≥ k, ENNReal.ofReal ((k' / (k' + 1)) ^ d) ∈ Set.Icc (1 - ε) (1 + ε)"},{"kind":"lemma","name":"eventually_ofReal_div_add_one_pow_mem_Icc","statement":"{ε : ℝ≥0∞} (hε : 0 < ε) : ∃ k : ℝ, k ≥ 0 ∧ ∀ k' ≥ k, ENNReal.ofReal ((k' / (k' + 1)) ^ d) ∈ Set.Icc (1 - ε) (1 + ε)"},{"kind":"theorem","name":"volume_ball_div_volume_ball_add_tendsto_one","statement":"{C : ℝ} (hd : 0 < d) (hC : 0 ≤ C) : Tendsto (fun R ↦ volume (ball (0 : EuclideanSpace ℝ (Fin d)) R) / volume (ball (0 : EuclideanSpace ℝ (Fin d)) (R + C))) atTop (𝓝 1)"},{"kind":"theorem","name":"volume_ball_add_div_volume_ball_add_tendsto_one_of_nonneg","statement":"{d : ℕ} {C C' : ℝ} (hd : 0 < d) (hC : 0 ≤ C) (hC' : 0 ≤ C') : Tendsto (fun R ↦ volume (ball (0 : EuclideanSpace ℝ (Fin d)) (R + C)) / volume (ball (0 : EuclideanSpace ℝ (Fin d)) (R + C'))) atTop (𝓝 1)"},{"kind":"theorem","name":"Filter.atTop_invariant_under_translation","statement":"{β : Type*} {f : ℝ → β} (C : ℝ) (α : Filter β) : Tendsto f atTop α ↔ Tendsto (fun x ↦ f (x + C)) atTop α"},{"kind":"theorem","name":"volume_ball_add_div_volume_ball_add_tendsto_one","statement":"{d : ℕ} {C C' : ℝ} (hd : 0 < d) : Tendsto (fun R ↦ volume (ball (0 : EuclideanSpace ℝ (Fin d)) (R + C)) / volume (ball (0 : EuclideanSpace ℝ (Fin d)) (R + C'))) atTop (𝓝 1)"},{"kind":"lemma","name":"PeriodicSpherePacking.local_packing_density_tends_to_formula","statement":"(hL : ∀ x ∈ fundamentalDomain (b.ofZLatticeBasis ℝ _), ‖x‖ ≤ L) (hd : 0 < d) : Tendsto S.densityInsideRadius atTop (𝓝 (S.centerOrbitCardinality * volume (ball (0 : EuclideanSpace ℝ (Fin d)) (S.separation / 2)) / volume (fundamentalDomain (b.ofZLatticeBasis ℝ _))))"},{"kind":"theorem","name":"PeriodicSpherePacking.density_eq_numReps_mul_volume_ball_div_volume_fundamentalDomain","statement":"(hL : ∀ x ∈ fundamentalDomain (b.ofZLatticeBasis ℝ _), ‖x‖ ≤ L) (hd : 0 < d) : S.upperPackingDensity = S.centerOrbitCardinality * volume (ball (0 : EuclideanSpace ℝ (Fin d)) (S.separation / 2)) / volume (fundamentalDomain (b.ofZLatticeBasis ℝ _))"},{"kind":"theorem","name":"periodic_packing_supremum_eq_unit_separation","statement":"PeriodicSpherePackingConstant d = ⨆ (S : PeriodicSpherePacking d) (_ : S.separation = 1), S.upperPackingDensity"},{"kind":"theorem","name":"PeriodicSpherePacking.center_representatives_cover_uniquely"