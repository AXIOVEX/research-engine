C_set_Z X).ncard"},{"kind":"lemma","name":"local_pattern_bound_Z","statement":"(X : Set ℤ) (hX : X.Finite) : 2 * N_k_Z X 2 ≤ N_k_Z X 3 + 2 * V_2_Z X + 2 * I_Z X"},{"kind":"lemma","name":"num_isolated_Z_rel","statement":"(A : Set ℕ) : I_Z (Z_S (A + A)) ≤ num_isolated A + 1"},{"kind":"lemma","name":"N_k_Z_rel_1","statement":"(A : Set ℕ) : N_k_Z (Z_S (A + A)) (1 : ℤ) = N_k_N (A + A) 1"},{"kind":"lemma","name":"N_k_Z_rel_2","statement":"(A : Set ℕ) : N_k_Z (Z_S (A + A)) (2 : ℤ) = N_k_N (A + A) 2"},{"kind":"lemma","name":"N_k_Z_rel_3","statement":"(A : Set ℕ) : N_k_Z (Z_S (A + A)) (3 : ℤ) = N_k_N (A + A) 3"},{"kind":"lemma","name":"Z_S_card","statement":"(A : Set ℕ) : (Z_S (A + A)).ncard = (A + A).ncard"},{"kind":"lemma","name":"quad_upper_Q0","statement":"(A : Set ℕ) (k : ℕ) (_ : IsSidon A) (hA : A.Finite) (hk : k > 0) : {q ∈ quad_k_N A k | (q.1 : ℤ) - q.2.2.1 = 0}.ncard ≤ A.ncard"},{"kind":"lemma","name":"quad_upper_Qk_inj","statement":"(A : Set ℕ) (k : ℕ) (_ : IsSidon A) (hk : k > 0) : InjOn (fun q : ℕ × ℕ × ℕ × ℕ => q.2.1) {q ∈ quad_k_N A k | (q.1 : ℤ) - q.2.2.1 = -k}"},{"kind":"lemma","name":"quad_upper_Qk_im","statement":"(A : Set ℕ) (k : ℕ) (_ : IsSidon A) (hk : k > 0) : (fun q : ℕ × ℕ × ℕ × ℕ => q.2.1) '' {q ∈ quad_k_N A k | (q.1 : ℤ) - q.2.2.1 = -k} ⊆ A"},{"kind":"lemma","name":"quad_upper_Qk","statement":"(A : Set ℕ) (k : ℕ) (hSidon : IsSidon A) (hA : A.Finite) (hk : k > 0) : {q ∈ quad_k_N A k | (q.1 : ℤ) - q.2.2.1 = -k}.ncard ≤ A.ncard"},{"kind":"lemma","name":"quad_upper_other_inj","statement":"(A : Set ℕ) (k : ℕ) (_ : IsSidon A) : InjOn (fun q : ℕ × ℕ × ℕ × ℕ => (q.1 : ℤ) - q.2.2.1) {q ∈ quad_k_N A k | (q.1 : ℤ) - q.2.2.1 ≠ 0 ∧ (q.1 : ℤ) - q.2.2.1 ≠ -k}"},{"kind":"lemma","name":"quad_upper_other_im","statement":"(A : Set ℕ) (k : ℕ) (_ : IsSidon A) : (fun q : ℕ × ℕ × ℕ × ℕ => (q.1 : ℤ) - q.2.2.1) '' {q ∈ quad_k_N A k | (q.1 : ℤ) - q.2.2.1 ≠ 0 ∧ (q.1 : ℤ) - q.2.2.1 ≠ -k} ⊆ {x ∈ D_set A | x + k ∈ D_set A}"},{"kind":"lemma","name":"quad_upper_other","statement":"(A : Set ℕ) (k : ℕ) (hSidon : IsSidon A) (_ : A.Finite) : {q ∈ quad_k_N A k | (q.1 : ℤ) - q.2.2.1 ≠ 0 ∧ (q.1 : ℤ) - q.2.2.1 ≠ -k}.ncard ≤ N_k_Z (D_set A) k"},{"kind":"lemma","name":"quad_upper_part","statement":"(A : Set ℕ) (k : ℕ) (_ : A.Finite) : (quad_k_N A k).ncard ≤ {q ∈ quad_k_N A k | (q.1 : ℤ) - q.2.2.1 = 0}.ncard + {q ∈ quad_k_N A k | (q.1 : ℤ) - q.2.2.1 = -k}.ncard + {q ∈ quad_k_N A k | (q.1 : ℤ) - q.2.2.1 ≠ 0 ∧ (q.1 : ℤ) - q.2.2.1 ≠ -k}.ncard"},{"kind":"lemma","name":"quad_upper","statement":"(A : Set ℕ) (k : ℕ) (hSidon : IsSidon A) (hA : A.Finite) (hk : k > 0) : (quad_k_N A k).ncard ≤ N_k_Z (D_set A) k + 2 * A.ncard"},{"kind":"lemma","name":"quad_fiber_subset","statement":"(A : Set ℕ) (hA : A.Finite) (s k : ℕ) : quad_fiber A s k ⊆ quad_k_N A k"},{"kind":"lemma","name":"quad_fiber_card","statement":"(A : Set ℕ) (hA : A.Finite) (k : ℕ) (s : ℕ) (hs : s ∈ S_good A k) : 4 ≤ (quad_fiber A s k).ncard"},{"kind":"lemma","name":"quad_fiber_disjoint","statement":"(A : Set ℕ) (hA : A.Finite) (k : ℕ) (s1 s2 : ℕ) (h : s1 ≠ s2) : Disjoint (quad_fiber A s1 k) (quad_fiber A s2 k)"},{"kind":"lemma","name":"quad_lower_sub_fin","statement":"(A : Set ℕ) (k : ℕ) (hA : A.Finite) : (S_good A k).Finite"},{"kind":"lemma","name":"quad_lower_sub","statement":"(A : Set ℕ) (k : ℕ) (hA : A.Finite) : 4 * (S_good A k).ncard ≤ (quad_k_N A k).ncard"},{"kind":"lemma","name":"quad_lower_edges","statement":"(A : Set ℕ) (k : ℕ) (hA : A.Finite) : N_k_N (A + A) k ≤ (S_good A k).ncard + 2 * A.ncard"},{"kind":"lemma","name":"quad_lower","statement":"(A : Set ℕ) (k : ℕ) (hSidon : IsSidon A) (hA : A.Finite) : 4 * N_k_N (A + A) k ≤ (quad_k_N A k).ncard + 8 * A.ncard"},{"kind":"lemma","name":"quad_lower_2","statement":"(A : Set ℕ) (k : ℕ) (hSidon : IsSidon A) (hA : A.Finite) : N_k_Z (D_set A) k ≤ (quad_k_N A k).ncard + 2 * A.ncard"},{"kind":"lemma","name":"quad_upper_2","statement":"(A : Set ℕ) (k : ℕ) (hSidon : IsSidon A) (hA : A.Finite) : (quad_k_N A k).ncard ≤ 4 * N_k_N (A + A) k + 2 * A.ncard"},{"kind":"lemma","name":"N_bound_upper_1","statement":"(A : Set ℕ) (hA : A.Finite) (hSidon : IsSidon A) : 4 * N_k_N (A + A) 1 ≤ N_k_Z (D_set A) 1 + 10 * A.ncard"},{"kind":"lemma","name":"N_bound_lower_2","statement":"(A : Set ℕ) (hA : A.Finite) (hSidon : IsSidon A) : N_k_Z (D_set A) 2 ≤ 4 * N_k_N (A + A) 2 + 10 * A.ncard"},{"kind":"lemma","name":"N_bound_upper_3","statement":"(A : Set ℕ) (hA : A.Finite) (hSidon : IsSidon A) : 4 * N_k_N (A + A) 3 ≤ N_k_Z (D_set A) 3 + 10 * A.ncard"},{"kind":"lemma","name":"D_set_card","statement":"(A : Set ℕ) (hA : A.Finite) : (D_set A).ncard ≤ A.ncard * A.ncard"},{"kind":"lemma","name":"S_card","statement":"(A : Set ℕ) (hA : A.Finite) (hSidon : IsSidon A) : 2 * (A + A).ncard ≥ A.ncard * A.ncard"},{"kind":"lemma","name":"num_isolated_lower_bound","statement":"(n : ℕ) (hn : n > 0) (A : Set ℕ) (h_card : A.ncard = n) (h_sidon : IsSidon A) : 16 * num_isolated A + 100 * n + 16 ≥ n * n"},{"kind":"lemma","name":"exists_sidon_set_n","statement":"(n : ℕ) : ∃ A : Set ℕ, A.ncard = n ∧ IsSidon A"},{"kind":"lemma","name":"f_lower_bound_div","statement":"(n : ℕ) : f n ≥ (n * n - 100 * n - 16) / 16"},{"kind":"lemma","name":"tendsto_bound","statement":"Tendsto (fun n : ℕ => (n * n - 100 * n - 16) / 16) atTop atTop"},{"kind":"lemma","name":"tendsto_f","statement":"Tendsto f atTop atTop"},{"kind":"theorem","name":"target_theorem_0","statement":"answer( -- EVOLVE-VALUE-START True -- EVOLVE-VALUE-END ) ↔ Tendsto f atTop atTop"}],"retrieved":"2026-10-12","sha256":"fb9cf6bb4de746f9e520e07ce9fccbddd6cd63eafb674bbe60dd457a827c6e35","sorry_count":0,"url":"https://github.com/google-deepmind/alphaproof-nexus-results/blob/main/APNOutputs/ErdosProblems/erdos_152.lean"}},"prev_hash":"ee61db435d94e482a6321184da499ecfbdbd1ee4036282f85bfc1210a433cecb","seq":86,"ts":1791808617,"type":"math.lean_ingested"}
