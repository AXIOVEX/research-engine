normalizedHamming p q"},{"kind":"theorem","name":"GoodOn.mono","statement":"{G : Type*} [Group G] {M : PermutationModel G} {F F' : Finset G} {ε : ℝ} (h : GoodOn M F' ε) (hF : F ⊆ F') : GoodOn M F ε where multiplicative g hg k hk"},{"kind":"theorem","name":"normalizedHamming_permCongr","statement":"{X Y : Type*} [Fintype X] [DecidableEq X] [Fintype Y] [DecidableEq Y] (e : X ≃ Y) (p q : Equiv.Perm X) : normalizedHamming (e.permCongr p) (e.permCongr q) = normalizedHamming p q"},{"kind":"theorem","name":"hammingDist_prodCongr_refl_left","statement":"{X Y : Type*} [Fintype X] [DecidableEq X] [Fintype Y] [DecidableEq Y] (p q : Equiv.Perm Y) : hammingDist (fun z : X × Y => ((Equiv.refl X).prodCongr p) z) (fun z : X × Y => ((Equiv.refl X).prodCongr q) z) = Fintype.card X * hammingDist (fun y => p y) (fun y => q y)"},{"kind":"theorem","name":"normalizedHamming_prodCongr_refl_left","statement":"{X Y : Type*} [Fintype X] [DecidableEq X] [Fintype Y] [DecidableEq Y] (hX : Fintype.card X ≠ 0) (p q : Equiv.Perm Y) : normalizedHamming ((Equiv.refl X).prodCongr p) ((Equiv.refl X).prodCongr q) = normalizedHamming p q"},{"kind":"theorem","name":"amplifyModel_normalizedHamming","statement":"{G : Type*} [Group G] (M : PermutationModel G) (k : ℕ) (hk : 0 < k) (g h : G) : normalizedHamming ((amplifyModel M k hk).action g) ((amplifyModel M k hk).action h) = normalizedHamming (M.action g) (M.action h)"},{"kind":"theorem","name":"amplifyModel_multiplicative_distance","statement":"{G : Type*} [Group G] (M : PermutationModel G) (k : ℕ) (hk : 0 < k) (g h : G) : normalizedHamming ((amplifyModel M k hk).action (g * h)) ((amplifyModel M k hk).action g * (amplifyModel M k hk).action h) = normalizedHamming (M.action (g * h)) (M.action g * M.action h)"},{"kind":"theorem","name":"amplifyModel_separation_distance","statement":"{G : Type*} [Group G] (M : PermutationModel G) (k : ℕ) (hk : 0 < k) (g : G) : normalizedHamming ((amplifyModel M k hk).action g) 1 = normalizedHamming (M.action g) 1"},{"kind":"theorem","name":"nonempty_soficApproximation_of_sofic","statement":"(G : Type*) [Group G] [Countable G] [Sofic G] : Nonempty (SoficApproximation G)"},{"kind":"theorem","name":"amplifyApproximation_size_tendsto","statement":"{G : Type*} [Group G] (A : SoficApproximation G) : Tendsto (fun n => (amplifyApproximation A).model n |>.size) atTop atTop"},{"kind":"theorem","name":"exists_soficApproximation_size_tendsto","statement":"(G : Type*) [Group G] [Countable G] [Sofic G] : ∃ A : SoficApproximation G, Tendsto (fun n => (A.model n).size) atTop atTop"},{"kind":"theorem","name":"sofic_of_injective","statement":"{G H : Type*} [Group G] [Group H] [Sofic G] (f : H →* G) (hf : Function.Injective f) : Sofic H"},{"kind":"theorem","name":"exists_finite_obstruction","statement":"{G : Type*} [Group G] (hG : ¬ Sofic G) : ∃ (F : Finset G) (ε : ℝ), 1 ∈ F ∧ 0 < ε ∧ ε < 1 ∧ ∀ M : PermutationModel G, ¬ GoodOn M F ε"},{"kind":"theorem","name":"mem_multiplicationTable_of_mem","statement":"{G : Type*} [Group G] {F : Finset G} {g : G} (hg : g ∈ F) : g ∈ multiplicationTable F"},{"kind":"theorem","name":"mul_mem_multiplicationTable","statement":"{G : Type*} [Group G] {F : Finset G} {g h : G} (hg : g ∈ F) (hh : h ∈ F) : g * h ∈ multiplicationTable F"},{"kind":"theorem","name":"tableGenerator_one","statement":"{G : Type*} [Group G] (F : Finset G) (h₁ : 1 ∈ F) : tableGenerator F h₁ ⟨1, mem_multiplicationTable_of_mem h₁⟩ = 1"},{"kind":"theorem","name":"tableGenerator_mul","statement":"{G : Type*} [Group G] (F : Finset G) (h₁ : 1 ∈ F) {g h : G} (hg : g ∈ F) (hh : h ∈ F) : tableGenerator F h₁ ⟨g, mem_multiplicationTable_of_mem hg⟩ * tableGenerator F h₁ ⟨h, mem_multiplicationTable_of_mem hh⟩ = tableGenerator F h₁ ⟨g * h, mul_mem_multiplicationTable hg hh⟩"},{"kind":"theorem","name":"tableEvaluation_generator","statement":"{G : Type*} [Group G] (F : Finset G) (h₁ : 1 ∈ F) (g : ↥(multiplicationTable F)) : tableEvaluation F h₁ (tableGenerator F h₁ g) = g.1"},{"kind":"theorem","name":"tableGenerator_ne_one","statement":"{G : Type*} [Group G] (F : Finset G) (h₁ : 1 ∈ F) {g : G} (hg : g ∈ F) (hne : g ≠ 1) : tableGenerator F h₁ ⟨g, mem_multiplicationTable_of_mem hg⟩ ≠ 1"},{"kind":"theorem","name":"tableGroup_finitelyPresented","statement":"{G : Type*} [Group G] (F : Finset G) (h₁ : 1 ∈ F) : Group.IsFinitelyPresented (tableGroup F h₁)"},{"kind":"theorem","name":"tableGenerator_mem_tableTestSet","statement":"{G : Type*} [Group G] (F : Finset G) (h₁ : 1 ∈ F) {g : G} (hg : g ∈ F) : tableGenerator F h₁ ⟨g, mem_multiplicationTable_of_mem hg⟩ ∈ tableTestSet F h₁"},{"kind":"theorem","name":"pullbackTableModel_action_of_mem","statement":"{G : Type*} [Group G] (F : Finset G) (h₁ : 1 ∈ F) (M : PermutationModel (tableGroup F h₁)) {g : G} (hg : g ∈ multiplicationTable F) : (pullbackTableModel F h₁ M).action g = M.action (tableGenerator F h₁ ⟨g, hg⟩)"},{"kind":"theorem","name":"goodOn_pullbackTableModel","statement":"{G : Type*} [Group G] (F : Finset G) (h₁ : 1 ∈ F) {ε : ℝ} (M : PermutationModel (tableGroup F h₁)) (hM : GoodOn M (tableTestSet F h₁) ε) : GoodOn (pullbackTableModel F h₁ M) F ε"},{"kind":"theorem","name":"tableGroup_not_sofic_of_obstruction","statement":"{G : Type*} [Group G] (F : Finset G) (h₁ : 1 ∈ F) (ε : ℝ) (hε : 0 < ε) (hε' : ε < 1) (hbad : ∀ M : PermutationModel G, ¬ GoodOn M F ε) : ¬ Sofic (tableGroup F h₁)"},{"kind":"theorem","name":"exists_nonsofic_finite_table","statement":"{G : Type u} [Group G] (hG : ¬ Sofic G) : ∃ (F : Finset G) (h₁ : 1 ∈ F), Group.IsFinitelyPresented (tableGroup F h₁) ∧ ¬ Sofic (tableGroup F h₁)"},{"kind":"theorem","name":"exists_finitelyPresented_not_sofic_of_not_sofic","statement":"{G : Type u} [Group G] (hG : ¬ Sofic G) : ∃ (H : Type u) (_ : Group H), Group.IsFinitelyPresented H ∧ ¬ Sofic H"},{"kind":"theorem","name":"mono","statement":"{s t : Finset G} {f : G → H} (h : LocalMultiplicativeOn t f) (hst : s ⊆ t) : LocalMultiplicativeOn s f where map_one"},{"kind":"theorem","name":"map_inv_of_mem","statement":"{s : Finset G} {f : G → H} (h : LocalMultiplicativeOn s f) {x : G} (hx : x ∈ s) (hi : x⁻¹ ∈ s) : f x⁻¹ = (f x)⁻¹"},{"kind":"theorem","name":"exists_local_word_control","statement":"{α : Type u} {G : Type v} [Group G] (φ : FreeGroup α →* G) (z : FreeGroup α) : ∃ s : Finset G, ∀ (H : Type w) [Group H] (f : G → H), LocalMultiplicativeOn s f → FreeGroup.lift (fun a => f (φ (FreeGroup.of a))) z = f (φ z)"},{"kind":"theorem","name":"agreementSet_card_add_hammingDist","statement":"{V : Type*} [Fintype V] [DecidableEq V] (c c' : Equiv.Perm V) : (agreementSet c c').card + hammingDist (fun x => c x) (fun x => c' x) = Fintype.card V"},{"kind":"theorem","name":"boundary_agreementSet_le_commutationDefect","statement":"{V ι : Type*} [Fintype V] [Fintype ι] [DecidableEq V] (σ : ι → Equiv.Perm V) (c c' : Equiv.Perm V) : boundary σ (agreementSet c c') ≤ permutationCommutationDefect σ c + permutationCommutationDefect σ c'"},{"kind":"theorem","name":"hamming_dichotomy_of_expansion","statement":"{V ι : Type*} [Fintype V] [Fintype ι] [DecidableEq V] (σ : ι → Equiv.Perm V) (h : ℝ) (hexp : ∀ A : Finset V, h * min (A.card : ℝ) ((Fintype.card V : ℝ) - A.card) ≤ (boundary σ A : ℝ)) (c c' : Equiv.Perm V) : h * (hammingDist (fun x => c x) (fun x => c' x) : ℝ) ≤ (permutationCommutationDefect σ c + permutationCommutationDefect σ c' : ℕ) ∨ h * ((Fintype.card V : ℝ) - hammingDist (fun x => c x) (fun x => c' x)) ≤ (permutationCommutationDefect σ c + permutationCommutationDefect σ c' : ℕ)"},{"kind":"theorem","name":"boundary_union_le","statement":"{V ι : Type*} [Fintype ι] [DecidableEq V] (σ : ι → Equiv.Perm V) (B E : Finset V) : boundary σ (B ∪ E) ≤ boundary σ B + inducedBoundary σ B E"},{"kind":"theorem","name":"boundary_le_induced_add_deleted","statement":"{V ι : Type*} [Fintype ι] [DecidableEq V] (σ : ι → Equiv.Perm V) (B E : Finset V) : boundary σ E ≤ inducedBoundary σ B E + Fintype.card ι * B.card"},{"kind":"theorem","name":"maximal_bad_cut_induced_lower","statement":"{V ι : Type*} [Fintype V] [Fintype ι] [DecidableEq V] (σ : ι → Equiv.Perm V) (B E : Finset V) (ell : ℝ) (hB : (boundary σ B : ℝ) ≤ ell * (B.card : ℝ)) (hmax : ∀ A : Finset V, 2 * A.card ≤ Fintype.card V → (boundary σ A : ℝ) < ell * (A.card : ℝ) → A.card ≤ B.card) (hdisj : Disjoint B E) (hne : E.Nonempty) (hhalf : 2 * (B ∪ E).card ≤ Fintype.card V) : ell * (E.card : ℝ) ≤ (inducedBoundary σ B E : ℝ)"},{"kind":"theorem","name":"bad_cut_card_bound","statement":"{γ ell a : ℝ} {N b q : ℕ} (hgap : ell < γ) (hadd : γ * (b : ℝ) - a * (N : ℝ) ≤ (q : ℝ)) (hbad : (q : ℝ) ≤ ell * (b : ℝ)) : (b : ℝ) ≤ a * (N : ℝ) / (γ - ell)"},{"kind":"theorem","name":"large_cut_lower","statement":"{γ ell a d N b e q : ℝ} (hgap : ell < γ) (hd : 0 ≤ d) (hN : 0 ≤ N) (hdeleted : (γ - ell) * b ≤ a * N) (hsmall : 2 * a * (2 * (γ - ell) + d) ≤ (γ - ell) ^ 2) (hlarge : N / 2 - b < e) (hcut : γ * e - a * N - d * b ≤ q) : ell * e ≤ q"},{"kind":"theorem","name":"prune_permutation_multigraph","statement":"{V ι : Type*} [Fintype V] [Fintype ι] [DecidableEq V] (σ : ι → Equiv.Perm V) (γ ell a : ℝ) (B : Finset V) (hgap : ell < γ) (hadd : ∀ A : Finset V, γ * min (A.card : ℝ) ((Fintype.card V : ℝ) - (A.card : ℝ)) - a * (Fintype.card V : ℝ) ≤ (boundary σ A : ℝ)) (hBhalf : 2 * B.card ≤ Fintype.card V) (hB : (boundary σ B : ℝ) ≤ ell * (B.card : ℝ)) (hmax : ∀ A : Finset V, 2 * A.card ≤ Fintype.card V → (boundary σ A : ℝ) < ell * (A.card : ℝ) → A.card ≤ B.card) (hsmall : 2 * a * (2 * (γ - ell) + (Fintype.card ι : ℝ)) ≤ (γ - ell) ^ 2) (E : Finset V) (hdisj : Disjoint B E) (hEhalf : 2 * E.card ≤ Fintype.card V - B.card) : ell * (E.card : ℝ) ≤ (inducedBoundary σ B E : ℝ)"},{"kind":"theorem","name":"exists_maximal_bad_cut","statement":"{V ι : Type*} [Fintype V] [Fintype ι] [DecidableEq V] (σ : ι → Equiv.Perm V) (ell : ℝ) : ∃ B : Finset V, 2 * B.card ≤ Fintype.card V ∧ (boundary σ B : ℝ) ≤ ell * (B.card : ℝ) ∧ ∀ A : Finset V, 2 * A.card ≤ Fintype.card V → (boundary σ A : ℝ) < ell * (A.card : ℝ) → A.card ≤ B.card"},{"kind":"theorem","name":"exists_pruned_expander","statement":"{V ι : Type*} [Fintype V] [Fintype ι] [DecidableEq V] (σ : ι → Equiv.Perm V) (γ ell a : ℝ) (hgap : ell < γ) (hadd : ∀ A : Finset V, γ * min (A.card : ℝ) ((Fintype.card V : ℝ) - (A.card : ℝ)) - a * (Fintype.card V : ℝ) ≤ (boundary σ A : ℝ)) (hsmall : 2 * a * (2 * (γ - ell) + (Fintype.card ι : ℝ)) ≤ (γ - ell) ^ 2) : ∃ B : Finset V, 2 * B.card ≤ Fintype.card V ∧ (B.card : ℝ) ≤ a * (Fintype.card V : ℝ) / (γ - ell) ∧ ∀ E : Finset V, Disjoint B E → 2 * E.card ≤ Fintype.card V - B.card → ell * (E.card : ℝ) ≤ (inducedBoundary σ B E : ℝ)"},{"kind":"theorem","name":"disjoint_dominant_intersections_false","statement":"{V : Type*} [DecidableEq V] (P Q D : Finset V) (hdisj : Disjoint P Q) (hP : D.card < 2 * (P ∩ D).card) (hQ : D.card < 2 * (Q ∩ D).card) : False"},{"kind":"theorem","name":"finpartition_dominant_matching_injOn","statement":"{V : Type*} [DecidableEq V] {U : Finset V} (P : Finpartition U) (R : Finset (Finset V)) (hR : R ⊆ P.parts) (D : Finset V → Finset V) (hmajor : ∀ C ∈ R, (D C).card < 2 * (C ∩ D C).card) : Set.InjOn D (R : Set (Finset V))"},{"kind":"theorem","name":"matchedRetainedSupport_subset","statement":"{V : Type*} [DecidableEq V] {U : Finset V} (P : Finpartition U) (R : Finset (Finset V)) (hR : R ⊆ P.parts) : matchedRetainedSupport R ⊆ U"},{"kind":"theorem","name":"matchedCore_subset_retainedSupport","statement":"{V : Type*} [DecidableEq V] (R : Finset (Finset V)) (D : Finset V → Finset V) : matchedCore R D ⊆ matchedRetainedSupport R"},{"kind":"theorem","name":"matchedCore_subset","statement":"{V : Type*} [DecidableEq V] {U : Finset V} (P : Finpartition U) (R : Finset (Finset V)) (hR : R ⊆ P.parts) (D : Finset V → Finset V) : matchedCore R D ⊆ U"},{"kind":"theorem","name":"matchedRetainedSupport_card","statement":"{V : Type*} [DecidableEq V] {U : Finset V} (P : Finpartition U) (R : Finset (Finset V)) (hR : R ⊆ P.parts) : (matchedRetainedSupport R).card = ∑ C ∈ R, C.card"},{"kind":"theorem","name":"matchedCore_card","statement":"{V : Type*} [DecidableEq V] {U : Finset V} (P : Finpartition U) (R : Finset (Finset V)) (hR : R ⊆ P.parts) (D : Finset V → Finset V) : (matchedCore R D).card = ∑ C ∈ R, (C ∩ D C).card"},{"kind":"theorem","name":"matchedCore_missing_card","statement":"{V : Type*} [DecidableEq V] {U : Finset V} (P : Finpartition U) (R : Finset (Finset V)) (hR : R ⊆ P.parts) (D : Finset V → Finset V) : (U \\ matchedCore R D).card = (U \\ matchedRetainedSupport R).card + ∑ C ∈ R, (C \\ D C).card"},{"kind":"theorem","name":"matchedCore_missing_card_le_symmDiff","statement":"{V : Type*} [DecidableEq V] {U : Finset V} (P : Finpartition U) (R : Finset (Finset V)) (hR : R ⊆ P.parts) (D : Finset V → Finset V) : (U \\ matchedCore R D).card ≤ (U \\ matchedRetainedSupport R).card + ∑ C ∈ R, (C ∆ D C).card"},{"kind":"theorem","name":"matched_partition_part_eq_of_target_part_eq","statement":"{V : Type*} [DecidableEq V] {U : Finset V} (P Q : Finpartition U) (R : Finset (Finset V)) (hR : R ⊆ P.parts) (D : Finset V → Finset V) (hD : ∀ C ∈ R, D C ∈ Q.parts) (hinj : Set.InjOn D (R : Set (Finset V))) {x y : V} (hx : x ∈ matchedCore R D) (hy : y ∈ matchedCore R D) (hpart : Q.part x = Q.part y) : P.part x = P.part y"},{"kind":"theorem","name":"matchedWordPreimageBad_card_le","statement":"{V : Type*} [DecidableEq V] (U : Finset V) (R : Finset (Finset V)) (D : Finset V → Finset V) (w : Equiv.Perm V) : (matchedWordPreimageBad U R D w).card ≤ (U \\ matchedCore R D).card"},{"kind":"theorem","name":"partitionWordCrossing_subset_target_or_unmatched","statement":"{V : Type*} [DecidableEq V] {U : Finset V} (P Q : Finpartition U) (R : Finset (Finset V)) (hR : R ⊆ P.parts) (D : Finset V → Finset V) (hD : ∀ C ∈ R, D C ∈ Q.parts) (hinj : Set.InjOn D (R : Set (Finset V))) (w : Equiv.Perm V) : partitionWordCrossing P w ⊆ partitionWordCrossing Q w ∪ (U \\ matchedCore R D) ∪ matchedWordPreimageBad U R D w"},{"kind":"theorem","name":"partitionWordCrossing_card_le_target_add_unmatched","statement":"{V : Type*} [DecidableEq V] {U : Finset V} (P Q : Finpartition U) (R : Finset (Finset V)) (hR : R ⊆ P.parts) (D : Finset V → Finset V) (hD : ∀ C ∈ R, D C ∈ Q.parts) (hinj : Set.InjOn D (R : Set (Finset V))) (w : Equiv.Perm V) : (partitionWordCrossing P w).card ≤ (partitionWordCrossing Q w).card + 2 * (U \\ matchedCore R D).card"},{"kind":"theorem","name":"matchedCore_missing_density_tendsto_zero","statement":"{V : ℕ → Type*} [∀ n, DecidableEq (V n)] (U : ∀ n, Finset (V n)) (P : ∀ n, Finpartition (U n)) (R : ∀ n, Finset (Finset (V n))) (hR : ∀ n, R n ⊆ (P n).parts) (D : ∀ n, Finset (V n) → Finset (V n)) (hdiscard : Tendsto (fun n => (((U n \\ matchedRetainedSupport (R n)).card : ℝ) / (U n).card)) atTop (𝓝 0)) (hsymm : Tendsto (fun n => ((∑ C ∈ R n, (C ∆ D n C).card : ℕ) : ℝ) / (U n).card) atTop (𝓝 0)) : Tendsto (fun n => (((U n \\ matchedCore (R n) (D n)).card : ℝ) / (U n).card)) atTop (𝓝 0)"},{"kind":"theorem","name":"permutation_increment_sum_eq_zero","statement":"{α : Type*} [Fintype α] (p : Equiv.Perm α) (f : α → ℝ) : ∑ x, (f (p x) - f x) = 0"},{"kind":"theorem","name":"permutation_squared_increment_le_twice_decreasing","statement":"{α : Type*} [Fintype α] (p : Equiv.Perm α) (f : α → ℝ) (hf_nonneg : ∀ x, 0 ≤ f x) (hf_le_one : ∀ x, f x ≤ 1) : ∑ x, (f (p x) - f x) ^ 2 ≤ 2 * ((Finset.univ.filter fun x => f (p x) < f x).card : ℝ)"},{"kind":"theorem","name":"exists_completion_of_internal_permutation","statement":"{V : Type*} [Fintype V] (p : Equiv.Perm V) (Z : Finset V) : ∃ q : Equiv.Perm {x : V // x ∈ Z}, ∀ (x : V) (hx : x ∈ Z) (_hp : p x ∈ Z), (q ⟨x, hx⟩ : V) = p x"},{"kind":"theorem","name":"diagonalRadius_tendsto_atTop","statement":"(e : ℕ → ℕ → ℝ) (he : ∀ k, Tendsto (fun n => e n k) atTop (𝓝 0)) : Tendsto (diagonalRadius e) atTop atTop"},{"kind":"theorem","name":"diagonalRadius_eventually_error_lt","statement":"(e : ℕ → ℕ → ℝ) (he : ∀ k, Tendsto (fun n => e n k) atTop (𝓝 0)) : ∀ᶠ n in atTop, e n (diagonalRadius e n) < 1 / ((diagonalRadius e n : ℝ) + 1)"},{"kind":"theorem","name":"diagonalRadius_error_tendsto_zero","statement":"(e : ℕ → ℕ → ℝ) (hnonneg : ∀ n k, 0 ≤ e n k) (he : ∀ k, Tendsto (fun n => e n k) atTop (𝓝 0)) : Tendsto (fun n => e n (diagonalRadius e n)) atTop (𝓝 0)"},{"kind":"theorem","name":"exists_diverging_radius_with_vanishing_diagonal_error","statement":"(e : ℕ → ℕ → ℝ) (hnonneg : ∀ n k, 0 ≤ e n k) (he : ∀ k, Tendsto (fun n => e n k) atTop (𝓝 0)) : ∃ r : ℕ → ℕ, Tendsto r atTop atTop ∧ Tendsto (fun n => e n (r n)) atTop (𝓝 0)"},{"kind":"theorem","name":"finite_union_bad_density_tendsto_zero","statement":"{α : ℕ → Type*} [∀ n, DecidableEq (α n)] {ι : Type*} (I : Finset ι) (V : ∀ n, Finset (α n)) (B : ∀ n, ι → Finset (α n)) (hbad : ∀ i ∈ I, Tendsto (fun n => (((V n ∩ B n i).card : ℝ) / (V n).card)) atTop (𝓝 0)) : Tendsto (fun n => (((V n ∩ I.biUnion (B n)).card : ℝ) / (V n).card)) atTop (𝓝 0)"},{"kind":"theorem","name":"sum_card_inter_partition","statement":"{α : Type*} [DecidableEq α] {U : Finset α} (P : Finpartition U) (B : Finset α) : ∑ C ∈ P.parts, (C ∩ B).card = (U ∩ B).card"},{"kind":"theorem","name":"retained_bad_density_tendsto_zero","statement":"{α : ℕ → Type*} [∀ n, DecidableEq (α n)] (V U B : ∀ n, Finset (α n)) (hV : ∀ n, (V n).Nonempty) (hU : ∀ n, (U n).Nonempty) (hUV : ∀ n, U n ⊆ V n) (hcover : Tendsto (fun n => ((U n).card : ℝ) / (V n).card) atTop (𝓝 1)) (hbad : Tendsto (fun n => (((V n ∩ B n).card : ℝ) / (V n).card)) atTop (𝓝 0)) : Tendsto (fun n => (((U n ∩ B n).card : ℝ) / (U n).card)) atTop (𝓝 0)"},{"kind":"theorem","name":"leavittT_mul_S","statement":"(i j : Fin 2) : leavittT i * leavittS j = if i = j then 1 else 0"},{"kind":"theorem","name":"leavitt_partition","statement":"leavittS 0 * leavittT 0 + leavittS 1 * leavittT 1 = 1"},{"kind":"theorem","name":"deletion_mul_prefix","statement":"(i j : Fin 2) : deletionOperator i * prefixOperator j = if i = j then 1 else 0"},{"kind":"theorem","name":"prefix_deletion_partition","statement":"prefixOperator 0 * deletionOperator 0 + prefixOperator 1 * deletionOperator 1 = 1"},{"kind":"theorem","name":"leavittFreeRepresentation_respects","statement":"{x y : LeavittFree} (h : LeavittRelation x y) : leavittFreeRepresentation x = leavittFreeRepresentation y"},{"kind":"theorem","name":"prefix_deletion_ne_one","statement":"prefixOperator 0 * deletionOperator 0 ≠ 1"},{"kind":"theorem","name":"leavittS_mul_T_ne_one","statement":"leavittS 0 * leavittT 0 ≠ 1"},{"kind":"theorem","name":"leavittWordT_mul_wordS_self","statement":"(a : List (Fin 2)) : leavittWordT a * leavittWordS a = 1"},{"kind":"theorem","name":"leavittWordT_mul_wordS_of_incomparable","statement":"(a b : List (Fin 2)) (hab : ¬a <+: b) (hba : ¬b <+: a) : leavittWordT a * leavittWordS b = 0"},{"kind":"theorem","name":"leavittWordS_append","statement":"(a b : List (Fin 2)) : leavittWordS (a ++ b) = leavittWordS a * leavittWordS b"},{"kind":"theorem","name":"leavittWordT_append","statement":"(a b : List (Fin 2)) : leavittWordT (a ++ b) = leavittWordT b * leavittWordT a"},{"kind":"theorem","name":"leavittCylinder_split","statement":"(a : List (Fin 2)) : leavittCylinder a = leavittCylinder (a ++ [0]) + leavittCylinder (a ++ [1])"},{"kind":"theorem","name":"decode_encode","statement":"[DecidableEq ι] (s t : ι → A) (h : ∀ i j, t i * s j = if i = j then 1 else 0) (M : Matrix ι ι A) : decode s t (encode s t M) = M"},{"kind":"theorem","name":"encode_decode","statement":"(s t : ι → A) (x : A) : encode s t (decode s t x) = codeIdempotent s t * x * codeIdempotent s t"},{"kind":"theorem","name":"codeIdempotent_isIdempotent","statement":"[DecidableEq ι] (s t : ι → A) (h : ∀ i j, t i * s j = if i = j then 1 else 0) : IsIdempotentElem (codeIdempotent s t)"},{"kind":"theorem","name":"encode_one","statement":"[DecidableEq ι] (s t : ι → A) : encode s t (1 : Matrix ι ι A) = codeIdempotent s t"},{"kind":"theorem","name":"encode_mul","statement":"[DecidableEq ι] (s t : ι → A) (h : ∀ i j, t i * s j = if i = j then 1 else 0) (M N : Matrix ι ι A) : encode s t (M * N) = encode s t M * encode s t N"},{"kind":"theorem","name":"binaryPrefixCode_orthogonal","statement":"{ι : Type*} [DecidableEq ι] (E : BinaryPrefixCode ι) (i j : ι) : leavittWordT (E.word i) * leavittWordS (E.word j) = if i = j then 1 else 0"},{"kind":"theorem","name":"prefixTable_mul_reverse","statement":"{ι : Type*} [Fintype ι] [DecidableEq ι] (source target : BinaryPrefixCode ι) : prefixTable source target * prefixTable target source = MatrixCorner.codeIdempotent (fun i => leavittWordS (target.word i)) (fun i => leavittWordT (target.word i))"},{"kind":"theorem","name":"alpha_cylinders","statement":"leavittCylinder (alphaWord 0) + leavittCylinder (alphaWord 1) + leavittCylinder (alphaWord 2) = leavittCylinder [0]"},{"kind":"theorem","name":"beta_cylinders","statement":"leavittCylinder (betaWord 0) + leavittCylinder (betaWord 1) + leavittCylinder (betaWord 2) = leavittCylinder [1, 0]"},{"kind":"theorem","name":"nu_cylinders","statement":"leavittCylinder (nuWord 0) + leavittCylinder (nuWord 1) + leavittCylinder (nuWord 2) = leavittCylinder [1, 1]"},{"kind":"theorem","name":"eta_cylinders","statement":"leavittCylinder (etaWord 0) + leavittCylinder (etaWord 1) + leavittCylinder (etaWord 2) = leavittCylinder [1]"},{"kind":"theorem","name":"ninePrefixCode_complete","statement":"MatrixCorner.codeIdempotent (fun i => leavittWordS (ninePrefixCode.word i)) (fun i => leavittWordT (ninePrefixCode.word i)) = 1"},{"kind":"theorem","name":"uPrefixCode_complete","statement":"MatrixCorner.codeIdempotent (fun i => leavittWordS (uPrefixCode.word i)) (fun i => leavittWordT (uPrefixCode.word i)) = 1"},{"kind":"theorem","name":"vPrefixCode_complete","statement":"MatrixCorner.codeIdempotent (fun i => leavittWordS (vPrefixCode.word i)) (fun i => leavittWordT (vPrefixCode.word i)) = 1"},{"kind":"theorem","name":"matrixUnitTransport_root","statement":"{A ι : Type*} [Ring A] [Fintype ι] [DecidableEq ι] (sSource tSource sTarget tTarget : ι → A) (hsource : ∀ i j, tSource i * sSource j = if i = j then 1 else 0) (i j : ι) (a : A) : (∑ k, sTarget k * tSource k) * (sSource i * a * tSource j) * (∑ k, sSource k * tTarget k) = sTarget i * a * tTarget j"},{"kind":"theorem","name":"prefixTable_transport_root","statement":"{ι : Type*} [Fintype ι] [DecidableEq ι] (source target : BinaryPrefixCode ι) (i j : ι) (a : BinaryLeavitt) : prefixTable source target * (leavittWordS (source.word i) * a * leavittWordT (source.word j)) * prefixTable target source = leavittWordS (target.word i) * a * leavittWordT (target.word j)"},{"kind":"theorem","name":"compressionU_conjugate_root","statement":"(i j : Fin 9) (a : BinaryLeavitt) : (compressionU : BinaryLeavitt) * (leavittWordS (nineWord i) * a * leavittWordT (nineWord j)) * (↑(compressionU⁻¹) : BinaryLeavitt) = leavittWordS (uWord i) * a * leavittWordT (uWord j)"},{"kind":"theorem","name":"compressionV_conjugate_root","statement":"(i j : Fin 9) (a : BinaryLeavitt) : (compressionV : BinaryLeavitt) * (leavittWordS (nineWord i) * a * leavittWordT (nineWord j)) * (↑(compressionV⁻¹) : BinaryLeavitt) = leavittWordS (vWord i) * a * leavittWordT (vWord j)"},{"kind":"theorem","name":"nineWord_alphaNineIndex","statement":"(i : Fin 3) : nineWord (alphaNineIndex i) = alphaWord i"},{"kind":"theorem","name":"uWord_alphaNineIndex","statement":"(i : Fin 3) : uWord (alphaNineIndex i) = alphaWord i ++ [0]"},{"kind":"theorem","name":"vWord_alphaNineIndex","statement":"(i : Fin 3) : vWord (alphaNineIndex i) = alphaWord i ++ [0]"},{"kind":"theorem","name":"compressionU_conjugate_alpha_root","statement":"(i j : Fin 3) (a : BinaryLeavitt) : (compressionU : BinaryLeavitt) * (leavittWordS (alphaWord i) * a * leavittWordT (alphaWord j)) * (↑(compressionU⁻¹) : BinaryLeavitt) = leavittWordS (alphaWord i ++ [0]) * a * leavittWordT (alphaWord j ++ [0])"},{"kind":"theorem","name":"compressionV_conjugate_alpha_root","statement":"(i j : Fin 3) (a : BinaryLeavitt) : (compressionV : BinaryLeavitt) * (leavittWordS (alphaWord i) * a * leavittWordT (alphaWord j)) * (↑(compressionV⁻¹) : BinaryLeavitt) = leavittWordS (alphaWord i ++ [0]) * a * leavittWordT (alphaWord j ++ [0])"},{"kind":"theorem","name":"compressionU_conjugate_alpha_elementaryUnit","statement":"(i j : Fin 3) (hij : i ≠ j) (a : BinaryLeavitt) : MulAut.conj compressionU (prefixElementaryUnit alphaPrefixCode i j hij a) = prefixElementaryUnit alphaZeroPrefixCode i j hij a"},{"kind":"theorem","name":"compressionV_conjugate_alpha_elementaryUnit","statement":"(i j : Fin 3) (hij : i ≠ j) (a : BinaryLeavitt) : MulAut.conj compressionV (prefixElementaryUnit alphaPrefixCode i j hij a) = prefixElementaryUnit alphaZeroPrefixCode i j hij a"},{"kind":"theorem","name":"prefixElementaryGroup_map_conj","statement":"{ι : Type*} [DecidableEq ι] (E E' : BinaryPrefixCode ι) (g : BinaryLeavittˣ) (hconj : ∀ (i j : ι) (hij : i ≠ j) (a : BinaryLeavitt), MulAut.conj g (prefixElementaryUnit E i j hij a) = prefixElementaryUnit E' i j hij a) : (prefixElementaryGroup E).map (MulAut.conj g).toMonoidHom = prefixElementaryGroup E'"},{"kind":"theorem","name":"compressionU_map_alphaPrefixElementaryGroup","statement":"(prefixElementaryGroup alphaPrefixCode).map (MulAut.conj compressionU).toMonoidHom = prefixElementaryGroup alphaZeroPrefixCode"},{"kind":"theorem","name":"compressionV_map_alphaPrefixElementaryGroup","statement":"(prefixElementaryGroup alphaPrefixCode).map (MulAut.conj compressionV).toMonoidHom = prefixElementaryGroup alphaZeroPrefixCode"},{"kind":"theorem","name":"alphaZero_prefixElementaryUnit_eq","statement":"(i j : Fin 3) (hij : i ≠ j) (a : BinaryLeavitt) : prefixElementaryUnit alphaZeroPrefixCode i j hij a = prefixElementaryUnit alphaPrefixCode i j hij (leavittS 0 * a * leavittT 0)"},{"kind":"theorem","name":"alphaZero_prefixElementaryGroup_le","statement":"prefixElementaryGroup alphaZeroPrefixCode ≤ prefixElementaryGroup alphaPrefixCode"},{"kind":"theorem","name":"single_mul_self_eq_zero","statement":"(i j : ι) (h : i ≠ j) (a : R) : Matrix.single i j a * Matrix.single i j a = 0"},{"kind":"theorem","name":"elementaryUnit_mul","statement":"(i j : ι) (h : i ≠ j) (a b : R) : elementaryUnit i j h a * elementaryUnit i j h b = elementaryUnit i j h (a + b)"},{"kind":"theorem","name":"elementaryUnit_injective","statement":"(i j : ι) (h : i ≠ j) : Function.Injective (elementaryUnit (R"},{"kind":"theorem","name":"elementaryUnit_mem","statement":"(i j : ι) (h : i ≠ j) (a : R) : elementaryUnit i j h a ∈ elementaryGroup ι R"},{"kind":"theorem","name":"elementaryGroup_infinite","statement":"[Infinite R] (i j : ι) (h : i ≠ j) : Infinite (elementaryGroup ι R)"},{"kind":"theorem","name":"cylinder_transposition_factorization","statement":"[CharP R 2] (P Q : R) (hPP : P * P = 0) (hPQP : P * Q * P = P) : (1 + P) * (1 + Q) * (1 + P) = 1 - P * Q - Q * P + P + Q"},{"kind":"theorem","name":"elementaryUnit_commutator","statement":"(i j k : ι) (hij : i ≠ j) (hjk : j ≠ k) (hik : i ≠ k) (a b : R) : ⁅elementaryUnit i j hij a, elementaryUnit j k hjk b⁆ = elementaryUnit i k hik (a * b)"},{"kind":"theorem","name":"elementaryUnit_mem_of_two_step","statement":"(H : Subgroup (Matrix ι ι R)ˣ) (i j k : ι) (hij : i ≠ j) (hjk : j ≠ k) (hik : i ≠ k) (a : R) (hleft : elementaryUnit i j hij a ∈ H) (hright : elementaryUnit j k hjk 1 ∈ H) : elementaryUnit i k hik a ∈ H"},{"kind":"theorem","name":"mem_finiteElementaryGenerators","statement":"[DecidableEq R] (n : ℕ) (s : Finset R) (z : (Matrix (Fin n) (Fin n) R)ˣ) : z ∈ finiteElementaryGenerators n s ↔ ∃ (i j : Fin n) (h : i ≠ j) (a : R), a ∈ insert 1 s ∧ elementaryUnit i j h a = z"},{"kind":"theorem","name":"elementaryGroup_finitelyGenerated","statement":"[Algebra.FiniteType (ZMod 2) R] (n : ℕ) (hn : 2 < n) : Group.FG (elementaryGroup (Fin n) R)"},{"kind":"theorem","name":"elementaryGroup_three_finitelyGenerated","statement":"[Algebra.FiniteType (ZMod 2) R] : Group.FG (elementaryGroup (Fin 3) R)"},{"kind":"theorem","name":"completePrefixUnitEquiv_elementaryUnit","statement":"{ι : Type*} [Fintype ι] [DecidableEq ι] (E : BinaryPrefixCode ι) (hcomplete : MatrixCorner.codeIdempotent (fun i => leavittWordS (E.word i)) (fun i => leavittWordT (E.word i)) = 1) (i j : ι) (hij : i ≠ j) (a : BinaryLeavitt) : completePrefixUnitEquiv E hcomplete (elementaryUnit i j hij a) = prefixElementaryUnit E i j hij a"},{"kind":"theorem","name":"completePrefixElementaryGroup_map","statement":"{ι : Type*} [Fintype ι] [DecidableEq ι] (E : BinaryPrefixCode ι) (hcomplete : MatrixCorner.codeIdempotent (fun i => leavittWordS (E.word i)) (fun i => leavittWordT (E.word i)) = 1) : (elementaryGroup ι BinaryLeavitt).map (completePrefixUnitEquiv E hcomplete).toMonoidHom = prefixElementaryGroup E"},{"kind":"theorem","name":"idempotentCornerUnitExtension_injective","statement":"{A : Type*} [Ring A] {e : A} (he : IsIdempotentElem e) : Function.Injective (idempotentCornerUnitExtension he)"},{"kind":"theorem","name":"prefixCornerUnitHom_injective","statement":"{ι : Type*} [Fintype ι] [DecidableEq ι] (E : BinaryPrefixCode ι) : Function.Injective (prefixCornerUnitHom E)"},{"kind":"theorem","name":"prefixCornerUnitHom_elementaryUnit","statement":"{ι : Type*} [Fintype ι] [DecidableEq ι] (E : BinaryPrefixCode ι) (i j : ι) (hij : i ≠ j) (a : BinaryLeavitt) : prefixCornerUnitHom E (elementaryUnit i j hij a) = prefixElementaryUnit E i j hij a"},{"kind":"theorem","name":"prefixCornerElementaryGroup_map","statement":"{ι : Type*} [Fintype ι] [DecidableEq ι] (E : BinaryPrefixCode ι) : (elementaryGroup ι BinaryLeavitt).map (prefixCornerUnitHom E) = prefixElementaryGroup E"},{"kind":"theorem","name":"alphaRoot_mem_sourceGenerated","statement":"(i j : Fin 3) (hij : i ≠ j) (a : BinaryLeavitt) : prefixElementaryUnit alphaPrefixCode i j hij a ∈ sourceGeneratedGroup"},{"kind":"theorem","name":"compressionU_mem_sourceGenerated","statement":"compressionU ∈ sourceGeneratedGroup"},{"kind":"theorem","name":"compressionV_mem_sourceGenerated","statement":"compressionV ∈ sourceGeneratedGroup"},{"kind":"theorem","name":"prefixTable_mul_wordS","statement":"{ι : Type*} [Fintype ι] [DecidableEq ι] (source target : BinaryPrefixCode ι) (i : ι) : prefixTable source target * leavittWordS (source.word i) = leavittWordS (target.word i)"},{"kind":"theorem","name":"wordT_mul_prefixTable","statement":"{ι : Type*} [Fintype ι] [DecidableEq ι] (source target : BinaryPrefixCode ι) (i : ι) : leavittWordT (target.word i) * prefixTable source target = leavittWordT (source.word i)"},{"kind":"theorem","name":"leavittWordS_split","statement":"(a : List (Fin 2)) : leavittWordS a = leavittWordS (a ++ [0]) * leavittT 0 + leavittWordS (a ++ [1]) * leavittT 1"},{"kind":"theorem","name":"leavittWordT_split","statement":"(a : List (Fin 2)) : leavittWordT a = leavittS 0 * leavittWordT (a ++ [0]) + leavittS 1 * leavittWordT (a ++ [1])"},{"kind":"theorem","name":"compressionU_inv_mul_alphaWordS","statement":"(i : Fin 3) : (↑(compressionU⁻¹) : BinaryLeavitt) * leavittWordS (alphaWord i) = leavittWordS (alphaWord i) * leavittT 0 + leavittWordS (betaWord i) * leavittT 1"},{"kind":"theorem","name":"alphaWordT_mul_compressionU","statement":"(i : Fin 3) : leavittWordT (alphaWord i) * (compressionU : BinaryLeavitt) = leavittS 0 * leavittWordT (alphaWord i) + leavittS 1 * leavittWordT (betaWord i)"},{"kind":"theorem","name":"alphaBetaNineIndex_ne","statement":"{i j : Fin 3} (hij : i ≠ j) (p q : Fin 2) : alphaBetaNineIndex p i ≠ alphaBetaNineIndex q j"},{"kind":"theorem","name":"binaryBlockSandwich","statement":"(x₀ x₁ y₀ y₁ a : BinaryLeavitt) (p q : Fin 2) : (x₀ * leavittT 0 + x₁ * leavittT 1) * (leavittS p * a * leavittT q) * (leavittS 0 * y₀ + leavittS 1 * y₁) = (if p = 0 then x₀ else x₁) * a * (if q = 0 then y₀ else y₁)"},{"kind":"theorem","name":"alphaBetaRoot_mem_sourceGenerated","statement":"(i j : Fin 3) (hij : i ≠ j) (p q : Fin 2) (a : BinaryLeavitt) : prefixElementaryUnit ninePrefixCode (alphaBetaNineIndex p i) (alphaBetaNineIndex q j) (alphaBetaNineIndex_ne hij p q) a ∈ sourceGeneratedGroup"},{"kind":"theorem","name":"prefixElementaryEntry_mul","statement":"{ι : Type*} [DecidableEq ι] (E : BinaryPrefixCode ι) (i j k l : ι) (a b : BinaryLeavitt) : prefixElementaryEntry E i j a * prefixElementaryEntry E k l b = if j = k then prefixElementaryEntry E i l (a * b) else 0"},{"kind":"theorem","name":"prefixElementaryUnit_commutator","statement":"{ι : Type*} [DecidableEq ι] (E : BinaryPrefixCode ι) (i j k : ι) (hij : i ≠ j) (hjk : j ≠ k) (hik : i ≠ k) (a b : BinaryLeavitt) : ⁅prefixElementaryUnit E i j hij a, prefixElementaryUnit E j k hjk b⁆ = prefixElementaryUnit E i k hik (a * b)"},{"kind":"theorem","name":"prefixElementaryUnit_mem_of_two_step","statement":"{ι : Type*} [DecidableEq ι] (E : BinaryPrefixCode ι) (H : Subgroup BinaryLeavittˣ) (i j k : ι) (hij : i ≠ j) (hjk : j ≠ k) (hik : i ≠ k) (a : BinaryLeavitt) (hleft : prefixElementaryUnit E i j hij a ∈ H) (hright : prefixElementaryUnit E j k hjk 1 ∈ H) : prefixElementaryUnit E i k hik a ∈ H"},{"kind":"theorem","name":"prefixElementaryGroup_le_of_hub","statement":"{ι : Type*} [DecidableEq ι] (E : BinaryPrefixCode ι) (H : Subgroup BinaryLeavittˣ) (k : ι) (hto : ∀ (i : ι) (h : i ≠ k) (a : BinaryLeavitt), prefixElementaryUnit E i k h a ∈ H) (hfrom : ∀ (j : ι) (h : k ≠ j) (a : BinaryLeavitt), prefixElementaryUnit E k j h a ∈ H) : prefixElementaryGroup E ≤ H"},{"kind":"theorem","name":"compressionV_inv_mul_alphaWordS","statement":"(i : Fin 3) : (↑(compressionV⁻¹) : BinaryLeavitt) * leavittWordS (alphaWord i) = leavittWordS (alphaWord i) * leavittT 0 + leavittWordS (nuWord i) * leavittT 1"},{"kind":"theorem","name":"alphaWordT_mul_compressionV","statement":"(i : Fin 3) : leavittWordT (alphaWord i) * (compressionV : BinaryLeavitt) = leavittS 0 * leavittWordT (alphaWord i) + leavittS 1 * leavittWordT (nuWord i)"},{"kind":"theorem","name":"alphaNuNineIndex_ne","statement":"{i j : Fin 3} (hij : i ≠ j) (p q : Fin 2) : alphaNuNineIndex p i ≠ alphaNuNineIndex q j"},{"kind":"theorem","name":"alphaNuRoot_mem_sourceGenerated","statement":"(i j : Fin 3) (hij : i ≠ j) (p q : Fin 2) (a : BinaryLeavitt) : prefixElementaryUnit ninePrefixCode (alphaNuNineIndex p i) (alphaNuNineIndex q j) (alphaNuNineIndex_ne hij p q) a ∈ sourceGeneratedGroup"},{"kind":"theorem","name":"nineRoot_to_alphaHub_mem_sourceGenerated","statement":"(i : Fin 9) (hi : i ≠ 0) (a : BinaryLeavitt) : prefixElementaryUnit ninePrefixCode i 0 hi a ∈ sourceGeneratedGroup"},{"kind":"theorem","name":"nineRoot_from_alphaHub_mem_sourceGenerated","statement":"(i : Fin 9) (hi : (0 : Fin 9) ≠ i) (a : BinaryLeavitt) : prefixElementaryUnit ninePrefixCode 0 i hi a ∈ sourceGeneratedGroup"},{"kind":"theorem","name":"ninePrefixElementaryGroup_le_sourceGenerated","statement":"prefixElementaryGroup ninePrefixCode ≤ sourceGeneratedGroup"},{"kind":"theorem","name":"alphaNineIndex_ne","statement":"{i j : Fin 3} (hij : i ≠ j) : alphaNineIndex i ≠ alphaNineIndex j"},{"kind":"theorem","name":"alphaPrefixElementaryUnit_eq_nine","statement":"(i j : Fin 3) (hij : i ≠ j) (a : BinaryLeavitt) : prefixElementaryUnit alphaPrefixCode i j hij a = prefixElementaryUnit ninePrefixCode (alphaNineIndex i) (alphaNineIndex j) (alphaNineIndex_ne hij) a"},{"kind":"theorem","name":"alphaPrefixElementaryGroup_le_nine","statement":"prefixElementaryGroup alphaPrefixCode ≤ prefixElementaryGroup ninePrefixCode"},{"kind":"theorem","name":"sourceGeneratedGroup_le_nine_of_compressions","statement":"(hu : compressionU ∈ prefixElementaryGroup ninePrefixCode) (hv : compressionV ∈ prefixElementaryGroup ninePrefixCode) : sourceGeneratedGroup ≤ prefixElementaryGroup ninePrefixCode"},{"kind":"theorem","name":"sourceGeneratedGroup_eq_nine_of_compressions","statement":"(hu : compressionU ∈ prefixElementaryGroup ninePrefixCode) (hv : compressionV ∈ prefixElementaryGroup ninePrefixCode) : sourceGeneratedGroup = prefixElementaryGroup ninePrefixCode"},{"kind":"theorem","name":"binaryLeavittMatrixUnitSubgroup_countable","statement":"(n : ℕ) (H : Subgroup (Matrix (Fin n) (Fin n) BinaryLeavitt)ˣ) : Countable H"},{"kind":"theorem","name":"binaryLeavittEL3_finitelyGenerated","statement":"Group.FG (binaryLeavittElementaryGroup 3)"},{"kind":"theorem","name":"binaryLeavittEL3_infinite","statement":"Infinite (binaryLeavittElementaryGroup 3)"},{"kind":"theorem","name":"alphaPrefixElementaryGroup_finitelyGenerated","statement":"Group.FG (prefixElementaryGroup alphaPrefixCode)"},{"kind":"theorem","name":"ninePrefixElementaryGroup_countable","statement":"Countable (prefixElementaryGroup ninePrefixCode)"},{"kind":"theorem","name":"midrankFirstMoment_eq","statement":"(a : ℝ) (ps : List ℝ) : midrankFirstMoment a ps = ((a + ps.sum) ^ 2 - a ^ 2) / 2"},{"kind":"theorem","name":"midrankSecondMoment_eq","statement":"(a : ℝ) (ps : List ℝ) : midrankSecondMoment a ps = ((a + ps.sum) ^ 3 - a ^ 3) / 3 - (ps.map fun p => p ^ 3).sum / 12"},{"kind":"theorem","name":"midrankVariance_eq","statement":"(ps : List ℝ) (hsum : ps.sum = 1) : midrankVariance ps = (1 - (ps.map fun p => p ^ 3).sum) / 12"},{"kind":"theorem","name":"cubeSum_le_dominant_mul_sum","statement":"(ps : List ℝ) (m : ℝ) (hpos : ∀ p ∈ ps, 0 ≤ p) (hone : ∀ p ∈ ps, p ≤ 1) (hdom : ∀ p ∈ ps, p ≤ m) : (ps.map fun p => p ^ 3).sum ≤ m * ps.sum"},{"kind":"theorem","name":"cube_sum_le_dominant_mass","statement":"(ps : List ℝ) (m : ℝ) (hsum : ps.sum = 1) (hpos : ∀ p ∈ ps, 0 ≤ p) (hdom : ∀ p ∈ ps, p ≤ m) : (ps.map fun p => p ^ 3).sum ≤ m"},{"kind":"theorem","name":"midrankVariance_controls_dominant_mass","statement":"(ps : List ℝ) (m : ℝ) (hsum : ps.sum = 1) (hpos : ∀ p ∈ ps, 0 ≤ p) (hdom : ∀ p ∈ ps, p ≤ m) : (1 - m) / 12 ≤ midrankVariance ps"},{"kind":"theorem","name":"weighted_midrank_dominant_mass_le","statement":"{ι : Type*} (I : Finset ι) (weight : ι → ℝ) (q : ι → List ℝ) (m : ι → ℝ) (hweight : ∀ i ∈ I, 0 ≤ weight i) (hsum : ∀ i ∈ I, (q i).sum = 1) (hpositive : ∀ i ∈ I, ∀ x ∈ q i, 0 ≤ x) (hdominant : ∀ i ∈ I, ∀ x ∈ q i, x ≤ m i) : (∑ i ∈ I, weight i * (1 - m i)) ≤ 12 * ∑ i ∈ I, weight i * midrankVariance (q i)"},{"kind":"theorem","name":"componentVertexMidrank_eq_sum_componentRankMass","statement":"{V : Type*} (C : Finset V) (b : V → ℤ) (x : V) : componentVertexMidrank C b x = (∑ j ∈ (C.image b).filter (fun j => j < b x), componentRankMass C b j) + componentRankMass C b (b x) / 2"},{"kind":"theorem","name":"componentRankMass_nonneg","statement":"{V : Type*} (C : Finset V) (b : V → ℤ) (j : ℤ) : 0 ≤ componentRankMass C b j"},{"kind":"theorem","name":"sum_componentRankMass","statement":"{V : Type*} (C : Finset V) (b : V → ℤ) (hC : C.Nonempty) : (∑ j ∈ C.image b, componentRankMass C b j) = 1"},{"kind":"theorem","name":"componentVertexMidrank_nonneg","statement":"{V : Type*} (C : Finset V) (b : V → ℤ) (x : V) : 0 ≤ componentVertexMidrank C b x"},{"kind":"theorem","name":"component_lower_equal_disjoint","statement":"{V : Type*} (C : Finset V) (b : V → ℤ) (x : V) : Disjoint (C.filter fun z => b z < b x) (C.filter fun z => b z = b x)"},{"kind":"theorem","name":"componentVertexMidrank_le_one","statement":"{V : Type*} (C : Finset V) (b : V → ℤ) (x : V) : componentVertexMidrank C b x ≤ 1"},{"kind":"theorem","name":"componentVertexMidrank_mono","statement":"{V : Type*} (C : Finset V) (b : V → ℤ) {x y : V} (hxy : b x ≤ b y) : componentVertexMidrank C b x ≤ componentVertexMidrank C b y"},{"kind":"theorem","name":"sum_map_sort_eq","statement":"{α : Type*} [LinearOrder α] (s : Finset α) (f : α → ℝ) : ((s.sort (· ≤ ·)).map f).sum = ∑ a ∈ s, f a"},{"kind":"theorem","name":"componentRankMassList_sum","statement":"{V : Type*} (C : Finset V) (b : V → ℤ) (hC : C.Nonempty) : (componentRankMassList C b).sum = 1"},{"kind":"theorem","name":"componentRankMassList_nonneg","statement":"{V : Type*} (C : Finset V) (b : V → ℤ) : ∀ p ∈ componentRankMassList C b, 0 ≤ p"},{"kind":"theorem","name":"componentRankMassList_le_max","statement":"{V : Type*} (C : Finset V) (b : V → ℤ) (j : ℤ) (hmax : ∀ k ∈ C.image b, componentRankMass C b k ≤ componentRankMass C b j) : ∀ p ∈ componentRankMassList C b, p ≤ componentRankMass C b j"},{"kind":"theorem","name":"exists_maximal_componentRankMass","statement":"{V : Type*} (C : Finset V) (b : V → ℤ) (hC : C.Nonempty) : ∃ j ∈ C.image b, ∀ k ∈ C.image b, componentRankMass C b k ≤ componentRankMass C b j"},{"kind":"theorem","name":"component_omitted_rank_card_eq","statement":"{V : Type*} (C : Finset V) (b : V → ℤ) (j : ℤ) (hC : C.Nonempty) : ((C.card - (C.filter fun x => b x = j).card : ℕ) : ℝ) = (C.card : ℝ) * (1 - componentRankMass C b j)"},{"kind":"theorem","name":"actual_weighted_midrank_dominant_mass_le","statement":"{V ι : Type*} (I : Finset ι) (C : ι → Finset V) (b : V → ℤ) (j : ι → ℤ) (hC : ∀ i ∈ I, (C i).Nonempty) (hmax : ∀ i ∈ I, ∀ k ∈ (C i).image b, componentRankMass (C i) b k ≤ componentRankMass (C i) b (j i)) : (∑ i ∈ I, (((C i).card - ((C i).filter fun x => b x = j i).card : ℕ) : ℝ)) ≤ 12 * ∑ i ∈ I, ((C i).card : ℝ) * midrankVariance (componentRankMassList (C i) b)"},{"kind":"theorem","name":"exists_maximum_overlap_component","statement":"{V : Type u} [DecidableEq V] {U : Finset V} (Q : Finpartition U) (C : Finset V) (hC : C.Nonempty) (hCU : C ⊆ U) : ∃ D ∈ Q.parts, ∀ E ∈ Q.parts, (C ∩ E).card ≤ (C ∩ D).card"},{"kind":"theorem","name":"sum_card_component_inter_partition","statement":"{V : Type u} [DecidableEq V] {U : Finset V} (Q : Finpartition U) (C : Finset V) (hCU : C ⊆ U) : ∑ D ∈ Q.parts, (C ∩ D).card = C.card"},{"kind":"theorem","name":"maximumOverlapPart_mem","statement":"{V : Type u} [DecidableEq V] {U : Finset V} (Q : Finpartition U) (C : Finset V) (hC : C.Nonempty) (hCU : C ⊆ U) : maximumOverlapPart Q C ∈ Q.parts"},{"kind":"theorem","name":"maximumOverlapPart_maximal","statement":"{V : Type u} [DecidableEq V] {U : Finset V} (Q : Finpartition U) (C : Finset V) (hC : C.Nonempty) (hCU : C ⊆ U) : ∀ E ∈ Q.parts, (C ∩ E).card ≤ (C ∩ maximumOverlapPart Q C).card"},{"kind":"theorem","name":"sourceCrossRoot_mem","statement":"(i j : Fin 9) (h : i ≠ j) (a b : List (Fin 2)) : sourceCrossRoot i j h a b ∈ prefixElementaryGroup ninePrefixCode"},{"kind":"theorem","name":"sourceCrossSwap_mem","statement":"(i j : Fin 9) (h : i ≠ j) (a b : List (Fin 2)) : sourceCrossSwap i j h a b ∈ prefixElementaryGroup ninePrefixCode"},{"kind":"theorem","name":"sourceRefinementOrthogonal","statement":"(i j : Fin 9) (h : i ≠ j) (a b : List (Fin 2)) : leavittWordT (nineWord i ++ a) * leavittWordS (nineWord j ++ b) = 0"},{"kind":"theorem","name":"sourceCrossSwap_val","statement":"(i j : Fin 9) (h : i ≠ j) (a b : List (Fin 2)) : (↑(sourceCrossSwap i j h a b) : BinaryLeavitt) = 1 - leavittWordS (nineWord i ++ a) * leavittWordT (nineWord i ++ a) - leavittWordS (nineWord j ++ b) * leavittWordT (nineWord j ++ b) + leavittWordS (nineWord i ++ a) * leavittWordT (nineWord j ++ b) + leavittWordS (nineWord j ++ b) * leavittWordT (nineWord i ++ a)"},{"kind":"theorem","name":"refinedSourcePrefixCode_complete","statement":"MatrixCorner.codeIdempotent (fun i => leavittWordS (refinedSourcePrefixCode.word i)) (fun i => leavittWordT (refinedSourcePrefixCode.word i)) = 1"},{"kind":"theorem","name":"completePrefixWord_ext","statement":"{ι : Type*} [Fintype ι] (E : BinaryPrefixCode ι) (hcomplete : MatrixCorner.codeIdempotent (fun i => leavittWordS (E.word i)) (fun i => leavittWordT (E.word i)) = 1) (x y : BinaryLeavitt) (haction : ∀ i : ι, x * leavittWordS (E.word i) = y * leavittWordS (E.word i)) : x = y"},{"kind":"theorem","name":"prefixTable_mul_sourceWord","statement":"{ι : Type*} [Fintype ι] [DecidableEq ι] (source target : BinaryPrefixCode ι) (i : ι) : prefixTable source target * leavittWordS (source.word i) = leavittWordS (target.word i)"},{"kind":"theorem","name":"compressionU_mul_nine_refinement","statement":"(i : Fin 9) (r : List (Fin 2)) : (compressionU : BinaryLeavitt) * leavittWordS (nineWord i ++ r) = leavittWordS (uWord i ++ r)"},{"kind":"theorem","name":"refinedSourceWord_eq_parent_append","statement":"(i : Fin 19) : refinedSourceWord i = nineWord (refinedSourceParent i) ++ refinedSourceSuffix i"},{"kind":"theorem","name":"compressionU_mul_refinedSourceWord","statement":"(i : Fin 19) : (compressionU : BinaryLeavitt) * leavittWordS (refinedSourceWord i) = leavittWordS (refinedTargetWord i)"},{"kind":"theorem","name":"leavittWordT_mul_wordS_cancel","statement":"(a b : List (Fin 2)) : leavittWordT a * leavittWordS b = binaryWordCancellation a b"},{"kind":"theorem","name":"leavittWordS_mul_wordS","statement":"(a b : List (Fin 2)) : leavittWordS a * leavittWordS b = leavittWordS (a ++ b)"},{"kind":"theorem","name":"sourceCrossSwap_mul_leavittWordS","statement":"(i j : Fin 9) (h : i ≠ j) (a b x : List (Fin 2)) : (↑(sourceCrossSwap i j h a b) : BinaryLeavitt) * leavittWordS x = leavittWordS x - leavittWordS (nineWord i ++ a) * binaryWordCancellation (nineWord i ++ a) x - leavittWordS (nineWord j ++ b) * binaryWordCancellation (nineWord j ++ b) x + leavittWordS (nineWord i ++ a) * binaryWordCancellation (nineWord j ++ b) x + leavittWordS (nineWord j ++ b) * binaryWordCancellation (nineWord i ++ a) x"},{"kind":"theorem","name":"elementaryCompressionU_mem","statement":"elementaryCompressionU ∈ prefixElementaryGroup ninePrefixCode"},{"kind":"theorem","name":"elementaryCompressionU_mul_refinedSourceWord","statement":"(i : Fin 19) : (elementaryCompressionU : BinaryLeavitt) * leavittWordS (refinedSourceWord i) = leavittWordS (refinedTargetWord i)"},{"kind":"theorem","name":"elementaryCompressionU_eq_compressionU","statement":"elementaryCompressionU = compressionU"},{"kind":"theorem","name":"compressionU_mem_ninePrefixElementaryGroup","statement":"compressionU ∈ prefixElementaryGroup ninePrefixCode"},{"kind":"theorem","name":"compressionU_mem_ninePrefixElementaryGroup","statement":"compressionU ∈ prefixElementaryGroup ninePrefixCode"},{"kind":"theorem","name":"prefixTable_compose","statement":"{ι : Type*} [Fintype ι] [DecidableEq ι] (source middle target : BinaryPrefixCode ι) : prefixTable middle target * prefixTable source middle = prefixTable source target"},{"kind":"theorem","name":"compressionV_eq_transition_mul","statement":"compressionV = compressionTransition * compressionU"},{"kind":"theorem","name":"nineCrossRoot_mem","statement":"(i j : Fin 9) (hij : i ≠ j) (a b : List (Fin 2)) : nineCrossRoot i j hij a b ∈ prefixElementaryGroup ninePrefixCode"},{"kind":"theorem","name":"nineCrossSwap_mem","statement":"(i j : Fin 9) (hij : i ≠ j) (a b : List (Fin 2)) : nineCrossSwap i j hij a b ∈ prefixElementaryGroup ninePrefixCode"},{"kind":"theorem","name":"compressionTransitionCrossSwaps_prod_mem","statement":"compressionTransitionCrossSwaps.prod ∈ prefixElementaryGroup ninePrefixCode"},{"kind":"theorem","name":"transpositionValue_refine","statement":"{A : Type*} [Ring A] (sa ta sb tb p₀ q₀ p₁ q₁ : A) (haa : ta * sa = 1) (hbb : tb * sb = 1) (hab : ta * sb = 0) (hba : tb * sa = 0) (h₀₀ : q₀ * p₀ = 1) (h₁₁ : q₁ * p₁ = 1) (h₀₁ : q₀ * p₁ = 0) (h₁₀ : q₁ * p₀ = 0) (hpartition : p₀ * q₀ + p₁ * q₁ = 1) : transpositionValue (sa * p₀) (q₀ * ta) (sb * p₀) (q₀ * tb) * transpositionValue (sa * p₁) (q₁ * ta) (sb * p₁) (q₁ * tb) = transpositionValue sa ta sb tb"},{"kind":"theorem","name":"nineRefinement_orthogonal","statement":"(i j : Fin 9) (hij : i ≠ j) (a b : List (Fin 2)) : leavittWordT (nineWord i ++ a) * leavittWordS (nineWord j ++ b) = 0"},{"kind":"theorem","name":"nineCrossSwap_val","statement":"(i j : Fin 9) (hij : i ≠ j) (a b : List (Fin 2)) : (↑(nineCrossSwap i j hij a b) : BinaryLeavitt) = transpositionValue (leavittWordS (nineWord i ++ a)) (leavittWordT (nineWord i ++ a)) (leavittWordS (nineWord j ++ b)) (leavittWordT (nineWord j ++ b))"},{"kind":"theorem","name":"wordSwapValue_refine","statement":"(a b : List (Fin 2)) (hab : leavittWordT a * leavittWordS b = 0) (hba : leavittWordT b * leavittWordS a = 0) : wordSwapValue (a ++ [0]) (b ++ [0]) * wordSwapValue (a ++ [1]) (b ++ [1]) = wordSwapValue a b"},{"kind":"theorem","name":"compressionTransitionCrossSwaps_prod_val","statement":"(↑compressionTransitionCrossSwaps.prod : BinaryLeavitt) = wordSwapValue (uWord 1) (uWord 2) * wordSwapValue (uWord 4) (uWord 5) * wordSwapValue (uWord 7) (uWord 8)"},{"kind":"theorem","name":"transpositionValue_mul_codeWord","statement":"{ι : Type*} [DecidableEq ι] (E : BinaryPrefixCode ι) (i j : ι) (hij : i ≠ j) (k : ι) : transpositionValue (leavittWordS (E.word i)) (leavittWordT (E.word i)) (leavittWordS (E.word j)) (leavittWordT (E.word j)) * leavittWordS (E.word k) = if k = i then leavittWordS (E.word j) else if k = j then leavittWordS (E.word i) else leavittWordS (E.word k)"},{"kind":"theorem","name":"uSwap12_mul","statement":"(k : Fin 9) : wordSwapValue (uWord 1) (uWord 2) * leavittWordS (uWord k) = if k = 1 then leavittWordS (uWord 2) else if k = 2 then leavittWordS (uWord 1) else leavittWordS (uWord k)"},{"kind":"theorem","name":"uSwap45_mul","statement":"(k : Fin 9) : wordSwapValue (uWord 4) (uWord 5) * leavittWordS (uWord k) = if k = 4 then leavittWordS (uWord 5) else if k = 5 then leavittWordS (uWord 4) else leavittWordS (uWord k)"},{"kind":"theorem","name":"uSwap78_mul","statement":"(k : Fin 9) : wordSwapValue (uWord 7) (uWord 8) * leavittWordS (uWord k) = if k = 7 then leavittWordS (uWord 8) else if k = 8 then leavittWordS (uWord 7) else leavittWordS (uWord k)"},{"kind":"theorem","name":"compressionTransitionParentSwaps_mul_word","statement":"(k : Fin 9) : (wordSwapValue (uWord 1) (uWord 2) * wordSwapValue (uWord 4) (uWord 5) * wordSwapValue (uWord 7) (uWord 8)) * leavittWordS (uWord k) = leavittWordS (vWord k)"},{"kind":"theorem","name":"compressionTransitionParentSwaps_eq_table","statement":"wordSwapValue (uWord 1) (uWord 2) * wordSwapValue (uWord 4) (uWord 5) * wordSwapValue (uWord 7) (uWord 8) = prefixTable uPrefixCode vPrefixCode"},{"kind":"theorem","name":"compressionTransitionCrossSwaps_prod_eq","statement":"compressionTransitionCrossSwaps.prod = compressionTransition"},{"kind":"theorem","name":"compressionTransition_mem","statement":"compressionTransition ∈ prefixElementaryGroup ninePrefixCode"},{"kind":"theorem","name":"compressionV_mem_of_compressionU","statement":"(hU : compressionU ∈ prefixElementaryGroup ninePrefixCode) : compressionV ∈ prefixElementaryGroup ninePrefixCode"},{"kind":"theorem","name":"compressionV_mem_ninePrefixElementaryGroup","statement":"compressionV ∈ prefixElementaryGroup ninePrefixCode"},{"kind":"theorem","name":"sourceGeneratedGroup_eq_nine","statement":"SourceGeneration.sourceGeneratedGroup = prefixElementaryGroup ninePrefixCode"},{"kind":"theorem","name":"shifted_floor_drop_subset_two_intervals","statement":"(u v H : ℝ) (hH : 0 < H) (k : ℤ) (hk : k = ⌊u / H⌋) : {r : ℝ | r ∈ Set.Ico 0 H ∧ ⌊(v + r) / H⌋ < ⌊(u + r) / H⌋} ⊆ Set.Ico ((k : ℝ) * H - u) ((k : ℝ) * H - v) ∪ Set.Ico (((k + 1 : ℤ) : ℝ) * H - u) (((k + 1 : ℤ) : ℝ) * H - v)"},{"kind":"theorem","name":"measurableSet_shifted_floor_drop","statement":"(u v H : ℝ) : MeasurableSet {r : ℝ | ⌊(v + r) / H⌋ < ⌊(u + r) / H⌋}"},{"kind":"theorem","name":"exists_common_offset_below_average","statement":"(H : ℝ) (hH : 0 < H) (f : ℝ → ℝ) (hf : MeasureTheory.IntegrableOn f (Set.Ico 0 H) MeasureTheory.volume) : ∃ r ∈ Set.Ico 0 H, f r ≤ MeasureTheory.average (MeasureTheory.volume.restrict (Set.Ico 0 H)) f"},{"kind":"theorem","name":"measurable_rankDropCount","statement":"{ι : Type*} [Fintype ι] (u v : ι → ℝ) (H : ℝ) : Measurable (fun r : ℝ => rankDropCount u v H r)"},{"kind":"theorem","name":"rankDropCount_nonneg_and_le","statement":"{ι : Type*} [Fintype ι] (u v : ι → ℝ) (H r : ℝ) : 0 ≤ rankDropCount u v H r ∧ rankDropCount u v H r ≤ (Fintype.card ι : ℝ)"},{"kind":"theorem","name":"integrableOn_rankDropCount","statement":"{ι : Type*} [Fintype ι] (u v : ι → ℝ) (H : ℝ) : MeasureTheory.IntegrableOn (fun r : ℝ => rankDropCount u v H r) (Set.Ico 0 H) MeasureTheory.volume"},{"kind":"theorem","name":"integrable_rankDropIndicator","statement":"(u v H : ℝ) : MeasureTheory.Integrable (fun r : ℝ => if ⌊(v + r) / H⌋ < ⌊(u + r) / H⌋ then (1 : ℝ) else 0) (MeasureTheory.volume.restrict (Set.Ico 0 H))"},{"kind":"theorem","name":"exists_common_rank_offset","statement":"{ι : Type*} [Fintype ι] (u v : ι → ℝ) (H : ℝ) (hH : 0 < H) : ∃ r ∈ Set.Ico 0 H, rankDropCount u v H r ≤ MeasureTheory.average (MeasureTheory.volume.restrict (Set.Ico 0 H)) (fun t : ℝ => rankDropCount u v H t)"},{"kind":"theorem","name":"rankDropCount_integral_eq","statement":"{ι : Type*} [Fintype ι] (u v : ι → ℝ) (H : ℝ) : (∫ r, rankDropCount u v H r ∂(MeasureTheory.volume.restrict (Set.Ico 0 H))) = ∑ i : ι, (MeasureTheory.volume.restrict (Set.Ico 0 H)).real {r : ℝ | ⌊(v i + r) / H⌋ < ⌊(u i + r) / H⌋}"},{"kind":"theorem","name":"rankDropCount_average_eq","statement":"{ι : Type*} [Fintype ι] (u v : ι → ℝ) (H : ℝ) (hH : 0 < H) : MeasureTheory.average (MeasureTheory.volume.restrict (Set.Ico 0 H)) (fun r : ℝ => rankDropCount u v H r) = H⁻¹ * ∑ i : ι, (MeasureTheory.volume.restrict (Set.Ico 0 H)).real {r : ℝ | ⌊(v i + r) / H⌋ < ⌊(u i + r) / H⌋}"},{"kind":"theorem","name":"rankDropCount_clamp_eq","statement":"{ι : Type*} [Fintype ι] (u v : ι → ℝ) (H r : ℝ) (hH : 0 < H) : rankDropCount u v H r = rankDropCount u (fun i => min (v i) (u i)) H r"},{"kind":"theorem","name":"shifted_floor_drop_volume_bound_sharp","statement":"(u v H : ℝ) (hH : 0 < H) (hvu : v ≤ u) : MeasureTheory.volume {r : ℝ | r ∈ Set.Ico 0 H ∧ ⌊(v + r) / H⌋ < ⌊(u + r) / H⌋} ≤ ENNReal.ofReal (u - v)"},{"kind":"theorem","name":"rankDrop_measureReal_bound_sharp","statement":"(u v H : ℝ) (hH : 0 < H) (hvu : v ≤ u) : (MeasureTheory.volume.restrict (Set.Ico 0 H)).real {r : ℝ | ⌊(v + r) / H⌋ < ⌊(u + r) / H⌋} ≤ u - v"},{"kind":"theorem","name":"exists_common_rank_offset_bound_sharp","statement":"{ι : Type*} [Fintype ι] (u v : ι → ℝ) (H : ℝ) (hH : 0 < H) (hvu : ∀ i : ι, v i ≤ u i) : ∃ r ∈ Set.Ico 0 H, rankDropCount u v H r ≤ (1 / H) * ∑ i : ι, (u i - v i)"},{"kind":"theorem","name":"exists_common_rank_offset_one_sided_sharp","statement":"{ι : Type*} [Fintype ι] (u v delta : ι → ℝ) (H : ℝ) (hH : 0 < H) (hdelta : ∀ i : ι, 0 ≤ delta i) (hone : ∀ i : ι, u i - delta i ≤ v i) : ∃ r ∈ Set.Ico 0 H, rankDropCount u v H r ≤ (1 / H) * ∑ i : ι, delta i"},{"kind":"theorem","name":"log_one_sided_of_multiplicative","statement":"(x y eta : ℝ) (hx : 0 < x) (heta0 : 0 ≤ eta) (heta1 : eta < 1) (hcomparison : (1 - eta) * x ≤ y) : Real.log x - |Real.log (1 - eta)| ≤ Real.log y"},{"kind":"theorem","name":"exists_common_log_rank_offset","statement":"{ι : Type*} [Fintype ι] (x y : ι → ℝ) (eta H : ℝ) (hx : ∀ i : ι, 0 < x i) (heta0 : 0 ≤ eta) (heta1 : eta < 1) (hH : 0 < H) (hcomparison : ∀ i : ι, (1 - eta) * x i ≤ y i) : ∃ r ∈ Set.Ico 0 H, rankDropCount (fun i => Real.log (x i)) (fun i => Real.log (y i)) H r ≤ (Fintype.card ι : ℝ) * |Real.log (1 - eta)| / H"},{"kind":"theorem","name":"abs_log_one_sub_le_two_mul","statement":"(eta : ℝ) (heta0 : 0 ≤ eta) (hetaHalf : eta ≤ (1 : ℝ) / 2) : |Real.log (1 - eta)| ≤ 2 * eta"},{"kind":"theorem","name":"abs_log_one_sub_div_tendsto_zero","statement":"(eta H : ℕ → ℝ) (heta0 : ∀ n, 0 ≤ eta n) (hH : ∀ n, 0 < H n) (heta : Filter.Tendsto eta Filter.atTop (nhds 0)) (hratio : Filter.Tendsto (fun n => eta n / H n) Filter.atTop (nhds 0)) : Filter.Tendsto (fun n => |Real.log (1 - eta n)| / H n) Filter.atTop (nhds 0)"},{"kind":"theorem","name":"sum_sub_finiteMean_eq_zero","statement":"{V : Type*} [Fintype V] [Nonempty V] (f : V → ℝ) : (∑ x : V, (f x - finiteMean f)) = 0"},{"kind":"theorem","name":"sum_sq_sub_finiteMean_le","statement":"{V : Type*} [Fintype V] [Nonempty V] (f : V → ℝ) (c : ℝ) : (∑ x : V, (f x - finiteMean f) ^ 2) ≤ ∑ x : V, (f x - c) ^ 2"},{"kind":"theorem","name":"exists_finite_real_median","statement":"{V : Type*} [Fintype V] [Nonempty V] (f : V → ℝ) : ∃ m : ℝ, 2 * (lowerLevel f m).card ≤ Fintype.card V ∧ 2 * (upperLevel f m).card ≤ Fintype.card V"},{"kind":"theorem","name":"positive_max_iff","statement":"(a : ℝ) : 0 < max a 0 ↔ 0 < a"},{"kind":"theorem","name":"positiveSupport_max_sub","statement":"{V : Type*} [Fintype V] (f : V → ℝ) (m : ℝ) : positiveSupport (fun x => max (f x - m) 0) = upperLevel f m"},{"kind":"theorem","name":"positiveSupport_max_sub_reverse","statement":"{V : Type*} [Fintype V] (f : V → ℝ) (m : ℝ) : positiveSupport (fun x => max (m - f x) 0) = lowerLevel f m"},{"kind":"theorem","name":"finiteVariance_nonneg","statement":"{V : Type*} [Fintype V] (f : V → ℝ) : 0 ≤ finiteVariance f"},{"kind":"theorem","name":"card_mul_finiteVariance","statement":"{V : Type*} [Fintype V] [Nonempty V] (f : V → ℝ) : (Fintype.card V : ℝ) * finiteVariance f = ∑ x : V, (f x - finiteMean f) ^ 2"},{"kind":"theorem","name":"idempotentCornerUnitExtensions_commute","statement":"{A : Type*} [Ring A] {e f : A} (he : IsIdempotentElem e) (hf : IsIdempotentElem f) (hef : e * f = 0) (hfe : f * e = 0) (u : he.Cornerˣ) (v : hf.Cornerˣ) : Commute (idempotentCornerUnitExtension he u) (idempotentCornerUnitExtension hf v)"},{"kind":"theorem","name":"idempotentCornerUnitExtensions_eq_one","statement":"{A : Type*} [Ring A] {e f : A} (he : IsIdempotentElem e) (hf : IsIdempotentElem f) (hef : e * f = 0) (u : he.Cornerˣ) (v : hf.Cornerˣ) (h : idempotentCornerUnitExtension he u = idempotentCornerUnitExtension hf v) : idempotentCornerUnitExtension he u = 1"},{"kind":"theorem","name":"idempotentCornerGroup_le_centralizer","statement":"{A : Type*} [Ring A] {e f : A} (he : IsIdempotentElem e) (hf : IsIdempotentElem f) (hef : e * f = 0) (hfe : f * e = 0) : idempotentCornerGroup hf ≤ Subgroup.centralizer (idempotentCornerGroup he : Set Aˣ)"},{"kind":"theorem","name":"idempotentCornerGroup_inf_eq_bot","statement":"{A : Type*} [Ring A] {e f : A} (he : IsIdempotentElem e) (hf : IsIdempotentElem f) (hef : e * f = 0) : idempotentCornerGroup he ⊓ idempotentCornerGroup hf = ⊥"},{"kind":"theorem","name":"leavittCylinder_isIdempotent","statement":"(a : List (Fin 2)) : IsIdempotentElem (leavittCylinder a)"},{"kind":"theorem","name":"leavittCylinder_mul_eq_zero_of_incomparable","statement":"(a b : List (Fin 2)) (hab : ¬ a <+: b) (hba : ¬ b <+: a) : leavittCylinder a * leavittCylinder b = 0"},{"kind":"theorem","name":"prefixElementaryGroup_le_corner","statement":"{ι : Type*} [Fintype ι] [DecidableEq ι] (E : BinaryPrefixCode ι) : prefixElementaryGroup E ≤ prefixCodeCornerGroup E"},{"kind":"theorem","name":"alphaZeroWord_incomparable_local","statement":"(i : Fin 3) : ¬ alphaZeroPrefixCode.word i <+: sourceLocalWord"},{"kind":"theorem","name":"localWord_incomparable_alphaZero","statement":"(i : Fin 3) : ¬ sourceLocalWord <+: alphaZeroPrefixCode.word i"},{"kind":"theorem","name":"alphaZeroCode_mul_localCylinder","statement":"prefixCodeIdempotent alphaZeroPrefixCode * leavittCylinder sourceLocalWord = 0"},{"kind":"theorem","name":"localCylinder_mul_alphaZeroCode","statement":"leavittCylinder sourceLocalWord * prefixCodeIdempotent alphaZeroPrefixCode = 0"},{"kind":"theorem","name":"localCylinderCorner_le_centralizer_alphaZero","statement":"cylinderCornerGroup sourceLocalWord ≤ Subgroup.centralizer (prefixElementaryGroup alphaZeroPrefixCode : Set BinaryLeavittˣ)"},{"kind":"theorem","name":"alphaZero_inf_localCylinderCorner_eq_bot","statement":"prefixElementaryGroup alphaZeroPrefixCode ⊓ cylinderCornerGroup sourceLocalWord = ⊥"},{"kind":"theorem","name":"target_majority_of_small_symmDiff","statement":"{V : Type*} [DecidableEq V] (C D : Finset V) (hsmall : 2 * (C ∆ D).card < C.card) : D.card < 2 * (C ∩ D).card"},{"kind":"theorem","name":"matchedRetainedSupport_nonempty","statement":"{V : Type*} [DecidableEq V] {U : Finset V} (P : Finpartition U) (R : Finset (Finset V)) (hR : R ⊆ P.parts) (hRne : R.Nonempty) : (matchedRetainedSupport R).Nonempty"},{"kind":"theorem","name":"partitionWordCrossing_indexed_sum_card_le_target_add_unmatched","statement":"{V ι : Type*} [DecidableEq V] {U : Finset V} (P Q : Finpartition U) (R : Finset (Finset V)) (hR : R ⊆ P.parts) (D : Finset V → Finset V) (hD : ∀ C ∈ R, D C ∈ Q.parts) (hinj : Set.InjOn D (R : Set (Finset V))) (I : Finset ι) (w : ι → Equiv.Perm V) : (∑ i ∈ I, (partitionWordCrossing P (w i)).card) ≤ (∑ i ∈ I, (partitionWordCrossing Q (w i)).card) + 2 * I.card * (U \\ matchedCore R D).card"},{"kind":"theorem","name":"matchedRetainedSupport_cover_density_tendsto_one","statement":"{V : ℕ → Type*} [∀ n, DecidableEq (V n)] (U : ∀ n, Finset (V n)) (hU : ∀ n, (U n).Nonempty) (P : ∀ n, Finpartition (U n)) (R : ∀ n, Finset (Finset (V n))) (hR : ∀ n, R n ⊆ (P n).parts) (hdiscard : Tendsto (fun n => (((U n \\ matchedRetainedSupport (R n)).card : ℝ) / (U n).card)) atTop (𝓝 0)) : Tendsto (fun n => ((matchedRetainedSupport (R n)).card : ℝ) / (U n).card) atTop (𝓝 1)"},{"kind":"theorem","name":"exists_matched_slow_diagonal_word_errors","statement":"{V : ℕ → Type*} [∀ n, DecidableEq (V n)] {ι : Type*} (U : ∀ n, Finset (V n)) (P Q : ∀ n, Finpartition (U n)) (R : ∀ n, Finset (Finset (V n))) (hR : ∀ n, R n ⊆ (P n).parts) (D : ∀ n, Finset (V n) → Finset (V n)) (hD : ∀ n C, C ∈ R n → D n C ∈ (Q n).parts) (hmajor : ∀ n C, C ∈ R n → (D n C).card < 2 * (C ∩ D n C).card) (hdiscard : Tendsto (fun n => (((U n \\ matchedRetainedSupport (R n)).card : ℝ) / (U n).card)) atTop (𝓝 0)) (hsymm : Tendsto (fun n => ((∑ C ∈ R n, (C ∆ D n C).card : ℕ) : ℝ) / (U n).card) atTop (𝓝 0)) (I : ℕ → Finset ι) (w : ∀ n, ι → Equiv.Perm (V n)) (hword : ∀ k, Tendsto (fun n => ((∑ i ∈ I k, (partitionWordCrossing (Q n) (w n i)).card : ℕ) : ℝ) / (U n).card) atTop (𝓝 0)) (B : ∀ n, ℕ → Finset (V n)) (hbad : ∀ k, Tendsto (fun n => (((U n ∩ B n k).card : ℝ) / (U n).card)) atTop (𝓝 0)) : ∃ r : ℕ → ℕ, Tendsto r atTop atTop ∧ Tendsto (fun n => (((∑ i ∈ I (r n), (partitionWordCrossing (P n) (w n i)).card : ℕ) : ℝ) + (U n ∩ B n (r n)).card) / (U n).card) atTop (𝓝 0)"},{"kind":"theorem","name":"matchedRadiusBad_card_le","statement":"{V ι : Type*} [DecidableEq V] {U : Finset V} (P : Finpartition U) (I : Finset ι) (w : ι → Equiv.Perm V) (B : Finset V) : (U ∩ matchedRadiusBad P I w B).card ≤ (U ∩ B).card + ∑ i ∈ I, (partitionWordCrossing P (w i)).card"},{"kind":"theorem","name":"matched_exists_le_weighted_average","statement":"{ι : Type*} (s : Finset ι) (hs : s.Nonempty) (weight bad : ι → ℝ) (hweight : ∀ i ∈ s, 0 < weight i) : ∃ i ∈ s, bad i / weight i ≤ (∑ j ∈ s, bad j) / (∑ j ∈ s, weight j)"},{"kind":"theorem","name":"matched_sum_card_inter_partition","statement":"{V : Type*} [DecidableEq V] {U : Finset V} (P : Finpartition U) (B : Finset V) : ∑ C ∈ P.parts, (C ∩ B).card = (U ∩ B).card"},{"kind":"theorem","name":"matchedRetained_bad_density_tendsto_zero","statement":"{V : ℕ → Type*} [∀ n, DecidableEq (V n)] (U : ∀ n, Finset (V n)) (hU : ∀ n, (U n).Nonempty) (P : ∀ n, Finpartition (U n)) (R : ∀ n, Finset (Finset (V n))) (hR : ∀ n, R n ⊆ (P n).parts) (hRne : ∀ n, (R n).Nonempty) (hdiscard : Tendsto (fun n => (((U n \\ matchedRetainedSupport (R n)).card : ℝ) / (U n).card)) atTop (𝓝 0)) (B : ∀ n, Finset (V n)) (hbad : Tendsto (fun n => (((U n ∩ B n).card : ℝ) / (U n).card)) atTop (𝓝 0)) : Tendsto (fun n => (((matchedRetainedSupport (R n) ∩ B n).card : ℝ) / (matchedRetainedSupport (R n)).card)) atTop (𝓝 0)"},{"kind":"theorem","name":"matched_eventually_exists_good_vertex","statement":"{V : ℕ → Type*} [∀ n, DecidableEq (V n)] (C B : ∀ n, Finset (V n)) (hC : ∀ n, (C n).Nonempty) (hbad : Tendsto (fun n => (((C n ∩ B n).card : ℝ) / (C n).card)) atTop (𝓝 0)) : ∀ᶠ n in atTop, ∃ x ∈ C n, x ∉ B n"},{"kind":"theorem","name":"sum_weighted_ordered_midpoints_sq","statement":"(s : Finset ℤ) (w : ℤ → ℝ) : (∑ j ∈ s, w j * (lowerRankWeight s w j + w j / 2) ^ 2) = (∑ j ∈ s, w j) ^ 3 / 3 - (∑ j ∈ s, w j ^ 3) / 12"},{"kind":"theorem","name":"twice_lower_rank_pairs_add_equal_rank_pairs","statement":"{V : Type*} (C : Finset V) (b : V → ℤ) : 2 * (∑ x ∈ C, ((C.filter fun z => b z < b x).card : ℝ)) + (∑ x ∈ C, ((C.filter fun z => b z = b x).card : ℝ)) = (C.card : ℝ) ^ 2"},{"kind":"theorem","name":"sum_componentVertexMidrank","statement":"{V : Type*} (C : Finset V) (b : V → ℤ) (hC : C.Nonempty) : (∑ x ∈ C, SoficGroups.componentVertexMidrank C b x) = (C.card : ℝ) / 2"},{"kind":"theorem","name":"componentVertexMidrank_eq_ordered_midpoint","statement":"{V : Type*} (C : Finset V) (b : V → ℤ) (x : V) : SoficGroups.componentVertexMidrank C b x = lowerRankWeight (C.image b) (SoficGroups.componentRankMass C b) (b x) + SoficGroups.componentRankMass C b (b x) / 2"},{"kind":"theorem","name":"sum_componentVertexMidrank_sq_eq","statement":"{V : Type*} (C : Finset V) (b : V → ℤ) (hC : C.Nonempty) : (∑ x ∈ C, SoficGroups.componentVertexMidrank C b x ^ 2) = (C.card : ℝ) * ((1 : ℝ) / 3 - (∑ j ∈ C.image b, SoficGroups.componentRankMass C b j ^ 3) / 12)"},{"kind":"theorem","name":"componentRankMassList_cube_sum","statement":"{V : Type*} (C : Finset V) (b : V → ℤ) : ((SoficGroups.componentRankMassList C b).map fun p => p ^ 3).sum = ∑ j ∈ C.image b, SoficGroups.componentRankMass C b j ^ 3"},{"kind":"theorem","name":"componentVertexMidrank_variance_eq","statement":"{V : Type*} (C : Finset V) (b : V → ℤ) (hC : C.Nonempty) : (∑ x ∈ C, (SoficGroups.componentVertexMidrank C b x - (1 / 2 : ℝ)) ^ 2) = (C.card : ℝ) * SoficGroups.midrankVariance (SoficGroups.componentRankMassList C b)"},{"kind":"theorem","name":"componentVertexMidrank_finiteMean_eq_half","statement":"{V : Type*} (C : Finset V) (b : V → ℤ) (hC : C.Nonempty) : SoficGroups.CheegerPoincare.finiteMean (fun x : {x // x ∈ C} => SoficGroups.componentVertexMidrank C b x) = (1 / 2 : ℝ)"},{"kind":"theorem","name":"componentVertexMidrank_finiteVariance_eq","statement":"{V : Type*} (C : Finset V) (b : V → ℤ) (hC : C.Nonempty) : SoficGroups.CheegerPoincare.finiteVariance (fun x : {x // x ∈ C} => SoficGroups.componentVertexMidrank C b x) = SoficGroups.midrankVariance (SoficGroups.componentRankMassList C b)"},{"kind":"theorem","name":"insufficientOverlapComponents_subset","statement":"{V : Type u} [DecidableEq V] {U : Finset V} (P Q : Finpartition U) (eta : ℝ) : insufficientOverlapComponents P Q eta ⊆ P.parts"},{"kind":"theorem","name":"insufficientOverlapComponents_mass_le_loss","statement":"{V : Type u} [DecidableEq V] {U : Finset V} (P Q : Finpartition U) (eta : ℝ) : eta * (∑ C ∈ insufficientOverlapComponents P Q eta, (C.card : ℝ)) ≤ ∑ C ∈ P.parts, ((C.card : ℝ) - ((C ∩ maximumOverlapPart Q C).card : ℝ))"},{"kind":"theorem","name":"transportedFinpartition_parts","statement":"{V : Type u} [DecidableEq V] {U : Finset V} (Q : Finpartition U) (T : Equiv.Perm V) : (transportedFinpartition Q T).parts = Q.parts.image (fun C : Finset V => C.map T.toEmbedding)"},{"kind":"theorem","name":"transportedUnivFinpartition_parts","statement":"{V : Type u} [Fintype V] [DecidableEq V] (Q : Finpartition (Finset.univ : Finset V)) (T : Equiv.Perm V) : (transportedUnivFinpartition Q T).parts = Q.parts.image (fun C : Finset V => C.map T.toEmbedding)"},{"kind":"theorem","name":"partitionComponentSize_eq_card_of_mem","statement":"{V : Type u} [DecidableEq V] {U : Finset V} (Q : Finpartition U) (C : Finset V) (hC : C ∈ Q.parts) (x : V) (hx : x ∈ C) : partitionComponentSize Q x = C.card"},{"kind":"theorem","name":"partitionComponentSize_transport_lower_of_overlap","statement":"{V : Type u} [DecidableEq V] {U : Finset V} (Q : Finpartition U) (T : Equiv.Perm V) (C D : Finset V) (hC : C ∈ Q.parts) (hD : D ∈ Q.parts) (eta : ℝ) (hoverlap : (1 - eta) * (C.card : ℝ) ≤ (((C.map T.toEmbedding) ∩ D).card : ℝ)) (x : V) (hx : x ∈ C) (hTx : T x ∈ D) : (1 - eta) * (partitionComponentSize Q x : ℝ) ≤ (partitionComponentSize Q (T x) : ℝ)"},{"kind":"theorem","name":"maximumOverlapPart_overlap_of_not_mem_insufficient","statement":"{V : Type u} [DecidableEq V] {U : Finset V} (P Q : Finpartition U) (eta : ℝ) (C : Finset V) (hC : C ∈ P.parts) (hretained : C ∉ insufficientOverlapComponents P Q eta) : (1 - eta) * (C.card : ℝ) ≤ ((C ∩ maximumOverlapPart Q C).card : ℝ)"},{"kind":"theorem","name":"partitionComponentSize_transport_lower_of_retained","statement":"{V : Type u} [Fintype V] [DecidableEq V] (Q : Finpartition (Finset.univ : Finset V)) (T : Equiv.Perm V) (C : Finset V) (hC : C ∈ Q.parts) (eta : ℝ) (hretained : C.map T.toEmbedding ∉ insufficientOverlapComponents (transportedUnivFinpartition Q T) Q eta) (x : V) (hx : x ∈ C) (hTx : T x ∈ maximumOverlapPart Q (C.map T.toEmbedding)) : (1 - eta) * (partitionComponentSize Q x : ℝ) ≤ (partitionComponentSize Q (T x) : ℝ)"},{"kind":"theorem","name":"singletonPrefixCode_codeIdempotent","statement":"(a : List (Fin 2)) : MatrixCorner.codeIdempotent (fun i => leavittWordS ((singletonPrefixCode a).word i)) (fun i => leavittWordT ((singletonPrefixCode a).word i)) = leavittCylinder a"},{"kind":"theorem","name":"prefixInsertionHom_injective","statement":"(a : List (Fin 2)) : Function.Injective (prefixInsertionHom a)"},{"kind":"theorem","name":"leavittCylinder_isIdempotent","statement":"(a : List (Fin 2)) : IsIdempotentElem (leavittCylinder a)"},{"kind":"theorem","name":"cylinderCornerGroup_eq_source","statement":"(a : List (Fin 2)) : cylinderCornerGroup a = ThompsonPrefixLocal.cylinderCornerGroup a"},{"kind":"theorem","name":"prefixInsertionHom_mem_cylinderCorner","statement":"(a : List (Fin 2)) (u : BinaryLeavittˣ) : prefixInsertionHom a u ∈ cylinderCornerGroup a"},{"kind":"theorem","name":"prefixInsertionHom_val","statement":"(a : List (Fin 2)) (u : BinaryLeavittˣ) : (↑(prefixInsertionHom a u) : BinaryLeavitt) = leavittWordS a * (u : BinaryLeavitt) * leavittWordT a + (1 - leavittCylinder a)"},{"kind":"theorem","name":"transpositionValue_mul_self","statement":"{A : Type*} [Ring A] (sa ta sb tb : A) (haa : ta * sa = 1) (hbb : tb * sb = 1) (hab : ta * sb = 0) (hba : tb * sa = 0) : PrefixCompression.transpositionValue sa ta sb tb * PrefixCompression.transpositionValue sa ta sb tb = 1"},{"kind":"theorem","name":"append_not_prefix_append","statement":"(a b x y : List (Fin 2)) (hab : ¬ a <+: b) (hba : ¬ b <+: a) : ¬ a ++ x <+: b ++ y"},{"kind":"theorem","name":"prepend_not_prefix_prepend","statement":"(l a b : List (Fin 2)) (hab : ¬ a <+: b) : ¬ l ++ a <+: l ++ b"},{"kind":"theorem","name":"prefixInsertionHom_cylinderSwap","statement":"(l a b : List (Fin 2)) (hab : ¬ a <+: b) (hba : ¬ b <+: a) : prefixInsertionHom l (cylinderSwap a b hab hba) = cylinderSwap (l ++ a) (l ++ b) (prepend_not_prefix_prepend l a b hab) (prepend_not_prefix_prepend l b a hba)"},{"kind":"theorem","name":"transpositionValue_braid","statement":"{A : Type*} [Ring A] (sa ta sb tb sc tc : A) (haa : ta * sa = 1) (hbb : tb * sb = 1) (hcc : tc * sc = 1) (hab : ta * sb = 0) (hba : tb * sa = 0) (hac : ta * sc = 0) (hca : tc * sa = 0) (hbc : tb * sc = 0) (hcb : tc * sb = 0) : PrefixCompression.transpositionValue sa ta sc tc * PrefixCompression.transpositionValue sb tb sc tc * PrefixCompression.transpositionValue sa ta sc tc = PrefixCompression.transpositionValue sa ta sb tb"},{"kind":"theorem","name":"prefixCrossRoot_mem","statement":"{ι : Type*} [DecidableEq ι] (E : BinaryPrefixCode ι) (i j : ι) (hij : i ≠ j) (a b : List (Fin 2)) : prefixCrossRoot E i j hij a b ∈ prefixElementaryGroup E"},{"kind":"theorem","name":"prefixCrossSwap_mem","statement":"{ι : Type*} [DecidableEq ι] (E : BinaryPrefixCode ι) (i j : ι) (hij : i ≠ j) (a b : List (Fin 2)) : prefixCrossSwap E i j hij a b ∈ prefixElementaryGroup E"},{"kind":"theorem","name":"prefixCrossSwap_val","statement":"{ι : Type*} [DecidableEq ι] (E : BinaryPrefixCode ι) (i j : ι) (hij : i ≠ j) (a b : List (Fin 2)) : (↑(prefixCrossSwap E i j hij a b) : BinaryLeavitt) = PrefixCompression.wordSwapValue (E.word i ++ a) (E.word j ++ b)"},{"kind":"theorem","name":"samePrefixCylinderSwap_mem","statement":"{ι : Type*} [DecidableEq ι] (E : BinaryPrefixCode ι) (i j : ι) (hij : i ≠ j) (a b c : List (Fin 2)) (hab : ¬ a <+: b) (hba : ¬ b <+: a) : cylinderSwap (E.word i ++ a) (E.word i ++ b) (prepend_not_prefix_prepend (E.word i) a b hab) (prepend_not_prefix_prepend (E.word i) b a hba) ∈ prefixElementaryGroup E"},{"kind":"theorem","name":"sourceLocal_cylinderSwap_mem_alpha","statement":"(a b : List (Fin 2)) (hab : ¬ a <+: b) (hba : ¬ b <+: a) : prefixInsertionHom [0, 0, 0, 1] (cylinderSwap a b hab hba) ∈ prefixElementaryGroup alphaPrefixCode"},{"kind":"theorem","name":"localPrefixTranspositionGroup_le_cylinderCorner","statement":"(l : List (Fin 2)) : localPrefixTranspositionGroup l ≤ cylinderCornerGroup l"},{"kind":"theorem","name":"localPrefixTranspositionGroup_le_sourceCylinderCorner","statement":"(l : List (Fin 2)) : localPrefixTranspositionGroup l ≤ ThompsonPrefixLocal.cylinderCornerGroup l"},{"kind":"theorem","name":"sourceLocalPrefixTranspositionGroup_le_alpha","statement":"localPrefixTranspositionGroup [0, 0, 0, 1] ≤ prefixElementaryGroup alphaPrefixCode"},{"kind":"theorem","name":"sourceLocalPrefixTranspositionGroup_le_alpha_sourceWord","statement":"localPrefixTranspositionGroup ThompsonPrefixLocal.sourceLocalWord ≤ prefixElementaryGroup alphaPrefixCode"},{"kind":"theorem","name":"sourceLocalPrefixTranspositionGroup_le_nine","statement":"localPrefixTranspositionGroup ThompsonPrefixLocal.sourceLocalWord ≤ prefixElementaryGroup ninePrefixCode"},{"kind":"theorem","name":"sourceLocalPrefixTranspositionGroup_le_centralizer_alphaZero","statement":"localPrefixTranspositionGroup ThompsonPrefixLocal.sourceLocalWord ≤ Subgroup.centralizer (prefixElementaryGroup alphaZeroPrefixCode : Set BinaryLeavittˣ)"},{"kind":"theorem","name":"alphaZero_inf_sourceLocalPrefixTranspositionGroup_eq_bot","statement":"prefixElementaryGroup alphaZeroPrefixCode ⊓ localPrefixTranspositionGroup ThompsonPrefixLocal.sourceLocalWord = ⊥"},{"kind":"theorem","name":"sourceCompressedLocalProductHom_injective","statement":"Function.Injective sourceCompressedLocalProductHom"},{"kind":"theorem","name":"sourceCompressedLocalProductHom_range_le_nine","statement":"sourceCompressedLocalProductHom.range ≤ prefixElementaryGroup ninePrefixCode"},{"kind":"theorem","name":"sourceCompressedLocalProductEmbedding_injective","statement":"Function.Injective sourceCompressedLocalProductEmbedding"},{"kind":"theorem","name":"rankDropCount_eq_sum_rankDecreasingVertices","statement":"{V ι : Type*} [Fintype V] [Fintype ι] (u : V → ℝ) (p : ι → Equiv.Perm V) (H r : ℝ) : SoficGroups.rankDropCount (fun e : ι × V => u e.2) (fun e : ι × V => u (p e.1 e.2)) H r = ∑ i : ι, ((rankDecreasingVertices Finset.univ (offsetFloorRank u H r) (p i)).card : ℝ)"},{"kind":"theorem","name":"midpointDecreasing_subset_crossing_union_rankDecreasing","statement":"{V : Type*} [DecidableEq V] {U : Finset V} (P : Finpartition U) (b : V → ℤ) (p : Equiv.Perm V) : midpointDecreasingVertices P b p ⊆ partitionWordCrossing P p ∪ rankDecreasingVertices U b p"},{"kind":"theorem","name":"partitionVertexMidrank_permutation_energy_le","statement":"{V : Type*} [Fintype V] [DecidableEq V] (P : Finpartition (Finset.univ : Finset V)) (b : V → ℤ) (p : Equiv.Perm V) : (∑ x : V, (partitionVertexMidrank P b (p x) - partitionVertexMidrank P b x) ^ 2) ≤ 2 * ((partitionWordCrossing P p).card : ℝ) + 2 * ((rankDecreasingVertices Finset.univ b p).card : ℝ)"},{"kind":"theorem","name":"sum_partitionVertexMidrank_permutation_energy_le","statement":"{V ι : Type*} [Fintype V] [DecidableEq V] (I : Finset ι) (P : Finpartition (Finset.univ : Finset V)) (b : V → ℤ) (p : ι → Equiv.Perm V) : (∑ i ∈ I, ∑ x : V, (partitionVertexMidrank P b (p i x) - partitionVertexMidrank P b x) ^ 2) ≤ 2 * (∑ i ∈ I, ((partitionWordCrossing P (p i)).card : ℝ)) + 2 * (∑ i ∈ I, ((rankDecreasingVertices Finset.univ b (p i)).card : ℝ))"},{"kind":"theorem","name":"partitionVertexMidrank_permutation_energy_tendsto_zero","statement":"(V ι : ℕ → Type*) [∀ n, Fintype (V n)] [∀ n, DecidableEq (V n)] [∀ n, Fintype (ι n)] (P : (n : ℕ) → Finpartition (Finset.univ : Finset (V n))) (b : (n : ℕ) → V n → ℤ) (p : (n : ℕ) → ι n → Equiv.Perm (V n)) (N : ℕ → ℝ) (hN : ∀ n, 0 < N n) (hcross : Tendsto (fun n => (∑ i : ι n, ((partitionWordCrossing (P n) (p n i)).card : ℝ)) / N n) atTop (nhds 0)) (hrank : Tendsto (fun n => (∑ i : ι n, ((rankDecreasingVertices Finset.univ (b n) (p n i)).card : ℝ)) / N n) atTop (nhds 0)) : Tendsto (fun n => (∑ i : ι n, ∑ x : V n, (partitionVertexMidrank (P n) (b n) (p n i x) - partitionVertexMidrank (P n) (b n) x) ^ 2) / N n) atTop (nhds 0)"},{"kind":"theorem","name":"selectedRankSupport_subset","statement":"{V : Type*} [DecidableEq V] {U : Finset V} (P : Finpartition U) (b : V → ℤ) (j : Finset V → ℤ) : selectedRankSupport P b j ⊆ U"},{"kind":"theorem","name":"selectedRankSupport_card","statement":"{V : Type*} [DecidableEq V] {U : Finset V} (P : Finpartition U) (b : V → ℤ) (j : Finset V → ℤ) : (selectedRankSupport P b j).card = ∑ C ∈ P.parts, (C.filter fun x => b x = j C).card"},{"kind":"theorem","name":"card_sdiff_selectedRankSupport","statement":"{V : Type*} [DecidableEq V] {U : Finset V} (P : Finpartition U) (b : V → ℤ) (j : Finset V → ℤ) : (U \\ selectedRankSupport P b j).card = ∑ C ∈ P.parts, (C.card - (C.filter fun x => b x = j C).card)"},{"kind":"theorem","name":"selectedRankSupport_rank_eq","statement":"{V : Type*} [DecidableEq V] {U : Finset V} (P : Finpartition U) (b : V → ℤ) (j : Finset V → ℤ) {x : V} (hx : x ∈ selectedRankSupport P b j) : b x = j (P.part x)"},{"kind":"theorem","name":"rankSupportPreimageBad_card_le","statement":"{V : Type*} [DecidableEq V] (U S : Finset V) (w : Equiv.Perm V) : (rankSupportPreimageBad U S w).card ≤ (U \\ S).card"},{"kind":"theorem","name":"rankChangingArc_subset_crossing_or_unselected","statement":"{V : Type*} [DecidableEq V] {U : Finset V} (P : Finpartition U) (b : V → ℤ) (j : Finset V → ℤ) (w : Equiv.Perm V) : rankChangingArc U b w ⊆ partitionWordCrossing P w ∪ (U \\ selectedRankSupport P b j) ∪ rankSupportPreimageBad U (selectedRankSupport P b j) w"},{"kind":"theorem","name":"rankChangingArc_card_le_crossing_add_unselected","statement":"{V : Type*} [DecidableEq V] {U : Finset V} (P : Finpartition U) (b : V → ℤ) (j : Finset V → ℤ) (w : Equiv.Perm V) : (rankChangingArc U b w).card ≤ (partitionWordCrossing P w).card + 2 * (U \\ selectedRankSupport P b j).card"},{"kind":"theorem","name":"rankChangingArc_density_tendsto_zero","statement":"(V : ℕ → Type*) [∀ n, DecidableEq (V n)] (U : ∀ n, Finset (V n)) (P : ∀ n, Finpartition (U n)) (b : ∀ n, V n → ℤ) (j : ∀ n, Finset (V n) → ℤ) (w : ∀ n, Equiv.Perm (V n)) (N : ℕ → ℝ) (hN : ∀ n, 0 < N n) (hcross : Filter.Tendsto (fun n => ((partitionWordCrossing (P n) (w n)).card : ℝ) / N n) Filter.atTop (nhds 0)) (homit : Filter.Tendsto (fun n => (((U n \\ selectedRankSupport (P n) (b n) (j n)).card : ℝ) / N n)) Filter.atTop (nhds 0)) : Filter.Tendsto (fun n => ((rankChangingArc (U n) (b n) (w n)).card : ℝ) / N n) Filter.atTop (nhds 0)"},{"kind":"theorem","name":"permutationDistance_self","statement":"{V : Type*} [Fintype V] [DecidableEq V] (p : Equiv.Perm V) : permutationDistance p p = 0"},{"kind":"theorem","name":"permutationDistance_comm","statement":"{V : Type*} [Fintype V] [DecidableEq V] (p q : Equiv.Perm V) : permutationDistance p q = permutationDistance q p"},{"kind":"theorem","name":"permutationDistance_triangle","statement":"{V : Type*} [Fintype V] [DecidableEq V] (p q r : Equiv.Perm V) : permutationDistance p r ≤ permutationDistance p q + permutationDistance q r"},{"kind":"theorem","name":"permutationDistance_mul_left","statement":"{V : Type*} [Fintype V] [DecidableEq V] (s p q : Equiv.Perm V) : permutationDistance (s * p) (s * q) = permutationDistance p q"},{"kind":"theorem","name":"permutationDistance_mul_right","statement":"{V : Type*} [Fintype V] [DecidableEq V] (s p q : Equiv.Perm V) : permutationDistance (p * s) (q * s) = permutationDistance p q"},{"kind":"theorem","name":"permutationDistance_mul_le","statement":"{V : Type*} [Fintype V] [DecidableEq V] (p p' q q' : Equiv.Perm V) : permutationDistance (p * q) (p' * q') ≤ permutationDistance p p' + permutationDistance q q'"},{"kind":"theorem","name":"permutationDistance_inv","statement":"{V : Type*} [Fintype V] [DecidableEq V] (p q : Equiv.Perm V) : permutationDistance p⁻¹ q⁻¹ = permutationDistance p q"},{"kind":"theorem","name":"permutationCommutationDefect_one","statement":"{V ι : Type*} [Fintype V] [Fintype ι] [DecidableEq V] (σ : ι → Equiv.Perm V) : permutationCommutationDefect σ 1 = 0"},{"kind":"theorem","name":"permutationCommutationDefect_inv","statement":"{V ι : Type*} [Fintype V] [Fintype ι] [DecidableEq V] (σ : ι → Equiv.Perm V) (c : Equiv.Perm V) : permutationCommutationDefect σ c⁻¹ = permutationCommutationDefect σ c"},{"kind":"theorem","name":"permutationCommutationDefect_mul_le","statement":"{V ι : Type*} [Fintype V] [Fintype ι] [DecidableEq V] (σ : ι → Equiv.Perm V) (p q : Equiv.Perm V) : permutationCommutationDefect σ (p * q) ≤ permutationCommutationDefect σ p + permutationCommutationDefect σ q"},{"kind":"theorem","name":"AlmostCentralizerElement.ext","statement":"{V ι : Type*} [Fintype V] [Fintype ι] [DecidableEq V] {σ : ι → Equiv.Perm V} {tolerance : ℕ} (p q : AlmostCentralizerElement σ tolerance) (h : p.permutation = q.permutation) : p = q"},{"kind":"theorem","name":"almostCentralizerGap_of_expansion","statement":"{V ι : Type*} [Fintype V] [Fintype ι] [DecidableEq V] (σ : ι → Equiv.Perm V) (tolerance : ℕ) (h : ℝ) (hpositive : 0 < h) (hexp : ∀ A : Finset V, h * min (A.card : ℝ) ((Fintype.card V : ℝ) - A.card) ≤ (boundary σ A : ℝ)) (hsmall : (10 : ℝ) * tolerance < h * Fintype.card V) : AlmostCentralizerGap σ tolerance"},{"kind":"theorem","name":"almostCentralizerCluster_eq_iff","statement":"{V ι : Type*} [Fintype V] [Fintype ι] [DecidableEq V] {σ : ι → Equiv.Perm V} {tolerance : ℕ} (hgap : AlmostCentralizerGap σ tolerance) (p q : AlmostCentralizerElement σ tolerance) : almostCentralizerCluster hgap p = almostCentralizerCluster hgap q ↔ 5 * permutationDistance p.permutation q.permutation ≤ Fintype.card V"},{"kind":"theorem","name":"correctedAlmostCentralizerProduct_congr","statement":"{V ι : Type*} [Fintype V] [Fintype ι] [DecidableEq V] {σ : ι → Equiv.Perm V} {tolerance : ℕ} (hgap : AlmostCentralizerGap σ tolerance) (R : AlmostCentralizerRepair σ tolerance) {p p' q q' : AlmostCentralizerElement σ tolerance} (hp : 5 * permutationDistance p.permutation p'.permutation ≤ Fintype.card V) (hq : 5 * permutationDistance q.permutation q'.permutation ≤ Fintype.card V) : 5 * permutationDistance (correctedAlmostCentralizerProduct R p q).permutation (correctedAlmostCentralizerProduct R p' q').permutation ≤ Fintype.card V"},{"kind":"theorem","name":"correctedAlmostCentralizerProduct_assoc","statement":"{V ι : Type*} [Fintype V] [Fintype ι] [DecidableEq V] {σ : ι → Equiv.Perm V} {tolerance : ℕ} (hgap : AlmostCentralizerGap σ tolerance) (R : AlmostCentralizerRepair σ tolerance) (p q r : AlmostCentralizerElement σ tolerance) : 5 * permutationDistance (correctedAlmostCentralizerProduct R (correctedAlmostCentralizerProduct R p q) r).permutation (correctedAlmostCentralizerProduct R p (correctedAlmostCentralizerProduct R q r)).permutation ≤ Fintype.card V"},{"kind":"theorem","name":"exists_finite_group_embedding_of_expanding_centralizer","statement":"{G : Type*} [Group G] (F : Finset G) (M : ExpandingCentralizerFiniteModel G F) : ∃ (H : Type) (_ : Group H) (_ : Finite H) (f : G → H), Set.InjOn f (F : Set G) ∧ f 1 = 1 ∧ ∀ x ∈ F, ∀ y ∈ F, f (x * y) = f x * f y"},{"kind":"theorem","name":"exists_permutation_embedding_of_expanding_centralizer","statement":"{G : Type*} [Group G] (F : Finset G) (M : ExpandingCentralizerFiniteModel G F) : ∃ (n : ℕ) (f : G → Equiv.Perm (Fin n)), Set.InjOn f (F : Set G) ∧ f 1 = 1 ∧ ∀ x ∈ F, ∀ y ∈ F, f (x * y) = f x * f y"},{"kind":"theorem","name":"lef_of_expanding_centralizer_models","statement":"{G : Type*} [Group G] (hmodels : ∀ F : Finset G, Nonempty (ExpandingCentralizerFiniteModel G F)) : LEF G"},{"kind":"theorem","name":"exists_positive_antitone_slow_vanishing_threshold","statement":"(e : ℕ → ℝ) (he_nonneg : ∀ n, 0 ≤ e n) (he : Tendsto e atTop (nhds 0)) : ∃ eta : ℕ → ℝ, (∀ n, 0 < eta n) ∧ Antitone eta ∧ Tendsto eta atTop (nhds 0) ∧ Tendsto (fun n => e n / eta n) atTop (nhds 0)"},{"kind":"theorem","name":"exists_positive_antitone_slow_overlap_scales","statement":"(e : ℕ → ℝ) (he_nonneg : ∀ n, 0 ≤ e n) (he : Tendsto e atTop (nhds 0)) : ∃ eta H : ℕ → ℝ, (∀ n, 0 < eta n) ∧ Antitone eta ∧ Tendsto eta atTop (nhds 0) ∧ (∀ n, 0 < H n) ∧ Antitone H ∧ Tendsto H atTop (nhds 0) ∧ Tendsto (fun n => e n / eta n) atTop (nhds 0) ∧ Tendsto (fun n => eta n / H n) atTop (nhds 0)"},{"kind":"theorem","name":"rankDropCount_goodSubtype_eq","statement":"{ι : Type*} (G : Finset ι) (u v : ι → ℝ) (H r : ℝ) : SoficGroups.rankDropCount (fun i : {i // i ∈ G} => u i.1) (fun i : {i // i ∈ G} => v i.1) H r = ∑ i ∈ G, if ⌊(v i + r) / H⌋ < ⌊(u i + r) / H⌋ then (1 : ℝ) else 0"},{"kind":"theorem","name":"rankDropCount_le_goodSubtype_add_exceptions","statement":"{ι : Type*} [Fintype ι] [DecidableEq ι] (G : Finset ι) (u v : ι → ℝ) (H r : ℝ) : SoficGroups.rankDropCount u v H r ≤ SoficGroups.rankDropCount (fun i : {i // i ∈ G} => u i.1) (fun i : {i // i ∈ G} => v i.1) H r + (((Finset.univ : Finset ι) \\ G).card : ℝ)"},{"kind":"theorem","name":"exists_common_log_rank_offset_except","statement":"{ι : Type*} [Fintype ι] [DecidableEq ι] (G : Finset ι) (x y : ι → ℝ) (eta H : ℝ) (hx : ∀ i ∈ G, 0 < x i) (heta0 : 0 ≤ eta) (heta1 : eta < 1) (hH : 0 < H) (hcomparison : ∀ i ∈ G, (1 - eta) * x i ≤ y i) : ∃ r ∈ Set.Ico 0 H, SoficGroups.rankDropCount (fun i => Real.log (x i)) (fun i => Real.log (y i)) H r ≤ (G.card : ℝ) * |Real.log (1 - eta)| / H + (((Finset.univ : Finset ι) \\ G).card : ℝ)"},{"kind":"theorem","name":"exists_common_log_rank_offsets_tendsto_zero_except","statement":"(ι : ℕ → Type*) [∀ n, Fintype (ι n)] [∀ n, DecidableEq (ι n)] (G : (n : ℕ) → Finset (ι n)) (x y : (n : ℕ) → ι n → ℝ) (eta H N : ℕ → ℝ) (C : ℝ) (hx : ∀ n i, i ∈ G n → 0 < x n i) (heta0 : ∀ n, 0 ≤ eta n) (heta1 : ∀ n, eta n < 1) (hH : ∀ n, 0 < H n) (hN : ∀ n, 0 < N n) (hcard : ∀ n, ((G n).card : ℝ) ≤ C * N n) (hcomparison : ∀ n i, i ∈ G n → (1 - eta n) * x n i ≤ y n i) (heta : Tendsto eta atTop (nhds 0)) (hratio : Tendsto (fun n => eta n / H n) atTop (nhds 0)) (hexceptions : Tendsto (fun n => (((Finset.univ : Finset (ι n)) \\ G n).card : ℝ) / N n) atTop (nhds 0)) : ∃ r : ℕ → ℝ, (∀ n, r n ∈ Set.Ico 0 (H n)) ∧ Tendsto (fun n => SoficGroups.rankDropCount (fun i => Real.log (x n i)) (fun i => Real.log (y n i)) (H n) (r n) / N n) atTop (nhds 0)"},{"kind":"theorem","name":"cylinderSwap_mul_wordS_right","statement":"(a b : List (Fin 2)) (hab : ¬ a <+: b) (hba : ¬ b <+: a) : (↑(cylinderSwap a b hab hba) : BinaryLeavitt) * leavittWordS b = leavittWordS a"},{"kind":"theorem","name":"elementaryMatrixUnitMap_elementaryUnit","statement":"(f : R →+* S) (i j : ι) (hij : i ≠ j) (a : R) : elementaryMatrixUnitMap f (elementaryUnit i j hij a) = elementaryUnit i j hij (f a)"},{"kind":"theorem","name":"elementaryGroup_map_le","statement":"(f : R →+* S) : (elementaryGroup ι R).map (elementaryMatrixUnitMap f) ≤ elementaryGroup ι S"},{"kind":"theorem","name":"elementaryGroup_map_eq_of_surjective","statement":"(f : R →+* S) (hf : Function.Surjective f) : (elementaryGroup ι R).map (elementaryMatrixUnitMap f) = elementaryGroup ι S"},{"kind":"theorem","name":"normalizedHamming_distinct_tendsto","statement":"{G : Type*} [Group G] (A : SoficGroups.SoficApproximation G) {g h : G} (hne : g ≠ h) : Tendsto (fun n => SoficGroups.normalizedHamming ((A.model n).action g) ((A.model n).action h)) atTop (𝓝 1)"},{"kind":"theorem","name":"one_mem_productTrackedTable","statement":"{J : Type*} [Group J] (F : Finset J) : 1 ∈ productTrackedTable F"},{"kind":"theorem","name":"mem_productTrackedTable","statement":"{J : Type*} [Group J] {F : Finset J} {j : J} (hj : j ∈ F) : j ∈ productTrackedTable F"},{"kind":"theorem","name":"mul_mem_productTrackedTable","statement":"{J : Type*} [Group J] {F : Finset J} {x y : J} (hx : x ∈ F) (hy : y ∈ F) : x * y ∈ productTrackedTable F"},{"kind":"theorem","name":"mem_permutationGraph","statement":"{V : Type*} [Fintype V] [DecidableEq V] (p : Equiv.Perm V) (x y : V) : (x, y) ∈ permutationGraph p ↔ y = p x"},{"kind":"theorem","name":"boundary_permutationGraph_eq_commutationDefect","statement":"{V ι : Type*} [Fintype V] [Fintype ι] [DecidableEq V] (σ : ι → Equiv.Perm V) (p : Equiv.Perm V) : boundary (fun i => (σ i).prodCongr (σ i)) (permutationGraph p) = permutationCommutationDefect σ p"},{"kind":"theorem","name":"kazhdan_generator_displacement","statement":"{G : Type u} {H : Type v} [Group G] [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H] (P : KazhdanPair.{u, v} G) (π : UnitaryRepresentation G H) (hfixed : ∀ η : H, (∀ g : G, π g η = η) → η = 0) (ξ : H) (hξ : ξ ≠ 0) : ∃ g ∈ P.generators, P.kazhdanConstant * ‖ξ‖ ≤ ‖π g ξ - ξ‖"},{"kind":"theorem","name":"prefixWordAction_append","statement":"{g : BinaryLeavittˣ} {a b : List (Fin 2)} (h : PrefixWordAction g a b) (r : List (Fin 2)) : PrefixWordAction g (a ++ r) (b ++ r)"},{"kind":"theorem","name":"prefixWordAction_mul","statement":"{g h : BinaryLeavittˣ} {a b c : List (Fin 2)} (hg : PrefixWordAction g b c) (hh : PrefixWordAction h a b) : PrefixWordAction (g * h) a c"},{"kind":"theorem","name":"cylinderSwap_prefixWordAction_left","statement":"(a b : List (Fin 2)) (hab : ¬ a <+: b) (hba : ¬ b <+: a) : PrefixWordAction (cylinderSwap a b hab hba) a b"},{"kind":"theorem","name":"cylinderSwap_prefixWordAction_right","statement":"(a b : List (Fin 2)) (hab : ¬ a <+: b) (hba : ¬ b <+: a) : PrefixWordAction (cylinderSwap a b hab hba) b a"},{"kind":"theorem","name":"cylinderSwap_prefixWordAction_fixed","statement":"(a b w : List (Fin 2)) (hab : ¬ a <+: b) (hba : ¬ b <+: a) (haw : ¬ a <+: w) (hwa : ¬ w <+: a) (hbw : ¬ b <+: w) (hwb : ¬ w <+: b) : PrefixWordAction (cylinderSwap a b hab hba) w w"},{"kind":"theorem","name":"prefixInsertionHom_conjugate_of_prefixWordAction","statement":"(g : BinaryLeavittˣ) (a b : List (Fin 2)) (h : PrefixWordAction g a b) (u : BinaryLeavittˣ) : g * prefixInsertionHom a u * g⁻¹ = prefixInsertionHom b u"},{"kind":"theorem","name":"prefixInsertionHom_mem_binaryPrefixTranspositionGroup","statement":"(a : List (Fin 2)) (u : BinaryLeavittˣ) (hu : u ∈ binaryPrefixTranspositionGroup) : prefixInsertionHom a u ∈ binaryPrefixTranspositionGroup"},{"kind":"theorem","name":"elementaryBlockUnitEquiv_elementaryUnit_single","statement":"(i j : ι) (hij : i ≠ j) (k l : κ) (a : R) : elementaryBlockUnitEquiv (ι"},{"kind":"theorem","name":"elementaryBlockUnitEquiv_elementaryUnit_mem","statement":"(i j : ι) (hij : i ≠ j) (A : Matrix κ κ R) : elementaryBlockUnitEquiv (ι"},{"kind":"theorem","name":"elementaryBlockGroup_map","statement":"[Nontrivial ι] : (elementaryGroup ι (Matrix κ κ R)).map (elementaryBlockUnitEquiv (ι"},{"kind":"theorem","name":"elementaryReindexUnitEquiv_elementaryUnit","statement":"(e : ι ≃ κ) (i j : ι) (hij : i ≠ j) (a : R) : elementaryReindexUnitEquiv (R"},{"kind":"theorem","name":"elementaryReindexGroup_map","statement":"(e : ι ≃ κ) : (elementaryGroup ι R).map (elementaryReindexUnitEquiv (R"},{"kind":"theorem","name":"ternaryLeavittPrefixCode_complete","statement":"MatrixCorner.codeIdempotent (fun i => leavittWordS (ternaryLeavittPrefixCode.word i)) (fun i => leavittWordT (ternaryLeavittPrefixCode.word i)) = 1"},{"kind":"theorem","name":"binaryLeavittElementaryThree_hasPropertyT_of_nine","statement":"[HasPropertyT.{0, v} (binaryLeavittElementaryGroup 9)] : HasPropertyT.{0, v} (binaryLeavittElementaryGroup 3)"},{"kind":"theorem","name":"alphaPrefixElementaryGroup_hasPropertyT_of_nine","statement":"[HasPropertyT.{0, v} (binaryLeavittElementaryGroup 9)] : HasPropertyT.{0, v} (prefixElementaryGroup alphaPrefixCode)"},{"kind":"theorem","name":"alphaZeroPrefixElementaryGroup_hasPropertyT_of_nine","statement":"[HasPropertyT.{0, v} (binaryLeavittElementaryGroup 9)] : HasPropertyT.{0, v} (prefixElementaryGroup alphaZeroPrefixCode)"},{"kind":"theorem","name":"cylinderSwap_prefixWordAction_of_cases","statement":"{a b w v : List (Fin 2)} (hab : ¬ a <+: b) (hba : ¬ b <+: a) (hcase : (a <+: w ∧ v = b ++ w.drop a.length) ∨ (b <+: w ∧ v = a ++ w.drop b.length) ∨ (v = w ∧ ¬ a <+: w ∧ ¬ w <+: a ∧ ¬ b <+: w ∧ ¬ w <+: b)) : PrefixWordAction (cylinderSwap a b hab hba) w v"},{"kind":"theorem","name":"three_pair_sum_norm_sq","statement":"(a b c : H) : ‖a + b‖ ^ 2 + ‖b + c‖ ^ 2 + ‖c + a‖ ^ 2 = ‖a + b + c‖ ^ 2 + (‖a‖ ^ 2 + ‖b‖ ^ 2 + ‖c‖ ^ 2)"},{"kind":"theorem","name":"norm_add_three_sq_le_three_mul","statement":"(a b c : H) : ‖a + b + c‖ ^ 2 ≤ 3 * (‖a‖ ^ 2 + ‖b‖ ^ 2 + ‖c‖ ^ 2)"},{"kind":"theorem","name":"three_pairwise_residual_spectral_gap","statement":"(a b c : H) (ε : ℝ) (hab : (1 - ε) * (‖a‖ ^ 2 + ‖b‖ ^ 2) ≤ ‖a + b‖ ^ 2) (hbc : (1 - ε) * (‖b‖ ^ 2 + ‖c‖ ^ 2) ≤ ‖b + c‖ ^ 2) (hca : (1 - ε) * (‖c‖ ^ 2 + ‖a‖ ^ 2) ≤ ‖c + a‖ ^ 2) : (1 - 2 * ε) * (‖a‖ ^ 2 + ‖b‖ ^ 2 + ‖c‖ ^ 2) ≤ ‖a + b + c‖ ^ 2"},{"kind":"theorem","name":"inner_sq_le_of_orthogonal_two_sector","statement":"(a₀ a₁ b₀ b₁ : H) (ha : inner ℂ a₀ a₁ = 0) (hb : inner ℂ b₀ b₁ = 0) (hcross₀ : inner ℂ a₀ b₁ = 0) (hcross₁ : inner ℂ a₁ b₀ = 0) (h₀ : 8 * ‖inner ℂ a₀ b₀‖ ^ 2 ≤ ‖a₀‖ ^ 2 * ‖b₀‖ ^ 2) (h₁ : 8 * ‖inner ℂ a₁ b₁‖ ^ 2 ≤ ‖a₁‖ ^ 2 * ‖b₁‖ ^ 2) : 8 * ‖inner ℂ (a₀ + a₁) (b₀ + b₁)‖ ^ 2 ≤ ‖a₀ + a₁‖ ^ 2 * ‖b₀ + b₁‖ ^ 2"},{"kind":"theorem","name":"inner_sq_le_of_finite_orthogonal_sector_splitting","statement":"{ι : Type*} [Fintype ι] (F : ι → Submodule ℂ H) [∀ i, (F i).HasOrthogonalProjection] (U V : Submodule ℂ H) (hU : ∀ (i : ι) ⦃x : H⦄, x ∈ U → (F i).starProjection x ∈ U) (hV : ∀ (i : ι) ⦃x : H⦄, x ∈ V → (F i).starProjection x ∈ V) (hF : ∀ (i j : ι) ⦃x : H⦄, x ∈ F j → (F i).starProjection x ∈ F j) (hsector : ∀ (i : ι) (a b : H), a ∈ U → b ∈ V → a ∈ (F i)ᗮ → b ∈ (F i)ᗮ → 8 * ‖inner ℂ a b‖ ^ 2 ≤ ‖a‖ ^ 2 * ‖b‖ ^ 2) (hterminal : ∀ (a b : H), a ∈ U → b ∈ V → (∀ i, a ∈ F i) → (∀ i, b ∈ F i) → inner ℂ a b = 0) (a b : H) (ha : a ∈ U) (hb : b ∈ V) : 8 * ‖inner ℂ a b‖ ^ 2 ≤ ‖a‖ ^ 2 * ‖b‖ ^ 2"},{"kind":"theorem","name":"ejStarProjection_re_inner","statement":"(W : Submodule ℂ H) [W.HasOrthogonalProjection] (x : H) : RCLike.re (inner ℂ (W.starProjection x) x) = ‖W.starProjection x‖ ^ 2"},{"kind":"theorem","name":"ejResidualProjection_apply","statement":"(V : Submodule ℂ H) [V.HasOrthogonalProjection] (x : H) : ejResidualProjection V x = x - V.starProjection x"},{"kind":"theorem","name":"ejResidualProjection_idempotent","statement":"(V : Submodule ℂ H) [V.HasOrthogonalProjection] (x : H) : ejResidualProjection V (ejResidualProjection V x) = ejResidualProjection V x"},{"kind":"theorem","name":"ejResidualProjection_inner","statement":"(V : Submodule ℂ H) [V.HasOrthogonalProjection] (x y : H) : inner ℂ (ejResidualProjection V x) y = inner ℂ x (ejResidualProjection V y)"},{"kind":"theorem","name":"ejResidualProjection_re_inner","statement":"(V : Submodule ℂ H) [V.HasOrthogonalProjection] (x : H) : RCLike.re (inner ℂ (ejResidualProjection V x) x) = ‖ejResidualProjection V x‖ ^ 2"},{"kind":"theorem","name":"ejThreeResidualMap_apply","statement":"(x : H) : ejThreeResidualMap V x = ejResidualProjection (V 0) x + ejResidualProjection (V 1) x + ejResidualProjection (V 2) x"},{"kind":"theorem","name":"ejThreeProjectionAverage_apply","statement":"(x : H) : ejThreeProjectionAverage V x = x - (3 : ℂ)⁻¹ • ejThreeResidualMap V x"},{"kind":"theorem","name":"ejThreeResidualEnergy_nonneg","statement":"(x : H) : 0 ≤ ejThreeResidualEnergy V x"},{"kind":"theorem","name":"ejThreeResidualEnergy_eq_re_inner","statement":"(x : H) : ejThreeResidualEnergy V x = RCLike.re (inner ℂ (ejThreeResidualMap V x) x)"},{"kind":"theorem","name":"ejThreeResidualMap_norm_sq_le","statement":"(x : H) : ‖ejThreeResidualMap V x‖ ^ 2 ≤ 3 * ejThreeResidualEnergy V x"},{"kind":"theorem","name":"ejResidualProjection_norm_le","statement":"(i : Fin 3) (x : H) : ‖ejResidualProjection (V i) x‖ ≤ ‖x‖"},{"kind":"theorem","name":"ejThreeResidualEnergy_le_three_norm_sq","statement":"(x : H) : ejThreeResidualEnergy V x ≤ 3 * ‖x‖ ^ 2"},{"kind":"theorem","name":"ejResidualProjection_cross_inner","statement":"(W : Submodule ℂ H) [W.HasOrthogonalProjection] (x z : H) : inner ℂ (ejResidualProjection W x) (ejResidualProjection W z) = inner ℂ (ejResidualProjection W x) z"},{"kind":"theorem","name":"ejThreeResidual_cross_re_inner","statement":"(x : H) : RCLike.re (inner ℂ (ejResidualProjection (V 0) x) (ejResidualProjection (V 0) (ejThreeResidualMap V x))) + RCLike.re (inner ℂ (ejResidualProjection (V 1) x) (ejResidualProjection (V 1) (ejThreeResidualMap V x))) + RCLike.re (inner ℂ (ejResidualProjection (V 2) x) (ejResidualProjection (V 2) (ejThreeResidualMap V x))) = ‖ejThreeResidualMap V x‖ ^ 2"},{"kind":"theorem","name":"norm_sub_one_third_smul_sq","statement":"(a b : H) : ‖a - (3 : ℂ)⁻¹ • b‖ ^ 2 = ‖a‖ ^ 2 - (2 / 3 : ℝ) * RCLike.re (inner ℂ a b) + (1 / 9 : ℝ) * ‖b‖ ^ 2"},{"kind":"theorem","name":"ejResidualProjection_average_norm_sq","statement":"(W : Submodule ℂ H) [W.HasOrthogonalProjection] (x z : H) : ‖ejResidualProjection W (x - (3 : ℂ)⁻¹ • z)‖ ^ 2 = ‖ejResidualProjection W x‖ ^ 2 - (2 / 3 : ℝ) * RCLike.re (inner ℂ (ejResidualProjection W x) (ejResidualProjection W z)) + (1 / 9 : ℝ) * ‖ejResidualProjection W z‖ ^ 2"},{"kind":"theorem","name":"ejThreeResidualEnergy_average","statement":"(x : H) : ejThreeResidualEnergy V (ejThreeProjectionAverage V x) = ejThreeResidualEnergy V x - (2 / 3 : ℝ) * ‖ejThreeResidualMap V x‖ ^ 2 + (1 / 9 : ℝ) * ejThreeResidualEnergy V (ejThreeResidualMap V x)"},{"kind":"theorem","name":"ejThreeResidualMap_spectral_gap","statement":"(x : H) (ε : ℝ) (h01 : (1 - ε) * (‖ejResidualProjection (V 0) x‖ ^ 2 + ‖ejResidualProjection (V 1) x‖ ^ 2) ≤ ‖ejResidualProjection (V 0) x + ejResidualProjection (V 1) x‖ ^ 2) (h12 : (1 - ε) * (‖ejResidualProjection (V 1) x‖ ^ 2 + ‖ejResidualProjection (V 2) x‖ ^ 2) ≤ ‖ejResidualProjection (V 1) x + ejResidualProjection (V 2) x‖ ^ 2) (h20 : (1 - ε) * (‖ejResidualProjection (V 2) x‖ ^ 2 + ‖ejResidualProjection (V 0) x‖ ^ 2) ≤ ‖ejResidualProjection (V 2) x + ejResidualProjection (V 0) x‖ ^ 2) : (1 - 2 * ε) * ejThreeResidualEnergy V x ≤ ‖ejThreeResidualMap V x‖ ^ 2"},{"kind":"theorem","name":"ejThreeResidualEnergy_average_le","statement":"(x : H) (δ : ℝ) (hgap : δ * ejThreeResidualEnergy V x ≤ ‖ejThreeResidualMap V x‖ ^ 2) : ejThreeResidualEnergy V (ejThreeProjectionAverage V x) ≤ (1 - δ / 3) * ejThreeResidualEnergy V x"},{"kind":"theorem","name":"ejStarProjection_mem_inf_orthogonal","statement":"(U V : Submodule ℂ H) [U.HasOrthogonalProjection] (w : H) (hw : w ∈ (U ⊓ V)ᗮ) : U.starProjection w ∈ (U ⊓ V)ᗮ"},{"kind":"theorem","name":"ejTwoProjection_norm_sq_sum_le_of_angle","statement":"(U V : Submodule ℂ H) [U.HasOrthogonalProjection] [V.HasOrthogonalProjection] (c : ℝ) (hc : 0 ≤ c) (hangle : ∀ (u v : H), u ∈ U → u ∈ (U ⊓ V)ᗮ → v ∈ V → v ∈ (U ⊓ V)ᗮ → ‖inner ℂ u v‖ ≤ c * ‖u‖ * ‖v‖) (w : H) (hw : w ∈ (U ⊓ V)ᗮ) : ‖U.starProjection w‖ ^ 2 + ‖V.starProjection w‖ ^ 2 ≤ (1 + c) * ‖w‖ ^ 2"},{"kind":"theorem","name":"ejTwoResidualEnergy_ge_of_angle","statement":"(U V : Submodule ℂ H) [U.HasOrthogonalProjection] [V.HasOrthogonalProjection] (c : ℝ) (hc : 0 ≤ c) (hangle : ∀ (u v : H), u ∈ U → u ∈ (U ⊓ V)ᗮ → v ∈ V → v ∈ (U ⊓ V)ᗮ → ‖inner ℂ u v‖ ≤ c * ‖u‖ * ‖v‖) (w : H) (hw : w ∈ (U ⊓ V)ᗮ) : (1 - c) * ‖w‖ ^ 2 ≤ ‖ejResidualProjection U w‖ ^ 2 + ‖ejResidualProjection V w‖ ^ 2"},{"kind":"theorem","name":"ejTwoResidual_sum_re_inner","statement":"(U V : Submodule ℂ H) [U.HasOrthogonalProjection] [V.HasOrthogonalProjection] (w : H) : RCLike.re (inner ℂ (ejResidualProjection U w + ejResidualProjection V w) w) = ‖ejResidualProjection U w‖ ^ 2 + ‖ejResidualProjection V w‖ ^ 2"},{"kind":"theorem","name":"ejTwoResidual_spectral_gap_of_angle","statement":"(U V : Submodule ℂ H) [U.HasOrthogonalProjection] [V.HasOrthogonalProjection] [(U ⊓ V).HasOrthogonalProjection] (c : ℝ) (hc : 0 ≤ c) (hc' : c ≤ 1) (hangle : ∀ (u v : H), u ∈ U → u ∈ (U ⊓ V)ᗮ → v ∈ V → v ∈ (U ⊓ V)ᗮ → ‖inner ℂ u v‖ ≤ c * ‖u‖ * ‖v‖) (x : H) : (1 - c) * (‖ejResidualProjection U x‖ ^ 2 + ‖ejResidualProjection V x‖ ^ 2) ≤ ‖ejResidualProjection U x + ejResidualProjection V x‖ ^ 2"},{"kind":"theorem","name":"ejThreeProjectionAverage_dist_sq","statement":"(x : H) : dist x (ejThreeProjectionAverage V x) ^ 2 = (1 / 9 : ℝ) * ‖ejThreeResidualMap V x‖ ^ 2"},{"kind":"theorem","name":"ejThreeProjectionAverage_dist_sq_le","statement":"(x : H) : dist x (ejThreeProjectionAverage V x) ^ 2 ≤ ejThreeResidualEnergy V x / 3"},{"kind":"theorem","name":"ejThreeResidualEnergy_iterate_le","statement":"(δ : ℝ) (hδ : δ ≤ 3) (hgap : ∀ x : H, δ * ejThreeResidualEnergy V x ≤ ‖ejThreeResidualMap V x‖ ^ 2) (x : H) (n : ℕ) : ejThreeResidualEnergy V (((ejThreeProjectionAverage V : H → H)^[n]) x) ≤ (1 - δ / 3) ^ n * ejThreeResidualEnergy V x"},{"kind":"theorem","name":"ejThreeProjectionAverage_iterate_dist_le_geometric","statement":"(δ : ℝ) (hδ : δ ≤ 3) (hgap : ∀ x : H, δ * ejThreeResidualEnergy V x ≤ ‖ejThreeResidualMap V x‖ ^ 2) (x : H) (n : ℕ) : dist (((ejThreeProjectionAverage V : H → H)^[n]) x) (((ejThreeProjectionAverage V : H → H)^[n + 1]) x) ≤ Real.sqrt (ejThreeResidualEnergy V x / 3) * (1 - δ / 6) ^ n"},{"kind":"theorem","name":"ejThreeResidual_spectral_gap_of_pair_angles","statement":"[∀ i j : Fin 3, (V i ⊓ V j).HasOrthogonalProjection] (c : ℝ) (hc : 0 ≤ c) (hc' : c ≤ 1) (hangle : ∀ (i j : Fin 3) (u v : H), u ∈ V i → u ∈ (V i ⊓ V j)ᗮ → v ∈ V j → v ∈ (V i ⊓ V j)ᗮ → ‖inner ℂ u v‖ ≤ c * ‖u‖ * ‖v‖) (x : H) : (1 - 2 * c) * ejThreeResidualEnergy V x ≤ ‖ejThreeResidualMap V x‖ ^ 2"},{"kind":"theorem","name":"ejThreeProjectionAverage_iterate_dist_le_of_pair_angles","statement":"[∀ i j : Fin 3, (V i ⊓ V j).HasOrthogonalProjection] (c : ℝ) (hc : 0 ≤ c) (hchalf : c < (1 / 2 : ℝ)) (hangle : ∀ (i j : Fin 3) (u v : H), u ∈ V i → u ∈ (V i ⊓ V j)ᗮ → v ∈ V j → v ∈ (V i ⊓ V j)ᗮ → ‖inner ℂ u v‖ ≤ c * ‖u‖ * ‖v‖) (x : H) (n : ℕ) : dist (((ejThreeProjectionAverage V : H → H)^[n]) x) (((ejThreeProjectionAverage V : H → H)^[n + 1]) x) ≤ Real.sqrt (ejThreeResidualEnergy V x / 3) * (1 - (1 - 2 * c) / 6) ^ n"},{"kind":"theorem","name":"ejThreeResidualEnergy_sqrt_div_three_le","statement":"(x : H) (T : ℝ) (hT : 0 ≤ T) (hbound : ∀ i : Fin 3, ‖ejResidualProjection (V i) x‖ ≤ T) : Real.sqrt (ejThreeResidualEnergy V x / 3) ≤ T"},{"kind":"theorem","name":"ejThreeProjectionAverage_fixed_iff_residualMap_eq_zero","statement":"(x : H) : ejThreeProjectionAverage V x = x ↔ ejThreeResidualMap V x = 0"},{"kind":"theorem","name":"ejThreeResidualEnergy_eq_zero_iff","statement":"(x : H) : ejThreeResidualEnergy V x = 0 ↔ ∀ i : Fin 3, ejResidualProjection (V i) x = 0"},{"kind":"theorem","name":"ejThreeProjectionAverage_fixed_mem","statement":"(x : H) (hx : ejThreeProjectionAverage V x = x) (i : Fin 3) : x ∈ V i"},{"kind":"theorem","name":"mem_ejUnitaryFixedSubmodule","statement":"{G : Type u₂} {H : Type v₂} [Group G] [NormedAddCommGroup H] [InnerProductSpace ℂ H] (π : UnitaryRepresentation G H) (K : Subgroup G) (x : H) : x ∈ ejUnitaryFixedSubmodule π K ↔ ∀ k : K, π (k : G) x = x"},{"kind":"theorem","name":"ejUnitaryFixedSubmodule_isClosed","statement":"{G : Type u₂} {H : Type v₂} [Group G] [NormedAddCommGroup H] [InnerProductSpace ℂ H] (π : UnitaryRepresentation G H) (K : Subgroup G) : IsClosed (ejUnitaryFixedSubmodule π K : Set H)"},{"kind":"theorem","name":"ejUnitaryFixedSubmodule_inf_isClosed","statement":"{G : Type u₂} {H : Type v₂} [Group G] [NormedAddCommGroup H] [InnerProductSpace ℂ H] (π : UnitaryRepresentation G H) (K J : Subgroup G) : IsClosed ((ejUnitaryFixedSubmodule π K ⊓ ejUnitaryFixedSubmodule π J : Submodule ℂ H) : Set H)"},{"kind":"theorem","name":"finiteUnitarySubgroupAverage_fixed","statement":"(π : SoficGroups.UnitaryRepresentation G H) (K : Subgroup G) [Fintype K] (x : H) (g : K) : π (g : G) (finiteUnitarySubgroupAverage π K x) = finiteUnitarySubgroupAverage π K x"},{"kind":"theorem","name":"finiteUnitarySubgroupAverage_sub","statement":"(π : SoficGroups.UnitaryRepresentation G H) (K : Subgroup G) [Fintype K] (x : H) : finiteUnitarySubgroupAverage π K x - x = (Fintype.card K : ℂ)⁻¹ • ∑ k : K, (π (k : G) x - x)"},{"kind":"theorem","name":"norm_finiteUnitarySubgroupAverage_sub_le","statement":"(π : SoficGroups.UnitaryRepresentation G H) (K : Subgroup G) [Fintype K] (x : H) : ‖finiteUnitarySubgroupAverage π K x - x‖ ≤ (Fintype.card K : ℝ)⁻¹ * ∑ k : K, ‖π (k : G) x - x‖"},{"kind":"theorem","name":"norm_sub_starProjection_le_finiteUnitarySubgroupAverage","statement":"(π : SoficGroups.UnitaryRepresentation G H) (K : Subgroup G) [Fintype K] (U : Submodule ℂ H) [U.HasOrthogonalProjection] (x : H) (hmem : finiteUnitarySubgroupAverage π K x ∈ U) : ‖x - U.starProjection x‖ ≤ ‖finiteUnitarySubgroupAverage π K x - x‖"},{"kind":"theorem","name":"hasPropertyT_of_geometric_finite_averaging","statement":"{G : Type u} [Group G] (S : Finset G) (q : ℝ) (hq1 : q < 1) (haverage : ∀ (H : Type v) [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H] (π : SoficGroups.UnitaryRepresentation G H), ∃ A : H →L[ℂ] H, (∀ (x : H) (n : ℕ), dist ((A : H → H)^[n] x) ((A : H → H)^[n + 1] x) ≤ (∑ g ∈ S, ‖π g x - x‖) * q ^ n) ∧ (∀ x : H, A x = x → ∀ g : G, π g x = x)) : SoficGroups.HasPropertyT.{u, v} G"},{"kind":"theorem","name":"mem_threeFiniteSubgroupGenerators","statement":"{G : Type u} [Group G] (K : Fin 3 → Subgroup G) [∀ i, Fintype (K i)] (g : G) : g ∈ threeFiniteSubgroupGenerators K ↔ ∃ i : Fin 3, g ∈ K i"},{"kind":"theorem","name":"hasPropertyT_of_three_finite_subgroups_geometric","statement":"{G : Type u} [Group G] (K : Fin 3 → Subgroup G) [∀ i, Fintype (K i)] (hgen : (⨆ i : Fin 3, K i) = ⊤) (q : ℝ) (hq : q < 1) (haverage : ∀ (H : Type v) [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H] (π : SoficGroups.UnitaryRepresentation G H), ∃ A : H →L[ℂ] H, (∀ (x : H) (n : ℕ), dist ((A : H → H)^[n] x) ((A : H → H)^[n + 1] x) ≤ (∑ g ∈ threeFiniteSubgroupGenerators K, ‖π g x - x‖) * q ^ n) ∧ (∀ x : H, A x = x → ∀ (i : Fin 3) (g : K i), π (g : G) x = x)) : SoficGroups.HasPropertyT.{u, v} G"},{"kind":"theorem","name":"inv_sqrt_eight_pos","statement":"0 < (Real.sqrt (8 : ℝ))⁻¹"},{"kind":"theorem","name":"inv_sqrt_eight_lt_one_half","statement":"(Real.sqrt (8 : ℝ))⁻¹ < (1 / 2 : ℝ)"},{"kind":"theorem","name":"norm_inner_le_inv_sqrt_eight_of_sq","statement":"{H : Type v} [NormedAddCommGroup H] [InnerProductSpace ℂ H] (a b : H) (h : 8 * ‖inner ℂ a b‖ ^ 2 ≤ ‖a‖ ^ 2 * ‖b‖ ^ 2) : ‖inner ℂ a b‖ ≤ (Real.sqrt (8 : ℝ))⁻¹ * ‖a‖ * ‖b‖"},{"kind":"theorem","name":"hasPropertyT_of_three_finite_subgroups_friedrichs_angle","statement":"{G : Type u} [Group G] (K : Fin 3 → Subgroup G) [∀ i, Fintype (K i)] (hgen : (⨆ i : Fin 3, K i) = ⊤) (c : ℝ) (hc : 0 ≤ c) (hchalf : c < (1 / 2 : ℝ)) (hangle : ∀ (H : Type v) [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H] (π : SoficGroups.UnitaryRepresentation G H) (i j : Fin 3), i ≠ j → ∀ (a b : H), a ∈ SoficGroups.ejUnitaryFixedSubmodule π (K i) → a ∈ (SoficGroups.ejUnitaryFixedSubmodule π (K i) ⊓ SoficGroups.ejUnitaryFixedSubmodule π (K j))ᗮ → b ∈ SoficGroups.ejUnitaryFixedSubmodule π (K j) → b ∈ (SoficGroups.ejUnitaryFixedSubmodule π (K i) ⊓ SoficGroups.ejUnitaryFixedSubmodule π (K j))ᗮ → ‖inner ℂ a b‖ ≤ c * ‖a‖ * ‖b‖) : SoficGroups.HasPropertyT.{u, v} G"},{"kind":"theorem","name":"finiteBlockGaloisField_natCard","statement":"Nat.card finiteBlockGaloisField = 8"},{"kind":"theorem","name":"finiteBlockCoefficientMatrix_mul_binary_mem","statement":"(W : Submodule (ZMod 2) R) (A : Matrix (Fin 3) (Fin 3) R) (hA : ∀ i j, A i j ∈ W) (B : Matrix (Fin 3) (Fin 3) (ZMod 2)) : ∀ i j, (A * RingHom.mapMatrix (algebraMap (ZMod 2) R) B) i j ∈ W"},{"kind":"theorem","name":"finiteBlockCoefficientMatrix_binary_mul_mem","statement":"(W : Submodule (ZMod 2) R) (A : Matrix (Fin 3) (Fin 3) R) (hA : ∀ i j, A i j ∈ W) (B : Matrix (Fin 3) (Fin 3) (ZMod 2)) : ∀ i j, (RingHom.mapMatrix (algebraMap (ZMod 2) R) B * A) i j ∈ W"},{"kind":"theorem","name":"finiteBlockCoefficientMatrix_mul_galois_mem","statement":"(W : Submodule (ZMod 2) R) (A : Matrix (Fin 3) (Fin 3) R) (hA : ∀ i j, A i j ∈ W) (t : finiteBlockGaloisField) : ∀ i j, (A * finiteBlockGaloisMatrixOver R t) i j ∈ W"},{"kind":"theorem","name":"finiteBlockCoefficientMatrix_galois_mul_mem","statement":"(W : Submodule (ZMod 2) R) (A : Matrix (Fin 3) (Fin 3) R) (hA : ∀ i j, A i j ∈ W) (t : finiteBlockGaloisField) : ∀ i j, (finiteBlockGaloisMatrixOver R t * A) i j ∈ W"},{"kind":"theorem","name":"finite_finiteOuterBlockRootSubgroup","statement":"(W : Submodule (ZMod 2) R) [Finite W] (i j : Fin 3) (hij : i ≠ j) : Finite (finiteOuterBlockRootSubgroup W i j hij)"},{"kind":"theorem","name":"finiteOuterElementaryRoot_commutator","statement":"(i j k : Fin 3) (hij : i ≠ j) (hjk : j ≠ k) (hik : i ≠ k) (A B : Matrix (Fin 3) (Fin 3) R) : ⁅elementaryRootHom i j hij (Multiplicative.ofAdd A), elementaryRootHom j k hjk (Multiplicative.ofAdd B)⁆ = elementaryRootHom i k hik (Multiplicative.ofAdd (A * B))"},{"kind":"theorem","name":"finiteOuterElementaryRoot_conjugate_by_successor","statement":"(i j k : Fin 3) (hij : i ≠ j) (hjk : j ≠ k) (hik : i ≠ k) (A B : Matrix (Fin 3) (Fin 3) R) : let x"},{"kind":"theorem","name":"finiteOuterElementaryUnit_commute_of_nonadjacent","statement":"(i j k l : Fin 3) (hij : i ≠ j) (hkl : k ≠ l) (hjk : j ≠ k) (hli : l ≠ i) (A B : Matrix (Fin 3) (Fin 3) R) : Commute (elementaryUnit i j hij A) (elementaryUnit k l hkl B)"},{"kind":"theorem","name":"finiteOuterElementaryRoot_commute_of_nonadjacent","statement":"(i j k l : Fin 3) (hij : i ≠ j) (hkl : k ≠ l) (hjk : j ≠ k) (hli : l ≠ i) (A B : Matrix (Fin 3) (Fin 3) R) : Commute (elementaryRootHom i j hij (Multiplicative.ofAdd A)) (elementaryRootHom k l hkl (Multiplicative.ofAdd B))"},{"kind":"theorem","name":"finiteOuterElementaryRoot_commute_same","statement":"(i j : Fin 3) (hij : i ≠ j) (A B : Matrix (Fin 3) (Fin 3) R) : Commute (elementaryRootHom i j hij (Multiplicative.ofAdd A)) (elementaryRootHom i j hij (Multiplicative.ofAdd B))"},{"kind":"theorem","name":"finiteOuterBlockRoot_commutator_mem_productCentral","statement":"(W : Submodule (ZMod 2) R) (i j k : Fin 3) (hij : i ≠ j) (hjk : j ≠ k) (hik : i ≠ k) (A B : Matrix (Fin 3) (Fin 3) W) : ⁅finiteOuterBlockRootHom W i j hij (Multiplicative.ofAdd A), finiteOuterBlockRootHom W j k hjk (Multiplicative.ofAdd B)⁆ ∈ finiteOuterBlockProductCentralRootSubgroup W i k hik B"},{"kind":"theorem","name":"finiteOuterBlockRoot_commutator_exists_productCentral","statement":"(W : Submodule (ZMod 2) R) (i j k : Fin 3) (hij : i ≠ j) (hjk : j ≠ k) (hik : i ≠ k) (x y : elementaryGroup (Fin 3) (Matrix (Fin 3) (Fin 3) R)) (hx : x ∈ finiteOuterBlockRootSubgroup W i j hij) (hy : y ∈ finiteOuterBlockRootSubgroup W j k hjk) : ∃ B : Matrix (Fin 3) (Fin 3) W, ⁅x, y⁆ ∈ finiteOuterBlockProductCentralRootSubgroup W i k hik B"},{"kind":"theorem","name":"finiteOuterBlockProductCentralRoot_commute_left","statement":"(W : Submodule (ZMod 2) R) (i j k : Fin 3) (hij : i ≠ j) (hik : i ≠ k) (B : Matrix (Fin 3) (Fin 3) W) (x z : elementaryGroup (Fin 3) (Matrix (Fin 3) (Fin 3) R)) (hx : x ∈ finiteOuterBlockRootSubgroup W i j hij) (hz : z ∈ finiteOuterBlockProductCentralRootSubgroup W i k hik B) : Commute x z"},{"kind":"theorem","name":"finiteOuterBlockProductCentralRoot_commute_right","statement":"(W : Submodule (ZMod 2) R) (i j k : Fin 3) (hjk : j ≠ k) (hik : i ≠ k) (B : Matrix (Fin 3) (Fin 3) W) (y z : elementaryGroup (Fin 3) (Matrix (Fin 3) (Fin 3) R)) (hy : y ∈ finiteOuterBlockRootSubgroup W j k hjk) (hz : z ∈ finiteOuterBlockProductCentralRootSubgroup W i k hik B) : Commute y z"},{"kind":"theorem","name":"finiteOuterBlockProductCentralRoot_pair_le_centralizer","statement":"(W : Submodule (ZMod 2) R) (i j k : Fin 3) (hij : i ≠ j) (hjk : j ≠ k) (hik : i ≠ k) (B : Matrix (Fin 3) (Fin 3) W) : finiteOuterBlockRootSubgroup W i j hij ⊔ finiteOuterBlockRootSubgroup W j k hjk ≤ Subgroup.centralizer (finiteOuterBlockProductCentralRootSubgroup W i k hik B : Set (elementaryGroup (Fin 3) (Matrix (Fin 3) (Fin 3) R)))"},{"kind":"theorem","name":"finiteOuterBlockProductCentralRoots_commute","statement":"(W : Submodule (ZMod 2) R) (i k : Fin 3) (hik : i ≠ k) (B C : Matrix (Fin 3) (Fin 3) W) (z w : elementaryGroup (Fin 3) (Matrix (Fin 3) (Fin 3) R)) (hz : z ∈ finiteOuterBlockProductCentralRootSubgroup W i k hik B) (hw : w ∈ finiteOuterBlockProductCentralRootSubgroup W i k hik C) : Commute z w"},{"kind":"theorem","name":"finiteBlockCoefficientMatrixHom_galoisLeftProduct","statement":"(W : Submodule (ZMod 2) R) (B : Matrix (Fin 3) (Fin 3) W) (t : finiteBlockGaloisField) : finiteBlockCoefficientMatrixHom W (finiteBlockGaloisLeftProductCoefficientMatrix